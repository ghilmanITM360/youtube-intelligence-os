{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Your husband dies on a Tuesday."
    } ]
  }, {
    "tStartMs": 3040,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "The joint account does not freeze."
    } ]
  }, {
    "tStartMs": 5500,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "The money is yours that same afternoon,\nwith no court, no lawyer and no waiting."
    } ]
  }, {
    "tStartMs": 11800,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Then the government reaches into that same\naccount and pulls a payment back"
    } ]
  }, {
    "tStartMs": 16060,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "out of it. It does not ask which half was\nyours."
    } ]
  }, {
    "tStartMs": 20140,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "If you have already spent that money on"
    } ]
  }, {
    "tStartMs": 22100,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "the electric bill, you now owe it\npersonally."
    } ]
  }, {
    "tStartMs": 25680,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "That is what nobody explains. The account\nsurvives him."
    } ]
  }, {
    "tStartMs": 30380,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Four other things do not, and three of\nthem are gone before the first month"
    } ]
  }, {
    "tStartMs": 34540,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "is over. His last Social Security payment."
    } ]
  }, {
    "tStartMs": 38080,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "The credit card in your purse."
    } ]
  }, {
    "tStartMs": 39900,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "His pension. And one word on a paper you\nsigned at the bank years ago, which"
    } ]
  }, {
    "tStartMs": 45120,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "decides whether anything I just said about\nthe account is even true for you."
    } ]
  }, {
    "tStartMs": 50140,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Four things. What each one is, and how few\ndays you have on each."
    } ]
  }, {
    "tStartMs": 54340,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Number one is the Social Security payment\nfor the month he died."
    } ]
  }, {
    "tStartMs": 59460,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Start with the rule, because it is the\nopposite of what almost everyone assumes."
    } ]
  }, {
    "tStartMs": 64260,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "Social Security is paid a month behind."
    } ]
  }, {
    "tStartMs": 67000,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "The payment that arrives in August is the\npayment for July, so people treat"
    } ]
  }, {
    "tStartMs": 71480,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "it as money already earned and already\ntheirs."
    } ]
  }, {
    "tStartMs": 74960,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The law says something else entirely."
    } ]
  }, {
    "tStartMs": 77580,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "A person must be alive for the entire\nmonth to be owed that month."
    } ]
  }, {
    "tStartMs": 81440,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "If your husband dies on the twenty eighth\nof a month, he is not owed anything"
    } ]
  }, {
    "tStartMs": 85740,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "for that month. Not a share of it."
    } ]
  }, {
    "tStartMs": 88180,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Not twenty eight days of it. Nothing."
    } ]
  }, {
    "tStartMs": 90800,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "So the payment that lands in your account\nafter he dies is not his final payment."
    } ]
  }, {
    "tStartMs": 95440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "It is an overpayment, and it is going\nback."
    } ]
  }, {
    "tStartMs": 99120,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Now the part that turns a rule into a\nproblem in your kitchen."
    } ]
  }, {
    "tStartMs": 103080,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "The money does not come back out of his\nhalf."
    } ]
  }, {
    "tStartMs": 106100,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "There is no his half. When the Treasury\nsends a reclamation to your bank, it"
    } ]
  }, {
    "tStartMs": 110620,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "reaches the whole account, and the bank\ntakes what it is told to take, no matter"
    } ]
  }, {
    "tStartMs": 114800,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "whose name put the money in. Think about\nwhat that means for a woman in her"
    } ]
  }, {
    "tStartMs": 118800,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "first weeks alone. Her husband dies at the\nend of the month."
    } ]
  }, {
    "tStartMs": 122940,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "The payment arrives a few days later, the\nway it has arrived for twenty years."
    } ]
  }, {
    "tStartMs": 127600,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "She pays the power bill with it, and the\nphone bill, and the grocery bill,"
    } ]
  }, {
    "tStartMs": 131820,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "because those bills do not stop for a\nfuneral."
    } ]
  }, {
    "tStartMs": 134760,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Then the bank pulls the money back."
    } ]
  }, {
    "tStartMs": 136620,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "If the balance is thin, and it usually is\nin those weeks, she is overdrawn"
    } ]
  }, {
    "tStartMs": 141260,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "on money she never knew she was not\nallowed to keep."
    } ]
  }, {
    "tStartMs": 144340,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "And if the bank cannot reach it because it\nis already spent, Social Security"
    } ]
  }, {
    "tStartMs": 148540,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "does not close the file. The debt moves to\nher."
    } ]
  }, {
    "tStartMs": 152620,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "She now owes the government directly, in\nthe same month she buried him, and"
    } ]
  }, {
    "tStartMs": 158000,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "the first she hears of it is a demand for\nrepayment."
    } ]
  }, {
    "tStartMs": 161460,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "There is a second payment in this, and it\ngoes the other way."
    } ]
  }, {
    "tStartMs": 165660,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "There is a one time death payment of two\nhundred and fifty five dollars for"
    } ]
  }, {
    "tStartMs": 169760,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "a surviving spouse who was living with\nhim."
    } ]
  }, {
    "tStartMs": 172380,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "It does not arrive by itself."
    } ]
  }, {
    "tStartMs": 175080,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Somebody has to ask for it, and there is a\ntwo year limit on asking."
    } ]
  }, {
    "tStartMs": 179940,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "So the money you were never owed is taken\nautomatically."
    } ]
  }, {
    "tStartMs": 183120,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "The money you are owed has to be claimed\nby hand."
    } ]
  }, {
    "tStartMs": 186280,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "That is the shape of this whole video."
    } ]
  }, {
    "tStartMs": 188420,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Number two is the credit card sitting in\nyour purse right now."
    } ]
  }, {
    "tStartMs": 193260,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Take it out and look at whose name is\nprinted on it."
    } ]
  }, {
    "tStartMs": 196460,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "If the name is his, and yours is not on\nthe account as an owner, then you are"
    } ]
  }, {
    "tStartMs": 201860,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "what the card company calls an authorized\nuser."
    } ]
  }, {
    "tStartMs": 204860,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "You have carried it for years."
    } ]
  }, {
    "tStartMs": 207120,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "You have paid the bill from the joint\naccount."
    } ]
  }, {
    "tStartMs": 209640,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "In every practical sense it is your card."
    } ]
  }, {
    "tStartMs": 213520,
    "dDurationMs": 6220,
    "segs": [ {
      "utf8": "It is not your card. The account belongs\nto him alone, and when he dies, the"
    } ]
  }, {
    "tStartMs": 219740,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "company closes it. You cannot take it\nover."
    } ]
  }, {
    "tStartMs": 222940,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "You cannot have the name changed."
    } ]
  }, {
    "tStartMs": 225180,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "You cannot ask them to leave it open while\nthings settle."
    } ]
  }, {
    "tStartMs": 228460,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "The account ends with the account holder,\nand every card attached to it stops"
    } ]
  }, {
    "tStartMs": 233140,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "working, including the one in your hand."
    } ]
  }, {
    "tStartMs": 236240,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Now the second half, which is worse and\nslower."
    } ]
  }, {
    "tStartMs": 240160,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "That card has been reporting to your\ncredit file the whole time."
    } ]
  }, {
    "tStartMs": 243940,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "Years of on time payments, years of\nhistory, all sitting on an account in his"
    } ]
  }, {
    "tStartMs": 249820,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "name."
    } ]
  }, {
    "tStartMs": 251040,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "When it closes, that history stops helping\nyou."
    } ]
  }, {
    "tStartMs": 254700,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "So picture the position she is in."
    } ]
  }, {
    "tStartMs": 256960,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "She has just lost half the household\nincome."
    } ]
  }, {
    "tStartMs": 259960,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "She has funeral costs in front of her."
    } ]
  }, {
    "tStartMs": 262320,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "And the card she has used for fifteen\nyears declines at the grocery store,"
    } ]
  }, {
    "tStartMs": 266900,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "because a company was told he died."
    } ]
  }, {
    "tStartMs": 270120,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Then she goes to apply for a card of her\nown, and she finds she has almost"
    } ]
  }, {
    "tStartMs": 275080,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "no credit record in her own name, because\neverything was in his."
    } ]
  }, {
    "tStartMs": 280220,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "There is one more thing worth knowing,\nbecause it is where the fear usually"
    } ]
  }, {
    "tStartMs": 284020,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "sits. As an authorized user you are not\nresponsible for the balance on that"
    } ]
  }, {
    "tStartMs": 289340,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "card."
    } ]
  }, {
    "tStartMs": 290420,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The debt belongs to his estate."
    } ]
  }, {
    "tStartMs": 293280,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "The one exception is a small group of\nstates that treat marital debt as shared,"
    } ]
  }, {
    "tStartMs": 298220,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "so if you live in Arizona, California,\nIdaho, Louisiana, Nevada, New Mexico,"
    } ]
  }, {
    "tStartMs": 304400,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Texas, Washington or Wisconsin, ask about\nthat specifically."
    } ]
  }, {
    "tStartMs": 309260,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "But being free of the debt does not put a\ncard back in your hand."
    } ]
  }, {
    "tStartMs": 313160,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Those are two different problems, and only\none of them solves itself."
    } ]
  }, {
    "tStartMs": 317460,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Number three is his pension, and this is\nthe largest amount of money in this"
    } ]
  }, {
    "tStartMs": 322260,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "video by a wide margin. If your husband\nhad a company pension, then on the"
    } ]
  }, {
    "tStartMs": 327660,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "day he retired he chose how it would be\npaid."
    } ]
  }, {
    "tStartMs": 331440,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "There were two doors. Behind one, a larger\namount every month that stops the"
    } ]
  }, {
    "tStartMs": 336760,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "day he dies. Behind the other, a smaller\namount every month that keeps paying"
    } ]
  }, {
    "tStartMs": 341720,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "you for the rest of your life after he is\ngone."
    } ]
  }, {
    "tStartMs": 345060,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "The larger one is called a single life\npayment."
    } ]
  }, {
    "tStartMs": 348460,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "The smaller one continues to the surviving\nspouse, and by law it must be at"
    } ]
  }, {
    "tStartMs": 353360,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "least half of what he was getting."
    } ]
  }, {
    "tStartMs": 355860,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Now the rule that decides your future."
    } ]
  }, {
    "tStartMs": 358940,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Federal law says a married man cannot take\nthe larger, ending payment on his"
    } ]
  }, {
    "tStartMs": 363380,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "own. His wife has to sign it away in\nwriting, and that signature has to be"
    } ]
  }, {
    "tStartMs": 368580,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "witnessed by the plan or notarized."
    } ]
  }, {
    "tStartMs": 371540,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "So if his pension stops the month he dies,\nthere is a signed paper somewhere"
    } ]
  }, {
    "tStartMs": 376380,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "with your name on it. Think about how that\nsignature usually happens."
    } ]
  }, {
    "tStartMs": 381840,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "A man retires. There is a stack of forms."
    } ]
  }, {
    "tStartMs": 385320,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Somewhere in that stack is the one that\nsays the payments end when he does,"
    } ]
  }, {
    "tStartMs": 389400,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "and it gets signed because the larger\nnumber looked better on the day and nobody"
    } ]
  }, {
    "tStartMs": 394320,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "at the table explained what the smaller\nnumber was buying."
    } ]
  }, {
    "tStartMs": 397920,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "The difference is not small. A widow\nreceiving half of a two thousand dollar"
    } ]
  }, {
    "tStartMs": 403120,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "monthly pension, across a normal remaining\nlifetime, is receiving something"
    } ]
  }, {
    "tStartMs": 407940,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "in the region of four hundred thousand\ndollars."
    } ]
  }, {
    "tStartMs": 411200,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "That is what one signature at a kitchen\ntable decides."
    } ]
  }, {
    "tStartMs": 415780,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "That signature has rules attached to it,\nand the rules are often broken."
    } ]
  }, {
    "tStartMs": 420760,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "The paper has to exist. It has to be\nsigned by you, not by him."
    } ]
  }, {
    "tStartMs": 426040,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "It has to be witnessed properly."
    } ]
  }, {
    "tStartMs": 427760,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "And it has to show that what you were\ngiving up was explained to you."
    } ]
  }, {
    "tStartMs": 432340,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "If any of that is missing, the choice can\nbe challenged."
    } ]
  }, {
    "tStartMs": 436700,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Widows have gone back to a plan years\nlater, asked for the consent form, found"
    } ]
  }, {
    "tStartMs": 441660,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that it was never signed or never"
    } ]
  }, {
    "tStartMs": 443580,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "witnessed, and had the survivor payment\nrestored."
    } ]
  }, {
    "tStartMs": 447500,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "So do not accept a telephone answer on\nthis."
    } ]
  }, {
    "tStartMs": 451280,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "Ask the plan, in writing, for a copy of\nthe election form and the spousal consent"
    } ]
  }, {
    "tStartMs": 456740,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "that goes with it. If they cannot produce"
    } ]
  }, {
    "tStartMs": 459420,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "it, that is not the end of the\nconversation."
    } ]
  }, {
    "tStartMs": 462060,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "That is the beginning of it. Number four\nis one word on a paper you signed"
    } ]
  }, {
    "tStartMs": 466920,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "at the bank, and it decides whether the\npromise in the title of this video"
    } ]
  }, {
    "tStartMs": 470860,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "applies to you at all. Everything I have\nsaid about the account passing to"
    } ]
  }, {
    "tStartMs": 475580,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "you straight away rests on how the account\nis titled."
    } ]
  }, {
    "tStartMs": 479540,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Not on your marriage. Not on your will."
    } ]
  }, {
    "tStartMs": 482080,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "On the wording of the signature card."
    } ]
  }, {
    "tStartMs": 484600,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Most joint accounts in this country are\nset up one way."
    } ]
  }, {
    "tStartMs": 488740,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Two names, and the survivor takes the\nwhole thing."
    } ]
  }, {
    "tStartMs": 491520,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "That is the arrangement that skips the\ncourt, and that is why the account keeps"
    } ]
  }, {
    "tStartMs": 496040,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "working the afternoon he dies."
    } ]
  }, {
    "tStartMs": 498900,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "But there is a second way to title exactly\nthe same account."
    } ]
  }, {
    "tStartMs": 502920,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "It looks identical on the statement."
    } ]
  }, {
    "tStartMs": 505300,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Both names are on it. The difference is\nthat each person owns a defined share,"
    } ]
  }, {
    "tStartMs": 510520,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "usually half, and when one of them dies,\nthat half does not go to the survivor."
    } ]
  }, {
    "tStartMs": 515680,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "It goes to his estate, and it waits for\nthe court like everything else."
    } ]
  }, {
    "tStartMs": 519340,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Same bank. Same two names. Same statement."
    } ]
  }, {
    "tStartMs": 523080,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Opposite outcome. And you will not find\nout which one you have on the day he"
    } ]
  }, {
    "tStartMs": 526760,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "dies, because that is the day it stops\nbeing a question you can fix."
    } ]
  }, {
    "tStartMs": 531120,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "There is a third situation, and it catches\npeople who did everything right."
    } ]
  }, {
    "tStartMs": 536020,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Even where the account passes to you\ncorrectly, some banks put a temporary"
    } ]
  }, {
    "tStartMs": 540080,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "hold on it anyway while they confirm the\ndeath and update their records."
    } ]
  }, {
    "tStartMs": 544480,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "It is not the court. It is not probate."
    } ]
  }, {
    "tStartMs": 547120,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "It is an internal step, and it can still\nlock you out for days in the week"
    } ]
  }, {
    "tStartMs": 551600,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "you can least afford it. So the account\nbeing safe in law and the account working"
    } ]
  }, {
    "tStartMs": 556020,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "on Wednesday morning are not the same\nthing."
    } ]
  }, {
    "tStartMs": 559520,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "What to do, and one thing must be said\nbefore the steps."
    } ]
  }, {
    "tStartMs": 563780,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "This describes how these rules generally\nwork across the country."
    } ]
  }, {
    "tStartMs": 567940,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Your own bank, your own state and the\nexact wording on your own paperwork can"
    } ]
  }, {
    "tStartMs": 572700,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "all change the answer, so take these\nquestions to the people holding your money"
    } ]
  }, {
    "tStartMs": 577320,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "rather than acting on what I say."
    } ]
  }, {
    "tStartMs": 580280,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Then do these four things. Telephone your\nbank and ask one question."
    } ]
  }, {
    "tStartMs": 585140,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Is our account held with right of"
    } ]
  }, {
    "tStartMs": 586880,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "survivorship, and can you read me the\nwording."
    } ]
  }, {
    "tStartMs": 590020,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Not is it a joint account. Both kinds are\njoint accounts."
    } ]
  }, {
    "tStartMs": 593780,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Ask for the wording, and write down what\nthey read you."
    } ]
  }, {
    "tStartMs": 597200,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Open your purse and check whose name is on\nthe card."
    } ]
  }, {
    "tStartMs": 601020,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "If you are only an authorized user on\nevery card you carry, apply for one card"
    } ]
  }, {
    "tStartMs": 606320,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "in your own name this month, while there\nare still two incomes and two credit"
    } ]
  }, {
    "tStartMs": 611440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "files in the house."
    } ]
  }, {
    "tStartMs": 613100,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "That is far easier to do now than in the\nmonth after."
    } ]
  }, {
    "tStartMs": 617260,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Write to the pension plan and ask for two\ndocuments."
    } ]
  }, {
    "tStartMs": 620140,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "The payment election he signed at\nretirement, and the spousal consent form."
    } ]
  }, {
    "tStartMs": 625540,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "Ask in writing so there is a record, and\nkeep whatever comes back with your"
    } ]
  }, {
    "tStartMs": 629880,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "other papers. And decide today which bills\ncome out of the joint account and"
    } ]
  }, {
    "tStartMs": 634620,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "which come out of an account in your name\nalone."
    } ]
  }, {
    "tStartMs": 637260,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "If the Treasury ever reaches into the\njoint account, the money in the account"
    } ]
  }, {
    "tStartMs": 642080,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "with only your name on it is not part of\nthat reach."
    } ]
  }, {
    "tStartMs": 646540,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Now a word about the people who appear at\nexactly this moment."
    } ]
  }, {
    "tStartMs": 650880,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "The death of a spouse is public."
    } ]
  }, {
    "tStartMs": 653160,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "It is in the notices, it is in the court\nfile, and there is an industry that"
    } ]
  }, {
    "tStartMs": 657800,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "reads both. Within weeks a widow"
    } ]
  }, {
    "tStartMs": 660520,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "gets telephone calls and visits about\nannuities,"
    } ]
  }, {
    "tStartMs": 663980,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "about trusts, about moving the money\nsomewhere safer."
    } ]
  }, {
    "tStartMs": 667560,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "Nothing in this video requires a product,\na policy or a fee."
    } ]
  }, {
    "tStartMs": 672760,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Asking your bank how an account is titled\nis free."
    } ]
  }, {
    "tStartMs": 676440,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "Asking a pension plan for a copy of a form\nyou signed is free."
    } ]
  }, {
    "tStartMs": 681680,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Applying for a card in your own name is\nfree."
    } ]
  }, {
    "tStartMs": 684560,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "If somebody arrives offering to solve all\nof it at once, and the solution involves"
    } ]
  }, {
    "tStartMs": 689940,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "moving your money into something they\nsell, that is the moment to say you will"
    } ]
  }, {
    "tStartMs": 694220,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "decide nothing for ninety days."
    } ]
  }, {
    "tStartMs": 696740,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "So that is the whole of it, laid out once\nmore."
    } ]
  }, {
    "tStartMs": 699720,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "The Social Security payment for the month\nhe died is not his and not yours,"
    } ]
  }, {
    "tStartMs": 704480,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "it comes back out of the whole account,\nand if it is already spent the debt"
    } ]
  }, {
    "tStartMs": 708900,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "follows you personally. A card where you\nare only an authorized user closes"
    } ]
  }, {
    "tStartMs": 714440,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "when he does, and the years of history on\nit stop working for you."
    } ]
  }, {
    "tStartMs": 719060,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "His pension may have been chosen to end\nwith him, but that choice required"
    } ]
  }, {
    "tStartMs": 723260,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "your signature, and if the signed consent\ncannot be produced, the choice can"
    } ]
  }, {
    "tStartMs": 728380,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "be challenged. And whether the account\npasses to you at all comes down to the"
    } ]
  }, {
    "tStartMs": 733180,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "wording on the signature card, which you\ncan find out this week and cannot"
    } ]
  }, {
    "tStartMs": 737740,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "find out on the day. Every one of these\nfour sits in a rule that a bank, a"
    } ]
  }, {
    "tStartMs": 743300,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "pension plan or a government office will\nexplain to anybody who asks them."
    } ]
  }, {
    "tStartMs": 748400,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "They stay unknown for one reason."
    } ]
  }, {
    "tStartMs": 751240,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "There is no moment in an ordinary life\nwhen somebody is required to raise them"
    } ]
  }, {
    "tStartMs": 756020,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "with you, and by the time they matter,"
    } ]
  }, {
    "tStartMs": 758500,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "three of the four can no longer be\nchanged."
    } ]
  }, {
    "tStartMs": 761400,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So telephone the bank this week and ask\nhow the account is titled."
    } ]
  }, {
    "tStartMs": 765400,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "And if your mother is widowed and still\ncarrying a card with your father name"
    } ]
  }, {
    "tStartMs": 770080,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "printed on it, look at that card tonight."
    } ]
  } ]
}
