{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "Nine days ago the Federal Reserve raised\ninterest rates for the first time"
    } ]
  }, {
    "tStartMs": 5260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "in three years."
    } ]
  }, {
    "tStartMs": 7120,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Your bank has known for nine days."
    } ]
  }, {
    "tStartMs": 10380,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Go and look at what it is paying you on\nthe money sitting in your savings account."
    } ]
  }, {
    "tStartMs": 15680,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Then think back to what it was paying you\na fortnight ago."
    } ]
  }, {
    "tStartMs": 19380,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "It is the same number. That is not an\noversight."
    } ]
  }, {
    "tStartMs": 23360,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "That is the arrangement, and it is the\nfirst of five things that moved against"
    } ]
  }, {
    "tStartMs": 27860,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "you this month while nobody was required\nto write to you about any of them."
    } ]
  }, {
    "tStartMs": 33320,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "The fifth one is the one that takes money\nout of your hand."
    } ]
  }, {
    "tStartMs": 37060,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "It was written in nineteen eighty three,\nand it has not been touched since."
    } ]
  }, {
    "tStartMs": 42340,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Number one. The rate that moved is the\nrate they charge you."
    } ]
  }, {
    "tStartMs": 46260,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "It is not the rate they pay you."
    } ]
  }, {
    "tStartMs": 48580,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "When the Federal Reserve raises rates, two\nnumbers inside your bank are supposed"
    } ]
  }, {
    "tStartMs": 53180,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to move. What you are charged to borrow."
    } ]
  }, {
    "tStartMs": 56320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "What you are paid to save."
    } ]
  }, {
    "tStartMs": 58460,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "One of them moves within days."
    } ]
  }, {
    "tStartMs": 60740,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Your credit card, your overdraft, anything\nwith a variable rate on it, all"
    } ]
  }, {
    "tStartMs": 65500,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "of that reprices almost immediately and\nwithout asking you."
    } ]
  }, {
    "tStartMs": 69380,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "The other one is left alone. There is no\nlaw that forces a bank to pass a rate"
    } ]
  }, {
    "tStartMs": 75040,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "rise on to a saver. There has never been\nsuch a law."
    } ]
  }, {
    "tStartMs": 78960,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "A bank can hold a hundred thousand dollars\nof your money in an account paying"
    } ]
  }, {
    "tStartMs": 82860,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "you almost nothing, lend that same money\nout at a rate that just went up, and"
    } ]
  }, {
    "tStartMs": 87800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "keep the difference."
    } ]
  }, {
    "tStartMs": 89400,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Nobody is breaking a rule. They also know\nwho is least likely to leave."
    } ]
  }, {
    "tStartMs": 94160,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "An account opened in nineteen ninety one,\nby somebody who has banked at the"
    } ]
  }, {
    "tStartMs": 98400,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "same branch for thirty years, is the\nsafest money that bank holds."
    } ]
  }, {
    "tStartMs": 102820,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "It is not going anywhere, so it does not\nhave to be paid for."
    } ]
  }, {
    "tStartMs": 106760,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "Most people assume they are simply getting\na poor rate."
    } ]
  }, {
    "tStartMs": 110020,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "They are not."
    } ]
  }, {
    "tStartMs": 112040,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "They are getting the rate a bank reserves\nfor people it is confident will never"
    } ]
  }, {
    "tStartMs": 116340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "check."
    } ]
  }, {
    "tStartMs": 117620,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Ring your own bank and ask them one\nquestion."
    } ]
  }, {
    "tStartMs": 120960,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "What is the highest rate you pay on\nsavings today, on any account you offer."
    } ]
  }, {
    "tStartMs": 126100,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Then ask which account you are actually\nin."
    } ]
  }, {
    "tStartMs": 129240,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "In a great many cases those are two\ndifferent accounts at the same bank, under"
    } ]
  }, {
    "tStartMs": 133740,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "the same roof, with the same name on the\ndoor."
    } ]
  }, {
    "tStartMs": 136420,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "Number two. On the fourteenth of October a\nnumber is announced, and people"
    } ]
  }, {
    "tStartMs": 141980,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "have already spent it. Your raise for next\nyear is calculated from an inflation"
    } ]
  }, {
    "tStartMs": 147000,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "figure the government publishes on the\nmorning of the fourteenth of October."
    } ]
  }, {
    "tStartMs": 151640,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "The raise is announced the same morning."
    } ]
  }, {
    "tStartMs": 154040,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "The estimates in front of us now are three\nand a half to three point six per"
    } ]
  }, {
    "tStartMs": 157940,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "cent. On an average check that is"
    } ]
  }, {
    "tStartMs": 160340,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "somewhere near seventy five dollars a\nmonth."
    } ]
  }, {
    "tStartMs": 162920,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "That figure is not decided. It is a\nforecast, produced by people outside the"
    } ]
  }, {
    "tStartMs": 167860,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "government, and it has already been\nrevised more than once this year."
    } ]
  }, {
    "tStartMs": 171980,
    "dDurationMs": 4010,
    "segs": [ {
      "utf8": "The only number that will matter is the\none announced on the fourteenth."
    } ]
  }, {
    "tStartMs": 176030,
    "dDurationMs": 1930,
    "segs": [ {
      "utf8": "Here is what happens in the weeks before\nit."
    } ]
  }, {
    "tStartMs": 178300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "People hear seventy five dollars."
    } ]
  }, {
    "tStartMs": 180120,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "They commit it. They agree to a payment\nplan, take on a repair, tell somebody"
    } ]
  }, {
    "tStartMs": 184620,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "they can help. The money is spoken for in\nSeptember and does not arrive until"
    } ]
  }, {
    "tStartMs": 189140,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "January."
    } ]
  }, {
    "tStartMs": 190600,
    "dDurationMs": 2827,
    "segs": [ {
      "utf8": "Do not commit that raise before the\nfourteenth."
    } ]
  }, {
    "tStartMs": 193467,
    "dDurationMs": 3773,
    "segs": [ {
      "utf8": "And after the fourteenth, still do not\ncommit it, because the amount announced"
    } ]
  }, {
    "tStartMs": 197240,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "that morning is not the amount that\nreaches your account."
    } ]
  }, {
    "tStartMs": 200380,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Number three. In November they announce\nwhat they are taking back."
    } ]
  }, {
    "tStartMs": 204140,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "The Medicare premium for next year is not\nannounced in October alongside your"
    } ]
  }, {
    "tStartMs": 208300,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "raise. It is announced in November, weeks\nlater, by a different office."
    } ]
  }, {
    "tStartMs": 213120,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "For this year that premium is two hundred\nand two dollars and ninety cents"
    } ]
  }, {
    "tStartMs": 216560,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "a month, and it comes out of the check\nbefore the check reaches you."
    } ]
  }, {
    "tStartMs": 220440,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "You have never had to pay it. You have\nonly ever had it removed."
    } ]
  }, {
    "tStartMs": 224420,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "The projection for next year in the\nofficial report is two hundred and nine"
    } ]
  }, {
    "tStartMs": 227520,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "dollars and fifty cents. Analysts outside\nthat report expect it to land higher"
    } ]
  }, {
    "tStartMs": 232580,
    "dDurationMs": 3692,
    "segs": [ {
      "utf8": "than the projection, somewhere between two\nhundred and fifteen and two hundred"
    } ]
  }, {
    "tStartMs": 236312,
    "dDurationMs": 1048,
    "segs": [ {
      "utf8": "and nineteen,"
    } ]
  }, {
    "tStartMs": 237400,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "because the official projection has come\nin low more than once in recent years."
    } ]
  }, {
    "tStartMs": 242180,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Put the two announcements next to each\nother."
    } ]
  }, {
    "tStartMs": 244920,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Seventy five dollars arrives in October as\na headline."
    } ]
  }, {
    "tStartMs": 248300,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Somewhere between seven and sixteen\ndollars"
    } ]
  }, {
    "tStartMs": 249940,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "of it is removed in November, quietly,"
    } ]
  }, {
    "tStartMs": 253180,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "in a separate notice, by people who are\nnot the people who announced the raise."
    } ]
  }, {
    "tStartMs": 257600,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "The sequence is doing work."
    } ]
  }, {
    "tStartMs": 259700,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Published on the same morning, a person\nsees a raise of sixty dollars and treats"
    } ]
  }, {
    "tStartMs": 263800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "it as sixty."
    } ]
  }, {
    "tStartMs": 265180,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Published four weeks apart, the same\nperson spends seventy five and is short"
    } ]
  }, {
    "tStartMs": 269320,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "in January without ever understanding\nwhere the gap came from."
    } ]
  }, {
    "tStartMs": 272760,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Number four. There is a law that is\nsupposed to stop this."
    } ]
  }, {
    "tStartMs": 276780,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "It leaves three groups outside it."
    } ]
  }, {
    "tStartMs": 278780,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "It is called hold harmless, and almost no\nolder person in this country has"
    } ]
  }, {
    "tStartMs": 282780,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "heard the phrase."
    } ]
  }, {
    "tStartMs": 284180,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "What it does is this. The rise in your\nMedicare premium cannot be large enough"
    } ]
  }, {
    "tStartMs": 288180,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "to make your January check smaller than\nyour December check."
    } ]
  }, {
    "tStartMs": 291620,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "The premium increase gets cut down to fit\nwhatever raise you were given."
    } ]
  }, {
    "tStartMs": 295400,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "That is a real protection and it has\nstopped real money from being taken."
    } ]
  }, {
    "tStartMs": 299440,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Now the part that is never said in the\nsame breath."
    } ]
  }, {
    "tStartMs": 301620,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Anything else coming out of your check is\noutside it entirely."
    } ]
  }, {
    "tStartMs": 305200,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "And it does not cover everybody."
    } ]
  }, {
    "tStartMs": 307980,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Three groups are outside it. If you are\nnew to Medicare this year, you are"
    } ]
  }, {
    "tStartMs": 311720,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "not covered. There is no December check to\ncompare against, so there is nothing"
    } ]
  }, {
    "tStartMs": 315940,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "to hold you harmless from. If your income\nis above the threshold and you pay"
    } ]
  }, {
    "tStartMs": 320200,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "the higher income-related premium, you are\nnot covered."
    } ]
  }, {
    "tStartMs": 323540,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The protection is written for people\npaying the standard amount."
    } ]
  }, {
    "tStartMs": 326240,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "And if your premium is not deducted from\nyour Social Security check, you are"
    } ]
  }, {
    "tStartMs": 330560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "not covered."
    } ]
  }, {
    "tStartMs": 331840,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "A person who pays Medicare by direct bill,\nor whose premium is handled by their"
    } ]
  }, {
    "tStartMs": 335760,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "state, sits outside the protection without\nbeing told they do."
    } ]
  }, {
    "tStartMs": 339800,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "That third group is the one that catches\npeople, because nothing about being"
    } ]
  }, {
    "tStartMs": 343300,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "moved onto a different payment arrangement\narrives with a warning that a protection"
    } ]
  }, {
    "tStartMs": 347260,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "has just been switched off. The one thing\nworth doing is to know which side"
    } ]
  }, {
    "tStartMs": 351700,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "of it you are on. Look at your award\nletter or your online statement and find"
    } ]
  }, {
    "tStartMs": 355940,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "whether the premium is being deducted from\nthe check."
    } ]
  }, {
    "tStartMs": 358520,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "If it is, the protection reaches you."
    } ]
  }, {
    "tStartMs": 360800,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "If it is not, plan on the full increase."
    } ]
  }, {
    "tStartMs": 363920,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Number five. A number from nineteen eighty\nthree decides whether your raise"
    } ]
  }, {
    "tStartMs": 367700,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "gets taxed, and it has never moved."
    } ]
  }, {
    "tStartMs": 370400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Until nineteen eighty four,"
    } ]
  }, {
    "tStartMs": 372180,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Social Security was not taxed at all."
    } ]
  }, {
    "tStartMs": 374140,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Then Congress decided it would be, above a\ncertain income, and wrote the line"
    } ]
  }, {
    "tStartMs": 378520,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "at twenty five thousand dollars for one\nperson and thirty two thousand for"
    } ]
  }, {
    "tStartMs": 382180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a married couple."
    } ]
  }, {
    "tStartMs": 383640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Those two figures are the same today."
    } ]
  }, {
    "tStartMs": 386200,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "Not similar. The same. They have never\nbeen adjusted for inflation, not once"
    } ]
  }, {
    "tStartMs": 391020,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "in more than forty years, while every\nprice you pay has moved and every raise"
    } ]
  }, {
    "tStartMs": 395300,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "you have been given has moved with it."
    } ]
  }, {
    "tStartMs": 397520,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "Think about what that does over time."
    } ]
  }, {
    "tStartMs": 399060,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "A person who was safely under that line in\nnineteen ninety is over it now,"
    } ]
  }, {
    "tStartMs": 403500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "on the same standard of living, having\ndone nothing except receive the raises"
    } ]
  }, {
    "tStartMs": 407500,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "they were entitled to. The line did not\nrise to meet them."
    } ]
  }, {
    "tStartMs": 410860,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "They were carried across it. And it means\nyour raise can cost you."
    } ]
  }, {
    "tStartMs": 415440,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Seventy five dollars a month is nine\nhundred dollars a year."
    } ]
  }, {
    "tStartMs": 419500,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "For somebody sitting just below twenty\nfive thousand, that raise is what pushes"
    } ]
  }, {
    "tStartMs": 424540,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "them above it, and crossing it brings part\nof a benefit into tax that was not"
    } ]
  }, {
    "tStartMs": 429580,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "taxed the year before. The government does\nnot warn anybody that this is about"
    } ]
  }, {
    "tStartMs": 434040,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "to happen to them. There is no letter."
    } ]
  }, {
    "tStartMs": 436760,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "You find out when you file."
    } ]
  }, {
    "tStartMs": 439440,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "The figure they measure you against is not\nthe number on your tax return."
    } ]
  }, {
    "tStartMs": 443540,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "It is your other income, plus any tax-free\ninterest you receive, plus half"
    } ]
  }, {
    "tStartMs": 448480,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "of your Social Security."
    } ]
  }, {
    "tStartMs": 450700,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Notice what is in there. Half the benefit,\nnot all of it."
    } ]
  }, {
    "tStartMs": 454880,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "And tax-free interest counts, even though\nit is tax-free everywhere else."
    } ]
  }, {
    "tStartMs": 459920,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "So if you are anywhere near that line, the\nfigure to work out before January"
    } ]
  }, {
    "tStartMs": 464140,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "is not what you earn. It is that total."
    } ]
  }, {
    "tStartMs": 468000,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "A preparer will calculate it in minutes,\nmost at no charge, and knowing it"
    } ]
  }, {
    "tStartMs": 472580,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "in October is worth a great deal more than\nfinding it out in April."
    } ]
  }, {
    "tStartMs": 476380,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "Now the line that runs through all five."
    } ]
  }, {
    "tStartMs": 479260,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "Every one of these was published."
    } ]
  }, {
    "tStartMs": 480800,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "The rate decision, the announcement dates,\nthe premium projection, the protection"
    } ]
  }, {
    "tStartMs": 486040,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "and its exclusions, the threshold from\nnineteen eighty three."
    } ]
  }, {
    "tStartMs": 490060,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "All of it is written down and available to\nanybody."
    } ]
  }, {
    "tStartMs": 493780,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Not one of them is going to be sent to\nyou."
    } ]
  }, {
    "tStartMs": 496020,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "That is the whole of the difference."
    } ]
  }, {
    "tStartMs": 498200,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "These are systems built to answer a\nquestion, and not one of them is built"
    } ]
  }, {
    "tStartMs": 502060,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "to ask you whether you knew. One"
    } ]
  }, {
    "tStartMs": 504620,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "correction, because the internet is loud\nthis"
    } ]
  }, {
    "tStartMs": 506520,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "month. A rate rise is not a crisis and\nyour money is not in danger because"
    } ]
  }, {
    "tStartMs": 511660,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "of it. Your deposits are insured exactly\nas they were a fortnight ago."
    } ]
  }, {
    "tStartMs": 516340,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Nothing about your Social Security payment\nchanges because the Federal Reserve"
    } ]
  }, {
    "tStartMs": 520080,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "met. Anybody telling you the banks are\nabout to fail is selling you something,"
    } ]
  }, {
    "tStartMs": 524400,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and it is usually on the screen next to\nthem."
    } ]
  }, {
    "tStartMs": 527960,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The damage here is slower than that and\nmuch more ordinary."
    } ]
  }, {
    "tStartMs": 531500,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "It is a rate that does not move, a raise\nthat is smaller than the headline,"
    } ]
  }, {
    "tStartMs": 535980,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "and a line from nineteen eighty three that\nnobody redrew."
    } ]
  }, {
    "tStartMs": 540520,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So. Five things, and who each one is\narranged for."
    } ]
  }, {
    "tStartMs": 544280,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Your bank will not pass the rate rise on\nand no law requires it to."
    } ]
  }, {
    "tStartMs": 548800,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "The raise is announced on the fourteenth\nof October and not before."
    } ]
  }, {
    "tStartMs": 552920,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "The premium that reduces it is announced\nseparately in November."
    } ]
  }, {
    "tStartMs": 556580,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Hold harmless covers Part B only and\nleaves three groups outside it."
    } ]
  }, {
    "tStartMs": 560640,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "And the tax threshold has sat at twenty\nfive and thirty two thousand since"
    } ]
  }, {
    "tStartMs": 565360,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "nineteen eighty three while everything\nelse moved."
    } ]
  }, {
    "tStartMs": 568620,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "This is education, not advice about your\nown circumstances."
    } ]
  }, {
    "tStartMs": 572620,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Your figures are yours and a preparer who\nsees them will tell you more in ten"
    } ]
  }, {
    "tStartMs": 576500,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "minutes than I can from here. If there is\nsomebody in your family living on"
    } ]
  }, {
    "tStartMs": 580560,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "a fixed amount, they do not need the\nFederal Reserve explained to them."
    } ]
  }, {
    "tStartMs": 584840,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "They need one question asked out loud\nbefore January."
    } ]
  }, {
    "tStartMs": 588220,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Is your Medicare premium coming out of\nyour check, or are you paying it another"
    } ]
  }, {
    "tStartMs": 593220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "way."
    } ]
  } ]
}
