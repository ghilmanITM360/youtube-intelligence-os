{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "62."
    } ]
  }, {
    "tStartMs": 1620,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "That is the age, and almost nobody uses\nit."
    } ]
  }, {
    "tStartMs": 5460,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "Six doors open on your 62nd birthday, and\nalmost every one of you is going"
    } ]
  }, {
    "tStartMs": 10520,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "to sit through three more years without\ntouching them, because 65 is the number"
    } ]
  }, {
    "tStartMs": 15700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "everybody repeats."
    } ]
  }, {
    "tStartMs": 17740,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Here is the one thing to do, and it takes\nan afternoon."
    } ]
  }, {
    "tStartMs": 21340,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Write down the month you turn 62."
    } ]
  }, {
    "tStartMs": 23680,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "Then go through the six on this list and\nfind which ones your state and your"
    } ]
  }, {
    "tStartMs": 28020,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "county actually run. That is all of it."
    } ]
  }, {
    "tStartMs": 31600,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "65 is a Medicare number. It got into\neverybody heads as the retirement number"
    } ]
  }, {
    "tStartMs": 36440,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "because Medicare is the loudest letter\nthat ever arrives, and the rest of the"
    } ]
  }, {
    "tStartMs": 41160,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "system never corrected it. Before you\ndecide you are too young for this."
    } ]
  }, {
    "tStartMs": 46760,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "If you are 62, 63 or 64 right now, every\nday you wait is money"
    } ]
  }, {
    "tStartMs": 53000,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "that was sitting there. And if you are\nalready past 65, you want this for a"
    } ]
  }, {
    "tStartMs": 58360,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "different reason:"
    } ]
  }, {
    "tStartMs": 59700,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "You may have paid three years of something\nthat stopped being required when"
    } ]
  }, {
    "tStartMs": 63700,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "you turned 62, and nobody sent the refund."
    } ]
  }, {
    "tStartMs": 67840,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Six doors. I will name each one out loud\nas we come to it."
    } ]
  }, {
    "tStartMs": 72120,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "The fifth one is a door that opens at 62,\nand I am going to tell you to walk"
    } ]
  }, {
    "tStartMs": 77240,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "past it. Two names you will hear."
    } ]
  }, {
    "tStartMs": 79700,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "A county assessor is the office that\ndecides what your house is worth for tax."
    } ]
  }, {
    "tStartMs": 85540,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "Section 202 is the name of the federal\nprogram that builds housing for older"
    } ]
  }, {
    "tStartMs": 90360,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "people."
    } ]
  }, {
    "tStartMs": 92040,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "Door number one. Georgia stops taxing\n$35,000 of your retirement income at"
    } ]
  }, {
    "tStartMs": 97900,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "62."
    } ]
  }, {
    "tStartMs": 99180,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Start with the one that moves the most\nmoney."
    } ]
  }, {
    "tStartMs": 102780,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "Georgia law takes retirement income out of\nstate tax by age, in two steps."
    } ]
  }, {
    "tStartMs": 108300,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "From 62 to 64, each person takes up to\n$35,000 out."
    } ]
  }, {
    "tStartMs": 114640,
    "dDurationMs": 3228,
    "segs": [ {
      "utf8": "At 65 it goes up to $65,000."
    } ]
  }, {
    "tStartMs": 118620,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Retirement income here means what you\nwould expect."
    } ]
  }, {
    "tStartMs": 121700,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "A pension. Money drawn from a retirement\naccount."
    } ]
  }, {
    "tStartMs": 124920,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Interest, dividends, rent. Capital gains\nwhen you sell something."
    } ]
  }, {
    "tStartMs": 129960,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Read the next part carefully, because this\nis where couples lose money."
    } ]
  }, {
    "tStartMs": 133660,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "The exclusion belongs to each person\nseparately."
    } ]
  }, {
    "tStartMs": 137240,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It does not pool."
    } ]
  }, {
    "tStartMs": 139240,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "A husband of 66 and a wife of 63 do not\nshare one pot."
    } ]
  }, {
    "tStartMs": 144120,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "He takes $65,000 against his own income."
    } ]
  }, {
    "tStartMs": 147100,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "She takes $35,000 against hers."
    } ]
  }, {
    "tStartMs": 149800,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "If the income is all in his name, hers\ngoes unused."
    } ]
  }, {
    "tStartMs": 153600,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "One limit, said plainly."
    } ]
  }, {
    "tStartMs": 155880,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "No more than $5,000 of that exclusion can\ncome from wages."
    } ]
  }, {
    "tStartMs": 159560,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "So if you still work, the wage part is\ncapped, and everything else still counts."
    } ]
  }, {
    "tStartMs": 165240,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "And it has nothing to do with whether you\nstopped working."
    } ]
  }, {
    "tStartMs": 168440,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "A 63 year old still on the job qualifies\non age alone."
    } ]
  }, {
    "tStartMs": 172840,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Do this one first."
    } ]
  }, {
    "tStartMs": 174600,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Find out whose name the pension and the\naccounts are in."
    } ]
  }, {
    "tStartMs": 178120,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "If it is all in one name and one of you is\npast 62, that is a conversation"
    } ]
  }, {
    "tStartMs": 182840,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "with whoever does your return, this year,\nnot next."
    } ]
  }, {
    "tStartMs": 186660,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "Door number two. In some Georgia counties\nthe whole school tax comes off at"
    } ]
  }, {
    "tStartMs": 191900,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "62."
    } ]
  }, {
    "tStartMs": 193040,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Now the biggest line on your property tax\nbill, and most people have never"
    } ]
  }, {
    "tStartMs": 196680,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "looked at it separately. Your property tax\nis not one charge."
    } ]
  }, {
    "tStartMs": 200700,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "It is a stack, and in most of this country\nthe school district takes the largest"
    } ]
  }, {
    "tStartMs": 204980,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "slice of it. The rest is county, city, and\nwhatever special districts you sit"
    } ]
  }, {
    "tStartMs": 209740,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "inside."
    } ]
  }, {
    "tStartMs": 211040,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "In Cobb County, Georgia, a homeowner of 62\nor older has the entire school portion"
    } ]
  }, {
    "tStartMs": 216120,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "removed. Not reduced. Removed."
    } ]
  }, {
    "tStartMs": 219440,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "It covers the school general tax and the\nschool bond tax, and your income never"
    } ]
  }, {
    "tStartMs": 223860,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "enters into it. Hear that last part again,\nbecause it is the opposite of what"
    } ]
  }, {
    "tStartMs": 228320,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "people assume. A retired teacher and a\nretired surgeon get the same answer."
    } ]
  }, {
    "tStartMs": 234140,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Now the trap, and it is a date."
    } ]
  }, {
    "tStartMs": 236800,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "You have to be 62 on or before the first\nof January of that tax year."
    } ]
  }, {
    "tStartMs": 241640,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Turn 62 on the fifteenth of January and\nyou wait until the following year."
    } ]
  }, {
    "tStartMs": 246640,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Two weeks of birthday costs a whole year\nof school tax."
    } ]
  }, {
    "tStartMs": 250720,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "And it does not arrive on its own."
    } ]
  }, {
    "tStartMs": 252880,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "You file for it, and in Cobb the deadline\nis the first of April."
    } ]
  }, {
    "tStartMs": 257440,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Go and find your own bill. Look for the\nline that says school."
    } ]
  }, {
    "tStartMs": 261400,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "That number is what is on the table, and\nwhether your county does what Cobb"
    } ]
  }, {
    "tStartMs": 264980,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "does is one telephone call to the tax\ncommissioner."
    } ]
  }, {
    "tStartMs": 268740,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Door number three."
    } ]
  }, {
    "tStartMs": 270220,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "The federal parks pass costs $80 once, at\n62."
    } ]
  }, {
    "tStartMs": 274380,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "A small one, and it is the easiest thing\non this list to actually get."
    } ]
  }, {
    "tStartMs": 278700,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "At 62, a citizen or permanent resident can\nbuy a lifetime pass to the federal"
    } ]
  }, {
    "tStartMs": 283160,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "recreation sites. $80, once, for the rest\nof your life."
    } ]
  }, {
    "tStartMs": 287760,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "There is a yearly version at $20 if you\nwould rather."
    } ]
  }, {
    "tStartMs": 290760,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "What it covers is wider than people think."
    } ]
  }, {
    "tStartMs": 292800,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "It admits the holder and everybody else in\nthe same vehicle."
    } ]
  }, {
    "tStartMs": 296720,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So the grandchildren in the back seat come\nin on your pass."
    } ]
  }, {
    "tStartMs": 300540,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "It also takes half off some of the fees\nyou pay once you are inside."
    } ]
  }, {
    "tStartMs": 304520,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Camping. Swimming. A boat launch."
    } ]
  }, {
    "tStartMs": 307160,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Your income never comes into it, and there\nis nothing to be approved for."
    } ]
  }, {
    "tStartMs": 311280,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Age and citizenship, and that is the list."
    } ]
  }, {
    "tStartMs": 314120,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "This is the one on here you can finish\nthis week."
    } ]
  }, {
    "tStartMs": 316720,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Proof of age, proof of citizenship, $80,\ndone."
    } ]
  }, {
    "tStartMs": 320360,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "And at 62 rather than 65, that is three\nextra years of something you already"
    } ]
  }, {
    "tStartMs": 325980,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "paid for through taxes your whole working\nlife."
    } ]
  }, {
    "tStartMs": 329180,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "Door number four. Federal senior housing\nopens at 62, and the waiting list"
    } ]
  }, {
    "tStartMs": 334480,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "is the reason to start now. Here is the\none with the longest clock on it."
    } ]
  }, {
    "tStartMs": 339580,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Section 202 is federal housing built\nspecifically for older people."
    } ]
  }, {
    "tStartMs": 344080,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "One person in the household has to be 62."
    } ]
  }, {
    "tStartMs": 346660,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Household income generally has to sit at\nor below half of what is normal for"
    } ]
  }, {
    "tStartMs": 351260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "your county."
    } ]
  }, {
    "tStartMs": 352540,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "What you pay is the part worth hearing."
    } ]
  }, {
    "tStartMs": 355140,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Rent is set at roughly 30% of your\nadjusted income."
    } ]
  }, {
    "tStartMs": 358240,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Not 30% of a market rent. 30% of what you\nactually have coming in."
    } ]
  }, {
    "tStartMs": 363340,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Now the part that decides whether this is\nany use to you."
    } ]
  }, {
    "tStartMs": 366300,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "There is no national waiting list."
    } ]
  }, {
    "tStartMs": 368340,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "You apply at each individual property, one\nat a time, to the people who manage"
    } ]
  }, {
    "tStartMs": 372660,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "that building. And those lists run long,\nsometimes years."
    } ]
  }, {
    "tStartMs": 376780,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Which is exactly why the age matters."
    } ]
  }, {
    "tStartMs": 379660,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "62 is when your name is allowed on the\nlist."
    } ]
  }, {
    "tStartMs": 382560,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "If you wait until 65 because that is the\nnumber you had in your head, you have"
    } ]
  }, {
    "tStartMs": 386860,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "put yourself three years further back in a\nqueue that moves slowly."
    } ]
  }, {
    "tStartMs": 390720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Two honest limits. This is housing, and\nhousing only."
    } ]
  }, {
    "tStartMs": 394360,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Assisted living and nursing homes run on\nan entirely separate system."
    } ]
  }, {
    "tStartMs": 397560,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "And at 60 or 61 there are other doors open\nto you, just a different set."
    } ]
  }, {
    "tStartMs": 403260,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Door number five. The reverse mortgage\ndoor opens at 62, and I want you to"
    } ]
  }, {
    "tStartMs": 407900,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "walk past it. Here is the one I promised\nyou, and it is the only item on this"
    } ]
  }, {
    "tStartMs": 411960,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "list where my advice is to do nothing."
    } ]
  }, {
    "tStartMs": 414640,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "The federally insured reverse mortgage\nrequires the youngest borrower to be"
    } ]
  }, {
    "tStartMs": 418360,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "62. Not 62 when you apply. 62 on the day\nthe loan closes."
    } ]
  }, {
    "tStartMs": 423060,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "So the door is open. That is a fact, and\nit belongs on a list about 62."
    } ]
  }, {
    "tStartMs": 428720,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Now the part the advertisements leave at\nthe end."
    } ]
  }, {
    "tStartMs": 431540,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "How much you can draw is set partly by\nyour age, and younger borrowers get"
    } ]
  }, {
    "tStartMs": 435560,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "a smaller share of the house. At 62 you\nare at the bottom of that scale."
    } ]
  }, {
    "tStartMs": 440160,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "You are borrowing against the house at the\nworst rate the product offers, and"
    } ]
  }, {
    "tStartMs": 443820,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "interest runs on it for the longest\nstretch of your life."
    } ]
  }, {
    "tStartMs": 446640,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "And if your husband or wife is under 62,\nthey cannot be a borrower."
    } ]
  }, {
    "tStartMs": 451620,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "There are protections for them, and those\nprotections cut the amount you can"
    } ]
  }, {
    "tStartMs": 456080,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "take. So understand what 62 means here."
    } ]
  }, {
    "tStartMs": 459360,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "It is not the age this becomes a good\nidea."
    } ]
  }, {
    "tStartMs": 461900,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "It is the earliest age the paperwork will\nlet you do it, which is a different"
    } ]
  }, {
    "tStartMs": 466380,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "thing entirely. If you are being\ntelephoned about this, the person ringing"
    } ]
  }, {
    "tStartMs": 470540,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "you works on commission. Whether a reverse\nmortgage ever makes sense for your"
    } ]
  }, {
    "tStartMs": 474820,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "household is a question for a counsellor\napproved by the housing department,"
    } ]
  }, {
    "tStartMs": 479380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and that counselling is required anyway."
    } ]
  }, {
    "tStartMs": 482280,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Go to it before anybody sells you\nanything."
    } ]
  }, {
    "tStartMs": 485180,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "Door number six. Two states let you stop\npaying property tax at 62 and settle"
    } ]
  }, {
    "tStartMs": 490380,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "it later. The last one, and it is the one\npeople confuse with an exemption."
    } ]
  }, {
    "tStartMs": 495320,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "California runs a property tax\npostponement programme."
    } ]
  }, {
    "tStartMs": 498780,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "You have to be 62 or older. For the\ncurrent cycle, household income has to"
    } ]
  }, {
    "tStartMs": 503680,
    "dDurationMs": 6140,
    "segs": [ {
      "utf8": "be $57,002 or below, and you generally\nneed at least 40% equity in the home."
    } ]
  }, {
    "tStartMs": 510660,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Several Missouri counties do something\nsimilar at 62."
    } ]
  }, {
    "tStartMs": 514280,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Saint Charles and Clay both use that age,\nmeasured as of the first of January."
    } ]
  }, {
    "tStartMs": 519320,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Now the word postponement, because it is\ndoing real work in that sentence."
    } ]
  }, {
    "tStartMs": 523540,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "The state pays the bill for you and puts a\nclaim on the house."
    } ]
  }, {
    "tStartMs": 527240,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "It comes back when the house is sold or\nwhen the estate settles."
    } ]
  }, {
    "tStartMs": 530640,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The money is not forgiven. It is moved."
    } ]
  }, {
    "tStartMs": 534380,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "That makes this the right answer for\nexactly one situation."
    } ]
  }, {
    "tStartMs": 538020,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "You are house rich and cash poor, the tax\nbill is what is squeezing you every"
    } ]
  }, {
    "tStartMs": 542820,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "year, and you would rather your heirs\nsettle it out of the sale than lose the"
    } ]
  }, {
    "tStartMs": 546800,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "house now. And it makes it the wrong"
    } ]
  }, {
    "tStartMs": 548940,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "answer if your family is counting on\ninheriting"
    } ]
  }, {
    "tStartMs": 551220,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "the house clear. Either way, the age is\n62, and the deadline is annual."
    } ]
  }, {
    "tStartMs": 556480,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "You apply every year, and missing the\nwindow means missing that year."
    } ]
  }, {
    "tStartMs": 561240,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "The same shape sits under all six."
    } ]
  }, {
    "tStartMs": 563780,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Every one of them waits for you to arrive."
    } ]
  }, {
    "tStartMs": 566100,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "The parks office stays silent."
    } ]
  }, {
    "tStartMs": 568120,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "The county reads its own records and your\nbirthday is in somebody else files."
    } ]
  }, {
    "tStartMs": 572400,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "The housing list grows from applications,\nand yours has to be one of them."
    } ]
  }, {
    "tStartMs": 576600,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The Georgia exclusion sits on a form in\nyour own handwriting."
    } ]
  }, {
    "tStartMs": 579560,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "And every one of them was built with a\ndifferent age in mind by a different"
    } ]
  }, {
    "tStartMs": 583780,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "body, which is why they do not line up\nwith each other and why nobody ever"
    } ]
  }, {
    "tStartMs": 587860,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "handed you a single list."
    } ]
  }, {
    "tStartMs": 589960,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "65 is not the retirement age. It is the\nMedicare age, and those two things"
    } ]
  }, {
    "tStartMs": 594700,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "got confused somewhere around 1965 and\nhave stayed confused ever since."
    } ]
  }, {
    "tStartMs": 600020,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Here is the edge of what I can tell you."
    } ]
  }, {
    "tStartMs": 602180,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "I do not know your state, your county or\nyour income, and those three decide"
    } ]
  }, {
    "tStartMs": 606640,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "most of what is above. The Georgia figures\nand the California income line come"
    } ]
  }, {
    "tStartMs": 611220,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "from tax guides rather than from the state\noffices themselves,"
    } ]
  }, {
    "tStartMs": 615320,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "so check your own number before you rely\non it."
    } ]
  }, {
    "tStartMs": 618900,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "What any of this means for your household\nis a matter for whoever prepares"
    } ]
  }, {
    "tStartMs": 622400,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "your return and for your own county\noffice."
    } ]
  }, {
    "tStartMs": 625280,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "The six doors, in order, before you go."
    } ]
  }, {
    "tStartMs": 628300,
    "dDurationMs": 5980,
    "segs": [ {
      "utf8": "Georgia takes $35,000 of retirement income\nout of state tax from 62, and it"
    } ]
  }, {
    "tStartMs": 634280,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "belongs to each person, not to the couple."
    } ]
  }, {
    "tStartMs": 636620,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "In Cobb County the entire school portion\nof the property tax comes off at 62"
    } ]
  }, {
    "tStartMs": 642000,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "with no income limit, but you must be 62\nby the first of January and you must"
    } ]
  }, {
    "tStartMs": 647300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "file by April."
    } ]
  }, {
    "tStartMs": 649020,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "The federal parks pass is $80 once, for\nlife, and it admits everybody in your"
    } ]
  }, {
    "tStartMs": 654080,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "car."
    } ]
  }, {
    "tStartMs": 655140,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "Section 202 housing opens at 62 and rent\nis about 30% of your income, which"
    } ]
  }, {
    "tStartMs": 660700,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "is why the waiting list is the reason to\napply now rather than later."
    } ]
  }, {
    "tStartMs": 664420,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "The reverse mortgage door opens at 62 and\nthat is the earliest age, not the"
    } ]
  }, {
    "tStartMs": 670120,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "right one. And California and some"
    } ]
  }, {
    "tStartMs": 672320,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "Missouri counties let you postpone\nproperty"
    } ]
  }, {
    "tStartMs": 674380,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "tax from 62, which moves the bill rather\nthan cancelling it."
    } ]
  }, {
    "tStartMs": 678780,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "All of it sits on public pages, free, for\nanybody who goes looking."
    } ]
  }, {
    "tStartMs": 683060,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "It catches careful people anyway, because\nnothing arrives in the post telling"
    } ]
  }, {
    "tStartMs": 687280,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "you a door has opened. Now the telephone,\nand this part is not optional."
    } ]
  }, {
    "tStartMs": 691580,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "If somebody rings offering to claim any of\nthese for you for a fee, put the"
    } ]
  }, {
    "tStartMs": 696300,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "handset down. Every one of them is free to\napply for, and the offices that"
    } ]
  }, {
    "tStartMs": 700520,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "run them do not use salespeople."
    } ]
  }, {
    "tStartMs": 702920,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "And if one of your parents is 62, 63 or 64\nright now, do not send them this."
    } ]
  }, {
    "tStartMs": 709220,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Sit beside them with their tax bill and\nfind the school line together."
    } ]
  }, {
    "tStartMs": 713080,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "It takes an afternoon, and the three years\nthey are about to lose do not come"
    } ]
  }, {
    "tStartMs": 717260,
    "dDurationMs": 797,
    "segs": [ {
      "utf8": "back."
    } ]
  } ]
}
