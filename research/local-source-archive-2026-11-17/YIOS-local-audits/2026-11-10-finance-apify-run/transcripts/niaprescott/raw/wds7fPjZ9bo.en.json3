{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "The house is paid off and you still owe\nmoney on it every single year."
    } ]
  }, {
    "tStartMs": 5160,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Fall far enough behind and the county\nsells it out from under you."
    } ]
  }, {
    "tStartMs": 9520,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "That is your property tax. It is the bill\nthat keeps arriving long after the"
    } ]
  }, {
    "tStartMs": 14680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "mortgage is gone."
    } ]
  }, {
    "tStartMs": 16560,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Six charges on that bill can come off\nafter sixty five."
    } ]
  }, {
    "tStartMs": 20960,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "The number the county guessed about your\nhouse."
    } ]
  }, {
    "tStartMs": 23860,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The mistakes on the paper the county\nkeeps."
    } ]
  }, {
    "tStartMs": 26760,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "The veteran exemption that takes the bill\ndown to nothing."
    } ]
  }, {
    "tStartMs": 30000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The exemption that does not die with your\nhusband."
    } ]
  }, {
    "tStartMs": 33580,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The exemption that drops off the record\nwithout a word."
    } ]
  }, {
    "tStartMs": 36880,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "And the exemption that stays behind at the\nold house when you move."
    } ]
  }, {
    "tStartMs": 41300,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Not one of the six happens by itself."
    } ]
  }, {
    "tStartMs": 43980,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Not one is ever offered to you."
    } ]
  }, {
    "tStartMs": 46320,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "The office that sends the bill is the same\noffice that decides whether to mention"
    } ]
  }, {
    "tStartMs": 50600,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "them, and it does not."
    } ]
  }, {
    "tStartMs": 52960,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Six charges. What each one is, and what\nthe silence has cost you already."
    } ]
  }, {
    "tStartMs": 58420,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Number one is the number the county\nguessed about your house."
    } ]
  }, {
    "tStartMs": 62360,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Your property tax is not a price anybody\nset for you."
    } ]
  }, {
    "tStartMs": 65600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It is a percentage."
    } ]
  }, {
    "tStartMs": 67280,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Somebody decides what your house is worth,\nand the tax is a slice of that figure."
    } ]
  }, {
    "tStartMs": 72280,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "So the whole bill rests on one number, and\nthat number is a guess."
    } ]
  }, {
    "tStartMs": 77220,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Nobody walks through your house."
    } ]
  }, {
    "tStartMs": 79140,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Nobody measures your rooms."
    } ]
  }, {
    "tStartMs": 81100,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "A county office looks at what houses near\nyou sold for, applies a formula,"
    } ]
  }, {
    "tStartMs": 85500,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "and prints a figure. If three houses on\nyour street sold high last year, your"
    } ]
  }, {
    "tStartMs": 90680,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "figure rises, even though nothing about\nyour house changed."
    } ]
  }, {
    "tStartMs": 94600,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "You are allowed to fight that figure."
    } ]
  }, {
    "tStartMs": 97100,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Every state has a way to do it."
    } ]
  }, {
    "tStartMs": 99300,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Very few homeowners over sixty five ever\ndo, and there is one reason."
    } ]
  }, {
    "tStartMs": 104060,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "The clock does not start when the bill\narrives."
    } ]
  }, {
    "tStartMs": 106860,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "The county sends you a paper before the\nbill."
    } ]
  }, {
    "tStartMs": 109720,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "It is not a bill. It asks you for nothing."
    } ]
  }, {
    "tStartMs": 112900,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "It says what they have decided your house\nis worth this year."
    } ]
  }, {
    "tStartMs": 117740,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Most people look at it, see that no\npayment is due, and set it aside."
    } ]
  }, {
    "tStartMs": 122740,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "That paper is the starting gun."
    } ]
  }, {
    "tStartMs": 125460,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "In most places you have thirty to forty\nfive days from the date printed on"
    } ]
  }, {
    "tStartMs": 129720,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "it, and the deadline is printed on that\nsame paper."
    } ]
  }, {
    "tStartMs": 132940,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Not on the bill. On the sheet that came\nmonths earlier and wanted no money"
    } ]
  }, {
    "tStartMs": 137740,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "from you."
    } ]
  }, {
    "tStartMs": 139060,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "So the year runs like this. The paper\ncomes in the spring and you ignore it,"
    } ]
  }, {
    "tStartMs": 143920,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "because it is not a bill."
    } ]
  }, {
    "tStartMs": 146000,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The bill comes in the fall and now you are\nangry."
    } ]
  }, {
    "tStartMs": 149160,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "You telephone the county to argue, and\nwhoever answers tells you the window"
    } ]
  }, {
    "tStartMs": 152920,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "shut four months ago and you may not\nchallenge anything until next year."
    } ]
  }, {
    "tStartMs": 157800,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "That is a full year of paying on a figure\nyou never agreed with."
    } ]
  }, {
    "tStartMs": 161820,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "And a guess left unchallenged becomes the\nstarting point for the guess after"
    } ]
  }, {
    "tStartMs": 166080,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "it. It builds against you every year you\nwait for a bill to argue about."
    } ]
  }, {
    "tStartMs": 171020,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Number two is the paper the county keeps\non your house, and the mistakes sitting"
    } ]
  }, {
    "tStartMs": 175320,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "on it. Behind that guess is a record."
    } ]
  }, {
    "tStartMs": 178520,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "The county holds a sheet on your property\nlisting what they believe is there."
    } ]
  }, {
    "tStartMs": 182940,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "How many square feet. How many bedrooms\nand bathrooms."
    } ]
  }, {
    "tStartMs": 186660,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Whether there is a garage or a finished\nbasement."
    } ]
  }, {
    "tStartMs": 189820,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "You are allowed to see it and it costs\nnothing."
    } ]
  }, {
    "tStartMs": 192540,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "Most counties put it on a website now, and\nif yours does not, you may telephone"
    } ]
  }, {
    "tStartMs": 197740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "and ask for a copy of the record on your\nproperty."
    } ]
  }, {
    "tStartMs": 201380,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Very few homeowners over sixty five have\never asked to see theirs."
    } ]
  }, {
    "tStartMs": 205380,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The errors are more common than people\nexpect."
    } ]
  }, {
    "tStartMs": 208980,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "County records carry the wrong square\nfootage far more often than homeowners"
    } ]
  }, {
    "tStartMs": 213440,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "believe. Sometimes the builder reported it\nwrong forty years ago."
    } ]
  }, {
    "tStartMs": 218360,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Sometimes an office estimated instead of\nmeasuring."
    } ]
  }, {
    "tStartMs": 222060,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Sometimes a shed was taken down twenty\nyears ago and is still sitting on the"
    } ]
  }, {
    "tStartMs": 226580,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "record, still being taxed. Every one of\nthose errors has been on your bill"
    } ]
  }, {
    "tStartMs": 231220,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "every year since it was made. And this is\nthe strongest kind of challenge there"
    } ]
  }, {
    "tStartMs": 235960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "is, because it is not an opinion."
    } ]
  }, {
    "tStartMs": 238660,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "Arguing that your house is worth less than\nthe county says is a judgement,"
    } ]
  }, {
    "tStartMs": 244160,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "and a judgement can be waved away."
    } ]
  }, {
    "tStartMs": 247780,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Showing that the county has you down for\nfour hundred more square feet than"
    } ]
  }, {
    "tStartMs": 251980,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "the house actually has is a fact."
    } ]
  }, {
    "tStartMs": 255080,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Nobody can argue with a measurement."
    } ]
  }, {
    "tStartMs": 257900,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Many counties will correct a clear"
    } ]
  }, {
    "tStartMs": 259780,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "measurement error without any formal\nhearing."
    } ]
  }, {
    "tStartMs": 263460,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "You telephone, you show them, they fix it."
    } ]
  }, {
    "tStartMs": 266780,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "And in some places the correction reaches\nbackwards."
    } ]
  }, {
    "tStartMs": 270420,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Where the mistake counts as a clerical\nerror rather than a difference of opinion,"
    } ]
  }, {
    "tStartMs": 275380,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "some states return money for prior years,\nnot only for the year you caught"
    } ]
  }, {
    "tStartMs": 279780,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "it. Number three is the veteran exemption\nthat takes the bill down to nothing."
    } ]
  }, {
    "tStartMs": 285560,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "This is the largest amount of money in\nthis video, and the one most often missed,"
    } ]
  }, {
    "tStartMs": 290320,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "because the families who qualify assume it\nmust be a small discount."
    } ]
  }, {
    "tStartMs": 295260,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Twenty two states charge no property tax\nat all on the home of a veteran rated"
    } ]
  }, {
    "tStartMs": 300260,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "totally and permanently disabled by the\nVeterans Administration."
    } ]
  }, {
    "tStartMs": 304660,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Not a reduction. Not a percentage off."
    } ]
  }, {
    "tStartMs": 307820,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Nothing. The bill goes to zero."
    } ]
  }, {
    "tStartMs": 310820,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Texas, Florida and Virginia are among\nthem, and in most cases the rating has"
    } ]
  }, {
    "tStartMs": 315820,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "to be one hundred percent. Now the part\nthat gets lost, and it is why this"
    } ]
  }, {
    "tStartMs": 320960,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "item sits so high. In most of those states\nthe exemption does not end when"
    } ]
  }, {
    "tStartMs": 326060,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "the veteran dies. It passes to his widow."
    } ]
  }, {
    "tStartMs": 328900,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "In Texas, the surviving spouse of"
    } ]
  }, {
    "tStartMs": 331840,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "a veteran rated totally and permanently\ndisabled"
    } ]
  }, {
    "tStartMs": 334360,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "keeps the full exemption for life on that\nsame home."
    } ]
  }, {
    "tStartMs": 338580,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "In Florida she keeps it until she sells or\nmarries again."
    } ]
  }, {
    "tStartMs": 342860,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "Virginia works the same way. What happens\nif she marries again differs by state,"
    } ]
  }, {
    "tStartMs": 348260,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and that is worth asking directly."
    } ]
  }, {
    "tStartMs": 350640,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "But she has to ask. It does not carry over\non its own."
    } ]
  }, {
    "tStartMs": 355100,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Nobody reads a death certificate and\nadjusts the account."
    } ]
  }, {
    "tStartMs": 358140,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "So think about the woman this happens to."
    } ]
  }, {
    "tStartMs": 361580,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Her husband served."
    } ]
  }, {
    "tStartMs": 363460,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "He was rated totally disabled."
    } ]
  }, {
    "tStartMs": 366100,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "For fifteen years the house was taxed at\nnothing."
    } ]
  }, {
    "tStartMs": 370140,
    "dDurationMs": 5760,
    "segs": [ {
      "utf8": "He dies. And a bill arrives that she has\nnot seen in fifteen years, for thousands"
    } ]
  }, {
    "tStartMs": 375900,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "of dollars, in the month she buried him."
    } ]
  }, {
    "tStartMs": 379100,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "She assumes it is correct. She assumes the\nbreak was his and died with him."
    } ]
  }, {
    "tStartMs": 384740,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "So she starts paying, out of a widow"
    } ]
  }, {
    "tStartMs": 387520,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "pension, on a house that was never\nsupposed"
    } ]
  }, {
    "tStartMs": 390220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to be taxed at all."
    } ]
  }, {
    "tStartMs": 392280,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "If that is your house, or the house your\nmother lives in, make that call this"
    } ]
  }, {
    "tStartMs": 397020,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "week."
    } ]
  }, {
    "tStartMs": 398180,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "Number four is the ordinary age exemption,\nand the same trap underneath it."
    } ]
  }, {
    "tStartMs": 403720,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "Set the veterans aside now, because this\none reaches many more households."
    } ]
  }, {
    "tStartMs": 409480,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "Almost every state gives homeowners a\nbreak on property tax once they reach"
    } ]
  }, {
    "tStartMs": 414320,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "sixty five."
    } ]
  }, {
    "tStartMs": 415940,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Some call it a senior exemption."
    } ]
  }, {
    "tStartMs": 418340,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Some call it a freeze, which locks the\ntaxable value where it stood the year"
    } ]
  }, {
    "tStartMs": 422740,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "you signed up, so your bill stops climbing\nwhile every other house on the street"
    } ]
  }, {
    "tStartMs": 427380,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "keeps rising."
    } ]
  }, {
    "tStartMs": 429180,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "Almost no household knows the next part."
    } ]
  }, {
    "tStartMs": 432300,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "In many of them only one name holds the\nbreak."
    } ]
  }, {
    "tStartMs": 436200,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Whichever spouse turned sixty five first\napplied, and the break sits under"
    } ]
  }, {
    "tStartMs": 440620,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "that name alone. When that spouse dies,\nthe county drops it."
    } ]
  }, {
    "tStartMs": 445300,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Not out of malice. The account simply\nloses the person it was attached to,"
    } ]
  }, {
    "tStartMs": 449740,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "and the next bill comes at full price."
    } ]
  }, {
    "tStartMs": 453380,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "But the law in many states says she keeps\nit."
    } ]
  }, {
    "tStartMs": 457300,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "In Texas, a surviving spouse who is fifty\nfive or older on the day her husband"
    } ]
  }, {
    "tStartMs": 462620,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "dies may keep his over sixty five\nexemption on that same home."
    } ]
  }, {
    "tStartMs": 468000,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "New Jersey uses the same age. Washington\nlets a surviving spouse qualify for"
    } ]
  }, {
    "tStartMs": 473180,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "the freeze at fifty seven instead of the\nusual age."
    } ]
  }, {
    "tStartMs": 476800,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Fifty five. Not sixty five."
    } ]
  }, {
    "tStartMs": 479560,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "A woman of fifty eight who has just buried\nher husband is old enough to keep"
    } ]
  }, {
    "tStartMs": 484240,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "his break, and she will almost certainly\nnever be told so."
    } ]
  }, {
    "tStartMs": 488780,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "What she must do is file a new application\nin her own name."
    } ]
  }, {
    "tStartMs": 493300,
    "dDurationMs": 6060,
    "segs": [ {
      "utf8": "It is not automatic. And the year she\nspends not knowing is a year she pays"
    } ]
  }, {
    "tStartMs": 499360,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "a full bill on an income that has just\nlost half of itself."
    } ]
  }, {
    "tStartMs": 504060,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "If you are widowed and your bill jumped\nafter your husband died, that jump"
    } ]
  }, {
    "tStartMs": 508900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "has a name and it may be reversible."
    } ]
  }, {
    "tStartMs": 512260,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Telephone the county, ask whether his age\nexemption can be continued in your"
    } ]
  }, {
    "tStartMs": 516840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "name, and say your age when you ask."
    } ]
  }, {
    "tStartMs": 520320,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Number five is the exemption that drops\noff the record without a word."
    } ]
  }, {
    "tStartMs": 525160,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Most people believe that once an exemption\nis on the house it stays there."
    } ]
  }, {
    "tStartMs": 529580,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "For the most part that is true."
    } ]
  }, {
    "tStartMs": 531920,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "In most places you apply once and you are\nnot asked again every year."
    } ]
  }, {
    "tStartMs": 536760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "But there is a check underneath it that\nnobody explains."
    } ]
  }, {
    "tStartMs": 540200,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "County offices are required to review\ntheir exemption records on a cycle."
    } ]
  }, {
    "tStartMs": 544640,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "In Texas the appraisal districts must\naudit every five years to confirm the"
    } ]
  }, {
    "tStartMs": 549580,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "people claiming exemptions still qualify."
    } ]
  }, {
    "tStartMs": 552160,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "If the office cannot confirm it from what\nthey hold, they are required to ask"
    } ]
  }, {
    "tStartMs": 556460,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "the owner to apply again."
    } ]
  }, {
    "tStartMs": 558780,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "That request goes out in the post."
    } ]
  }, {
    "tStartMs": 561200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "If it is missed, the exemption comes off."
    } ]
  }, {
    "tStartMs": 564580,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Think about who misses post. Someone who\nspent three weeks in hospital."
    } ]
  }, {
    "tStartMs": 569260,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Someone who spent a winter at the home of\na daughter."
    } ]
  }, {
    "tStartMs": 572440,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The break falls away and nothing announces\nit."
    } ]
  }, {
    "tStartMs": 575780,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "The next bill is simply larger."
    } ]
  }, {
    "tStartMs": 577840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "And that is exactly how it gets read."
    } ]
  }, {
    "tStartMs": 580860,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Taxes went up again. It goes on the pile\nwith everything else that costs more"
    } ]
  }, {
    "tStartMs": 585480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "this year."
    } ]
  }, {
    "tStartMs": 586860,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "There is one place it does announce\nitself,"
    } ]
  }, {
    "tStartMs": 588980,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "and you have to know where to look."
    } ]
  }, {
    "tStartMs": 591360,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "When a county removes or denies an\nexemption they send a notice, and the time"
    } ]
  }, {
    "tStartMs": 596260,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "to challenge that removal is short."
    } ]
  }, {
    "tStartMs": 598960,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "In Gwinnett County in Georgia it is forty\nfive days from the date on that notice."
    } ]
  }, {
    "tStartMs": 604060,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "So this is the check to run this month."
    } ]
  }, {
    "tStartMs": 607320,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "Find your last property tax bill and look\ndown it for a line that says exemption,"
    } ]
  }, {
    "tStartMs": 613240,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "and for the amount taken off. If that line\nis missing, or the amount is smaller"
    } ]
  }, {
    "tStartMs": 619060,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "than last year, something came off your\naccount and nobody told you."
    } ]
  }, {
    "tStartMs": 624260,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Number six is the exemption that stays\nbehind at the old house."
    } ]
  }, {
    "tStartMs": 628380,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "This one catches people at the worst\npossible moment, because it catches them"
    } ]
  }, {
    "tStartMs": 632860,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "while they are downsizing. The children\nare gone."
    } ]
  }, {
    "tStartMs": 636580,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "The stairs are hard. So the big house is\nsold and a smaller one is bought,"
    } ]
  }, {
    "tStartMs": 641700,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "sometimes on the same side of the same\ntown."
    } ]
  }, {
    "tStartMs": 644000,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "And every single person assumes the break\ncomes along."
    } ]
  }, {
    "tStartMs": 648140,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "It does not. The exemption belongs to the\nhouse, not to the person."
    } ]
  }, {
    "tStartMs": 653520,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "When you buy a new home it does not\ntransfer with you."
    } ]
  }, {
    "tStartMs": 657120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It stays on the property you left."
    } ]
  }, {
    "tStartMs": 659820,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "You have to apply again, on the new\naddress, as though you had never had one."
    } ]
  }, {
    "tStartMs": 665120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "And there is a deadline."
    } ]
  }, {
    "tStartMs": 667020,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "In Florida the new application is due by\nthe first of March in the first year"
    } ]
  }, {
    "tStartMs": 671860,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "after you move."
    } ]
  }, {
    "tStartMs": 673920,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "Miss it and you pay a full unreduced bill\non the new house for a year, at the"
    } ]
  }, {
    "tStartMs": 679380,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "exact moment you have just paid for a move\nand given up the old house."
    } ]
  }, {
    "tStartMs": 684180,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Ask one further question while you are on\nthat call."
    } ]
  }, {
    "tStartMs": 687840,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Some states let you carry the savings\nacross, not only the exemption."
    } ]
  }, {
    "tStartMs": 692540,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Florida lets a homeowner move a large part\nof the built up tax benefit from"
    } ]
  }, {
    "tStartMs": 696500,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "the old home to the new one. It has to be\nrequested on the same application."
    } ]
  }, {
    "tStartMs": 702660,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "So if you have moved house in the last two\nyears, check this before anything"
    } ]
  }, {
    "tStartMs": 707680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "else in the video."
    } ]
  }, {
    "tStartMs": 709500,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "What to do, and a note first."
    } ]
  }, {
    "tStartMs": 712240,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "This video describes the general shape of\nthese rules across the country."
    } ]
  }, {
    "tStartMs": 716980,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "Property tax is written at state level and\nrun at county level, so the detail"
    } ]
  }, {
    "tStartMs": 721820,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "where you live will differ."
    } ]
  }, {
    "tStartMs": 723840,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Check anything here with your county\nbefore acting on it."
    } ]
  }, {
    "tStartMs": 727020,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Then do these things. Find your last"
    } ]
  }, {
    "tStartMs": 729720,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "property tax bill and look for the\nexemption"
    } ]
  }, {
    "tStartMs": 731940,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "line. Note whether there is one and what\nit took off."
    } ]
  }, {
    "tStartMs": 735880,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "If there is nothing there, you are paying\nthe full amount, and you have been."
    } ]
  }, {
    "tStartMs": 740400,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "Telephone your county and ask for the\noffice that decides what your house is"
    } ]
  }, {
    "tStartMs": 744940,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "worth."
    } ]
  }, {
    "tStartMs": 745980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Use these words."
    } ]
  }, {
    "tStartMs": 747660,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "My age is over sixty five and this house\nis where I live."
    } ]
  }, {
    "tStartMs": 752240,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Which exemptions can I hold, and which of\nthem are missing from my account"
    } ]
  }, {
    "tStartMs": 756140,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "now."
    } ]
  }, {
    "tStartMs": 757320,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Then ask for a copy of the record on your\nproperty, and check the square footage"
    } ]
  }, {
    "tStartMs": 761600,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "and the room count against the house you\nare standing in."
    } ]
  }, {
    "tStartMs": 765220,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "Then ask when the paper comes out that\nsays what my house is worth, and how"
    } ]
  }, {
    "tStartMs": 770400,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "many days I have to challenge it."
    } ]
  }, {
    "tStartMs": 772820,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "Put that date on a calendar. That single\ndate decides whether you may argue"
    } ]
  }, {
    "tStartMs": 778020,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "at all. And if your husband has died, ask\nthis separately, because it will"
    } ]
  }, {
    "tStartMs": 783420,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "not come up on its own."
    } ]
  }, {
    "tStartMs": 785820,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "My husband held the over sixty five\nexemption."
    } ]
  }, {
    "tStartMs": 788980,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "I am fifty five or older. Can it be\ncontinued in my name."
    } ]
  }, {
    "tStartMs": 793120,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Note the date of that call, and who\nanswered it."
    } ]
  }, {
    "tStartMs": 797140,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "If any of this is disputed a year from\nnow, that note is all you will be holding."
    } ]
  }, {
    "tStartMs": 803100,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Now a warning about the people who will\nfind you once you start asking."
    } ]
  }, {
    "tStartMs": 807640,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "The moment a senior starts asking about\nproperty tax, companies appear."
    } ]
  }, {
    "tStartMs": 813100,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Some offer to challenge your value for a\nshare of whatever they save you."
    } ]
  }, {
    "tStartMs": 816980,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "But nobody has to be paid to file the\nexemptions in this video."
    } ]
  }, {
    "tStartMs": 821240,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "Every one is a free form at your own\ncounty, and the county will tell you which"
    } ]
  }, {
    "tStartMs": 826640,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "ones you qualify for at no cost."
    } ]
  }, {
    "tStartMs": 829980,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "If somebody telephones you first, before\nyou contacted anyone, treat that as"
    } ]
  }, {
    "tStartMs": 834900,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "the warning. Counties do not ring\nhomeowners to offer exemptions, so anybody"
    } ]
  }, {
    "tStartMs": 840240,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "who does has a reason for finding you."
    } ]
  }, {
    "tStartMs": 842760,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "And no honest service needs your Social\nSecurity number to look up a property"
    } ]
  }, {
    "tStartMs": 847440,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "record. Run through the six one last time."
    } ]
  }, {
    "tStartMs": 851140,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "The bill is a percentage of a figure the\ncounty guessed, and the days to challenge"
    } ]
  }, {
    "tStartMs": 855220,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "it start from the paper that comes before\nthe bill, not from the bill."
    } ]
  }, {
    "tStartMs": 859600,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The county holds a record on your house\nthat may be wrong."
    } ]
  }, {
    "tStartMs": 862840,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "You may see it for nothing, and a wrong\nmeasurement is the hardest error to"
    } ]
  }, {
    "tStartMs": 866720,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "dismiss. A veteran rated totally and\npermanently disabled pays no property"
    } ]
  }, {
    "tStartMs": 871380,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "tax at all in twenty two states, and in\nmost of them the widow keeps that."
    } ]
  }, {
    "tStartMs": 875560,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "The over sixty five exemption does not\nhave to end when your husband does,"
    } ]
  }, {
    "tStartMs": 880040,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "and fifty five is old enough to keep it."
    } ]
  }, {
    "tStartMs": 882840,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "An exemption can come off your account in\na five year review with nothing said,"
    } ]
  }, {
    "tStartMs": 886860,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and it shows up only as a bigger bill."
    } ]
  }, {
    "tStartMs": 889580,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "And when you move house it stays behind,\nand you must file again."
    } ]
  }, {
    "tStartMs": 894040,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "None of the six is hidden. Every one is\nwritten in public rules at your own"
    } ]
  }, {
    "tStartMs": 898040,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "county office. They stay unknown because\nnobody in that office is paid to tell"
    } ]
  }, {
    "tStartMs": 902920,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "you, and there is no penalty anywhere for\nthe silence."
    } ]
  }, {
    "tStartMs": 906760,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "So telephone your county this week and ask\nwhat you are not getting."
    } ]
  }, {
    "tStartMs": 910200,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "And if your mother is widowed and still in\nthe house, make that call for her"
    } ]
  }, {
    "tStartMs": 914440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "tonight."
    } ]
  } ]
}
