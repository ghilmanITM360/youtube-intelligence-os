  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "There is a phone call happening in this country every"
    } ]
  }, {
    "tStartMs": 3241,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "single day that goes something like this."
    } ]
  }, {
    "tStartMs": 6262,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "A woman in her seventies walks into her bank to"
    } ]
  }, {
    "tStartMs": 9604,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "move some of her own money, to help a grandchild,"
    } ]
  }, {
    "tStartMs": 13165,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "to pay for a new roof, to send a deposit"
    } ]
  }, {
    "tStartMs": 16067,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "on a place she is moving to."
    } ]
  }, {
    "tStartMs": 18288,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "And instead of handing her the money, the bank pulls"
    } ]
  }, {
    "tStartMs": 21669,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "her into a back office, asks her a series of"
    } ]
  }, {
    "tStartMs": 24670,
    "dDurationMs": 3522,
    "segs": [ {
      "utf8": "questions, and then tells her the transaction is on hold."
    } ]
  }, {
    "tStartMs": 28872,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "Her own money, in her own account, frozen."
    } ]
  }, {
    "tStartMs": 32314,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "And she did absolutely nothing wrong."
    } ]
  }, {
    "tStartMs": 35195,
    "dDurationMs": 3261,
    "segs": [ {
      "utf8": "This is happening to seniors more than to anyone else,"
    } ]
  }, {
    "tStartMs": 38756,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "and the reason is something almost nobody has explained to"
    } ]
  }, {
    "tStartMs": 41858,
    "dDurationMs": 3221,
    "segs": [ {
      "utf8": "you. The bank now has the power to freeze your"
    } ]
  }, {
    "tStartMs": 45079,
    "dDurationMs": 4462,
    "segs": [ {
      "utf8": "account, hold your transfer, or block your withdrawal, sometimes for"
    } ]
  }, {
    "tStartMs": 49541,
    "dDurationMs": 3922,
    "segs": [ {
      "utf8": "weeks, and in some cases it is legally forbidden from"
    } ]
  }, {
    "tStartMs": 53463,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "telling you exactly why. I am going to walk you"
    } ]
  }, {
    "tStartMs": 57004,
    "dDurationMs": 2722,
    "segs": [ {
      "utf8": "through the six reasons a bank will freeze a senior's"
    } ]
  }, {
    "tStartMs": 59726,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "account, why you are a bigger target than you think,"
    } ]
  }, {
    "tStartMs": 63007,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "and the exact steps you can take right now so"
    } ]
  }, {
    "tStartMs": 65988,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "that your money is never locked away from you when"
    } ]
  }, {
    "tStartMs": 68309,
    "dDurationMs": 3622,
    "segs": [ {
      "utf8": "you need it most. Stay to the end, because the"
    } ]
  }, {
    "tStartMs": 71931,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "last step is the one that keeps your account open"
    } ]
  }, {
    "tStartMs": 74212,
    "dDurationMs": 2821,
    "segs": [ {
      "utf8": "even when everyone else's is getting frozen."
    } ]
  }, {
    "tStartMs": 77574,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "The first reason is the one that surprises people the"
    } ]
  }, {
    "tStartMs": 80635,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "most, because it was created to protect you."
    } ]
  }, {
    "tStartMs": 83836,
    "dDurationMs": 3442,
    "segs": [ {
      "utf8": "In the last few years, banks and investment firms were"
    } ]
  }, {
    "tStartMs": 87278,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "given the power to put a temporary hold on the"
    } ]
  }, {
    "tStartMs": 90079,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "account of anyone sixty five or older the moment they"
    } ]
  }, {
    "tStartMs": 93460,
    "dDurationMs": 2722,
    "segs": [ {
      "utf8": "suspect that senior is being financially exploited."
    } ]
  }, {
    "tStartMs": 97082,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "The hold can last fifteen business days, and it can"
    } ]
  }, {
    "tStartMs": 99943,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "be extended even longer than that."
    } ]
  }, {
    "tStartMs": 102424,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "It was written with good intentions, to stop a scammer"
    } ]
  }, {
    "tStartMs": 105526,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "from draining a grandmother's life savings before anyone notices."
    } ]
  }, {
    "tStartMs": 110628,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "But the very same rule means that a perfectly sharp,"
    } ]
  }, {
    "tStartMs": 114550,
    "dDurationMs": 3301,
    "segs": [ {
      "utf8": "perfectly capable senior who walks in to take out twenty"
    } ]
  }, {
    "tStartMs": 117851,
    "dDurationMs": 2721,
    "segs": [ {
      "utf8": "thousand dollars to help her own daughter buy a home"
    } ]
  }, {
    "tStartMs": 120572,
    "dDurationMs": 4002,
    "segs": [ {
      "utf8": "can be questioned, doubted, and made to wait while the"
    } ]
  }, {
    "tStartMs": 124574,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "bank decides whether to release her own money."
    } ]
  }, {
    "tStartMs": 127736,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "The bank does not have to be right."
    } ]
  }, {
    "tStartMs": 129936,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "It only has to be suspicious."
    } ]
  }, {
    "tStartMs": 132037,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "The second reason is a sudden change in your normal"
    } ]
  }, {
    "tStartMs": 134999,
    "dDurationMs": 4542,
    "segs": [ {
      "utf8": "pattern. The software your bank runs watches every account quietly,"
    } ]
  }, {
    "tStartMs": 140121,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "and it is looking for anything that breaks your usual"
    } ]
  }, {
    "tStartMs": 142882,
    "dDurationMs": 3392,
    "segs": [ {
      "utf8": "habits. If you have taken out three hundred dollars a"
    } ]
  }, {
    "tStartMs": 146274,
    "dDurationMs": 3111,
    "segs": [ {
      "utf8": "week for fifteen years and you suddenly ask for eight"
    } ]
  }, {
    "tStartMs": 149385,
    "dDurationMs": 3502,
    "segs": [ {
      "utf8": "thousand, that is a pattern break, and it can trigger"
    } ]
  }, {
    "tStartMs": 152887,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "a hold while a human reviews it."
    } ]
  }, {
    "tStartMs": 155508,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "The system does not know you are putting a new"
    } ]
  }, {
    "tStartMs": 157769,
    "dDurationMs": 2421,
    "segs": [ {
      "utf8": "roof on the house. It does not care."
    } ]
  }, {
    "tStartMs": 160670,
    "dDurationMs": 3622,
    "segs": [ {
      "utf8": "It sees something different from your history, and different is"
    } ]
  }, {
    "tStartMs": 164292,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "exactly what it is built to flag."
    } ]
  }, {
    "tStartMs": 166693,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "The third reason is any sign that you might be"
    } ]
  }, {
    "tStartMs": 169794,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "the victim of a scam, and this is where seniors"
    } ]
  }, {
    "tStartMs": 172595,
    "dDurationMs": 2121,
    "segs": [ {
      "utf8": "get caught in the trap the most."
    } ]
  }, {
    "tStartMs": 175076,
    "dDurationMs": 3082,
    "segs": [ {
      "utf8": "Banks are now trained to treat large transfers by older"
    } ]
  }, {
    "tStartMs": 178158,
    "dDurationMs": 4201,
    "segs": [ {
      "utf8": "customers as possible scams. So when a senior tries to"
    } ]
  }, {
    "tStartMs": 182359,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "send a wire, especially to a person or a place"
    } ]
  }, {
    "tStartMs": 185421,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "the account has never sent money to before, the teller"
    } ]
  }, {
    "tStartMs": 188962,
    "dDurationMs": 2702,
    "segs": [ {
      "utf8": "is trained to slow it down, ask who the money"
    } ]
  }, {
    "tStartMs": 191664,
    "dDurationMs": 3361,
    "segs": [ {
      "utf8": "is for, ask whether anyone instructed you to send it,"
    } ]
  }, {
    "tStartMs": 195305,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "ask whether you met someone new online."
    } ]
  }, {
    "tStartMs": 198066,
    "dDurationMs": 3282,
    "segs": [ {
      "utf8": "If your answers make the bank uneasy, even if everything"
    } ]
  }, {
    "tStartMs": 201348,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "is completely legitimate, they can hold the transfer."
    } ]
  }, {
    "tStartMs": 205330,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "The irony is painful. The rule meant to protect you"
    } ]
  }, {
    "tStartMs": 208791,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "from losing your money can stop you from using your"
    } ]
  }, {
    "tStartMs": 211832,
    "dDurationMs": 3542,
    "segs": [ {
      "utf8": "money. The fourth reason is one most people never see"
    } ]
  }, {
    "tStartMs": 215374,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "coming, and it is doing nothing at all."
    } ]
  }, {
    "tStartMs": 218395,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "It is called a dormancy or inactivity freeze."
    } ]
  }, {
    "tStartMs": 222177,
    "dDurationMs": 6933,
    "segs": [ {
      "utf8": "If you have a savings account or an old checking"
    } ]
  }, {
    "tStartMs": 229110,
    "dDurationMs": 1538,
    "segs": [ {
      "utf8": "account that you simply leave sitting there untouched, after a"
    } ]
  }, {
    "tStartMs": 230648,
    "dDurationMs": 1353,
    "segs": [ {
      "utf8": "period of time the bank can flag it as dormant,"
    } ]
  }, {
    "tStartMs": 232001,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "restrict it, and in some states eventually hand the balance"
    } ]
  }, {
    "tStartMs": 234622,
    "dDurationMs": 2702,
    "segs": [ {
      "utf8": "over to the state government as unclaimed property."
    } ]
  }, {
    "tStartMs": 238124,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "Money you forgot about, money you were saving for later,"
    } ]
  }, {
    "tStartMs": 241846,
    "dDurationMs": 3521,
    "segs": [ {
      "utf8": "can be locked up or swept away simply because you"
    } ]
  }, {
    "tStartMs": 245367,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "were not moving it around enough to satisfy the bank."
    } ]
  }, {
    "tStartMs": 248929,
    "dDurationMs": 2291,
    "segs": [ {
      "utf8": "The fifth reason is the one the bank can never"
    } ]
  }, {
    "tStartMs": 251220,
    "dDurationMs": 4252,
    "segs": [ {
      "utf8": "explain to you, and it is a suspicious activity review."
    } ]
  }, {
    "tStartMs": 256372,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "Federal rules require banks to watch for transactions that look"
    } ]
  }, {
    "tStartMs": 259773,
    "dDurationMs": 3742,
    "segs": [ {
      "utf8": "unusual, and when something gets flagged, the bank can freeze"
    } ]
  }, {
    "tStartMs": 263515,
    "dDurationMs": 3582,
    "segs": [ {
      "utf8": "the account while it investigates, and it is legally prohibited"
    } ]
  }, {
    "tStartMs": 267097,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "from telling you that this is what happened."
    } ]
  }, {
    "tStartMs": 269958,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "So you could walk in one day and find your"
    } ]
  }, {
    "tStartMs": 272419,
    "dDurationMs": 4382,
    "segs": [ {
      "utf8": "card declined, your transfer blocked, your account restricted, and the"
    } ]
  }, {
    "tStartMs": 276801,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "person at the counter genuinely cannot tell you why, because"
    } ]
  }, {
    "tStartMs": 280202,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "the law forbids it. You did nothing illegal."
    } ]
  }, {
    "tStartMs": 283964,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "The system simply scored your activity as worth a second"
    } ]
  }, {
    "tStartMs": 286805,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "look, and you are the one who pays for that"
    } ]
  }, {
    "tStartMs": 289426,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "with frozen access to your own money."
    } ]
  }, {
    "tStartMs": 292028,
    "dDurationMs": 4662,
    "segs": [ {
      "utf8": "The sixth reason hits at the worst possible time, and"
    } ]
  }, {
    "tStartMs": 296690,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "it is the death of a co-owner."
    } ]
  }, {
    "tStartMs": 299491,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "If you share a joint account with a spouse and"
    } ]
  }, {
    "tStartMs": 302552,
    "dDurationMs": 4102,
    "segs": [ {
      "utf8": "that spouse passes away, the bank can freeze the account"
    } ]
  }, {
    "tStartMs": 306654,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "the moment it learns of the death, until the paperwork"
    } ]
  }, {
    "tStartMs": 310115,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "is sorted out and ownership is confirmed."
    } ]
  }, {
    "tStartMs": 314137,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "A grieving widow can find herself locked out of the"
    } ]
  }, {
    "tStartMs": 317459,
    "dDurationMs": 3881,
    "segs": [ {
      "utf8": "very account she needs to pay for the funeral, simply"
    } ]
  }, {
    "tStartMs": 321340,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "because the name on the account is now in question."
    } ]
  }, {
    "tStartMs": 324742,
    "dDurationMs": 3862,
    "segs": [ {
      "utf8": "It is cruel, it is common, and almost nobody plans"
    } ]
  }, {
    "tStartMs": 328604,
    "dDurationMs": 4141,
    "segs": [ {
      "utf8": "for it. So now you understand why it happens."
    } ]
  }, {
    "tStartMs": 333486,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "Here is what you actually do about it, because every"
    } ]
  }, {
    "tStartMs": 336947,
    "dDurationMs": 3362,
    "segs": [ {
      "utf8": "one of these freezes can be prevented or shortened if"
    } ]
  }, {
    "tStartMs": 340309,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "you take a few simple steps before the trouble starts."
    } ]
  }, {
    "tStartMs": 344150,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "The first step, and the most powerful one, is to"
    } ]
  }, {
    "tStartMs": 347612,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "add a trusted contact to your account."
    } ]
  }, {
    "tStartMs": 350313,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "Most banks and investment firms now let you name a"
    } ]
  }, {
    "tStartMs": 353094,
    "dDurationMs": 3042,
    "segs": [ {
      "utf8": "person they are allowed to call if they ever suspect"
    } ]
  }, {
    "tStartMs": 356136,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "something is wrong with your account."
    } ]
  }, {
    "tStartMs": 358637,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "When you name that trusted contact, you give the bank"
    } ]
  }, {
    "tStartMs": 361718,
    "dDurationMs": 3722,
    "segs": [ {
      "utf8": "someone to verify with instead of simply freezing you out."
    } ]
  }, {
    "tStartMs": 365920,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "This one step, which takes five minutes and costs nothing,"
    } ]
  }, {
    "tStartMs": 369922,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "is the single best protection against the elder exploitation hold,"
    } ]
  }, {
    "tStartMs": 373603,
    "dDurationMs": 3262,
    "segs": [ {
      "utf8": "because it gives the bank a faster path than locking"
    } ]
  }, {
    "tStartMs": 376865,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "your money away. The second step is to warn your"
    } ]
  }, {
    "tStartMs": 379946,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "bank before you do anything large."
    } ]
  }, {
    "tStartMs": 382727,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "If you know a big withdrawal or a big transfer"
    } ]
  }, {
    "tStartMs": 385268,
    "dDurationMs": 3842,
    "segs": [ {
      "utf8": "is coming, call the branch a few days ahead, tell"
    } ]
  }, {
    "tStartMs": 389110,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "them the amount and what it is for, and ask"
    } ]
  }, {
    "tStartMs": 392091,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "them to note it on your account."
    } ]
  }, {
    "tStartMs": 394512,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "A transaction the bank is expecting is a transaction the"
    } ]
  }, {
    "tStartMs": 398074,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "bank does not freeze. The freeze happens when you surprise"
    } ]
  }, {
    "tStartMs": 401756,
    "dDurationMs": 4542,
    "segs": [ {
      "utf8": "them. Take the surprise away. The third step is to"
    } ]
  }, {
    "tStartMs": 406298,
    "dDurationMs": 4161,
    "segs": [ {
      "utf8": "keep every account active. Do not leave money sitting in"
    } ]
  }, {
    "tStartMs": 410459,
    "dDurationMs": 4202,
    "segs": [ {
      "utf8": "an account you never touch. Set up one small automatic"
    } ]
  }, {
    "tStartMs": 414661,
    "dDurationMs": 3862,
    "segs": [ {
      "utf8": "transaction, even a few dollars moving in or out each"
    } ]
  }, {
    "tStartMs": 418523,
    "dDurationMs": 3762,
    "segs": [ {
      "utf8": "month, so that no account of yours ever gets flagged"
    } ]
  }, {
    "tStartMs": 422285,
    "dDurationMs": 4462,
    "segs": [ {
      "utf8": "as dormant and swept away. The fourth step is to"
    } ]
  }, {
    "tStartMs": 426747,
    "dDurationMs": 4061,
    "segs": [ {
      "utf8": "keep your paperwork ready. If you sell a car, receive"
    } ]
  }, {
    "tStartMs": 430808,
    "dDurationMs": 3662,
    "segs": [ {
      "utf8": "a gift, move an inheritance, or cash in a policy,"
    } ]
  }, {
    "tStartMs": 434930,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "keep the document that proves where that money came from."
    } ]
  }, {
    "tStartMs": 438052,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "When the bank questions a deposit or a withdrawal, a"
    } ]
  }, {
    "tStartMs": 441953,
    "dDurationMs": 2942,
    "segs": [ {
      "utf8": "single piece of paper that explains it can be the"
    } ]
  }, {
    "tStartMs": 444895,
    "dDurationMs": 3661,
