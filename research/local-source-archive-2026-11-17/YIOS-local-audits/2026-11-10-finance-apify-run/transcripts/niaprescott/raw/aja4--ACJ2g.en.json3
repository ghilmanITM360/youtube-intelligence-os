{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 620,
    "dDurationMs": 3202,
    "segs": [ {
      "utf8": "Imagine opening your mailbox on an ordinary"
    } ]
  }, {
    "tStartMs": 3822,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "afternoon and finding a letter from the Social"
    } ]
  }, {
    "tStartMs": 6644,
    "dDurationMs": 1221,
    "segs": [ {
      "utf8": "Security Administration."
    } ]
  }, {
    "tStartMs": 8666,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "You open it, and it tells you that you"
    } ]
  }, {
    "tStartMs": 10987,
    "dDurationMs": 2622,
    "segs": [ {
      "utf8": "were paid too much, sometime over the last"
    } ]
  }, {
    "tStartMs": 13609,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "few years, and that you now owe the government"
    } ]
  }, {
    "tStartMs": 16571,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "thousands of dollars."
    } ]
  }, {
    "tStartMs": 18612,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "And here is the part that takes the breath"
    } ]
  }, {
    "tStartMs": 20533,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "out of you."
    } ]
  }, {
    "tStartMs": 21354,
    "dDurationMs": 3142,
    "segs": [ {
      "utf8": "Starting next month, to get that money back,"
    } ]
  }, {
    "tStartMs": 24776,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "they are going to keep half of your monthly"
    } ]
  }, {
    "tStartMs": 27117,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "check."
    } ]
  }, {
    "tStartMs": 27498,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "Not a small piece."
    } ]
  }, {
    "tStartMs": 29579,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Half."
    } ]
  }, {
    "tStartMs": 30640,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The check you live on,"
    } ]
  }, {
    "tStartMs": 32061,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "the check that pays the rent and the electric"
    } ]
  }, {
    "tStartMs": 34502,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "and the groceries, cut in two,"
    } ]
  }, {
    "tStartMs": 36904,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "for a debt you did not know you had,"
    } ]
  }, {
    "tStartMs": 39445,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "over a mistake that in most cases was never"
    } ]
  }, {
    "tStartMs": 43048,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "even yours."
    } ]
  }, {
    "tStartMs": 44789,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "This is happening to older Americans by the"
    } ]
  }, {
    "tStartMs": 47591,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "hundreds of thousands right now,"
    } ]
  }, {
    "tStartMs": 49572,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "and almost none of them know that there is"
    } ]
  }, {
    "tStartMs": 52113,
    "dDurationMs": 2842,
    "segs": [ {
      "utf8": "a narrow window, and three specific requests,"
    } ]
  }, {
    "tStartMs": 54955,
    "dDurationMs": 2862,
    "segs": [ {
      "utf8": "that can stop it before a single dollar is"
    } ]
  }, {
    "tStartMs": 57817,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "taken."
    } ]
  }, {
    "tStartMs": 58998,
    "dDurationMs": 1541,
    "segs": [ {
      "utf8": "So stay with me to the end,"
    } ]
  }, {
    "tStartMs": 60539,
    "dDurationMs": 2662,
    "segs": [ {
      "utf8": "because by the time we are done you will"
    } ]
  }, {
    "tStartMs": 63201,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "know exactly what to do the day that letter"
    } ]
  }, {
    "tStartMs": 65862,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "arrives."
    } ]
  }, {
    "tStartMs": 66763,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "And I want you to hear this from a"
    } ]
  }, {
    "tStartMs": 69084,
    "dDurationMs": 2342,
    "segs": [ {
      "utf8": "calm voice, not a frightening one,"
    } ]
  }, {
    "tStartMs": 72006,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "because fear is exactly what makes people freeze"
    } ]
  }, {
    "tStartMs": 74828,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "and lose their money."
    } ]
  }, {
    "tStartMs": 76929,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "You are going to leave these few minutes knowing"
    } ]
  }, {
    "tStartMs": 79491,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "your rights, and that knowledge is the thing"
    } ]
  }, {
    "tStartMs": 82253,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "that protects you."
    } ]
  }, {
    "tStartMs": 83273,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "So let me explain what is actually happening,"
    } ]
  }, {
    "tStartMs": 86175,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "because it has a name,"
    } ]
  }, {
    "tStartMs": 87796,
    "dDurationMs": 3222,
    "segs": [ {
      "utf8": "and understanding it is the first step to not"
    } ]
  }, {
    "tStartMs": 91018,
    "dDurationMs": 961,
    "segs": [ {
      "utf8": "being afraid of it."
    } ]
  }, {
    "tStartMs": 92820,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "It is called an overpayment recovery,"
    } ]
  }, {
    "tStartMs": 95521,
    "dDurationMs": 1521,
    "segs": [ {
      "utf8": "and here is how it works."
    } ]
  }, {
    "tStartMs": 97863,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "The Social Security Administration keeps track"
    } ]
  }, {
    "tStartMs": 100665,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "of every dollar it sends you."
    } ]
  }, {
    "tStartMs": 103086,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "If they later decide that,"
    } ]
  }, {
    "tStartMs": 104827,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "at some point, they paid you more than you"
    } ]
  }, {
    "tStartMs": 107229,
    "dDurationMs": 2942,
    "segs": [ {
      "utf8": "were supposed to receive, they label the difference"
    } ]
  }, {
    "tStartMs": 110171,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "an overpayment, and by law they are allowed"
    } ]
  }, {
    "tStartMs": 113233,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "to come and collect it back."
    } ]
  }, {
    "tStartMs": 115834,
    "dDurationMs": 2242,
    "segs": [ {
      "utf8": "The way they collect it is simple,"
    } ]
  }, {
    "tStartMs": 118076,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "and it is brutal."
    } ]
  }, {
    "tStartMs": 119957,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "They reach into your future monthly checks"
    } ]
  }, {
    "tStartMs": 122358,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "and they hold back part of each one until"
    } ]
  }, {
    "tStartMs": 125180,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "the debt is repaid."
    } ]
  }, {
    "tStartMs": 127081,
    "dDurationMs": 1261,
    "segs": [ {
      "utf8": "And as of last year,"
    } ]
  }, {
    "tStartMs": 128342,
    "dDurationMs": 2602,
    "segs": [ {
      "utf8": "for your regular retirement, survivors,"
    } ]
  }, {
    "tStartMs": 130944,
    "dDurationMs": 2942,
    "segs": [ {
      "utf8": "or disability benefits, the amount they hold"
    } ]
  }, {
    "tStartMs": 133886,
    "dDurationMs": 3382,
    "segs": [ {
      "utf8": "back by default is fifty percent of your monthly"
    } ]
  }, {
    "tStartMs": 137268,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "check."
    } ]
  }, {
    "tStartMs": 138469,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "Half of everything you were counting on,"
    } ]
  }, {
    "tStartMs": 140710,
    "dDurationMs": 3643,
    "segs": [ {
      "utf8": "gone, every month, until the balance is cleared."
    } ]
  }, {
    "tStartMs": 144673,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Now here is the part that makes people the"
    } ]
  }, {
    "tStartMs": 147134,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "angriest, and rightly so."
    } ]
  }, {
    "tStartMs": 149896,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "In a great many of these cases,"
    } ]
  }, {
    "tStartMs": 152118,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "the overpayment was never the fault of the"
    } ]
  }, {
    "tStartMs": 154279,
    "dDurationMs": 1861,
    "segs": [ {
      "utf8": "person being asked to pay it back."
    } ]
  }, {
    "tStartMs": 156881,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "Sometimes the agency simply made an error in"
    } ]
  }, {
    "tStartMs": 159422,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "its own math, years ago,"
    } ]
  }, {
    "tStartMs": 161424,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "and kept paying the wrong amount month after"
    } ]
  }, {
    "tStartMs": 164125,
    "dDurationMs": 1841,
    "segs": [ {
      "utf8": "month without anyone noticing."
    } ]
  }, {
    "tStartMs": 166847,
    "dDurationMs": 2722,
    "segs": [ {
      "utf8": "Sometimes a change was reported on time,"
    } ]
  }, {
    "tStartMs": 169569,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "exactly as it was supposed to be,"
    } ]
  }, {
    "tStartMs": 172210,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "but the agency was slow to process it,"
    } ]
  }, {
    "tStartMs": 174772,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "and the extra money kept flowing in the meantime."
    } ]
  }, {
    "tStartMs": 178414,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "Sometimes a person went back to a little part"
    } ]
  }, {
    "tStartMs": 181717,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "time work, told the agency just as they were"
    } ]
  }, {
    "tStartMs": 184598,
    "dDurationMs": 2622,
    "segs": [ {
      "utf8": "instructed, and the adjustment still did not"
    } ]
  }, {
    "tStartMs": 187220,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "happen for a year or more."
    } ]
  }, {
    "tStartMs": 189602,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "And because these mistakes can quietly run"
    } ]
  }, {
    "tStartMs": 192003,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "for years before anyone catches them,"
    } ]
  }, {
    "tStartMs": 194565,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "the total is almost never small."
    } ]
  }, {
    "tStartMs": 197106,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "By the time the letter finally arrives,"
    } ]
  }, {
    "tStartMs": 199788,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "the amount they say you owe can be five"
    } ]
  }, {
    "tStartMs": 201829,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "thousand, ten thousand, even more,"
    } ]
  }, {
    "tStartMs": 204431,
    "dDurationMs": 2382,
    "segs": [ {
      "utf8": "built up entirely from an error you may have"
    } ]
  }, {
    "tStartMs": 206813,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "had nothing to do with."
    } ]
  }, {
    "tStartMs": 208554,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "And still, the letter lands in your mailbox."
    } ]
  }, {
    "tStartMs": 211015,
    "dDurationMs": 2862,
    "segs": [ {
      "utf8": "And still, they come for half of your check."
    } ]
  }, {
    "tStartMs": 214538,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "And do not think for a moment that this"
    } ]
  }, {
    "tStartMs": 216519,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "is rare, or that it only happens to a"
    } ]
  }, {
    "tStartMs": 218860,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "careless few."
    } ]
  }, {
    "tStartMs": 220301,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "In just the last couple of years,"
    } ]
  }, {
    "tStartMs": 222523,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "the Social Security Administration has sent"
    } ]
  }, {
    "tStartMs": 224664,
    "dDurationMs": 2682,
    "segs": [ {
      "utf8": "these overpayment letters to millions of people."
    } ]
  }, {
    "tStartMs": 227346,
    "dDurationMs": 2742,
    "segs": [ {
      "utf8": "And it very nearly got far worse."
    } ]
  }, {
    "tStartMs": 230628,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "For a stretch of time,"
    } ]
  }, {
    "tStartMs": 232149,
    "dDurationMs": 2191,
    "segs": [ {
      "utf8": "the agency announced it would take one hundred"
    } ]
  }, {
    "tStartMs": 234340,
    "dDurationMs": 2412,
    "segs": [ {
      "utf8": "percent of a person's monthly check to recover"
    } ]
  }, {
    "tStartMs": 236752,
    "dDurationMs": 2501,
    "segs": [ {
      "utf8": "an overpayment, the entire payment,"
    } ]
  }, {
    "tStartMs": 239794,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "leaving people with nothing at all to live"
    } ]
  }, {
    "tStartMs": 241615,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "on while the debt was collected."
    } ]
  }, {
    "tStartMs": 243876,
    "dDurationMs": 3142,
    "segs": [ {
      "utf8": "After a public outcry, they pulled that back"
    } ]
  }, {
    "tStartMs": 247018,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "to the fifty percent that stands today."
    } ]
  }, {
    "tStartMs": 250000,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "But think about what that tells you."
    } ]
  }, {
    "tStartMs": 251821,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "The instinct was to take everything."
    } ]
  }, {
    "tStartMs": 255104,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "The only reason it is half instead of all"
    } ]
  }, {
    "tStartMs": 257545,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "is that enough people spoke up."
    } ]
  }, {
    "tStartMs": 260367,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "That is the ground you are standing on,"
    } ]
  }, {
    "tStartMs": 262809,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "and it is exactly why you need to know"
    } ]
  }, {
    "tStartMs": 264970,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "how to protect yourself."
    } ]
  }, {
    "tStartMs": 266691,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "And for an older person living on a fixed"
    } ]
  }, {
    "tStartMs": 269453,
    "dDurationMs": 3882,
    "segs": [ {
      "utf8": "income, this kind of demand is cruel in a"
    } ]
  }, {
    "tStartMs": 273335,
    "dDurationMs": 2442,
    "segs": [ {
      "utf8": "way it simply is not for a younger person"
    } ]
  }, {
    "tStartMs": 275777,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "still working."
    } ]
  }, {
    "tStartMs": 277318,
    "dDurationMs": 2682,
    "segs": [ {
      "utf8": "A younger person told they owe money can pick"
    } ]
  }, {
    "tStartMs": 280000,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "up extra hours, take a second job,"
    } ]
  }, {
    "tStartMs": 282861,
    "dDurationMs": 1942,
    "segs": [ {
      "utf8": "find some way to earn the difference back."
    } ]
  }, {
    "tStartMs": 285543,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "A retiree cannot."
    } ]
  }, {
    "tStartMs": 287725,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "The check is the income."
    } ]
  }, {
    "tStartMs": 289786,
    "dDurationMs": 1781,
    "segs": [ {
      "utf8": "There is no picking up more shifts,"
    } ]
  }, {
    "tStartMs": 292027,
    "dDurationMs": 2942,
    "segs": [ {
      "utf8": "no raise coming, no other stream to lean on."
    } ]
  }, {
    "tStartMs": 295489,
    "dDurationMs": 2682,
    "segs": [ {
      "utf8": "So when the agency reaches in and takes half"
    } ]
  }, {
    "tStartMs": 298171,
    "dDurationMs": 3022,
    "segs": [ {
      "utf8": "of it, there is no room anywhere else to"
    } ]
  }, {
    "tStartMs": 301193,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "absorb the blow."
    } ]
  }, {
    "tStartMs": 302854,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "That is why knowing your rights here is not"
    } ]
  }, {
    "tStartMs": 305416,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "a small thing."
    } ]
  }, {
    "tStartMs": 306717,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "For the person it happens to,"
    } ]
  }, {
    "tStartMs": 308298,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "it can be the difference between keeping their"
    } ]
  }, {
    "tStartMs": 310899,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "home and losing it."
    } ]
  }, {
    "tStartMs": 313781,
    "dDurationMs": 1561,
    "segs": [ {
      "utf8": "Let me make this real,"
    } ]
  }, {
    "tStartMs": 315342,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "because somewhere in this country it is happening"
    } ]
  }, {
    "tStartMs": 318404,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "today."
    } ]
  }, {
    "tStartMs": 319745,
    "dDurationMs": 2382,
    "segs": [ {
      "utf8": "Picture a widow in her late seventies."
    } ]
  }, {
    "tStartMs": 322387,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "Her husband is gone, and she lives now on"
    } ]
  }, {
    "tStartMs": 325008,
    "dDurationMs": 2942,
    "segs": [ {
      "utf8": "a single Social Security check of about eighteen"
    } ]
  }, {
    "tStartMs": 327950,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "hundred dollars a month, and every dollar of"
    } ]
  }, {
    "tStartMs": 330772,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "it is already spoken for by the time it"
    } ]
  }, {
    "tStartMs": 333694,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "arrives."
    } ]
  }, {
    "tStartMs": 334815,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "One afternoon the letter comes."
    } ]
  }, {
    "tStartMs": 336576,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "It says that over the past three years she"
    } ]
  }, {
    "tStartMs": 339638,
    "dDurationMs": 2792,
    "segs": [ {
      "utf8": "was overpaid by nine thousand dollars,"
    } ]
  }, {
    "tStartMs": 342430,
    "dDurationMs": 2351,
    "segs": [ {
      "utf8": "because of an adjustment that was never her"
    } ]
  }, {
    "tStartMs": 344781,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "doing, and that beginning next month her check"
    } ]
  }, {
    "tStartMs": 347843,
    "dDurationMs": 2882,
    "segs": [ {
      "utf8": "will be cut to nine hundred dollars until the"
    } ]
  }, {
    "tStartMs": 350725,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "debt is gone."
    } ]
  }, {
    "tStartMs": 352026,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "Nine hundred dollars."
    } ]
  }, {
    "tStartMs": 353607,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "She cannot pay her rent on nine hundred dollars."
    } ]
  }, {
    "tStartMs": 356789,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "She did nothing wrong, she reported everything"
    } ]
  }, {
    "tStartMs": 359851,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "she was ever asked to report,"
    } ]
  }, {
    "tStartMs": 361472,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "and now she is staring at a year or"
    } ]
  }, {
    "tStartMs": 363913,
    "dDurationMs": 2742,
    "segs": [ {
      "utf8": "more of being unable to cover her own basic"
    } ]
  }, {
    "tStartMs": 366655,
    "dDurationMs": 3082,
    "segs": [ {
      "utf8": "needs, over a mistake made in an office she"
    } ]
  }, {
    "tStartMs": 369737,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "has never seen."
    } ]
  }, {
    "tStartMs": 371478,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "If she does nothing, that is exactly what will"
    } ]
  }, {
    "tStartMs": 374300,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "happen to her."
    } ]
  }, {
    "tStartMs": 375741,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "But if she knows what I am about to"
    } ]
  }, {
    "tStartMs": 377422,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "tell you, none of it has to."
    } ]
  }, {
    "tStartMs": 379623,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "So here is what to do,"
    } ]
  }, {
    "tStartMs": 381905,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "and it comes down to one window and three"
    } ]
  }, {
    "tStartMs": 384366,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "requests."
    } ]
  }, {
    "tStartMs": 385527,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "The most important thing first."
    } ]
  }, {
    "tStartMs": 387549,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "From the day that letter is dated,"
    } ]
  }, {
    "tStartMs": 389430,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "you have a short window to respond,"
    } ]
  }, {
    "tStartMs": 391511,
    "dDurationMs": 1521,
    "segs": [ {
      "utf8": "and if you act inside it,"
    } ]
  }, {
    "tStartMs": 393032,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "the law is on your side in a powerful"
    } ]
  }, {
    "tStartMs": 395794,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "way."
    } ]
  }, {
    "tStartMs": 397035,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "If you send in a request to appeal the"
    } ]
  }, {
    "tStartMs": 398836,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "overpayment, or a request to have it forgiven,"
    } ]
  }, {
    "tStartMs": 401177,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "within thirty days of that notice,"
    } ]
  }, {
    "tStartMs": 403799,
    "dDurationMs": 2522,
    "segs": [ {
      "utf8": "the Social Security Administration is not allowed"
    } ]
  }, {
    "tStartMs": 406321,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "to take a single dollar out of your check"
    } ]
  }, {
    "tStartMs": 408322,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "until they have reviewed and decided on your"
    } ]
  }, {
    "tStartMs": 411244,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "request."
    } ]
  }, {
    "tStartMs": 412465,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Let me say that again,"
    } ]
  }, {
    "tStartMs": 414226,
    "dDurationMs": 1461,
    "segs": [ {
      "utf8": "because it is the whole game."
    } ]
  }, {
    "tStartMs": 416407,
    "dDurationMs": 2622,
    "segs": [ {
      "utf8": "Responding within thirty days pushes the pause"
    } ]
  }, {
    "tStartMs": 419029,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "button."
    } ]
  }, {
    "tStartMs": 419949,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "The withholding does not start."
    } ]
  }, {
    "tStartMs": 421750,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "Your full check keeps arriving while they look"
    } ]
  }, {
    "tStartMs": 424812,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "at your case."
    } ]
  }, {
    "tStartMs": 426113,
    "dDurationMs": 2442,
    "segs": [ {
      "utf8": "The people who lose half their checks are,"
    } ]
  }, {
    "tStartMs": 428555,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "almost every time, the people who let that"
    } ]
  }, {
    "tStartMs": 431357,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "window pass without doing anything,"
    } ]
  }, {
    "tStartMs": 433778,
    "dDurationMs": 2162,
    "segs": [ {
      "utf8": "because after thirty days of silence,"
    } ]
  }, {
    "tStartMs": 436420,
    "dDurationMs": 2421,
    "segs": [ {
      "utf8": "the withholding simply begins on its own."
    } ]
  }, {
    "tStartMs": 439382,
    "dDurationMs": 3022,
    "segs": [ {
      "utf8": "Now, the three requests, and you choose the"
    } ]
  }, {
    "tStartMs": 442404,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "one that fits your situation."
    } ]
  }, {
    "tStartMs": 444405,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "The first is to ask them to look at"
    } ]
  }, {
    "tStartMs": 446446,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "it again."
    } ]
  }, {
    "tStartMs": 447487,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "If you do not believe you were overpaid at"
    } ]
  }, {
    "tStartMs": 449728,
    "dDurationMs": 2442,
    "segs": [ {
      "utf8": "all, or you believe the amount they claim is"
    } ]
  }, {
    "tStartMs": 452170,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "wrong, you have the right to formally ask them"
    } ]
  }, {
    "tStartMs": 455132,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "to reconsider, and you generally have sixty"
    } ]
  }, {
    "tStartMs": 458114,
    "dDurationMs": 1181,
    "segs": [ {
      "utf8": "days to do it."
    } ]
  }, {
    "tStartMs": 459895,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "You are telling them, plainly,"
    } ]
  }, {
    "tStartMs": 462156,
    "dDurationMs": 1381,
    "segs": [ {
      "utf8": "I do not think this is right,"
    } ]
  }, {
    "tStartMs": 463757,
    "dDurationMs": 1181,
    "segs": [ {
      "utf8": "please review it."
    } ]
  }, {
    "tStartMs": 465278,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "Errors in these cases are common,"
    } ]
  }, {
    "tStartMs": 467460,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "and sometimes a second look is all it takes."
    } ]
  }, {
    "tStartMs": 470362,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "The second request is the one that matters"
    } ]
  }, {
    "tStartMs": 472563,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "most for people who were not at fault,"
    } ]
  }, {
    "tStartMs": 474784,
    "dDurationMs": 2042,
    "segs": [ {
      "utf8": "and it is the right to ask them to"
    } ]
  }, {
    "tStartMs": 476826,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "forgive the debt entirely."
    } ]
  }, {
    "tStartMs": 478867,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "If the overpayment was not your fault,"
    } ]
  }, {
    "tStartMs": 481469,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "and paying it back would leave you unable to"
    } ]
  }, {
    "tStartMs": 483630,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "cover your basic living expenses,"
    } ]
  }, {
    "tStartMs": 485932,
    "dDurationMs": 1461,
    "segs": [ {
      "utf8": "or would simply be unfair,"
    } ]
  }, {
    "tStartMs": 487993,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "you can ask them to waive it,"
    } ]
  }, {
    "tStartMs": 489914,
    "dDurationMs": 2582,
    "segs": [ {
      "utf8": "which means to cancel the collection altogether."
    } ]
  }, {
    "tStartMs": 492816,
    "dDurationMs": 2582,
    "segs": [ {
      "utf8": "And here is something important that most people"
    } ]
  }, {
    "tStartMs": 495398,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "never learn."
    } ]
  }, {
    "tStartMs": 496979,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "There is no time limit on asking for this"
    } ]
  }, {
    "tStartMs": 499220,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "one."
    } ]
  }, {
    "tStartMs": 500101,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "Even if months have already gone by,"
    } ]
  }, {
    "tStartMs": 502902,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "even if they have already started taking money"
    } ]
  }, {
    "tStartMs": 505204,
    "dDurationMs": 2862,
    "segs": [ {
      "utf8": "from your check, you can still ask them to"
    } ]
  }, {
    "tStartMs": 508066,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "forgive it."
    } ]
  }, {
    "tStartMs": 509587,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "For the widow in my story,"
    } ]
  }, {
    "tStartMs": 511448,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "whose overpayment was never her doing and who"
    } ]
  }, {
    "tStartMs": 514350,
    "dDurationMs": 1421,
    "segs": [ {
      "utf8": "cannot live on half a check,"
    } ]
  }, {
    "tStartMs": 516451,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "this is very often the path that saves her."
    } ]
  }, {
    "tStartMs": 519873,
    "dDurationMs": 2602,
    "segs": [ {
      "utf8": "The third request is for when you do accept"
    } ]
  }, {
    "tStartMs": 522475,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "that you were overpaid, but having them take"
    } ]
  }, {
    "tStartMs": 525297,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "half your check would leave you unable to pay"
    } ]
  }, {
    "tStartMs": 527618,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "your bills."
    } ]
  }, {
    "tStartMs": 528939,
    "dDurationMs": 2442,
    "segs": [ {
      "utf8": "In that case, you can ask them to lower"
    } ]
  }, {
    "tStartMs": 531381,
    "dDurationMs": 1461,
    "segs": [ {
      "utf8": "the amount they take each month."
    } ]
  }, {
    "tStartMs": 533482,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "You are not disputing the debt."
    } ]
  }, {
    "tStartMs": 535503,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "You are simply telling them the truth,"
    } ]
  }, {
    "tStartMs": 537485,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "that fifty percent is more than you can survive"
    } ]
  }, {
    "tStartMs": 539886,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "on, and asking them to reduce it to a"
    } ]
  }, {
    "tStartMs": 542788,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "smaller amount you can actually manage."
    } ]
  }, {
    "tStartMs": 545390,
    "dDurationMs": 2421,
    "segs": [ {
      "utf8": "They will look at your income and your necessary"
    } ]
  }, {
    "tStartMs": 547811,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "expenses, and they can bring that monthly bite"
    } ]
  }, {
    "tStartMs": 550573,
    "dDurationMs": 2442,
    "segs": [ {
      "utf8": "down to something that does not push you under."
    } ]
  }, {
    "tStartMs": 553275,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "And let me tell you how you actually make"
    } ]
  }, {
    "tStartMs": 556037,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "these requests, because it is more within your"
    } ]
  }, {
    "tStartMs": 559038,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "reach than you might fear."
    } ]
  }, {
    "tStartMs": 561040,
    "dDurationMs": 1861,
    "segs": [ {
      "utf8": "Each one is a specific form,"
    } ]
  }, {
    "tStartMs": 563361,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "and you do not need to be a lawyer"
    } ]
  }, {
    "tStartMs": 564962,
    "dDurationMs": 1121,
    "segs": [ {
      "utf8": "to fill it out."
    } ]
  }, {
    "tStartMs": 566503,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "You can call the Social Security Administration"
    } ]
  }, {
    "tStartMs": 569005,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "directly, or go into your local office,"
    } ]
  }, {
    "tStartMs": 572167,
    "dDurationMs": 3202,
    "segs": [ {
      "utf8": "and tell them plainly which of the three you"
    } ]
  }, {
    "tStartMs": 575369,
    "dDurationMs": 2842,
    "segs": [ {
      "utf8": "want to do, and they must give you the"
    } ]
  }, {
    "tStartMs": 578211,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "form and help you understand it."
    } ]
  }, {
    "tStartMs": 580913,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "When you ask them to forgive the debt,"
    } ]
  }, {
    "tStartMs": 583294,
    "dDurationMs": 2282,
    "segs": [ {
      "utf8": "you will be asked to show your income and"
    } ]
  }, {
    "tStartMs": 585576,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "your monthly expenses, so it helps to gather"
    } ]
  }, {
    "tStartMs": 588277,
    "dDurationMs": 1421,
    "segs": [ {
      "utf8": "your bills ahead of time,"
    } ]
  }, {
    "tStartMs": 590028,
    "dDurationMs": 1852,
    "segs": [ {
      "utf8": "your rent or your mortgage,"
    } ]
  }, {
    "tStartMs": 592380,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "your utilities, your food, your medicine,"
    } ]
  }, {
    "tStartMs": 595702,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "so that you can show in black and white"
    } ]
  }, {
    "tStartMs": 597703,
    "dDurationMs": 3583,
    "segs": [ {
      "utf8": "that after your necessary costs there is simply"
    } ]
  }, {
    "tStartMs": 601286,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "nothing left to hand back."
    } ]
  }, {
    "tStartMs": 603827,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "And if any of this feels overwhelming,"
    } ]
  }, {
    "tStartMs": 607089,
    "dDurationMs": 2222,
    "segs": [ {
      "utf8": "you do not have to do it by yourself."
    } ]
  }, {
    "tStartMs": 609871,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "There are free legal aid offices and senior"
    } ]
  }, {
    "tStartMs": 612693,
    "dDurationMs": 3402,
    "segs": [ {
      "utf8": "advocates all across this country whose entire"
    } ]
  }, {
    "tStartMs": 616095,
    "dDurationMs": 3803,
    "segs": [ {
      "utf8": "job is helping older people fight exactly these"
    } ]
  }, {
    "tStartMs": 619898,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "overpayment notices, and they will do it at"
    } ]
  }, {
    "tStartMs": 622699,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "no cost to you at all."
    } ]
  }, {
    "tStartMs": 625061,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "Now let me name the one mistake that turns"
    } ]
  }, {
    "tStartMs": 627823,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "all of this protection into a disaster,"
    } ]
  }, {
    "tStartMs": 630524,
    "dDurationMs": 2662,
    "segs": [ {
      "utf8": "and it is the same one every single time."
    } ]
  }, {
    "tStartMs": 633666,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "It is doing nothing."
    } ]
  }, {
    "tStartMs": 635528,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "It is opening that letter,"
    } ]
  }, {
    "tStartMs": 637489,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "feeling the wave of fear and helplessness,"
    } ]
  }, {
    "tStartMs": 640110,
    "dDurationMs": 3022,
    "segs": [ {
      "utf8": "and then setting it aside because it is too"
    } ]
  }, {
    "tStartMs": 643132,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "frightening to deal with, or because you assume"
    } ]
  }, {
    "tStartMs": 645694,
    "dDurationMs": 2582,
    "segs": [ {
      "utf8": "the government must be right and there is nothing"
    } ]
  }, {
    "tStartMs": 648276,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "you can do."
    } ]
  }, {
    "tStartMs": 649897,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "But the government is not always right."
    } ]
  }, {
    "tStartMs": 652478,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "In these cases they are very often wrong."
    } ]
  }, {
    "tStartMs": 655380,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "And there is a great deal you can do."
    } ]
  }, {
    "tStartMs": 657902,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "Every protection I just described,"
    } ]
  }, {
    "tStartMs": 660403,
    "dDurationMs": 1662,
    "segs": [ {
      "utf8": "the pause, the second look,"
    } ]
  }, {
    "tStartMs": 662445,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "the forgiveness, the lower rate,"
    } ]
  }, {
    "tStartMs": 664766,
    "dDurationMs": 2742,
    "segs": [ {
      "utf8": "every one of them depends on you responding."
    } ]
  }, {
    "tStartMs": 668168,
    "dDurationMs": 2142,
    "segs": [ {
      "utf8": "And the clock is not kind to silence."
    } ]
  }, {
    "tStartMs": 671070,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "Do nothing for thirty days,"
    } ]
  }, {
    "tStartMs": 672771,
    "dDurationMs": 1982,
    "segs": [ {
      "utf8": "and the withholding starts on its own."
    } ]
  }, {
    "tStartMs": 675293,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "So the bravest and the smartest thing you can"
    } ]
  }, {
    "tStartMs": 677595,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "do the day that letter arrives is exactly the"
    } ]
  }, {
    "tStartMs": 680496,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "same thing."
    } ]
  }, {
    "tStartMs": 681717,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Open it."
    } ]
  }, {
    "tStartMs": 682598,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "Find the date."
    } ]
  }, {
    "tStartMs": 683718,
    "dDurationMs": 2062,
    "segs": [ {
      "utf8": "And respond before the window closes."
    } ]
  }, {
    "tStartMs": 686200,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "So let me pull this together,"
    } ]
  }, {
    "tStartMs": 688562,
    "dDurationMs": 3042,
    "segs": [ {
      "utf8": "because the thread is simple and it is worth"
    } ]
  }, {
    "tStartMs": 691604,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "holding onto."
    } ]
  }, {
    "tStartMs": 693285,
    "dDurationMs": 3022,
    "segs": [ {
      "utf8": "Your monthly Social Security check can feel"
    } ]
  }, {
    "tStartMs": 696307,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "like the one certain thing in your life,"
    } ]
  }, {
    "tStartMs": 699008,
    "dDurationMs": 1841,
    "segs": [ {
      "utf8": "the payment that always arrives,"
    } ]
  }, {
    "tStartMs": 701290,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "the ground under your feet."
    } ]
  }, {
    "tStartMs": 703211,
    "dDurationMs": 1781,
    "segs": [ {
      "utf8": "And most of the time it is."
    } ]
  }, {
    "tStartMs": 705412,
    "dDurationMs": 1822,
    "segs": [ {
      "utf8": "But it is not untouchable,"
    } ]
  }, {
    "tStartMs": 707694,
    "dDurationMs": 2642,
    "segs": [ {
      "utf8": "and the very agency that sends it can also"
    } ]
  }, {
    "tStartMs": 710336,
    "dDurationMs": 3142,
    "segs": [ {
      "utf8": "decide, sometimes wrongly, to take a large"
    } ]
  }, {
    "tStartMs": 713478,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "piece of it back."
    } ]
  }, {
    "tStartMs": 715159,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "What stands between you and that loss is not"
    } ]
  }, {
    "tStartMs": 718501,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "luck, and it is not money,"
    } ]
  }, {
    "tStartMs": 720642,
    "dDurationMs": 1221,
    "segs": [ {
      "utf8": "and it is not a lawyer."
    } ]
  }, {
    "tStartMs": 722583,
    "dDurationMs": 2282,
    "segs": [ {
      "utf8": "It is knowing that you have rights,"
    } ]
  }, {
    "tStartMs": 725325,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "that you have a window of time,"
    } ]
  }, {
    "tStartMs": 727627,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "and that three plain requests,"
    } ]
  }, {
    "tStartMs": 729768,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "a second look, a forgiveness,"
    } ]
  }, {
    "tStartMs": 732470,
    "dDurationMs": 3262,
    "segs": [ {
      "utf8": "or a lower rate, can stop or shrink the"
    } ]
  }, {
    "tStartMs": 735732,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "whole thing."
    } ]
  }, {
    "tStartMs": 736973,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "The system is built to keep collecting from"
    } ]
  }, {
    "tStartMs": 739614,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "the people who stay silent,"
    } ]
  }, {
    "tStartMs": 741596,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "and to step back for the people who stand"
    } ]
  }, {
    "tStartMs": 744077,
    "dDurationMs": 961,
    "segs": [ {
      "utf8": "up and answer."
    } ]
  }, {
    "tStartMs": 745358,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "So here is what I want you to do."
    } ]
  }, {
    "tStartMs": 747840,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "If a letter like this ever arrives,"
    } ]
  }, {
    "tStartMs": 750261,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "for you or for someone you love,"
    } ]
  }, {
    "tStartMs": 752843,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "do not panic, and do not hide it in"
    } ]
  }, {
    "tStartMs": 755645,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "a drawer."
    } ]
  }, {
    "tStartMs": 756605,
    "dDurationMs": 2262,
    "segs": [ {
      "utf8": "Open it the day it comes and look for"
    } ]
  }, {
    "tStartMs": 758867,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "the date, because that is where your thirty"
    } ]
  }, {
    "tStartMs": 761408,
    "dDurationMs": 1261,
    "segs": [ {
      "utf8": "day window begins."
    } ]
  }, {
    "tStartMs": 763530,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "Then decide which of the three fits."
    } ]
  }, {
    "tStartMs": 766371,
    "dDurationMs": 1722,
    "segs": [ {
      "utf8": "If you do not think you owe it,"
    } ]
  }, {
    "tStartMs": 768353,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "ask them to look again."
    } ]
  }, {
    "tStartMs": 770254,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "If it was not your fault and you cannot"
    } ]
  }, {
    "tStartMs": 772355,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "afford it, ask them to forgive it."
    } ]
  }, {
    "tStartMs": 775197,
    "dDurationMs": 1561,
    "segs": [ {
      "utf8": "And if you can pay something,"
    } ]
  }, {
    "tStartMs": 777038,
    "dDurationMs": 2862,
    "segs": [ {
      "utf8": "but not half, ask them to lower the rate."
    } ]
  }, {
    "tStartMs": 780360,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "You spent a lifetime paying into this system,"
    } ]
  }, {
    "tStartMs": 783482,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "check after check, decade after decade."
    } ]
  }, {
    "tStartMs": 787605,
    "dDurationMs": 1841,
    "segs": [ {
      "utf8": "The money it sends you is not a gift,"
    } ]
  }, {
    "tStartMs": 789867,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "and it is not a favor."
    } ]
  }, {
    "tStartMs": 791508,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It is yours."
    } ]
  }, {
    "tStartMs": 793249,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "And if anyone, even the agency itself,"
    } ]
  }, {
    "tStartMs": 796211,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "comes to take a piece of it back,"
    } ]
  }, {
    "tStartMs": 798472,
    "dDurationMs": 2121,
    "segs": [ {
      "utf8": "you have every right to stand up,"
    } ]
  }, {
    "tStartMs": 800874,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "open that letter, and make them prove it."
    } ]
  }, {
    "tStartMs": 803635,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "So do that."
    } ]
  }, {
    "tStartMs": 804916,
    "dDurationMs": 2602,
    "segs": [ {
      "utf8": "And then let yourself rest a little easier,"
    } ]
  }, {
    "tStartMs": 808018,
    "dDurationMs": 2442,
    "segs": [ {
      "utf8": "knowing that a letter is not a verdict,"
    } ]
  }, {
    "tStartMs": 810580,
    "dDurationMs": 2842,
    "segs": [ {
      "utf8": "and that you are not nearly as powerless as"
    } ]
  }, {
    "tStartMs": 813422,
    "dDurationMs": 1661,
    "segs": [ {
      "utf8": "that envelope wants you to feel."
    } ]
  } ]
}
