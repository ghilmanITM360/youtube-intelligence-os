{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "A letter comes."
    } ]
  }, {
    "tStartMs": 1780,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "It is printed to look as though a court\nhas already decided something about"
    } ]
  }, {
    "tStartMs": 5360,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "you, and it has a number along the top,\nand a date by which you are told to"
    } ]
  }, {
    "tStartMs": 9960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "respond."
    } ]
  }, {
    "tStartMs": 11560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Nothing has been decided."
    } ]
  }, {
    "tStartMs": 13560,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "No judge has seen your name. And the thing\nmost people do within a week of"
    } ]
  }, {
    "tStartMs": 17840,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "opening that letter is the single act that\ncan hand the sender a power they"
    } ]
  }, {
    "tStartMs": 22000,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "did not have when they posted it."
    } ]
  }, {
    "tStartMs": 24460,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "There are six things a collector cannot\ntake from an older person, and almost"
    } ]
  }, {
    "tStartMs": 28780,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "nobody is told what they are. The sixth is\nnot a thing at all."
    } ]
  }, {
    "tStartMs": 33720,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "It is a date, and people give it away by\nbeing decent."
    } ]
  }, {
    "tStartMs": 37920,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Number one. The paper that arrives looks\nlike a court order and is not one."
    } ]
  }, {
    "tStartMs": 43240,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Look at what is printed on it."
    } ]
  }, {
    "tStartMs": 45240,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Bold type across the top. A reference\nnumber."
    } ]
  }, {
    "tStartMs": 48400,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Words like final notice, or action\nrequired,"
    } ]
  }, {
    "tStartMs": 51300,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "or a demand that you reply within"
    } ]
  }, {
    "tStartMs": 53460,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "ten days. It is designed by people whose\nwork is to make a piece of company"
    } ]
  }, {
    "tStartMs": 58620,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "post feel like a summons."
    } ]
  }, {
    "tStartMs": 61380,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "A real court order carries the name of a\ncourt."
    } ]
  }, {
    "tStartMs": 64240,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "A real case has a number issued by that\ncourt, and it exists because somebody"
    } ]
  }, {
    "tStartMs": 68540,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "filed a lawsuit and because you were\nhanded the papers, by a person, at your"
    } ]
  }, {
    "tStartMs": 73300,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "door."
    } ]
  }, {
    "tStartMs": 74360,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "If none of that happened to you, then\nnothing has been decided about you by"
    } ]
  }, {
    "tStartMs": 78300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "anybody."
    } ]
  }, {
    "tStartMs": 79740,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Hold that next to what actually happens in\na kitchen."
    } ]
  }, {
    "tStartMs": 82720,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "An older woman opens an envelope, reads\nthe word final, and telephones the"
    } ]
  }, {
    "tStartMs": 87460,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "number on the page inside the hour."
    } ]
  }, {
    "tStartMs": 89660,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "That call is the whole purpose of the\ndesign."
    } ]
  }, {
    "tStartMs": 92900,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "The letter did not need to be true."
    } ]
  }, {
    "tStartMs": 94960,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "It needed to be answered."
    } ]
  }, {
    "tStartMs": 96980,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "So before you telephone anybody, find the\nname of a court printed anywhere"
    } ]
  }, {
    "tStartMs": 101220,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "on that page. If there is one, telephone\nthe clerk of that court and ask whether"
    } ]
  }, {
    "tStartMs": 106220,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "a case exists in your name. They will tell\nyou, it costs nothing, and it takes"
    } ]
  }, {
    "tStartMs": 111040,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "one call. If there is no court named at\nall, you are holding an advertisement"
    } ]
  }, {
    "tStartMs": 115760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "with a threatening face on it."
    } ]
  }, {
    "tStartMs": 118160,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "Now the opposite case, because getting\nthis backwards is worse than getting"
    } ]
  }, {
    "tStartMs": 122620,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "it wrong in the first direction."
    } ]
  }, {
    "tStartMs": 124960,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "If a real lawsuit has been filed, the\npapers are handed to you and there is"
    } ]
  }, {
    "tStartMs": 129760,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "a deadline printed on them to file your\nanswer with the court."
    } ]
  }, {
    "tStartMs": 133900,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Depending on the state it runs somewhere\nbetween fourteen and thirty five days."
    } ]
  }, {
    "tStartMs": 138400,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "Miss it and the court enters what is\ncalled a default judgment, which means"
    } ]
  }, {
    "tStartMs": 143620,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "the other side wins because nobody spoke."
    } ]
  }, {
    "tStartMs": 147420,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Understand what that unlocks, because it\nis the whole of the danger."
    } ]
  }, {
    "tStartMs": 152100,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "A judgment lets them ask a court to\ngarnish wages, to levy a bank account,"
    } ]
  }, {
    "tStartMs": 157080,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "to put a lien on property."
    } ]
  }, {
    "tStartMs": 159260,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Everything I am about to tell you about\nprotected money still holds afterwards,"
    } ]
  }, {
    "tStartMs": 163680,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "but it stops being automatic. That is the\nsentence to carry out of this video."
    } ]
  }, {
    "tStartMs": 169780,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The protections exist, and in a court they\nhave to be claimed."
    } ]
  }, {
    "tStartMs": 173860,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Nobody in that room will raise them for\nyou."
    } ]
  }, {
    "tStartMs": 176800,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "A person who stays silent because the\nenvelope frightened them can lose money"
    } ]
  }, {
    "tStartMs": 181140,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "that was never reachable, simply because\nthey were not there to say so."
    } ]
  }, {
    "tStartMs": 185560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Number two."
    } ]
  }, {
    "tStartMs": 186820,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "A credit card company cannot reach your\nSocial Security."
    } ]
  }, {
    "tStartMs": 190200,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Neither can a hospital. This is settled\nand it is not a grey area."
    } ]
  }, {
    "tStartMs": 194140,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Ordinary commercial debt cannot touch\nfederal benefit money."
    } ]
  }, {
    "tStartMs": 198940,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "That covers credit cards. It covers a\nhospital bill."
    } ]
  }, {
    "tStartMs": 202280,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "It covers a shop card, an old medical\naccount, and a company that bought your"
    } ]
  }, {
    "tStartMs": 206620,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "debt from somebody else for pennies."
    } ]
  }, {
    "tStartMs": 209180,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The people telephoning about those debts\nknow this."
    } ]
  }, {
    "tStartMs": 212460,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "They knew it before they dialled."
    } ]
  }, {
    "tStartMs": 214480,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Nothing in the law requires them to say it\nto you, and saying it would end"
    } ]
  }, {
    "tStartMs": 218320,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "the call. There are limits on how they are\nallowed to behave while they do"
    } ]
  }, {
    "tStartMs": 222460,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "it, and almost no older person has been\ntold them."
    } ]
  }, {
    "tStartMs": 226020,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "They cannot telephone you before eight in\nthe morning or after nine at night."
    } ]
  }, {
    "tStartMs": 230300,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "They are presumed to be breaking the law\nif they ring you about the same debt"
    } ]
  }, {
    "tStartMs": 234360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "more than seven times in seven days."
    } ]
  }, {
    "tStartMs": 237060,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "And they cannot threaten you with arrest,\nbecause an unpaid bill is a civil"
    } ]
  }, {
    "tStartMs": 241420,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "matter and nobody in this country goes to\njail over one."
    } ]
  }, {
    "tStartMs": 245400,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "There is also a document they owe you."
    } ]
  }, {
    "tStartMs": 247300,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Within five days of first making contact,\na collector has to send you a written"
    } ]
  }, {
    "tStartMs": 251940,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "notice naming the original creditor,\nstating the amount, and telling you that"
    } ]
  }, {
    "tStartMs": 256500,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "you have thirty days to dispute it."
    } ]
  }, {
    "tStartMs": 258760,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "If you dispute it in writing inside that\nwindow, they must stop collecting"
    } ]
  }, {
    "tStartMs": 262920,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "until they have sent you verification."
    } ]
  }, {
    "tStartMs": 266080,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Most people never use that window, because\nnobody tells them it is open."
    } ]
  }, {
    "tStartMs": 270640,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "The other direction is true as well and\nyou should hear it from me rather than"
    } ]
  }, {
    "tStartMs": 274700,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "from them. Debts owed to the government\nitself are a separate matter."
    } ]
  }, {
    "tStartMs": 279220,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Back federal taxes. A federal student loan\ngone into default."
    } ]
  }, {
    "tStartMs": 283780,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Support ordered by a family court."
    } ]
  }, {
    "tStartMs": 286080,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Those have their own machinery and their\nown limits."
    } ]
  }, {
    "tStartMs": 289300,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Even those are capped. A student loan\noffset cannot take more than a set share,"
    } ]
  }, {
    "tStartMs": 294640,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "and it cannot push a monthly payment below\nseven hundred and fifty dollars."
    } ]
  }, {
    "tStartMs": 299320,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Anyone receiving that figure or less is\nuntouched by it entirely."
    } ]
  }, {
    "tStartMs": 303560,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "So the picture is narrower than the one\npeople carry around."
    } ]
  }, {
    "tStartMs": 307820,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "The category doing the telephoning is\nalmost always the category with no power"
    } ]
  }, {
    "tStartMs": 312140,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to collect."
    } ]
  }, {
    "tStartMs": 313560,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Number three. There is one payment nobody\ncan touch."
    } ]
  }, {
    "tStartMs": 317380,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Not even the government."
    } ]
  }, {
    "tStartMs": 318980,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Supplemental Security Income sits outside\nall of it."
    } ]
  }, {
    "tStartMs": 322140,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "A commercial creditor cannot reach it."
    } ]
  }, {
    "tStartMs": 324380,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The government cannot reach it either, and\nthat is the part that surprises"
    } ]
  }, {
    "tStartMs": 327740,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "people who assume the government can\nalways take what it is owed."
    } ]
  }, {
    "tStartMs": 331100,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Not for a tax debt. Not for a student\nloan."
    } ]
  }, {
    "tStartMs": 334620,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Not for support. It is the one payment in\nthe entire system that is closed"
    } ]
  }, {
    "tStartMs": 338980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to everybody."
    } ]
  }, {
    "tStartMs": 340860,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "If that is what arrives in your account\neach month, then the whole of this"
    } ]
  }, {
    "tStartMs": 345020,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "video is about a danger that cannot reach\nyou, and the only thing that can"
    } ]
  }, {
    "tStartMs": 348840,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "put your money at risk is something you do\nyourself."
    } ]
  }, {
    "tStartMs": 352180,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Which brings us to number six, and I will\nget there."
    } ]
  }, {
    "tStartMs": 355480,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Number four. If your money comes from any\nof these four places, it was never"
    } ]
  }, {
    "tStartMs": 359720,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "theirs to take. Veterans Affairs\ndisability payments."
    } ]
  }, {
    "tStartMs": 363620,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Railroad retirement. Civil Service\nretirement."
    } ]
  }, {
    "tStartMs": 366880,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Federal Employees Retirement. Four\nseparate systems, four separate offices,"
    } ]
  }, {
    "tStartMs": 371740,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "and every one of them protected in the\nsame way."
    } ]
  }, {
    "tStartMs": 374940,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "A person can spend a year frightened of a\ncollector while every dollar arriving"
    } ]
  }, {
    "tStartMs": 379480,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "in their account came from a source that\ncollector was never able to reach."
    } ]
  }, {
    "tStartMs": 383320,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "There is machinery behind these four that\nruns without you."
    } ]
  }, {
    "tStartMs": 387740,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "A bank served with an order has to review\nthe account itself and set aside"
    } ]
  }, {
    "tStartMs": 391860,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "the federal benefit money paid in over the\npreceding sixty days, and that amount"
    } ]
  }, {
    "tStartMs": 396260,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "has to stay spendable. Nobody asks you."
    } ]
  }, {
    "tStartMs": 399320,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Nobody sends you a form. It turns on one\ncondition."
    } ]
  }, {
    "tStartMs": 403400,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "The payment has to arrive straight from\nthe government into the account."
    } ]
  }, {
    "tStartMs": 407560,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Money that passed through your hands first\nis outside the rule, so a paper"
    } ]
  }, {
    "tStartMs": 411560,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "payment cashed at a counter and paid in\nafterwards loses it."
    } ]
  }, {
    "tStartMs": 415860,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Number five. The tools you work with, and\nthe things inside your house, stay"
    } ]
  }, {
    "tStartMs": 420060,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "with you. Every state keeps a list of what\ncannot be taken from a person regardless"
    } ]
  }, {
    "tStartMs": 425040,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "of what they owe. Household furniture."
    } ]
  }, {
    "tStartMs": 427900,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Clothing. In most states a wedding ring."
    } ]
  }, {
    "tStartMs": 430520,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Cooking equipment. The tools somebody uses\nto earn a living, whether that is"
    } ]
  }, {
    "tStartMs": 434380,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "a set of wrenches, a sewing machine, or a\nladder and a bucket."
    } ]
  }, {
    "tStartMs": 437780,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "The amounts differ enormously from one\nstate to the next, so I am not going"
    } ]
  }, {
    "tStartMs": 442960,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "to name a figure that is wrong where you\nlive."
    } ]
  }, {
    "tStartMs": 445820,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Here is what I want you to notice about\nthis one."
    } ]
  }, {
    "tStartMs": 448620,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Collectors very rarely go after household\ngoods, because the cost of doing"
    } ]
  }, {
    "tStartMs": 453200,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "it is greater than anything they would\nrecover."
    } ]
  }, {
    "tStartMs": 456020,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "It almost never happens. But people give\nthings away anyway, out of fear, because"
    } ]
  }, {
    "tStartMs": 461660,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "somebody on the telephone let them believe\nit could."
    } ]
  }, {
    "tStartMs": 464000,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "Before you agree to anything at all, ask\nfor your own state exemption list."
    } ]
  }, {
    "tStartMs": 469300,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Your state legal aid office keeps it, they\ngive it out free, and reading it"
    } ]
  }, {
    "tStartMs": 473520,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "is often the moment a person stops being\nfrightened."
    } ]
  }, {
    "tStartMs": 476960,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Number six. Most old debt has a date on\nit, and one dollar can undo that date."
    } ]
  }, {
    "tStartMs": 482540,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Every state sets a period during which a\ndebt can be taken to court."
    } ]
  }, {
    "tStartMs": 486420,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Depending on where you live and what kind\nof debt it is, it runs somewhere"
    } ]
  }, {
    "tStartMs": 489960,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "between three and ten years. When that\nperiod ends, the debt is called time"
    } ]
  }, {
    "tStartMs": 494680,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "barred, and what that means is precise."
    } ]
  }, {
    "tStartMs": 497440,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "They can no longer sue you for it."
    } ]
  }, {
    "tStartMs": 500060,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Understand exactly what expires, because\nthis is where people get it wrong"
    } ]
  }, {
    "tStartMs": 504160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "in both directions."
    } ]
  }, {
    "tStartMs": 505940,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "The debt does not vanish. The telephone\ncalls do not stop."
    } ]
  }, {
    "tStartMs": 509900,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "What ends is their right to take you to\ncourt."
    } ]
  }, {
    "tStartMs": 512360,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "That is the whole of it, and it is still\nenormous, because court is the only"
    } ]
  }, {
    "tStartMs": 516880,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "route to your money. Now the mechanism,\nand this is the reason this video exists."
    } ]
  }, {
    "tStartMs": 522020,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "In most states, a partial payment on an\nold debt restarts that clock from the"
    } ]
  }, {
    "tStartMs": 526420,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "day you make it. One dollar does it."
    } ]
  }, {
    "tStartMs": 529040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "A written promise to pay does it."
    } ]
  }, {
    "tStartMs": 531160,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "In some states, simply saying out loud\nthat the debt is yours can do it."
    } ]
  }, {
    "tStartMs": 535700,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Think about who that catches. Not the\nperson who ignores the letter."
    } ]
  }, {
    "tStartMs": 539340,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "The person who wants to do the right\nthing."
    } ]
  }, {
    "tStartMs": 541780,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Somebody in their seventies, who has never\nmissed a payment in their life,"
    } ]
  }, {
    "tStartMs": 545440,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "sends twenty five dollars towards a\nfifteen year old account because it feels"
    } ]
  }, {
    "tStartMs": 549160,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "honest. That twenty five dollars can hand\nback a right to sue that had already"
    } ]
  }, {
    "tStartMs": 553820,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "expired."
    } ]
  }, {
    "tStartMs": 555200,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Texas is the exception worth naming."
    } ]
  }, {
    "tStartMs": 557700,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Their state law says a payment does not\nrevive a debt that has already run"
    } ]
  }, {
    "tStartMs": 561580,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "out of time. If you are anywhere else,\nassume it does."
    } ]
  }, {
    "tStartMs": 565360,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So the date you need is the last payment\nmade on that account, and most people"
    } ]
  }, {
    "tStartMs": 569360,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "cannot remember it. There is a free way to\nfind it."
    } ]
  }, {
    "tStartMs": 572480,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Your credit report lists the date of last\nactivity on each account, and you"
    } ]
  }, {
    "tStartMs": 576660,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "are entitled to one from each of the three\nreporting companies at no charge."
    } ]
  }, {
    "tStartMs": 580960,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Pull it before you speak to anybody, and\nwrite that date on the letter itself."
    } ]
  }, {
    "tStartMs": 585460,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "One more thing collectors rely on."
    } ]
  }, {
    "tStartMs": 587520,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "A debt sold on to a buyer often arrives\nwith very little paperwork behind it,"
    } ]
  }, {
    "tStartMs": 591880,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "because the file changed hands for pennies\nand the documents did not always"
    } ]
  }, {
    "tStartMs": 595720,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "travel with it. When somebody disputes in\nwriting and asks for verification,"
    } ]
  }, {
    "tStartMs": 600500,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "a fair number of those accounts simply go\nquiet, not because the debt was imaginary,"
    } ]
  }, {
    "tStartMs": 605700,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "but because nobody kept the proof."
    } ]
  }, {
    "tStartMs": 607880,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "So the single most dangerous thing in this\nentire subject is not a collector."
    } ]
  }, {
    "tStartMs": 612880,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "It is a decent instinct, acted on before\nanybody checked a date."
    } ]
  }, {
    "tStartMs": 617440,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Three moves, and none of them costs\nanything."
    } ]
  }, {
    "tStartMs": 620580,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "This is general information rather than\nadvice about your own circumstances,"
    } ]
  }, {
    "tStartMs": 624720,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "because state law differs and yours is\nyours."
    } ]
  }, {
    "tStartMs": 628020,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "First, pay nothing on an old account until\nthe date is established."
    } ]
  }, {
    "tStartMs": 631260,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "The date that matters is the last payment\nmade on it."
    } ]
  }, {
    "tStartMs": 635320,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Second, write to the collector and require\nverification of the debt, including"
    } ]
  }, {
    "tStartMs": 639180,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "the month the account fell into default."
    } ]
  }, {
    "tStartMs": 641680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "Written demands leave a record."
    } ]
  }, {
    "tStartMs": 643560,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Telephone calls do not. Third, your state\nlegal aid office handles this every"
    } ]
  }, {
    "tStartMs": 647980,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "day, free, for older people. They will sit\nwith the letter and read it with"
    } ]
  }, {
    "tStartMs": 652320,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "you. One warning about the calls\nthemselves."
    } ]
  }, {
    "tStartMs": 654920,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "If somebody telephones saying they are\nfrom a law firm and that papers are"
    } ]
  }, {
    "tStartMs": 659020,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "being prepared today, ask for the name of\nthe court and the case number, and"
    } ]
  }, {
    "tStartMs": 663440,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "say you will telephone the court yourself\nto confirm."
    } ]
  }, {
    "tStartMs": 666420,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "A real case survives that question."
    } ]
  }, {
    "tStartMs": 668760,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Almost nothing else does."
    } ]
  }, {
    "tStartMs": 670780,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "So, six things, and who each one is closed\nto."
    } ]
  }, {
    "tStartMs": 674200,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The letter in your hand is not a court\norder unless a court is named on it."
    } ]
  }, {
    "tStartMs": 678280,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "A credit card company or a hospital cannot\nreach your Social Security, though"
    } ]
  }, {
    "tStartMs": 682500,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "the government can for its own debts."
    } ]
  }, {
    "tStartMs": 685360,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Supplemental Security Income cannot be\nreached by anybody at all."
    } ]
  }, {
    "tStartMs": 689160,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Veterans, railroad, civil service and\nfederal retirement money is protected"
    } ]
  }, {
    "tStartMs": 693560,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "the same way, and your bank shields two\nmonths of it automatically."
    } ]
  }, {
    "tStartMs": 697760,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Your household goods and the tools you\nwork with are on a protected list your"
    } ]
  }, {
    "tStartMs": 701540,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "state publishes. And most old debt\neventually runs out of time, unless you"
    } ]
  }, {
    "tStartMs": 707160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "restart the clock by paying a single\ndollar."
    } ]
  }, {
    "tStartMs": 711020,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Every one of those has been written down\nfor years."
    } ]
  }, {
    "tStartMs": 714580,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "It works badly for older people only\nbecause the side that knows the rules"
    } ]
  }, {
    "tStartMs": 719140,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "is the side being paid to telephone, and\nthe side that needs them is handed"
    } ]
  }, {
    "tStartMs": 724180,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "a printed page designed to stop them from\nreading anything else."
    } ]
  }, {
    "tStartMs": 728520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "If there is somebody in your family who\nhas been getting these letters and"
    } ]
  }, {
    "tStartMs": 732360,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "has gone quiet about it, do not ask them\nhow much they owe."
    } ]
  }, {
    "tStartMs": 737100,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Ask them one thing. Have you paid anything\non it recently."
    } ]
  } ]
}
