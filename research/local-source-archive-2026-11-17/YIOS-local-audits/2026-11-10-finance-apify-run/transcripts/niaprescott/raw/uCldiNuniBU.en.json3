{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Here is some good news for a change."
    } ]
  }, {
    "tStartMs": 3260,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Starting in January, five things change\nfor your money."
    } ]
  }, {
    "tStartMs": 7980,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Four of them you will hear about on the\nnews, and they are real."
    } ]
  }, {
    "tStartMs": 12480,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "The fifth one almost nobody claims."
    } ]
  }, {
    "tStartMs": 15580,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "For the people who qualify it is worth\nabout two thousand four hundred dollars"
    } ]
  }, {
    "tStartMs": 19980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a year."
    } ]
  }, {
    "tStartMs": 21600,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Hold that number against the raise\neverybody is talking about, because it is"
    } ]
  }, {
    "tStartMs": 26200,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "three or four times larger than the raise\nwill be for the same person."
    } ]
  }, {
    "tStartMs": 31220,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "I am going to take all five one at a time."
    } ]
  }, {
    "tStartMs": 33800,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "For each one I will tell you the real\nnumber, what it does to your deposit,"
    } ]
  }, {
    "tStartMs": 37940,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "and the one thing you do about it."
    } ]
  }, {
    "tStartMs": 40580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Four of them need nothing from you at all."
    } ]
  }, {
    "tStartMs": 43140,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "One of them will sit there untouched for\nthe rest of your life if you never"
    } ]
  }, {
    "tStartMs": 46940,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "raise your hand. Stay to the end for\nnumber five, because it is the one nobody"
    } ]
  }, {
    "tStartMs": 52140,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "is going to mail you a letter about."
    } ]
  }, {
    "tStartMs": 54160,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "Every figure here comes from the agencies\nthemselves, and the sources are in"
    } ]
  }, {
    "tStartMs": 59600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "the description."
    } ]
  }, {
    "tStartMs": 61060,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Number one. The raise lands by itself."
    } ]
  }, {
    "tStartMs": 64440,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "Nobody has to ask."
    } ]
  }, {
    "tStartMs": 66420,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "Social Security confirmed the increase for\nnext year at three point six percent."
    } ]
  }, {
    "tStartMs": 71350,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "It reaches about seventy six million\npeople, and it starts with the January"
    } ]
  }, {
    "tStartMs": 76120,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "payment. On an average retired worker\ncheck that is roughly seventy five dollars"
    } ]
  }, {
    "tStartMs": 80940,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "more a month. On a thousand dollar check\nit is about thirty six dollars."
    } ]
  }, {
    "tStartMs": 86520,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "On a fifteen hundred dollar check it is\nabout fifty four."
    } ]
  }, {
    "tStartMs": 90880,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "Run your own number and you will know what\nto expect before the letter arrives."
    } ]
  }, {
    "tStartMs": 95860,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "In December the agency posts your exact\nnew amount."
    } ]
  }, {
    "tStartMs": 100140,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "If you have an account on their website it\nappears in your message center."
    } ]
  }, {
    "tStartMs": 104760,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "If you do not, it comes by mail."
    } ]
  }, {
    "tStartMs": 108260,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Read that notice instead of filing it."
    } ]
  }, {
    "tStartMs": 110500,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "It shows your new gross payment and it"
    } ]
  }, {
    "tStartMs": 112940,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "shows what is being taken out for\nMedicare."
    } ]
  }, {
    "tStartMs": 115720,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Put it beside the letter from last year\nand compare the two lines."
    } ]
  }, {
    "tStartMs": 120160,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "That one habit catches errors that\notherwise ride along for years."
    } ]
  }, {
    "tStartMs": 125540,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Now one warning that costs people money\nevery single year."
    } ]
  }, {
    "tStartMs": 130000,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "The week a raise is announced, the phone\ncalls start."
    } ]
  }, {
    "tStartMs": 133580,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Somebody says they can get you a larger\nincrease, or that you have to confirm"
    } ]
  }, {
    "tStartMs": 137600,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "your details to receive it. You do not."
    } ]
  }, {
    "tStartMs": 140620,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "The raise is automatic."
    } ]
  }, {
    "tStartMs": 142680,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Nobody needs your number to give you\nsomething you already have."
    } ]
  }, {
    "tStartMs": 146380,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "And there is one number missing from all\nof this, which is the reason I am"
    } ]
  }, {
    "tStartMs": 150920,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "not going to tell you your net increase."
    } ]
  }, {
    "tStartMs": 153540,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Medicare has not published the Part B\npremium for next year yet."
    } ]
  }, {
    "tStartMs": 157800,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "The trustees project about two hundred and\nnine dollars and fifty cents, up"
    } ]
  }, {
    "tStartMs": 162440,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "from two hundred and two dollars and\nninety cents, but a projection is not"
    } ]
  }, {
    "tStartMs": 166560,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "a published figure. It normally arrives in\nthe middle of November."
    } ]
  }, {
    "tStartMs": 170640,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "Until it does, nobody on this website can\ntell you what your deposit will actually"
    } ]
  }, {
    "tStartMs": 175720,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "be in January, and anybody who says a\nprecise figure is guessing."
    } ]
  }, {
    "tStartMs": 181180,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "There is a rule that stops the Part B\nincrease from pushing your payment below"
    } ]
  }, {
    "tStartMs": 186000,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "what it was the year before, and for most\npeople it holds."
    } ]
  }, {
    "tStartMs": 190400,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "It does not cover you if you are new to\nMedicare this year, if your premium"
    } ]
  }, {
    "tStartMs": 195180,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "is billed to you directly rather than\ntaken from your payment,"
    } ]
  }, {
    "tStartMs": 199100,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "or if you pay the higher charge that\napplies at higher incomes."
    } ]
  }, {
    "tStartMs": 202980,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Roughly three in ten people sit outside\nthat protection."
    } ]
  }, {
    "tStartMs": 207160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Number two."
    } ]
  }, {
    "tStartMs": 208480,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Medicare Advantage premiums go down next\nyear, not up."
    } ]
  }, {
    "tStartMs": 212900,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "This one surprises people because it runs\nagainst everything else they hear."
    } ]
  }, {
    "tStartMs": 217780,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "At the end of September, Medicare released\nthe figures for next year."
    } ]
  }, {
    "tStartMs": 222620,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "The average monthly premium on a Medicare\nAdvantage plan is expected to fall"
    } ]
  }, {
    "tStartMs": 227760,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "from fourteen dollars and thirty seven\ncents to twelve dollars."
    } ]
  }, {
    "tStartMs": 231840,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "That is a drop of about sixteen and a half\npercent."
    } ]
  }, {
    "tStartMs": 235140,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The part of that premium that pays for\nyour prescriptions falls further."
    } ]
  }, {
    "tStartMs": 240440,
    "dDurationMs": 4347,
    "segs": [ {
      "utf8": "It goes from about eleven dollars and\nthirty two cents down to about seven."
    } ]
  }, {
    "tStartMs": 245480,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "That is a drop of nearly forty percent."
    } ]
  }, {
    "tStartMs": 248520,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Medicare also estimates that about eight\nin ten people on a Medicare Advantage"
    } ]
  }, {
    "tStartMs": 253120,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "plan will be able to stay exactly where\nthey are next year at the same premium"
    } ]
  }, {
    "tStartMs": 258020,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "or a lower one."
    } ]
  }, {
    "tStartMs": 260280,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Now here is the honest limit of that, and\nI would rather you heard it from"
    } ]
  }, {
    "tStartMs": 264160,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "me. An average is only an average."
    } ]
  }, {
    "tStartMs": 266840,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Your own plan can fall, hold still, or\nrise."
    } ]
  }, {
    "tStartMs": 270300,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "And the premium is the smallest part of\nwhat a plan costs you."
    } ]
  }, {
    "tStartMs": 274820,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "What you pay at the doctor, what you pay\nat the pharmacy, and the most you"
    } ]
  }, {
    "tStartMs": 278700,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "can be charged in a single year all matter\nmore than the premium does."
    } ]
  }, {
    "tStartMs": 282860,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Here is the move."
    } ]
  }, {
    "tStartMs": 284840,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Find the envelope your plan sent you\ncalled the annual notice of change."
    } ]
  }, {
    "tStartMs": 289780,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "It is the one most people throw out."
    } ]
  }, {
    "tStartMs": 292680,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "It tells you exactly what is changing for\nyou, not for the average."
    } ]
  }, {
    "tStartMs": 296880,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "Then compare it against the other plans\nwhere you live before the seventh of"
    } ]
  }, {
    "tStartMs": 302200,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "December, because that is when your choice\nlocks for the whole year."
    } ]
  }, {
    "tStartMs": 307000,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "One caution before you move. If you have\noriginal Medicare with a supplement"
    } ]
  }, {
    "tStartMs": 311060,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "today, a cheaper premium is not on its own\na reason to switch to an Advantage"
    } ]
  }, {
    "tStartMs": 315400,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "plan."
    } ]
  }, {
    "tStartMs": 316560,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "In most states, once you give up that\nsupplement you may not be able to buy"
    } ]
  }, {
    "tStartMs": 320900,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "it back without answering health\nquestions."
    } ]
  }, {
    "tStartMs": 322740,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "That door closes quietly behind you."
    } ]
  }, {
    "tStartMs": 326720,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Number three."
    } ]
  }, {
    "tStartMs": 328360,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "Six thousand dollars off your taxable\nincome, and what that saves you."
    } ]
  }, {
    "tStartMs": 333360,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "The tax law passed last year created a\ndeduction that exists only for people"
    } ]
  }, {
    "tStartMs": 338120,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "sixty five and older. It is six thousand\ndollars for each person."
    } ]
  }, {
    "tStartMs": 343000,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "For a married couple where both of you are\nover sixty five, that is twelve"
    } ]
  }, {
    "tStartMs": 347520,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "thousand. What makes it different from\nalmost every other break is that it"
    } ]
  }, {
    "tStartMs": 351960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "stacks."
    } ]
  }, {
    "tStartMs": 353240,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "It sits on top of the standard deduction,\nand on top of the extra amount people"
    } ]
  }, {
    "tStartMs": 357900,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "over sixty five have always received."
    } ]
  }, {
    "tStartMs": 360860,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "You get it whether you take the standard\ndeduction or itemize."
    } ]
  }, {
    "tStartMs": 365220,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Most deductions make you choose one or the\nother."
    } ]
  }, {
    "tStartMs": 368040,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "This one does not. It shrinks at higher\nincome."
    } ]
  }, {
    "tStartMs": 372240,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "It starts coming down above seventy five\nthousand dollars for a single filer,"
    } ]
  }, {
    "tStartMs": 376820,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "or one hundred fifty thousand for a\ncouple, and it disappears entirely well"
    } ]
  }, {
    "tStartMs": 381880,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "above that."
    } ]
  }, {
    "tStartMs": 383300,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Now the part nobody puts a number on."
    } ]
  }, {
    "tStartMs": 386100,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "A deduction is not a check. What it saves\nyou depends on your tax rate."
    } ]
  }, {
    "tStartMs": 391600,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "If your top rate is twelve percent, six\nthousand dollars off your income saves"
    } ]
  }, {
    "tStartMs": 396860,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "you about seven hundred and twenty\ndollars."
    } ]
  }, {
    "tStartMs": 399320,
    "dDurationMs": 3929,
    "segs": [ {
      "utf8": "For a couple where both qualify, about\nfourteen hundred and forty."
    } ]
  }, {
    "tStartMs": 404280,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "That is every year through the twenty\ntwenty eight tax year."
    } ]
  }, {
    "tStartMs": 407960,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "And here is the honest limit. This only\nputs money back in your hand if you"
    } ]
  }, {
    "tStartMs": 412820,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "owe federal income tax in the first place."
    } ]
  }, {
    "tStartMs": 415720,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "If your income is almost entirely Social\nSecurity and you already owe nothing,"
    } ]
  }, {
    "tStartMs": 421040,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "this changes very little for you."
    } ]
  }, {
    "tStartMs": 423180,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "You may also have heard that Social\nSecurity is no longer taxed at all."
    } ]
  }, {
    "tStartMs": 426860,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "That is not what the law did. It created a\ndeduction, and it put an end date"
    } ]
  }, {
    "tStartMs": 431760,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "on it. So do not stop having tax withheld\nfrom your payments until somebody"
    } ]
  }, {
    "tStartMs": 436640,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "has actually run your numbers."
    } ]
  }, {
    "tStartMs": 438840,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Number four. The January payment arrives\non the last day of December."
    } ]
  }, {
    "tStartMs": 443180,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "This one is small and it catches people\nout every year, so it is worth the"
    } ]
  }, {
    "tStartMs": 447180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "ninety seconds."
    } ]
  }, {
    "tStartMs": 448780,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "If you receive Supplemental Security\nIncome, the federal amount goes up in"
    } ]
  }, {
    "tStartMs": 452720,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "January. For one person it moves from nine\nhundred and ninety four dollars"
    } ]
  }, {
    "tStartMs": 456300,
    "dDurationMs": 5582,
    "segs": [ {
      "utf8": "to one thousand twenty nine. For a couple\nit moves from one thousand four hundred"
    } ]
  }, {
    "tStartMs": 461882,
    "dDurationMs": 2618,
    "segs": [ {
      "utf8": "and ninety one to one thousand five\nhundred and forty four."
    } ]
  }, {
    "tStartMs": 465340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Now the timing."
    } ]
  }, {
    "tStartMs": 466780,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "The first of January is a federal holiday,\nso the January payment does not"
    } ]
  }, {
    "tStartMs": 470920,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "arrive in January. It is sent on the\nthirty first of December instead."
    } ]
  }, {
    "tStartMs": 475740,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "That means two payments land in the same\ncalendar month, December, and none"
    } ]
  }, {
    "tStartMs": 480240,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "arrives on the first of January."
    } ]
  }, {
    "tStartMs": 482340,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Every year people see that and assume"
    } ]
  }, {
    "tStartMs": 484180,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "something has gone wrong, or that a\npayment"
    } ]
  }, {
    "tStartMs": 486420,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "has been missed. Nothing has gone wrong."
    } ]
  }, {
    "tStartMs": 489180,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "It is the calendar, not the agency."
    } ]
  }, {
    "tStartMs": 492040,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Write that date down somewhere you will\nsee it, and if you know somebody who"
    } ]
  }, {
    "tStartMs": 495600,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "panics when a deposit does not appear,\ntell them now rather than on the holiday"
    } ]
  }, {
    "tStartMs": 500100,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "itself, when nobody is answering the\nphone."
    } ]
  }, {
    "tStartMs": 503080,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Number five. Your state can pay your Part\nB."
    } ]
  }, {
    "tStartMs": 506540,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "That is two thousand four hundred a year."
    } ]
  }, {
    "tStartMs": 509120,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Now the one I promised you, and the reason\nI made this."
    } ]
  }, {
    "tStartMs": 511820,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "If you are on Medicare, more than two\nhundred dollars a month is coming out"
    } ]
  }, {
    "tStartMs": 516080,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "of your Social Security before the deposit\never reaches your bank."
    } ]
  }, {
    "tStartMs": 520140,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "The standard Part B premium this year is\ntwo hundred and two dollars and ninety"
    } ]
  }, {
    "tStartMs": 524220,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "cents. You never see that money."
    } ]
  }, {
    "tStartMs": 526880,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It is gone before the payment is a\npayment."
    } ]
  }, {
    "tStartMs": 529780,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Over a year it is more than two thousand\nfour hundred dollars."
    } ]
  }, {
    "tStartMs": 533120,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "There is a set of programs, run by your\nown state, that take over that payment"
    } ]
  }, {
    "tStartMs": 537780,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "entirely. They are called Medicare Savings\nPrograms."
    } ]
  }, {
    "tStartMs": 540920,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "When you qualify, the premium stops being\ndeducted."
    } ]
  }, {
    "tStartMs": 545180,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Your deposit is larger by that amount\nevery month, for as long as you qualify."
    } ]
  }, {
    "tStartMs": 550000,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Hear what that is, because people mishear\nit."
    } ]
  }, {
    "tStartMs": 552720,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "It is not a refund at the end of the year."
    } ]
  }, {
    "tStartMs": 555020,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It is not a credit."
    } ]
  }, {
    "tStartMs": 556700,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "The deduction simply stops. There are\nthree levels."
    } ]
  }, {
    "tStartMs": 560560,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The most generous one also covers your\nMedicare deductible and your share of"
    } ]
  }, {
    "tStartMs": 565000,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "the cost when you see a doctor, which\nmeans the bills that arrive three weeks"
    } ]
  }, {
    "tStartMs": 569000,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "after an appointment stop arriving."
    } ]
  }, {
    "tStartMs": 571560,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The other two cover the premium itself."
    } ]
  }, {
    "tStartMs": 573480,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And there is a second thing that comes\nwith it."
    } ]
  }, {
    "tStartMs": 576160,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "If you qualify for any of these, you are\nautomatically given a separate program"
    } ]
  }, {
    "tStartMs": 580540,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "that lowers what you pay for\nprescriptions."
    } ]
  }, {
    "tStartMs": 583140,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "You do not file for it twice. It follows\nyou."
    } ]
  }, {
    "tStartMs": 586460,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "It does not run in reverse, which is why\nthere are people today getting help"
    } ]
  }, {
    "tStartMs": 590500,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "with medicine while still paying their\nPart B out of their own payment."
    } ]
  }, {
    "tStartMs": 594120,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Now the income lines, and this is where\npeople talk themselves out of it."
    } ]
  }, {
    "tStartMs": 598480,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "For the most generous level, a single\nperson can have monthly income up to"
    } ]
  }, {
    "tStartMs": 602420,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "about one thousand three hundred and fifty\ndollars,"
    } ]
  }, {
    "tStartMs": 604940,
    "dDurationMs": 2850,
    "segs": [ {
      "utf8": "and a couple up to about one thousand\neight hundred and twenty four."
    } ]
  }, {
    "tStartMs": 608340,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The middle level reaches about one\nthousand six hundred and sixteen for one"
    } ]
  }, {
    "tStartMs": 611940,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "person and two thousand one hundred and\neighty four for a couple."
    } ]
  }, {
    "tStartMs": 615900,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "The third level goes up to about one\nthousand eight hundred and sixteen for"
    } ]
  }, {
    "tStartMs": 619360,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "one person and two thousand four hundred\nand fifty five for a couple."
    } ]
  }, {
    "tStartMs": 624120,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Read those against your own situation and\nbe honest about something."
    } ]
  }, {
    "tStartMs": 628340,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Those lines are higher than you assumed."
    } ]
  }, {
    "tStartMs": 630620,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Almost everybody assumes they are lower."
    } ]
  }, {
    "tStartMs": 633280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "There is a savings limit as well."
    } ]
  }, {
    "tStartMs": 635460,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "About nine thousand nine hundred and fifty\ndollars for one person, and about"
    } ]
  }, {
    "tStartMs": 639360,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "fourteen thousand nine hundred and ten for\na couple."
    } ]
  }, {
    "tStartMs": 642600,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And here is what gets left out of that\ncount."
    } ]
  }, {
    "tStartMs": 644760,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The house you live in does not count."
    } ]
  }, {
    "tStartMs": 647220,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Your car does not count. Your furniture\nand your belongings do not count."
    } ]
  }, {
    "tStartMs": 651620,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "It is bank accounts and investments they\nare looking at."
    } ]
  }, {
    "tStartMs": 654760,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "So the person who looks around at a paid\noff house and a working car and decides"
    } ]
  }, {
    "tStartMs": 658820,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "they are far too comfortable for this has\njust ruled themselves out over two"
    } ]
  }, {
    "tStartMs": 662880,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "things that were never being counted."
    } ]
  }, {
    "tStartMs": 665220,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Some states also set their lines higher\nthan the federal ones, and some do"
    } ]
  }, {
    "tStartMs": 669120,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "not apply the savings test at all."
    } ]
  }, {
    "tStartMs": 671000,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "That varies by where you live, which is\nexactly why you cannot answer this"
    } ]
  }, {
    "tStartMs": 675060,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "at your own table. Nobody is coming to\ntell you."
    } ]
  }, {
    "tStartMs": 678420,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "There is no office reviewing your income\nand posting you a letter."
    } ]
  }, {
    "tStartMs": 683240,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "These programs pay out on application, not\non eligibility."
    } ]
  }, {
    "tStartMs": 687780,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "The agency has your income and your age\nand it will sit on that information"
    } ]
  }, {
    "tStartMs": 692080,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "for the rest of your life if you never\napply."
    } ]
  }, {
    "tStartMs": 695680,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Here is the move, and you can start it\nthis week."
    } ]
  }, {
    "tStartMs": 699120,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Call your state Medicaid office and"
    } ]
  }, {
    "tStartMs": 701300,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "ask for the Medicare Savings Program\napplication"
    } ]
  }, {
    "tStartMs": 703860,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "by name. Or call the free counselling\nservice in your state and they will help"
    } ]
  }, {
    "tStartMs": 709000,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "you fill it out. If you do not know the\nnumber, call Medicare and ask them"
    } ]
  }, {
    "tStartMs": 714100,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "for your state office. It is free to\napply."
    } ]
  }, {
    "tStartMs": 717620,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "If somebody asks you to pay to file it,\nyou are being taken."
    } ]
  }, {
    "tStartMs": 721780,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And if you were turned down in an earlier\nyear, that answer has expired."
    } ]
  }, {
    "tStartMs": 726360,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The income lines move almost every year."
    } ]
  }, {
    "tStartMs": 729200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Ask again."
    } ]
  }, {
    "tStartMs": 730620,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "One more thing about applying, because\npeople assume the clock starts the day"
    } ]
  }, {
    "tStartMs": 735000,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "they are approved. For some of these,\ncoverage can reach backward, and months"
    } ]
  }, {
    "tStartMs": 739980,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "you have already paid for can be picked\nup."
    } ]
  }, {
    "tStartMs": 742900,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Ask about that specifically when you call,\nbecause nobody volunteers it."
    } ]
  }, {
    "tStartMs": 747720,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "So here is all five in one breath."
    } ]
  }, {
    "tStartMs": 750200,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "The raise is three point six percent and\nit needs nothing from you."
    } ]
  }, {
    "tStartMs": 754580,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Medicare Advantage premiums fall next\nyear, but check your own notice rather"
    } ]
  }, {
    "tStartMs": 759340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "than the average."
    } ]
  }, {
    "tStartMs": 760760,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "The six thousand dollar deduction stacks\non everything else, and it is worth"
    } ]
  }, {
    "tStartMs": 765180,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "real money only if you owe tax."
    } ]
  }, {
    "tStartMs": 767880,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Your January payment arrives on the thirty\nfirst of December, and nothing is"
    } ]
  }, {
    "tStartMs": 772120,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "wrong when it does. And your state may\ntake over your Part B premium completely,"
    } ]
  }, {
    "tStartMs": 776660,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "which is worth more than two thousand four\nhundred dollars a year and is the"
    } ]
  }, {
    "tStartMs": 781080,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "only one of the five that waits for you to\nask."
    } ]
  }, {
    "tStartMs": 784540,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Four of them find you. One of them does\nnot."
    } ]
  }, {
    "tStartMs": 787540,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "If your situation has something in it I\ndid not cover, a public pension, a"
    } ]
  }, {
    "tStartMs": 792320,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "spouse still working, a state with its own\nrules, tell me in the comments."
    } ]
  }, {
    "tStartMs": 796840,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "I read them and they decide what I look at\nnext."
    } ]
  }, {
    "tStartMs": 800280,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "This is general information and not advice\nabout your own record."
    } ]
  }, {
    "tStartMs": 804360,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Your own income and your own state decide\nyour figures."
    } ]
  } ]
}
