{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "Starting in January the average retired\nworker gets $75 more every month."
    } ]
  }, {
    "tStartMs": 6860,
    "dDurationMs": 5820,
    "segs": [ {
      "utf8": "That is $900 over the year, and you do not\nfill in a single form to get it."
    } ]
  }, {
    "tStartMs": 12900,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "And that is the smallest of the seven\nthings I am going to give you today."
    } ]
  }, {
    "tStartMs": 17520,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "I know what the last few months have\nsounded like."
    } ]
  }, {
    "tStartMs": 20780,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Prices up,"
    } ]
  }, {
    "tStartMs": 22140,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Medicare plans dropped, warnings about\nyour savings and your check."
    } ]
  }, {
    "tStartMs": 25980,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Some of that was real and I covered it\nhere."
    } ]
  }, {
    "tStartMs": 29320,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "Today is the good side. Before we start,\ntwo things, because they are the two"
    } ]
  }, {
    "tStartMs": 35180,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "questions I get under every video like\nthis one."
    } ]
  }, {
    "tStartMs": 38740,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "The first. Does this apply where I live."
    } ]
  }, {
    "tStartMs": 42180,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Six of these seven are exactly the same in\nall 50 states."
    } ]
  }, {
    "tStartMs": 45940,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Same in Texas, same in Illinois, same in\nCalifornia."
    } ]
  }, {
    "tStartMs": 49980,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Only one of them goes through your own\nstate office, and I will tell you which"
    } ]
  }, {
    "tStartMs": 53840,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "one when we get to it. The second."
    } ]
  }, {
    "tStartMs": 56760,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Do you have to be poor for any of this."
    } ]
  }, {
    "tStartMs": 59320,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Only two of the seven ask what you earn."
    } ]
  }, {
    "tStartMs": 61860,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "The other five do not ask at all."
    } ]
  }, {
    "tStartMs": 64580,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "They do not look at your income, they do\nnot look at your savings, and they"
    } ]
  }, {
    "tStartMs": 68320,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "do not care that your house is paid off."
    } ]
  }, {
    "tStartMs": 71120,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "If you have been ruling yourself out, you\nhave been ruling yourself out of"
    } ]
  }, {
    "tStartMs": 75020,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "the wrong five. Here is the shape of it."
    } ]
  }, {
    "tStartMs": 78120,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Five of the seven arrive on their own."
    } ]
  }, {
    "tStartMs": 80320,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "You do nothing and the money moves."
    } ]
  }, {
    "tStartMs": 82080,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "The other two do not, and those two are\nthe biggest ones."
    } ]
  }, {
    "tStartMs": 86300,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Nobody writes to you about those."
    } ]
  }, {
    "tStartMs": 88120,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Nobody telephones. So that is where we\nstart."
    } ]
  }, {
    "tStartMs": 91540,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Every number here comes from Social\nSecurity, Medicare or the tax office."
    } ]
  }, {
    "tStartMs": 95980,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "I cannot see your income, your state or\nyour paperwork, and those three decide"
    } ]
  }, {
    "tStartMs": 100680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "your own figure."
    } ]
  }, {
    "tStartMs": 102380,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Number one."
    } ]
  }, {
    "tStartMs": 103900,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The Medicare Savings Program. Right now"
    } ]
  }, {
    "tStartMs": 107840,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "$202.90 comes out of your Social Security\nevery month before you ever see it."
    } ]
  }, {
    "tStartMs": 114340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "That is your Medicare Part B premium."
    } ]
  }, {
    "tStartMs": 116940,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Your state will pay it for you."
    } ]
  }, {
    "tStartMs": 119080,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "Not part of it. All of it. That is $2,434\na year back in"
    } ]
  }, {
    "tStartMs": 125180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "your hand."
    } ]
  }, {
    "tStartMs": 126480,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Most people never apply because they hear\na program for seniors and decide"
    } ]
  }, {
    "tStartMs": 131160,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "they earn too much. So here are the actual\nlines, and they have names you can"
    } ]
  }, {
    "tStartMs": 136480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "say on the telephone."
    } ]
  }, {
    "tStartMs": 138260,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "The first is called QMB. One person up to\n$1,350 a month."
    } ]
  }, {
    "tStartMs": 144420,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "It pays the premium and it also wipes out\nmost of what you hand over at the"
    } ]
  }, {
    "tStartMs": 148660,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "doctor and the hospital. The second is\ncalled SLMB."
    } ]
  }, {
    "tStartMs": 152800,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Up to $1,616 a month. It pays the premium."
    } ]
  }, {
    "tStartMs": 157080,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "The third is called QI. Up to $1,816 a\nmonth."
    } ]
  }, {
    "tStartMs": 161360,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "It pays the premium too. Read that top\nnumber again."
    } ]
  }, {
    "tStartMs": 165660,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "$1,816 a month. That is most retired\npeople in this country."
    } ]
  }, {
    "tStartMs": 171300,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "Now the part that costs people the most,\nand almost nobody says it out loud."
    } ]
  }, {
    "tStartMs": 175920,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "They do not count every dollar you bring\nin."
    } ]
  }, {
    "tStartMs": 178820,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "$20 a month is set aside before they\nstart, and if you still work, another"
    } ]
  }, {
    "tStartMs": 183460,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "$65 of your wages is set aside on top of\nthat."
    } ]
  }, {
    "tStartMs": 187000,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "So the number on your bank statement can\nsit above the line and you still get"
    } ]
  }, {
    "tStartMs": 191160,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "in. Say that plainly. A single person\nbringing in $1,900 a month can still"
    } ]
  }, {
    "tStartMs": 197040,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "land inside the third level, because 85 of\nthose dollars were never counted"
    } ]
  }, {
    "tStartMs": 201280,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "in the first place."
    } ]
  }, {
    "tStartMs": 203060,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Your savings count, but the line is higher\nthan you think."
    } ]
  }, {
    "tStartMs": 207000,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "$9,950 for one person."
    } ]
  }, {
    "tStartMs": 210440,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "$14,910 for a couple. Your home does not\ncount."
    } ]
  }, {
    "tStartMs": 215260,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "One car does not count. And here is the\npart that makes it worth more than"
    } ]
  }, {
    "tStartMs": 219240,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "the premium. The moment you are in any of\nthese three, you automatically get"
    } ]
  }, {
    "tStartMs": 223540,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "a second one called Extra Help, and that\ncuts what you pay for your medicine"
    } ]
  }, {
    "tStartMs": 227500,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "on top."
    } ]
  }, {
    "tStartMs": 228800,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "One warning. That third level, QI, is paid\nout of a pot of money that is fixed"
    } ]
  }, {
    "tStartMs": 233700,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "for the year and handed out in the order\npeople apply."
    } ]
  }, {
    "tStartMs": 237180,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "When it is gone, it is gone until January."
    } ]
  }, {
    "tStartMs": 240040,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "So call your state Medicaid office and ask\nfor the Medicare Savings Program"
    } ]
  }, {
    "tStartMs": 244300,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "application by name. Your state, not\nMedicare."
    } ]
  }, {
    "tStartMs": 248460,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Ask them whether your state uses higher\nlimits than the federal ones, because"
    } ]
  }, {
    "tStartMs": 252180,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "many do. And do not decide for yourself\nthat you are over the line."
    } ]
  }, {
    "tStartMs": 256380,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "Let them tell you. Number two."
    } ]
  }, {
    "tStartMs": 258860,
    "dDurationMs": 5980,
    "segs": [ {
      "utf8": "The $6,000 deduction. If you are 65 or\nolder you can take an extra $6,000 off"
    } ]
  }, {
    "tStartMs": 264840,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "the income you are taxed on. 12,000 for a\ncouple when you both qualify."
    } ]
  }, {
    "tStartMs": 269860,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "This did not exist two years ago."
    } ]
  }, {
    "tStartMs": 271840,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "It runs through 2028 and then it is gone."
    } ]
  }, {
    "tStartMs": 274940,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Here is what I need you to hear clearly,\nbecause the videos get this wrong."
    } ]
  }, {
    "tStartMs": 278560,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Nobody made your Social Security tax free."
    } ]
  }, {
    "tStartMs": 282100,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "What this does is lower the income the tax\noffice counts against you."
    } ]
  }, {
    "tStartMs": 285720,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "For a great many people on a modest income\nthe result is that the tax on the"
    } ]
  }, {
    "tStartMs": 290200,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "check comes out at nothing anyway."
    } ]
  }, {
    "tStartMs": 291840,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Same ending, different road, and knowing\nwhich road you are on is what stops"
    } ]
  }, {
    "tStartMs": 295420,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "the form being filled in wrong."
    } ]
  }, {
    "tStartMs": 297400,
    "dDurationMs": 6285,
    "segs": [ {
      "utf8": "It also shrinks once your income passes\n75,000 for one person, or 150,000"
    } ]
  }, {
    "tStartMs": 303960,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "for a couple. And it is not automatic."
    } ]
  }, {
    "tStartMs": 306880,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "It has to be on your return."
    } ]
  }, {
    "tStartMs": 308860,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "If somebody else does your taxes, say the\nwords extra deduction for age 65"
    } ]
  }, {
    "tStartMs": 314300,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "and over, and make them show you the line."
    } ]
  }, {
    "tStartMs": 317520,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Number three. Your raise. 3.6%, from\nJanuary."
    } ]
  }, {
    "tStartMs": 322240,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "The average retired worker goes from\n$2,095 a month to $2,170."
    } ]
  }, {
    "tStartMs": 328900,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "$75 more. Over the year, $900."
    } ]
  }, {
    "tStartMs": 333020,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "This one needs nothing from you."
    } ]
  }, {
    "tStartMs": 335280,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "It lands on its own. Two things to watch\nwhen your notice arrives in the post."
    } ]
  }, {
    "tStartMs": 339920,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Compare it line by line with last year,\nbecause the Medicare premium comes"
    } ]
  }, {
    "tStartMs": 343920,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "out before the raise reaches you, and the\nnumber you actually receive is the"
    } ]
  }, {
    "tStartMs": 348140,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "smaller of the two. And the Medicare"
    } ]
  }, {
    "tStartMs": 349980,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "figure for next year has not been\nannounced"
    } ]
  }, {
    "tStartMs": 351900,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "yet, so anybody quoting it to you today is\nguessing."
    } ]
  }, {
    "tStartMs": 356040,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Number four. 15 medicines get a new price."
    } ]
  }, {
    "tStartMs": 359640,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "On the first of January the price Medicare\npays for 15 of the most expensive"
    } ]
  }, {
    "tStartMs": 363600,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "drugs drops, and the second round is\nbigger than the first."
    } ]
  }, {
    "tStartMs": 367320,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "One example tells you the size of it."
    } ]
  }, {
    "tStartMs": 369580,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "The diabetes and weight medicine that\ncarried a list price near $960 for a"
    } ]
  }, {
    "tStartMs": 374600,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "month now sits at $274."
    } ]
  }, {
    "tStartMs": 377840,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "The prostate cancer one falls by nearly\nhalf."
    } ]
  }, {
    "tStartMs": 380840,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "You do not apply for this. If you take one\nof the 15, your price simply changes"
    } ]
  }, {
    "tStartMs": 385580,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "in January. What to do is small and it\nmatters."
    } ]
  }, {
    "tStartMs": 388900,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "In January, telephone your plan and ask\nwhat you pay now for each medicine"
    } ]
  }, {
    "tStartMs": 393460,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "on your list. The price moved, but your\nplan will not write and tell you it"
    } ]
  }, {
    "tStartMs": 397600,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "moved."
    } ]
  }, {
    "tStartMs": 398720,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Number five. The ceiling on what medicine\ncan cost you."
    } ]
  }, {
    "tStartMs": 402280,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "$2,400. That is the most you can be made\nto pay out of your own pocket for"
    } ]
  }, {
    "tStartMs": 407040,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "covered medicine in the whole of next\nyear."
    } ]
  }, {
    "tStartMs": 409340,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Once you reach it, you pay nothing more\nuntil January comes round again."
    } ]
  }, {
    "tStartMs": 413100,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "The amount you pay before the plan starts\nhelping is capped too, at $700."
    } ]
  }, {
    "tStartMs": 419620,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Nobody has to tell you when you cross that\nceiling, and plans do not always"
    } ]
  }, {
    "tStartMs": 423760,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "get it right. Keep your pharmacy receipts\nfor the year, and if you are still"
    } ]
  }, {
    "tStartMs": 428000,
    "dDurationMs": 1894,
    "segs": [ {
      "utf8": "being charged after $2,400,"
    } ]
  }, {
    "tStartMs": 430600,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "telephone the plan and say you have\nreached the yearly cap."
    } ]
  }, {
    "tStartMs": 435040,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Number six."
    } ]
  }, {
    "tStartMs": 436260,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The earnings limit, if you are still\nworking."
    } ]
  }, {
    "tStartMs": 438940,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "If you took your Social Security early and\nyou are still working, they hold"
    } ]
  }, {
    "tStartMs": 443160,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "back a dollar for every two you earn above\na line."
    } ]
  }, {
    "tStartMs": 446120,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "From January that line goes up to $25,560."
    } ]
  }, {
    "tStartMs": 450840,
    "dDurationMs": 2307,
    "segs": [ {
      "utf8": "It was $24,480."
    } ]
  }, {
    "tStartMs": 453920,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "In the year you reach your full age the\nline jumps to $67,920, and they only"
    } ]
  }, {
    "tStartMs": 460160,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "count what you earn before your birthday\nmonth."
    } ]
  }, {
    "tStartMs": 462760,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "And here is the piece almost nobody is\ntold."
    } ]
  }, {
    "tStartMs": 465240,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The money they hold back is not taken from\nyou."
    } ]
  }, {
    "tStartMs": 468320,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "When you reach your full age they work it\nout again and give it back to you"
    } ]
  }, {
    "tStartMs": 472120,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "in a higher monthly payment for the rest\nof your life."
    } ]
  }, {
    "tStartMs": 474820,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "People turn down hours they needed because\nthey thought the money was gone."
    } ]
  }, {
    "tStartMs": 479040,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It was never gone. Number seven."
    } ]
  }, {
    "tStartMs": 481780,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Your January payment lands in December."
    } ]
  }, {
    "tStartMs": 484580,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "If you are on the extra payment for people\nwith very little income, your January"
    } ]
  }, {
    "tStartMs": 488680,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "money arrives on the 31st of December,\nbecause the first falls on a holiday."
    } ]
  }, {
    "tStartMs": 493540,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "So you get two deposits in December and\nnothing at all on the first of January."
    } ]
  }, {
    "tStartMs": 497740,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "Every year people see that second December\ndeposit, decide the government sent"
    } ]
  }, {
    "tStartMs": 502580,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "something extra, and spend it."
    } ]
  }, {
    "tStartMs": 504840,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "By the middle of January the account is\nempty."
    } ]
  }, {
    "tStartMs": 508280,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Write the word January on your calendar\nbeside the 31st of December."
    } ]
  }, {
    "tStartMs": 512340,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "That deposit is next month, handed to you\none day early."
    } ]
  }, {
    "tStartMs": 516360,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "So that is the seven. Five of them arrive\non their own."
    } ]
  }, {
    "tStartMs": 519640,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Your raise, the 15 medicines, the ceiling,\nthe earnings limit and the December"
    } ]
  }, {
    "tStartMs": 524320,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "payment. You do nothing and they happen."
    } ]
  }, {
    "tStartMs": 527360,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Two of them do not. The $6,000 deduction\nhas to be on your tax return."
    } ]
  }, {
    "tStartMs": 532100,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The Medicare Savings Program has to be\napplied for at your state office."
    } ]
  }, {
    "tStartMs": 536200,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Those two are the biggest money on the\nlist, and they are the two nobody will"
    } ]
  }, {
    "tStartMs": 539840,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "ever contact you about. If you only do one\nthing this week, make it the telephone"
    } ]
  }, {
    "tStartMs": 544160,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "call. Your state Medicaid office, the\nMedicare Savings Program application,"
    } ]
  }, {
    "tStartMs": 548680,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "by name. A refusal costs you nothing and\ntakes 20 minutes."
    } ]
  }, {
    "tStartMs": 553260,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Not asking costs you $2,400 every single\nyear you stay quiet."
    } ]
  }, {
    "tStartMs": 558620,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "This is education and not advice about\nyour own situation."
    } ]
  }, {
    "tStartMs": 562300,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Your income, your state and your paperwork\ndecide your own answer."
    } ]
  }, {
    "tStartMs": 566400,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "And if your mother or your father is\nliving on Social Security alone, do not"
    } ]
  }, {
    "tStartMs": 570340,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "send them this video. Sit beside them and\nmake that call together."
    } ]
  } ]
}
