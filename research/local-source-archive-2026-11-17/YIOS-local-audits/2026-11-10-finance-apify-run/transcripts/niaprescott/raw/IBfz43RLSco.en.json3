{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "There is one number that decides whether\nyou get food help."
    } ]
  }, {
    "tStartMs": 3980,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Your own doctor bills are meant to come\noff that number before anybody looks"
    } ]
  }, {
    "tStartMs": 7880,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "at it. No one at that counter is obliged\nto ask for them."
    } ]
  }, {
    "tStartMs": 12060,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "So the no you were given was worked out on\na figure that was never yours."
    } ]
  }, {
    "tStartMs": 16480,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "It sits in a file. Nobody reopens it and\nworks it a second time."
    } ]
  }, {
    "tStartMs": 21220,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Four things change that figure once\nsomebody sixty or over lives under your"
    } ]
  }, {
    "tStartMs": 25200,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "roof. Most people hear the word medical,\nthink of hospitals, and say nothing"
    } ]
  }, {
    "tStartMs": 30360,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "at all. I will name the program once so\nyou know what we are talking about."
    } ]
  }, {
    "tStartMs": 34960,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "It is called SNAP. Most people still call\nit food stamps."
    } ]
  }, {
    "tStartMs": 39240,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "The money lands on a card each month, and\nyou buy groceries with it."
    } ]
  }, {
    "tStartMs": 43520,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "And let me deal with who this covers,\nsince that question arrives under every"
    } ]
  }, {
    "tStartMs": 47180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "one of these videos."
    } ]
  }, {
    "tStartMs": 48800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Limits exist, and the figures are below."
    } ]
  }, {
    "tStartMs": 51360,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "But the whole point of today is that the\namount being weighed is not the amount"
    } ]
  }, {
    "tStartMs": 55620,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "sitting in your head. Number one."
    } ]
  }, {
    "tStartMs": 58020,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "In this program old starts at sixty."
    } ]
  }, {
    "tStartMs": 60300,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Not sixty five. Read that again, because\nit costs people five years."
    } ]
  }, {
    "tStartMs": 64980,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The government writes it down plainly."
    } ]
  }, {
    "tStartMs": 67060,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "In this program you are elderly at sixty."
    } ]
  }, {
    "tStartMs": 69820,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Not at sixty five, not at retirement, not\nwhen your card arrives."
    } ]
  }, {
    "tStartMs": 73760,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Sixty. And the moment somebody sixty or\nover lives in your house, one whole"
    } ]
  }, {
    "tStartMs": 78180,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "test gets dropped. Here is what that means\nin practice."
    } ]
  }, {
    "tStartMs": 81120,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "A normal household gets measured twice."
    } ]
  }, {
    "tStartMs": 84280,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Once on the whole amount arriving, with\nnothing subtracted yet."
    } ]
  }, {
    "tStartMs": 88040,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Then again on whatever survives after\ncertain costs are removed."
    } ]
  }, {
    "tStartMs": 92060,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And the first measurement is precisely\nwhere people stop."
    } ]
  }, {
    "tStartMs": 96640,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "It is the headline amount. The one printed\nat the top, the one that sounds"
    } ]
  }, {
    "tStartMs": 101480,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "like wages. Somebody says it out loud,\ndecides it is far too much, and the"
    } ]
  }, {
    "tStartMs": 107160,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "form never gets filled in. That\nmeasurement does not apply to you."
    } ]
  }, {
    "tStartMs": 112280,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "It never did. Nobody at any counter has\never been required to mention that."
    } ]
  }, {
    "tStartMs": 117000,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "The one that counts is the number left\nafter your costs come off."
    } ]
  }, {
    "tStartMs": 120920,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "For one person that line sits at one\nthousand three hundred and thirty dollars"
    } ]
  }, {
    "tStartMs": 124640,
    "dDurationMs": 2965,
    "segs": [ {
      "utf8": "a month. For two it is one thousand eight\nhundred and four."
    } ]
  }, {
    "tStartMs": 128660,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And those are the figures for the year\nthat started this month."
    } ]
  }, {
    "tStartMs": 132080,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "So here is the small move, and it costs\nyou nothing."
    } ]
  }, {
    "tStartMs": 135380,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Lead with the age, not the income."
    } ]
  }, {
    "tStartMs": 138400,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Tell them somebody under your roof is\nsixty or over, say you want to file,"
    } ]
  }, {
    "tStartMs": 142960,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "and leave the sums to the people employed\nto do them."
    } ]
  }, {
    "tStartMs": 146420,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Number two. Every dollar past thirty five\na month comes off before they judge"
    } ]
  }, {
    "tStartMs": 151100,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "you. Thirty five dollars. That is the\nfloor."
    } ]
  }, {
    "tStartMs": 154900,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Understand how low that is. It is not an\noperation."
    } ]
  }, {
    "tStartMs": 158580,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It is not a week on a ward. It is the\npills on repeat."
    } ]
  }, {
    "tStartMs": 162180,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "It is getting to the appointment, and\ngetting home again."
    } ]
  }, {
    "tStartMs": 165680,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "It is the dentist. The glasses."
    } ]
  }, {
    "tStartMs": 168060,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "The small items you lift off a shelf\nwithout a second thought."
    } ]
  }, {
    "tStartMs": 171740,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Almost nobody over sixty spends less than\nthirty five dollars a month keeping"
    } ]
  }, {
    "tStartMs": 176120,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "themselves well. It is simply what the\nmonth costs."
    } ]
  }, {
    "tStartMs": 179980,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Everything past that first thirty five is\nsubtracted before they weigh you"
    } ]
  }, {
    "tStartMs": 183660,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "at all. There is a limit on it, and you\nshould hear it plainly."
    } ]
  }, {
    "tStartMs": 187840,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Only what you pay yourself counts."
    } ]
  }, {
    "tStartMs": 189680,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "If the insurance paid it, or a son or\ndaughter paid it, that part is theirs,"
    } ]
  }, {
    "tStartMs": 194740,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "not yours. And only the amount over thirty\nfive comes off, not the whole thing."
    } ]
  }, {
    "tStartMs": 200260,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "So before you call anyone, pick one month\nand put it on paper."
    } ]
  }, {
    "tStartMs": 204880,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Every health cost you covered yourself in\nthose four weeks."
    } ]
  }, {
    "tStartMs": 208160,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Most people have never added that column\nup in their lives, and the total surprises"
    } ]
  }, {
    "tStartMs": 212260,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "them. Number three. What counts is wider\nthan medicine."
    } ]
  }, {
    "tStartMs": 216320,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Dentures, nursing care, the ride there."
    } ]
  }, {
    "tStartMs": 219520,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Of the four, this is the one least often\nexplained to anybody, and it moves"
    } ]
  }, {
    "tStartMs": 223660,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "the most money. People hear medical and\nthey think of pills."
    } ]
  }, {
    "tStartMs": 227320,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The list the government actually publishes\nis far longer than that."
    } ]
  }, {
    "tStartMs": 230960,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Doctor bills. Prescriptions. Things from\nthe drugstore shelf, when a doctor"
    } ]
  }, {
    "tStartMs": 235280,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "has said to take them. Dentures."
    } ]
  }, {
    "tStartMs": 237460,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "A stay in hospital and treatment that does\nnot need a stay."
    } ]
  }, {
    "tStartMs": 240960,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Nursing care. Somebody who comes in to\nhelp you."
    } ]
  }, {
    "tStartMs": 243840,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "And two more that people miss every single\ntime."
    } ]
  }, {
    "tStartMs": 246620,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "The cost of getting there. The journey to\nthe appointment counts."
    } ]
  }, {
    "tStartMs": 249980,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "And the health insurance you pay for."
    } ]
  }, {
    "tStartMs": 252040,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "That takes in the Medicare premium removed\nfrom your Social Security before"
    } ]
  }, {
    "tStartMs": 256300,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "any of it reaches a bank. No check was\nwritten."
    } ]
  }, {
    "tStartMs": 259500,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Nothing was approved. It counts all the\nsame."
    } ]
  }, {
    "tStartMs": 262700,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Sit with that one, because for most houses\nit is the largest single line on"
    } ]
  }, {
    "tStartMs": 266800,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the whole sheet. It leaves every month."
    } ]
  }, {
    "tStartMs": 269240,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "It leaves on its own. And it sits on\nalmost nobody's form."
    } ]
  }, {
    "tStartMs": 273020,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Think about how that happens. A cost you\nnever chose, never approved, and never"
    } ]
  }, {
    "tStartMs": 277660,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "watched go, is still a cost you carry."
    } ]
  }, {
    "tStartMs": 280260,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The office has no way of knowing it unless\nyou say it."
    } ]
  }, {
    "tStartMs": 283080,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "And nothing on that form tells you to."
    } ]
  }, {
    "tStartMs": 285540,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "There is a second one people walk past."
    } ]
  }, {
    "tStartMs": 287820,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "If a husband and wife both have a premium\ncoming out, both of them count."
    } ]
  }, {
    "tStartMs": 292040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Two people, two premiums, every month of\nthe year."
    } ]
  }, {
    "tStartMs": 295220,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "That alone has moved households from\nrefused to accepted."
    } ]
  }, {
    "tStartMs": 298120,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "So when you make that sheet of paper,\nstart with the premium."
    } ]
  }, {
    "tStartMs": 302460,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Then the pills. Then the dentist."
    } ]
  }, {
    "tStartMs": 304260,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "Then the"
    } ]
  }, {
    "tStartMs": 304980,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "journeys. A woman of seventy four with a\nbad knee and a car she pays somebody"
    } ]
  }, {
    "tStartMs": 309200,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "else to drive is carrying several hundred\ndollars a month, and she has been"
    } ]
  }, {
    "tStartMs": 313460,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "telling the office she has no medical\ncosts."
    } ]
  }, {
    "tStartMs": 316920,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "Number four."
    } ]
  }, {
    "tStartMs": 318140,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "One thing people claim never counts, and\nit gets the file refused."
    } ]
  }, {
    "tStartMs": 322300,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Special food does not count. Ever."
    } ]
  }, {
    "tStartMs": 324860,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "If a doctor has told you to eat a certain\nway, and that way costs you more,"
    } ]
  }, {
    "tStartMs": 329700,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "every instinct says it should come off."
    } ]
  }, {
    "tStartMs": 331760,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "It does not. The rule names it and\nexcludes it."
    } ]
  }, {
    "tStartMs": 335520,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Put it on the form and you have given them\na reason to reject the whole thing."
    } ]
  }, {
    "tStartMs": 339620,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "And there is a second rule that goes with\nit."
    } ]
  }, {
    "tStartMs": 342080,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "You need proof. Receipts, statements, the\npaperwork from the insurer."
    } ]
  }, {
    "tStartMs": 346400,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "A number you say out loud is not enough."
    } ]
  }, {
    "tStartMs": 349120,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Some states let you claim one flat amount\ninstead of listing every item."
    } ]
  }, {
    "tStartMs": 353160,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Some do not. Ask which one yours is, and\nask it in those words, because it"
    } ]
  }, {
    "tStartMs": 358020,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "changes how much paperwork you carry."
    } ]
  }, {
    "tStartMs": 360620,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Here is the thread tying the four\ntogether."
    } ]
  }, {
    "tStartMs": 362820,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Every one of these moves the same number."
    } ]
  }, {
    "tStartMs": 365200,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Not what arrives. What is left, after what\nyou pay to stay well."
    } ]
  }, {
    "tStartMs": 369340,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "And not one counter anywhere rings an\nolder person to ask what their health"
    } ]
  }, {
    "tStartMs": 373640,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "is costing. The form has a box."
    } ]
  }, {
    "tStartMs": 376440,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "The box sits empty. The empty box becomes\na figure, and the figure becomes"
    } ]
  }, {
    "tStartMs": 380820,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "a no. Here is the arithmetic the\ngovernment prints in its own rulebook, so"
    } ]
  }, {
    "tStartMs": 385180,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "you can see the size of it. Two people,\nsixty or over, twelve hundred dollars"
    } ]
  }, {
    "tStartMs": 389120,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "a month coming in. Take off two hundred\nand seventeen that every household"
    } ]
  }, {
    "tStartMs": 393860,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "gets. Take off three hundred in doctor\nbills."
    } ]
  }, {
    "tStartMs": 397180,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Take off what the roof costs above half of\nwhat is left."
    } ]
  }, {
    "tStartMs": 400360,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "The number they finally judge is four\nhundred and twenty four dollars and fifty"
    } ]
  }, {
    "tStartMs": 404160,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "cents. The food help that comes back is\nfour hundred and thirty four dollars"
    } ]
  }, {
    "tStartMs": 407540,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "a month. Leave the doctor bills off that\nsame form and the number they judge"
    } ]
  }, {
    "tStartMs": 412860,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "jumps by three hundred."
    } ]
  }, {
    "tStartMs": 414840,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Same house. Same income. Same month."
    } ]
  }, {
    "tStartMs": 417880,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Over ninety dollars a month gone, because\none box was empty."
    } ]
  }, {
    "tStartMs": 421940,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Now a word on the limits of what I have\ngiven you."
    } ]
  }, {
    "tStartMs": 424560,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "I am not able to settle your case from\nhere."
    } ]
  }, {
    "tStartMs": 428300,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "States administer this separately, each\nwith its own forms."
    } ]
  }, {
    "tStartMs": 432340,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Some set their limits higher than the\nfederal ones."
    } ]
  }, {
    "tStartMs": 434940,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "The numbers here are the national ones for\nthe year that opened this month."
    } ]
  }, {
    "tStartMs": 440080,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Your state lays its own rules over the top\nof those."
    } ]
  }, {
    "tStartMs": 443600,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "What holds in every state is the shape."
    } ]
  }, {
    "tStartMs": 446680,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "You are weighed on one figure, your doctor\nbills belong inside it, and no one"
    } ]
  }, {
    "tStartMs": 451900,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "is coming to your door to collect them."
    } ]
  }, {
    "tStartMs": 454160,
    "dDurationMs": 6267,
    "segs": [ {
      "utf8": "So, the four, one more time. In this\nprogram you are old at sixty, not sixty"
    } ]
  }, {
    "tStartMs": 460427,
    "dDurationMs": 2913,
    "segs": [ {
      "utf8": "five, and that alone drops a whole test."
    } ]
  }, {
    "tStartMs": 463340,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "Anything you pay for health past thirty\nfive dollars a month comes off before"
    } ]
  }, {
    "tStartMs": 468640,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "they judge you. What counts is far wider\nthan medicine, and the biggest piece"
    } ]
  }, {
    "tStartMs": 473480,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "of it is the premium already leaving your\ncheck."
    } ]
  }, {
    "tStartMs": 476560,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "And special food never counts, no matter\nhow fair that feels."
    } ]
  }, {
    "tStartMs": 480920,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "The name for all of this in the rulebook\nis the excess medical expenses deduction."
    } ]
  }, {
    "tStartMs": 486680,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Say that line when you telephone"
    } ]
  }, {
    "tStartMs": 488600,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "and whoever answers will understand the\nrequest"
    } ]
  }, {
    "tStartMs": 491200,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "at once. You will not have to explain\nanything else."
    } ]
  }, {
    "tStartMs": 495540,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "None of this is secret. It is printed, it\nhas been printed for decades, and"
    } ]
  }, {
    "tStartMs": 499880,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "anyone may read it. It fails older people\nfor one reason only."
    } ]
  }, {
    "tStartMs": 504640,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Those counters are staffed to answer what\nis put to them, and nothing in them"
    } ]
  }, {
    "tStartMs": 508640,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "was ever designed to raise a question\nfirst."
    } ]
  }, {
    "tStartMs": 511920,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "One last thing, and it comes around every\nyear."
    } ]
  }, {
    "tStartMs": 515200,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Honest offices do not ring you about food\nhelp."
    } ]
  }, {
    "tStartMs": 517960,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "If a call offers to work out your benefit\nfor a fee, or wants a card number"
    } ]
  }, {
    "tStartMs": 522600,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "before anything can go ahead, put the\ntelephone down."
    } ]
  }, {
    "tStartMs": 526540,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Applying costs nothing. Asking costs\nnothing."
    } ]
  }, {
    "tStartMs": 530380,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "And if this was refused to someone in your\nfamily, say nothing about their"
    } ]
  }, {
    "tStartMs": 534480,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "earnings."
    } ]
  }, {
    "tStartMs": 535700,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Ask them something else entirely."
    } ]
  }, {
    "tStartMs": 538020,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Did anyone, at any point, ask to see what\ntheir health costs them?"
    } ]
  } ]
}
