{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Two weeks from now a number gets fixed for\nyou."
    } ]
  }, {
    "tStartMs": 3540,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "You are not asked, you are not written to,\nand by the time it reaches you the"
    } ]
  }, {
    "tStartMs": 8380,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "work behind it is already months old."
    } ]
  }, {
    "tStartMs": 11280,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "That number is your raise for next year."
    } ]
  }, {
    "tStartMs": 14740,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "And before one dollar of it reaches your\naccount, five other numbers have already"
    } ]
  }, {
    "tStartMs": 18900,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "been moved, and not one of them was moved\non your say so."
    } ]
  }, {
    "tStartMs": 23880,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Here is what nobody puts in the same place\nfor you."
    } ]
  }, {
    "tStartMs": 26500,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "The raise is announced on one day."
    } ]
  }, {
    "tStartMs": 30080,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "The cost that comes out of it is announced\non a different day."
    } ]
  }, {
    "tStartMs": 33620,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "The limits that decide what help you keep\nmoved on three more days, all of"
    } ]
  }, {
    "tStartMs": 38420,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "them different, and one of them has not\nmoved since nineteen eighty three."
    } ]
  }, {
    "tStartMs": 43060,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Five numbers. Five separate days."
    } ]
  }, {
    "tStartMs": 45800,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Not one of them is the day you find out."
    } ]
  }, {
    "tStartMs": 48840,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Let me settle one question before anything\nelse, because it is asked every"
    } ]
  }, {
    "tStartMs": 53120,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "single time. Part of this depends on what\nyou have coming in each month."
    } ]
  }, {
    "tStartMs": 57860,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Part of it does not. The rise does not."
    } ]
  }, {
    "tStartMs": 60700,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "The deduction does not. Those two reach\nevery person on Medicare regardless"
    } ]
  }, {
    "tStartMs": 65240,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "of income. The last three do carry limits,\nand I will give you the figures"
    } ]
  }, {
    "tStartMs": 69720,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "and the place to check them. There is no\npretending here that you qualify for"
    } ]
  }, {
    "tStartMs": 74080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "something you do not."
    } ]
  }, {
    "tStartMs": 75980,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Number one. Your COLA is set on the\nfourteenth of October."
    } ]
  }, {
    "tStartMs": 80060,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "You get no say in it. The full name is\ncost of living adjustment, and almost"
    } ]
  }, {
    "tStartMs": 84760,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "everyone just says COLA. It is the yearly\nrise added to Social Security, and"
    } ]
  }, {
    "tStartMs": 89840,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "it is worked out from a list of prices\ngathered in July, August and September."
    } ]
  }, {
    "tStartMs": 95040,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Those three months are finished."
    } ]
  }, {
    "tStartMs": 96640,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "The readings are already taken."
    } ]
  }, {
    "tStartMs": 98400,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "The last one goes public before breakfast\non the fourteenth, and from that"
    } ]
  }, {
    "tStartMs": 102300,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "moment the figure is locked for the whole\nof next year."
    } ]
  }, {
    "tStartMs": 105500,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "Estimates right now sit near three and a\nhalf percent, with one or two a shade"
    } ]
  }, {
    "tStartMs": 110680,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "above it. Last year's was two point eight."
    } ]
  }, {
    "tStartMs": 113400,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "On a payment of about two thousand dollars\na month, that works out at roughly"
    } ]
  }, {
    "tStartMs": 117580,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "seventy dollars more."
    } ]
  }, {
    "tStartMs": 119620,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Now hold on to the part that matters."
    } ]
  }, {
    "tStartMs": 122100,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The list those prices come from is built\non what working age people in cities"
    } ]
  }, {
    "tStartMs": 126540,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "buy. It is called the price index for\nurban wage earners."
    } ]
  }, {
    "tStartMs": 130800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Urban wage earners."
    } ]
  }, {
    "tStartMs": 132700,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "That is who is measured, and that is who\nsets your raise."
    } ]
  }, {
    "tStartMs": 136540,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "A woman of seventy eight does not spend\nlike a thirty five year old with a"
    } ]
  }, {
    "tStartMs": 140140,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "commute. She spends on heating, on the\nroof over her, and on medicine."
    } ]
  }, {
    "tStartMs": 145500,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Those are the three that have risen\nhardest, and they are the three carrying"
    } ]
  }, {
    "tStartMs": 148960,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "the least weight on the list she is judged\nby."
    } ]
  }, {
    "tStartMs": 152240,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "So the raise is real, and it was never\nmeasured on you."
    } ]
  }, {
    "tStartMs": 155740,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "Number two. Medicare Part B takes its cut\nfirst, and that number comes out"
    } ]
  }, {
    "tStartMs": 161080,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "later. Part B is the part of Medicare that\npays doctors and outpatient care,"
    } ]
  }, {
    "tStartMs": 166380,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "and for most people the cost of it is\ntaken straight out of the Social Security"
    } ]
  }, {
    "tStartMs": 170340,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "payment. Not billed. Not asked for."
    } ]
  }, {
    "tStartMs": 173520,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Taken, before the money moves."
    } ]
  }, {
    "tStartMs": 176000,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "This year that amount is two hundred and\ntwo dollars and ninety cents every"
    } ]
  }, {
    "tStartMs": 180180,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "month. The trustees project it rising to\naround two hundred and nine dollars"
    } ]
  }, {
    "tStartMs": 184500,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "and fifty cents next year. That is six\ndollars and sixty cents a month gone,"
    } ]
  }, {
    "tStartMs": 190380,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "close to eighty dollars across the year."
    } ]
  }, {
    "tStartMs": 193080,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Now put the two dates side by side,\nbecause this is the whole of it."
    } ]
  }, {
    "tStartMs": 197760,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Your raise is announced in October."
    } ]
  }, {
    "tStartMs": 200480,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The Part B figure is not made official\nuntil November."
    } ]
  }, {
    "tStartMs": 204820,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "So for about four weeks every retiree in\nthis country is walking around with"
    } ]
  }, {
    "tStartMs": 209520,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "a number in their head that is not the\nnumber."
    } ]
  }, {
    "tStartMs": 212460,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "The rise is public. The deduction is not."
    } ]
  }, {
    "tStartMs": 216160,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "And when the deduction is finally"
    } ]
  }, {
    "tStartMs": 217640,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "published, there is no second\nannouncement,"
    } ]
  }, {
    "tStartMs": 220500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "no letter, no correction."
    } ]
  }, {
    "tStartMs": 223380,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Seventy dollars of raise. Seven of it gone\nbefore you see it."
    } ]
  }, {
    "tStartMs": 227760,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "You were told the first figure on a\nTuesday morning and the second one three"
    } ]
  }, {
    "tStartMs": 231760,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "weeks later with no headline at all."
    } ]
  }, {
    "tStartMs": 234520,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Number three. Your SNAP limits already\nmoved."
    } ]
  }, {
    "tStartMs": 237820,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "They moved before your raise existed."
    } ]
  }, {
    "tStartMs": 241560,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "SNAP is food stamps. Same thing, different\nname, and the official one is the"
    } ]
  }, {
    "tStartMs": 245900,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "one the office uses. Here is the trap in\nit."
    } ]
  }, {
    "tStartMs": 250000,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "SNAP runs on the government's own year,\nand that year rolled over at the start"
    } ]
  }, {
    "tStartMs": 254500,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "of this month. The income ceilings and the\ndeduction amounts all changed then."
    } ]
  }, {
    "tStartMs": 259400,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "They changed two weeks before your raise\neven exists as a number."
    } ]
  }, {
    "tStartMs": 263520,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "So a household that is refused in November\nis refused against ceilings set"
    } ]
  }, {
    "tStartMs": 268000,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "in October, measured against income that\nincludes a raise announced after those"
    } ]
  }, {
    "tStartMs": 272680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "ceilings were written."
    } ]
  }, {
    "tStartMs": 274460,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "The two numbers were never designed to\nmeet."
    } ]
  }, {
    "tStartMs": 277000,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And people do not go back."
    } ]
  }, {
    "tStartMs": 279860,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "They hold on to the refusal and let go of\nthe year it came in."
    } ]
  }, {
    "tStartMs": 284660,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "A no from two winters back was measured\nagainst figures that have since been"
    } ]
  }, {
    "tStartMs": 289400,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "replaced twice. So call the benefit office\nin your own state and ask for the"
    } ]
  }, {
    "tStartMs": 295120,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "ceiling that applies to the year beginning\nthis month."
    } ]
  }, {
    "tStartMs": 298860,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Those words, that year."
    } ]
  }, {
    "tStartMs": 301300,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Whatever figure comes back down the line,\nit will not match the one sitting"
    } ]
  }, {
    "tStartMs": 305700,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "in your memory. Number four. Medicaid and\nthe Medicare Savings Programs judge"
    } ]
  }, {
    "tStartMs": 310760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "you on last year's line until spring."
    } ]
  }, {
    "tStartMs": 313760,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "Of everything in this video, this is the\npiece fewest people have ever been"
    } ]
  }, {
    "tStartMs": 318460,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "told, and it carries the largest sum."
    } ]
  }, {
    "tStartMs": 322360,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Three programs exist that cover Medicare\ncosts for people on lower incomes,"
    } ]
  }, {
    "tStartMs": 327420,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "and their names are nothing but letters."
    } ]
  }, {
    "tStartMs": 330380,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "QMB covers your premium and also the money\nyou pay across a doctor's desk."
    } ]
  }, {
    "tStartMs": 337440,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "SLMB covers the premium by itself."
    } ]
  }, {
    "tStartMs": 341180,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "QI covers that same premium, at a higher\nincome ceiling."
    } ]
  }, {
    "tStartMs": 346180,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Read those letters out on the telephone\nand whoever answers will know immediately"
    } ]
  }, {
    "tStartMs": 350700,
    "dDurationMs": 5167,
    "segs": [ {
      "utf8": "what you are asking for. This year the\nmonthly income lines sit at about one"
    } ]
  }, {
    "tStartMs": 355867,
    "dDurationMs": 4753,
    "segs": [ {
      "utf8": "thousand three hundred and fifty dollars\nfor one person on the first, around"
    } ]
  }, {
    "tStartMs": 360620,
    "dDurationMs": 3653,
    "segs": [ {
      "utf8": "one thousand six hundred on the second,\nand around one thousand eight hundred"
    } ]
  }, {
    "tStartMs": 364520,
    "dDurationMs": 5364,
    "segs": [ {
      "utf8": "on the third. What you have in savings is\ncapped near nine thousand nine hundred"
    } ]
  }, {
    "tStartMs": 369884,
    "dDurationMs": 4236,
    "segs": [ {
      "utf8": "dollars for one person. Your home does not\ncount."
    } ]
  }, {
    "tStartMs": 374620,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "One car does not count. Household goods do\nnot count."
    } ]
  }, {
    "tStartMs": 378940,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "A burial plot does not count. And here is\nthe timing, which is the point of"
    } ]
  }, {
    "tStartMs": 383760,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "this whole video."
    } ]
  }, {
    "tStartMs": 385320,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Your raise lands in January."
    } ]
  }, {
    "tStartMs": 388220,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "The poverty guidelines that set those\nincome lines are not published until"
    } ]
  }, {
    "tStartMs": 392460,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "the middle of January or into February,\nand most states do not start using"
    } ]
  }, {
    "tStartMs": 397420,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "the new ones until March or April."
    } ]
  }, {
    "tStartMs": 400340,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "So for two or three months your income is\nthe new one and the line is the old"
    } ]
  }, {
    "tStartMs": 405220,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "one. People get letters in that window\nsaying they no longer qualify."
    } ]
  }, {
    "tStartMs": 410720,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "A rule covers this."
    } ]
  }, {
    "tStartMs": 412840,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "States have to leave the rise out of the\nsum for those three programs, at least"
    } ]
  }, {
    "tStartMs": 417260,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "until the fresh guidelines are in use."
    } ]
  }, {
    "tStartMs": 419820,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "It exists because somebody noticed the\ndates do not meet."
    } ]
  }, {
    "tStartMs": 423640,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Hardly a soul has been told about it."
    } ]
  }, {
    "tStartMs": 426060,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "So if a letter turns up in February\ntelling you that you have gone over, that"
    } ]
  }, {
    "tStartMs": 430460,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "rule is the thing you name back to them."
    } ]
  }, {
    "tStartMs": 432420,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "One more thing before you hang up."
    } ]
  }, {
    "tStartMs": 435340,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Acceptance into any of those three puts\nyou onto the help with prescription"
    } ]
  }, {
    "tStartMs": 439280,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "costs by itself. The name of it is Extra\nHelp."
    } ]
  }, {
    "tStartMs": 443300,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "No second form, no second interview."
    } ]
  }, {
    "tStartMs": 446080,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "One yes, two things. Number five."
    } ]
  }, {
    "tStartMs": 449520,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "The IRS line never moves at all."
    } ]
  }, {
    "tStartMs": 452200,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "It was set in nineteen eighty three."
    } ]
  }, {
    "tStartMs": 454580,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Everything so far moves. Badly timed,\nmeasured on the wrong people, but it"
    } ]
  }, {
    "tStartMs": 459200,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "moves. This one does not. Social Security\nbecame taxable in nineteen eighty"
    } ]
  }, {
    "tStartMs": 464440,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "three, and the line went in at twenty five\nthousand dollars for a single person,"
    } ]
  }, {
    "tStartMs": 469500,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "thirty two thousand for a couple."
    } ]
  }, {
    "tStartMs": 471320,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Read those out loud and then read what\nthey are now."
    } ]
  }, {
    "tStartMs": 474440,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Identical. Four decades, and the pen has\nnever gone near them."
    } ]
  }, {
    "tStartMs": 479180,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Think about what every raise does against\na line that is nailed down."
    } ]
  }, {
    "tStartMs": 482940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Each year the raise lifts you slightly."
    } ]
  }, {
    "tStartMs": 485440,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "The line does not move to meet you."
    } ]
  }, {
    "tStartMs": 487560,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "So a payment that was below it becomes a\npayment above it, and nothing about"
    } ]
  }, {
    "tStartMs": 492240,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "your life changed except that they gave\nyou the rise they said was to keep"
    } ]
  }, {
    "tStartMs": 496240,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "up with prices. That is the shape of the\nwhole thing."
    } ]
  }, {
    "tStartMs": 499880,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "They move the money a little. They leave\nthe line exactly where it is."
    } ]
  }, {
    "tStartMs": 503400,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "And the gap closes on you from one side\nonly."
    } ]
  }, {
    "tStartMs": 506520,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Now a word about the limits of what I have\ngiven you, because nothing here"
    } ]
  }, {
    "tStartMs": 510320,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "should go further than the evidence does."
    } ]
  }, {
    "tStartMs": 512500,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Your own answer is not mine to give."
    } ]
  }, {
    "tStartMs": 514720,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Each state runs these health programs its\nown way and writes its own forms."
    } ]
  }, {
    "tStartMs": 519940,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Next year's Part B amount stays a"
    } ]
  }, {
    "tStartMs": 521920,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "projection until November puts it in\nprint."
    } ]
  }, {
    "tStartMs": 524780,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "The rise stays an estimate until the\nfourteenth makes it real."
    } ]
  }, {
    "tStartMs": 528480,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "What holds regardless of your state and\nregardless of your figures is the shape"
    } ]
  }, {
    "tStartMs": 532720,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "of it. The day your money changes and the\nday the lines change are different"
    } ]
  }, {
    "tStartMs": 537260,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "days, and the ground between those days is\nwhere people quietly lose help they"
    } ]
  }, {
    "tStartMs": 541920,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "were never disqualified from. So, the\nfive, one more time."
    } ]
  }, {
    "tStartMs": 546680,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Your raise is fixed on the fourteenth of\nOctober from prices measured on younger"
    } ]
  }, {
    "tStartMs": 550820,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "people in cities. Part B takes its share\nfirst and that figure is not official"
    } ]
  }, {
    "tStartMs": 555520,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "until November. The food stamp ceilings\nmoved on the first of October, before"
    } ]
  }, {
    "tStartMs": 559860,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "the raise existed."
    } ]
  }, {
    "tStartMs": 561600,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "The health programs go on judging you\nagainst last year's line until spring,"
    } ]
  }, {
    "tStartMs": 565480,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "and there is a rule that is supposed to\nprotect you in that gap."
    } ]
  }, {
    "tStartMs": 568540,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "And the tax line has not moved since\nnineteen eighty three and will not move"
    } ]
  }, {
    "tStartMs": 573060,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "now."
    } ]
  }, {
    "tStartMs": 574340,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "One last thing, and it turns up on\nschedule every year at this point."
    } ]
  }, {
    "tStartMs": 578420,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "No honest office rings you about your\nrise."
    } ]
  }, {
    "tStartMs": 581260,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "A voice offering to calculate your new\namount, or to safeguard your benefits"
    } ]
  }, {
    "tStartMs": 585080,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "for a small charge, or wanting the long\nnumber off a card before it can go"
    } ]
  }, {
    "tStartMs": 589000,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "ahead, is a voice to hang up on."
    } ]
  }, {
    "tStartMs": 591620,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Checking costs nothing. Applying costs\nnothing."
    } ]
  }, {
    "tStartMs": 594220,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Anyone asking you for money is somebody\nwho had no business dialling your number."
    } ]
  }, {
    "tStartMs": 599660,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "And where there is a relative living on a\nset amount, leave their income out"
    } ]
  }, {
    "tStartMs": 603220,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "of it. Which month did they turn you down?"
    } ]
  } ]
}
