{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 6041,
    "segs": [ {
      "utf8": "The Internal Revenue Service made a series of quiet changes this year that directly"
    } ]
  }, {
    "tStartMs": 6041,
    "dDurationMs": 4822,
    "segs": [ {
      "utf8": "affect how much of your retirement money you get to keep, and almost none"
    } ]
  }, {
    "tStartMs": 10863,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "of it was announced in a way you would ever notice."
    } ]
  }, {
    "tStartMs": 14524,
    "dDurationMs": 5121,
    "segs": [ {
      "utf8": "There was no letter in your mailbox, no warning on your statement, no phone call."
    } ]
  }, {
    "tStartMs": 19965,
    "dDurationMs": 4682,
    "segs": [ {
      "utf8": "The rules simply changed underneath you, and the people who do not find out"
    } ]
  }, {
    "tStartMs": 24647,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "until tax time are the ones who lose the most."
    } ]
  }, {
    "tStartMs": 28328,
    "dDurationMs": 4241,
    "segs": [ {
      "utf8": "Some of these changes can save you thousands of dollars if you know to use them."
    } ]
  }, {
    "tStartMs": 33149,
    "dDurationMs": 4001,
    "segs": [ {
      "utf8": "Others can quietly cost you thousands if you do not see them coming."
    } ]
  }, {
    "tStartMs": 37671,
    "dDurationMs": 4341,
    "segs": [ {
      "utf8": "I am going to walk you through five specific changes the I R S"
    } ]
  }, {
    "tStartMs": 42012,
    "dDurationMs": 5462,
    "segs": [ {
      "utf8": "put in place that hit retirees this year, exactly what each one means for"
    } ]
  }, {
    "tStartMs": 47474,
    "dDurationMs": 3981,
    "segs": [ {
      "utf8": "your money in plain English, and what you need to do about it."
    } ]
  }, {
    "tStartMs": 51455,
    "dDurationMs": 4821,
    "segs": [ {
      "utf8": "Stay to the end, because the last one is a change to inherited accounts"
    } ]
  }, {
    "tStartMs": 56276,
    "dDurationMs": 4742,
    "segs": [ {
      "utf8": "that can hand your children a tax bill they never saw coming, and it"
    } ]
  }, {
    "tStartMs": 61018,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "is the one almost nobody is talking about."
    } ]
  }, {
    "tStartMs": 63998,
    "dDurationMs": 4622,
    "segs": [ {
      "utf8": "The first change is a new deduction that can push your tax bill all"
    } ]
  }, {
    "tStartMs": 68620,
    "dDurationMs": 4301,
    "segs": [ {
      "utf8": "the way down to zero, and most seniors have no idea it exists."
    } ]
  }, {
    "tStartMs": 73741,
    "dDurationMs": 4822,
    "segs": [ {
      "utf8": "Starting with this tax year and running through twenty twenty eight, every person who"
    } ]
  }, {
    "tStartMs": 78563,
    "dDurationMs": 4501,
    "segs": [ {
      "utf8": "is sixty five or older gets a brand new senior bonus deduction of up"
    } ]
  }, {
    "tStartMs": 83064,
    "dDurationMs": 4711,
    "segs": [ {
      "utf8": "to six thousand dollars, and for a married couple where both spouses are sixty"
    } ]
  }, {
    "tStartMs": 87775,
    "dDurationMs": 3592,
    "segs": [ {
      "utf8": "five or older that is twelve thousand dollars."
    } ]
  }, {
    "tStartMs": 91367,
    "dDurationMs": 4501,
    "segs": [ {
      "utf8": "This stacks on top of the regular standard deduction and on top of the"
    } ]
  }, {
    "tStartMs": 95868,
    "dDurationMs": 3941,
    "segs": [ {
      "utf8": "extra deduction seniors have always gotten for being over sixty five."
    } ]
  }, {
    "tStartMs": 100309,
    "dDurationMs": 4922,
    "segs": [ {
      "utf8": "When you add it all together, a single senior can now shelter well over"
    } ]
  }, {
    "tStartMs": 105231,
    "dDurationMs": 5401,
    "segs": [ {
      "utf8": "twenty thousand dollars of income from federal tax, and a married couple can shelter"
    } ]
  }, {
    "tStartMs": 110632,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "close to forty thousand."
    } ]
  }, {
    "tStartMs": 112793,
    "dDurationMs": 5221,
    "segs": [ {
      "utf8": "For millions of retirees living on Social Security plus a modest pension or a"
    } ]
  }, {
    "tStartMs": 118014,
    "dDurationMs": 3762,
    "segs": [ {
      "utf8": "small withdrawal, that means a federal tax bill of zero."
    } ]
  }, {
    "tStartMs": 122216,
    "dDurationMs": 3361,
    "segs": [ {
      "utf8": "But here is the catch the I R S does not advertise."
    } ]
  }, {
    "tStartMs": 126157,
    "dDurationMs": 4841,
    "segs": [ {
      "utf8": "It only lasts through twenty twenty eight unless Congress extends it, and it starts"
    } ]
  }, {
    "tStartMs": 130998,
    "dDurationMs": 4502,
    "segs": [ {
      "utf8": "to shrink for higher incomes, so this is a claim it every single year"
    } ]
  }, {
    "tStartMs": 135500,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "while it lasts situation."
    } ]
  }, {
    "tStartMs": 137520,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "Do not leave six thousand dollars sitting on the table."
    } ]
  }, {
    "tStartMs": 141301,
    "dDurationMs": 5342,
    "segs": [ {
      "utf8": "The second change is connected to the first, and it has quietly created a"
    } ]
  }, {
    "tStartMs": 146643,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "window that the smartest retirees are using right now."
    } ]
  }, {
    "tStartMs": 150824,
    "dDurationMs": 5672,
    "segs": [ {
      "utf8": "Because the standard deduction keeps rising, in twenty twenty six it is sixteen thousand"
    } ]
  }, {
    "tStartMs": 156496,
    "dDurationMs": 6012,
    "segs": [ {
      "utf8": "one hundred dollars for a single person and thirty two thousand two hundred dollars"
    } ]
  }, {
    "tStartMs": 162508,
    "dDurationMs": 4981,
    "segs": [ {
      "utf8": "for a married couple, and because the senior deductions stack on top, there is"
    } ]
  }, {
    "tStartMs": 167489,
    "dDurationMs": 3881,
    "segs": [ {
      "utf8": "now a larger amount of income you can pull out of a traditional retirement"
    } ]
  }, {
    "tStartMs": 171370,
    "dDurationMs": 3781,
    "segs": [ {
      "utf8": "account each year and pay little or no tax on it."
    } ]
  }, {
    "tStartMs": 175471,
    "dDurationMs": 4042,
    "segs": [ {
      "utf8": "This is the low tax window, and it exists in the years after you"
    } ]
  }, {
    "tStartMs": 179513,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "stop working and before forced withdrawals begin."
    } ]
  }, {
    "tStartMs": 183064,
    "dDurationMs": 3611,
    "segs": [ {
      "utf8": "The change in the deduction made that window wider this year."
    } ]
  }, {
    "tStartMs": 187495,
    "dDurationMs": 4741,
    "segs": [ {
      "utf8": "The retirees who understand this are moving money out of their traditional accounts at"
    } ]
  }, {
    "tStartMs": 192236,
    "dDurationMs": 4502,
    "segs": [ {
      "utf8": "almost no tax cost, while the ones who do not understand it leave the"
    } ]
  }, {
    "tStartMs": 196738,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "money sitting there to be taxed harder later."
    } ]
  }, {
    "tStartMs": 199939,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "The rule change handed you a gift. Most people will never open it."
    } ]
  }, {
    "tStartMs": 202419,
    "dDurationMs": 5142,
    "segs": [ {
      "utf8": "The third change is a trap, and it is the one that punishes you"
    } ]
  }, {
    "tStartMs": 207561,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "for something you did two years ago."
    } ]
  }, {
    "tStartMs": 210422,
    "dDurationMs": 5861,
    "segs": [ {
      "utf8": "It is the Medicare income surcharge, the extra amount added to your Medicare premiums"
    } ]
  }, {
    "tStartMs": 216283,
    "dDurationMs": 5082,
    "segs": [ {
      "utf8": "when your income passes a certain line, and the line and the lookback both"
    } ]
  }, {
    "tStartMs": 221365,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "matter this year."
    } ]
  }, {
    "tStartMs": 223086,
    "dDurationMs": 6181,
    "segs": [ {
      "utf8": "In twenty twenty six that surcharge kicks in once your income passes roughly one"
    } ]
  }, {
    "tStartMs": 229267,
    "dDurationMs": 5062,
    "segs": [ {
      "utf8": "hundred and nine thousand dollars for a single person or two hundred and eighteen thousand for a married couple."
    } ]
  }, {
    "tStartMs": 234809,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "But here is the cruel part."
    } ]
  }, {
    "tStartMs": 237050,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "Medicare does not look at this year's income."
    } ]
  }, {
    "tStartMs": 240791,
    "dDurationMs": 2741,
    "segs": [ {
      "utf8": "It looks at your tax return from two years ago."
    } ]
  }, {
    "tStartMs": 244352,
    "dDurationMs": 4141,
    "segs": [ {
      "utf8": "So a one time spike in your income two years back, from selling a"
    } ]
  }, {
    "tStartMs": 248493,
    "dDurationMs": 5602,
    "segs": [ {
      "utf8": "house, from a large withdrawal, from a Roth conversion you did without planning, can"
    } ]
  }, {
    "tStartMs": 254095,
    "dDurationMs": 6121,
    "segs": [ {
      "utf8": "raise your Medicare premiums this year by hundreds or even thousands of dollars, long"
    } ]
  }, {
    "tStartMs": 260216,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "after you have forgotten what caused it."
    } ]
  }, {
    "tStartMs": 262877,
    "dDurationMs": 3961,
    "segs": [ {
      "utf8": "The change you need to know is that if your income has dropped since"
    } ]
  }, {
    "tStartMs": 266838,
    "dDurationMs": 5622,
    "segs": [ {
      "utf8": "then because you retired, you can file a form and ask them to recalculate"
    } ]
  }, {
    "tStartMs": 272460,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "based on what you actually earn now."
    } ]
  }, {
    "tStartMs": 275241,
    "dDurationMs": 4601,
    "segs": [ {
      "utf8": "Most people pay the surcharge for years without ever knowing they could appeal it."
    } ]
  }, {
    "tStartMs": 280222,
    "dDurationMs": 3601,
    "segs": [ {
      "utf8": "The fourth change is the one the I R S is counting on you"
    } ]
  }, {
    "tStartMs": 283823,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "to ignore, the required withdrawal."
    } ]
  }, {
    "tStartMs": 287224,
    "dDurationMs": 4322,
    "segs": [ {
      "utf8": "The government does not let you leave money in a traditional retirement account forever."
    } ]
  }, {
    "tStartMs": 292486,
    "dDurationMs": 3821,
    "segs": [ {
      "utf8": "At a certain age it forces you to start pulling money out and paying"
    } ]
  }, {
    "tStartMs": 296307,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "tax on it whether you need the money or not."
    } ]
  }, {
    "tStartMs": 299768,
    "dDurationMs": 3941,
    "segs": [ {
      "utf8": "For most people that age is now seventy three, and if you were born"
    } ]
  }, {
    "tStartMs": 303709,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "in nineteen sixty or later it is seventy five."
    } ]
  }, {
    "tStartMs": 307390,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "Here is what changed and what bites people."
    } ]
  }, {
    "tStartMs": 310251,
    "dDurationMs": 5402,
    "segs": [ {
      "utf8": "Your very first required withdrawal can be delayed until the first of April of"
    } ]
  }, {
    "tStartMs": 315653,
    "dDurationMs": 4201,
    "segs": [ {
      "utf8": "the following year, but if you delay it, you are then forced to take"
    } ]
  }, {
    "tStartMs": 319854,
    "dDurationMs": 5342,
    "segs": [ {
      "utf8": "two withdrawals in that same year, and stacking two years of income together can"
    } ]
  }, {
    "tStartMs": 325196,
    "dDurationMs": 4521,
    "segs": [ {
      "utf8": "shove you into a higher tax bracket and even trigger that Medicare surcharge we"
    } ]
  }, {
    "tStartMs": 329717,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "just talked about."
    } ]
  }, {
    "tStartMs": 331338,
    "dDurationMs": 4961,
    "segs": [ {
      "utf8": "And if you simply miss a required withdrawal, the penalty is twenty five percent"
    } ]
  }, {
    "tStartMs": 336299,
    "dDurationMs": 3841,
    "segs": [ {
      "utf8": "of the amount you were supposed to take, cut down to ten percent only"
    } ]
  }, {
    "tStartMs": 340140,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "if you fix it quickly."
    } ]
  }, {
    "tStartMs": 342281,
    "dDurationMs": 3821,
    "segs": [ {
      "utf8": "That is a penalty on top of the tax, just for being late."
    } ]
  }, {
    "tStartMs": 346862,
    "dDurationMs": 3641,
    "segs": [ {
      "utf8": "Know your age, know your deadline, and never miss it."
    } ]
  }, {
    "tStartMs": 350803,
    "dDurationMs": 4642,
    "segs": [ {
      "utf8": "The fifth change is the one that almost nobody is talking about, and it"
    } ]
  }, {
    "tStartMs": 355445,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "is the one that reaches past you and lands on your children."
    } ]
  }, {
    "tStartMs": 359786,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "It is the new rule for inherited retirement accounts."
    } ]
  }, {
    "tStartMs": 363427,
    "dDurationMs": 4021,
    "segs": [ {
      "utf8": "It used to be that when your children inherited your I R A, they"
    } ]
  }, {
    "tStartMs": 367448,
    "dDurationMs": 5002,
    "segs": [ {
      "utf8": "could stretch the withdrawals out over their entire lifetime, taking a little each year"
    } ]
  }, {
    "tStartMs": 372450,
    "dDurationMs": 3281,
    "segs": [ {
      "utf8": "and keeping the tax small. That is gone."
    } ]
  }, {
    "tStartMs": 376491,
    "dDurationMs": 4641,
    "segs": [ {
      "utf8": "Under the current rules, when a child or other non spouse inherits your traditional"
    } ]
  }, {
    "tStartMs": 381132,
    "dDurationMs": 5382,
    "segs": [ {
      "utf8": "retirement account, they generally have to empty the entire account within ten years."
    } ]
  }, {
    "tStartMs": 387014,
    "dDurationMs": 4181,
    "segs": [ {
      "utf8": "And the final version of this rule, now in full effect, says that if"
    } ]
  }, {
    "tStartMs": 391195,
    "dDurationMs": 5622,
    "segs": [ {
      "utf8": "you had already started your own required withdrawals before you passed, your children must"
    } ]
  }, {
    "tStartMs": 396817,
    "dDurationMs": 5402,
    "segs": [ {
      "utf8": "also take a withdrawal every single year during that ten year window, not just"
    } ]
  }, {
    "tStartMs": 402219,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "empty it at the end."
    } ]
  }, {
    "tStartMs": 403579,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "What that means in real life is brutal."
    } ]
  }, {
    "tStartMs": 407080,
    "dDurationMs": 5422,
    "segs": [ {
      "utf8": "Your children are usually in their forties, fifties, or sixties when they inherit, often"
    } ]
  }, {
    "tStartMs": 412502,
    "dDurationMs": 4861,
    "segs": [ {
      "utf8": "in their peak earning years and their highest tax brackets, and now they are"
    } ]
  }, {
    "tStartMs": 417363,
    "dDurationMs": 3841,
    "segs": [ {
      "utf8": "forced to pull this money out and pay tax on it on a tight"
    } ]
  }, {
    "tStartMs": 421204,
    "dDurationMs": 3441,
    "segs": [ {
      "utf8": "schedule, at the worst possible rates of their lives."
    } ]
  }, {
    "tStartMs": 425425,
    "dDurationMs": 3822,
    "segs": [ {
      "utf8": "A lifetime of your careful saving can be handed to the I R S"
    } ]
  }, {
    "tStartMs": 429247,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "in a single decade."
    } ]
  }, {
    "tStartMs": 431787,
    "dDurationMs": 4962,
    "segs": [ {
      "utf8": "The move that softens this is to consider converting some of that traditional money"
    } ]
  }, {
    "tStartMs": 436749,
    "dDurationMs": 5121,
    "segs": [ {
      "utf8": "to a Roth account while you are alive, because a Roth passes to your"
    } ]
  }, {
    "tStartMs": 441870,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "children without that yearly tax bill."
    } ]
  }, {
    "tStartMs": 444631,
    "dDurationMs": 5122,
    "segs": [ {
      "utf8": "But you have to know the rule exists before you can plan around it,"
    } ]
  }, {
    "tStartMs": 450193,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "and most people find out only after it is too late."
    } ]
  }, {
    "tStartMs": 454154,
    "dDurationMs": 4561,
    "segs": [ {
      "utf8": "Let me bring all five together, because the thread is the same one that"
    } ]
  }, {
    "tStartMs": 458715,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "runs through everything the I R S does."
    } ]
  }, {
    "tStartMs": 461616,
    "dDurationMs": 4741,
    "segs": [ {
      "utf8": "A new deduction that can take your tax to zero, but only if you claim it."
    } ]
  }, {
    "tStartMs": 466818,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "A wider low tax window, but only if you use it."
    } ]
  }, {
    "tStartMs": 470719,
    "dDurationMs": 5301,
    "segs": [ {
      "utf8": "A Medicare surcharge that punishes you for income from two years ago, but that you can appeal."
    } ]
  }, {
    "tStartMs": 476741,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "A forced withdrawal with a brutal penalty for being late."
    } ]
  }, {
    "tStartMs": 480462,
    "dDurationMs": 5541,
    "segs": [ {
      "utf8": "And a new inheritance rule that quietly hands your children's inheritance to the government over ten years."
    } ]
  }, {
    "tStartMs": 486704,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Not one of these came with a warning."
    } ]
  }, {
    "tStartMs": 489044,
    "dDurationMs": 4662,
    "segs": [ {
      "utf8": "The system changed the rules underneath you, said nothing, and is waiting to see"
    } ]
  }, {
    "tStartMs": 493706,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "who notices and who does not."
    } ]
  }, {
    "tStartMs": 496346,
    "dDurationMs": 4042,
    "segs": [ {
      "utf8": "Nobody from the government is going to call and walk you through how these"
    } ]
  }, {
    "tStartMs": 500388,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "changes affect your money."
    } ]
  }, {
    "tStartMs": 502948,
    "dDurationMs": 4302,
    "segs": [ {
      "utf8": "The I R S processes what you file and stays silent about the rest."
    } ]
  }, {
    "tStartMs": 508390,
    "dDurationMs": 4261,
    "segs": [ {
      "utf8": "The only person who can use the changes that help you and defend against"
    } ]
  }, {
    "tStartMs": 512651,
    "dDurationMs": 5642,
    "segs": [ {
      "utf8": "the ones that hurt you is you, and for most of this, the move is the same."
    } ]
  }, {
    "tStartMs": 519233,
    "dDurationMs": 3601,
    "segs": [ {
      "utf8": "Sit down with your real numbers before the end of the year, and if"
    } ]
  }, {
    "tStartMs": 522834,
    "dDurationMs": 4762,
    "segs": [ {
      "utf8": "any of it is complicated, talk to a fee only fiduciary adviser who can"
    } ]
  }, {
    "tStartMs": 527596,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "run your specific situation."
    } ]
  }, {
    "tStartMs": 530396,
    "dDurationMs": 4382,
    "segs": [ {
      "utf8": "I will put the form numbers and the things to ask about in the description below."
    } ]
  }, {
    "tStartMs": 536038,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "So do one thing for me right now."
    } ]
  }, {
    "tStartMs": 539059,
    "dDurationMs": 4661,
    "segs": [ {
      "utf8": "Send this to one person you care about who is retired or getting close,"
    } ]
  }, {
    "tStartMs": 543720,
    "dDurationMs": 3561,
    "segs": [ {
      "utf8": "and who still has money in a traditional retirement account."
    } ]
  }, {
    "tStartMs": 547782,
    "dDurationMs": 4841,
    "segs": [ {
      "utf8": "A parent, a sibling, a friend, someone at church who has no idea the"
    } ]
  }, {
    "tStartMs": 552623,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "rules just changed underneath them."
    } ]
  }, {
    "tStartMs": 554984,
    "dDurationMs": 4001,
    "segs": [ {
      "utf8": "The odds are very good that at least one of these five changes is"
    } ]
  }, {
    "tStartMs": 558985,
    "dDurationMs": 4641,
    "segs": [ {
      "utf8": "about to cost them or save them real money, and they have never heard"
    } ]
  }, {
    "tStartMs": 563626,
    "dDurationMs": 1421,
    "segs": [ {
      "utf8": "a word about any of it."
    } ]
  }, {
    "tStartMs": 565807,
    "dDurationMs": 4661,
    "segs": [ {
      "utf8": "One share from you could be worth thousands of dollars to them and to their children."
    } ]
  }, {
    "tStartMs": 571028,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "That is what we are here for."
    } ]
  }, {
    "tStartMs": 572529,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "I will see you in the next one."
    } ]
  } ]
}
