{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "The first of October came and went."
    } ]
  }, {
    "tStartMs": 3060,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Your payment did not change. Your health\ncard still works."
    } ]
  }, {
    "tStartMs": 7920,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "The amount taken out for your health cover\ndid not move by a single cent."
    } ]
  }, {
    "tStartMs": 12800,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "If somebody told you otherwise, they were\neither wrong or they were relying"
    } ]
  }, {
    "tStartMs": 17240,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "on you not to check."
    } ]
  }, {
    "tStartMs": 19160,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "What the date actually did was wind up a\nclock."
    } ]
  }, {
    "tStartMs": 22760,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Four of them, and every one lands on a\ndifferent day between now and the middle"
    } ]
  }, {
    "tStartMs": 27120,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "of November, on a different set of people,\nand not one of them arrives with"
    } ]
  }, {
    "tStartMs": 32040,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "your name on an envelope."
    } ]
  }, {
    "tStartMs": 34120,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "On the fourteenth of this month you will\nbe handed one number."
    } ]
  }, {
    "tStartMs": 37620,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Three more numbers move the same morning\nand no newsreader will say them out"
    } ]
  }, {
    "tStartMs": 41920,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "loud. And the figure that decides how much\nof that raise ever reaches your"
    } ]
  }, {
    "tStartMs": 46460,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "bank is not released until the middle of\nNovember."
    } ]
  }, {
    "tStartMs": 49760,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "When it comes out, nothing is mailed to\nyou."
    } ]
  }, {
    "tStartMs": 52520,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "You find out because the deposit is\nsmaller."
    } ]
  }, {
    "tStartMs": 55700,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Four things. The one that takes the most\nmoney is last."
    } ]
  }, {
    "tStartMs": 60040,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Before any of it, who it lands on."
    } ]
  }, {
    "tStartMs": 62480,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Receive Social Security and all four are\nyours."
    } ]
  }, {
    "tStartMs": 65720,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Receive the monthly payment for people\nwith very little and the third one is"
    } ]
  }, {
    "tStartMs": 69620,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "yours twice over. Not one of the four has\nan income test, and not one of them"
    } ]
  }, {
    "tStartMs": 74580,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "asks what you own. Three names, said once."
    } ]
  }, {
    "tStartMs": 78480,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Social Security. The health cover is\nMedicare,"
    } ]
  }, {
    "tStartMs": 81000,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "and the piece of it taken straight"
    } ]
  }, {
    "tStartMs": 82840,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "out of your payment is called Part B."
    } ]
  }, {
    "tStartMs": 84680,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "The monthly payment for people with almost\nnothing is called Supplemental Security"
    } ]
  }, {
    "tStartMs": 89480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Income, and most people just call it the\nsupplement."
    } ]
  }, {
    "tStartMs": 93060,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Number one. The first of October changed\nnothing on your payment, and that"
    } ]
  }, {
    "tStartMs": 97540,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "is the part being sold to you wrongly."
    } ]
  }, {
    "tStartMs": 99960,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Every autumn the same wave of noise\narrives."
    } ]
  }, {
    "tStartMs": 102840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Rules changing on the first. Money\nstopping on the first."
    } ]
  }, {
    "tStartMs": 106880,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "None of it touched your payment."
    } ]
  }, {
    "tStartMs": 108400,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "What the first of October is, is day one\nof the money year the government runs"
    } ]
  }, {
    "tStartMs": 113820,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "on. Their books turn over. Their new\nspending year opens."
    } ]
  }, {
    "tStartMs": 118980,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "For you it is an accounting date and\nnothing more."
    } ]
  }, {
    "tStartMs": 122980,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "The reason it matters is not what happened\nthat day."
    } ]
  }, {
    "tStartMs": 125600,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "It is what started counting that day."
    } ]
  }, {
    "tStartMs": 128560,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Decisions made months ago were written to\ntake effect at points scattered across"
    } ]
  }, {
    "tStartMs": 132660,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "the autumn and the winter, on purpose, so\nthat by the time each one reaches"
    } ]
  }, {
    "tStartMs": 137820,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "a household, there is no news left about\nit and nobody is talking."
    } ]
  }, {
    "tStartMs": 142600,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "So the question is never what changed on\nthe first."
    } ]
  }, {
    "tStartMs": 146420,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "The question is which day your particular\nchange lands on, and whether anybody"
    } ]
  }, {
    "tStartMs": 150900,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "is required to tell you when it does."
    } ]
  }, {
    "tStartMs": 153480,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "For almost everything in this video, the\nanswer to the second half is no."
    } ]
  }, {
    "tStartMs": 158200,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Look at how the autumn is actually built."
    } ]
  }, {
    "tStartMs": 160320,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "One date hands you a figure. A different\ndate, weeks later, hands you the figure"
    } ]
  }, {
    "tStartMs": 165820,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "that cancels part of it. A third date\nmoves money into your account early and"
    } ]
  }, {
    "tStartMs": 170960,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "leaves the following month empty."
    } ]
  }, {
    "tStartMs": 173320,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "Not one of those three is the first of\nOctober, and not one of them was ever"
    } ]
  }, {
    "tStartMs": 177660,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "going to be. That spacing is not an\naccident of the calendar."
    } ]
  }, {
    "tStartMs": 181640,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "A thing that lands on four separate days\nreaches four separate groups of people,"
    } ]
  }, {
    "tStartMs": 186200,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "and by the fourth one the news has stopped\ncovering it and the neighbours have"
    } ]
  }, {
    "tStartMs": 190520,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "stopped mentioning it. Here is the\npractical use of knowing this."
    } ]
  }, {
    "tStartMs": 194700,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "When the next person tells you something\nterrible happened on a date that has"
    } ]
  }, {
    "tStartMs": 198560,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "already gone by, ask them one thing."
    } ]
  }, {
    "tStartMs": 201640,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "Ask what the next date is. If they cannot\nname one, they are selling you a"
    } ]
  }, {
    "tStartMs": 206380,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "feeling, and feelings are what this season\nis made of."
    } ]
  }, {
    "tStartMs": 210280,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "Number two. On the fourteenth you are\nhanded one number, and three others move"
    } ]
  }, {
    "tStartMs": 215120,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "that morning without a word. The raise is\nannounced in the middle of October."
    } ]
  }, {
    "tStartMs": 219720,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "One figure, one headline, every year."
    } ]
  }, {
    "tStartMs": 222920,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Three other figures are decided at the\nvery same moment, and they are published"
    } ]
  }, {
    "tStartMs": 226800,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "in the same release, and almost nobody\nrepeats them."
    } ]
  }, {
    "tStartMs": 230140,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Take the last round as the measure of\nsize, because the new figures do not"
    } ]
  }, {
    "tStartMs": 234140,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "exist yet. The ceiling on earnings that\nget taxed for Social Security went"
    } ]
  }, {
    "tStartMs": 238820,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "from one hundred and seventy six thousand\none hundred dollars to one hundred"
    } ]
  }, {
    "tStartMs": 242630,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "and eighty four thousand five hundred."
    } ]
  }, {
    "tStartMs": 244700,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "That is a jump of eight thousand four\nhundred dollars in one morning."
    } ]
  }, {
    "tStartMs": 248900,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "The amount you are allowed to earn before\nthey start holding money back from"
    } ]
  }, {
    "tStartMs": 252240,
    "dDurationMs": 4548,
    "segs": [ {
      "utf8": "your payment moved as well. Last round it\nlanded at twenty four thousand four"
    } ]
  }, {
    "tStartMs": 256788,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "hundred and eighty dollars."
    } ]
  }, {
    "tStartMs": 258620,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Go past it before you reach full"
    } ]
  }, {
    "tStartMs": 260500,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "retirement age and they keep one dollar\nfor"
    } ]
  }, {
    "tStartMs": 263100,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "every two you earn above the line."
    } ]
  }, {
    "tStartMs": 265260,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "And the figures that decide whether a\nperson counts as able to work moved too."
    } ]
  }, {
    "tStartMs": 270320,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Those are the lines a disability claim is\nweighed against."
    } ]
  }, {
    "tStartMs": 273640,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Earn above them and the answer is no,\nwhatever a doctor has written down."
    } ]
  }, {
    "tStartMs": 278340,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "They are adjusted on the same morning as\nthe raise, in the same release, and"
    } ]
  }, {
    "tStartMs": 282380,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "a person waiting two years on a decision\nwill never be shown the number their"
    } ]
  }, {
    "tStartMs": 286340,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "file is being measured by. Now think about\nwho those three actually land on."
    } ]
  }, {
    "tStartMs": 291300,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Somebody who went back to work part time\nat seventy because the rent moved."
    } ]
  }, {
    "tStartMs": 295600,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Somebody still working at sixty four and\nplanning the month they stop."
    } ]
  }, {
    "tStartMs": 299460,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Somebody waiting on a disability decision\nthat turns on a figure they have"
    } ]
  }, {
    "tStartMs": 303100,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "never been shown."
    } ]
  }, {
    "tStartMs": 304640,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Those are not rare people. And every one\nof them will be told the headline"
    } ]
  }, {
    "tStartMs": 308600,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and none of the three numbers that decide\ntheir year."
    } ]
  }, {
    "tStartMs": 312240,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "So on the fourteenth, do not stop at the\npercentage."
    } ]
  }, {
    "tStartMs": 315740,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "The release has all four figures in it."
    } ]
  }, {
    "tStartMs": 318420,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "The one you need is whichever one applies\nto how you actually live."
    } ]
  }, {
    "tStartMs": 322420,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Number three. Two payments land in\nOctober."
    } ]
  }, {
    "tStartMs": 325440,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "The first of November is empty."
    } ]
  }, {
    "tStartMs": 327260,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "And the second one does not count against\nyou, whatever anybody tells you."
    } ]
  }, {
    "tStartMs": 331520,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Here is what is about to happen to the\nsupplement."
    } ]
  }, {
    "tStartMs": 333920,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "That money normally arrives on the first\nof the month."
    } ]
  }, {
    "tStartMs": 337000,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "The first of November falls on a Sunday."
    } ]
  }, {
    "tStartMs": 339460,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "So the November payment is pushed back to\nthe last working day before it, which"
    } ]
  }, {
    "tStartMs": 343480,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "is the thirtieth of October. That means\nOctober carries two payments."
    } ]
  }, {
    "tStartMs": 347520,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "One at the start, one at the very end."
    } ]
  }, {
    "tStartMs": 349840,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And then the first of November arrives and\nnothing comes, because it already"
    } ]
  }, {
    "tStartMs": 353840,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "came. Now the part that does real damage,\nand it is not the calendar."
    } ]
  }, {
    "tStartMs": 358920,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Somebody will tell you that two payments\nin one month will push you over your"
    } ]
  }, {
    "tStartMs": 362100,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "limit. For the supplement, that limit is\ntwo thousand dollars for one person"
    } ]
  }, {
    "tStartMs": 366420,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "and three thousand for a couple, counted\non the first day of the month."
    } ]
  }, {
    "tStartMs": 370660,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "People hear this every single time the\ncalendar does this, and they do something"
    } ]
  }, {
    "tStartMs": 374800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "about it. They pull the money out."
    } ]
  }, {
    "tStartMs": 377020,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "They hand it to a son or daughter to hold."
    } ]
  }, {
    "tStartMs": 379500,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "They spend it on something they did not\nneed."
    } ]
  }, {
    "tStartMs": 382220,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Every one of those moves can cost you more\nthan the thing you were frightened"
    } ]
  }, {
    "tStartMs": 385580,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "of. Because the rule is already written,\nand it was written to protect you."
    } ]
  }, {
    "tStartMs": 390800,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "When a payment is sent early only because\nthe usual date fell on a weekend,"
    } ]
  }, {
    "tStartMs": 394880,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "it is treated as belonging to the month it\nwas meant for."
    } ]
  }, {
    "tStartMs": 397940,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "The money that arrives on the thirtieth of\nOctober is November money."
    } ]
  }, {
    "tStartMs": 401140,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "It is not October money. And it is not\nlooked at against your limit until the"
    } ]
  }, {
    "tStartMs": 405720,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "month after that. Read that line again,\nbecause it is the reverse of what you"
    } ]
  }, {
    "tStartMs": 410440,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "are about to be told. So the instruction\nhere is to do nothing."
    } ]
  }, {
    "tStartMs": 415280,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Do not move it. Do not hide it."
    } ]
  }, {
    "tStartMs": 417740,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Do not spend it to get it out of the way."
    } ]
  }, {
    "tStartMs": 420160,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Leave it exactly where it lands, and if a\nvoice on the telephone tells you"
    } ]
  }, {
    "tStartMs": 424260,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "to shift it before the first, that voice\nis not from the government."
    } ]
  }, {
    "tStartMs": 428440,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Number four. The raise is given to you in\nOctober."
    } ]
  }, {
    "tStartMs": 432460,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "The amount that eats it is held back until\nthe middle of November, and no letter"
    } ]
  }, {
    "tStartMs": 436580,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "goes out when it lands. Here is the one."
    } ]
  }, {
    "tStartMs": 439740,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The raise is one half of a sum."
    } ]
  }, {
    "tStartMs": 442080,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "The other half is the amount taken out of\nyour payment for your health cover,"
    } ]
  }, {
    "tStartMs": 445740,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "and that amount is set by a different\noffice, released on a different date,"
    } ]
  }, {
    "tStartMs": 450360,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "roughly three weeks later. So for about a\nmonth every year, the whole country"
    } ]
  }, {
    "tStartMs": 455180,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "is told what it is getting and not"
    } ]
  }, {
    "tStartMs": 457100,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "one person can work out what they will\nactually"
    } ]
  }, {
    "tStartMs": 459360,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "keep. The last round shows you the size of\nit."
    } ]
  }, {
    "tStartMs": 463020,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "The raise came to roughly fifty six\ndollars a month for the average person."
    } ]
  }, {
    "tStartMs": 467400,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Three weeks later the health cover figure\nwas published."
    } ]
  }, {
    "tStartMs": 470420,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "It had risen by seventeen dollars and\nninety cents every month, climbing from"
    } ]
  }, {
    "tStartMs": 474860,
    "dDurationMs": 2448,
    "segs": [ {
      "utf8": "one hundred and eighty five to just over\ntwo hundred and two."
    } ]
  }, {
    "tStartMs": 478700,
    "dDurationMs": 1899,
    "segs": [ {
      "utf8": "Seventeen dollars and ninety cents out of\nfifty six."
    } ]
  }, {
    "tStartMs": 481520,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Close to a third of the raise was gone\nbefore a single dollar of it reached"
    } ]
  }, {
    "tStartMs": 485500,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "a bank account. The headline in October\nsaid one thing."
    } ]
  }, {
    "tStartMs": 489100,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "The deposit in January said another."
    } ]
  }, {
    "tStartMs": 491520,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "And the gap between them was never"
    } ]
  }, {
    "tStartMs": 493280,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "explained to anybody, because the two\nnumbers"
    } ]
  }, {
    "tStartMs": 495900,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "were never printed on the same page."
    } ]
  }, {
    "tStartMs": 498340,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "And understand how it is taken."
    } ]
  }, {
    "tStartMs": 500440,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "No bill is posted to you. No payment is\nrequested."
    } ]
  }, {
    "tStartMs": 504260,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "The amount is lifted out before the money\nis ever sent, so there is nothing"
    } ]
  }, {
    "tStartMs": 508120,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "to refuse, nothing to query and nothing to\nhold back."
    } ]
  }, {
    "tStartMs": 511520,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "It just never arrives, and the only\nevidence is a deposit that fell."
    } ]
  }, {
    "tStartMs": 516640,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "So here is what to do, and it costs\nnothing."
    } ]
  }, {
    "tStartMs": 519380,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "In the middle of November, look up the\nhealth cover amount for next year."
    } ]
  }, {
    "tStartMs": 523280,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Take the raise you were told about in\nOctober, take that figure away from it,"
    } ]
  }, {
    "tStartMs": 527020,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "and what is left is your real raise."
    } ]
  }, {
    "tStartMs": 529700,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Write it down before January so the\ndeposit does not have to tell you."
    } ]
  }, {
    "tStartMs": 533840,
    "dDurationMs": 1415,
    "segs": [ {
      "utf8": "Most people never do that sum."
    } ]
  }, {
    "tStartMs": 535800,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "They hear the number in October, they feel\nthe relief in October, and in January"
    } ]
  }, {
    "tStartMs": 540380,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "they wonder why the money feels the same."
    } ]
  }, {
    "tStartMs": 543300,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Here is what joins all four. Every one of\nthem is decided by somebody you will"
    } ]
  }, {
    "tStartMs": 547600,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "never speak to, on a date nobody posts to\nyou, and published in a document"
    } ]
  }, {
    "tStartMs": 552080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "nobody reads aloud."
    } ]
  }, {
    "tStartMs": 553960,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Nothing in this video is secret."
    } ]
  }, {
    "tStartMs": 555720,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "It is all printed and free. It simply\narrives in a form that was never designed"
    } ]
  }, {
    "tStartMs": 560240,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "for a person sitting at a kitchen table\ntrying to work out whether the heating"
    } ]
  }, {
    "tStartMs": 564040,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "can stay on. Now the point where I stop\nbeing useful."
    } ]
  }, {
    "tStartMs": 568280,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "The figures in this video are the last\nround, used to show you the size of"
    } ]
  }, {
    "tStartMs": 572080,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "these things, not to predict the new ones."
    } ]
  }, {
    "tStartMs": 574560,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "The new figures do not exist yet."
    } ]
  }, {
    "tStartMs": 576600,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "The raise comes on the fourteenth of this\nmonth."
    } ]
  }, {
    "tStartMs": 580020,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "The health cover amount comes in the\nmiddle of November."
    } ]
  }, {
    "tStartMs": 583420,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Your own situation depends on what you\nearn, what you receive and which state"
    } ]
  }, {
    "tStartMs": 588100,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "you live in, and none of that is in front\nof me."
    } ]
  }, {
    "tStartMs": 590540,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "The four, said quickly."
    } ]
  }, {
    "tStartMs": 593640,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "The first of October started a money year\nand changed nothing on your payment."
    } ]
  }, {
    "tStartMs": 598300,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "On the fourteenth you get one number while\nthree others move in silence."
    } ]
  }, {
    "tStartMs": 602880,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "October carries two payments of the"
    } ]
  }, {
    "tStartMs": 604740,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "supplement, the first of November is\nempty,"
    } ]
  }, {
    "tStartMs": 607540,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "and the second payment does not count\nagainst your limit no matter who tells"
    } ]
  }, {
    "tStartMs": 611340,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "you it does. And your raise is announced\nweeks before the amount that eats"
    } ]
  }, {
    "tStartMs": 615400,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "it, which last round took close to a third\nof it before it arrived."
    } ]
  }, {
    "tStartMs": 618920,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "So the useful habit is simple and it is\nnothing like what you are being sold."
    } ]
  }, {
    "tStartMs": 624400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Stop watching the dates that have passed."
    } ]
  }, {
    "tStartMs": 626620,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "Watch the two that are still coming."
    } ]
  }, {
    "tStartMs": 628680,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The fourteenth of this month, and the\nmiddle of November."
    } ]
  }, {
    "tStartMs": 632040,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Those two mornings decide your whole next\nyear."
    } ]
  }, {
    "tStartMs": 635060,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "One more thing, because this season brings\nthe calls."
    } ]
  }, {
    "tStartMs": 638240,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Nobody official telephones you about your\nraise."
    } ]
  }, {
    "tStartMs": 641060,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "Nobody official asks you to move money\nbefore the first of a month."
    } ]
  }, {
    "tStartMs": 644660,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "If a voice offers to protect your payment,\nor needs your account details to"
    } ]
  }, {
    "tStartMs": 648740,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "make sure the raise goes through, that is\nsomebody working from a bought list."
    } ]
  }, {
    "tStartMs": 653000,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Hang up while they are still talking."
    } ]
  }, {
    "tStartMs": 654960,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "And if you know an older person living on\none fixed payment, keep the October"
    } ]
  }, {
    "tStartMs": 658940,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "headline to yourself. Wait for the middle\nof November, sit down with them,"
    } ]
  }, {
    "tStartMs": 663800,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "do the subtraction once, and hand them the\nfigure that is actually true."
    } ]
  } ]
}
