{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "In January seven good things become\navailable to people over 65."
    } ]
  }, {
    "tStartMs": 5540,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Five of them are the same in every state."
    } ]
  }, {
    "tStartMs": 8500,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Not one of them will be posted to you."
    } ]
  }, {
    "tStartMs": 10980,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "You heard about the raise last week."
    } ]
  }, {
    "tStartMs": 13120,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "3.6%. That one arrives on its own, and it\nis the only thing on this list that"
    } ]
  }, {
    "tStartMs": 18540,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "does."
    } ]
  }, {
    "tStartMs": 19580,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "These seven sit and wait for somebody to\nask."
    } ]
  }, {
    "tStartMs": 23020,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Two of them depend on your county."
    } ]
  }, {
    "tStartMs": 25360,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Five do not. I will tell you which is\nwhich every time."
    } ]
  }, {
    "tStartMs": 28920,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "And the biggest is worth $6,000 off the\nincome you are taxed on."
    } ]
  }, {
    "tStartMs": 33420,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "Each. I am saving that one for last,\nbecause it is also the one most people"
    } ]
  }, {
    "tStartMs": 38740,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "get wrong. One line before we start."
    } ]
  }, {
    "tStartMs": 41600,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "I cannot see your state, your income, or\nyour paperwork, and those three decide"
    } ]
  }, {
    "tStartMs": 47280,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "your answer. So I will give you the rule,\nthe number the rule uses, and the"
    } ]
  }, {
    "tStartMs": 52160,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "office that holds it. Anybody handing you\nan exact figure for your own house"
    } ]
  }, {
    "tStartMs": 56520,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "today is guessing."
    } ]
  }, {
    "tStartMs": 58720,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "None of this is hidden. It is on\ngovernment websites, free, for anybody who"
    } ]
  }, {
    "tStartMs": 63360,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "looks. It works badly for people only\nbecause every one of these offices is"
    } ]
  }, {
    "tStartMs": 67980,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "built to answer. Not one of them is built\nto ask."
    } ]
  }, {
    "tStartMs": 71800,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Number one. Your county will take money\noff your property tax bill, and it"
    } ]
  }, {
    "tStartMs": 76360,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "will never once tell you that you qualify."
    } ]
  }, {
    "tStartMs": 78320,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "This is the one that costs the most and\ngets claimed the least."
    } ]
  }, {
    "tStartMs": 82660,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Nearly every state has something for older\nowners."
    } ]
  }, {
    "tStartMs": 85360,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "It is not automatic. Nobody checks your\nage and applies it for you."
    } ]
  }, {
    "tStartMs": 89600,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "You file a form at the county assessor or\nthe appraisal district."
    } ]
  }, {
    "tStartMs": 93440,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Until you file, you pay the full amount."
    } ]
  }, {
    "tStartMs": 96360,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "The ages and the amounts are set by your\nstate, and often by your county."
    } ]
  }, {
    "tStartMs": 100140,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "So I cannot tell you yours. I can tell you\nhow far apart they are."
    } ]
  }, {
    "tStartMs": 105540,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "In Texas, an owner of 65 gets $60,000\ntaken off the value"
    } ]
  }, {
    "tStartMs": 111640,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "the school tax is worked out on."
    } ]
  }, {
    "tStartMs": 114340,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "In Texas, age is enough."
    } ]
  }, {
    "tStartMs": 117340,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "In one Georgia county, Cobb County, an\nowner of 62 has the whole school part"
    } ]
  }, {
    "tStartMs": 122920,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "removed, with no income limit."
    } ]
  }, {
    "tStartMs": 125620,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "The statewide Georgia rule is much\nsmaller."
    } ]
  }, {
    "tStartMs": 128320,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "In Florida, Illinois and New York there is\nan income limit."
    } ]
  }, {
    "tStartMs": 132260,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "So the answer is not a number."
    } ]
  }, {
    "tStartMs": 135460,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "The answer is a telephone call."
    } ]
  }, {
    "tStartMs": 137980,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Ask for each one by name. Say this."
    } ]
  }, {
    "tStartMs": 141120,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "I am over 65, and I want the homestead\nexemption, the senior exemption, and"
    } ]
  }, {
    "tStartMs": 146580,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "any freeze you have. Then ask for the\ndeadline."
    } ]
  }, {
    "tStartMs": 150280,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Write it down while they are still on the\nline."
    } ]
  }, {
    "tStartMs": 152620,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "Number two. There is a program that pays\nmost of your medicine costs, and the"
    } ]
  }, {
    "tStartMs": 157700,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "income line is far higher than people\nbelieve."
    } ]
  }, {
    "tStartMs": 160140,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "Same in every state. It is called Extra\nHelp, and it works on the medicine"
    } ]
  }, {
    "tStartMs": 165940,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "side of Medicare."
    } ]
  }, {
    "tStartMs": 167800,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "This year the line is $23,940 a year for\none person."
    } ]
  }, {
    "tStartMs": 173440,
    "dDurationMs": 3805,
    "segs": [ {
      "utf8": "For a married couple living together it is\n$32,460."
    } ]
  }, {
    "tStartMs": 178340,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Read those again, because this is where\npeople take themselves out."
    } ]
  }, {
    "tStartMs": 182760,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "They hear the word help and decide it is\nfor somebody poorer."
    } ]
  }, {
    "tStartMs": 186720,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "$23,940 a year is about $1,995 a month."
    } ]
  }, {
    "tStartMs": 192400,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "A good many people listening are under\nthat and have never applied once."
    } ]
  }, {
    "tStartMs": 196420,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "If you are a little over, apply anyway."
    } ]
  }, {
    "tStartMs": 199480,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Some of what you own and receive does not\ncount the way you expect, and the"
    } ]
  }, {
    "tStartMs": 203700,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "office works that out, not you."
    } ]
  }, {
    "tStartMs": 206300,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "A refusal costs you nothing. Not applying\ncosts you every month."
    } ]
  }, {
    "tStartMs": 210960,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "You apply through Social Security."
    } ]
  }, {
    "tStartMs": 213260,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "Online, or by telephone. It is free, and\nnobody should ever charge you to fill"
    } ]
  }, {
    "tStartMs": 218420,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "it in. Number three. In January there is\nmoney waiting for your heating bill,"
    } ]
  }, {
    "tStartMs": 223500,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and in most places it runs out before the\nwinter does."
    } ]
  }, {
    "tStartMs": 227160,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "This is federal money, handed out by your\nown state."
    } ]
  }, {
    "tStartMs": 230360,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "That is why somebody two states away gets\na different answer."
    } ]
  }, {
    "tStartMs": 233980,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Your state sets its own income line."
    } ]
  }, {
    "tStartMs": 235920,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "But it is not allowed to go below 1.1\ntimes the poverty figure for a household"
    } ]
  }, {
    "tStartMs": 241060,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "of your size. That is the floor, and you\ncan hold them to it."
    } ]
  }, {
    "tStartMs": 245720,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Here is the part that costs people real\nmoney."
    } ]
  }, {
    "tStartMs": 248280,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "It is handed out in the order people ask."
    } ]
  }, {
    "tStartMs": 250800,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "In a cold January it is gone by February\nin a great many counties."
    } ]
  }, {
    "tStartMs": 255400,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Being eligible is not the same as being\npaid."
    } ]
  }, {
    "tStartMs": 258180,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "The people who get it are the people who\nasked early."
    } ]
  }, {
    "tStartMs": 261180,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Ask your county office for the home energy\nassistance program."
    } ]
  }, {
    "tStartMs": 264360,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "In the same call, ask whether they run a\ncrisis fund for a shut off notice."
    } ]
  }, {
    "tStartMs": 268800,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "That is usually a separate pot with its\nown money."
    } ]
  }, {
    "tStartMs": 272760,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Number four. A funeral home must hand you\na price list before it shows you"
    } ]
  }, {
    "tStartMs": 276620,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "a single casket, and it cannot charge you\nfor using a casket you bought somewhere"
    } ]
  }, {
    "tStartMs": 280720,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "else. Same in every state, and almost\nnobody knows it."
    } ]
  }, {
    "tStartMs": 285100,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Most funeral homes are covered by a\nfederal rule called the Funeral Rule."
    } ]
  }, {
    "tStartMs": 289300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It says three things."
    } ]
  }, {
    "tStartMs": 291220,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "First, you can telephone and ask the\nprices, and they have to tell you."
    } ]
  }, {
    "tStartMs": 294900,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "You do not have to give your name."
    } ]
  }, {
    "tStartMs": 296580,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "You do not have to give your address."
    } ]
  }, {
    "tStartMs": 298040,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "And if you walk in, they must hand you a\nwritten list of everything they sell"
    } ]
  }, {
    "tStartMs": 302480,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "and what each item costs."
    } ]
  }, {
    "tStartMs": 304760,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "That list is yours to keep. Second, you\ncan buy the casket wherever you like."
    } ]
  }, {
    "tStartMs": 309480,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "From another supplier, or online."
    } ]
  }, {
    "tStartMs": 312020,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "A fraction of what the same box costs in\nthe room with the curtains."
    } ]
  }, {
    "tStartMs": 316100,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Third, and this is the one that saves the\nmoney."
    } ]
  }, {
    "tStartMs": 318540,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "If you bring your own, they cannot charge\nyou a handling fee."
    } ]
  }, {
    "tStartMs": 322060,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Not a storage fee, not a receiving fee,\nnothing."
    } ]
  }, {
    "tStartMs": 325040,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "If anybody tells you different, what they\nare telling you is not true."
    } ]
  }, {
    "tStartMs": 329620,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "So do this on an ordinary afternoon, when\nnobody has died and nobody is in"
    } ]
  }, {
    "tStartMs": 334060,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "a hurry. Ask three funeral homes for the\nprice list."
    } ]
  }, {
    "tStartMs": 337760,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Put them in a drawer, and tell one person\nin your family which drawer."
    } ]
  }, {
    "tStartMs": 342540,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Number five. A nursing home cannot make\nyour son or your daughter promise to"
    } ]
  }, {
    "tStartMs": 346740,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "pay the bill as the price of letting you\nin."
    } ]
  }, {
    "tStartMs": 349480,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Same in every state, for any home that\ntakes Medicare or Medicaid."
    } ]
  }, {
    "tStartMs": 353660,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "That is very nearly all of them."
    } ]
  }, {
    "tStartMs": 356080,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "The rule is plain. They may not require a\nthird person to guarantee payment"
    } ]
  }, {
    "tStartMs": 360200,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "as a condition of admitting you."
    } ]
  }, {
    "tStartMs": 362340,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "They may not require it to let you stay\neither."
    } ]
  }, {
    "tStartMs": 365000,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "What they can do is ask somebody who\nalready handles your money to pay the"
    } ]
  }, {
    "tStartMs": 369100,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "bill out of your own funds. That is a\ndifferent thing, and the difference is"
    } ]
  }, {
    "tStartMs": 373140,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "everything. One asks your daughter to\nstand behind your bill with her own money."
    } ]
  }, {
    "tStartMs": 377200,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The other asks her to pay your bill out of\nyour account."
    } ]
  }, {
    "tStartMs": 379480,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "The first they cannot require."
    } ]
  }, {
    "tStartMs": 381900,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "The second they can. So when a form is\npushed across a desk in the worst week"
    } ]
  }, {
    "tStartMs": 386140,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "of your life, and somebody calls it a\nformality, ask this out loud."
    } ]
  }, {
    "tStartMs": 390480,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Am I signing as the person responsible for\nthis bill, or am I signing to handle"
    } ]
  }, {
    "tStartMs": 394720,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "money that belongs to my mother."
    } ]
  }, {
    "tStartMs": 396880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Ask them to point to the sentence on the\npage."
    } ]
  }, {
    "tStartMs": 399660,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Number six. There is a line under which no\nfederal tax at all is taken from"
    } ]
  }, {
    "tStartMs": 403860,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "your Social Security, and it has not moved\nsince 1983."
    } ]
  }, {
    "tStartMs": 408240,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Same in every state. Take half of what\nSocial Security pays you in a year."
    } ]
  }, {
    "tStartMs": 412900,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Add everything else that comes in."
    } ]
  }, {
    "tStartMs": 415040,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "A pension, wages, interest, money drawn\nfrom a retirement account."
    } ]
  }, {
    "tStartMs": 419920,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "If that total is under $25,000 for one\nperson, no federal tax is due on your"
    } ]
  }, {
    "tStartMs": 425260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Social Security."
    } ]
  }, {
    "tStartMs": 426620,
    "dDurationMs": 3348,
    "segs": [ {
      "utf8": "For a married couple filing together the\nfigure is $32,000."
    } ]
  }, {
    "tStartMs": 430700,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "There is a ceiling at the other end people\ndo not know about."
    } ]
  }, {
    "tStartMs": 433300,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "However high your income climbs, the most\nof your Social Security that can"
    } ]
  }, {
    "tStartMs": 437580,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "ever be taxed is 85%. 15% of it is never\nreachable."
    } ]
  }, {
    "tStartMs": 442880,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Now the hard part, and I am not going to\ndress it up."
    } ]
  }, {
    "tStartMs": 447340,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Those two numbers are not tied to the cost\nof living."
    } ]
  }, {
    "tStartMs": 450700,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "They were set in 1983 and they have stayed\nwhere somebody put them, while everything"
    } ]
  }, {
    "tStartMs": 456580,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "else in your life went up. That is why\npeople who sat comfortably under that"
    } ]
  }, {
    "tStartMs": 461700,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "line twenty years ago sit above it now,\nwithout having done anything differently."
    } ]
  }, {
    "tStartMs": 467880,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Work your own total out once, on paper,\nbefore you file."
    } ]
  }, {
    "tStartMs": 472420,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Number seven, and this is the big one."
    } ]
  }, {
    "tStartMs": 474940,
    "dDurationMs": 6500,
    "segs": [ {
      "utf8": "If you are 65 or over, an extra $6,000\ncomes off the income you are taxed on."
    } ]
  }, {
    "tStartMs": 481440,
    "dDurationMs": 6060,
    "segs": [ {
      "utf8": "Each. So a married couple where both of\nyou are over 65 is $12,000."
    } ]
  }, {
    "tStartMs": 488120,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "It is here for this year and the three\nthat follow, and then it ends."
    } ]
  }, {
    "tStartMs": 492680,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Same in every state, because it is\nfederal."
    } ]
  }, {
    "tStartMs": 495600,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Three things people get wrong, and the\nthird matters most."
    } ]
  }, {
    "tStartMs": 499720,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "First. It shrinks if your income is high."
    } ]
  }, {
    "tStartMs": 503020,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "Above $75,000 for one person, or $150,000\nfor a couple, it starts"
    } ]
  }, {
    "tStartMs": 509260,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "coming down. Most people listening are\nnowhere near that and get the whole"
    } ]
  }, {
    "tStartMs": 513780,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "of it. Second. You do not have to itemize\nto take it."
    } ]
  }, {
    "tStartMs": 518140,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "It sits on top of the ordinary deduction."
    } ]
  }, {
    "tStartMs": 520960,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "People who have never itemized anything\nstill get every dollar."
    } ]
  }, {
    "tStartMs": 525340,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Third, and listen closely, because there\nare videos telling you otherwise."
    } ]
  }, {
    "tStartMs": 529760,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "This does not make your Social Security\ntax free."
    } ]
  }, {
    "tStartMs": 532720,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "It is a deduction. A deduction takes money\noff the amount you are taxed on."
    } ]
  }, {
    "tStartMs": 537720,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It does not declare one kind of income\nuntouchable."
    } ]
  }, {
    "tStartMs": 541320,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "If somebody told you Social Security is no\nlonger taxed, they were wrong."
    } ]
  }, {
    "tStartMs": 546100,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Number six is where the truth about that\nlives."
    } ]
  }, {
    "tStartMs": 549020,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "You do not apply for this one."
    } ]
  }, {
    "tStartMs": 551020,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Whoever fills in your return claims it."
    } ]
  }, {
    "tStartMs": 553800,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "So say it out loud to them. I am over 65\nand I want the extra deduction for"
    } ]
  }, {
    "tStartMs": 558760,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "my age. That is the seven. And the same\nshape sits under every one."
    } ]
  }, {
    "tStartMs": 563700,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Not one of these offices is going to write\nto you."
    } ]
  }, {
    "tStartMs": 566580,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The county will not mention the exemption."
    } ]
  }, {
    "tStartMs": 569320,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Social Security will not telephone you\nabout Extra Help."
    } ]
  }, {
    "tStartMs": 572600,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The funeral home will not open with the\nprice list."
    } ]
  }, {
    "tStartMs": 575400,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "The rule exists, the money exists, and the\nwhole system waits with its hands"
    } ]
  }, {
    "tStartMs": 579800,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "folded until somebody asks."
    } ]
  }, {
    "tStartMs": 582400,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Treat this as education, not as advice\nabout your own money."
    } ]
  }, {
    "tStartMs": 586440,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Your state sets its own figures and its\nown deadlines, and yours may sit higher"
    } ]
  }, {
    "tStartMs": 590720,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "or lower than anything said here."
    } ]
  }, {
    "tStartMs": 593400,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Two of the seven depend on where you live."
    } ]
  }, {
    "tStartMs": 596000,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "Number one and number three. The other\nfive are the same in every state in"
    } ]
  }, {
    "tStartMs": 600040,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "the country. And if one of your parents is\nliving on a fixed amount this winter,"
    } ]
  }, {
    "tStartMs": 604480,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "they do not need this explained."
    } ]
  }, {
    "tStartMs": 606600,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "They need two telephone numbers and the\nword deadline."
    } ]
  }, {
    "tStartMs": 610020,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Sit beside them, find the county office\nand find Social Security, and let them"
    } ]
  }, {
    "tStartMs": 614820,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "make the calls themselves."
    } ]
  } ]
}
