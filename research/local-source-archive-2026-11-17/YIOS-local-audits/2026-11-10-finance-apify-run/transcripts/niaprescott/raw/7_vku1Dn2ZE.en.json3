{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "Hello, and welcome back."
    } ]
  }, {
    "tStartMs": 2762,
    "dDurationMs": 3943,
    "segs": [ {
      "utf8": "If you were born in the nineteen forties, the nineteen fifties, or"
    } ]
  }, {
    "tStartMs": 6705,
    "dDurationMs": 4183,
    "segs": [ {
      "utf8": "the nineteen sixties, the rules around your Social Security are"
    } ]
  }, {
    "tStartMs": 10888,
    "dDurationMs": 4084,
    "segs": [ {
      "utf8": "changing this year, and what applies to you is not the same"
    } ]
  }, {
    "tStartMs": 14972,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "as what applies to the person born ten years before or after"
    } ]
  }, {
    "tStartMs": 18695,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "you."
    } ]
  }, {
    "tStartMs": 19996,
    "dDurationMs": 4103,
    "segs": [ {
      "utf8": "The Social Security Administration does not send you a personal"
    } ]
  }, {
    "tStartMs": 24099,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "letter explaining any of it."
    } ]
  }, {
    "tStartMs": 26401,
    "dDurationMs": 4203,
    "segs": [ {
      "utf8": "The rules simply shift underneath you, and the people who lose"
    } ]
  }, {
    "tStartMs": 30604,
    "dDurationMs": 4244,
    "segs": [ {
      "utf8": "money are almost always the ones who assumed that if something changed,"
    } ]
  }, {
    "tStartMs": 35148,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "somebody would have told them."
    } ]
  }, {
    "tStartMs": 36629,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "So stay with me to the end, because by the time we"
    } ]
  }, {
    "tStartMs": 39591,
    "dDurationMs": 3563,
    "segs": [ {
      "utf8": "are done you will know exactly what changed for your birth group,"
    } ]
  }, {
    "tStartMs": 43535,
    "dDurationMs": 3643,
    "segs": [ {
      "utf8": "what you need to check, and what quietly happens to your monthly"
    } ]
  }, {
    "tStartMs": 47178,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "check if you do nothing at all."
    } ]
  }, {
    "tStartMs": 49419,
    "dDurationMs": 3743,
    "segs": [ {
      "utf8": "Let me start with the people born in the nineteen forties, because"
    } ]
  }, {
    "tStartMs": 53162,
    "dDurationMs": 3263,
    "segs": [ {
      "utf8": "you have already reached your full retirement age and most of you"
    } ]
  }, {
    "tStartMs": 56425,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "are collecting right now."
    } ]
  }, {
    "tStartMs": 58467,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "For you, the changes this year are not about when to claim,"
    } ]
  }, {
    "tStartMs": 62470,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "they are about protecting the check you already receive."
    } ]
  }, {
    "tStartMs": 66153,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "There is a cost of living increase of two point eight percent"
    } ]
  }, {
    "tStartMs": 69335,
    "dDurationMs": 3343,
    "segs": [ {
      "utf8": "that began this year, which is real money added to your monthly"
    } ]
  }, {
    "tStartMs": 72678,
    "dDurationMs": 3143,
    "segs": [ {
      "utf8": "payment, and you want to make sure it actually showed up on"
    } ]
  }, {
    "tStartMs": 75821,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "your benefit."
    } ]
  }, {
    "tStartMs": 76781,
    "dDurationMs": 4034,
    "segs": [ {
      "utf8": "There is a new tax deduction worth up to six thousand dollars"
    } ]
  }, {
    "tStartMs": 80815,
    "dDurationMs": 3613,
    "segs": [ {
      "utf8": "for people sixty five and older, which for many in your group"
    } ]
  }, {
    "tStartMs": 84428,
    "dDurationMs": 3883,
    "segs": [ {
      "utf8": "can bring the tax on your Social Security all the way down"
    } ]
  }, {
    "tStartMs": 88311,
    "dDurationMs": 2662,
    "segs": [ {
      "utf8": "to nothing if your return is done correctly."
    } ]
  }, {
    "tStartMs": 91713,
    "dDurationMs": 3904,
    "segs": [ {
      "utf8": "And there is the change that touches every single person watching this,"
    } ]
  }, {
    "tStartMs": 96157,
    "dDurationMs": 3343,
    "segs": [ {
      "utf8": "which is that the paper check is ending and you must be"
    } ]
  }, {
    "tStartMs": 99500,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "set up for electronic payment, and I will come back to that"
    } ]
  }, {
    "tStartMs": 103003,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "one for everybody in a moment."
    } ]
  }, {
    "tStartMs": 105885,
    "dDurationMs": 3403,
    "segs": [ {
      "utf8": "Here is what I want you to actually do if you are"
    } ]
  }, {
    "tStartMs": 109288,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "in this group."
    } ]
  }, {
    "tStartMs": 110809,
    "dDurationMs": 4383,
    "segs": [ {
      "utf8": "Pull out your most recent benefit statement or check your account, and"
    } ]
  }, {
    "tStartMs": 115192,
    "dDurationMs": 4224,
    "segs": [ {
      "utf8": "confirm two things, that the two point eight percent increase is reflected"
    } ]
  }, {
    "tStartMs": 119416,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "in your payment, and that the Medicare premium being pulled out of"
    } ]
  }, {
    "tStartMs": 123319,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "your check is the correct amount for this year and not more."
    } ]
  }, {
    "tStartMs": 127723,
    "dDurationMs": 4323,
    "segs": [ {
      "utf8": "Every year, people in your generation overpay a Medicare surcharge"
    } ]
  }, {
    "tStartMs": 132046,
    "dDurationMs": 4344,
    "segs": [ {
      "utf8": "they could have appealed, or miss a deduction that was theirs, simply"
    } ]
  }, {
    "tStartMs": 136390,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "because the payment shows up automatically and they never look closely."
    } ]
  }, {
    "tStartMs": 140893,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "The money is already yours."
    } ]
  }, {
    "tStartMs": 143215,
    "dDurationMs": 4384,
    "segs": [ {
      "utf8": "You just have to make sure it is actually reaching you in"
    } ]
  }, {
    "tStartMs": 147599,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "full."
    } ]
  }, {
    "tStartMs": 148579,
    "dDurationMs": 2823,
    "segs": [ {
      "utf8": "Now the people born in the nineteen fifties."
    } ]
  }, {
    "tStartMs": 151402,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "You are in the most delicate spot of all three groups, because"
    } ]
  }, {
    "tStartMs": 155065,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "some of you have claimed and some of you have not, and"
    } ]
  }, {
    "tStartMs": 158387,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "the difference of even one year in when you start can change"
    } ]
  }, {
    "tStartMs": 161890,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "your monthly check for the rest of your life."
    } ]
  }, {
    "tStartMs": 164792,
    "dDurationMs": 4844,
    "segs": [ {
      "utf8": "Your full retirement age is not a clean sixty six anymore, it"
    } ]
  }, {
    "tStartMs": 169636,
    "dDurationMs": 3383,
    "segs": [ {
      "utf8": "sits a few months past it depending on your exact year of"
    } ]
  }, {
    "tStartMs": 173019,
    "dDurationMs": 4364,
    "segs": [ {
      "utf8": "birth, and claiming before you reach it means a permanent reduction"
    } ]
  }, {
    "tStartMs": 177383,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "that never comes back."
    } ]
  }, {
    "tStartMs": 178964,
    "dDurationMs": 4143,
    "segs": [ {
      "utf8": "If you are still working and collecting at the same time, there"
    } ]
  }, {
    "tStartMs": 183107,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "is an earnings limit that can hold back part of your check,"
    } ]
  }, {
    "tStartMs": 186510,
    "dDurationMs": 3803,
    "segs": [ {
      "utf8": "and the number changed this year, so it is worth knowing exactly"
    } ]
  }, {
    "tStartMs": 190313,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "where that line sits before you pick up extra hours."
    } ]
  }, {
    "tStartMs": 194096,
    "dDurationMs": 3463,
    "segs": [ {
      "utf8": "There is also a quiet trap around survivor benefits for many in"
    } ]
  }, {
    "tStartMs": 197559,
    "dDurationMs": 3763,
    "segs": [ {
      "utf8": "your group, because if you have lost a spouse, you may be"
    } ]
  }, {
    "tStartMs": 201322,
    "dDurationMs": 3743,
    "segs": [ {
      "utf8": "entitled to a higher payment based on their earnings record, and the"
    } ]
  }, {
    "tStartMs": 205065,
    "dDurationMs": 4123,
    "segs": [ {
      "utf8": "Social Security Administration does not always reach out to tell you that"
    } ]
  }, {
    "tStartMs": 209188,
    "dDurationMs": 741,
    "segs": [ {
      "utf8": "you can switch."
    } ]
  }, {
    "tStartMs": 210890,
    "dDurationMs": 4043,
    "segs": [ {
      "utf8": "A widow or a widower can collect their own smaller check"
    } ]
  }, {
    "tStartMs": 214933,
    "dDurationMs": 4143,
    "segs": [ {
      "utf8": "for years, never knowing a larger one was sitting there the"
    } ]
  }, {
    "tStartMs": 219076,
    "dDurationMs": 821,
    "segs": [ {
      "utf8": "whole time."
    } ]
  }, {
    "tStartMs": 220497,
    "dDurationMs": 3163,
    "segs": [ {
      "utf8": "And if you spent any part of your career as a teacher,"
    } ]
  }, {
    "tStartMs": 224140,
    "dDurationMs": 4224,
    "segs": [ {
      "utf8": "a firefighter, a police officer, or any public job"
    } ]
  }, {
    "tStartMs": 228364,
    "dDurationMs": 4523,
    "segs": [ {
      "utf8": "with its own pension, listen very closely to the part coming up"
    } ]
  }, {
    "tStartMs": 232887,
    "dDurationMs": 4084,
    "segs": [ {
      "utf8": "about the law that just restored benefits to millions of people"
    } ]
  }, {
    "tStartMs": 236971,
    "dDurationMs": 1861,
    "segs": [ {
      "utf8": "in exactly that situation."
    } ]
  }, {
    "tStartMs": 239453,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "Then there are the people born in the nineteen sixties."
    } ]
  }, {
    "tStartMs": 243056,
    "dDurationMs": 4163,
    "segs": [ {
      "utf8": "For your group, this is the year the full retirement age officially"
    } ]
  }, {
    "tStartMs": 247219,
    "dDurationMs": 4043,
    "segs": [ {
      "utf8": "reaches sixty seven, the final step of a change that"
    } ]
  }, {
    "tStartMs": 251262,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "has been climbing quietly for forty years."
    } ]
  }, {
    "tStartMs": 254805,
    "dDurationMs": 4043,
    "segs": [ {
      "utf8": "That means the old idea of full benefits at sixty six no"
    } ]
  }, {
    "tStartMs": 258848,
    "dDurationMs": 3984,
    "segs": [ {
      "utf8": "longer applies to you, and if you claim at sixty two, the"
    } ]
  }, {
    "tStartMs": 262832,
    "dDurationMs": 3743,
    "segs": [ {
      "utf8": "reduction is larger than it was for the generations before you."
    } ]
  }, {
    "tStartMs": 266815,
    "dDurationMs": 4123,
    "segs": [ {
      "utf8": "None of this means you should wait no matter what, because everyone's"
    } ]
  }, {
    "tStartMs": 270938,
    "dDurationMs": 4203,
    "segs": [ {
      "utf8": "health and situation is different, but it does mean the decision in"
    } ]
  }, {
    "tStartMs": 275141,
    "dDurationMs": 3343,
    "segs": [ {
      "utf8": "front of you is not the same decision your older brother or"
    } ]
  }, {
    "tStartMs": 278484,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "sister faced, and treating it like it is the same is one"
    } ]
  }, {
    "tStartMs": 282307,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "of the most expensive mistakes in this entire system."
    } ]
  }, {
    "tStartMs": 286210,
    "dDurationMs": 4284,
    "segs": [ {
      "utf8": "Know your real full retirement age, run your real numbers, and"
    } ]
  }, {
    "tStartMs": 290494,
    "dDurationMs": 2742,
    "segs": [ {
      "utf8": "do not let an old rule of thumb cost you."
    } ]
  }, {
    "tStartMs": 293476,
    "dDurationMs": 3743,
    "segs": [ {
      "utf8": "And there is one more thing for your group that almost nobody"
    } ]
  }, {
    "tStartMs": 297219,
    "dDurationMs": 4044,
    "segs": [ {
      "utf8": "plans for, which is the way taking your Social Security too"
    } ]
  }, {
    "tStartMs": 301263,
    "dDurationMs": 4103,
    "segs": [ {
      "utf8": "early while you are still working can collide with the earnings limit"
    } ]
  }, {
    "tStartMs": 305366,
    "dDurationMs": 4043,
    "segs": [ {
      "utf8": "and the taxes on your benefit all at the same time, so"
    } ]
  }, {
    "tStartMs": 309409,
    "dDurationMs": 4284,
    "segs": [ {
      "utf8": "that a decision that felt like extra income quietly costs you"
    } ]
  }, {
    "tStartMs": 313693,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "in three places at once."
    } ]
  }, {
    "tStartMs": 316435,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "Slow down, look at the real numbers for your exact birth year,"
    } ]
  }, {
    "tStartMs": 320618,
    "dDurationMs": 3983,
    "segs": [ {
      "utf8": "and treat this as the single most important financial decision of your"
    } ]
  }, {
    "tStartMs": 324601,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "sixties, because that is exactly what it is."
    } ]
  }, {
    "tStartMs": 328104,
    "dDurationMs": 4184,
    "segs": [ {
      "utf8": "Now let me bring everyone back together, because"
    } ]
  }, {
    "tStartMs": 332288,
    "dDurationMs": 3402,
    "segs": [ {
      "utf8": "there are a few changes this year that do not care what"
    } ]
  }, {
    "tStartMs": 335690,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "decade you were born in, and these are the ones costing people"
    } ]
  }, {
    "tStartMs": 339473,
    "dDurationMs": 621,
    "segs": [ {
      "utf8": "the most."
    } ]
  }, {
    "tStartMs": 340594,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "The first is the one I promised to come back to, and"
    } ]
  }, {
    "tStartMs": 345098,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "it is the end of the paper check."
    } ]
  }, {
    "tStartMs": 348020,
    "dDurationMs": 4744,
    "segs": [ {
      "utf8": "The federal government is moving every benefit payment to electronic, which"
    } ]
  }, {
    "tStartMs": 352764,
    "dDurationMs": 3323,
    "segs": [ {
      "utf8": "means if you still receive a paper Social Security check in the"
    } ]
  }, {
    "tStartMs": 356087,
    "dDurationMs": 3523,
    "segs": [ {
      "utf8": "mail, you need to be set up for direct deposit into a"
    } ]
  }, {
    "tStartMs": 359610,
    "dDurationMs": 4203,
    "segs": [ {
      "utf8": "bank account or onto a government payment card before the change is"
    } ]
  }, {
    "tStartMs": 363813,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "complete."
    } ]
  }, {
    "tStartMs": 364894,
    "dDurationMs": 4323,
    "segs": [ {
      "utf8": "If you do nothing, a payment with nowhere electronic to land is"
    } ]
  }, {
    "tStartMs": 369217,
    "dDurationMs": 3743,
    "segs": [ {
      "utf8": "a payment that does not arrive, and that is a frightening position"
    } ]
  }, {
    "tStartMs": 372960,
    "dDurationMs": 2663,
    "segs": [ {
      "utf8": "to be in over something so avoidable."
    } ]
  }, {
    "tStartMs": 376483,
    "dDurationMs": 2342,
    "segs": [ {
      "utf8": "You have two simple ways to do it."
    } ]
  }, {
    "tStartMs": 379185,
    "dDurationMs": 3863,
    "segs": [ {
      "utf8": "You can have the money sent by direct deposit straight into a"
    } ]
  }, {
    "tStartMs": 383048,
    "dDurationMs": 3463,
    "segs": [ {
      "utf8": "bank or credit union account, or if you do not have a"
    } ]
  }, {
    "tStartMs": 386511,
    "dDurationMs": 3443,
    "segs": [ {
      "utf8": "bank account and do not want one, there is a government payment"
    } ]
  }, {
    "tStartMs": 389954,
    "dDurationMs": 3843,
    "segs": [ {
      "utf8": "card that the money is loaded onto every month, and you can"
    } ]
  }, {
    "tStartMs": 393797,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "use it like any other card."
    } ]
  }, {
    "tStartMs": 396019,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "Either way it is faster and safer than a paper check that"
    } ]
  }, {
    "tStartMs": 399522,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "can be lost or stolen out of a mailbox."
    } ]
  }, {
    "tStartMs": 402404,
    "dDurationMs": 4103,
    "segs": [ {
      "utf8": "One call to Social Security sets it up, and"
    } ]
  }, {
    "tStartMs": 406507,
    "dDurationMs": 4144,
    "segs": [ {
      "utf8": "please listen carefully, because scammers are using this exact change"
    } ]
  }, {
    "tStartMs": 410651,
    "dDurationMs": 1121,
    "segs": [ {
      "utf8": "to trick seniors."
    } ]
  }, {
    "tStartMs": 412552,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "The real Social Security Administration will not call you out of"
    } ]
  }, {
    "tStartMs": 416556,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "nowhere demanding your bank details."
    } ]
  }, {
    "tStartMs": 419678,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "If someone contacts you first and pressures you, hang up."
    } ]
  }, {
    "tStartMs": 423301,
    "dDurationMs": 3623,
    "segs": [ {
      "utf8": "You reach out to them, using only the official number I will"
    } ]
  }, {
    "tStartMs": 426924,
    "dDurationMs": 921,
    "segs": [ {
      "utf8": "put in the description."
    } ]
  }, {
    "tStartMs": 428245,
    "dDurationMs": 4083,
    "segs": [ {
      "utf8": "The second is for the public servants I mentioned earlier, and"
    } ]
  }, {
    "tStartMs": 432328,
    "dDurationMs": 3563,
    "segs": [ {
      "utf8": "it is the biggest piece of unclaimed money in this whole video."
    } ]
  }, {
    "tStartMs": 436512,
    "dDurationMs": 4023,
    "segs": [ {
      "utf8": "There was a law passed that removed two old rules that"
    } ]
  }, {
    "tStartMs": 440535,
    "dDurationMs": 4343,
    "segs": [ {
      "utf8": "for decades had cut or completely erased the Social Security benefits"
    } ]
  }, {
    "tStartMs": 444878,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "of people who also received a government pension, teachers,"
    } ]
  }, {
    "tStartMs": 449502,
    "dDurationMs": 4183,
    "segs": [ {
      "utf8": "firefighters, postal workers, police officers, and many others."
    } ]
  }, {
    "tStartMs": 454266,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "For most people affected, the correction happened automatically, but"
    } ]
  }, {
    "tStartMs": 458329,
    "dDurationMs": 3223,
    "segs": [ {
      "utf8": "for a great many it did not, and there is back pay"
    } ]
  }, {
    "tStartMs": 461552,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "sitting there, in some cases many thousands of dollars, waiting"
    } ]
  }, {
    "tStartMs": 465615,
    "dDurationMs": 2382,
    "segs": [ {
      "utf8": "on people who do not know to go and check."
    } ]
  }, {
    "tStartMs": 467997,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "If you or your spouse worked a public job with a pension"
    } ]
  }, {
    "tStartMs": 472060,
    "dDurationMs": 3863,
    "segs": [ {
      "utf8": "and were ever told your Social Security would be reduced because of"
    } ]
  }, {
    "tStartMs": 475923,
    "dDurationMs": 3563,
    "segs": [ {
      "utf8": "it, this is the single most important phone call you will make"
    } ]
  }, {
    "tStartMs": 479486,
    "dDurationMs": 641,
    "segs": [ {
      "utf8": "this year."
    } ]
  }, {
    "tStartMs": 480687,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "Here is how to know if it is you."
    } ]
  }, {
    "tStartMs": 482929,
    "dDurationMs": 3403,
    "segs": [ {
      "utf8": "Think back to whether you ever received a letter, or were told"
    } ]
  }, {
    "tStartMs": 486332,
    "dDurationMs": 4003,
    "segs": [ {
      "utf8": "when you first applied, that your Social Security benefit was being lowered"
    } ]
  }, {
    "tStartMs": 490335,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "because you also had a pension from a job that did not"
    } ]
  }, {
    "tStartMs": 493337,
    "dDurationMs": 1482,
    "segs": [ {
      "utf8": "pay into Social Security."
    } ]
  }, {
    "tStartMs": 495459,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "If that ever happened to you, or to a husband or wife"
    } ]
  }, {
    "tStartMs": 498522,
    "dDurationMs": 3643,
    "segs": [ {
      "utf8": "who has since passed, then you are very likely owed both a"
    } ]
  }, {
    "tStartMs": 502165,
    "dDurationMs": 3522,
    "segs": [ {
      "utf8": "higher monthly payment going forward and a lump sum of back pay"
    } ]
  }, {
    "tStartMs": 505687,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "for the months you were shortchanged."
    } ]
  }, {
    "tStartMs": 507929,
    "dDurationMs": 2923,
    "segs": [ {
      "utf8": "You do not need to hire anyone or pay a fee to"
    } ]
  }, {
    "tStartMs": 510852,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "claim it."
    } ]
  }, {
    "tStartMs": 511752,
    "dDurationMs": 4304,
    "segs": [ {
      "utf8": "You simply contact Social Security, tell them you believe you were affected"
    } ]
  }, {
    "tStartMs": 516056,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "by the change to those two old rules, and ask them to"
    } ]
  }, {
    "tStartMs": 519398,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "review your record."
    } ]
  }, {
    "tStartMs": 521180,
    "dDurationMs": 4103,
    "segs": [ {
      "utf8": "For some people that one request has been worth tens of thousands"
    } ]
  }, {
    "tStartMs": 525283,
    "dDurationMs": 4164,
    "segs": [ {
      "utf8": "of dollars, and not a penny of it comes automatically if"
    } ]
  }, {
    "tStartMs": 529447,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "your case slipped through."
    } ]
  }, {
    "tStartMs": 531608,
    "dDurationMs": 3323,
    "segs": [ {
      "utf8": "And the third is the new senior deduction I mentioned for the"
    } ]
  }, {
    "tStartMs": 534931,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "nineteen forties group, except it applies to everyone sixty five and"
    } ]
  }, {
    "tStartMs": 538994,
    "dDurationMs": 2222,
    "segs": [ {
      "utf8": "older across all three generations."
    } ]
  }, {
    "tStartMs": 541997,
    "dDurationMs": 3202,
    "segs": [ {
      "utf8": "It is worth up to six thousand dollars for a single person"
    } ]
  }, {
    "tStartMs": 545199,
    "dDurationMs": 3093,
    "segs": [ {
      "utf8": "and twice that for a married couple where both have turned sixty"
    } ]
  }, {
    "tStartMs": 548292,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "five, it stacks on top of the deductions you already"
    } ]
  }, {
    "tStartMs": 552505,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "get, and you do not have to itemize to use it."
    } ]
  }, {
    "tStartMs": 557169,
    "dDurationMs": 3663,
    "segs": [ {
      "utf8": "For a great many seniors living on Social Security and a little"
    } ]
  }, {
    "tStartMs": 560832,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "bit more, stacking these deductions together is the difference"
    } ]
  }, {
    "tStartMs": 564895,
    "dDurationMs": 3683,
    "segs": [ {
      "utf8": "between owing the government money and owing nothing at all."
    } ]
  }, {
    "tStartMs": 568958,
    "dDurationMs": 4144,
    "segs": [ {
      "utf8": "If someone prepares your taxes, the most valuable question you can"
    } ]
  }, {
    "tStartMs": 573102,
    "dDurationMs": 4143,
    "segs": [ {
      "utf8": "ask this year is whether your full age sixty five deductions"
    } ]
  }, {
    "tStartMs": 577245,
    "dDurationMs": 821,
    "segs": [ {
      "utf8": "were applied."
    } ]
  }, {
    "tStartMs": 578786,
    "dDurationMs": 4064,
    "segs": [ {
      "utf8": "And there is a related habit that quietly costs people across all"
    } ]
  }, {
    "tStartMs": 582850,
    "dDurationMs": 4003,
    "segs": [ {
      "utf8": "three of these generations, which is having too much tax withheld"
    } ]
  }, {
    "tStartMs": 586853,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "from your Social Security check every month out of caution, and then"
    } ]
  }, {
    "tStartMs": 590916,
    "dDurationMs": 2542,
    "segs": [ {
      "utf8": "waiting a full year to get it back as a refund."
    } ]
  }, {
    "tStartMs": 594019,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "When you do that, you are handing the government the use of"
    } ]
  }, {
    "tStartMs": 597842,
    "dDurationMs": 4263,
    "segs": [ {
      "utf8": "your money for free, all year long, on a tax you"
    } ]
  }, {
    "tStartMs": 602105,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "may not even owe once these deductions are counted."
    } ]
  }, {
    "tStartMs": 606048,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Look at your real numbers, and if you are overpaying month after"
    } ]
  }, {
    "tStartMs": 610052,
    "dDurationMs": 3983,
    "segs": [ {
      "utf8": "month, you can adjust how much is withheld so that what comes"
    } ]
  }, {
    "tStartMs": 614035,
    "dDurationMs": 4083,
    "segs": [ {
      "utf8": "out matches what you actually owe, and not a single"
    } ]
  }, {
    "tStartMs": 618118,
    "dDurationMs": 721,
    "segs": [ {
      "utf8": "dollar more."
    } ]
  }, {
    "tStartMs": 619539,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "It is your money."
    } ]
  }, {
    "tStartMs": 620920,
    "dDurationMs": 4364,
    "segs": [ {
      "utf8": "It should be working for you, not sitting in a government account"
    } ]
  }, {
    "tStartMs": 625284,
    "dDurationMs": 2362,
    "segs": [ {
      "utf8": "waiting for you to ask for it back."
    } ]
  }, {
    "tStartMs": 628567,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "So let me tie the whole thing together, because the thread running"
    } ]
  }, {
    "tStartMs": 632350,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "through every one of these is the same."
    } ]
  }, {
    "tStartMs": 635372,
    "dDurationMs": 1381,
    "segs": [ {
      "utf8": "The rules changed."
    } ]
  }, {
    "tStartMs": 637334,
    "dDurationMs": 4123,
    "segs": [ {
      "utf8": "Your check, your taxes, the age that counts as full for you,"
    } ]
  }, {
    "tStartMs": 641597,
    "dDurationMs": 3563,
    "segs": [ {
      "utf8": "and the very way your money reaches you, all of it shifted"
    } ]
  }, {
    "tStartMs": 645160,
    "dDurationMs": 3263,
    "segs": [ {
      "utf8": "this year, and not one piece of it came with a letter,"
    } ]
  }, {
    "tStartMs": 648823,
    "dDurationMs": 1661,
    "segs": [ {
      "utf8": "a warning, or a phone call."
    } ]
  }, {
    "tStartMs": 651405,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "The system is built so the changes happen quietly and the money"
    } ]
  }, {
    "tStartMs": 655188,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "stays where it is unless you stand up and claim what is"
    } ]
  }, {
    "tStartMs": 658911,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "yours."
    } ]
  }, {
    "tStartMs": 660152,
    "dDurationMs": 3943,
    "segs": [ {
      "utf8": "The good news is that every single thing I just described is"
    } ]
  }, {
    "tStartMs": 664095,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "something you can act on with one phone call or one question,"
    } ]
  }, {
    "tStartMs": 667458,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "and the only people who lose are the ones who assume it"
    } ]
  }, {
    "tStartMs": 671281,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "does not apply to them."
    } ]
  }, {
    "tStartMs": 672802,
    "dDurationMs": 3343,
    "segs": [ {
      "utf8": "So do one kind thing before you go."
    } ]
  }, {
    "tStartMs": 676145,
    "dDurationMs": 3583,
    "segs": [ {
      "utf8": "Send this video to every person you love who was born in"
    } ]
  }, {
    "tStartMs": 681409,
    "dDurationMs": 4264,
    "segs": [ {
      "utf8": "the nineteen forties, the nineteen fifties, or the nineteen sixties, because every"
    } ]
  }, {
    "tStartMs": 685673,
    "dDurationMs": 2882,
    "segs": [ {
      "utf8": "one of them is in one of these three groups, and the"
    } ]
  }, {
    "tStartMs": 688555,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "odds are very good that at least one of these changes affects"
    } ]
  }, {
    "tStartMs": 691858,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "them right now and nobody has told them."
    } ]
  }, {
    "tStartMs": 694880,
    "dDurationMs": 3143,
    "segs": [ {
      "utf8": "A two minute message from you could protect a check that someone"
    } ]
  }, {
    "tStartMs": 698023,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "depends on for the rest of their life."
    } ]
  }, {
    "tStartMs": 700565,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "That is what this is for, and I will see you in"
    } ]
  }, {
    "tStartMs": 703567,
    "dDurationMs": 561,
    "segs": [ {
      "utf8": "the next one."
    } ]
  } ]
}
