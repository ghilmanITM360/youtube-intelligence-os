{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "Three days ago the government threw away\nevery income limit it had been using"
    } ]
  }, {
    "tStartMs": 5660,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "since last autumn."
    } ]
  }, {
    "tStartMs": 7540,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Every deduction. Every benefit amount."
    } ]
  }, {
    "tStartMs": 11040,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "All of it, replaced overnight."
    } ]
  }, {
    "tStartMs": 14160,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Nobody wrote to tell you. Nobody is\nrequired to."
    } ]
  }, {
    "tStartMs": 18300,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "So a refusal you were handed this spring\nwas worked out with numbers that stopped"
    } ]
  }, {
    "tStartMs": 23060,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "existing on the first of October."
    } ]
  }, {
    "tStartMs": 26220,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Nobody goes back and runs that decision\nagain."
    } ]
  }, {
    "tStartMs": 28740,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "It sits in a file, still saying no,\nagainst figures nobody uses any more."
    } ]
  }, {
    "tStartMs": 35300,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Three things changed that week, and every\none of them moves in your direction"
    } ]
  }, {
    "tStartMs": 39580,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "if there is somebody sixty or over living\nin your house."
    } ]
  }, {
    "tStartMs": 43440,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "They never announce the ones that help."
    } ]
  }, {
    "tStartMs": 45660,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "They announce the ones that take."
    } ]
  }, {
    "tStartMs": 47880,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "The first is an income test they simply do\nnot run on you."
    } ]
  }, {
    "tStartMs": 52220,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "The second is a cost that comes off your\ntotal with no ceiling on it, and you"
    } ]
  }, {
    "tStartMs": 56680,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "are the only household that gets that."
    } ]
  }, {
    "tStartMs": 59140,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "The third is the one limit that did not\nmove at all, and the reason that is"
    } ]
  }, {
    "tStartMs": 63420,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "good news."
    } ]
  }, {
    "tStartMs": 64960,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "None of this is new money. All of it has\nbeen sitting there, and the only thing"
    } ]
  }, {
    "tStartMs": 69360,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "keeping people out is that they decided\nthe answer themselves before anybody"
    } ]
  }, {
    "tStartMs": 73460,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "looked."
    } ]
  }, {
    "tStartMs": 74880,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Number one. They never test your gross pay\nat all, and nobody tells you that."
    } ]
  }, {
    "tStartMs": 80140,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Here is how it works for most households."
    } ]
  }, {
    "tStartMs": 82520,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "There are two income tests. The first\nlooks at everything coming in before"
    } ]
  }, {
    "tStartMs": 86820,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "anything is taken off. The second looks at\nwhat is left after certain costs"
    } ]
  }, {
    "tStartMs": 91280,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "are subtracted. A normal household has to\npass both."
    } ]
  }, {
    "tStartMs": 95480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Yours does not."
    } ]
  }, {
    "tStartMs": 96980,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "That first test is not applied."
    } ]
  }, {
    "tStartMs": 99060,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "It is skipped entirely. Only the second\none counts, and the second one is the"
    } ]
  }, {
    "tStartMs": 103800,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "one measured after your costs come off."
    } ]
  }, {
    "tStartMs": 106620,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "The number that stops most people is the\nbig one."
    } ]
  }, {
    "tStartMs": 109980,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It is the number at the top of the page."
    } ]
  }, {
    "tStartMs": 112580,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The one that looks like a wage."
    } ]
  }, {
    "tStartMs": 114900,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Somebody reads it out loud and says that\nis too much, we would never qualify."
    } ]
  }, {
    "tStartMs": 120580,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "That number is not the test for you."
    } ]
  }, {
    "tStartMs": 123120,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "It was never the test for you."
    } ]
  }, {
    "tStartMs": 125120,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "And here is where it costs real money."
    } ]
  }, {
    "tStartMs": 127880,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "People do not apply. They sit at a kitchen\ntable with a bank statement."
    } ]
  }, {
    "tStartMs": 132320,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "They look at the top line. They compare it\nagainst a figure they half remember"
    } ]
  }, {
    "tStartMs": 136260,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "from two winters ago, and they decide."
    } ]
  }, {
    "tStartMs": 139240,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "No form filled in. No call made."
    } ]
  }, {
    "tStartMs": 141920,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "The decision is made in the kitchen by a\nperson who has not read the rule,"
    } ]
  }, {
    "tStartMs": 146420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "and it is made against the wrong number."
    } ]
  }, {
    "tStartMs": 149240,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "I want to be plain about who this catches,\nbecause it is not who you would"
    } ]
  }, {
    "tStartMs": 153620,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "think. It is not the person who cannot be\nbothered."
    } ]
  }, {
    "tStartMs": 156880,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "It is the careful one. It is the woman who\nhas never taken a thing she was"
    } ]
  }, {
    "tStartMs": 160980,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "not owed. She would rather go without than\nask for something that turns out"
    } ]
  }, {
    "tStartMs": 164480,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "not to be hers. She is the one who looks\nat that top line and rules herself"
    } ]
  }, {
    "tStartMs": 169040,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "out, and she is the one the rule was\nwritten for."
    } ]
  }, {
    "tStartMs": 172800,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The office does not want your opinion of\nyour own income."
    } ]
  }, {
    "tStartMs": 176220,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Deciding is the job they are paid to do."
    } ]
  }, {
    "tStartMs": 178680,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "That is the whole of the work."
    } ]
  }, {
    "tStartMs": 180500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "So the instruction for this one is small\nand it does not cost anything."
    } ]
  }, {
    "tStartMs": 185280,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Put in the application. Do not lead with\nwhat you earn."
    } ]
  }, {
    "tStartMs": 188780,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Do not explain your figures on the\ntelephone before anybody has asked."
    } ]
  }, {
    "tStartMs": 192880,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Say that you want to apply, and let them\ndo the arithmetic they are employed"
    } ]
  }, {
    "tStartMs": 196580,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "to do."
    } ]
  }, {
    "tStartMs": 197800,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "There is one more thing about that first\ntest worth knowing."
    } ]
  }, {
    "tStartMs": 200540,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It is not a kindness and it is not a\nspecial case."
    } ]
  }, {
    "tStartMs": 203900,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "It is written into the law itself, and it\nhas been there for decades, for one"
    } ]
  }, {
    "tStartMs": 208560,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "reason. A person of seventy living on a\nfixed amount has costs a working household"
    } ]
  }, {
    "tStartMs": 213340,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "does not, and whoever wrote the rule\nunderstood that."
    } ]
  }, {
    "tStartMs": 216860,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "So when somebody tells you that you earn\ntoo much, ask them which test they"
    } ]
  }, {
    "tStartMs": 220600,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "are talking about. Most of the time they\ncannot tell you, because they are"
    } ]
  }, {
    "tStartMs": 224120,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "repeating what somebody told them."
    } ]
  }, {
    "tStartMs": 226540,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Number two. Your housing costs come off\nwith no ceiling."
    } ]
  }, {
    "tStartMs": 230960,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Everybody else has one. This is the one\nalmost nobody has heard of, and it"
    } ]
  }, {
    "tStartMs": 235060,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "is worth the most. What you pay to keep a\nroof over you counts."
    } ]
  }, {
    "tStartMs": 239380,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "The rent or the mortgage payment."
    } ]
  }, {
    "tStartMs": 241380,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The property tax. The insurance."
    } ]
  }, {
    "tStartMs": 243580,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "The heat, the power, the water, the Trash."
    } ]
  }, {
    "tStartMs": 246360,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Add all of it together. Now take half of\nwhat comes in each month."
    } ]
  }, {
    "tStartMs": 250240,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Anything you spend on the roof above that\nhalf comes off your total before"
    } ]
  }, {
    "tStartMs": 253820,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "they judge you."
    } ]
  }, {
    "tStartMs": 255360,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "For most households there is a ceiling on\nthat."
    } ]
  }, {
    "tStartMs": 258220,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Seven hundred and sixty nine dollars, and\nthat is a new number as of the first"
    } ]
  }, {
    "tStartMs": 261740,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "of October. It used to be seven hundred\nand forty four."
    } ]
  }, {
    "tStartMs": 265560,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "In your house, with somebody sixty or over\nunder the roof, there is no ceiling"
    } ]
  }, {
    "tStartMs": 270060,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "at all. Hear that twice. No ceiling."
    } ]
  }, {
    "tStartMs": 273140,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Not a higher one. None at all."
    } ]
  }, {
    "tStartMs": 275320,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "This is the only place in the whole\nprogram where a cost comes off without"
    } ]
  }, {
    "tStartMs": 278640,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "a limit on it, and it exists for one\nreason."
    } ]
  }, {
    "tStartMs": 282300,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Older people spend a larger share of what\nthey have on the house and on keeping"
    } ]
  }, {
    "tStartMs": 286360,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "it warm, and somebody wrote that into the\nrules."
    } ]
  }, {
    "tStartMs": 289660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Then nobody told anybody."
    } ]
  }, {
    "tStartMs": 292280,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Think about what that does to a real\nhousehold."
    } ]
  }, {
    "tStartMs": 295180,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "A woman of seventy four with a house that\nis paid for still owes the tax on"
    } ]
  }, {
    "tStartMs": 299440,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "it, the insurance on it, and the cost of\nheating it."
    } ]
  }, {
    "tStartMs": 302360,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "In a cold state that can run to hundreds\nof dollars a month before a single"
    } ]
  }, {
    "tStartMs": 306160,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "item of food is bought. Every dollar of\nthat above half her income comes off"
    } ]
  }, {
    "tStartMs": 310380,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "the figure they judge her on. She has no\nidea."
    } ]
  }, {
    "tStartMs": 313720,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "She thinks the house being paid off counts\nagainst her."
    } ]
  }, {
    "tStartMs": 316980,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "And notice the shape of this, because it\nis the shape of everything in this"
    } ]
  }, {
    "tStartMs": 320360,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "video. The rule is generous. The rule is\nwritten down."
    } ]
  }, {
    "tStartMs": 324200,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "The rule is old. What is missing is\nanybody telling the people it was written"
    } ]
  }, {
    "tStartMs": 328140,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "for."
    } ]
  }, {
    "tStartMs": 329260,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "If you have never had these costs counted,\nthat is not because you failed a"
    } ]
  }, {
    "tStartMs": 332860,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "test. It is because nobody added them up."
    } ]
  }, {
    "tStartMs": 336260,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Write them down on one sheet of paper\nbefore you telephone anybody."
    } ]
  }, {
    "tStartMs": 339600,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Rent or mortgage. Tax. Insurance."
    } ]
  }, {
    "tStartMs": 342360,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Heat. Power. Water. Trash. The total on\nthat sheet is the number that matters,"
    } ]
  }, {
    "tStartMs": 346360,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "and it is a number most people have never\nworked out in their lives."
    } ]
  }, {
    "tStartMs": 350180,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "And there is a second half to this that\nnobody mentions."
    } ]
  }, {
    "tStartMs": 353580,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "If you live in a place where the heating\nbill triples in January, that January"
    } ]
  }, {
    "tStartMs": 357520,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "bill counts. Not an average. Not a guess."
    } ]
  }, {
    "tStartMs": 360860,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "What you actually paid. A person who\napplies in July and a person who applies"
    } ]
  }, {
    "tStartMs": 365160,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "in January can be judged on very different\nfigures, from the same house, on"
    } ]
  }, {
    "tStartMs": 369300,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "the same income. Almost nobody is told\nthat either."
    } ]
  }, {
    "tStartMs": 372620,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Number three. Every limit moved on the\nfirst except the one that helps you."
    } ]
  }, {
    "tStartMs": 377000,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "On the first of October almost every\nfigure in this system went up."
    } ]
  }, {
    "tStartMs": 380600,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "That is what the first of October is."
    } ]
  }, {
    "tStartMs": 382600,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "The ceilings moved, the deductions moved,\nthe amounts moved."
    } ]
  }, {
    "tStartMs": 386340,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "One thing did not move, and it is the one\nyou want held still."
    } ]
  }, {
    "tStartMs": 390780,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Medical costs above thirty five dollars a\nmonth come off your total."
    } ]
  }, {
    "tStartMs": 395840,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "Thirty five. That floor has not moved,\nwhile everything standing around it"
    } ]
  }, {
    "tStartMs": 400680,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "has."
    } ]
  }, {
    "tStartMs": 401860,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Understand how low thirty five dollars is."
    } ]
  }, {
    "tStartMs": 405020,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "It is not a serious illness. It is not a\nhospital stay."
    } ]
  }, {
    "tStartMs": 409440,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "It is what you already spend without\nthinking about it."
    } ]
  }, {
    "tStartMs": 413040,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "The pills on repeat. The trip to the\ndoctor and the trip home."
    } ]
  }, {
    "tStartMs": 417260,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "The dentist. The glasses. The hearing aid\nbatteries."
    } ]
  }, {
    "tStartMs": 420840,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "The things you buy off the shelf every\nmonth."
    } ]
  }, {
    "tStartMs": 423740,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "The bandages and the ointment and the\npills you take for your knees."
    } ]
  }, {
    "tStartMs": 427760,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Almost every person over sixty spends more\nthan thirty five dollars a month"
    } ]
  }, {
    "tStartMs": 431960,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "on health without ever calling it a\nmedical expense."
    } ]
  }, {
    "tStartMs": 435680,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "It is just what life costs. And every\ndollar above that first thirty five comes"
    } ]
  }, {
    "tStartMs": 441320,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "off the number they judge you on."
    } ]
  }, {
    "tStartMs": 443260,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "There is a second figure here and it is\nthe one that stops people cold."
    } ]
  }, {
    "tStartMs": 447080,
    "dDurationMs": 4228,
    "segs": [ {
      "utf8": "The amount you are allowed to keep in\nsavings went up to four thousand seven"
    } ]
  }, {
    "tStartMs": 451308,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "hundred and fifty dollars."
    } ]
  }, {
    "tStartMs": 453400,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "People believe money in the bank ends it\nright there."
    } ]
  }, {
    "tStartMs": 456660,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "They have three thousand dollars put aside\nfor a funeral or a roof or a grandchild,"
    } ]
  }, {
    "tStartMs": 461220,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "and they think that rules them out before\nthey start."
    } ]
  }, {
    "tStartMs": 464040,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "It does not. And in a good many states\nthat test is not run at all any more,"
    } ]
  }, {
    "tStartMs": 468600,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "so the whole worry was never real."
    } ]
  }, {
    "tStartMs": 471500,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "That is the third refusal people hand\nthemselves."
    } ]
  }, {
    "tStartMs": 474420,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Not the income. Not the housing."
    } ]
  }, {
    "tStartMs": 476320,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "The small amount of money they have been\ncareful enough to save."
    } ]
  }, {
    "tStartMs": 480020,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Now I want to be straight with you about\nsomething, because I am not going"
    } ]
  }, {
    "tStartMs": 483260,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "to tell you anything I cannot stand\nbehind."
    } ]
  }, {
    "tStartMs": 485860,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "I cannot tell you your own figures."
    } ]
  }, {
    "tStartMs": 488280,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "Every state runs this differently."
    } ]
  }, {
    "tStartMs": 490440,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Some states dropped the savings test\ncompletely and some did not."
    } ]
  }, {
    "tStartMs": 494440,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Some count things others ignore."
    } ]
  }, {
    "tStartMs": 496480,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "The numbers I have given you are the\nfederal ones that changed on the first"
    } ]
  }, {
    "tStartMs": 499800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "of October, and your state builds on top\nof them."
    } ]
  }, {
    "tStartMs": 502980,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "So do not take my word for whether you\nqualify."
    } ]
  }, {
    "tStartMs": 505420,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "Take my word for this instead."
    } ]
  }, {
    "tStartMs": 508080,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "The person who decides is not you, and the\ndecision you made at your own kitchen"
    } ]
  }, {
    "tStartMs": 512400,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "table three years ago was made against\nnumbers that no longer exist."
    } ]
  }, {
    "tStartMs": 516960,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So. Three things, and what each one does."
    } ]
  }, {
    "tStartMs": 519980,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "They never look at your pay before costs\ncome off."
    } ]
  }, {
    "tStartMs": 522580,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "So the big number on the top line was\nnever the one that counted."
    } ]
  }, {
    "tStartMs": 526360,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Your housing costs above half your income\ncome off with nothing capping them,"
    } ]
  }, {
    "tStartMs": 530600,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "which is true for no other kind of home."
    } ]
  }, {
    "tStartMs": 533200,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "And the medical floor held at thirty five\ndollars while every other limit rose,"
    } ]
  }, {
    "tStartMs": 537640,
    "dDurationMs": 2851,
    "segs": [ {
      "utf8": "with money in the bank allowed up to\nnearly five thousand."
    } ]
  }, {
    "tStartMs": 541140,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "None of that is hidden. It is published."
    } ]
  }, {
    "tStartMs": 543660,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "It has been published for years."
    } ]
  }, {
    "tStartMs": 545860,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "It works badly for older people only\nbecause every one of those offices is"
    } ]
  }, {
    "tStartMs": 549920,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "built to answer a question, and not one of\nthem is built to ask."
    } ]
  }, {
    "tStartMs": 553980,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "One last thing, and hold on to it for the\nnext few weeks."
    } ]
  }, {
    "tStartMs": 557500,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Nobody legitimate telephones you about\nthis."
    } ]
  }, {
    "tStartMs": 560220,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "If a call offers to check your benefits,\nor to file for you for a fee, or asks"
    } ]
  }, {
    "tStartMs": 565920,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "for your card number to confirm anything,\nthat is a fraud."
    } ]
  }, {
    "tStartMs": 569600,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Applying is free. The help is free."
    } ]
  }, {
    "tStartMs": 572360,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "The only people who charge you are the\nones who should not be calling."
    } ]
  }, {
    "tStartMs": 576340,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "And if somebody in your family was refused\nthis year, do not ask them how much"
    } ]
  }, {
    "tStartMs": 580520,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "they earn. Ask them one thing."
    } ]
  }, {
    "tStartMs": 583060,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "What month were you turned down?"
    } ]
  } ]
}
