{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4962,
    "segs": [ {
      "utf8": "There is a single day that can quietly\ntake away nearly everything you have"
    } ]
  }, {
    "tStartMs": 4962,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "worked for, and it is not the day you die."
    } ]
  }, {
    "tStartMs": 8303,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "It is the day you can no longer manage\nyour own money."
    } ]
  }, {
    "tStartMs": 11784,
    "dDurationMs": 6243,
    "segs": [ {
      "utf8": "A stroke. A bad fall. The slow fog of\nmemory that far too many families"
    } ]
  }, {
    "tStartMs": 18027,
    "dDurationMs": 5962,
    "segs": [ {
      "utf8": "come to know. In a single moment, you are\nstill alive, your savings are still"
    } ]
  }, {
    "tStartMs": 23989,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "sitting in the bank with your own name on\nthe account, and yet the people who"
    } ]
  }, {
    "tStartMs": 28410,
    "dDurationMs": 4982,
    "segs": [ {
      "utf8": "love you most, your husband, your wife,\nyour own children, may not be able"
    } ]
  }, {
    "tStartMs": 33392,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "to touch a single dollar of it to help\nyou."
    } ]
  }, {
    "tStartMs": 36233,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "Not to pay your bills. Not to keep your\nhome."
    } ]
  }, {
    "tStartMs": 39334,
    "dDurationMs": 4962,
    "segs": [ {
      "utf8": "Not even to care for you. And here is the\npart that shocks families the most,"
    } ]
  }, {
    "tStartMs": 44596,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "and the reason I am making this video."
    } ]
  }, {
    "tStartMs": 47277,
    "dDurationMs": 4202,
    "segs": [ {
      "utf8": "Even the families who did everything\nright, who sat down and signed the legal"
    } ]
  }, {
    "tStartMs": 51479,
    "dDurationMs": 4761,
    "segs": [ {
      "utf8": "papers years ago, often walk into the bank\nand find the door slammed in their"
    } ]
  }, {
    "tStartMs": 56240,
    "dDurationMs": 5562,
    "segs": [ {
      "utf8": "face anyway. Let me explain how this\nhappens, because almost nobody sees it"
    } ]
  }, {
    "tStartMs": 61802,
    "dDurationMs": 2381,
    "segs": [ {
      "utf8": "coming until it is far too late."
    } ]
  }, {
    "tStartMs": 64823,
    "dDurationMs": 4602,
    "segs": [ {
      "utf8": "The money in your bank account belongs to\nyou, and only to you."
    } ]
  }, {
    "tStartMs": 70125,
    "dDurationMs": 5162,
    "segs": [ {
      "utf8": "That sounds so obvious it is hardly worth\nsaying, but it carries a hard edge"
    } ]
  }, {
    "tStartMs": 75287,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "that people never stop to think about."
    } ]
  }, {
    "tStartMs": 78348,
    "dDurationMs": 4382,
    "segs": [ {
      "utf8": "It means that in the eyes of the law, no\none else on this earth has the right"
    } ]
  }, {
    "tStartMs": 82730,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "to touch that account but you."
    } ]
  }, {
    "tStartMs": 85571,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "Not the wife you have been married to for\nfifty years."
    } ]
  }, {
    "tStartMs": 88972,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "Not the son who drives you to every doctor\nvisit."
    } ]
  }, {
    "tStartMs": 92113,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "To the bank, they are strangers to that\naccount."
    } ]
  }, {
    "tStartMs": 95575,
    "dDurationMs": 4381,
    "segs": [ {
      "utf8": "As long as you are healthy and can walk in\nand sign your own name, none of"
    } ]
  }, {
    "tStartMs": 99956,
    "dDurationMs": 5762,
    "segs": [ {
      "utf8": "this ever matters. But the day you cannot,\nthe day you are lying in a hospital"
    } ]
  }, {
    "tStartMs": 105718,
    "dDurationMs": 5502,
    "segs": [ {
      "utf8": "bed unable to speak, or sitting at home no\nlonger able to make sense of a bank"
    } ]
  }, {
    "tStartMs": 111220,
    "dDurationMs": 3842,
    "segs": [ {
      "utf8": "statement, that account simply freezes in\nplace."
    } ]
  }, {
    "tStartMs": 115962,
    "dDurationMs": 4822,
    "segs": [ {
      "utf8": "A few automatic payments may keep going\nfor a little while, but no one can"
    } ]
  }, {
    "tStartMs": 120784,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "step in."
    } ]
  }, {
    "tStartMs": 122124,
    "dDurationMs": 2501,
    "segs": [ {
      "utf8": "No one can move money to cover a new bill."
    } ]
  }, {
    "tStartMs": 125325,
    "dDurationMs": 4062,
    "segs": [ {
      "utf8": "No one can do the hundred small things\nthat keeping a life running quietly"
    } ]
  }, {
    "tStartMs": 129387,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "requires."
    } ]
  }, {
    "tStartMs": 131067,
    "dDurationMs": 4862,
    "segs": [ {
      "utf8": "Your money is right there, with your name\non it, and it might as well be locked"
    } ]
  }, {
    "tStartMs": 135929,
    "dDurationMs": 2121,
    "segs": [ {
      "utf8": "in a vault at the bottom of the sea."
    } ]
  }, {
    "tStartMs": 138830,
    "dDurationMs": 3882,
    "segs": [ {
      "utf8": "And think for a moment about everything\nthat does not stop just because you"
    } ]
  }, {
    "tStartMs": 142712,
    "dDurationMs": 4121,
    "segs": [ {
      "utf8": "can no longer sign your name. The mortgage\nor the rent is still due."
    } ]
  }, {
    "tStartMs": 147393,
    "dDurationMs": 2381,
    "segs": [ {
      "utf8": "The electric bill and the water bill keep\narriving."
    } ]
  }, {
    "tStartMs": 150334,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "The property tax does not wait."
    } ]
  }, {
    "tStartMs": 152615,
    "dDurationMs": 3301,
    "segs": [ {
      "utf8": "The insurance must be paid or it quietly\nlapses."
    } ]
  }, {
    "tStartMs": 156036,
    "dDurationMs": 6183,
    "segs": [ {
      "utf8": "And on top of all of it, there is now the\nenormous cost of your care, the aide,"
    } ]
  }, {
    "tStartMs": 162219,
    "dDurationMs": 4041,
    "segs": [ {
      "utf8": "the medicine, the hospital, all of it\nlanding at once."
    } ]
  }, {
    "tStartMs": 166840,
    "dDurationMs": 4222,
    "segs": [ {
      "utf8": "Your family stands there watching these\nbills stack up on the kitchen table,"
    } ]
  }, {
    "tStartMs": 171342,
    "dDurationMs": 4342,
    "segs": [ {
      "utf8": "knowing full well there is more than\nenough money in your account to cover"
    } ]
  }, {
    "tStartMs": 175684,
    "dDurationMs": 5362,
    "segs": [ {
      "utf8": "every last one of them, and being told,\nagain and again, that they are not"
    } ]
  }, {
    "tStartMs": 181046,
    "dDurationMs": 3741,
    "segs": [ {
      "utf8": "allowed to touch it. That is not a small\ninconvenience."
    } ]
  }, {
    "tStartMs": 185287,
    "dDurationMs": 4662,
    "segs": [ {
      "utf8": "That is a family being pushed toward ruin\nwhile sitting right on top of a fortune"
    } ]
  }, {
    "tStartMs": 189949,
    "dDurationMs": 6002,
    "segs": [ {
      "utf8": "they cannot reach. Now, you may be\nthinking, that is exactly what a power of"
    } ]
  }, {
    "tStartMs": 195951,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "attorney is for. And you would be right."
    } ]
  }, {
    "tStartMs": 199052,
    "dDurationMs": 4642,
    "segs": [ {
      "utf8": "A power of attorney is a simple legal\npaper in which you name a person you"
    } ]
  }, {
    "tStartMs": 203694,
    "dDurationMs": 5222,
    "segs": [ {
      "utf8": "trust, usually your spouse or one of your\nchildren, and you give them the authority"
    } ]
  }, {
    "tStartMs": 208916,
    "dDurationMs": 4641,
    "segs": [ {
      "utf8": "to handle your money for you if the day\never comes that you no longer can."
    } ]
  }, {
    "tStartMs": 214158,
    "dDurationMs": 4401,
    "segs": [ {
      "utf8": "It is one of the most important pieces of\npaper an older person can ever have."
    } ]
  }, {
    "tStartMs": 218859,
    "dDurationMs": 4642,
    "segs": [ {
      "utf8": "But here is the cruel surprise that\ncatches so many well prepared families"
    } ]
  }, {
    "tStartMs": 223501,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "completely off guard."
    } ]
  }, {
    "tStartMs": 225702,
    "dDurationMs": 5382,
    "segs": [ {
      "utf8": "The bank can still refuse it. It happens\nevery single day in this country."
    } ]
  }, {
    "tStartMs": 231404,
    "dDurationMs": 5822,
    "segs": [ {
      "utf8": "A frightened, grieving family walks into\nthe branch holding a valid power of"
    } ]
  }, {
    "tStartMs": 237226,
    "dDurationMs": 4622,
    "segs": [ {
      "utf8": "attorney that a lawyer drew up years ago,\nand the bank looks at it and says"
    } ]
  }, {
    "tStartMs": 241848,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "no."
    } ]
  }, {
    "tStartMs": 243408,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "Sometimes they claim it is too old."
    } ]
  }, {
    "tStartMs": 246389,
    "dDurationMs": 4042,
    "segs": [ {
      "utf8": "Sometimes they insist you must use the\nspecial in house form the bank keeps"
    } ]
  }, {
    "tStartMs": 250431,
    "dDurationMs": 5442,
    "segs": [ {
      "utf8": "behind the counter, the one you can no\nlonger sign because by now you are already"
    } ]
  }, {
    "tStartMs": 255873,
    "dDurationMs": 5222,
    "segs": [ {
      "utf8": "too ill to hold the pen. And sometimes,\nbecause banks have grown so afraid"
    } ]
  }, {
    "tStartMs": 261095,
    "dDurationMs": 4061,
    "segs": [ {
      "utf8": "of elder fraud, they simply refuse to\ntrust the document at all."
    } ]
  }, {
    "tStartMs": 265996,
    "dDurationMs": 4402,
    "segs": [ {
      "utf8": "But the very worst kind is something\ncalled a springing power of attorney."
    } ]
  }, {
    "tStartMs": 271258,
    "dDurationMs": 4242,
    "segs": [ {
      "utf8": "That is one written so that it only\nsprings to life once a doctor certifies,"
    } ]
  }, {
    "tStartMs": 275500,
    "dDurationMs": 3441,
    "segs": [ {
      "utf8": "in writing, that you can no longer manage\nyour own affairs."
    } ]
  }, {
    "tStartMs": 279921,
    "dDurationMs": 3622,
    "segs": [ {
      "utf8": "It sounds careful and wise. It is a trap."
    } ]
  }, {
    "tStartMs": 283983,
    "dDurationMs": 4902,
    "segs": [ {
      "utf8": "Because now your family has to track down\na doctor willing to put that certification"
    } ]
  }, {
    "tStartMs": 288885,
    "dDurationMs": 4341,
    "segs": [ {
      "utf8": "on paper, fight through medical privacy\nlaws that block them from even speaking"
    } ]
  }, {
    "tStartMs": 293226,
    "dDurationMs": 4562,
    "segs": [ {
      "utf8": "to that doctor, and then pray the bank\naccepts it once they are finally done."
    } ]
  }, {
    "tStartMs": 298448,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "Weeks slip by. Bills go unpaid."
    } ]
  }, {
    "tStartMs": 301609,
    "dDurationMs": 3702,
    "segs": [ {
      "utf8": "And the whole time, your money sits there,\nuntouchable."
    } ]
  }, {
    "tStartMs": 305631,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "And this is not some rare misfortune that\nonly strikes careless people."
    } ]
  }, {
    "tStartMs": 309832,
    "dDurationMs": 3882,
    "segs": [ {
      "utf8": "It happens constantly, to the most careful\nfamilies there are."
    } ]
  }, {
    "tStartMs": 313914,
    "dDurationMs": 2581,
    "segs": [ {
      "utf8": "People who planned. People who paid a\nlawyer."
    } ]
  }, {
    "tStartMs": 316495,
    "dDurationMs": 4701,
    "segs": [ {
      "utf8": "People who did every single thing they\nwere ever told to do, and still found"
    } ]
  }, {
    "tStartMs": 321196,
    "dDurationMs": 4422,
    "segs": [ {
      "utf8": "that the paperwork alone was not the\nfinish line, because no one had ever warned"
    } ]
  }, {
    "tStartMs": 325618,
    "dDurationMs": 4862,
    "segs": [ {
      "utf8": "them that the real test is getting the\nbank to actually honor it when the day"
    } ]
  }, {
    "tStartMs": 330480,
    "dDurationMs": 5181,
    "segs": [ {
      "utf8": "finally comes. So what happens to a family\nthat gets that door slammed in their"
    } ]
  }, {
    "tStartMs": 335661,
    "dDurationMs": 341,
    "segs": [ {
      "utf8": "face?"
    } ]
  }, {
    "tStartMs": 336802,
    "dDurationMs": 5222,
    "segs": [ {
      "utf8": "They are forced down the one road nobody\never wants to travel, and it is called"
    } ]
  }, {
    "tStartMs": 342024,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "guardianship, or in some states,\nconservatorship."
    } ]
  }, {
    "tStartMs": 346145,
    "dDurationMs": 5442,
    "segs": [ {
      "utf8": "It means going to court, hiring a lawyer,\nand standing before a judge to ask"
    } ]
  }, {
    "tStartMs": 351587,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "for the legal right to manage the money of\nthe person you love."
    } ]
  }, {
    "tStartMs": 355889,
    "dDurationMs": 5602,
    "segs": [ {
      "utf8": "It is slow, often dragging on for months\nwhile the unpaid bills pile higher"
    } ]
  }, {
    "tStartMs": 361491,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "and higher."
    } ]
  }, {
    "tStartMs": 362871,
    "dDurationMs": 1061,
    "segs": [ {
      "utf8": "It is expensive,"
    } ]
  }, {
    "tStartMs": 364632,
    "dDurationMs": 4342,
    "segs": [ {
      "utf8": "frequently costing thousands of dollars,\nmoney that comes straight out of the"
    } ]
  }, {
    "tStartMs": 368974,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "very savings you were all trying to\nprotect."
    } ]
  }, {
    "tStartMs": 371655,
    "dDurationMs": 4901,
    "segs": [ {
      "utf8": "And it strips away dignity in a way that\nis hard to describe until you have"
    } ]
  }, {
    "tStartMs": 376556,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "watched it happen to someone you love."
    } ]
  }, {
    "tStartMs": 379217,
    "dDurationMs": 5122,
    "segs": [ {
      "utf8": "A judge, a complete stranger who has never\nmet your family, now sits in charge"
    } ]
  }, {
    "tStartMs": 384339,
    "dDurationMs": 4802,
    "segs": [ {
      "utf8": "of your money. In some cases the court\nhands control to a professional guardian,"
    } ]
  }, {
    "tStartMs": 389801,
    "dDurationMs": 4602,
    "segs": [ {
      "utf8": "another stranger entirely, who charges\nfees to manage your life and answers"
    } ]
  }, {
    "tStartMs": 394403,
    "dDurationMs": 5362,
    "segs": [ {
      "utf8": "to no one but the court. The quiet dignity\nof handling your own affairs, and"
    } ]
  }, {
    "tStartMs": 399765,
    "dDurationMs": 4361,
    "segs": [ {
      "utf8": "of having your family gently handle them\nfor you when you no longer can, is"
    } ]
  }, {
    "tStartMs": 404126,
    "dDurationMs": 4202,
    "segs": [ {
      "utf8": "simply gone, traded for hearings and forms\nand permission slips."
    } ]
  }, {
    "tStartMs": 409028,
    "dDurationMs": 5002,
    "segs": [ {
      "utf8": "And all of it, every bit of that heartache\nand every dollar of that cost, just"
    } ]
  }, {
    "tStartMs": 414030,
    "dDurationMs": 4622,
    "segs": [ {
      "utf8": "to reach money that was yours the entire\ntime, sitting in an account with your"
    } ]
  }, {
    "tStartMs": 418652,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "own name printed right on the front."
    } ]
  }, {
    "tStartMs": 421212,
    "dDurationMs": 4362,
    "segs": [ {
      "utf8": "And it does not simply end when the judge\nfinally signs the order."
    } ]
  }, {
    "tStartMs": 426194,
    "dDurationMs": 5342,
    "segs": [ {
      "utf8": "In many states, the guardian must return\nto that court year after year, filing"
    } ]
  }, {
    "tStartMs": 431536,
    "dDurationMs": 5182,
    "segs": [ {
      "utf8": "reports, asking permission for the larger\nexpenses, accounting for every dollar"
    } ]
  }, {
    "tStartMs": 436718,
    "dDurationMs": 4742,
    "segs": [ {
      "utf8": "spent, as though your whole lifetime of\ncareful saving had suddenly fallen"
    } ]
  }, {
    "tStartMs": 441460,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "under suspicion."
    } ]
  }, {
    "tStartMs": 443200,
    "dDurationMs": 4602,
    "segs": [ {
      "utf8": "A choice as ordinary as selling a car, or\nmoving you into a better care home,"
    } ]
  }, {
    "tStartMs": 447802,
    "dDurationMs": 4002,
    "segs": [ {
      "utf8": "can now require a hearing, a lawyer, and\nweeks of waiting."
    } ]
  }, {
    "tStartMs": 452484,
    "dDurationMs": 4161,
    "segs": [ {
      "utf8": "Your spouse, the one person who knew your\nwishes better than anyone alive,"
    } ]
  }, {
    "tStartMs": 456645,
    "dDurationMs": 4242,
    "segs": [ {
      "utf8": "is reduced to filling out forms and hoping\na stranger agrees."
    } ]
  }, {
    "tStartMs": 461587,
    "dDurationMs": 4802,
    "segs": [ {
      "utf8": "It is a slow and grinding indignity, and\nthe cruelest part of all is that it"
    } ]
  }, {
    "tStartMs": 466389,
    "dDurationMs": 2381,
    "segs": [ {
      "utf8": "was almost always completely avoidable."
    } ]
  }, {
    "tStartMs": 469050,
    "dDurationMs": 4741,
    "segs": [ {
      "utf8": "Now here is the good news, and there is a\ngreat deal of it, because nearly"
    } ]
  }, {
    "tStartMs": 473791,
    "dDurationMs": 4382,
    "segs": [ {
      "utf8": "every part of this nightmare can be\nprevented with a little bit of paperwork"
    } ]
  }, {
    "tStartMs": 478173,
    "dDurationMs": 4982,
    "segs": [ {
      "utf8": "done ahead of time, while you are still\nwell, and it costs almost nothing."
    } ]
  }, {
    "tStartMs": 483835,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "Let me tell you exactly what to do."
    } ]
  }, {
    "tStartMs": 485796,
    "dDurationMs": 5582,
    "segs": [ {
      "utf8": "First, have a proper durable power of\nattorney drawn up, and hold on tight"
    } ]
  }, {
    "tStartMs": 491378,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "to that one word, durable."
    } ]
  }, {
    "tStartMs": 494239,
    "dDurationMs": 4562,
    "segs": [ {
      "utf8": "A durable power of attorney is one that\nstays in full effect even after you"
    } ]
  }, {
    "tStartMs": 498801,
    "dDurationMs": 4341,
    "segs": [ {
      "utf8": "become unable to manage things yourself,\nwhich is the entire point of having"
    } ]
  }, {
    "tStartMs": 503142,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "it."
    } ]
  }, {
    "tStartMs": 504363,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "And do not use the springing kind that\nwaits on a signed note from a doctor."
    } ]
  }, {
    "tStartMs": 508964,
    "dDurationMs": 4682,
    "segs": [ {
      "utf8": "Have it written so that the person you\ntrust can use it the moment they truly"
    } ]
  }, {
    "tStartMs": 513646,
    "dDurationMs": 5782,
    "segs": [ {
      "utf8": "need to. Second, and this is the step that\nalmost everybody misses, take that"
    } ]
  }, {
    "tStartMs": 519428,
    "dDurationMs": 5142,
    "segs": [ {
      "utf8": "power of attorney down to your bank now,\ntoday, while you are healthy, and"
    } ]
  }, {
    "tStartMs": 524570,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "ask them to accept it and keep it on file."
    } ]
  }, {
    "tStartMs": 527971,
    "dDurationMs": 4142,
    "segs": [ {
      "utf8": "A great many banks will also want you to\nfill out their own in house form,"
    } ]
  }, {
    "tStartMs": 532493,
    "dDurationMs": 4621,
    "segs": [ {
      "utf8": "so sit down and do that too, while your\nhand is still steady enough to sign"
    } ]
  }, {
    "tStartMs": 537114,
    "dDurationMs": 441,
    "segs": [ {
      "utf8": "it."
    } ]
  }, {
    "tStartMs": 538375,
    "dDurationMs": 4742,
    "segs": [ {
      "utf8": "Getting the bank to bless the paperwork\ntoday is what guarantees there is no"
    } ]
  }, {
    "tStartMs": 543117,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "locked door tomorrow."
    } ]
  }, {
    "tStartMs": 545517,
    "dDurationMs": 5162,
    "segs": [ {
      "utf8": "Third, ask your bank about naming what\nthey call a trusted contact, a person"
    } ]
  }, {
    "tStartMs": 550679,
    "dDurationMs": 4002,
    "segs": [ {
      "utf8": "they are allowed to reach out to if\nsomething ever looks wrong on your account."
    } ]
  }, {
    "tStartMs": 555361,
    "dDurationMs": 5122,
    "segs": [ {
      "utf8": "It adds one more quiet layer of\nprotection, against both fraud and a freeze."
    } ]
  }, {
    "tStartMs": 560863,
    "dDurationMs": 4982,
    "segs": [ {
      "utf8": "And fourth, keep every one of these papers\ncurrent, because a document that"
    } ]
  }, {
    "tStartMs": 565845,
    "dDurationMs": 5142,
    "segs": [ {
      "utf8": "is twenty years old is exactly the kind a\nnervous bank loves to reject."
    } ]
  }, {
    "tStartMs": 571967,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "And if your savings or your home are worth\na real amount,"
    } ]
  }, {
    "tStartMs": 575708,
    "dDurationMs": 4482,
    "segs": [ {
      "utf8": "it is worth sitting down just once with a\nlawyer who works with older families,"
    } ]
  }, {
    "tStartMs": 580690,
    "dDurationMs": 4882,
    "segs": [ {
      "utf8": "the kind sometimes called an elder law\nattorney, who can make sure the paperwork"
    } ]
  }, {
    "tStartMs": 585572,
    "dDurationMs": 5042,
    "segs": [ {
      "utf8": "is written in a way your own bank and your\nown state will honor without a fight."
    } ]
  }, {
    "tStartMs": 590934,
    "dDurationMs": 5222,
    "segs": [ {
      "utf8": "It costs far less than most people fear,\nand it is a tiny fraction of what"
    } ]
  }, {
    "tStartMs": 596156,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "a guardianship would later cost the people\nyou love."
    } ]
  }, {
    "tStartMs": 599577,
    "dDurationMs": 4862,
    "segs": [ {
      "utf8": "And understand this clearly. None of these\nsteps asks you to give up a single"
    } ]
  }, {
    "tStartMs": 604439,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "ounce of control today."
    } ]
  }, {
    "tStartMs": 606419,
    "dDurationMs": 3502,
    "segs": [ {
      "utf8": "You still run your own money, exactly as\nyou always have."
    } ]
  }, {
    "tStartMs": 610381,
    "dDurationMs": 4442,
    "segs": [ {
      "utf8": "All you are doing is making certain that\non the day you no longer can, the"
    } ]
  }, {
    "tStartMs": 614823,
    "dDurationMs": 4601,
    "segs": [ {
      "utf8": "right person can step in gently, without\never having to beg a judge for permission."
    } ]
  }, {
    "tStartMs": 619784,
    "dDurationMs": 5302,
    "segs": [ {
      "utf8": "This is general information to help you\nknow what to ask for, and it is not"
    } ]
  }, {
    "tStartMs": 625086,
    "dDurationMs": 5202,
    "segs": [ {
      "utf8": "legal advice, because the exact rules are\na little different in every state."
    } ]
  }, {
    "tStartMs": 631549,
    "dDurationMs": 3821,
    "segs": [ {
      "utf8": "So here is the truth of it, laid out\nplainly."
    } ]
  }, {
    "tStartMs": 635970,
    "dDurationMs": 5302,
    "segs": [ {
      "utf8": "This is one of the very few dangers in\nyour whole life that costs almost nothing"
    } ]
  }, {
    "tStartMs": 641272,
    "dDurationMs": 3862,
    "segs": [ {
      "utf8": "to prevent, and very nearly everything to\nignore."
    } ]
  }, {
    "tStartMs": 645994,
    "dDurationMs": 5402,
    "segs": [ {
      "utf8": "One quiet afternoon with the right form,\nwhile you are well and clear headed,"
    } ]
  }, {
    "tStartMs": 651836,
    "dDurationMs": 4722,
    "segs": [ {
      "utf8": "is all that stands between your family\nstepping in to help you the moment you"
    } ]
  }, {
    "tStartMs": 656558,
    "dDurationMs": 5522,
    "segs": [ {
      "utf8": "need them, and your family standing\nhelpless at a bank counter while your own"
    } ]
  }, {
    "tStartMs": 662080,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "money sits just out of their reach."
    } ]
  }, {
    "tStartMs": 665441,
    "dDurationMs": 2911,
    "segs": [ {
      "utf8": "So do not leave this one for someday."
    } ]
  }, {
    "tStartMs": 668352,
    "dDurationMs": 2951,
    "segs": [ {
      "utf8": "Someday is the exact thing that takes it\naway."
    } ]
  }, {
    "tStartMs": 671743,
    "dDurationMs": 5022,
    "segs": [ {
      "utf8": "Handle it now, while it is still easy,\nwhile the choice is still yours to make."
    } ]
  }, {
    "tStartMs": 677125,
    "dDurationMs": 4702,
    "segs": [ {
      "utf8": "Do it, and you will have handed the people\nyou love the one thing that matters"
    } ]
  }, {
    "tStartMs": 681827,
    "dDurationMs": 2561,
    "segs": [ {
      "utf8": "far more than any dollar in that account."
    } ]
  }, {
    "tStartMs": 685148,
    "dDurationMs": 3641,
    "segs": [ {
      "utf8": "The power to help you, on the day you\nfinally need them most."
    } ]
  } ]
}
