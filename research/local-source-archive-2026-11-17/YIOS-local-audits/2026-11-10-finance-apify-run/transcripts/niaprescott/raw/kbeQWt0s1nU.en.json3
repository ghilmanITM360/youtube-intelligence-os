{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "The thirtieth of October is not a\ndeadline."
    } ]
  }, {
    "tStartMs": 4140,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Nothing closes on that day. No office"
    } ]
  }, {
    "tStartMs": 6480,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "shuts a door, no form stops being\naccepted,"
    } ]
  }, {
    "tStartMs": 9440,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "and nothing is taken out of your account."
    } ]
  }, {
    "tStartMs": 12180,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "If somebody told you to move your money\nbefore the thirtieth, ask them to name"
    } ]
  }, {
    "tStartMs": 16160,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "the rule. There is no rule."
    } ]
  }, {
    "tStartMs": 18900,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "I will give you the date they should have\ngiven you instead, and it sits in"
    } ]
  }, {
    "tStartMs": 22700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "December."
    } ]
  }, {
    "tStartMs": 23980,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "Here is what is true. Six real dates land\nbetween now and the first of January."
    } ]
  }, {
    "tStartMs": 29920,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Every one of them has a number attached to\nit."
    } ]
  }, {
    "tStartMs": 32600,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "And not one of them arrives with a letter\nwarning you that it is about to close."
    } ]
  }, {
    "tStartMs": 36800,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The first one is 23 days away."
    } ]
  }, {
    "tStartMs": 39500,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Miss it and you wait three extra weeks to\nfind out what your own check will"
    } ]
  }, {
    "tStartMs": 43060,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "be. Two questions always come first, so I\nwill deal with them before item one."
    } ]
  }, {
    "tStartMs": 48360,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Does this depend on where I live."
    } ]
  }, {
    "tStartMs": 50240,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "No. All six are exactly the same in every\nstate."
    } ]
  }, {
    "tStartMs": 53580,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Same in Texas, same in Ohio, same in\nCalifornia."
    } ]
  }, {
    "tStartMs": 58140,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Not one of them goes through a county\noffice or a state office."
    } ]
  }, {
    "tStartMs": 61840,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Do you have to be poor. No. Not one of\nthese six asks what you earn, what you"
    } ]
  }, {
    "tStartMs": 66720,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "have saved, or what your house is worth."
    } ]
  }, {
    "tStartMs": 68760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "There is no income line anywhere in this\nvideo."
    } ]
  }, {
    "tStartMs": 72020,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Four of the six ask something of you, and\nthree of those four take under 15 minutes"
    } ]
  }, {
    "tStartMs": 76340,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "at your own kitchen table. The other two\nland whether you act or not, and the"
    } ]
  }, {
    "tStartMs": 80920,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "only thing you can do is know the number\nbefore it arrives."
    } ]
  }, {
    "tStartMs": 84620,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Every figure in this video comes from\nSocial Security, from Medicare, or from"
    } ]
  }, {
    "tStartMs": 89040,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "the law that set it. What I cannot see is\nyour plan and your paperwork, and"
    } ]
  }, {
    "tStartMs": 94200,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "those two decide your own amount."
    } ]
  }, {
    "tStartMs": 96660,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Number one. November eighteenth."
    } ]
  }, {
    "tStartMs": 99000,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "The notice that comes early. Your raise\nfor next year is 3.6%."
    } ]
  }, {
    "tStartMs": 104480,
    "dDurationMs": 5940,
    "segs": [ {
      "utf8": "For the average retired worker that moves\nthe check from $2,095 a month to"
    } ]
  }, {
    "tStartMs": 110420,
    "dDurationMs": 1328,
    "segs": [ {
      "utf8": "$2,170."
    } ]
  }, {
    "tStartMs": 115060,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "$75 more."
    } ]
  }, {
    "tStartMs": 117180,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Almost 72 million people are getting it."
    } ]
  }, {
    "tStartMs": 120060,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "That part is settled."
    } ]
  }, {
    "tStartMs": 121840,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Nobody can take it and you do not apply\nfor it."
    } ]
  }, {
    "tStartMs": 125200,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "What is not settled is when you find out\nyour own number."
    } ]
  }, {
    "tStartMs": 128600,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "Not the average. Yours. Social Security\nhas set one date for that, and almost"
    } ]
  }, {
    "tStartMs": 134120,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "nobody has heard it. If you have an\naccount at my Social Security, and you"
    } ]
  }, {
    "tStartMs": 138760,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "have told them you want your notices\nwithout paper, your own figure appears"
    } ]
  }, {
    "tStartMs": 142600,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "in your message center in late November."
    } ]
  }, {
    "tStartMs": 145220,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "If you have not, your notice comes by post\nin December."
    } ]
  }, {
    "tStartMs": 150080,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "Three weeks apart. Same money, same raise,\nthree weeks of not knowing."
    } ]
  }, {
    "tStartMs": 155160,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And the cut off to be on the early side is\nthe eighteenth of November."
    } ]
  }, {
    "tStartMs": 159160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Why that matters more than three weeks of\nwaiting."
    } ]
  }, {
    "tStartMs": 162840,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Your December and January bills are being\nset right now."
    } ]
  }, {
    "tStartMs": 166500,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "The plan premium, the heating, the\ninsurance that renews in January."
    } ]
  }, {
    "tStartMs": 170700,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "If you know your real figure in late\nNovember you are deciding with the true"
    } ]
  }, {
    "tStartMs": 174640,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "number in front of you. If you wait for\nthe post you are guessing through the"
    } ]
  }, {
    "tStartMs": 178400,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "most expensive six weeks of the year, and\nthen correcting in January."
    } ]
  }, {
    "tStartMs": 183280,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "So this week, go to my Social Security and\nopen an account if you do not have"
    } ]
  }, {
    "tStartMs": 187620,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "one. It is free and it takes about 10\nminutes."
    } ]
  }, {
    "tStartMs": 191180,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Then find the setting for paperless\nnotices and switch it on."
    } ]
  }, {
    "tStartMs": 194620,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "That is the whole job. If you already have\nan account, do not assume you are"
    } ]
  }, {
    "tStartMs": 198620,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "covered. Having the account and choosing\npaperless are two separate switches,"
    } ]
  }, {
    "tStartMs": 203280,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "and most people only ever did the first\none."
    } ]
  }, {
    "tStartMs": 206000,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Log in and check the second."
    } ]
  }, {
    "tStartMs": 208140,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Number two. December seventh. Your plan\nlocks for the whole year."
    } ]
  }, {
    "tStartMs": 212700,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The window to change your Medicare drug\nplan or your Medicare Advantage plan"
    } ]
  }, {
    "tStartMs": 216380,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "is open right now. The seventh of December\nis the last day it stays open."
    } ]
  }, {
    "tStartMs": 221520,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Whatever you are holding on the eighth,\nyou carry all the way to next December."
    } ]
  }, {
    "tStartMs": 225480,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Here is the part that costs people real\nmoney, and it has nothing to do with"
    } ]
  }, {
    "tStartMs": 229260,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "whether you like your plan. Your plan is\nallowed to change its own list of"
    } ]
  }, {
    "tStartMs": 232880,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "covered medicines every January."
    } ]
  }, {
    "tStartMs": 234860,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Not with your permission and not with a\nphone call to you."
    } ]
  }, {
    "tStartMs": 238140,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "The medicine that cost you a small copay\nthis year can sit outside the list"
    } ]
  }, {
    "tStartMs": 241840,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "in January, at full price, and the first\nyou hear of it is at the counter in"
    } ]
  }, {
    "tStartMs": 246180,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "the chemist. That is the trap in plain\nterms."
    } ]
  }, {
    "tStartMs": 249160,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "People check whether they are happy with\ntheir plan."
    } ]
  }, {
    "tStartMs": 251620,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "The question is not whether you are happy."
    } ]
  }, {
    "tStartMs": 253580,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "The question is whether the plan still\ncovers your medicines next year, because"
    } ]
  }, {
    "tStartMs": 257360,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "that is the thing that moved. So the job\nis one visit to medicare.gov, to the"
    } ]
  }, {
    "tStartMs": 262460,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "tool that compares plans, with your actual\nmedicines typed in."
    } ]
  }, {
    "tStartMs": 266620,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Every one of them, by name. Or one call to\nthe number on the back of your card"
    } ]
  }, {
    "tStartMs": 270880,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "and the words, is every medicine on my\nlist still covered next year, and what"
    } ]
  }, {
    "tStartMs": 275060,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "will each one cost me. If the answer is\nyes, you do nothing and you are done."
    } ]
  }, {
    "tStartMs": 279620,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "If the answer is no, you switch before the\nseventh, and the new plan starts"
    } ]
  }, {
    "tStartMs": 283720,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "on the first of January. And if you want\nsomebody to sit with you through it"
    } ]
  }, {
    "tStartMs": 287240,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "at no charge and with nothing to sell you,\nevery state has a free advice service"
    } ]
  }, {
    "tStartMs": 291660,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "for exactly this."
    } ]
  }, {
    "tStartMs": 293540,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Ask Medicare for the free counselling\nservice in your state."
    } ]
  }, {
    "tStartMs": 296720,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "They do not sell plans. That is the point\nof them."
    } ]
  }, {
    "tStartMs": 300100,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Number three. The Part B number nobody\nactually has yet."
    } ]
  }, {
    "tStartMs": 303260,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "$202.90 comes out of your Social Security\nevery month before the money reaches"
    } ]
  }, {
    "tStartMs": 308960,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "you. That is the Medicare Part B premium\nfor this year."
    } ]
  }, {
    "tStartMs": 313120,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "It is not a bill you receive. It is\nalready gone when the deposit lands."
    } ]
  }, {
    "tStartMs": 317520,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Now listen to this carefully, because it\nis the single most repeated mistake"
    } ]
  }, {
    "tStartMs": 321200,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "in every video about your raise."
    } ]
  }, {
    "tStartMs": 323720,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "The figure for next year has not been\nannounced."
    } ]
  }, {
    "tStartMs": 326080,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Not by anybody. The people who publish it\nnormally do it in November."
    } ]
  }, {
    "tStartMs": 330660,
    "dDurationMs": 6287,
    "segs": [ {
      "utf8": "Today it does not exist. The best public\nestimate is around $209.50,"
    } ]
  }, {
    "tStartMs": 336987,
    "dDurationMs": 3193,
    "segs": [ {
      "utf8": "and that estimate comes from the official\nprojection, not from a decision."
    } ]
  }, {
    "tStartMs": 340960,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So when somebody tells you with confidence\nwhat your Part B premium will be"
    } ]
  }, {
    "tStartMs": 344620,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "in January, they are reading a forecast\nand calling it a fact."
    } ]
  }, {
    "tStartMs": 349220,
    "dDurationMs": 4710,
    "segs": [ {
      "utf8": "I have watched a video this month that put\nthe figure at $29.50."
    } ]
  }, {
    "tStartMs": 353970,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "That is not a smaller number. That is the\nreal number with a digit dropped,"
    } ]
  }, {
    "tStartMs": 357900,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "and the whole video was built on it."
    } ]
  }, {
    "tStartMs": 360520,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Why you should care about an unannounced\nnumber."
    } ]
  }, {
    "tStartMs": 362960,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Because it comes out of your raise before\nyou see your raise."
    } ]
  }, {
    "tStartMs": 366560,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "$75 arrives, the premium takes its share\nfirst, and the figure that actually"
    } ]
  }, {
    "tStartMs": 371160,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "lands in your account is the one after\nthat subtraction."
    } ]
  }, {
    "tStartMs": 374380,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Until the real premium is published,\nnobody can tell you your January deposit."
    } ]
  }, {
    "tStartMs": 378940,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Including me. So here is the only honest\ninstruction."
    } ]
  }, {
    "tStartMs": 382540,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "When your own notice appears, late\nNovember if you did item one, December if"
    } ]
  }, {
    "tStartMs": 386780,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "you did not, read the line for the premium\nand the line for the net payment,"
    } ]
  }, {
    "tStartMs": 390480,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "and compare both against this year line by\nline."
    } ]
  }, {
    "tStartMs": 393820,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Not the percentage. The two lines."
    } ]
  }, {
    "tStartMs": 396700,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "One thing that has been announced."
    } ]
  }, {
    "tStartMs": 398460,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "A one off payment of $90 towards the Part\nB premium is going to more than 20 million"
    } ]
  }, {
    "tStartMs": 403160,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "people on Medicare. About 40 million\nothers are not getting it."
    } ]
  }, {
    "tStartMs": 406920,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "If nothing has appeared, you are very\nlikely in the second group, and there"
    } ]
  }, {
    "tStartMs": 410760,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "is no form to fill in and no appeal to\nmake."
    } ]
  }, {
    "tStartMs": 413840,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Check your deposits, then stop looking."
    } ]
  }, {
    "tStartMs": 416640,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Number four. January to March."
    } ]
  }, {
    "tStartMs": 419460,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "The second window. Now the one that is\ngood news, and the one I almost never"
    } ]
  }, {
    "tStartMs": 424740,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "see covered. If January goes badly, you\nare not locked in until next October."
    } ]
  }, {
    "tStartMs": 430820,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "If you are on a Medicare Advantage plan,\nyou get a second window from the first"
    } ]
  }, {
    "tStartMs": 435840,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "of January to the thirty first of March."
    } ]
  }, {
    "tStartMs": 438720,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "One change. You can move to a different\nAdvantage plan, or you can leave and"
    } ]
  }, {
    "tStartMs": 443400,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "go back to Original Medicare."
    } ]
  }, {
    "tStartMs": 445640,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "That exists because the people who wrote\nthe rules knew that January is when"
    } ]
  }, {
    "tStartMs": 450040,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "you discover what your plan actually does."
    } ]
  }, {
    "tStartMs": 453020,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Three limits, and I will say them plainly\nso nobody is caught out."
    } ]
  }, {
    "tStartMs": 457280,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "It is one change, not several."
    } ]
  }, {
    "tStartMs": 459400,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "It only applies if you are already on an\nAdvantage plan, so if you are on Original"
    } ]
  }, {
    "tStartMs": 463720,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Medicare this window is not yours."
    } ]
  }, {
    "tStartMs": 466100,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "And if you use it to go back to Original\nMedicare, you have to pick up a separate"
    } ]
  }, {
    "tStartMs": 470400,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "medicine plan at the same time, or you\nwill have no cover for medicines at"
    } ]
  }, {
    "tStartMs": 474660,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "all. Your change starts on the first day\nof the month after the plan receives"
    } ]
  }, {
    "tStartMs": 478940,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "it. So a change made in January starts in\nFebruary."
    } ]
  }, {
    "tStartMs": 483420,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "What to do with this. Nothing today."
    } ]
  }, {
    "tStartMs": 486220,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Write the thirty first of March on a piece\nof paper and keep it with your plan"
    } ]
  }, {
    "tStartMs": 489840,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "card. If something goes wrong in January,\nyou take that paper out and you ring"
    } ]
  }, {
    "tStartMs": 494980,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "the plan or you ring Medicare."
    } ]
  }, {
    "tStartMs": 497340,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Most people in that situation believe they\nhave to live with it for a year."
    } ]
  }, {
    "tStartMs": 501220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "They do not."
    } ]
  }, {
    "tStartMs": 502720,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Number five. December thirty first."
    } ]
  }, {
    "tStartMs": 505300,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "One form, 4 minutes. The amount of tax\nheld back from your Social Security"
    } ]
  }, {
    "tStartMs": 509760,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "check every month was set on the day you\nfirst asked for it."
    } ]
  }, {
    "tStartMs": 513780,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "If you have never asked for any to be held\nback, nothing is being held back."
    } ]
  }, {
    "tStartMs": 518220,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Either way, that decision is probably out\nof date."
    } ]
  }, {
    "tStartMs": 521100,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Your income changed this year."
    } ]
  }, {
    "tStartMs": 523060,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "It changes for most people every year."
    } ]
  }, {
    "tStartMs": 525520,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "If too little is being held back, you get\na bill in the spring that you did"
    } ]
  }, {
    "tStartMs": 528880,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "not plan for, in the same months the\nheating bill is at its highest."
    } ]
  }, {
    "tStartMs": 532880,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "If too much is being held back, you have\nbeen lending money to the government"
    } ]
  }, {
    "tStartMs": 536500,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "at no interest for twelve months, and you\nget it back slowly, long after you"
    } ]
  }, {
    "tStartMs": 541640,
    "dDurationMs": 4227,
    "segs": [ {
      "utf8": "needed it. The form that fixes both is\ncalled W-4V."
    } ]
  }, {
    "tStartMs": 545907,
    "dDurationMs": 4113,
    "segs": [ {
      "utf8": "You can file it at any time, and you can\nfile it again later to change your"
    } ]
  }, {
    "tStartMs": 550020,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "mind or to stop it completely."
    } ]
  }, {
    "tStartMs": 551800,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "You are not choosing an amount."
    } ]
  }, {
    "tStartMs": 553780,
    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "You choose one of four percentages, and\nthey are seven, ten, twelve and 22 percent"
    } ]
  }, {
    "tStartMs": 559780,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "of each payment. No other figure is\nallowed, so do not spend an evening trying"
    } ]
  }, {
    "tStartMs": 564220,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "to work out a custom number. The deadline\nhere is not a rule, it is arithmetic."
    } ]
  }, {
    "tStartMs": 569700,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "The tax year closes on the thirty first of\nDecember, so a correction filed"
    } ]
  }, {
    "tStartMs": 573680,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "in November or early December still\nreaches most of this year."
    } ]
  }, {
    "tStartMs": 577480,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "One filed in February reaches none of it."
    } ]
  }, {
    "tStartMs": 580440,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "The paper version goes to your local\nSocial Security office, not to the tax"
    } ]
  }, {
    "tStartMs": 584500,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "office. Or you can ask for the change by\ntelephone or on the website, which"
    } ]
  }, {
    "tStartMs": 588440,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "is faster. The whole job is one page and 4\nminutes."
    } ]
  }, {
    "tStartMs": 592780,
    "dDurationMs": 2527,
    "segs": [ {
      "utf8": "Number six. December eleventh."
    } ]
  }, {
    "tStartMs": 595347,
    "dDurationMs": 3913,
    "segs": [ {
      "utf8": "The real next date. This is the date that\nshould have been in every video you"
    } ]
  }, {
    "tStartMs": 599260,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "watched about the thirtieth of October."
    } ]
  }, {
    "tStartMs": 601600,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "The law that is keeping the federal\ngovernment funded runs out on the eleventh"
    } ]
  }, {
    "tStartMs": 605660,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "of December. That is not a forecast."
    } ]
  }, {
    "tStartMs": 607780,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "It was signed at the start of September\nand the date was written into it."
    } ]
  }, {
    "tStartMs": 612940,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Now the part you need, because the fear\naround this is sold hard and it is"
    } ]
  }, {
    "tStartMs": 617140,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "sold wrong. Your Social Security payment\nis not funded by that law."
    } ]
  }, {
    "tStartMs": 621660,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It does not stop on the twelfth of\nDecember."
    } ]
  }, {
    "tStartMs": 624160,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "It did not stop the last time, it has not\nstopped in any previous one, and"
    } ]
  }, {
    "tStartMs": 629080,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "nobody has to pass anything for your\ndeposit to arrive."
    } ]
  }, {
    "tStartMs": 632960,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "The same is true of your Medicare cover."
    } ]
  }, {
    "tStartMs": 634840,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "What does slow down is service."
    } ]
  }, {
    "tStartMs": 637460,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Offices, telephone lines, new"
    } ]
  }, {
    "tStartMs": 639380,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "applications, appeals, replacement cards,\nthe"
    } ]
  }, {
    "tStartMs": 642340,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "paperwork that needs a person at a desk to\nmove it."
    } ]
  }, {
    "tStartMs": 645080,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Which turns the eleventh of December into\nthe real reason to finish items one,"
    } ]
  }, {
    "tStartMs": 649700,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "two and five this month rather than next."
    } ]
  }, {
    "tStartMs": 653140,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Every one of those three needs a working\noffice or a working helpline."
    } ]
  }, {
    "tStartMs": 657180,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "In the first week of December those lines\nare at their busiest in the year"
    } ]
  }, {
    "tStartMs": 660780,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "anyway, and that is before you add any\ndisruption on top."
    } ]
  }, {
    "tStartMs": 664540,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "So that is the calendar. The eighteenth of\nNovember for your own figure."
    } ]
  }, {
    "tStartMs": 668640,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "The seventh of December for your plan."
    } ]
  }, {
    "tStartMs": 670880,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "The thirty first of December for the form."
    } ]
  }, {
    "tStartMs": 673320,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "The eleventh of December for the waiting\nline."
    } ]
  }, {
    "tStartMs": 675800,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "January to March if January goes wrong."
    } ]
  }, {
    "tStartMs": 678220,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "And the Part B figure, which nobody can\ngive you yet and which decides what"
    } ]
  }, {
    "tStartMs": 682680,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "actually lands. Not one of those six is\nthe thirtieth of October."
    } ]
  }, {
    "tStartMs": 687200,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Two of the six happen with no help from\nyou."
    } ]
  }, {
    "tStartMs": 689620,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "Your raise lands, and the Part B premium\ntakes its share."
    } ]
  }, {
    "tStartMs": 693480,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Four of them need you, and three of those\nfour are shorter than this video."
    } ]
  }, {
    "tStartMs": 697560,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "If you only do one thing this week, open\nmy Social Security and turn on paperless"
    } ]
  }, {
    "tStartMs": 702300,
    "dDurationMs": 2310,
    "segs": [ {
      "utf8": "notices before the eighteenth."
    } ]
  }, {
    "tStartMs": 704650,
    "dDurationMs": 4070,
    "segs": [ {
      "utf8": "It is free, it is 10 minutes, and it is\nthe difference between knowing your"
    } ]
  }, {
    "tStartMs": 708720,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "own number in November and finding it out\nafter Christmas."
    } ]
  }, {
    "tStartMs": 712520,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "This is education and not advice about\nyour own position."
    } ]
  }, {
    "tStartMs": 717660,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Your plan, your income and your paperwork\ndecide your own answer."
    } ]
  }, {
    "tStartMs": 722640,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "And if your mother or your father is\nliving on this money alone, do not forward"
    } ]
  }, {
    "tStartMs": 727460,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "them this video. Sit down beside them and\nopen the account together."
    } ]
  } ]
}
