{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5221,
    "segs": [ {
      "utf8": "The government is quietly cutting the one\nkind of help that lets millions of"
    } ]
  }, {
    "tStartMs": 5221,
    "dDurationMs": 6201,
    "segs": [ {
      "utf8": "older Americans stay in their own homes\ninstead of being moved into a nursing"
    } ]
  }, {
    "tStartMs": 12202,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Not with a headline."
    } ]
  }, {
    "tStartMs": 14442,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "Not with a warning in the mail."
    } ]
  }, {
    "tStartMs": 18123,
    "dDurationMs": 6161,
    "segs": [ {
      "utf8": "Quietly, buried deep inside a law that\nalmost no one ever sat down and"
    } ]
  }, {
    "tStartMs": 24284,
    "dDurationMs": 5751,
    "segs": [ {
      "utf8": "read. And it is counting on one thing\nabove all else, that you will not find"
    } ]
  }, {
    "tStartMs": 30035,
    "dDurationMs": 6031,
    "segs": [ {
      "utf8": "out until the very day you reach for that\nhelp"
    } ]
  }, {
    "tStartMs": 36066,
    "dDurationMs": 4461,
    "segs": [ {
      "utf8": "and discover how much of it has already\ndisappeared."
    } ]
  }, {
    "tStartMs": 40827,
    "dDurationMs": 6781,
    "segs": [ {
      "utf8": "I am glad you are here today, because this\nis exactly the sort of thing that"
    } ]
  }, {
    "tStartMs": 48668,
    "dDurationMs": 4781,
    "segs": [ {
      "utf8": "stays hidden until it is too late to act\non it."
    } ]
  }, {
    "tStartMs": 53449,
    "dDurationMs": 6061,
    "segs": [ {
      "utf8": "So give me the next few minutes, and I\nwill walk you through the three"
    } ]
  }, {
    "tStartMs": 59510,
    "dDurationMs": 6101,
    "segs": [ {
      "utf8": "ways these cuts can reach your home and\nyour care, and the"
    } ]
  }, {
    "tStartMs": 65611,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "free steps that stop each one of them\ncold."
    } ]
  }, {
    "tStartMs": 70172,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "Almost no one is telling seniors any of\nthis."
    } ]
  }, {
    "tStartMs": 73253,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "So let me tell you plainly what has\nhappened."
    } ]
  }, {
    "tStartMs": 75853,
    "dDurationMs": 5481,
    "segs": [ {
      "utf8": "A large budget law was passed in twenty\ntwenty five, and buried deep inside"
    } ]
  }, {
    "tStartMs": 81334,
    "dDurationMs": 5201,
    "segs": [ {
      "utf8": "it is the biggest cut to Medicaid in the\nentire history of the program, close"
    } ]
  }, {
    "tStartMs": 86535,
    "dDurationMs": 4161,
    "segs": [ {
      "utf8": "to a trillion dollars pulled back out over\nthe next ten years."
    } ]
  }, {
    "tStartMs": 91476,
    "dDurationMs": 4561,
    "segs": [ {
      "utf8": "Now you may be thinking that Medicaid is\nonly for the very poor, and that none"
    } ]
  }, {
    "tStartMs": 96037,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "of this has anything to do with you."
    } ]
  }, {
    "tStartMs": 98017,
    "dDurationMs": 4461,
    "segs": [ {
      "utf8": "Please do not make that mistake, because\nit is the most expensive mistake in"
    } ]
  }, {
    "tStartMs": 102478,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "this whole story. Medicaid is the single"
    } ]
  }, {
    "tStartMs": 107138,
    "dDurationMs": 4981,
    "segs": [ {
      "utf8": "largest payer of long term care in this\nentire country."
    } ]
  }, {
    "tStartMs": 112659,
    "dDurationMs": 4681,
    "segs": [ {
      "utf8": "It is what pays for the nursing home, and\nfor the helper who comes to the house,"
    } ]
  }, {
    "tStartMs": 117660,
    "dDurationMs": 4561,
    "segs": [ {
      "utf8": "for millions of ordinary middle class\nseniors who simply lived long enough"
    } ]
  }, {
    "tStartMs": 122221,
    "dDurationMs": 4861,
    "segs": [ {
      "utf8": "to need care and watched their life\nsavings drain away paying for it first."
    } ]
  }, {
    "tStartMs": 127202,
    "dDurationMs": 6461,
    "segs": [ {
      "utf8": "And there is a secret at the very heart of\nthis that catches almost everyone,"
    } ]
  }, {
    "tStartMs": 134143,
    "dDurationMs": 4221,
    "segs": [ {
      "utf8": "so let me say it as plainly as I can.\nMedicare,"
    } ]
  }, {
    "tStartMs": 139084,
    "dDurationMs": 6661,
    "segs": [ {
      "utf8": "the program you paid into out of every\npaycheck your whole working life, does"
    } ]
  }, {
    "tStartMs": 145745,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "not pay for long term care."
    } ]
  }, {
    "tStartMs": 148766,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "It will cover a short stay to get back on\nyour feet after a hospital visit,"
    } ]
  }, {
    "tStartMs": 154047,
    "dDurationMs": 6321,
    "segs": [ {
      "utf8": "but it does not pay for the months, or the\nyears, of daily help that so"
    } ]
  }, {
    "tStartMs": 160368,
    "dDurationMs": 4961,
    "segs": [ {
      "utf8": "many people come to need near the end of\ntheir lives, whether that help is"
    } ]
  }, {
    "tStartMs": 165329,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "in a nursing home or in your own kitchen."
    } ]
  }, {
    "tStartMs": 168789,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "Most people only discover this at the very\nworst moment, standing in a hallway,"
    } ]
  }, {
    "tStartMs": 172890,
    "dDurationMs": 4341,
    "segs": [ {
      "utf8": "being told that the care their husband or\ntheir mother needs will cost many"
    } ]
  }, {
    "tStartMs": 177231,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "thousands of dollars every single month,\nout of their own pocket, until the"
    } ]
  }, {
    "tStartMs": 182311,
    "dDurationMs": 4781,
    "segs": [ {
      "utf8": "money is gone. And when the money is gone,\nthe program that finally steps in"
    } ]
  }, {
    "tStartMs": 187092,
    "dDurationMs": 4481,
    "segs": [ {
      "utf8": "is Medicaid. That is why this reaches you\neven if you have never needed it"
    } ]
  }, {
    "tStartMs": 191573,
    "dDurationMs": 5221,
    "segs": [ {
      "utf8": "in your life. Medicaid is the safety net\nstretched underneath every middle"
    } ]
  }, {
    "tStartMs": 196794,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "class family that lives long enough."
    } ]
  }, {
    "tStartMs": 199054,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "And that safety net is exactly what they\nare quietly cutting."
    } ]
  }, {
    "tStartMs": 202695,
    "dDurationMs": 5241,
    "segs": [ {
      "utf8": "Here is the first way the cut reaches you,\nand it is the cruelest of the three."
    } ]
  }, {
    "tStartMs": 208896,
    "dDurationMs": 4821,
    "segs": [ {
      "utf8": "When a state suddenly has less money for\nMedicaid, it does not usually cancel"
    } ]
  }, {
    "tStartMs": 213717,
    "dDurationMs": 5721,
    "segs": [ {
      "utf8": "the whole program at once. It trims around\nthe edges first, and it starts with"
    } ]
  }, {
    "tStartMs": 219438,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "what the rules politely call optional\nservices."
    } ]
  }, {
    "tStartMs": 223899,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "And here is the quiet tragedy folded\ninside that one word,"
    } ]
  }, {
    "tStartMs": 228219,
    "dDurationMs": 5621,
    "segs": [ {
      "utf8": "optional. The care that comes to your own\nhome, the aide who helps you bathe"
    } ]
  }, {
    "tStartMs": 233840,
    "dDurationMs": 4961,
    "segs": [ {
      "utf8": "and dress and cook so that you can stay in\nthe house you raised your family"
    } ]
  }, {
    "tStartMs": 238801,
    "dDurationMs": 5121,
    "segs": [ {
      "utf8": "in, that home care is very often counted\nas optional."
    } ]
  }, {
    "tStartMs": 244242,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "The nursing home is treated as required."
    } ]
  }, {
    "tStartMs": 247083,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Your home care is treated as optional."
    } ]
  }, {
    "tStartMs": 250563,
    "dDurationMs": 4301,
    "segs": [ {
      "utf8": "So when the cuts come down the line, the\nhelp that keeps you out of a nursing"
    } ]
  }, {
    "tStartMs": 254864,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "home is the very first thing on the\nchopping block."
    } ]
  }, {
    "tStartMs": 257364,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "Think hard about what that truly means."
    } ]
  }, {
    "tStartMs": 260305,
    "dDurationMs": 5761,
    "segs": [ {
      "utf8": "A single cut, written on a page in a state\nbudget office, can quietly become"
    } ]
  }, {
    "tStartMs": 266066,
    "dDurationMs": 5401,
    "segs": [ {
      "utf8": "the reason an older person is moved out of\ntheir own home and into a facility,"
    } ]
  }, {
    "tStartMs": 272007,
    "dDurationMs": 4741,
    "segs": [ {
      "utf8": "not because their health got any worse,\nbut because the help that let them"
    } ]
  }, {
    "tStartMs": 276748,
    "dDurationMs": 4521,
    "segs": [ {
      "utf8": "stay simply vanished. The second way it\nreaches you is through paperwork, and"
    } ]
  }, {
    "tStartMs": 281269,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "this one is going to catch thousands of\npeople who are fully entitled to every"
    } ]
  }, {
    "tStartMs": 285449,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "dollar of their benefits."
    } ]
  }, {
    "tStartMs": 287310,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "The new law piles on more forms, more\neligibility checks, and more frequent"
    } ]
  }, {
    "tStartMs": 292150,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "renewals just to stay on Medicaid."
    } ]
  }, {
    "tStartMs": 294791,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "That may not sound like much at first."
    } ]
  }, {
    "tStartMs": 296451,
    "dDurationMs": 4881,
    "segs": [ {
      "utf8": "But for an older person living alone,\nperhaps struggling to keep up with the"
    } ]
  }, {
    "tStartMs": 301332,
    "dDurationMs": 5201,
    "segs": [ {
      "utf8": "mail, perhaps not seeing as sharply as\nthey once did, a single missed form"
    } ]
  }, {
    "tStartMs": 306533,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "can mean losing coverage they have every\nlegal right to keep."
    } ]
  }, {
    "tStartMs": 310154,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "They are not dropped because they stopped\nqualifying."
    } ]
  }, {
    "tStartMs": 313674,
    "dDurationMs": 4041,
    "segs": [ {
      "utf8": "They are dropped because one piece of\npaper did not get filled out and mailed"
    } ]
  }, {
    "tStartMs": 317715,
    "dDurationMs": 5641,
    "segs": [ {
      "utf8": "back in time. And this hits one group\nharder than any other, the roughly twelve"
    } ]
  }, {
    "tStartMs": 323356,
    "dDurationMs": 4181,
    "segs": [ {
      "utf8": "million older Americans who rely on both\nMedicare and Medicaid together."
    } ]
  }, {
    "tStartMs": 327537,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "For them, one paperwork slip can knock out\nthe very coverage that fills all"
    } ]
  }, {
    "tStartMs": 332977,
    "dDurationMs": 5481,
    "segs": [ {
      "utf8": "the gaps Medicare leaves wide open, the\nlong term care, the help at home, the"
    } ]
  }, {
    "tStartMs": 338458,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "bills Medicare was never going to pay in\nthe first place."
    } ]
  }, {
    "tStartMs": 341479,
    "dDurationMs": 4401,
    "segs": [ {
      "utf8": "And the third way it reaches you strikes\nat the one thing you worked an entire"
    } ]
  }, {
    "tStartMs": 345880,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "lifetime to hold on to. Your home."
    } ]
  }, {
    "tStartMs": 351701,
    "dDurationMs": 6001,
    "segs": [ {
      "utf8": "Even now, after a senior who was on\nMedicaid passes away, the program holds"
    } ]
  }, {
    "tStartMs": 357702,
    "dDurationMs": 5221,
    "segs": [ {
      "utf8": "the legal right to come back and recover\nwhat it spent on their care,"
    } ]
  }, {
    "tStartMs": 364023,
    "dDurationMs": 4061,
    "segs": [ {
      "utf8": "and the single biggest thing it reaches\nfor is the house."
    } ]
  }, {
    "tStartMs": 368604,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "That much was already the law for years."
    } ]
  }, {
    "tStartMs": 372684,
    "dDurationMs": 6141,
    "segs": [ {
      "utf8": "But the rules around how much home value a\nperson is allowed to keep are being"
    } ]
  }, {
    "tStartMs": 378825,
    "dDurationMs": 5341,
    "segs": [ {
      "utf8": "tightened under this new law, and the\nheavy pressure on state budgets means"
    } ]
  }, {
    "tStartMs": 384166,
    "dDurationMs": 6161,
    "segs": [ {
      "utf8": "these programs will chase that repayment\nharder and more aggressively than"
    } ]
  }, {
    "tStartMs": 390327,
    "dDurationMs": 4841,
    "segs": [ {
      "utf8": "they ever have before. So the home you\nalways meant to leave to your children"
    } ]
  }, {
    "tStartMs": 395168,
    "dDurationMs": 6301,
    "segs": [ {
      "utf8": "can end up partly owed back to the\ngovernment, to repay the cost of the care"
    } ]
  }, {
    "tStartMs": 401469,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "you received while you were alive."
    } ]
  }, {
    "tStartMs": 405110,
    "dDurationMs": 6641,
    "segs": [ {
      "utf8": "It is entirely legal, it is done very\nquietly, and most families"
    } ]
  }, {
    "tStartMs": 411751,
    "dDurationMs": 6621,
    "segs": [ {
      "utf8": "never see it coming until a plain envelope\narrives in"
    } ]
  }, {
    "tStartMs": 418372,
    "dDurationMs": 5381,
    "segs": [ {
      "utf8": "the weeks after the funeral. Now I do not\ntell you this to frighten you, because"
    } ]
  }, {
    "tStartMs": 423753,
    "dDurationMs": 5501,
    "segs": [ {
      "utf8": "there is real good news folded right\ninside it."
    } ]
  }, {
    "tStartMs": 429254,
    "dDurationMs": 6061,
    "segs": [ {
      "utf8": "While you are still alive and living in\nyour home, that home is very often"
    } ]
  }, {
    "tStartMs": 435315,
    "dDurationMs": 5721,
    "segs": [ {
      "utf8": "protected. In most cases the program\ncannot push you out of the house you live"
    } ]
  }, {
    "tStartMs": 441036,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "in to pay for your care."
    } ]
  }, {
    "tStartMs": 443577,
    "dDurationMs": 6021,
    "segs": [ {
      "utf8": "The danger is what happens afterward, in\nthose quiet weeks after a death, when"
    } ]
  }, {
    "tStartMs": 449598,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "the recovery letter goes out to the\nfamily."
    } ]
  }, {
    "tStartMs": 451858,
    "dDurationMs": 6361,
    "segs": [ {
      "utf8": "And that gap, between the strong\nprotection you have while you are living"
    } ]
  }, {
    "tStartMs": 458219,
    "dDurationMs": 6061,
    "segs": [ {
      "utf8": "the claim that arrives after you are gone,\nis the exact space where careful,"
    } ]
  }, {
    "tStartMs": 464280,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "early planning does its finest work."
    } ]
  }, {
    "tStartMs": 467781,
    "dDurationMs": 5381,
    "segs": [ {
      "utf8": "It is the whole reason that the families\nwho sit down and plan ahead keep the"
    } ]
  }, {
    "tStartMs": 473162,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "house, while the families who never knew\nany of this was coming are so often"
    } ]
  }, {
    "tStartMs": 477902,
    "dDurationMs": 6122,
    "segs": [ {
      "utf8": "the ones who lose it. The threat is real,\nbut so is the shield, and"
    } ]
  }, {
    "tStartMs": 484024,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "the shield only works for the people who\nreach for it in time."
    } ]
  }, {
    "tStartMs": 489104,
    "dDurationMs": 5401,
    "segs": [ {
      "utf8": "Let me make this real for a moment,\nbecause it happens to true families every"
    } ]
  }, {
    "tStartMs": 494505,
    "dDurationMs": 4921,
    "segs": [ {
      "utf8": "year, and it is about to happen to a great\nmany more."
    } ]
  }, {
    "tStartMs": 500086,
    "dDurationMs": 6161,
    "segs": [ {
      "utf8": "A widow, well into her eighties, is able\nto stay in her own home for one"
    } ]
  }, {
    "tStartMs": 506247,
    "dDurationMs": 6962,
    "segs": [ {
      "utf8": "reason only, because a helper comes a few\ndays each week to assist her."
    } ]
  }, {
    "tStartMs": 513449,
    "dDurationMs": 6301,
    "segs": [ {
      "utf8": "Her state, squeezed hard by these new\ncuts, trims back its home care hours"
    } ]
  }, {
    "tStartMs": 519750,
    "dDurationMs": 5821,
    "segs": [ {
      "utf8": "to save money. Almost overnight, the help\nshe has is no longer enough to keep"
    } ]
  }, {
    "tStartMs": 525571,
    "dDurationMs": 4841,
    "segs": [ {
      "utf8": "her safe, and her children are told the\nonly choice left is to move her into"
    } ]
  }, {
    "tStartMs": 530412,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "a nursing home. The house she lived in for\nfifty years sits dark and empty."
    } ]
  }, {
    "tStartMs": 535312,
    "dDurationMs": 5961,
    "segs": [ {
      "utf8": "And because her care is now being paid by\nMedicaid, the day she passes, the"
    } ]
  }, {
    "tStartMs": 541273,
    "dDurationMs": 4521,
    "segs": [ {
      "utf8": "program files a claim against that very\nhouse to recover the cost."
    } ]
  }, {
    "tStartMs": 545794,
    "dDurationMs": 6061,
    "segs": [ {
      "utf8": "In the space of two short years, a budget\ncut she never once heard about"
    } ]
  }, {
    "tStartMs": 551855,
    "dDurationMs": 5181,
    "segs": [ {
      "utf8": "took both her home and the inheritance she\nhad spent her whole life protecting."
    } ]
  }, {
    "tStartMs": 557896,
    "dDurationMs": 3261,
    "segs": [ {
      "utf8": "Not one single part of that was against\nthe law."
    } ]
  }, {
    "tStartMs": 561157,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "And not one single part of it had to\nhappen."
    } ]
  }, {
    "tStartMs": 565038,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "So here is how you protect yourself and\nthe people you love, and every step"
    } ]
  }, {
    "tStartMs": 570518,
    "dDurationMs": 5721,
    "segs": [ {
      "utf8": "of it is completely free. First, and most\nimportant of all, never ignore a"
    } ]
  }, {
    "tStartMs": 576239,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "letter about your Medicaid or your\nMedicare."
    } ]
  }, {
    "tStartMs": 579160,
    "dDurationMs": 6081,
    "segs": [ {
      "utf8": "Open every one of them the very day it\narrives, and if it asks for a form"
    } ]
  }, {
    "tStartMs": 585241,
    "dDurationMs": 4861,
    "segs": [ {
      "utf8": "or a renewal, treat it as urgent, because\nin this new world a late form is"
    } ]
  }, {
    "tStartMs": 590102,
    "dDurationMs": 5381,
    "segs": [ {
      "utf8": "one of the most common ways good and\neligible people are quietly stripped of"
    } ]
  }, {
    "tStartMs": 595483,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "coverage they have earned."
    } ]
  }, {
    "tStartMs": 597543,
    "dDurationMs": 6221,
    "segs": [ {
      "utf8": "Second, if you are ever told that your\nbenefits are being cut or ended,"
    } ]
  }, {
    "tStartMs": 603764,
    "dDurationMs": 5241,
    "segs": [ {
      "utf8": "that you have the right to appeal that\ndecision, and you should use it, because"
    } ]
  }, {
    "tStartMs": 609005,
    "dDurationMs": 5741,
    "segs": [ {
      "utf8": "a great many of these terminations turn\nout to be wrong and get overturned"
    } ]
  }, {
    "tStartMs": 614746,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "when someone pushes back. Third,"
    } ]
  }, {
    "tStartMs": 617707,
    "dDurationMs": 6021,
    "segs": [ {
      "utf8": "please do not try to face any of this\nalone, and never pay a company that"
    } ]
  }, {
    "tStartMs": 623728,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "to sort it out for a fee."
    } ]
  }, {
    "tStartMs": 626628,
    "dDurationMs": 4761,
    "segs": [ {
      "utf8": "Every state runs a free counseling service\nbuilt for exactly this, and there"
    } ]
  }, {
    "tStartMs": 631389,
    "dDurationMs": 5541,
    "segs": [ {
      "utf8": "are Area Agencies on Aging, and legal aid\noffices, and elder law attorneys"
    } ]
  }, {
    "tStartMs": 636930,
    "dDurationMs": 4961,
    "segs": [ {
      "utf8": "whose entire purpose is to help older\npeople hold on to the benefits and the"
    } ]
  }, {
    "tStartMs": 641891,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "home they are rightfully entitled to. And\nfourth,"
    } ]
  }, {
    "tStartMs": 645791,
    "dDurationMs": 5521,
    "segs": [ {
      "utf8": "if protecting your home is what weighs on\nyou most, do not wait, because the"
    } ]
  }, {
    "tStartMs": 651312,
    "dDurationMs": 5261,
    "segs": [ {
      "utf8": "planning that truly shields a house has to\nbe put in place early, long before"
    } ]
  }, {
    "tStartMs": 656573,
    "dDurationMs": 5481,
    "segs": [ {
      "utf8": "any care is ever needed. Sit down with\nsomeone who handles elder law while"
    } ]
  }, {
    "tStartMs": 662054,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "there is still time on the clock to act."
    } ]
  }, {
    "tStartMs": 668755,
    "dDurationMs": 2721,
    "segs": [ {
      "utf8": "So here is what I want you to carry with\nyou long after this ends."
    } ]
  }, {
    "tStartMs": 672476,
    "dDurationMs": 5841,
    "segs": [ {
      "utf8": "These cuts were written quietly, and on\npurpose, and they are counting on one"
    } ]
  }, {
    "tStartMs": 678317,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "thing above"
    } ]
  }, {
    "tStartMs": 680617,
    "dDurationMs": 5001,
    "segs": [ {
      "utf8": "all else, that you will not be paying\nattention until it is far too late to"
    } ]
  }, {
    "tStartMs": 685618,
    "dDurationMs": 5061,
    "segs": [ {
      "utf8": "do anything about it. But you are paying\nattention, right now."
    } ]
  }, {
    "tStartMs": 690859,
    "dDurationMs": 3941,
    "segs": [ {
      "utf8": "You know that the home care keeping you\nindependent is the very first thing"
    } ]
  }, {
    "tStartMs": 694800,
    "dDurationMs": 5541,
    "segs": [ {
      "utf8": "at risk. You know that a single missed\nform can cost you coverage you spent"
    } ]
  }, {
    "tStartMs": 700341,
    "dDurationMs": 6561,
    "segs": [ {
      "utf8": "a lifetime earning. And you know that the\nhome itself can be reached, even"
    } ]
  }, {
    "tStartMs": 706902,
    "dDurationMs": 6361,
    "segs": [ {
      "utf8": "after you are gone. Knowing all of that\ntoday, while everything is still calm"
    } ]
  }, {
    "tStartMs": 713263,
    "dDurationMs": 6061,
    "segs": [ {
      "utf8": "and there is still time, is the thing that\nhands"
    } ]
  }, {
    "tStartMs": 719324,
    "dDurationMs": 5221,
    "segs": [ {
      "utf8": "you the power to stand in front of it.\nOpen the letters."
    } ]
  }, {
    "tStartMs": 725305,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "Ask for the free help. Plan early."
    } ]
  }, {
    "tStartMs": 728946,
    "dDurationMs": 6421,
    "segs": [ {
      "utf8": "And if you know an older person who is on\nMedicaid, or who is quietly heading"
    } ]
  }, {
    "tStartMs": 735367,
    "dDurationMs": 4881,
    "segs": [ {
      "utf8": "toward needing it, please share this with\nthem today, because this is the kind"
    } ]
  }, {
    "tStartMs": 740248,
    "dDurationMs": 6101,
    "segs": [ {
      "utf8": "of thing that can only protect you if you\nlearn it before the help you were"
    } ]
  }, {
    "tStartMs": 746349,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "counting on quietly disappears."
    } ]
  } ]
}
