{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4963,
    "segs": [ {
      "utf8": "There are five costs tied to your own home\nthat the government, and programs"
    } ]
  }, {
    "tStartMs": 4963,
    "dDurationMs": 5783,
    "segs": [ {
      "utf8": "already built for exactly this, will\nquietly help you lower, wipe out, or pay"
    } ]
  }, {
    "tStartMs": 10746,
    "dDurationMs": 881,
    "segs": [ {
      "utf8": "for once you turn"
    } ]
  }, {
    "tStartMs": 12988,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "sixty five. I am not talking about a small\nsenior discount."
    } ]
  }, {
    "tStartMs": 16650,
    "dDurationMs": 5323,
    "segs": [ {
      "utf8": "On some of these, the right answer is not\na reduced bill, it is a bill of nothing"
    } ]
  }, {
    "tStartMs": 21973,
    "dDurationMs": 5103,
    "segs": [ {
      "utf8": "at all, or a check for thousands of\ndollars to fix your home that you never"
    } ]
  }, {
    "tStartMs": 27076,
    "dDurationMs": 3902,
    "segs": [ {
      "utf8": "pay back. And here is the part that should\nmake you angry."
    } ]
  }, {
    "tStartMs": 31678,
    "dDurationMs": 4323,
    "segs": [ {
      "utf8": "Nobody whose job it is to collect that\nmoney, or to hand out that help, has"
    } ]
  }, {
    "tStartMs": 36001,
    "dDurationMs": 3082,
    "segs": [ {
      "utf8": "the slightest reason to pick up the phone\nand tell you."
    } ]
  }, {
    "tStartMs": 39743,
    "dDurationMs": 3442,
    "segs": [ {
      "utf8": "The city will not tell you. The county\nwill not tell you."
    } ]
  }, {
    "tStartMs": 43565,
    "dDurationMs": 5163,
    "segs": [ {
      "utf8": "The programs sit there, funded and\nwaiting, quietly, in the hope that you never"
    } ]
  }, {
    "tStartMs": 48728,
    "dDurationMs": 3642,
    "segs": [ {
      "utf8": "learn they exist and keep paying out of a\nlifetime of habit."
    } ]
  }, {
    "tStartMs": 53331,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "The people who scroll right past a video\nlike this keep on paying."
    } ]
  }, {
    "tStartMs": 58634,
    "dDurationMs": 4022,
    "segs": [ {
      "utf8": "The ones who stay are the ones who stop\nquietly handing thousands of dollars"
    } ]
  }, {
    "tStartMs": 62656,
    "dDurationMs": 4883,
    "segs": [ {
      "utf8": "away every year, and sometimes it is the\ndifference between keeping the home"
    } ]
  }, {
    "tStartMs": 67539,
    "dDurationMs": 3982,
    "segs": [ {
      "utf8": "and losing it. Because that is what this\nis really about."
    } ]
  }, {
    "tStartMs": 72042,
    "dDurationMs": 4823,
    "segs": [ {
      "utf8": "Keeping the home you worked your whole\nlife to pay for, and staying in it safely,"
    } ]
  }, {
    "tStartMs": 77425,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "instead of losing it to bills you did not\nhave to pay or repairs you could"
    } ]
  }, {
    "tStartMs": 82008,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "not afford."
    } ]
  }, {
    "tStartMs": 83388,
    "dDurationMs": 4843,
    "segs": [ {
      "utf8": "Let me take you through all five, one by\none, in plain words, what each one"
    } ]
  }, {
    "tStartMs": 88231,
    "dDurationMs": 5023,
    "segs": [ {
      "utf8": "is, who qualifies, and the one quiet\nmistake that keeps this help sitting on"
    } ]
  }, {
    "tStartMs": 93254,
    "dDurationMs": 5063,
    "segs": [ {
      "utf8": "the table year after year. Wait for the\nlast two, because they can put thousands"
    } ]
  }, {
    "tStartMs": 98317,
    "dDurationMs": 4843,
    "segs": [ {
      "utf8": "of dollars toward fixing your home, and\nalmost no one has ever heard of them."
    } ]
  }, {
    "tStartMs": 103560,
    "dDurationMs": 4703,
    "segs": [ {
      "utf8": "The first one is a bill that lands every\nmonth or two, and you have probably"
    } ]
  }, {
    "tStartMs": 108263,
    "dDurationMs": 5003,
    "segs": [ {
      "utf8": "never once thought to question it, and\nthat is your water, your sewer, and"
    } ]
  }, {
    "tStartMs": 113266,
    "dDurationMs": 4922,
    "segs": [ {
      "utf8": "your trash. Most people assume these are\nfixed, that everyone pays the same,"
    } ]
  }, {
    "tStartMs": 118469,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "and that there is nothing to be done about\nit."
    } ]
  }, {
    "tStartMs": 120830,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "That is not true."
    } ]
  }, {
    "tStartMs": 122811,
    "dDurationMs": 4203,
    "segs": [ {
      "utf8": "A great many cities and towns in this\ncountry offer a senior discount on water"
    } ]
  }, {
    "tStartMs": 127014,
    "dDurationMs": 4562,
    "segs": [ {
      "utf8": "and sewer service, and often on trash\npickup too, once you reach a certain"
    } ]
  }, {
    "tStartMs": 131576,
    "dDurationMs": 4383,
    "segs": [ {
      "utf8": "age, usually sixty five, and sometimes\nwith a modest income limit."
    } ]
  }, {
    "tStartMs": 136539,
    "dDurationMs": 3762,
    "segs": [ {
      "utf8": "In some places that discount takes twenty\nfive or thirty percent straight off"
    } ]
  }, {
    "tStartMs": 140301,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "the bill. In others, the sewer charge is\ndropped entirely."
    } ]
  }, {
    "tStartMs": 144564,
    "dDurationMs": 6203,
    "segs": [ {
      "utf8": "On a bill you will pay for the rest of\nyour life, month after month, a discount"
    } ]
  }, {
    "tStartMs": 150767,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "like that quietly adds up to hundreds of\ndollars a year."
    } ]
  }, {
    "tStartMs": 154550,
    "dDurationMs": 5122,
    "segs": [ {
      "utf8": "But your water company will not put a note\nin the mailbox telling you to apply."
    } ]
  }, {
    "tStartMs": 160413,
    "dDurationMs": 4703,
    "segs": [ {
      "utf8": "You have to call them, or your city hall,\nand ask one simple question."
    } ]
  }, {
    "tStartMs": 165836,
    "dDurationMs": 5643,
    "segs": [ {
      "utf8": "Do you offer a senior discount on my\nwater, my sewer, or my trash, and how"
    } ]
  }, {
    "tStartMs": 171479,
    "dDurationMs": 4903,
    "segs": [ {
      "utf8": "do I apply for it. That single phone call\nis worth making this week."
    } ]
  }, {
    "tStartMs": 177383,
    "dDurationMs": 4362,
    "segs": [ {
      "utf8": "The second one is the biggest bill in your\nhome in the cold months and the"
    } ]
  }, {
    "tStartMs": 181745,
    "dDurationMs": 2622,
    "segs": [ {
      "utf8": "hot ones, and that is your energy bill."
    } ]
  }, {
    "tStartMs": 185187,
    "dDurationMs": 3582,
    "segs": [ {
      "utf8": "Now, you may have heard of programs that\nhelp pay a heating bill in an emergency."
    } ]
  }, {
    "tStartMs": 189530,
    "dDurationMs": 4322,
    "segs": [ {
      "utf8": "This one is different, and in many ways\nbetter, because it does not just pay"
    } ]
  }, {
    "tStartMs": 193852,
    "dDurationMs": 4143,
    "segs": [ {
      "utf8": "a single bill, it makes every future bill\nsmaller, for free."
    } ]
  }, {
    "tStartMs": 198655,
    "dDurationMs": 2682,
    "segs": [ {
      "utf8": "It is called the Weatherization Assistance\nProgram."
    } ]
  }, {
    "tStartMs": 201797,
    "dDurationMs": 4352,
    "segs": [ {
      "utf8": "It is a federal program, run through your\nown state, and here is what it actually"
    } ]
  }, {
    "tStartMs": 206149,
    "dDurationMs": 491,
    "segs": [ {
      "utf8": "does."
    } ]
  }, {
    "tStartMs": 207360,
    "dDurationMs": 5523,
    "segs": [ {
      "utf8": "It sends workers to your home, at no cost\nto you, to seal the leaks, add insulation,"
    } ]
  }, {
    "tStartMs": 213324,
    "dDurationMs": 4242,
    "segs": [ {
      "utf8": "and repair or replace an old furnace or\nair conditioner, so the money that"
    } ]
  }, {
    "tStartMs": 217566,
    "dDurationMs": 4363,
    "segs": [ {
      "utf8": "has been leaking out of your walls and\nwindows for years finally stops."
    } ]
  }, {
    "tStartMs": 222689,
    "dDurationMs": 5463,
    "segs": [ {
      "utf8": "For an older person on a fixed income,\nthat can cut a heating and cooling bill"
    } ]
  }, {
    "tStartMs": 228152,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "dramatically, and permanently."
    } ]
  }, {
    "tStartMs": 230974,
    "dDurationMs": 4742,
    "segs": [ {
      "utf8": "And here is the part written right into\nthe rules."
    } ]
  }, {
    "tStartMs": 235716,
    "dDurationMs": 441,
    "segs": [ {
      "utf8": "The elderly are given priority."
    } ]
  }, {
    "tStartMs": 236997,
    "dDurationMs": 4723,
    "segs": [ {
      "utf8": "If your income is modest, and the limit is\nmore generous than most people expect,"
    } ]
  }, {
    "tStartMs": 242200,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "you move toward the front of the line\nsimply because of your age."
    } ]
  }, {
    "tStartMs": 246743,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "You apply through your state's\nweatherization office."
    } ]
  }, {
    "tStartMs": 249825,
    "dDurationMs": 5323,
    "segs": [ {
      "utf8": "It costs you nothing, and it keeps paying\nyou back every single month for years"
    } ]
  }, {
    "tStartMs": 255148,
    "dDurationMs": 5043,
    "segs": [ {
      "utf8": "to come. The third one is the repair you\nhave been putting off because you"
    } ]
  }, {
    "tStartMs": 260191,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "cannot see how you would ever pay for it."
    } ]
  }, {
    "tStartMs": 263493,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "The leaking roof. The broken furnace."
    } ]
  }, {
    "tStartMs": 266514,
    "dDurationMs": 1781,
    "segs": [ {
      "utf8": "The step that is no longer safe."
    } ]
  }, {
    "tStartMs": 269156,
    "dDurationMs": 5123,
    "segs": [ {
      "utf8": "If you own your home, you are sixty two or\nolder, your income is modest, and"
    } ]
  }, {
    "tStartMs": 274279,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "you live in a smaller town or a rural\narea,"
    } ]
  }, {
    "tStartMs": 277521,
    "dDurationMs": 3762,
    "segs": [ {
      "utf8": "there is a program from the Department of\nAgriculture that will simply give"
    } ]
  }, {
    "tStartMs": 281283,
    "dDurationMs": 1261,
    "segs": [ {
      "utf8": "you the money to fix it."
    } ]
  }, {
    "tStartMs": 283264,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "Not a loan you have to pay back."
    } ]
  }, {
    "tStartMs": 284945,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "A grant."
    } ]
  }, {
    "tStartMs": 286846,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "As the program stands now, it can provide\nup to ten thousand dollars, over"
    } ]
  }, {
    "tStartMs": 291429,
    "dDurationMs": 4002,
    "segs": [ {
      "utf8": "your lifetime, to remove health and safety\nhazards from your home."
    } ]
  }, {
    "tStartMs": 296252,
    "dDurationMs": 4562,
    "segs": [ {
      "utf8": "Ten thousand dollars, to repair the very\nthings that might otherwise force"
    } ]
  }, {
    "tStartMs": 300814,
    "dDurationMs": 5123,
    "segs": [ {
      "utf8": "you out of the house you own. And if you\nneed more than that and can handle"
    } ]
  }, {
    "tStartMs": 305937,
    "dDurationMs": 6024,
    "segs": [ {
      "utf8": "a small payment, the same program offers a\nloan of up to forty thousand"
    } ]
  }, {
    "tStartMs": 311961,
    "dDurationMs": 5043,
    "segs": [ {
      "utf8": "dollars at just one percent interest, far\nbelow anything a bank would ever"
    } ]
  }, {
    "tStartMs": 317004,
    "dDurationMs": 4822,
    "segs": [ {
      "utf8": "offer you. Most people who qualify have\nnever once heard of it."
    } ]
  }, {
    "tStartMs": 322227,
    "dDurationMs": 4202,
    "segs": [ {
      "utf8": "You apply through your local Department of\nAgriculture Rural Development office,"
    } ]
  }, {
    "tStartMs": 326429,
    "dDurationMs": 4042,
    "segs": [ {
      "utf8": "and you ask about the five oh four home\nrepair program."
    } ]
  }, {
    "tStartMs": 331312,
    "dDurationMs": 4483,
    "segs": [ {
      "utf8": "For the right person, it is the difference\nbetween staying in your home and"
    } ]
  }, {
    "tStartMs": 335795,
    "dDurationMs": 5843,
    "segs": [ {
      "utf8": "losing it. The fourth one decides, for a\ngreat many seniors, whether they get"
    } ]
  }, {
    "tStartMs": 341638,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "to stay in their own home at all."
    } ]
  }, {
    "tStartMs": 344540,
    "dDurationMs": 5022,
    "segs": [ {
      "utf8": "As we grow older, the ordinary house we\nhave lived in for decades can slowly"
    } ]
  }, {
    "tStartMs": 349562,
    "dDurationMs": 4763,
    "segs": [ {
      "utf8": "turn against us. A tub you can no longer\nsafely step into."
    } ]
  }, {
    "tStartMs": 355046,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "Stairs that have started to frighten you."
    } ]
  }, {
    "tStartMs": 357627,
    "dDurationMs": 2011,
    "segs": [ {
      "utf8": "A doorway too narrow for a walker."
    } ]
  }, {
    "tStartMs": 360469,
    "dDurationMs": 1561,
    "segs": [ {
      "utf8": "And here is the cruel result."
    } ]
  }, {
    "tStartMs": 362810,
    "dDurationMs": 4443,
    "segs": [ {
      "utf8": "People leave homes they fully own, and\nmove into care that costs a fortune,"
    } ]
  }, {
    "tStartMs": 367873,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "not because they truly had to, but because\na few simple changes to the house"
    } ]
  }, {
    "tStartMs": 372456,
    "dDurationMs": 3702,
    "segs": [ {
      "utf8": "were never made. Now here is what almost\nno one knows."
    } ]
  }, {
    "tStartMs": 376878,
    "dDurationMs": 6124,
    "segs": [ {
      "utf8": "Those changes, grab bars, a walk in\nshower, a ramp, a raised toilet, a"
    } ]
  }, {
    "tStartMs": 383002,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "wider doorway, can very often be done for\nfree."
    } ]
  }, {
    "tStartMs": 386804,
    "dDurationMs": 4743,
    "segs": [ {
      "utf8": "If you are on Medicaid, there is a special\npart of it, called a home and community"
    } ]
  }, {
    "tStartMs": 391547,
    "dDurationMs": 3082,
    "segs": [ {
      "utf8": "based waiver, that exists for exactly\nthis."
    } ]
  }, {
    "tStartMs": 395309,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "It pays for the modifications that let you\nstay in your home instead of entering"
    } ]
  }, {
    "tStartMs": 399892,
    "dDurationMs": 5123,
    "segs": [ {
      "utf8": "a nursing home, for the simple reason that\nkeeping you at home costs the government"
    } ]
  }, {
    "tStartMs": 405015,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "far less than paying for that home."
    } ]
  }, {
    "tStartMs": 407656,
    "dDurationMs": 4863,
    "segs": [ {
      "utf8": "And whether or not you are on Medicaid,\nyour local Area Agency on Aging can"
    } ]
  }, {
    "tStartMs": 412519,
    "dDurationMs": 3022,
    "segs": [ {
      "utf8": "point you to the programs in your area\nthat do this work."
    } ]
  }, {
    "tStartMs": 415781,
    "dDurationMs": 3302,
    "segs": [ {
      "utf8": "Think for a moment about how much this one\nquietly decides."
    } ]
  }, {
    "tStartMs": 419943,
    "dDurationMs": 4523,
    "segs": [ {
      "utf8": "A single slip stepping over the side of\nthe tub, and all at once a family is"
    } ]
  }, {
    "tStartMs": 424466,
    "dDurationMs": 4202,
    "segs": [ {
      "utf8": "sitting around the kitchen table talking\nabout a care home that costs more"
    } ]
  }, {
    "tStartMs": 428668,
    "dDurationMs": 3943,
    "segs": [ {
      "utf8": "than five thousand dollars a month,\npulling someone out of the only place they"
    } ]
  }, {
    "tStartMs": 432611,
    "dDurationMs": 4942,
    "segs": [ {
      "utf8": "have ever felt safe, not because they\ntruly had to leave, but because a walk"
    } ]
  }, {
    "tStartMs": 437553,
    "dDurationMs": 2882,
    "segs": [ {
      "utf8": "in shower and two grab bars were never put\nin."
    } ]
  }, {
    "tStartMs": 440655,
    "dDurationMs": 4723,
    "segs": [ {
      "utf8": "And those grab bars, that shower, would\nhave been installed for nothing, by"
    } ]
  }, {
    "tStartMs": 445378,
    "dDurationMs": 4703,
    "segs": [ {
      "utf8": "a program built for exactly this, if only\nsomeone had said out loud that it"
    } ]
  }, {
    "tStartMs": 450081,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "existed."
    } ]
  }, {
    "tStartMs": 451261,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "That is the whole weight of this one."
    } ]
  }, {
    "tStartMs": 453543,
    "dDurationMs": 4162,
    "segs": [ {
      "utf8": "Not a small repair. The difference between\na person keeping the home they own"
    } ]
  }, {
    "tStartMs": 457705,
    "dDurationMs": 5243,
    "segs": [ {
      "utf8": "and losing it to a facility. So before you\never let anyone convince you that"
    } ]
  }, {
    "tStartMs": 462948,
    "dDurationMs": 4923,
    "segs": [ {
      "utf8": "you have to leave your home, make one call\nto your Area Agency on Aging"
    } ]
  }, {
    "tStartMs": 469212,
    "dDurationMs": 4082,
    "segs": [ {
      "utf8": "and ask, what help is there to make my\nhome safe enough for me to stay in it."
    } ]
  }, {
    "tStartMs": 473554,
    "dDurationMs": 5103,
    "segs": [ {
      "utf8": "And the fifth one is for every single\nperson who heard those last two and thought,"
    } ]
  }, {
    "tStartMs": 479078,
    "dDurationMs": 5162,
    "segs": [ {
      "utf8": "that sounds wonderful, but I am not in a\nrural area, or I am not on Medicaid,"
    } ]
  }, {
    "tStartMs": 484601,
    "dDurationMs": 3202,
    "segs": [ {
      "utf8": "so none of it is for me. This one is for\nyou."
    } ]
  }, {
    "tStartMs": 488223,
    "dDurationMs": 4883,
    "segs": [ {
      "utf8": "Across this country there are national\ncharities whose entire purpose is to"
    } ]
  }, {
    "tStartMs": 493106,
    "dDurationMs": 5123,
    "segs": [ {
      "utf8": "repair and modify the homes of older\npeople who cannot afford to do it themselves,"
    } ]
  }, {
    "tStartMs": 498829,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "and they do the work for free."
    } ]
  }, {
    "tStartMs": 500990,
    "dDurationMs": 5143,
    "segs": [ {
      "utf8": "One of them, called Rebuilding Together,\nsends skilled volunteers to fix roofs,"
    } ]
  }, {
    "tStartMs": 506533,
    "dDurationMs": 2642,
    "segs": [ {
      "utf8": "repair heating, and make a home safe\nagain."
    } ]
  }, {
    "tStartMs": 510296,
    "dDurationMs": 5203,
    "segs": [ {
      "utf8": "Another, Habitat for Humanity, runs a\nprogram built specifically for aging"
    } ]
  }, {
    "tStartMs": 515499,
    "dDurationMs": 6023,
    "segs": [ {
      "utf8": "in place, installing ramps, grab bars, and\nsafer bathrooms for homeowners who"
    } ]
  }, {
    "tStartMs": 521522,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "are sixty two or older with a modest\nincome."
    } ]
  }, {
    "tStartMs": 525224,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "You do not need to be on any government\nprogram at all to qualify."
    } ]
  }, {
    "tStartMs": 529567,
    "dDurationMs": 3742,
    "segs": [ {
      "utf8": "You simply have to find the group that\nserves your area, and ask."
    } ]
  }, {
    "tStartMs": 533989,
    "dDurationMs": 4543,
    "segs": [ {
      "utf8": "Search the name of the charity along with\nthe name of your town, or ask your"
    } ]
  }, {
    "tStartMs": 538532,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "Area Agency on Aging to point you toward\nthem."
    } ]
  }, {
    "tStartMs": 542114,
    "dDurationMs": 4663,
    "segs": [ {
      "utf8": "For a senior who has been staring at a\nrepair they cannot afford, quietly wondering"
    } ]
  }, {
    "tStartMs": 546777,
    "dDurationMs": 4602,
    "segs": [ {
      "utf8": "how much longer they can stay in their own\nhome, this is the door almost no"
    } ]
  }, {
    "tStartMs": 551379,
    "dDurationMs": 5203,
    "segs": [ {
      "utf8": "one ever knows to knock on. Now step back\nand look at what all five of these"
    } ]
  }, {
    "tStartMs": 556582,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "share, because it is the very same thread\nrunning through every one of them."
    } ]
  }, {
    "tStartMs": 561485,
    "dDurationMs": 5423,
    "segs": [ {
      "utf8": "The money is real. The programs already\nexist, funded and running, written"
    } ]
  }, {
    "tStartMs": 566908,
    "dDurationMs": 1781,
    "segs": [ {
      "utf8": "for exactly your situation."
    } ]
  }, {
    "tStartMs": 569650,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "And not a single one of them will ever\ncome looking for you."
    } ]
  }, {
    "tStartMs": 573152,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "The city does not call to offer you the\ndiscount."
    } ]
  }, {
    "tStartMs": 576034,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "The county does not knock to hand you the\ngrant."
    } ]
  }, {
    "tStartMs": 579075,
    "dDurationMs": 3863,
    "segs": [ {
      "utf8": "They are counting on your silence, and on\na lifetime of habit that tells you"
    } ]
  }, {
    "tStartMs": 582938,
    "dDurationMs": 3262,
    "segs": [ {
      "utf8": "to just pay, and just cope, and never ask."
    } ]
  }, {
    "tStartMs": 586780,
    "dDurationMs": 4422,
    "segs": [ {
      "utf8": "But this is your home. The single biggest\nthing you ever worked for and paid"
    } ]
  }, {
    "tStartMs": 591202,
    "dDurationMs": 5223,
    "segs": [ {
      "utf8": "for. Protecting it, keeping it affordable,\nand keeping it safe enough to stay"
    } ]
  }, {
    "tStartMs": 596425,
    "dDurationMs": 4543,
    "segs": [ {
      "utf8": "in, is one of the most important things\nyou will ever do with a few phone calls."
    } ]
  }, {
    "tStartMs": 601849,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "So here is your list for this week."
    } ]
  }, {
    "tStartMs": 605671,
    "dDurationMs": 5003,
    "segs": [ {
      "utf8": "One. Call your water company or your city\nhall and ask about a senior discount."
    } ]
  }, {
    "tStartMs": 611374,
    "dDurationMs": 3702,
    "segs": [ {
      "utf8": "Two. Call your state's weatherization\noffice and apply."
    } ]
  }, {
    "tStartMs": 615697,
    "dDurationMs": 4862,
    "segs": [ {
      "utf8": "Three. If you live in a smaller town, call\nthe Department of Agriculture and"
    } ]
  }, {
    "tStartMs": 620559,
    "dDurationMs": 2722,
    "segs": [ {
      "utf8": "ask about the five oh four home repair\ngrant."
    } ]
  }, {
    "tStartMs": 623681,
    "dDurationMs": 5523,
    "segs": [ {
      "utf8": "Four. Call your Area Agency on Aging and\nask what help exists to make your"
    } ]
  }, {
    "tStartMs": 629204,
    "dDurationMs": 5844,
    "segs": [ {
      "utf8": "home safe. And five. If you need another\ndoor, find Rebuilding Together or"
    } ]
  }, {
    "tStartMs": 635048,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "Habitat for Humanity in your area."
    } ]
  }, {
    "tStartMs": 637930,
    "dDurationMs": 4122,
    "segs": [ {
      "utf8": "Every one of these is free to ask about,\nand the rules and income limits are"
    } ]
  }, {
    "tStartMs": 642052,
    "dDurationMs": 5043,
    "segs": [ {
      "utf8": "different in every place, so let each\nprogram tell you exactly what you qualify"
    } ]
  }, {
    "tStartMs": 647095,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "for."
    } ]
  }, {
    "tStartMs": 648276,
    "dDurationMs": 5683,
    "segs": [ {
      "utf8": "This is general information to help you\nknow what to ask for, and it is not"
    } ]
  }, {
    "tStartMs": 653959,
    "dDurationMs": 5683,
    "segs": [ {
      "utf8": "legal or financial advice. And I have put\nthe names of every one of these programs,"
    } ]
  }, {
    "tStartMs": 659642,
    "dDurationMs": 4323,
    "segs": [ {
      "utf8": "and where to start, in the description\njust below this video."
    } ]
  }, {
    "tStartMs": 664805,
    "dDurationMs": 4683,
    "segs": [ {
      "utf8": "And before you go, think of one person who\nis quietly worried about their home."
    } ]
  }, {
    "tStartMs": 670028,
    "dDurationMs": 2422,
    "segs": [ {
      "utf8": "A parent afraid of the next repair bill."
    } ]
  }, {
    "tStartMs": 673070,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "A widow who no longer feels safe in her\nown bathroom."
    } ]
  }, {
    "tStartMs": 676772,
    "dDurationMs": 4383,
    "segs": [ {
      "utf8": "A neighbor paying full price for\neverything because no one ever told them there"
    } ]
  }, {
    "tStartMs": 681155,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "was another way. Send them this video."
    } ]
  }, {
    "tStartMs": 684156,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "It could be the very thing that lets them\nkeep the home they love."
    } ]
  }, {
    "tStartMs": 688039,
    "dDurationMs": 4782,
    "segs": [ {
      "utf8": "Go and make one of these calls this week,\nand help someone you love make theirs."
    } ]
  } ]
}
