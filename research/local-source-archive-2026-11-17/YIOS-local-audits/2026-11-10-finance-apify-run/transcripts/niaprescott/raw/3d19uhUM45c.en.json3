{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "I would like to keep this under ten\nthousand dollars."
    } ]
  }, {
    "tStartMs": 4080,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "Ten words."
    } ]
  }, {
    "tStartMs": 5620,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "Said politely, at a bank counter, by\nsomeone who has never broken a law in"
    } ]
  }, {
    "tStartMs": 10660,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "their life."
    } ]
  }, {
    "tStartMs": 12060,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "And those ten words can freeze your\naccount, put a report with your name on"
    } ]
  }, {
    "tStartMs": 16600,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "it into a federal system that you are\nnever allowed to see, and in the worst"
    } ]
  }, {
    "tStartMs": 21300,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "cases cost you the money itself."
    } ]
  }, {
    "tStartMs": 24320,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Not because you did anything wrong."
    } ]
  }, {
    "tStartMs": 26500,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Because of how you said it. And this is\nwhat catches good people off guard."
    } ]
  }, {
    "tStartMs": 31820,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Your bank is not only a place that holds\nyour money."
    } ]
  }, {
    "tStartMs": 34840,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "By law, it is also required to watch it,\nand to report certain things about"
    } ]
  }, {
    "tStartMs": 39660,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "you, and it is forbidden from telling you\nwhen it does."
    } ]
  }, {
    "tStartMs": 43960,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "So the words you choose at that counter\nmatter far more than anyone ever explains."
    } ]
  }, {
    "tStartMs": 49620,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "There are three sentences in particular\nthat older people say all the time,"
    } ]
  }, {
    "tStartMs": 54260,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "believing they sound careful and\nresponsible,"
    } ]
  }, {
    "tStartMs": 56860,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and every one of them can turn"
    } ]
  }, {
    "tStartMs": 59260,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "an ordinary transaction into a problem\nthat takes weeks to undo."
    } ]
  }, {
    "tStartMs": 64000,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "So I am going to give you all three, tell\nyou exactly what the person behind"
    } ]
  }, {
    "tStartMs": 68080,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "the counter hears when you say them, and\ngive you the plain words to use instead."
    } ]
  }, {
    "tStartMs": 73560,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "And I want to start with the first one,\nbecause it is the only one where the"
    } ]
  }, {
    "tStartMs": 77960,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "sentence itself is the offense."
    } ]
  }, {
    "tStartMs": 80200,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Let me say it again. I would like to keep\nthis under ten thousand dollars."
    } ]
  }, {
    "tStartMs": 85280,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Now here is what almost nobody\nunderstands."
    } ]
  }, {
    "tStartMs": 88460,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "There is a rule that says when more than\nten thousand dollars in cash moves"
    } ]
  }, {
    "tStartMs": 92760,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "through your account in a single day, the\nbank files a routine report."
    } ]
  }, {
    "tStartMs": 97440,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Millions of these are filed every year."
    } ]
  }, {
    "tStartMs": 99840,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "For an honest person, that report goes\ninto a file and absolutely nothing ever"
    } ]
  }, {
    "tStartMs": 104620,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "comes of it. It is paperwork. It is not an\naccusation, and it is not an audit."
    } ]
  }, {
    "tStartMs": 109840,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "But the moment you deliberately arrange\nyour money to stay underneath that"
    } ]
  }, {
    "tStartMs": 115160,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "line, you have crossed into something\nentirely different."
    } ]
  }, {
    "tStartMs": 119900,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Breaking up your own money into smaller\namounts to avoid that report is, by"
    } ]
  }, {
    "tStartMs": 124520,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "itself, a federal crime. It has a name in\nthe law, and it carries penalties"
    } ]
  }, {
    "tStartMs": 130360,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "of up to five years in prison."
    } ]
  }, {
    "tStartMs": 133060,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "And I want you to hear the cruelest part\nof this clearly."
    } ]
  }, {
    "tStartMs": 136660,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "It does not matter one bit that the money\nis clean."
    } ]
  }, {
    "tStartMs": 140540,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "It can be money you earned, money you\ninherited,"
    } ]
  }, {
    "tStartMs": 144420,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "money your own children gave you."
    } ]
  }, {
    "tStartMs": 146440,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "If you split it up to stay under the line,\nthe splitting is the crime, all"
    } ]
  }, {
    "tStartMs": 151700,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "on its own. And it is not only a criminal\nmatter."
    } ]
  }, {
    "tStartMs": 155740,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The government can seize that money\nthrough"
    } ]
  }, {
    "tStartMs": 158300,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "a process that does not even require"
    } ]
  }, {
    "tStartMs": 160260,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "them to charge you with anything."
    } ]
  }, {
    "tStartMs": 161700,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "Let me show you what that looks like with\na real person, because this is not"
    } ]
  }, {
    "tStartMs": 167040,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "a hypothetical."
    } ]
  }, {
    "tStartMs": 168760,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "In Iowa, a woman named Carole Hinders ran\na small Mexican restaurant for nearly"
    } ]
  }, {
    "tStartMs": 174480,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "forty years."
    } ]
  }, {
    "tStartMs": 176120,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Cash business."
    } ]
  }, {
    "tStartMs": 177560,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "She did not take credit cards."
    } ]
  }, {
    "tStartMs": 179760,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "So she deposited her daily cash takings at\nthe bank, and because a small restaurant"
    } ]
  }, {
    "tStartMs": 184820,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "does not make ten thousand dollars in a\nday, her deposits naturally came in"
    } ]
  }, {
    "tStartMs": 189700,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "under that line, day after day, year after\nyear."
    } ]
  }, {
    "tStartMs": 194200,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "She was not hiding anything. She was\nsimply banking what she earned."
    } ]
  }, {
    "tStartMs": 198620,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "One morning, federal agents came to her\nhome and told her they had taken every"
    } ]
  }, {
    "tStartMs": 203600,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "dollar in her business account."
    } ]
  }, {
    "tStartMs": 205800,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Roughly thirty three thousand dollars."
    } ]
  }, {
    "tStartMs": 208120,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Her life savings from that restaurant."
    } ]
  }, {
    "tStartMs": 210460,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "She was never charged with a crime,\nbecause she had not committed one."
    } ]
  }, {
    "tStartMs": 214900,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "The deposits themselves, the pattern of\nthem, was the entire case."
    } ]
  }, {
    "tStartMs": 219080,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "It took a legal fight and a great deal of\npublic attention before that money"
    } ]
  }, {
    "tStartMs": 224500,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "was returned to her, and in the meantime\nshe had to borrow to keep the restaurant"
    } ]
  }, {
    "tStartMs": 228980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "open. And she was not alone."
    } ]
  }, {
    "tStartMs": 232500,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "Hers was one of a number of cases where\nordinary people, farmers, shop owners,"
    } ]
  }, {
    "tStartMs": 238440,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "a family running a small convenience\nstore, all had their accounts emptied"
    } ]
  }, {
    "tStartMs": 242320,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "for the same reason. Not one of them was\naccused of selling anything illegal,"
    } ]
  }, {
    "tStartMs": 247460,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "or hiding income, or cheating anyone."
    } ]
  }, {
    "tStartMs": 250680,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "In every case the government looked at a\nlong row of deposits that happened"
    } ]
  }, {
    "tStartMs": 255340,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "to fall under the line and decided that\nthe pattern itself was proof enough."
    } ]
  }, {
    "tStartMs": 260560,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "The lesson those families learned the hard\nway is the lesson I want you to"
    } ]
  }, {
    "tStartMs": 264440,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "have for free. It is not the amount that\ndraws attention."
    } ]
  }, {
    "tStartMs": 267980,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "It is any sign that you were thinking\nabout the line at all."
    } ]
  }, {
    "tStartMs": 271900,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "She did nothing wrong. Her only mistake\nwas a pattern that a computer found"
    } ]
  }, {
    "tStartMs": 277560,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "interesting. So here is your rule, and it\nis simple."
    } ]
  }, {
    "tStartMs": 281660,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Never say anything about staying under a\nlimit."
    } ]
  }, {
    "tStartMs": 284860,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Never ask how to avoid the report."
    } ]
  }, {
    "tStartMs": 287500,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "And never split a large sum into smaller\ntrips."
    } ]
  }, {
    "tStartMs": 291040,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "What you say instead is the plain truth."
    } ]
  }, {
    "tStartMs": 294120,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "I would like to withdraw twelve thousand\ndollars."
    } ]
  }, {
    "tStartMs": 297420,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "I am paying a contractor for a new roof."
    } ]
  }, {
    "tStartMs": 300520,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "That is it. Say the real amount, in one\ntransaction, and let them file whatever"
    } ]
  }, {
    "tStartMs": 306200,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "routine paperwork they need to file,\nbecause that paperwork has never hurt"
    } ]
  }, {
    "tStartMs": 310480,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "an honest person."
    } ]
  }, {
    "tStartMs": 312060,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "That report is harmless."
    } ]
  }, {
    "tStartMs": 314060,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "The avoiding is what is dangerous."
    } ]
  }, {
    "tStartMs": 316580,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Walk in honest and open, and you are\nsimply a customer moving your own money."
    } ]
  }, {
    "tStartMs": 322100,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Now the second sentence, and this one has\nbecome the most common of the three,"
    } ]
  }, {
    "tStartMs": 326660,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "because the world has changed."
    } ]
  }, {
    "tStartMs": 328280,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "Someone told me to send it. Or, it is for\na friend I met online."
    } ]
  }, {
    "tStartMs": 334120,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Or, they said I need to move it right away\nto keep it safe."
    } ]
  }, {
    "tStartMs": 338200,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "When a teller hears any version of that\nfrom an older customer,"
    } ]
  }, {
    "tStartMs": 342200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "something specific happens behind the\ncounter."
    } ]
  }, {
    "tStartMs": 345520,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Banks now have rules and training built\naround protecting older people from"
    } ]
  }, {
    "tStartMs": 349460,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "being cheated."
    } ]
  }, {
    "tStartMs": 350780,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "If they reasonably believe an older\ncustomer is being taken advantage of, they"
    } ]
  }, {
    "tStartMs": 355340,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "are allowed to put a temporary hold on the\nmoney."
    } ]
  }, {
    "tStartMs": 357800,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "Not for an hour. It can run for days, and\nwith an extension, longer."
    } ]
  }, {
    "tStartMs": 363780,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Now I want to be fair about this, because\nit is not the villain it sounds like."
    } ]
  }, {
    "tStartMs": 368840,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "That rule exists because thousands of\nolder Americans really are talked out"
    } ]
  }, {
    "tStartMs": 373360,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "of their savings every year by people who\nare very good at it."
    } ]
  }, {
    "tStartMs": 377460,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "That hold has saved people from losing\neverything they had."
    } ]
  }, {
    "tStartMs": 381200,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "But it does not know the difference\nbetween a stranger running a scheme and"
    } ]
  }, {
    "tStartMs": 385720,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "your own daughter asking for help."
    } ]
  }, {
    "tStartMs": 387420,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "It hears the shape of the sentence."
    } ]
  }, {
    "tStartMs": 390580,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Someone else is directing this money."
    } ]
  }, {
    "tStartMs": 393300,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "That is the trigger. So think of a man\nsending money to his own son who is"
    } ]
  }, {
    "tStartMs": 398440,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "buying a first house."
    } ]
  }, {
    "tStartMs": 400400,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "If he says at the counter, my son told me\nto send this today, he has said the"
    } ]
  }, {
    "tStartMs": 405180,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "exact shape of the sentence the training\nis built to catch."
    } ]
  }, {
    "tStartMs": 409180,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Someone told him. It is urgent."
    } ]
  }, {
    "tStartMs": 411320,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "It is going out fast. Nothing about it is\nwrong, and it can still put a hold"
    } ]
  }, {
    "tStartMs": 415900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "on the money, and now the closing is at\nrisk."
    } ]
  }, {
    "tStartMs": 419120,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "What you say instead is the relationship\nand the reason."
    } ]
  }, {
    "tStartMs": 423420,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "I am wiring money to my son for the down\npayment on his house."
    } ]
  }, {
    "tStartMs": 427460,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Or, this is going to my granddaughter for\nher tuition."
    } ]
  }, {
    "tStartMs": 432140,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Name the person, name their relation to\nyou, and name what the money buys."
    } ]
  }, {
    "tStartMs": 436980,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "That single change turns a warning sign\ninto an ordinary family transaction."
    } ]
  }, {
    "tStartMs": 442300,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "And if the person behind the counter still\nasks you a few more questions after"
    } ]
  }, {
    "tStartMs": 446820,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "that, do not take it as an insult, and\nplease do not let it fluster you."
    } ]
  }, {
    "tStartMs": 452860,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "They are following a script that somebody\nin an office wrote for them, and"
    } ]
  }, {
    "tStartMs": 457420,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "they are asking every older customer the\nsame things."
    } ]
  }, {
    "tStartMs": 461320,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "Answer them the same calm way, in ordinary\nwords, and you will be on your way."
    } ]
  }, {
    "tStartMs": 467200,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "The customers who run into real trouble\nare almost never the ones who answered"
    } ]
  }, {
    "tStartMs": 471780,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "plainly."
    } ]
  }, {
    "tStartMs": 473060,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "They are the ones who got angry, or went\nvague, or changed their story halfway"
    } ]
  }, {
    "tStartMs": 478000,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "through, because the questions made them\nfeel accused."
    } ]
  }, {
    "tStartMs": 481260,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "And there is one more piece of this worth\ncarrying with you."
    } ]
  }, {
    "tStartMs": 485300,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "If anyone, on a telephone or a screen,\never tells you to move your money and"
    } ]
  }, {
    "tStartMs": 490720,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "not to tell your bank what it is really\nfor, that is not advice."
    } ]
  }, {
    "tStartMs": 495000,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "That is the scheme itself. No honest\nperson will ever ask you to lie to your"
    } ]
  }, {
    "tStartMs": 500240,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "own bank."
    } ]
  }, {
    "tStartMs": 501600,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Now the third sentence, and this is the\nsmallest one, but it does the most"
    } ]
  }, {
    "tStartMs": 505600,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "damage in the moment. I would rather not\nsay."
    } ]
  }, {
    "tStartMs": 509240,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "You are perfectly within your rights to\nfeel that way."
    } ]
  }, {
    "tStartMs": 512220,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "It is your money."
    } ]
  }, {
    "tStartMs": 514140,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Nobody enjoys being questioned about their\nown savings by a stranger half their"
    } ]
  }, {
    "tStartMs": 518340,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "age, and I understand exactly why an older\nperson, asked what the money is"
    } ]
  }, {
    "tStartMs": 523080,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "for, feels their back go up. It is\nundignified."
    } ]
  }, {
    "tStartMs": 526920,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "It should not be necessary. But here is\nwhat happens the second those words"
    } ]
  }, {
    "tStartMs": 531280,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "are spoken. The person in front of you now\nhas to write something."
    } ]
  }, {
    "tStartMs": 535960,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "And when the field for the reason is left\nempty, or the customer declined to"
    } ]
  }, {
    "tStartMs": 540120,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "explain, that is what goes into the\nrecord."
    } ]
  }, {
    "tStartMs": 543340,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "To the reviewer who reads it later,\nrefusing to answer looks far worse than"
    } ]
  }, {
    "tStartMs": 548200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "any answer you could have given."
    } ]
  }, {
    "tStartMs": 549820,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "There is no ordinary explanation that\nraises more suspicion than no explanation"
    } ]
  }, {
    "tStartMs": 554780,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "at all. So do not fight the question, and\ndo not let it wound your pride."
    } ]
  }, {
    "tStartMs": 559760,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Answer it in one boring sentence, and move\non."
    } ]
  }, {
    "tStartMs": 563300,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "I am buying a car. It is for medical\nbills."
    } ]
  }, {
    "tStartMs": 566520,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "I am helping my daughter. That is all it\ntakes, and the whole thing ends right"
    } ]
  }, {
    "tStartMs": 571260,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "there at the counter."
    } ]
  }, {
    "tStartMs": 573280,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And now let me give you the two things\nthat stop nearly all of this from ever"
    } ]
  }, {
    "tStartMs": 577000,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "starting. The first is to call ahead."
    } ]
  }, {
    "tStartMs": 580100,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "If you know a large withdrawal or transfer\nis coming, telephone your branch"
    } ]
  }, {
    "tStartMs": 583880,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "a few days before, tell them the amount\nand what it is for, and ask them to"
    } ]
  }, {
    "tStartMs": 588500,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "make a note of it on your account."
    } ]
  }, {
    "tStartMs": 590540,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "A transaction the bank is expecting is a\ntransaction the bank does not stop."
    } ]
  }, {
    "tStartMs": 595300,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "It turns what could be a week of held\nmoney into a five minute conversation"
    } ]
  }, {
    "tStartMs": 599080,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "you already had."
    } ]
  }, {
    "tStartMs": 600860,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The second is to name a trusted contact on\nyour account."
    } ]
  }, {
    "tStartMs": 604080,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "This is a free form. It is a"
    } ]
  }, {
    "tStartMs": 606460,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "person the bank is permitted to telephone\nif something"
    } ]
  }, {
    "tStartMs": 609080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "about your account ever worries them."
    } ]
  }, {
    "tStartMs": 612060,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Naming a son, a daughter, or an old friend\ndoes not give that person one penny"
    } ]
  }, {
    "tStartMs": 616660,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "of access, and it does not let them move\nyour money."
    } ]
  }, {
    "tStartMs": 619540,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "It simply gives the bank a human being to\ncall instead of locking the account"
    } ]
  }, {
    "tStartMs": 623480,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "and waiting. It costs nothing, it takes\nabout ten minutes at the branch or"
    } ]
  }, {
    "tStartMs": 628740,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "on the telephone, and for a person who\nlives alone it is one of the most useful"
    } ]
  }, {
    "tStartMs": 633160,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "pieces of paper you will ever sign."
    } ]
  }, {
    "tStartMs": 635200,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "That one form is the difference between\nsomeone picking up the phone and someone"
    } ]
  }, {
    "tStartMs": 640160,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "freezing your money."
    } ]
  }, {
    "tStartMs": 642080,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So let me put the three of them together,\nsimply, one last time."
    } ]
  }, {
    "tStartMs": 645980,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Never talk about staying under a limit."
    } ]
  }, {
    "tStartMs": 648260,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Say the real amount and let them file\ntheir paperwork."
    } ]
  }, {
    "tStartMs": 651660,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Never say that someone told you to send\nit."
    } ]
  }, {
    "tStartMs": 654360,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Name the person, name the relationship,\nname what it is for."
    } ]
  }, {
    "tStartMs": 658300,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "And never refuse to explain. Give one"
    } ]
  }, {
    "tStartMs": 661080,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "ordinary sentence and the matter is\nclosed."
    } ]
  }, {
    "tStartMs": 663980,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Everything I have told you today comes\ndown to a single idea."
    } ]
  }, {
    "tStartMs": 667620,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The money is not the problem. Your money\nis fine."
    } ]
  }, {
    "tStartMs": 671380,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "The pattern and the wording are what get\nread, by people and by computers,"
    } ]
  }, {
    "tStartMs": 675680,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "and they are read by strangers who do not\nknow you and will never meet you."
    } ]
  }, {
    "tStartMs": 680020,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "So give them nothing to wonder about."
    } ]
  }, {
    "tStartMs": 682500,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Be the plainest, most boring customer in\nthe branch, and you will walk out"
    } ]
  }, {
    "tStartMs": 686340,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "with your own money and never think about\nany of this again."
    } ]
  }, {
    "tStartMs": 689420,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "And if you know someone who is planning a\nlarge withdrawal soon, for a car,"
    } ]
  }, {
    "tStartMs": 694180,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "for a roof, to help one of their children,\nplease send this to them before"
    } ]
  }, {
    "tStartMs": 697940,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "they go."
    } ]
  }, {
    "tStartMs": 699120,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Five minutes of the right words is all\nthat stands between an ordinary morning"
    } ]
  }, {
    "tStartMs": 702940,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "at the bank and a very long month."
    } ]
  } ]
}
