{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "I want you to picture a woman named Dorothy."
    } ]
  }, {
    "tStartMs": 3943,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "She is seventy one years old, she lives alone in the same"
    } ]
  }, {
    "tStartMs": 7647,
    "dDurationMs": 3323,
    "segs": [ {
      "utf8": "house she raised her children in, and she has banked at the"
    } ]
  }, {
    "tStartMs": 10970,
    "dDurationMs": 3424,
    "segs": [ {
      "utf8": "same branch on the same corner for almost forty years."
    } ]
  }, {
    "tStartMs": 14934,
    "dDurationMs": 4845,
    "segs": [ {
      "utf8": "Every month her statement arrives in the mail, she glances at the"
    } ]
  }, {
    "tStartMs": 19779,
    "dDurationMs": 3464,
    "segs": [ {
      "utf8": "balance on the first page, and she files it away in a"
    } ]
  }, {
    "tStartMs": 23243,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "kitchen drawer without ever once reading the middle of it."
    } ]
  }, {
    "tStartMs": 27537,
    "dDurationMs": 4875,
    "segs": [ {
      "utf8": "And every single month, buried in that middle, her bank quietly takes"
    } ]
  }, {
    "tStartMs": 32412,
    "dDurationMs": 3223,
    "segs": [ {
      "utf8": "a little more of her money in fees she does not even"
    } ]
  }, {
    "tStartMs": 35635,
    "dDurationMs": 1021,
    "segs": [ {
      "utf8": "know she is paying."
    } ]
  }, {
    "tStartMs": 37657,
    "dDurationMs": 4184,
    "segs": [ {
      "utf8": "Over the last ten years, Dorothy has handed that bank close to"
    } ]
  }, {
    "tStartMs": 41841,
    "dDurationMs": 4845,
    "segs": [ {
      "utf8": "three thousand dollars for nothing, and not one time did anyone there"
    } ]
  }, {
    "tStartMs": 46686,
    "dDurationMs": 2863,
    "segs": [ {
      "utf8": "pick up the phone to tell her she could make it stop."
    } ]
  }, {
    "tStartMs": 50530,
    "dDurationMs": 4064,
    "segs": [ {
      "utf8": "Dorothy is not careless and Dorothy is not foolish."
    } ]
  }, {
    "tStartMs": 55174,
    "dDurationMs": 4545,
    "segs": [ {
      "utf8": "She is exactly like millions of good, careful people who simply assume"
    } ]
  }, {
    "tStartMs": 59719,
    "dDurationMs": 2983,
    "segs": [ {
      "utf8": "that fees are the normal price of having a bank account."
    } ]
  }, {
    "tStartMs": 63022,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "They are not."
    } ]
  }, {
    "tStartMs": 64764,
    "dDurationMs": 3624,
    "segs": [ {
      "utf8": "Every one of these charges is pure profit for the bank, and"
    } ]
  }, {
    "tStartMs": 68388,
    "dDurationMs": 3923,
    "segs": [ {
      "utf8": "the whole system is built on one quiet bet, that you will"
    } ]
  }, {
    "tStartMs": 72311,
    "dDurationMs": 3624,
    "segs": [ {
      "utf8": "not read your statement closely and you will not call to ask"
    } ]
  }, {
    "tStartMs": 75935,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "about it."
    } ]
  }, {
    "tStartMs": 76756,
    "dDurationMs": 3744,
    "segs": [ {
      "utf8": "Because almost every one of these fees can be removed with a"
    } ]
  }, {
    "tStartMs": 80500,
    "dDurationMs": 3763,
    "segs": [ {
      "utf8": "single phone call or a single switch, and the bank will never"
    } ]
  }, {
    "tStartMs": 84263,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "be the one to volunteer that to you."
    } ]
  }, {
    "tStartMs": 86986,
    "dDurationMs": 4164,
    "segs": [ {
      "utf8": "So today I am going to walk you through eight fees your"
    } ]
  }, {
    "tStartMs": 91150,
    "dDurationMs": 4645,
    "segs": [ {
      "utf8": "bank is very likely charging you right now, exactly why each one"
    } ]
  }, {
    "tStartMs": 95795,
    "dDurationMs": 4644,
    "segs": [ {
      "utf8": "exists, and the precise words to say to make each one disappear."
    } ]
  }, {
    "tStartMs": 101020,
    "dDurationMs": 3684,
    "segs": [ {
      "utf8": "Stay with me to the end, because the last one is not"
    } ]
  }, {
    "tStartMs": 104704,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "even printed on your bank statement."
    } ]
  }, {
    "tStartMs": 106756,
    "dDurationMs": 5295,
    "segs": [ {
      "utf8": "It is hidden somewhere else entirely, and it quietly costs retirees more"
    } ]
  }, {
    "tStartMs": 112051,
    "dDurationMs": 3564,
    "segs": [ {
      "utf8": "money than all seven of these fees put together."
    } ]
  }, {
    "tStartMs": 116215,
    "dDurationMs": 5426,
    "segs": [ {
      "utf8": "Fee number one is the monthly maintenance fee, sometimes called a service"
    } ]
  }, {
    "tStartMs": 121641,
    "dDurationMs": 3143,
    "segs": [ {
      "utf8": "fee, and it is the most common one of all."
    } ]
  }, {
    "tStartMs": 125364,
    "dDurationMs": 4385,
    "segs": [ {
      "utf8": "It is a charge, often around fourteen dollars a month, simply for"
    } ]
  }, {
    "tStartMs": 129749,
    "dDurationMs": 2122,
    "segs": [ {
      "utf8": "the privilege of keeping your account open."
    } ]
  }, {
    "tStartMs": 132431,
    "dDurationMs": 4124,
    "segs": [ {
      "utf8": "Fourteen dollars does not sound like much, but that is well over"
    } ]
  }, {
    "tStartMs": 137556,
    "dDurationMs": 3644,
    "segs": [ {
      "utf8": "a hundred and sixty dollars a year, every year, draining quietly out"
    } ]
  }, {
    "tStartMs": 141200,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "of your account for nothing in return."
    } ]
  }, {
    "tStartMs": 144383,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "Now here is the good news."
    } ]
  }, {
    "tStartMs": 146385,
    "dDurationMs": 3784,
    "segs": [ {
      "utf8": "Almost every major bank offers a senior account with no monthly fee"
    } ]
  }, {
    "tStartMs": 150169,
    "dDurationMs": 4584,
    "segs": [ {
      "utf8": "at all, some starting as young as fifty five and most by"
    } ]
  }, {
    "tStartMs": 154753,
    "dDurationMs": 2123,
    "segs": [ {
      "utf8": "the age of sixty or sixty two."
    } ]
  }, {
    "tStartMs": 158417,
    "dDurationMs": 3924,
    "segs": [ {
      "utf8": "So the first thing you do is call your bank and say"
    } ]
  }, {
    "tStartMs": 162341,
    "dDurationMs": 1441,
    "segs": [ {
      "utf8": "these exact words."
    } ]
  }, {
    "tStartMs": 164423,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "I would like to switch to your no monthly fee account for seniors."
    } ]
  }, {
    "tStartMs": 168767,
    "dDurationMs": 3144,
    "segs": [ {
      "utf8": "If they tell you they do not have one, you say this."
    } ]
  }, {
    "tStartMs": 172371,
    "dDurationMs": 2863,
    "segs": [ {
      "utf8": "Then please tell me how to get this monthly fee waived."
    } ]
  }, {
    "tStartMs": 175774,
    "dDurationMs": 3043,
    "segs": [ {
      "utf8": "And almost every bank will waive that fee the moment you have"
    } ]
  }, {
    "tStartMs": 178817,
    "dDurationMs": 4325,
    "segs": [ {
      "utf8": "a regular direct deposit going into the account, and your Social Security"
    } ]
  }, {
    "tStartMs": 183142,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "payment counts as that direct deposit."
    } ]
  }, {
    "tStartMs": 186005,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "If they still refuse, that is your answer to leave, because an"
    } ]
  }, {
    "tStartMs": 189828,
    "dDurationMs": 3484,
    "segs": [ {
      "utf8": "online bank or a local credit union will give you the very"
    } ]
  }, {
    "tStartMs": 193312,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "same checking account with no monthly fee, ever."
    } ]
  }, {
    "tStartMs": 196615,
    "dDurationMs": 4124,
    "segs": [ {
      "utf8": "Fee number two is the overdraft fee, and this is the one"
    } ]
  }, {
    "tStartMs": 200739,
    "dDurationMs": 4565,
    "segs": [ {
      "utf8": "that does the most damage, because it strikes at the exact moment"
    } ]
  }, {
    "tStartMs": 205304,
    "dDurationMs": 2362,
    "segs": [ {
      "utf8": "you are already short on money."
    } ]
  }, {
    "tStartMs": 208407,
    "dDurationMs": 3623,
    "segs": [ {
      "utf8": "If you spend even a few dollars more than you have, the"
    } ]
  }, {
    "tStartMs": 212030,
    "dDurationMs": 3944,
    "segs": [ {
      "utf8": "bank quietly covers it and then charges you around thirty to thirty"
    } ]
  }, {
    "tStartMs": 215974,
    "dDurationMs": 3304,
    "segs": [ {
      "utf8": "five dollars for the favor, and they can do it more than"
    } ]
  }, {
    "tStartMs": 219278,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "once in a single day."
    } ]
  }, {
    "tStartMs": 221740,
    "dDurationMs": 4885,
    "segs": [ {
      "utf8": "So a five dollar cup of coffee can end up costing you forty dollars."
    } ]
  }, {
    "tStartMs": 226625,
    "dDurationMs": 2923,
    "segs": [ {
      "utf8": "Now I need you to hear something important."
    } ]
  }, {
    "tStartMs": 230028,
    "dDurationMs": 4625,
    "segs": [ {
      "utf8": "Regulators recently tried to cap this fee at just five dollars, but"
    } ]
  }, {
    "tStartMs": 234653,
    "dDurationMs": 3904,
    "segs": [ {
      "utf8": "that rule was overturned in twenty twenty five, so the banks are"
    } ]
  }, {
    "tStartMs": 238557,
    "dDurationMs": 3143,
    "segs": [ {
      "utf8": "once again free to charge the full amount, and they are."
    } ]
  }, {
    "tStartMs": 242261,
    "dDurationMs": 3763,
    "segs": [ {
      "utf8": "The way you protect yourself is to call your bank and say this."
    } ]
  }, {
    "tStartMs": 246665,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "I want to opt out of overdraft coverage completely."
    } ]
  }, {
    "tStartMs": 250649,
    "dDurationMs": 3423,
    "segs": [ {
      "utf8": "When you do that, if a payment would ever overdraw your account,"
    } ]
  }, {
    "tStartMs": 254533,
    "dDurationMs": 3623,
    "segs": [ {
      "utf8": "the bank simply declines it at the register, and you pay nothing"
    } ]
  }, {
    "tStartMs": 258156,
    "dDurationMs": 2603,
    "segs": [ {
      "utf8": "at all instead of thirty five dollars."
    } ]
  }, {
    "tStartMs": 260759,
    "dDurationMs": 3784,
    "segs": [ {
      "utf8": "You would far rather have a card quietly declined for a moment"
    } ]
  }, {
    "tStartMs": 264543,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "than pay thirty five dollars for a gallon of milk."
    } ]
  }, {
    "tStartMs": 267746,
    "dDurationMs": 4604,
    "segs": [ {
      "utf8": "Fee number three is the out of network cash machine fee, and"
    } ]
  }, {
    "tStartMs": 272350,
    "dDurationMs": 3104,
    "segs": [ {
      "utf8": "it is sneaky because you actually get charged twice."
    } ]
  }, {
    "tStartMs": 276074,
    "dDurationMs": 2963,
    "segs": [ {
      "utf8": "Once by the machine you are standing in front of, and once"
    } ]
  }, {
    "tStartMs": 279037,
    "dDurationMs": 4084,
    "segs": [ {
      "utf8": "again by your own bank, and together those charges now average close"
    } ]
  }, {
    "tStartMs": 283121,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "to five dollars just to take out your own money."
    } ]
  }, {
    "tStartMs": 286945,
    "dDurationMs": 2743,
    "segs": [ {
      "utf8": "Do that a couple of times a week and you have handed"
    } ]
  }, {
    "tStartMs": 289688,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "away hundreds of dollars a year in cash you already owned."
    } ]
  }, {
    "tStartMs": 293932,
    "dDurationMs": 1722,
    "segs": [ {
      "utf8": "The fix could not be simpler."
    } ]
  }, {
    "tStartMs": 296334,
    "dDurationMs": 3464,
    "segs": [ {
      "utf8": "Only use the cash machines that belong to your own bank, and"
    } ]
  }, {
    "tStartMs": 299798,
    "dDurationMs": 2642,
    "segs": [ {
      "utf8": "when there is not one nearby, do this instead."
    } ]
  }, {
    "tStartMs": 303221,
    "dDurationMs": 3544,
    "segs": [ {
      "utf8": "At almost any grocery store or pharmacy, when you pay with your"
    } ]
  }, {
    "tStartMs": 306765,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "debit card, the cashier will ask if you would like cash back,"
    } ]
  }, {
    "tStartMs": 310588,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "and you can take out your cash right there at the register"
    } ]
  }, {
    "tStartMs": 313652,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "completely free."
    } ]
  }, {
    "tStartMs": 315073,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "No machine, no fee, your own money in your hand."
    } ]
  }, {
    "tStartMs": 318957,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "Fee number four is the wire transfer fee."
    } ]
  }, {
    "tStartMs": 322400,
    "dDurationMs": 3183,
    "segs": [ {
      "utf8": "Any time you send money to family, or to a title company"
    } ]
  }, {
    "tStartMs": 325583,
    "dDurationMs": 2983,
    "segs": [ {
      "utf8": "when you buy or sell a home, or even between your own"
    } ]
  }, {
    "tStartMs": 328566,
    "dDurationMs": 3364,
    "segs": [ {
      "utf8": "accounts, and you let the bank send it as a wire, they"
    } ]
  }, {
    "tStartMs": 331930,
    "dDurationMs": 3263,
    "segs": [ {
      "utf8": "charge you somewhere between twenty five and thirty five dollars to push"
    } ]
  }, {
    "tStartMs": 335193,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "a button."
    } ]
  }, {
    "tStartMs": 336634,
    "dDurationMs": 3684,
    "segs": [ {
      "utf8": "For the vast majority of transfers you will ever make, you do"
    } ]
  }, {
    "tStartMs": 340318,
    "dDurationMs": 1381,
    "segs": [ {
      "utf8": "not need a wire at all."
    } ]
  }, {
    "tStartMs": 342140,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "You can send the money for free using a standard electronic transfer"
    } ]
  }, {
    "tStartMs": 345443,
    "dDurationMs": 3624,
    "segs": [ {
      "utf8": "between banks, or through one of the free transfer apps your bank"
    } ]
  }, {
    "tStartMs": 349067,
    "dDurationMs": 2983,
    "segs": [ {
      "utf8": "already offers right inside its phone application."
    } ]
  }, {
    "tStartMs": 353071,
    "dDurationMs": 4304,
    "segs": [ {
      "utf8": "A wire is only for the rare, truly urgent, same day situation."
    } ]
  }, {
    "tStartMs": 357956,
    "dDurationMs": 4244,
    "segs": [ {
      "utf8": "For everything else, the free option does the exact same job and"
    } ]
  }, {
    "tStartMs": 362200,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "the money simply arrives a day or two later."
    } ]
  }, {
    "tStartMs": 365683,
    "dDurationMs": 3163,
    "segs": [ {
      "utf8": "Fee number five is the paper statement fee."
    } ]
  }, {
    "tStartMs": 369547,
    "dDurationMs": 4485,
    "segs": [ {
      "utf8": "More and more banks have quietly begun charging you a few dollars"
    } ]
  }, {
    "tStartMs": 374032,
    "dDurationMs": 3883,
    "segs": [ {
      "utf8": "every month just for mailing you a paper copy of your statement,"
    } ]
  }, {
    "tStartMs": 378496,
    "dDurationMs": 2963,
    "segs": [ {
      "utf8": "the very thing they sent you for free your entire life."
    } ]
  }, {
    "tStartMs": 382060,
    "dDurationMs": 2142,
    "segs": [ {
      "utf8": "You have two ways to kill this one."
    } ]
  }, {
    "tStartMs": 384882,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "You can switch to electronic statements, which you can always print at"
    } ]
  }, {
    "tStartMs": 388886,
    "dDurationMs": 3844,
    "segs": [ {
      "utf8": "home any time you want a paper copy, and the fee vanishes."
    } ]
  }, {
    "tStartMs": 393591,
    "dDurationMs": 4224,
    "segs": [ {
      "utf8": "Or, if you genuinely want that paper statement mailed to you and"
    } ]
  }, {
    "tStartMs": 397815,
    "dDurationMs": 3464,
    "segs": [ {
      "utf8": "you are living on a fixed income, you call and say this."
    } ]
  }, {
    "tStartMs": 401879,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "I am a senior on a fixed income and I would like"
    } ]
  }, {
    "tStartMs": 404962,
    "dDurationMs": 2463,
    "segs": [ {
      "utf8": "this paper statement fee waived."
    } ]
  }, {
    "tStartMs": 407685,
    "dDurationMs": 3343,
    "segs": [ {
      "utf8": "Many banks will waive it the moment you ask, because they would"
    } ]
  }, {
    "tStartMs": 411028,
    "dDurationMs": 3324,
    "segs": [ {
      "utf8": "much rather keep you than lose you over a few dollars a"
    } ]
  }, {
    "tStartMs": 414352,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "month."
    } ]
  }, {
    "tStartMs": 415293,
    "dDurationMs": 5285,
    "segs": [ {
      "utf8": "Fee number six is the inactivity fee, also called a dormancy fee,"
    } ]
  }, {
    "tStartMs": 420878,
    "dDurationMs": 4104,
    "segs": [ {
      "utf8": "and this one is almost insulting once you understand it."
    } ]
  }, {
    "tStartMs": 425463,
    "dDurationMs": 4144,
    "segs": [ {
      "utf8": "It is a fee the bank charges you for not using an account enough."
    } ]
  }, {
    "tStartMs": 430258,
    "dDurationMs": 3893,
    "segs": [ {
      "utf8": "If you have a savings account or an older checking account that"
    } ]
  }, {
    "tStartMs": 434151,
    "dDurationMs": 4365,
    "segs": [ {
      "utf8": "you simply leave sitting there, some banks will begin draining it with"
    } ]
  }, {
    "tStartMs": 438516,
    "dDurationMs": 2622,
    "segs": [ {
      "utf8": "a monthly charge for the crime of doing nothing."
    } ]
  }, {
    "tStartMs": 441819,
    "dDurationMs": 4685,
    "segs": [ {
      "utf8": "The fix is to either set up one small automatic transaction, even"
    } ]
  }, {
    "tStartMs": 446504,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "a few dollars moving in or out each month, so the account"
    } ]
  }, {
    "tStartMs": 449867,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "stays active, or to simply close any account you are not really"
    } ]
  }, {
    "tStartMs": 453671,
    "dDurationMs": 4024,
    "segs": [ {
      "utf8": "using and move that money somewhere it is not being nibbled away"
    } ]
  }, {
    "tStartMs": 457695,
    "dDurationMs": 1021,
    "segs": [ {
      "utf8": "while you sleep."
    } ]
  }, {
    "tStartMs": 459897,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Fee number seven is the minimum balance fee, and this is the"
    } ]
  }, {
    "tStartMs": 463901,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "one that feels like a trap, because it is one."
    } ]
  }, {
    "tStartMs": 467084,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "The bank promises you free checking, but only if you keep a"
    } ]
  }, {
    "tStartMs": 470888,
    "dDurationMs": 3644,
    "segs": [ {
      "utf8": "certain amount of money sitting in the account at all times, and"
    } ]
  }, {
    "tStartMs": 474532,
    "dDurationMs": 3944,
    "segs": [ {
      "utf8": "the one month your balance dips below that invisible line, even for"
    } ]
  }, {
    "tStartMs": 478476,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "a single day, even by a single dollar, they hit you with"
    } ]
  }, {
    "tStartMs": 482299,
    "dDurationMs": 441,
    "segs": [ {
      "utf8": "a fee."
    } ]
  }, {
    "tStartMs": 483200,
    "dDurationMs": 3063,
    "segs": [ {
      "utf8": "The answer is to stop playing their game entirely."
    } ]
  }, {
    "tStartMs": 486944,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "Move your money into an account that has no minimum balance requirement"
    } ]
  }, {
    "tStartMs": 490648,
    "dDurationMs": 5025,
    "segs": [ {
      "utf8": "at all, which nearly every online bank and nearly every senior account"
    } ]
  }, {
    "tStartMs": 495673,
    "dDurationMs": 5125,
    "segs": [ {
      "utf8": "now offers, so that a low month or one unexpected expense never"
    } ]
  }, {
    "tStartMs": 500798,
    "dDurationMs": 2082,
    "segs": [ {
      "utf8": "costs you an extra penny on top of it."
    } ]
  }, {
    "tStartMs": 504001,
    "dDurationMs": 5125,
    "segs": [ {
      "utf8": "Fee number eight is the foreign transaction fee, and it catches people"
    } ]
  }, {
    "tStartMs": 509126,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "who do not even realize they left the country."
    } ]
  }, {
    "tStartMs": 512229,
    "dDurationMs": 3984,
    "segs": [ {
      "utf8": "If you traveled abroad, or even just bought something online from a"
    } ]
  }, {
    "tStartMs": 516213,
    "dDurationMs": 4284,
    "segs": [ {
      "utf8": "company based in another country, your bank quietly adds a charge of"
    } ]
  }, {
    "tStartMs": 520497,
    "dDurationMs": 3083,
    "segs": [ {
      "utf8": "around three percent on top of everything you spent."
    } ]
  }, {
    "tStartMs": 524221,
    "dDurationMs": 3223,
    "segs": [ {
      "utf8": "On a single trip that can add up to real money for nothing."
    } ]
  }, {
    "tStartMs": 528185,
    "dDurationMs": 3924,
    "segs": [ {
      "utf8": "Many cards built for travel and most credit unions charge nothing at"
    } ]
  }, {
    "tStartMs": 532109,
    "dDurationMs": 3984,
    "segs": [ {
      "utf8": "all for this, so if you ever spend across the border, even"
    } ]
  }, {
    "tStartMs": 536093,
    "dDurationMs": 2883,
    "segs": [ {
      "utf8": "online, call and ask your bank one question."
    } ]
  }, {
    "tStartMs": 539436,
    "dDurationMs": 4324,
    "segs": [ {
      "utf8": "Do you charge a foreign transaction fee, and if so, what card"
    } ]
  }, {
    "tStartMs": 543760,
    "dDurationMs": 1442,
    "segs": [ {
      "utf8": "can I use that does not."
    } ]
  }, {
    "tStartMs": 545682,
    "dDurationMs": 3364,
    "segs": [ {
      "utf8": "Then carry that card whenever your money is leaving the country."
    } ]
  }, {
    "tStartMs": 549506,
    "dDurationMs": 3824,
    "segs": [ {
      "utf8": "Now here is the bonus I promised you, the fee that is"
    } ]
  }, {
    "tStartMs": 553330,
    "dDurationMs": 4544,
    "segs": [ {
      "utf8": "not on your bank statement at all and that quietly dwarfs every"
    } ]
  }, {
    "tStartMs": 557874,
    "dDurationMs": 1162,
    "segs": [ {
      "utf8": "single one of the eight I just gave you."
    } ]
  }, {
    "tStartMs": 559636,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "It is the fee you pay to have your money managed and"
    } ]
  }, {
    "tStartMs": 562839,
    "dDurationMs": 1102,
    "segs": [ {
      "utf8": "invested for you."
    } ]
  }, {
    "tStartMs": 563941,
    "dDurationMs": 3613,
    "segs": [ {
      "utf8": "If you have someone managing your retirement savings, and they charge you"
    } ]
  }, {
    "tStartMs": 567554,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "what sounds like a tiny one percent a year, I want you"
    } ]
  }, {
    "tStartMs": 570917,
    "dDurationMs": 1672,
    "segs": [ {
      "utf8": "to really hear what that means in actual dollars."
    } ]
  }, {
    "tStartMs": 573110,
    "dDurationMs": 3803,
    "segs": [ {
      "utf8": "On a nest egg of five hundred thousand dollars, one percent is"
    } ]
  }, {
    "tStartMs": 576913,
    "dDurationMs": 3524,
    "segs": [ {
      "utf8": "five thousand dollars every single year, coming out of your savings whether"
    } ]
  }, {
    "tStartMs": 580437,
    "dDurationMs": 1582,
    "segs": [ {
      "utf8": "your money grew that year or shrank."
    } ]
  }, {
    "tStartMs": 582579,
    "dDurationMs": 3263,
    "segs": [ {
      "utf8": "And over a long retirement, with that money compounding year after year,"
    } ]
  }, {
    "tStartMs": 585842,
    "dDurationMs": 2993,
    "segs": [ {
      "utf8": "that one small sounding percent can quietly cost you well over a"
    } ]
  }, {
    "tStartMs": 588835,
    "dDurationMs": 1672,
    "segs": [ {
      "utf8": "hundred thousand dollars across your lifetime."
    } ]
  }, {
    "tStartMs": 590507,
    "dDurationMs": 2583,
    "segs": [ {
      "utf8": "And that is before you count the separate yearly fee that the"
    } ]
  }, {
    "tStartMs": 593090,
    "dDurationMs": 8168,
    "segs": [ {
      "utf8": "funds your money sits inside often charge on top, a fee you"
    } ]
  }, {
    "tStartMs": 601258,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "never see on any statement."
    } ]
  }, {
    "tStartMs": 602259,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "So here is what you do."
    } ]
  }, {
    "tStartMs": 605792,
    "dDurationMs": 4679,
    "segs": [ {
      "utf8": "You ask whoever manages your money one direct question, and you do"
    } ]
  }, {
    "tStartMs": 610471,
    "dDurationMs": 1878,
    "segs": [ {
      "utf8": "not let them answer in percentages."
    } ]
  }, {
    "tStartMs": 612349,
    "dDurationMs": 2138,
    "segs": [ {
      "utf8": "What am I paying you in total every year, in actual dollars."
    } ]
  }, {
    "tStartMs": 614487,
    "dDurationMs": 4548,
    "segs": [ {
      "utf8": "And then you ask whether there is a simpler, lower cost option"
    } ]
  }, {
    "tStartMs": 621438,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "that does the same job."
    } ]
  }, {
    "tStartMs": 622178,
    "dDurationMs": 4759,
    "segs": [ {
      "utf8": "That one conversation can be worth more than all seven bank fees combined."
    } ]
  }, {
    "tStartMs": 626937,
    "dDurationMs": 688,
    "segs": [ {
      "utf8": "Now let me make the phone call itself easier, because I know"
    } ]
  }, {
    "tStartMs": 627625,
    "dDurationMs": 324,
    "segs": [ {
      "utf8": "that is the part most people quietly dread, and it is the"
    } ]
  }, {
    "tStartMs": 627949,
    "dDurationMs": 215,
    "segs": [ {
      "utf8": "real reason these fees go unchallenged for years."
    } ]
  }, {
    "tStartMs": 628164,
    "dDurationMs": 2342,
    "segs": [ {
      "utf8": "You do not need to argue and you do not need to be rude."
    } ]
  }, {
    "tStartMs": 630506,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "You simply call the number printed on the back of your card,"
    } ]
  }, {
    "tStartMs": 632369,
    "dDurationMs": 4924,
    "segs": [ {
      "utf8": "and when a real person answers, you say this."
    } ]
  }, {
    "tStartMs": 637293,
    "dDurationMs": 881,
    "segs": [ {
      "utf8": "I have been a loyal customer for many years, and I would"
    } ]
  }, {
    "tStartMs": 638174,
    "dDurationMs": 2743,
    "segs": [ {
      "utf8": "like to review the fees on my account and have them removed"
    } ]
  }, {
    "tStartMs": 640917,
    "dDurationMs": 1141,
    "segs": [ {
      "utf8": "or waived."
    } ]
  }, {
    "tStartMs": 642539,
    "dDurationMs": 3323,
    "segs": [ {
      "utf8": "Then you go down your circled list one charge at a time."
    } ]
  }, {
    "tStartMs": 646322,
    "dDurationMs": 2737,
    "segs": [ {
      "utf8": "If the person on the phone says they cannot help you, you"
    } ]
  }, {
    "tStartMs": 649059,
    "dDurationMs": 4921,
    "segs": [ {
      "utf8": "do not give up and you do not hang up."
    } ]
  }, {
    "tStartMs": 653980,
    "dDurationMs": 250,
    "segs": [ {
      "utf8": "You say five simple words."
    } ]
  }, {
    "tStartMs": 654230,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "May I speak with a supervisor."
    } ]
  }, {
    "tStartMs": 655051,
    "dDurationMs": 4665,
    "segs": [ {
      "utf8": "Because a supervisor is allowed to waive charges that the first person"
    } ]
  }, {
    "tStartMs": 659716,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "on the line is not."
    } ]
  }, {
    "tStartMs": 660316,
    "dDurationMs": 2052,
    "segs": [ {
      "utf8": "Stay calm, stay friendly, and stay on the line until you get"
    } ]
  }, {
    "tStartMs": 662368,
    "dDurationMs": 2093,
    "segs": [ {
      "utf8": "a real answer."
    } ]
  }, {
    "tStartMs": 664461,
    "dDurationMs": 5284,
    "segs": [ {
      "utf8": "Fifteen quiet minutes on the phone, just once, can save you hundreds"
    } ]
  }, {
    "tStartMs": 669745,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "of dollars every year for the rest of your life."
    } ]
  }, {
    "tStartMs": 670245,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Let me bring this together, because the thread running through every one"
    } ]
  }, {
    "tStartMs": 672685,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "of these is the same."
    } ]
  }, {
    "tStartMs": 675952,
    "dDurationMs": 5265,
    "segs": [ {
      "utf8": "The monthly fee, the overdraft fee, the cash machine fee, the wire"
    } ]
  }, {
    "tStartMs": 681217,
    "dDurationMs": 8248,
    "segs": [ {
      "utf8": "fee, the paper statement fee, the inactivity fee, the minimum balance fee,"
    } ]
  }, {
    "tStartMs": 689465,
    "dDurationMs": 1942,
    "segs": [ {
      "utf8": "the foreign transaction fee, and the management fee hiding off your statement."
    } ]
  }, {
    "tStartMs": 692108,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Every one of them is your money, leaving your account for nothing,"
    } ]
  }, {
    "tStartMs": 695608,
    "dDurationMs": 1345,
    "segs": [ {
      "utf8": "month after month, year after year."
    } ]
  }, {
    "tStartMs": 696953,
    "dDurationMs": 2342,
    "segs": [ {
      "utf8": "None of it is illegal."
    } ]
  }, {
    "tStartMs": 700677,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "The bank is allowed to charge every cent of it."
    } ]
  }, {
    "tStartMs": 703579,
    "dDurationMs": 881,
    "segs": [ {
      "utf8": "But you are also allowed to say no, and the only difference"
    } ]
  }, {
    "tStartMs": 704460,
    "dDurationMs": 6041,
    "segs": [ {
      "utf8": "between the person who pays all of these and the person who"
    } ]
  }, {
    "tStartMs": 710501,
    "dDurationMs": 3469,
    "segs": [ {
      "utf8": "pays none of them is simply knowing they exist and being willing"
    } ]
  }, {
    "tStartMs": 713970,
    "dDurationMs": 1254,
    "segs": [ {
      "utf8": "to make one phone call."
    } ]
  }, {
    "tStartMs": 715224,
    "dDurationMs": 5352,
    "segs": [ {
      "utf8": "Nobody at the bank is ever going to call you and offer"
    } ]
  }, {
    "tStartMs": 720576,
    "dDurationMs": 1922,
    "segs": [ {
      "utf8": "to lower your fees."
    } ]
  }, {
    "tStartMs": 722498,
    "dDurationMs": 6707,
    "segs": [ {
      "utf8": "The whole system is built so those small charges keep flowing quietly"
    } ]
  }, {
    "tStartMs": 729205,
    "dDurationMs": 2963,
    "segs": [ {
      "utf8": "out of your account for as long as you allow it."
    } ]
  }, {
    "tStartMs": 732168,
    "dDurationMs": 610,
    "segs": [ {
      "utf8": "The only person who can turn them off is you."
    } ]
  }, {
    "tStartMs": 732778,
    "dDurationMs": 350,
    "segs": [ {
      "utf8": "So this week, do one simple thing."
    } ]
  }, {
    "tStartMs": 733128,
    "dDurationMs": 5837,
    "segs": [ {
      "utf8": "Pull out your most recent bank statement, sit down at the kitchen"
    } ]
  }, {
    "tStartMs": 738965,
    "dDurationMs": 3713,
    "segs": [ {
      "utf8": "table, and read it line by line from top to bottom."
    } ]
  }, {
    "tStartMs": 742678,
    "dDurationMs": 3344,
    "segs": [ {
      "utf8": "Circle every charge you do not understand."
    } ]
  }, {
    "tStartMs": 747683,
    "dDurationMs": 4315,
    "segs": [ {
      "utf8": "Then pick up the phone and ask about each one, using the"
    } ]
  }, {
    "tStartMs": 751998,
    "dDurationMs": 1291,
    "segs": [ {
      "utf8": "exact words I gave you today."
    } ]
  }, {
    "tStartMs": 753289,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "Most of these will be gone within a week."
    } ]
  }, {
    "tStartMs": 755591,
    "dDurationMs": 2723,
    "segs": [ {
      "utf8": "And think back to Dorothy."
    } ]
  }, {
    "tStartMs": 758314,
    "dDurationMs": 1742,
    "segs": [ {
      "utf8": "The day she finally read one statement line by line and made"
    } ]
  }, {
    "tStartMs": 760056,
    "dDurationMs": 4044,
    "segs": [ {
      "utf8": "three short phone calls, she stopped paying almost every fee on this"
    } ]
  }, {
    "tStartMs": 764100,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "list, and she put real money back in her pocket every month"
    } ]
  }, {
    "tStartMs": 766422,
    "dDurationMs": 1246,
    "segs": [ {
      "utf8": "for the rest of her life."
    } ]
  }, {
    "tStartMs": 767668,
    "dDurationMs": 1647,
    "segs": [ {
      "utf8": "It was never that she could not afford to fix it."
    } ]
  }, {
    "tStartMs": 769315,
    "dDurationMs": 1852,
    "segs": [ {
      "utf8": "It was only that nobody had ever told her she could."
    } ]
  }, {
    "tStartMs": 771167,
    "dDurationMs": 2073,
    "segs": [ {
      "utf8": "So do one thing for me right now."
    } ]
  }, {
    "tStartMs": 773240,
    "dDurationMs": 6796,
    "segs": [ {
      "utf8": "Send this video to one person you care about who has had"
    } ]
  }, {
    "tStartMs": 783579,
    "dDurationMs": 1642,
    "segs": [ {
      "utf8": "the same bank account for decades and has never once questioned the"
    } ]
  }, {
    "tStartMs": 785221,
    "dDurationMs": 150,
    "segs": [ {
      "utf8": "fees on it."
    } ]
  }, {
    "tStartMs": 785371,
    "dDurationMs": 639,
    "segs": [ {
      "utf8": "A parent, a sibling, a friend, someone at your church living on"
    } ]
  }, {
    "tStartMs": 786010,
    "dDurationMs": 512,
    "segs": [ {
      "utf8": "a fixed income where every single dollar matters."
    } ]
  }, {
    "tStartMs": 786522,
    "dDurationMs": 810,
    "segs": [ {
      "utf8": "The odds are very good that they are paying at least three"
    } ]
  }, {
    "tStartMs": 787332,
    "dDurationMs": 3414,
    "segs": [ {
      "utf8": "of these fees right now for absolutely no reason, and one share"
    } ]
  }, {
    "tStartMs": 790746,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "from you could put real money back in their pocket every month"
    } ]
  }, {
    "tStartMs": 793989,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "for the rest of their life."
    } ]
  }, {
    "tStartMs": 795771,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "That is what we are here for."
    } ]
  }, {
    "tStartMs": 797693,
    "dDurationMs": 2923,
    "segs": [ {
      "utf8": "I will put a full checklist of these fees and the questions"
    } ]
  }, {
    "tStartMs": 800616,
    "dDurationMs": 1742,
    "segs": [ {
      "utf8": "to ask in the description below."
    } ]
  }, {
    "tStartMs": 802698,
    "dDurationMs": 1462,
    "segs": [ {
      "utf8": "I will see you in the next one."
    } ]
  } ]
}
