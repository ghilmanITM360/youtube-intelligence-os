{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "There is money in your house right now\nthat nobody else can prove exists."
    } ]
  }, {
    "tStartMs": 5560,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "The day you die, every account in your\nname locks."
    } ]
  }, {
    "tStartMs": 9560,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "The bank is told, the account freezes, the\nsafe deposit box is sealed shut"
    } ]
  }, {
    "tStartMs": 14480,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "with a court order waiting on it."
    } ]
  }, {
    "tStartMs": 17040,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "That is the part people know. Here is the\npart they do not."
    } ]
  }, {
    "tStartMs": 21180,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "In this country a drawer stays exactly as\nyou left it."
    } ]
  }, {
    "tStartMs": 24920,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "So does a closet shelf, a coffee tin, an\nenvelope taped under a mattress."
    } ]
  }, {
    "tStartMs": 30820,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The law reaches the bank in an afternoon."
    } ]
  }, {
    "tStartMs": 33400,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Your bedroom it leaves alone entirely."
    } ]
  }, {
    "tStartMs": 36620,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "So the money you kept at home because you\nwanted it close, because you wanted"
    } ]
  }, {
    "tStartMs": 40800,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "it out of their hands, because you\nremember what happened to your parents,"
    } ]
  }, {
    "tStartMs": 44680,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "sits there with the house full of people\nand no record anywhere that says how"
    } ]
  }, {
    "tStartMs": 49300,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "much it was. Before you decide this is\nabout somebody wealthier than you."
    } ]
  }, {
    "tStartMs": 54040,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "$2,000 in a drawer behaves exactly the\nsame way as $200,000."
    } ]
  }, {
    "tStartMs": 58900,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "The amount changes nothing about what\nfollows."
    } ]
  }, {
    "tStartMs": 61660,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "And this reaches the families who get on\nwell, the same as the ones who do"
    } ]
  }, {
    "tStartMs": 65640,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "not."
    } ]
  }, {
    "tStartMs": 66760,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Six things start moving the day you die,\nand four of them arrive whoever is"
    } ]
  }, {
    "tStartMs": 71080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "standing in the room."
    } ]
  }, {
    "tStartMs": 72700,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Six things. I will say each one out loud\nas we come to it, and the sixth is"
    } ]
  }, {
    "tStartMs": 76720,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "the one with a clock running on it."
    } ]
  }, {
    "tStartMs": 78440,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "Two words I will use. A payable on death\nform is the slip your bank keeps that"
    } ]
  }, {
    "tStartMs": 83840,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "says who gets the account."
    } ]
  }, {
    "tStartMs": 86000,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Probate is the court process that decides\nwhere everything else goes."
    } ]
  }, {
    "tStartMs": 90260,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Thing number one. The freeze reaches the\nbank."
    } ]
  }, {
    "tStartMs": 93380,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It does not reach your house."
    } ]
  }, {
    "tStartMs": 95420,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Work out what that means in a real room."
    } ]
  }, {
    "tStartMs": 97880,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The bank learns you have died, usually\nwithin days."
    } ]
  }, {
    "tStartMs": 102240,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "From that moment the account is closed to\neverybody."
    } ]
  }, {
    "tStartMs": 105740,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Your daughter cannot draw from it."
    } ]
  }, {
    "tStartMs": 107640,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Your husband cannot draw from it unless\nhis name is on it."
    } ]
  }, {
    "tStartMs": 111960,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "The box in the vault is sealed, and in\nmost states it takes a court order and"
    } ]
  }, {
    "tStartMs": 116720,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "a bank officer standing there to open it."
    } ]
  }, {
    "tStartMs": 119920,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Every one of those protections exists\nbecause the money is somewhere the law"
    } ]
  }, {
    "tStartMs": 124020,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "can see. Now walk down the hall to the\nbedroom."
    } ]
  }, {
    "tStartMs": 127540,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "The drawer answers to nobody. It stays\nexactly as you left it, and the only"
    } ]
  }, {
    "tStartMs": 132880,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "people who will ever count what is inside\nare the ones standing in that room"
    } ]
  }, {
    "tStartMs": 137260,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "with the door shut. The protection you\nhave been reading about for years, the"
    } ]
  }, {
    "tStartMs": 142660,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "freeze, the seal, the court order, all of\nit was built around a bank."
    } ]
  }, {
    "tStartMs": 148280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You kept your money out of the bank on\npurpose."
    } ]
  }, {
    "tStartMs": 151000,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "So you kept it out of all of that on\npurpose too, and that half of the bargain"
    } ]
  }, {
    "tStartMs": 155660,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "was left out of the conversation."
    } ]
  }, {
    "tStartMs": 158100,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "The first thing that happens to the money\nin your house is this."
    } ]
  }, {
    "tStartMs": 162060,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "It sits. Everything else in your estate\ngets a lock, a seal or a form, and"
    } ]
  }, {
    "tStartMs": 167420,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "your cash gets a room full of people."
    } ]
  }, {
    "tStartMs": 170220,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "That is the problem, and the five that\nfollow all grow out of it."
    } ]
  }, {
    "tStartMs": 175200,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Thing number two. Someone has to sign a\nlist of everything you owned, under"
    } ]
  }, {
    "tStartMs": 179600,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "oath. This is the part most families have\nnever heard of until they are inside"
    } ]
  }, {
    "tStartMs": 183940,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "it. Whoever takes charge of your estate\nhas to file a sworn inventory with"
    } ]
  }, {
    "tStartMs": 188520,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "the court. Not a rough idea. A list,\nsigned under oath, valued at what it was"
    } ]
  }, {
    "tStartMs": 194100,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "worth on the day you died. In Texas it is\ndue within 90 days of their appointment."
    } ]
  }, {
    "tStartMs": 199340,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "In California it is 4 months. In New York\nit is 9 months."
    } ]
  }, {
    "tStartMs": 203740,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "The deadlines move from state to state."
    } ]
  }, {
    "tStartMs": 206060,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "The duty does not. Now hold that against a\ndrawer full of cash."
    } ]
  }, {
    "tStartMs": 210160,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "They have to swear to a number they have\nno way of knowing."
    } ]
  }, {
    "tStartMs": 213340,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "If you kept $12,000 and they find nine,\nthe list says nine, and that becomes"
    } ]
  }, {
    "tStartMs": 218660,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "the official truth of what you owned."
    } ]
  }, {
    "tStartMs": 221020,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "If they never open the drawer at all, the\nlist says nothing, and the money"
    } ]
  }, {
    "tStartMs": 225160,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "leaves your estate without ever entering\nit."
    } ]
  }, {
    "tStartMs": 227940,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "And in Texas there is a line that should\nstop anybody who agrees to do this"
    } ]
  }, {
    "tStartMs": 231880,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "job. If estate property is lost or stolen\nbecause the person in charge failed"
    } ]
  }, {
    "tStartMs": 236580,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "to secure it, that person, or the bond\nthey posted, repays the value to the"
    } ]
  }, {
    "tStartMs": 241460,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "estate out of their own pocket."
    } ]
  }, {
    "tStartMs": 243420,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Read that as what it is. You are handing\nsomebody you love a legal duty to"
    } ]
  }, {
    "tStartMs": 247940,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "account for money you never told them the\namount of."
    } ]
  }, {
    "tStartMs": 251460,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Thing number three. Your payable on death\nform stops at the bank door."
    } ]
  }, {
    "tStartMs": 256200,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "A great many people have done one thing to\nprepare, and this is it."
    } ]
  }, {
    "tStartMs": 259580,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "They filled in a payable on death form at\nthe bank."
    } ]
  }, {
    "tStartMs": 262700,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Good. That form works. On the day you die,\nthe account named on it passes straight"
    } ]
  }, {
    "tStartMs": 267420,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "to the person named on it, with no court\ninvolved, sometimes within a week."
    } ]
  }, {
    "tStartMs": 271940,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Here is what that form is. It is an\ninstruction attached to an account."
    } ]
  }, {
    "tStartMs": 276560,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "The bank holds it because the bank holds\nthe account."
    } ]
  }, {
    "tStartMs": 279800,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Cash in a drawer is not in an account."
    } ]
  }, {
    "tStartMs": 282080,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "There is no institution holding it, so\nthere is no form that can be attached"
    } ]
  }, {
    "tStartMs": 285540,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "to it, and no instruction anybody can\nfollow."
    } ]
  }, {
    "tStartMs": 288300,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Which means every dollar you kept at home\ntravels the slow road."
    } ]
  }, {
    "tStartMs": 293160,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "It goes into the estate, through probate,\nin front of a judge, on a public"
    } ]
  }, {
    "tStartMs": 296740,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "record, and it can be argued over by\nanybody with standing to argue."
    } ]
  }, {
    "tStartMs": 300660,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So the very money you were most careful\nabout, the money you wanted to pass"
    } ]
  }, {
    "tStartMs": 304320,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "quietly, is the only money in your life\nthat cannot pass quietly."
    } ]
  }, {
    "tStartMs": 308920,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "The account you were careless about moves\nin a week."
    } ]
  }, {
    "tStartMs": 311880,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "The drawer takes months and is read aloud\nin open court."
    } ]
  }, {
    "tStartMs": 314980,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Thing number four. Any one of them can"
    } ]
  }, {
    "tStartMs": 318000,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "take that list to a judge and say\nsomething"
    } ]
  }, {
    "tStartMs": 320360,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "is missing."
    } ]
  }, {
    "tStartMs": 321680,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Here is where a family comes apart."
    } ]
  }, {
    "tStartMs": 323680,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Once that sworn list is filed, anybody\nwith an interest in your estate can"
    } ]
  }, {
    "tStartMs": 328060,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "file a written complaint with the court\nsaying property was left off it."
    } ]
  }, {
    "tStartMs": 332420,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "They do not need proof. They need a belief\nand a filing fee."
    } ]
  }, {
    "tStartMs": 336560,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "The court can then order a second list."
    } ]
  }, {
    "tStartMs": 339060,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "In Texas the order gives 20 days to\nproduce it."
    } ]
  }, {
    "tStartMs": 342320,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Think for a moment about what gets argued\nover."
    } ]
  }, {
    "tStartMs": 344440,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "The house is on the deed. The car is on a\ntitle."
    } ]
  }, {
    "tStartMs": 348500,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "The accounts have statements going back\nyears."
    } ]
  }, {
    "tStartMs": 351360,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "None of that is worth fighting about,\nbecause all of it can be checked."
    } ]
  }, {
    "tStartMs": 355360,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The cash is the only thing in your entire\nestate with no paper anywhere."
    } ]
  }, {
    "tStartMs": 359400,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So it is the only thing that can be\nclaimed and denied with nothing to settle"
    } ]
  }, {
    "tStartMs": 363060,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "it. One of them says there was always\nmoney in that drawer."
    } ]
  }, {
    "tStartMs": 366680,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Another remembers it differently."
    } ]
  }, {
    "tStartMs": 368140,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "There is no document to open, no officer\nto telephone, no record to pull, and"
    } ]
  }, {
    "tStartMs": 373480,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "no third person alive who looked inside."
    } ]
  }, {
    "tStartMs": 376480,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "By then the argument has stopped being\nabout money."
    } ]
  }, {
    "tStartMs": 379320,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "It is about which of them you trusted, and\nthey will carry it to their own"
    } ]
  }, {
    "tStartMs": 382540,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "graves. Thing number five. If Medicaid\npaid for your care, the state has a"
    } ]
  }, {
    "tStartMs": 387560,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "claim on what is left. This one is not a\nfamily matter and it does not care"
    } ]
  }, {
    "tStartMs": 391460,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "what anybody agreed to. If you were 55 or\nolder and Medicaid paid for long"
    } ]
  }, {
    "tStartMs": 396200,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "term care, nursing home care or care"
    } ]
  }, {
    "tStartMs": 398380,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "brought to you at home, federal law\nrequires"
    } ]
  }, {
    "tStartMs": 400760,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "your state to come back to your estate for\nthat money after you die."
    } ]
  }, {
    "tStartMs": 404500,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Cash is personal property. Personal\nproperty is part of an estate."
    } ]
  }, {
    "tStartMs": 408480,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "So the money in the drawer is inside the\nclaim."
    } ]
  }, {
    "tStartMs": 411640,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "And here is the turn that catches people."
    } ]
  }, {
    "tStartMs": 413680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "While you were alive, that cash was"
    } ]
  }, {
    "tStartMs": 415760,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "counted against you when they decided\nwhether"
    } ]
  }, {
    "tStartMs": 417860,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "you qualified for help at all."
    } ]
  }, {
    "tStartMs": 419340,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "After you die, the same cash is counted\nagain, this time to pay the bill."
    } ]
  }, {
    "tStartMs": 425080,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "The same dollars, twice, and in"
    } ]
  }, {
    "tStartMs": 427920,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "both directions it works against your\nhousehold."
    } ]
  }, {
    "tStartMs": 430820,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "There are real limits on this, and I will\ngive them to you straight rather"
    } ]
  }, {
    "tStartMs": 435220,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "than let you worry about something that\nmay not apply."
    } ]
  }, {
    "tStartMs": 438400,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "If your husband or wife is still living,\nyour estate is exempt while they are"
    } ]
  }, {
    "tStartMs": 443460,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "alive. If the estate is worth less than\nwhat is owed, the state cannot chase"
    } ]
  }, {
    "tStartMs": 448720,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "your children for the difference."
    } ]
  }, {
    "tStartMs": 450740,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "Some states exempt small estates outright,\nGeorgia at $25,000 and under."
    } ]
  }, {
    "tStartMs": 456980,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "States also run a hardship process, and it\nis worth asking about in writing."
    } ]
  }, {
    "tStartMs": 462160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Thing number six."
    } ]
  }, {
    "tStartMs": 463660,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "The house goes empty, and the policy\nstarts counting."
    } ]
  }, {
    "tStartMs": 467460,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "This is the one with the clock, and almost\nnobody sees it coming."
    } ]
  }, {
    "tStartMs": 471120,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Nearly every ordinary home insurance\npolicy"
    } ]
  }, {
    "tStartMs": 474100,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "in America contains a vacancy clause."
    } ]
  }, {
    "tStartMs": 477440,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "It says that once the house sits"
    } ]
  }, {
    "tStartMs": 478900,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "unoccupied for a set stretch, usually 30\ndays,"
    } ]
  }, {
    "tStartMs": 482820,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "sometimes 60,"
    } ]
  }, {
    "tStartMs": 484420,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "cover for certain kinds of loss stops."
    } ]
  }, {
    "tStartMs": 487640,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Some policies go further and treat the\nwhole thing as void."
    } ]
  }, {
    "tStartMs": 491280,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "The day you die, the clock starts."
    } ]
  }, {
    "tStartMs": 494020,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Not when probate finishes. Not when the\nfamily gets around to it."
    } ]
  }, {
    "tStartMs": 497740,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "From that day. And somebody driving over\nonce a week to collect the post and"
    } ]
  }, {
    "tStartMs": 502340,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "check the taps does not stop it."
    } ]
  }, {
    "tStartMs": 505060,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "Occupied means lived in. A house nobody\nsleeps in is empty, whatever anybody"
    } ]
  }, {
    "tStartMs": 510160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "tells the agent."
    } ]
  }, {
    "tStartMs": 511820,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "So picture the stretch of weeks that\nfollows a funeral."
    } ]
  }, {
    "tStartMs": 515100,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The family is scattered. The house sits\ndark."
    } ]
  }, {
    "tStartMs": 518720,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Day 30 passes, or day 60, and the cover\nthins or goes."
    } ]
  }, {
    "tStartMs": 523940,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Then a pipe bursts in February, or\nsomebody notices the post piling up on the"
    } ]
  }, {
    "tStartMs": 528500,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "step, and whatever was in that drawer was\nuninsured for weeks before anyone"
    } ]
  }, {
    "tStartMs": 532900,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "opened the policy to look. The one thing\nto do about it is a telephone call,"
    } ]
  }, {
    "tStartMs": 537560,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and it has to happen in the first month."
    } ]
  }, {
    "tStartMs": 540300,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "The insurer has to be told there has been\na death."
    } ]
  }, {
    "tStartMs": 543220,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Ask them two questions and write the\nanswers down."
    } ]
  }, {
    "tStartMs": 546580,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "How many days before the vacancy clause\napplies."
    } ]
  }, {
    "tStartMs": 549420,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "And what has to be done to keep cover in\nforce while the estate is settled."
    } ]
  }, {
    "tStartMs": 553440,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "Underneath all six is one thing, and it is\nthe whole reason this video exists."
    } ]
  }, {
    "tStartMs": 559700,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Everything that protects money in this\ncountry was built to protect money the"
    } ]
  }, {
    "tStartMs": 563680,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "government can already see. The freeze."
    } ]
  }, {
    "tStartMs": 566860,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "The seal. The court order. The form at the\nbank."
    } ]
  }, {
    "tStartMs": 570280,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Every one of those arrived because an\ninstitution was holding the money and"
    } ]
  }, {
    "tStartMs": 574000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a record existed."
    } ]
  }, {
    "tStartMs": 575600,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You kept cash at home to stay outside all\nthat."
    } ]
  }, {
    "tStartMs": 578420,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It worked. You are outside all of it."
    } ]
  }, {
    "tStartMs": 580820,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Here is where my ground runs out."
    } ]
  }, {
    "tStartMs": 583320,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "I do not know your family and I cannot see\nyour estate."
    } ]
  }, {
    "tStartMs": 586900,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Probate deadlines, what counts as your\nestate, and how the vacancy clause reads"
    } ]
  }, {
    "tStartMs": 590860,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "are set in your own state and your own\npolicy."
    } ]
  }, {
    "tStartMs": 593980,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "What any of this means for your household\nis a matter for a lawyer in your"
    } ]
  }, {
    "tStartMs": 597620,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "state, and most counties have a free legal\naid office for people over 60."
    } ]
  }, {
    "tStartMs": 602560,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "Six, in order, before you go. The freeze\nreaches the bank and stops there,"
    } ]
  }, {
    "tStartMs": 607500,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "because nothing locks a drawer."
    } ]
  }, {
    "tStartMs": 610760,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "Someone must swear to a list of what you\nowned, in 90 days in Texas, 4 months"
    } ]
  }, {
    "tStartMs": 616420,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "in California,"
    } ]
  }, {
    "tStartMs": 617880,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "9 months in New York, and in Texas they\nrepay from their own pocket what goes"
    } ]
  }, {
    "tStartMs": 622440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "missing on their watch."
    } ]
  }, {
    "tStartMs": 624380,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Your payable on death form reaches an\naccount and cannot reach a drawer, so"
    } ]
  }, {
    "tStartMs": 628900,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "that money goes the slow way, through\nprobate, in open court."
    } ]
  }, {
    "tStartMs": 632620,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "Any one of them can tell a judge the list\nis short, and the cash is the only"
    } ]
  }, {
    "tStartMs": 637560,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "thing in your estate with no paper to\nsettle it."
    } ]
  }, {
    "tStartMs": 640500,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "If Medicaid paid for your care after 55,\nthe state has a claim on what is left,"
    } ]
  }, {
    "tStartMs": 645760,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "and the same dollars that were counted\nagainst you while you lived are counted"
    } ]
  }, {
    "tStartMs": 649640,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "again after. And the house empties the day\nyou die, with 30 or 60 days before"
    } ]
  }, {
    "tStartMs": 654780,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "the policy thins out. If somebody\ntelephones offering to protect your estate"
    } ]
  }, {
    "tStartMs": 659140,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "for a fee, put the handset down."
    } ]
  }, {
    "tStartMs": 662200,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "No service and no payment changes a single\nthing on that list."
    } ]
  }, {
    "tStartMs": 666440,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "And if your mother or your father is\nkeeping money in the house, do not ask"
    } ]
  }, {
    "tStartMs": 670300,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "them how much. Ask them who knows where it\nis."
    } ]
  }, {
    "tStartMs": 673840,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "If the answer is nobody, you already know\nwhat happens."
    } ]
  } ]
}
