{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Two hundred dollars can leave your"
    } ]
  }, {
    "tStartMs": 1760,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "checking account without your card,\nwithout"
    } ]
  }, {
    "tStartMs": 3900,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "your signature, and without anyone\ntelephoning you."
    } ]
  }, {
    "tStartMs": 7580,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "You have sixty days from the day your\nstatement is sent to report it."
    } ]
  }, {
    "tStartMs": 11780,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Report it in time and you owe nothing."
    } ]
  }, {
    "tStartMs": 14840,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Miss that day and the two hundred is still\nyours to reclaim, but everything"
    } ]
  }, {
    "tStartMs": 18840,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "taken afterwards is not."
    } ]
  }, {
    "tStartMs": 21440,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Four hundred more goes out on day sixty\none, you speak on day sixty two, and"
    } ]
  }, {
    "tStartMs": 26300,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "that four hundred can be charged to you in\nfull."
    } ]
  }, {
    "tStartMs": 28860,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "That is not my example."
    } ]
  }, {
    "tStartMs": 32280,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "That is the example the regulator prints\nin its own rulebook."
    } ]
  }, {
    "tStartMs": 36340,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Most people over sixty five open"
    } ]
  }, {
    "tStartMs": 38660,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "a statement when something already feels\nwrong,"
    } ]
  }, {
    "tStartMs": 41240,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "and by then the sixty days are spent."
    } ]
  }, {
    "tStartMs": 44800,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "This is how the money goes out, what your\nbank is forced to do once you speak,"
    } ]
  }, {
    "tStartMs": 49360,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "and the deadlines that decide how much of\nit you carry yourself."
    } ]
  }, {
    "tStartMs": 53500,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "Number one is the thing almost nobody gets\nright, and getting it wrong costs"
    } ]
  }, {
    "tStartMs": 58980,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "people money every single week."
    } ]
  }, {
    "tStartMs": 61580,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "There are two completely different\nsituations, and they run on two different"
    } ]
  }, {
    "tStartMs": 65700,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "sets of rules. The first situation is a\ncard or a personal number that is lost"
    } ]
  }, {
    "tStartMs": 70960,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "or stolen. Somebody has the physical\nthing, or the numbers off the front of"
    } ]
  }, {
    "tStartMs": 75740,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "it, and they use it. The second situation\nis money pulled straight out of your"
    } ]
  }, {
    "tStartMs": 81380,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "account with no card involved at all."
    } ]
  }, {
    "tStartMs": 84100,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "A company sets up a payment. Someone who\ngot your account number off a check"
    } ]
  }, {
    "tStartMs": 88180,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "arranges a withdrawal."
    } ]
  }, {
    "tStartMs": 90340,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Nothing was taken from your pocket."
    } ]
  }, {
    "tStartMs": 92260,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "The money simply goes out. Now hold on to\nthe difference, because this is where"
    } ]
  }, {
    "tStartMs": 96840,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "people lose money they never had to lose."
    } ]
  }, {
    "tStartMs": 100000,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "In the first situation, the one with the\ncard, there are two early deadlines"
    } ]
  }, {
    "tStartMs": 104420,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "with two amounts attached."
    } ]
  }, {
    "tStartMs": 106780,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Tell your bank within two business days of\nfinding out, and the most you can"
    } ]
  }, {
    "tStartMs": 110980,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "be made to carry is fifty dollars."
    } ]
  }, {
    "tStartMs": 113920,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Wait longer than two business days and"
    } ]
  }, {
    "tStartMs": 116380,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "that ceiling rises to five hundred\ndollars."
    } ]
  }, {
    "tStartMs": 119560,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "In the second situation, the one with no\ncard, those two amounts do not exist"
    } ]
  }, {
    "tStartMs": 125440,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "at all. The rulebook says it in plain\nwords."
    } ]
  }, {
    "tStartMs": 129840,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Those first two limits do not apply to\nmoney taken without a card."
    } ]
  }, {
    "tStartMs": 134560,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "So what protects you in the second\nsituation."
    } ]
  }, {
    "tStartMs": 137280,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "One thing. Sixty days. And this matters\nmore for you than for anybody else,"
    } ]
  }, {
    "tStartMs": 143700,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "because the second situation is the common\none after sixty five."
    } ]
  }, {
    "tStartMs": 148340,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Very few people your age are having a card\nsnatched from their hand at a cash"
    } ]
  }, {
    "tStartMs": 152420,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "machine. What happens instead is a company\nthat keeps drawing money after being"
    } ]
  }, {
    "tStartMs": 157860,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "told to stop, or a payment arranged by\nsomebody who got your account details"
    } ]
  }, {
    "tStartMs": 162460,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "off a piece of paper you threw out."
    } ]
  }, {
    "tStartMs": 165400,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "Which means most older people are\nprotected by exactly one deadline, and it"
    } ]
  }, {
    "tStartMs": 170680,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "is the one nobody has ever told them\nabout."
    } ]
  }, {
    "tStartMs": 173680,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Number two is that deadline, and I want\nyou to be exact about where it starts,"
    } ]
  }, {
    "tStartMs": 178260,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "because people get this wrong and it costs\nthem everything that follows."
    } ]
  }, {
    "tStartMs": 183160,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Sixty days is counted from the day your\nbank sends the statement."
    } ]
  }, {
    "tStartMs": 187060,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Not the day it lands on your table."
    } ]
  }, {
    "tStartMs": 188780,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Not the day you open it. The day they send\nit."
    } ]
  }, {
    "tStartMs": 192300,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "So every day the statement sits closed is\na day off your sixty."
    } ]
  }, {
    "tStartMs": 196060,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "A person who opens their statement once a\nquarter has already spent the whole"
    } ]
  }, {
    "tStartMs": 200040,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "period before they look."
    } ]
  }, {
    "tStartMs": 202080,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Now the part that decides the money."
    } ]
  }, {
    "tStartMs": 204480,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "If you report inside those sixty days, you\ncarry nothing for that theft."
    } ]
  }, {
    "tStartMs": 208960,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Not fifty dollars, not five hundred,\nnothing."
    } ]
  }, {
    "tStartMs": 212160,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "The money goes back. If you go past sixty\ndays, the first theft is still yours"
    } ]
  }, {
    "tStartMs": 216700,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "to reclaim. Missing the deadline does not\nerase it."
    } ]
  }, {
    "tStartMs": 220100,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "What it does is remove the ceiling on\neverything taken afterwards."
    } ]
  }, {
    "tStartMs": 224440,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "The rulebook gives its own example, and I\nam reading it to you the way it is"
    } ]
  }, {
    "tStartMs": 228200,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "written. Two hundred dollars is taken from\nan account without permission and"
    } ]
  }, {
    "tStartMs": 231960,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "without a card. If the person reports it\nwithin sixty days of the statement"
    } ]
  }, {
    "tStartMs": 235860,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "being sent, they have no liability at all."
    } ]
  }, {
    "tStartMs": 238940,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "But if four hundred more is taken on day\nsixty one, and the person does not"
    } ]
  }, {
    "tStartMs": 242880,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "speak until day sixty two, they may be\nliable for the full four hundred."
    } ]
  }, {
    "tStartMs": 247520,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Sit with that for a moment. The first two\nhundred was never really the danger."
    } ]
  }, {
    "tStartMs": 251780,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "The danger was the second theft, the one\nthat only happened because the first"
    } ]
  }, {
    "tStartMs": 255680,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "one went unreported. That is what the\nsixty days is actually protecting you"
    } ]
  }, {
    "tStartMs": 259960,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "from. Not the money already gone."
    } ]
  }, {
    "tStartMs": 262520,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The money still coming. And thieves know\nthe pattern."
    } ]
  }, {
    "tStartMs": 266160,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Somebody who takes two hundred dollars and\nsees nothing happen for two months"
    } ]
  }, {
    "tStartMs": 269540,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "has learned that nobody is watching this\naccount."
    } ]
  }, {
    "tStartMs": 272700,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The second withdrawal is always bigger\nthan the first."
    } ]
  }, {
    "tStartMs": 276540,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Number three is what your bank is forced\nto do the moment you speak, and most"
    } ]
  }, {
    "tStartMs": 280840,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "people have no idea how strong this is."
    } ]
  }, {
    "tStartMs": 283600,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Once you tell them, they must begin\nlooking into it straight away."
    } ]
  }, {
    "tStartMs": 287240,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "They are not allowed to sit and wait for\nyou to put it in writing first."
    } ]
  }, {
    "tStartMs": 290800,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "A telephone call starts the clock."
    } ]
  }, {
    "tStartMs": 292900,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "They then have ten business days to finish\nlooking and tell you what they found."
    } ]
  }, {
    "tStartMs": 296960,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "If they cannot finish inside ten business\ndays, they are allowed more time,"
    } ]
  }, {
    "tStartMs": 300840,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "up to forty five days, but only on one\ncondition."
    } ]
  }, {
    "tStartMs": 304780,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "They must put the money back into"
    } ]
  }, {
    "tStartMs": 306140,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "your account first, while they carry on\nlooking."
    } ]
  }, {
    "tStartMs": 309180,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Read that again, because it is the part\nthat changes how the telephone call"
    } ]
  }, {
    "tStartMs": 312640,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "feels. The money goes back into your\naccount before they have decided anything."
    } ]
  }, {
    "tStartMs": 317180,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "You get the full use of it during the\nwhole investigation."
    } ]
  }, {
    "tStartMs": 320280,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "And within two business days of putting it\nback, they have to tell you the"
    } ]
  }, {
    "tStartMs": 323580,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "amount and the date they did it."
    } ]
  }, {
    "tStartMs": 325500,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "If they decide an error did happen, they\nmust correct it, and that includes"
    } ]
  }, {
    "tStartMs": 329680,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "giving back any fees they charged you and\nany interest you lost because the"
    } ]
  }, {
    "tStartMs": 334120,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "money was missing."
    } ]
  }, {
    "tStartMs": 336320,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "And when they give you their answer, they\nmust put their findings in writing,"
    } ]
  }, {
    "tStartMs": 340320,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "and they must tell you that you have the\nright to ask for the documents they"
    } ]
  }, {
    "tStartMs": 343580,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "relied on. If a bank tells you on the\ntelephone that they investigated and"
    } ]
  }, {
    "tStartMs": 348060,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "found nothing, you are entitled to see\nwhat they looked at."
    } ]
  }, {
    "tStartMs": 351700,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Ask for it by those words. The papers you\nrelied on."
    } ]
  }, {
    "tStartMs": 355380,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "There are longer periods in a few narrow\ncases, such as a payment that started"
    } ]
  }, {
    "tStartMs": 359800,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "outside the country or an account opened\nin the last thirty days."
    } ]
  }, {
    "tStartMs": 363840,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Those are the exceptions. For an ordinary\nchecking account that has been open"
    } ]
  }, {
    "tStartMs": 367900,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "for years, ten business days or\nprovisional money back is the rule."
    } ]
  }, {
    "tStartMs": 372580,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "And notice what none of this depends on."
    } ]
  }, {
    "tStartMs": 374860,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "It does not depend on the branch liking\nyou."
    } ]
  }, {
    "tStartMs": 377340,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "It does not depend on how long you have\nbanked there, or on whether the person"
    } ]
  }, {
    "tStartMs": 381020,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "answering the telephone believes your\nstory."
    } ]
  }, {
    "tStartMs": 383120,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "These are steps a bank is required to take\nonce it has been told, and the requirement"
    } ]
  }, {
    "tStartMs": 388220,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "starts from the words you say, not from a\ndecision anybody makes about you"
    } ]
  }, {
    "tStartMs": 392280,
    "dDurationMs": 520,
    "segs": [ {
      "utf8": "afterwards."
    } ]
  }, {
    "tStartMs": 393640,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Number four will surprise you, and it is\nwritten into the rules in a single"
    } ]
  }, {
    "tStartMs": 397340,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "hard sentence."
    } ]
  }, {
    "tStartMs": 398880,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Being careless cannot be used against you."
    } ]
  }, {
    "tStartMs": 401680,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "If you wrote your personal number on the\ncard itself, or on a slip of paper"
    } ]
  }, {
    "tStartMs": 405460,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "in the same wallet as the card, that does\nnot increase one dollar of what you"
    } ]
  }, {
    "tStartMs": 409440,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "owe. The rulebook states it directly."
    } ]
  }, {
    "tStartMs": 412440,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Carelessness by the customer cannot be\nused as a reason to make that customer"
    } ]
  }, {
    "tStartMs": 416520,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "carry more than the limits allow."
    } ]
  }, {
    "tStartMs": 418840,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "I want you to hear why that sentence\nexists."
    } ]
  }, {
    "tStartMs": 421540,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Banks used to argue exactly this."
    } ]
  }, {
    "tStartMs": 424000,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "You were careless, so this is your own\ndoing, so you are paying for it."
    } ]
  }, {
    "tStartMs": 428220,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "That argument was taken away from them and\nwritten out of the rules on purpose."
    } ]
  }, {
    "tStartMs": 432020,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "So if you telephone your bank and somebody\nsuggests that you brought this on"
    } ]
  }, {
    "tStartMs": 437420,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "yourself, that person is either mistaken\nor hoping you will accept it and hang"
    } ]
  }, {
    "tStartMs": 442480,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "up."
    } ]
  }, {
    "tStartMs": 443520,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "What you owe is decided by one thing only."
    } ]
  }, {
    "tStartMs": 446600,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "How quickly you reported it. Nothing else."
    } ]
  }, {
    "tStartMs": 449980,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Not your age, not your habits, not where\nyou kept the card."
    } ]
  }, {
    "tStartMs": 454040,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The same section says something else worth\ncarrying."
    } ]
  }, {
    "tStartMs": 456600,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "No agreement you signed with your bank can\nmake you liable for more than these"
    } ]
  }, {
    "tStartMs": 461220,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "limits. If there is a paragraph in your\naccount paperwork that says otherwise,"
    } ]
  }, {
    "tStartMs": 466240,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "it does not stand. And if your state has a\nlaw that gives you better protection"
    } ]
  }, {
    "tStartMs": 471100,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "than this, the better one applies."
    } ]
  }, {
    "tStartMs": 474360,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Number five was written for exactly the\nthing that happens to people your age,"
    } ]
  }, {
    "tStartMs": 478640,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and almost nobody knows it is in there."
    } ]
  }, {
    "tStartMs": 481580,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "If the reason you could not report in time\nwas outside your control, the bank"
    } ]
  }, {
    "tStartMs": 487060,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "is required to give you longer."
    } ]
  }, {
    "tStartMs": 489500,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "Not may. Is required to. The rules name\nthe circumstances, and the two named"
    } ]
  }, {
    "tStartMs": 495540,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "in the official text are being in hospital\nand being away from home for an"
    } ]
  }, {
    "tStartMs": 500060,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "extended period. A person who spends three\nweeks in a hospital bed and comes"
    } ]
  }, {
    "tStartMs": 504780,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "home to two months of mail nobody sorted\nis precisely the person that sentence"
    } ]
  }, {
    "tStartMs": 509420,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "was written for. So if you missed the\nsixty days because you were ill, or in"
    } ]
  }, {
    "tStartMs": 514540,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "a care setting, or away, say so, and say\nit early in the call."
    } ]
  }, {
    "tStartMs": 519560,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "Those exact circumstances require the bank\nto extend the period to a reasonable"
    } ]
  }, {
    "tStartMs": 524760,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "one. And there is a second protection\nsitting beside it."
    } ]
  }, {
    "tStartMs": 528760,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Somebody else can report it for you, and\nit counts as if you did it yourself."
    } ]
  }, {
    "tStartMs": 533380,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "If you are in a hospital bed and cannot\nmake the call, your daughter can make"
    } ]
  }, {
    "tStartMs": 537620,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "it, and the law treats that as your\nnotice."
    } ]
  }, {
    "tStartMs": 540580,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "The bank may ask her to show she is acting\nfor you, but the notice stands from"
    } ]
  }, {
    "tStartMs": 544920,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "the moment she speaks. One more thing in\nthat same part, and it removes the"
    } ]
  }, {
    "tStartMs": 549360,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "last excuse people give themselves for not\ncalling."
    } ]
  }, {
    "tStartMs": 552540,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "You do not need the account number."
    } ]
  }, {
    "tStartMs": 554700,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "You do not need the card number."
    } ]
  }, {
    "tStartMs": 556240,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "If you can identify the account well\nenough for them to find it, by the name"
    } ]
  }, {
    "tStartMs": 560640,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "on it and the type of account, your notice\ncounts."
    } ]
  }, {
    "tStartMs": 564740,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "People put off calling because they cannot\nfind the paperwork."
    } ]
  }, {
    "tStartMs": 568560,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "The paperwork is not required to start the\nclock."
    } ]
  }, {
    "tStartMs": 571880,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Here are the steps, and one note before\nthem."
    } ]
  }, {
    "tStartMs": 574900,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Everything in this video is general\ninformation about rules that apply across"
    } ]
  }, {
    "tStartMs": 579160,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "the country. It is not advice about your\naccount, so read your own agreement"
    } ]
  }, {
    "tStartMs": 583920,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "and speak to your own bank, because banks\ndiffer in what they offer beyond"
    } ]
  }, {
    "tStartMs": 588720,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "the minimum. Go and get your last two\nstatements today."
    } ]
  }, {
    "tStartMs": 593460,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Not this week. Today."
    } ]
  }, {
    "tStartMs": 595980,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Look at every line that left the account\nand put a mark next to anything you"
    } ]
  }, {
    "tStartMs": 600160,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "cannot name. You are not looking for large\namounts."
    } ]
  }, {
    "tStartMs": 604140,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "You are looking for small ones you do not\nknow, because that is how it starts."
    } ]
  }, {
    "tStartMs": 609580,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "A thief takes four dollars first to see\nwhether anybody notices, and when nobody"
    } ]
  }, {
    "tStartMs": 614520,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "does, they come back for the rest."
    } ]
  }, {
    "tStartMs": 617080,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "If you find one, telephone the bank the\nsame day and use plain words."
    } ]
  }, {
    "tStartMs": 622160,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "There is a payment on my account that I\nnever agreed to, and I am reporting"
    } ]
  }, {
    "tStartMs": 626280,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "it now. Say the date it came out and the\namount."
    } ]
  }, {
    "tStartMs": 630960,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Then write down the date you called, the\ntime, and the name of the person you"
    } ]
  }, {
    "tStartMs": 635480,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "spoke to. That note is what proves when\nyour sixty days stopped running, and"
    } ]
  }, {
    "tStartMs": 640700,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "if there is ever an argument about it, it\nis the only thing you will have."
    } ]
  }, {
    "tStartMs": 645520,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Then ask one question before you hang up."
    } ]
  }, {
    "tStartMs": 648760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "When will I receive your findings in\nwriting."
    } ]
  }, {
    "tStartMs": 651660,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "That single question tells the person on\nthe line that you know there is a"
    } ]
  }, {
    "tStartMs": 655660,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "deadline, and it changes the call."
    } ]
  }, {
    "tStartMs": 658000,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "If more than ten business days pass and no\nmoney has come back and no answer"
    } ]
  }, {
    "tStartMs": 663660,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "has arrived,"
    } ]
  }, {
    "tStartMs": 665100,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "telephone again and say the words\nprovisional credit."
    } ]
  }, {
    "tStartMs": 668640,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "That is the phrase for money returned to\nyou while they are still looking."
    } ]
  }, {
    "tStartMs": 673800,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "And put a date in your calendar for the\nday each statement arrives from now"
    } ]
  }, {
    "tStartMs": 678180,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "on. Ten minutes, once a month, is the\nwhole defense."
    } ]
  }, {
    "tStartMs": 683180,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Now the warning, and this one is aimed at\nthe exact moment you are in right"
    } ]
  }, {
    "tStartMs": 687040,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "now. Nobody from your bank will ever\ntelephone you and ask you to move your"
    } ]
  }, {
    "tStartMs": 692040,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "money to a safe account. There is no such\nthing as a safe account."
    } ]
  }, {
    "tStartMs": 696240,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "That call is the crime itself, and it is\naimed at people who have just been"
    } ]
  }, {
    "tStartMs": 701460,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "told to watch their statements."
    } ]
  }, {
    "tStartMs": 704080,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Your bank does not need your personal\nnumber to look at your own account."
    } ]
  }, {
    "tStartMs": 708800,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "If a caller asks for it, hang up and\ntelephone the number printed on your own"
    } ]
  }, {
    "tStartMs": 713920,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "card. So there they are, one last time."
    } ]
  }, {
    "tStartMs": 717900,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Money taken with a card and money taken\nwithout one run on different rules,"
    } ]
  }, {
    "tStartMs": 722200,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "and after sixty five you are almost always\nin the second one."
    } ]
  }, {
    "tStartMs": 726700,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Sixty days from the day the statement is\nsent, and it protects you from the"
    } ]
  }, {
    "tStartMs": 730500,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "second theft more than the first."
    } ]
  }, {
    "tStartMs": 733020,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Once you speak, they have ten business\ndays or they must put the money back"
    } ]
  }, {
    "tStartMs": 737000,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "while they keep looking. Being careless\ncannot be used to make you carry more."
    } ]
  }, {
    "tStartMs": 742920,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "And if you were ill or away, they are\nrequired to give you longer, and somebody"
    } ]
  }, {
    "tStartMs": 747860,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "else can speak for you. None of this is\nhidden."
    } ]
  }, {
    "tStartMs": 750720,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "It is printed in the rules that every bank\nin this country already follows."
    } ]
  }, {
    "tStartMs": 756080,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "It works the way it does because the\nburden of noticing was put on you, and"
    } ]
  }, {
    "tStartMs": 760520,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "nobody was given the job of telling you\nthat."
    } ]
  }, {
    "tStartMs": 763740,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Go and look at your statements tonight."
    } ]
  }, {
    "tStartMs": 765800,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "If somebody in your family has not opened\na bank statement in two months, telephone"
    } ]
  }, {
    "tStartMs": 770140,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "them and ask them to open it while you are\non the line."
    } ]
  } ]
}
