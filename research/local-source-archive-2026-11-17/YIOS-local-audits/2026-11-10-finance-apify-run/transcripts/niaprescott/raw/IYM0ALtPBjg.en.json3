{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "Money is leaving your payments every month\nand going to the government, and"
    } ]
  }, {
    "tStartMs": 4940,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "you never agreed to it out loud."
    } ]
  }, {
    "tStartMs": 7260,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "You did not write a check. You did not get\na bill."
    } ]
  }, {
    "tStartMs": 10940,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "It comes out before the money reaches your\nbank, and at the end of the year"
    } ]
  }, {
    "tStartMs": 15420,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "part of it is handed back and called a\nrefund."
    } ]
  }, {
    "tStartMs": 18980,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "That is not a gift. That is your own money\ncoming home late, with nothing added"
    } ]
  }, {
    "tStartMs": 24300,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "for the year the government held on to it."
    } ]
  }, {
    "tStartMs": 26340,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "Most people over sixty five have no idea\nthis is happening to them, and fewer"
    } ]
  }, {
    "tStartMs": 31180,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "still know it can be switched off in one\nsingle afternoon."
    } ]
  }, {
    "tStartMs": 35740,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "And almost nobody knows Number one, which\nis that after three years the money"
    } ]
  }, {
    "tStartMs": 40200,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "you overpaid stops being yours forever,\nand no notice arrives to tell you the"
    } ]
  }, {
    "tStartMs": 45120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "door has closed."
    } ]
  }, {
    "tStartMs": 47060,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Twelve things. Number three catches people\nwho are still working."
    } ]
  }, {
    "tStartMs": 50980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Let us begin."
    } ]
  }, {
    "tStartMs": 52420,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Number twelve. Look at your Social\nSecurity statement."
    } ]
  }, {
    "tStartMs": 56140,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Every January the Social Security\nAdministration sends you a form called the"
    } ]
  }, {
    "tStartMs": 60740,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "S S A ten ninety nine."
    } ]
  }, {
    "tStartMs": 62840,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "On it there is a box marked voluntary\nfederal income tax withheld."
    } ]
  }, {
    "tStartMs": 67460,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "If there is a figure sitting in that box,\nmoney has been coming out of your"
    } ]
  }, {
    "tStartMs": 71200,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "check all year long, month after month,\nwithout you doing a thing."
    } ]
  }, {
    "tStartMs": 75960,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Most people read the top line of that form\nand put it aside."
    } ]
  }, {
    "tStartMs": 79740,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Go and find the copy from last year and\nread that one box."
    } ]
  }, {
    "tStartMs": 82960,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "If you cannot find your copy, you can ask\nthe Social Security Administration"
    } ]
  }, {
    "tStartMs": 87280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "for another one, and it costs nothing."
    } ]
  }, {
    "tStartMs": 90160,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "If the figure is anything other than zero,\nthe rest of this video is about"
    } ]
  }, {
    "tStartMs": 94040,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "you."
    } ]
  }, {
    "tStartMs": 95560,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Number eleven. If you draw a pension or an\nannuity, the company that pays you"
    } ]
  }, {
    "tStartMs": 100140,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "sends a different form. It is called the\nten ninety nine R, and it has its"
    } ]
  }, {
    "tStartMs": 104900,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "own separate box for federal income tax\nwithheld."
    } ]
  }, {
    "tStartMs": 108160,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "These are two different taps, and turning\none of them off does nothing at all"
    } ]
  }, {
    "tStartMs": 113360,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "to the other one. A woman can stop the tax\ncoming out of her Social Security,"
    } ]
  }, {
    "tStartMs": 118300,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "feel satisfied that she has fixed it, and\nstill have money leaving her pension"
    } ]
  }, {
    "tStartMs": 122260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "every single month."
    } ]
  }, {
    "tStartMs": 124080,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Nobody told her the two were run by\ndifferent offices and needed two different"
    } ]
  }, {
    "tStartMs": 128080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "instructions."
    } ]
  }, {
    "tStartMs": 129440,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Check both forms. Write the two figures\ndown side by side and add them together."
    } ]
  }, {
    "tStartMs": 134160,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "That total is what you are sending in\nevery year without ever deciding to."
    } ]
  }, {
    "tStartMs": 139480,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Number ten. Money taken out of"
    } ]
  }, {
    "tStartMs": 141560,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "a retirement account arrives smaller than\nyou"
    } ]
  }, {
    "tStartMs": 144000,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "asked for. When you pull money out of an\nindividual retirement account, the"
    } ]
  }, {
    "tStartMs": 148240,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "company holding it may take federal tax\nout before the money ever reaches your"
    } ]
  }, {
    "tStartMs": 152540,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "bank. You asked for one thousand dollars."
    } ]
  }, {
    "tStartMs": 155420,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Something less than one thousand dollars\nlanded."
    } ]
  }, {
    "tStartMs": 158140,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "That gap was tax, and it went out under a\ndefault setting."
    } ]
  }, {
    "tStartMs": 161720,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "A default is something that happens unless\nyou tell somebody otherwise."
    } ]
  }, {
    "tStartMs": 166720,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "People assume they filled the paperwork in\nwrong."
    } ]
  }, {
    "tStartMs": 169320,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "They did not, and nothing went wrong at\nall."
    } ]
  }, {
    "tStartMs": 171960,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "The system did exactly what it does when\nno one gives it a different instruction,"
    } ]
  }, {
    "tStartMs": 175820,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "which is to take the money and move on."
    } ]
  }, {
    "tStartMs": 179080,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Number nine. Three different checks, three\ndifferent forms."
    } ]
  }, {
    "tStartMs": 182860,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "This is the point where most people give\nup, so here it is in the plainest"
    } ]
  }, {
    "tStartMs": 186660,
    "dDurationMs": 5373,
    "segs": [ {
      "utf8": "terms I can manage. For Social Security\nthe form is called W four V."
    } ]
  }, {
    "tStartMs": 192073,
    "dDurationMs": 3987,
    "segs": [ {
      "utf8": "For a regular pension or annuity payment\nit is W four P."
    } ]
  }, {
    "tStartMs": 196100,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "For money taken out of a retirement\naccount or rolled over it is W four R."
    } ]
  }, {
    "tStartMs": 200860,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Three forms, one for each kind of payment."
    } ]
  }, {
    "tStartMs": 203680,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "You do not need all three of them."
    } ]
  }, {
    "tStartMs": 205480,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "You need the ones that match the checks\nthat actually arrive at your house."
    } ]
  }, {
    "tStartMs": 209380,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Write down which payments come in each\nmonth, and that short list tells you"
    } ]
  }, {
    "tStartMs": 212940,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "which forms you need. You can stop\nworrying about the rest of them."
    } ]
  }, {
    "tStartMs": 216340,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Number eight. On Social Security you\nchoose the percentage yourself."
    } ]
  }, {
    "tStartMs": 221540,
    "dDurationMs": 4113,
    "segs": [ {
      "utf8": "The Social Security Administration will\nwithhold seven percent, ten percent,"
    } ]
  }, {
    "tStartMs": 225693,
    "dDurationMs": 2647,
    "segs": [ {
      "utf8": "twelve percent, or twenty two percent of\nyour monthly payment."
    } ]
  }, {
    "tStartMs": 228980,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Those four figures are the only choices on\noffer."
    } ]
  }, {
    "tStartMs": 231940,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "There is no five percent and there is no\nfifteen percent, so do not go looking"
    } ]
  }, {
    "tStartMs": 235900,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "for one. Now do the arithmetic on your own\ncheck."
    } ]
  }, {
    "tStartMs": 239480,
    "dDurationMs": 3198,
    "segs": [ {
      "utf8": "Seven percent of a two thousand dollar\nmonthly payment is one hundred and forty"
    } ]
  }, {
    "tStartMs": 242920,
    "dDurationMs": 3249,
    "segs": [ {
      "utf8": "dollars. Over twelve months that comes to\none thousand six hundred and eighty"
    } ]
  }, {
    "tStartMs": 246169,
    "dDurationMs": 1191,
    "segs": [ {
      "utf8": "dollars."
    } ]
  }, {
    "tStartMs": 247400,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Twenty two percent of that same payment is\nfour hundred and forty dollars a"
    } ]
  }, {
    "tStartMs": 250800,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "month, which is five thousand two hundred\nand eighty dollars a year."
    } ]
  }, {
    "tStartMs": 254680,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "You can set this up, change it, or stop it\ninside your my Social Security account"
    } ]
  }, {
    "tStartMs": 259040,
    "dDurationMs": 4239,
    "segs": [ {
      "utf8": "online. If you would rather speak to a\nperson, the number is eight double zero,"
    } ]
  }, {
    "tStartMs": 263319,
    "dDurationMs": 2486,
    "segs": [ {
      "utf8": "seven seven two, one two one three."
    } ]
  }, {
    "tStartMs": 266460,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Number seven. Stopping is not the same as\nchoosing the smallest number."
    } ]
  }, {
    "tStartMs": 270540,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "There is no zero percent option on that\nlist."
    } ]
  }, {
    "tStartMs": 273320,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "If you want nothing taken out at all, you\ndo not pick a smaller figure off"
    } ]
  }, {
    "tStartMs": 276860,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "the four. You stop the withholding"
    } ]
  }, {
    "tStartMs": 278700,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "altogether, and that is a separate\ninstruction"
    } ]
  }, {
    "tStartMs": 281180,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "that you have to ask for in those exact\nwords."
    } ]
  }, {
    "tStartMs": 284380,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "People get this wrong constantly."
    } ]
  }, {
    "tStartMs": 286180,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "They look at the four choices, take the\nsmallest one because it feels safest,"
    } ]
  }, {
    "tStartMs": 290620,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and walk away believing they have solved\nthe problem."
    } ]
  }, {
    "tStartMs": 293500,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Seven percent is still one hundred and\nforty dollars a month leaving a household"
    } ]
  }, {
    "tStartMs": 297080,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "that may owe nothing at all for the entire\nyear."
    } ]
  }, {
    "tStartMs": 299680,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Number six. Work out whether you owe\nanything before you touch a single form."
    } ]
  }, {
    "tStartMs": 304240,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "I will keep this short because I have gone\nthrough the arithmetic elsewhere."
    } ]
  }, {
    "tStartMs": 308320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Add up everything that came in for the\nyear."
    } ]
  }, {
    "tStartMs": 310600,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Then subtract the standard deduction,\nincluding the extra amount the law gives"
    } ]
  }, {
    "tStartMs": 314700,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "to people over sixty five."
    } ]
  }, {
    "tStartMs": 316720,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "For many seniors living on Social Security\nand a modest pension, the answer"
    } ]
  }, {
    "tStartMs": 320800,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "is not a small tax bill. The answer is\nzero."
    } ]
  }, {
    "tStartMs": 324460,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "Not almost zero. Zero. And if that is you,\nthen every dollar withheld last"
    } ]
  }, {
    "tStartMs": 329580,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "year was a loan to the government, paying\nno interest, arranged without your"
    } ]
  }, {
    "tStartMs": 334180,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "knowledge and never once explained to you."
    } ]
  }, {
    "tStartMs": 337200,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Number five. Some of you are not required\nto file at all, and that is the trap."
    } ]
  }, {
    "tStartMs": 342180,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "If your income sits below the filing\nthreshold, the law does not require you"
    } ]
  }, {
    "tStartMs": 346040,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "to send in a return. A lot of seniors are\nin exactly that position, they know"
    } ]
  }, {
    "tStartMs": 350580,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "it, and so they stop filing. That part is\nperfectly correct and nobody is doing"
    } ]
  }, {
    "tStartMs": 355360,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "anything wrong."
    } ]
  }, {
    "tStartMs": 356900,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Now here is the problem with it."
    } ]
  }, {
    "tStartMs": 358620,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "If tax was withheld from your payments and\nyou never file, nobody sends that"
    } ]
  }, {
    "tStartMs": 362940,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "money back to you. A refund is not"
    } ]
  }, {
    "tStartMs": 365200,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "automatic and it is not triggered by\nanything."
    } ]
  }, {
    "tStartMs": 368100,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "It is a claim. Somebody has to make that\nclaim, and the only person who can"
    } ]
  }, {
    "tStartMs": 372100,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "make it is you."
    } ]
  }, {
    "tStartMs": 374000,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Number four. If you are still working\nafter sixty five, there is a third tap"
    } ]
  }, {
    "tStartMs": 378060,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "open. Wages have tax withheld too, and the\nform for that one is the plain W"
    } ]
  }, {
    "tStartMs": 383060,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "four you filled in on your first day."
    } ]
  }, {
    "tStartMs": 385740,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Many people have not looked at it in\ntwenty years, and the household it was"
    } ]
  }, {
    "tStartMs": 389320,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "written for does not exist any more."
    } ]
  }, {
    "tStartMs": 391960,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Children moved out. A spouse retired."
    } ]
  }, {
    "tStartMs": 394780,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "The figures on it stopped being true a\nlong time ago."
    } ]
  }, {
    "tStartMs": 398160,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "If you are working part time, and drawing\nSocial Security, and drawing a pension,"
    } ]
  }, {
    "tStartMs": 404180,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "money may be leaving from three directions\nat the same time."
    } ]
  }, {
    "tStartMs": 408320,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "The three offices do not talk to each\nother."
    } ]
  }, {
    "tStartMs": 411560,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Nothing anywhere adds them up for you."
    } ]
  }, {
    "tStartMs": 413760,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "That job belongs to you and nobody else is\ngoing to do it."
    } ]
  }, {
    "tStartMs": 417680,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "Number three."
    } ]
  }, {
    "tStartMs": 418840,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Your state may be taking a separate cut of\nthe same money."
    } ]
  }, {
    "tStartMs": 422840,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Federal withholding and state withholding\nare two different things, run by"
    } ]
  }, {
    "tStartMs": 426920,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "two different offices, on two different\nforms."
    } ]
  }, {
    "tStartMs": 430480,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Stopping the federal one does nothing\nwhatsoever to the state one, and a lot"
    } ]
  }, {
    "tStartMs": 434920,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "of people find that out years later."
    } ]
  }, {
    "tStartMs": 436860,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Some states do not tax retirement income\nat all."
    } ]
  }, {
    "tStartMs": 440820,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Others tax it in full. And if your pension\nis paid out of a state you no longer"
    } ]
  }, {
    "tStartMs": 445500,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "live in, the state that gets to tax it is\ndecided by your address today, not"
    } ]
  }, {
    "tStartMs": 450640,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "by the office you retired from."
    } ]
  }, {
    "tStartMs": 453020,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Look at your statement again and see\nwhether a state figure sits next to the"
    } ]
  }, {
    "tStartMs": 456700,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "federal one. Many people find a second\nnumber there they had never once noticed."
    } ]
  }, {
    "tStartMs": 461100,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Number two. Before you switch anything\noff, understand the other side of it."
    } ]
  }, {
    "tStartMs": 465280,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "If you stop withholding and it turns out\nyou do owe tax at the end of the year,"
    } ]
  }, {
    "tStartMs": 469880,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "the government can add a charge for not\nhaving paid enough during the year."
    } ]
  }, {
    "tStartMs": 473740,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "That is real, it happens, and I am not\ngoing to pretend it away to make this"
    } ]
  }, {
    "tStartMs": 477980,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "video easier to listen to. The protection\nis straightforward."
    } ]
  }, {
    "tStartMs": 482060,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "If you genuinely owe nothing, there is\nnothing to underpay and no charge can"
    } ]
  }, {
    "tStartMs": 486120,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "apply to you. If you do owe something, you\neither leave a small percentage"
    } ]
  }, {
    "tStartMs": 490240,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "running or you send payments in yourself\nacross the year."
    } ]
  }, {
    "tStartMs": 493420,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "The Internal Revenue Service publication\non withholding and estimated tax sets"
    } ]
  }, {
    "tStartMs": 498520,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "out those rules, and it costs nothing to\nread."
    } ]
  }, {
    "tStartMs": 501780,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Number one. The refund that is already\ngone."
    } ]
  }, {
    "tStartMs": 505080,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "The Internal Revenue Service is plain\nabout this."
    } ]
  }, {
    "tStartMs": 507900,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "If you are owed a refund for tax that was\nwithheld from you, you must file"
    } ]
  }, {
    "tStartMs": 511940,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "a return to claim it within three years of\nthe date that return was due."
    } ]
  }, {
    "tStartMs": 516140,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Three years. Not four. Not whenever you\nget around to it."
    } ]
  }, {
    "tStartMs": 519680,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "After that, the money stops being yours."
    } ]
  }, {
    "tStartMs": 522600,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It is not sitting in an account with your\nname on it."
    } ]
  }, {
    "tStartMs": 525320,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "It is not waiting patiently for you to\nask."
    } ]
  }, {
    "tStartMs": 527880,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "The claim expires, the government keeps\nwhat you overpaid, and nothing at all"
    } ]
  }, {
    "tStartMs": 532380,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "arrives in the mail to tell you it has\nhappened."
    } ]
  }, {
    "tStartMs": 535460,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "So if you have not filed in a while, and\ntax was coming out of your payments"
    } ]
  }, {
    "tStartMs": 539020,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "that whole time, there is a window open\nright now and part of it has already"
    } ]
  }, {
    "tStartMs": 543420,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "shut behind you. The years furthest back\ngo first, and they go on a fixed date"
    } ]
  }, {
    "tStartMs": 548420,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "that nobody announces to you. Here is how\nto find out exactly how much is still"
    } ]
  }, {
    "tStartMs": 552860,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "there."
    } ]
  }, {
    "tStartMs": 553960,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Ask the Internal Revenue Service for a\nwage and income transcript."
    } ]
  }, {
    "tStartMs": 557900,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "That document lists what every payer\nreported about you, including the tax"
    } ]
  }, {
    "tStartMs": 561980,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "they withheld, year by year, in writing."
    } ]
  }, {
    "tStartMs": 565200,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "You can pull it through your online\naccount with the Internal Revenue Service,"
    } ]
  }, {
    "tStartMs": 568760,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "or by filling in form forty five oh six T\nand ticking the box on line eight."
    } ]
  }, {
    "tStartMs": 574940,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "It will tell you, year by year, how much\nof your own money the government is"
    } ]
  }, {
    "tStartMs": 579180,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "still holding against a claim you have not\nfiled."
    } ]
  }, {
    "tStartMs": 582480,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Now put the three moves together, because\nthey only work as a set."
    } ]
  }, {
    "tStartMs": 586480,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "First, read the boxes on your forms and\nfind out what is actually leaving each"
    } ]
  }, {
    "tStartMs": 590360,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "month. Second, use the right form for each\ncheck to turn it down or turn it"
    } ]
  }, {
    "tStartMs": 595420,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "off completely. Third, pull the transcript\nand go back three years for the"
    } ]
  }, {
    "tStartMs": 600240,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "money that can still be claimed before\nthose years close."
    } ]
  }, {
    "tStartMs": 603400,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Free help exists for the third one."
    } ]
  }, {
    "tStartMs": 605700,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "The Volunteer Income Tax Assistance and\nTax Counseling for the Elderly programs"
    } ]
  }, {
    "tStartMs": 610060,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "prepare returns for older people at no\ncharge, and they are able to file the"
    } ]
  }, {
    "tStartMs": 614740,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "back years for you. This is education and\nnot tax advice."
    } ]
  }, {
    "tStartMs": 619000,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Your own figures decide your own answer."
    } ]
  }, {
    "tStartMs": 621340,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "If you know somebody who has been paying\nthis for years without knowing, send"
    } ]
  }, {
    "tStartMs": 624960,
    "dDurationMs": 1030,
    "segs": [ {
      "utf8": "this to them."
    } ]
  } ]
}
