{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5884,
    "segs": [ {
      "utf8": "The day you die, your own bank quietly\ndoes two things to your money that almost"
    } ]
  }, {
    "tStartMs": 5884,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "no family ever sees coming,"
    } ]
  }, {
    "tStartMs": 8266,
    "dDurationMs": 3882,
    "segs": [ {
      "utf8": "and both of them lock your loved\nones out at the very worst moment."
    } ]
  }, {
    "tStartMs": 12909,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "The first is that it\nfreezes your bank account."
    } ]
  }, {
    "tStartMs": 16511,
    "dDurationMs": 4983,
    "segs": [ {
      "utf8": "The second is that it seals your safe\ndeposit box shut, the very box where"
    } ]
  }, {
    "tStartMs": 21494,
    "dDurationMs": 5084,
    "segs": [ {
      "utf8": "so many people keep their will, their deed,\ntheir insurance papers, and everything"
    } ]
  }, {
    "tStartMs": 26578,
    "dDurationMs": 4543,
    "segs": [ {
      "utf8": "that matters most. And here is the\npart that shocks families the most."
    } ]
  }, {
    "tStartMs": 31561,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "They cannot get into either one."
    } ]
  }, {
    "tStartMs": 33683,
    "dDurationMs": 3482,
    "segs": [ {
      "utf8": "Not with the will. Not with\na death certificate in hand."
    } ]
  }, {
    "tStartMs": 37465,
    "dDurationMs": 5284,
    "segs": [ {
      "utf8": "Not even a husband or a wife of fifty\nyears can simply walk in and open it."
    } ]
  }, {
    "tStartMs": 43009,
    "dDurationMs": 5103,
    "segs": [ {
      "utf8": "But there is one simple form, one you can\nfill out for free in a single afternoon,"
    } ]
  }, {
    "tStartMs": 48693,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "that stops the whole nightmare\nbefore it ever begins."
    } ]
  }, {
    "tStartMs": 52796,
    "dDurationMs": 4563,
    "segs": [ {
      "utf8": "So let me show you exactly what the\nbank does the day you die, and the one"
    } ]
  }, {
    "tStartMs": 57359,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "form that keeps that door\nopen for the people you love."
    } ]
  }, {
    "tStartMs": 60841,
    "dDurationMs": 4123,
    "segs": [ {
      "utf8": "Let me start with the bank account,\nbecause this one catches almost everyone."
    } ]
  }, {
    "tStartMs": 65504,
    "dDurationMs": 3622,
    "segs": [ {
      "utf8": "The moment your bank learns that you\nhave died, an account held in your name"
    } ]
  }, {
    "tStartMs": 69126,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "alone is frozen solid. Nothing moves."
    } ]
  }, {
    "tStartMs": 72549,
    "dDurationMs": 4603,
    "segs": [ {
      "utf8": "A few automatic payments may limp along\nfor a little while, but no person can"
    } ]
  }, {
    "tStartMs": 77152,
    "dDurationMs": 4683,
    "segs": [ {
      "utf8": "step in and take money out, not to pay\nyour bills, not to cover your funeral,"
    } ]
  }, {
    "tStartMs": 82155,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "not to keep your home running."
    } ]
  }, {
    "tStartMs": 83496,
    "dDurationMs": 5224,
    "segs": [ {
      "utf8": "In the eyes of the law, that money now\nbelongs to your estate, and only one"
    } ]
  }, {
    "tStartMs": 88720,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "person on this earth can touch it."
    } ]
  }, {
    "tStartMs": 90801,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "That is the executor, the person named\nin your will, and even they cannot lift"
    } ]
  }, {
    "tStartMs": 95384,
    "dDurationMs": 4603,
    "segs": [ {
      "utf8": "a finger until a probate court has\nmet, reviewed the will, and handed them"
    } ]
  }, {
    "tStartMs": 99987,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "a special set of court papers\nproving they hold the authority."
    } ]
  }, {
    "tStartMs": 103650,
    "dDurationMs": 3942,
    "segs": [ {
      "utf8": "That process takes weeks at\nbest, and very often many months."
    } ]
  }, {
    "tStartMs": 108053,
    "dDurationMs": 4082,
    "segs": [ {
      "utf8": "And all the while, your family stands\nthere watching the bills pile up on the"
    } ]
  }, {
    "tStartMs": 112135,
    "dDurationMs": 4023,
    "segs": [ {
      "utf8": "kitchen table, knowing full well there\nis more than enough money sitting right"
    } ]
  }, {
    "tStartMs": 116158,
    "dDurationMs": 4403,
    "segs": [ {
      "utf8": "there to cover every one of them, and\nbeing told, again and again, that they"
    } ]
  }, {
    "tStartMs": 120561,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "are not allowed to touch a single dollar."
    } ]
  }, {
    "tStartMs": 123243,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "Now here is the second lock, the one\nhardly anyone warns you about, and it"
    } ]
  }, {
    "tStartMs": 127826,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "is even crueler. The safe deposit box."
    } ]
  }, {
    "tStartMs": 131268,
    "dDurationMs": 5064,
    "segs": [ {
      "utf8": "The day the bank is told you have passed,\nit seals that box shut, exactly the"
    } ]
  }, {
    "tStartMs": 136332,
    "dDurationMs": 4343,
    "segs": [ {
      "utf8": "same as the account. And this catches\nfamilies completely off guard, because"
    } ]
  }, {
    "tStartMs": 140675,
    "dDurationMs": 3702,
    "segs": [ {
      "utf8": "they assume that if they have the\nlittle key, they can simply open it."
    } ]
  }, {
    "tStartMs": 144517,
    "dDurationMs": 4803,
    "segs": [ {
      "utf8": "They cannot. The bank will not let\nanyone into a box held in your name alone"
    } ]
  }, {
    "tStartMs": 149601,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "until, once again, a probate court gives\nits blessing and an executor arrives"
    } ]
  }, {
    "tStartMs": 154184,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "with those same court papers in hand."
    } ]
  }, {
    "tStartMs": 156906,
    "dDurationMs": 4483,
    "segs": [ {
      "utf8": "Even a joint renter, someone whose own\nname sits on the box right beside yours,"
    } ]
  }, {
    "tStartMs": 161969,
    "dDurationMs": 4443,
    "segs": [ {
      "utf8": "often finds themselves frozen out at\ndeath, allowed in only under the watchful"
    } ]
  }, {
    "tStartMs": 166412,
    "dDurationMs": 4843,
    "segs": [ {
      "utf8": "eye of a bank employee, and only to pull\nout burial instructions, nothing more."
    } ]
  }, {
    "tStartMs": 171675,
    "dDurationMs": 4383,
    "segs": [ {
      "utf8": "So that box, and everything precious\nyou tucked inside it, sits locked away"
    } ]
  }, {
    "tStartMs": 176058,
    "dDurationMs": 4764,
    "segs": [ {
      "utf8": "in the dark for months. And this is where\nit turns into a trap that would almost"
    } ]
  }, {
    "tStartMs": 180822,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "be funny if it were not so painful."
    } ]
  }, {
    "tStartMs": 183684,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "Think about what people\nkeep inside that box."
    } ]
  }, {
    "tStartMs": 186425,
    "dDurationMs": 2582,
    "segs": [ {
      "utf8": "The most common thing of\nall is the will itself."
    } ]
  }, {
    "tStartMs": 189367,
    "dDurationMs": 2682,
    "segs": [ {
      "utf8": "The deed to the house.\nThe life insurance policy."
    } ]
  }, {
    "tStartMs": 192449,
    "dDurationMs": 5264,
    "segs": [ {
      "utf8": "The savings bonds, the jewelry, the\npapers a family needs the very moment a"
    } ]
  }, {
    "tStartMs": 197713,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "loved one dies. But here\nis the cruel circle."
    } ]
  }, {
    "tStartMs": 200995,
    "dDurationMs": 4563,
    "segs": [ {
      "utf8": "To open probate and get the court papers\nthat unlock the box, the family usually"
    } ]
  }, {
    "tStartMs": 205558,
    "dDurationMs": 3202,
    "segs": [ {
      "utf8": "needs the will. And the will\nis sitting inside the box."
    } ]
  }, {
    "tStartMs": 209041,
    "dDurationMs": 3202,
    "segs": [ {
      "utf8": "Which is locked. Which cannot\nbe opened without the will."
    } ]
  }, {
    "tStartMs": 213063,
    "dDurationMs": 4443,
    "segs": [ {
      "utf8": "Families have waited months, and paid\nlawyers thousands of dollars, all to"
    } ]
  }, {
    "tStartMs": 217506,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "get into a box that was holding the\none piece of paper that would have let"
    } ]
  }, {
    "tStartMs": 220989,
    "dDurationMs": 4543,
    "segs": [ {
      "utf8": "them in from the very start. It is a\nknot that ties itself tighter the harder"
    } ]
  }, {
    "tStartMs": 225532,
    "dDurationMs": 3842,
    "segs": [ {
      "utf8": "you pull on it, and it is\ncompletely, entirely avoidable."
    } ]
  }, {
    "tStartMs": 229955,
    "dDurationMs": 3822,
    "segs": [ {
      "utf8": "And do not think for a moment that probate\nis a quick trip down to a courthouse."
    } ]
  }, {
    "tStartMs": 234198,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "It is a long, formal, and\noften expensive process."
    } ]
  }, {
    "tStartMs": 238440,
    "dDurationMs": 4383,
    "segs": [ {
      "utf8": "In a great many places it drags on for\nsix months to a year, and sometimes"
    } ]
  }, {
    "tStartMs": 242823,
    "dDurationMs": 3443,
    "segs": [ {
      "utf8": "far longer if anyone raises\nso much as a single objection."
    } ]
  }, {
    "tStartMs": 247006,
    "dDurationMs": 4683,
    "segs": [ {
      "utf8": "It commonly eats up thousands of dollars\nin court fees and lawyer fees, and"
    } ]
  }, {
    "tStartMs": 251689,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "every one of those dollars comes straight\nout of the very savings you worked"
    } ]
  }, {
    "tStartMs": 255472,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "a whole lifetime to leave behind."
    } ]
  }, {
    "tStartMs": 258634,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "Worse still, probate is a public process."
    } ]
  }, {
    "tStartMs": 261396,
    "dDurationMs": 3842,
    "segs": [ {
      "utf8": "The list of what you owned, and who\nyou left it to, can become a matter of"
    } ]
  }, {
    "tStartMs": 265238,
    "dDurationMs": 3563,
    "segs": [ {
      "utf8": "public record that any stranger\nis free to walk in and read."
    } ]
  }, {
    "tStartMs": 269441,
    "dDurationMs": 2522,
    "segs": [ {
      "utf8": "So the account and the box\ndo not merely sit frozen."
    } ]
  }, {
    "tStartMs": 272523,
    "dDurationMs": 4603,
    "segs": [ {
      "utf8": "They sit frozen inside a slow, costly,\nand very public machine that your family"
    } ]
  }, {
    "tStartMs": 277126,
    "dDurationMs": 4043,
    "segs": [ {
      "utf8": "is forced to feed and wait upon, at\nthe exact moment they are least able to"
    } ]
  }, {
    "tStartMs": 281169,
    "dDurationMs": 4763,
    "segs": [ {
      "utf8": "bear it. And this is the entire machine\nthat one small form lets you skip,"
    } ]
  }, {
    "tStartMs": 285932,
    "dDurationMs": 1842,
    "segs": [ {
      "utf8": "cleanly and completely."
    } ]
  }, {
    "tStartMs": 288534,
    "dDurationMs": 3643,
    "segs": [ {
      "utf8": "So here is the one form that cuts\nstraight through all of it, and it costs"
    } ]
  }, {
    "tStartMs": 292177,
    "dDurationMs": 3582,
    "segs": [ {
      "utf8": "you nothing at all. It is called\na payable on death designation."
    } ]
  }, {
    "tStartMs": 296359,
    "dDurationMs": 4744,
    "segs": [ {
      "utf8": "Some banks call it transfer on death,\nbut it is the very same simple thing."
    } ]
  }, {
    "tStartMs": 301603,
    "dDurationMs": 4043,
    "segs": [ {
      "utf8": "You walk into your bank, or you go\nonline, and you name the person you want"
    } ]
  }, {
    "tStartMs": 305646,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "your money to go to when you die."
    } ]
  }, {
    "tStartMs": 307727,
    "dDurationMs": 2782,
    "segs": [ {
      "utf8": "Your spouse. Your child.\nWhoever you choose."
    } ]
  }, {
    "tStartMs": 310989,
    "dDurationMs": 2042,
    "segs": [ {
      "utf8": "That is it. While you are alive,"
    } ]
  }, {
    "tStartMs": 313831,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "absolutely nothing changes. It\nis still entirely your account."
    } ]
  }, {
    "tStartMs": 317494,
    "dDurationMs": 5803,
    "segs": [ {
      "utf8": "You spend it, you move it, you close\nit, you change your mind, all exactly"
    } ]
  }, {
    "tStartMs": 323297,
    "dDurationMs": 5444,
    "segs": [ {
      "utf8": "as before, and the person you named\nhas no access and no claim to a single"
    } ]
  }, {
    "tStartMs": 328741,
    "dDurationMs": 2512,
    "segs": [ {
      "utf8": "dollar for as long as you are breathing."
    } ]
  }, {
    "tStartMs": 331943,
    "dDurationMs": 5464,
    "segs": [ {
      "utf8": "But the moment you pass, that account does\nnot freeze, and it does not go anywhere"
    } ]
  }, {
    "tStartMs": 337407,
    "dDurationMs": 1261,
    "segs": [ {
      "utf8": "near a probate court."
    } ]
  }, {
    "tStartMs": 339368,
    "dDurationMs": 4163,
    "segs": [ {
      "utf8": "It passes straight to the person you\nnamed, who simply walks into the bank"
    } ]
  }, {
    "tStartMs": 343531,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "with a death certificate and\ntheir own identification,"
    } ]
  }, {
    "tStartMs": 347334,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "and within days, not\nmonths, the money is theirs."
    } ]
  }, {
    "tStartMs": 351316,
    "dDurationMs": 2542,
    "segs": [ {
      "utf8": "No frozen account. No endless waiting."
    } ]
  }, {
    "tStartMs": 354378,
    "dDurationMs": 3803,
    "segs": [ {
      "utf8": "No lawyer. One free form,\nand your family is protected."
    } ]
  }, {
    "tStartMs": 359202,
    "dDurationMs": 3882,
    "segs": [ {
      "utf8": "And here is something that should make\nthis feel familiar rather than frightening,"
    } ]
  }, {
    "tStartMs": 363084,
    "dDurationMs": 4543,
    "segs": [ {
      "utf8": "because you have almost certainly done\nthis very thing before without thinking"
    } ]
  }, {
    "tStartMs": 367627,
    "dDurationMs": 4944,
    "segs": [ {
      "utf8": "twice about it. Your life insurance\npolicy already names a beneficiary."
    } ]
  }, {
    "tStartMs": 372791,
    "dDurationMs": 4042,
    "segs": [ {
      "utf8": "So does your retirement account, and\nyour pension, and your savings bonds."
    } ]
  }, {
    "tStartMs": 377294,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "When you pass, every one of those pours\nstraight to the people you named, quickly"
    } ]
  }, {
    "tStartMs": 381877,
    "dDurationMs": 4703,
    "segs": [ {
      "utf8": "and quietly, with no court and no\nfreeze, and for one reason only."
    } ]
  }, {
    "tStartMs": 386880,
    "dDurationMs": 4763,
    "segs": [ {
      "utf8": "You filled out a beneficiary line\nyears ago and then forgot all about it."
    } ]
  }, {
    "tStartMs": 392284,
    "dDurationMs": 4603,
    "segs": [ {
      "utf8": "Your plain checking and savings account,\nand your safe deposit box, are very"
    } ]
  }, {
    "tStartMs": 396887,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "often the only things you never\ngot around to doing it for."
    } ]
  }, {
    "tStartMs": 400509,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "So all you are really doing here is\nfinishing a job you already started long"
    } ]
  }, {
    "tStartMs": 404972,
    "dDurationMs": 4804,
    "segs": [ {
      "utf8": "ago. If you would rather, a joint\naccount held with what is called a right"
    } ]
  }, {
    "tStartMs": 409776,
    "dDurationMs": 4623,
    "segs": [ {
      "utf8": "of survivorship does much the same thing,\npassing straight to the other owner"
    } ]
  }, {
    "tStartMs": 414399,
    "dDurationMs": 5223,
    "segs": [ {
      "utf8": "the moment you are gone. And for a larger\nestate, a living trust can hold your"
    } ]
  }, {
    "tStartMs": 419622,
    "dDurationMs": 3943,
    "segs": [ {
      "utf8": "accounts and your box together\nand skip past probate entirely."
    } ]
  }, {
    "tStartMs": 424285,
    "dDurationMs": 4784,
    "segs": [ {
      "utf8": "But for most ordinary people, that free\npayable on death form is the simplest"
    } ]
  }, {
    "tStartMs": 429069,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "and the fastest shield there is."
    } ]
  }, {
    "tStartMs": 432011,
    "dDurationMs": 4062,
    "segs": [ {
      "utf8": "Now the safe deposit box needs a little\nmore care, because that payable on"
    } ]
  }, {
    "tStartMs": 436073,
    "dDurationMs": 3823,
    "segs": [ {
      "utf8": "death form covers your account, but\nthe box is its own separate lock."
    } ]
  }, {
    "tStartMs": 439896,
    "dDurationMs": 6064,
    "segs": [ {
      "utf8": "So do two things. First, if you keep\na box, add a trusted person as a joint"
    } ]
  }, {
    "tStartMs": 445960,
    "dDurationMs": 4583,
    "segs": [ {
      "utf8": "renter on it now, while you are well,\nso that their name sits on the contract"
    } ]
  }, {
    "tStartMs": 450543,
    "dDurationMs": 5424,
    "segs": [ {
      "utf8": "right beside yours. And second, and this\nis the big one, do not keep your will,"
    } ]
  }, {
    "tStartMs": 455967,
    "dDurationMs": 4503,
    "segs": [ {
      "utf8": "or any paper your family will need the\ninstant you die, locked away inside"
    } ]
  }, {
    "tStartMs": 460470,
    "dDurationMs": 4223,
    "segs": [ {
      "utf8": "that box. Keep the will somewhere\nyour family can reach it right away."
    } ]
  }, {
    "tStartMs": 464693,
    "dDurationMs": 3362,
    "segs": [ {
      "utf8": "With your lawyer. In a\nfireproof box at home."
    } ]
  }, {
    "tStartMs": 468055,
    "dDurationMs": 4503,
    "segs": [ {
      "utf8": "Wherever they can put their hands on it\nwithout having to ask a bank or a judge"
    } ]
  }, {
    "tStartMs": 472558,
    "dDurationMs": 4603,
    "segs": [ {
      "utf8": "for permission first. The box is a\nfine place for jewelry and keepsakes."
    } ]
  }, {
    "tStartMs": 477381,
    "dDurationMs": 4163,
    "segs": [ {
      "utf8": "It is a terrible place for the one\ndocument that unlocks everything else."
    } ]
  }, {
    "tStartMs": 482204,
    "dDurationMs": 3983,
    "segs": [ {
      "utf8": "Here is how this plays out, and it\nhappens to real families all the time."
    } ]
  }, {
    "tStartMs": 486587,
    "dDurationMs": 4123,
    "segs": [ {
      "utf8": "A husband passes away, and his wife\nknows exactly where everything is."
    } ]
  }, {
    "tStartMs": 491050,
    "dDurationMs": 5044,
    "segs": [ {
      "utf8": "It is all in the safe deposit box,\nneat and organized, the will, the deed,"
    } ]
  }, {
    "tStartMs": 496394,
    "dDurationMs": 4043,
    "segs": [ {
      "utf8": "the insurance. She drives to the bank\nwith the key and the death certificate,"
    } ]
  }, {
    "tStartMs": 500837,
    "dDurationMs": 4523,
    "segs": [ {
      "utf8": "grieving and exhausted, and she is\nturned away right there at the counter."
    } ]
  }, {
    "tStartMs": 505920,
    "dDurationMs": 5104,
    "segs": [ {
      "utf8": "The box is sealed. To open it she needs\nto be named the executor, but to be"
    } ]
  }, {
    "tStartMs": 511024,
    "dDurationMs": 4323,
    "segs": [ {
      "utf8": "named the executor, the court needs\nthe will, and the will is locked inside"
    } ]
  }, {
    "tStartMs": 515347,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "the box she cannot open."
    } ]
  }, {
    "tStartMs": 517488,
    "dDurationMs": 3542,
    "segs": [ {
      "utf8": "Weeks turn into months. The\nlife insurance goes unclaimed."
    } ]
  }, {
    "tStartMs": 521471,
    "dDurationMs": 4883,
    "segs": [ {
      "utf8": "The bills go unpaid. And a woman who\ndid everything right, whose husband did"
    } ]
  }, {
    "tStartMs": 526354,
    "dDurationMs": 4443,
    "segs": [ {
      "utf8": "everything right, is left standing\nthere helpless, all for the want of one"
    } ]
  }, {
    "tStartMs": 530797,
    "dDurationMs": 3863,
    "segs": [ {
      "utf8": "free form and one simple decision\nabout where to keep a piece of paper."
    } ]
  }, {
    "tStartMs": 535420,
    "dDurationMs": 2662,
    "segs": [ {
      "utf8": "So here is your plan,\nand none of it is hard."
    } ]
  }, {
    "tStartMs": 538562,
    "dDurationMs": 4964,
    "segs": [ {
      "utf8": "This week, call your bank or go online\nand put a payable on death beneficiary"
    } ]
  }, {
    "tStartMs": 543526,
    "dDurationMs": 5103,
    "segs": [ {
      "utf8": "on every account you own. It is free,\nit takes only minutes, and it changes"
    } ]
  }, {
    "tStartMs": 548629,
    "dDurationMs": 5003,
    "segs": [ {
      "utf8": "nothing while you are alive. If you\nkeep a safe deposit box, add a trusted"
    } ]
  }, {
    "tStartMs": 553632,
    "dDurationMs": 4183,
    "segs": [ {
      "utf8": "person as a joint renter on it, and\nmove your will and your important papers"
    } ]
  }, {
    "tStartMs": 557815,
    "dDurationMs": 2782,
    "segs": [ {
      "utf8": "out of it and into somewhere\nyour family can reach."
    } ]
  }, {
    "tStartMs": 561157,
    "dDurationMs": 4103,
    "segs": [ {
      "utf8": "And then, tell your family what you\nhave done, and where everything is."
    } ]
  }, {
    "tStartMs": 565901,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "The families that sail right\nthrough this are not the lucky ones."
    } ]
  }, {
    "tStartMs": 569363,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "They are simply the ones\nwho set it up ahead of time."
    } ]
  }, {
    "tStartMs": 572425,
    "dDurationMs": 4003,
    "segs": [ {
      "utf8": "This is general information to help\nyou protect the people you love, and it"
    } ]
  }, {
    "tStartMs": 576428,
    "dDurationMs": 4142,
    "segs": [ {
      "utf8": "is not legal advice, because the exact\nrules are a little different in every"
    } ]
  }, {
    "tStartMs": 580570,
    "dDurationMs": 4584,
    "segs": [ {
      "utf8": "state. Before you finish your planning,\nit is well worth sitting down just"
    } ]
  }, {
    "tStartMs": 585154,
    "dDurationMs": 4763,
    "segs": [ {
      "utf8": "once with a lawyer who handles estates,\nto make sure everything is set up the"
    } ]
  }, {
    "tStartMs": 589917,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "right way for where you live."
    } ]
  }, {
    "tStartMs": 592218,
    "dDurationMs": 3863,
    "segs": [ {
      "utf8": "So remember the two locks that\nsnap shut the day you die."
    } ]
  }, {
    "tStartMs": 596661,
    "dDurationMs": 2662,
    "segs": [ {
      "utf8": "The frozen account, and the sealed box."
    } ]
  }, {
    "tStartMs": 599823,
    "dDurationMs": 4503,
    "segs": [ {
      "utf8": "And remember that both of them can be\nbeaten by one quiet afternoon of paperwork,"
    } ]
  }, {
    "tStartMs": 604326,
    "dDurationMs": 3403,
    "segs": [ {
      "utf8": "done while you are still here to do it."
    } ]
  }, {
    "tStartMs": 608229,
    "dDurationMs": 4123,
    "segs": [ {
      "utf8": "Your family will already be carrying\nmore grief than words can hold on that"
    } ]
  }, {
    "tStartMs": 612352,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "day."
    } ]
  }, {
    "tStartMs": 613533,
    "dDurationMs": 4483,
    "segs": [ {
      "utf8": "Do not let them also stand helpless at\na bank counter, locked out of the very"
    } ]
  }, {
    "tStartMs": 618016,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "things you saved a lifetime to leave them."
    } ]
  }, {
    "tStartMs": 620918,
    "dDurationMs": 4783,
    "segs": [ {
      "utf8": "Fill out that one form, move that will\nto safety, and you will have handed"
    } ]
  }, {
    "tStartMs": 625701,
    "dDurationMs": 4723,
    "segs": [ {
      "utf8": "the people you love something far more\nvaluable than any dollar in that account."
    } ]
  }, {
    "tStartMs": 631185,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "A door that stays open."
    } ]
  }, {
    "tStartMs": 633866,
    "dDurationMs": 4523,
    "segs": [ {
      "utf8": "And if you know someone who keeps a\nsafe deposit box, or who has never once"
    } ]
  }, {
    "tStartMs": 638389,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "named a beneficiary on their accounts,"
    } ]
  }, {
    "tStartMs": 641111,
    "dDurationMs": 3783,
    "segs": [ {
      "utf8": "share this with them today, because\nthis is the kind of thing you can only"
    } ]
  }, {
    "tStartMs": 644894,
    "dDurationMs": 1421,
    "segs": [ {
      "utf8": "fix while there is still time."
    } ]
  } ]
}
