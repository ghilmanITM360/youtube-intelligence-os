{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Every year the government adds up your\nmoney to decide whether it is allowed"
    } ]
  }, {
    "tStartMs": 4420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to tax your Social Security check."
    } ]
  }, {
    "tStartMs": 7320,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Your pension goes into that sum."
    } ]
  }, {
    "tStartMs": 9620,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Your withdrawals go in.\nYour interest goes in."
    } ]
  }, {
    "tStartMs": 13000,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Even half of the Social\nSecurity check itself goes in."
    } ]
  }, {
    "tStartMs": 16620,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "And the closer that total climbs, the\nmore of your own check becomes taxable."
    } ]
  }, {
    "tStartMs": 22040,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "But six kinds of money never\ngo into that sum at all."
    } ]
  }, {
    "tStartMs": 25840,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "Not a penny of them. You can receive\nevery one of them, use every one of them,"
    } ]
  }, {
    "tStartMs": 30820,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "and the total the government looks\nat does not move by a single dollar."
    } ]
  }, {
    "tStartMs": 35800,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Most people over sixty five have never\nbeen told that even one of these exists,"
    } ]
  }, {
    "tStartMs": 40720,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "and several of them are sitting in\naccounts those same people already own."
    } ]
  }, {
    "tStartMs": 45780,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "I will give you all six. And before that,\nI want to tell you why this sum reaches"
    } ]
  }, {
    "tStartMs": 50980,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "you at all, because that part is the\nthing almost nobody knows and it will"
    } ]
  }, {
    "tStartMs": 55540,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "change how you feel about the rest of it."
    } ]
  }, {
    "tStartMs": 58040,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The first one is the year\nthe numbers were frozen."
    } ]
  }, {
    "tStartMs": 61540,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "When Congress wrote this\nrule, it picked two amounts."
    } ]
  }, {
    "tStartMs": 64980,
    "dDurationMs": 3455,
    "segs": [ {
      "utf8": "Twenty five thousand dollars for a\nperson on their own, thirty two thousand"
    } ]
  }, {
    "tStartMs": 68680,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "for a married couple."
    } ]
  }, {
    "tStartMs": 70360,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Under those amounts, your Social\nSecurity could not be taxed at all."
    } ]
  }, {
    "tStartMs": 74540,
    "dDurationMs": 4229,
    "segs": [ {
      "utf8": "Over them, part of it could. And the year\nthey picked those amounts was nineteen"
    } ]
  }, {
    "tStartMs": 78769,
    "dDurationMs": 411,
    "segs": [ {
      "utf8": "eighty four."
    } ]
  }, {
    "tStartMs": 80260,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Now consider what nineteen\neighty four money was worth."
    } ]
  }, {
    "tStartMs": 83800,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Twenty five thousand dollars a year\nwas a comfortable retirement then."
    } ]
  }, {
    "tStartMs": 87400,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "It was the sort of income that\nput a person well above ordinary."
    } ]
  }, {
    "tStartMs": 91120,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "And that was the whole idea."
    } ]
  }, {
    "tStartMs": 93120,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "This rule was built to reach"
    } ]
  }, {
    "tStartMs": 94620,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "the wealthiest retirees\nin the country, roughly"
    } ]
  }, {
    "tStartMs": 97240,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "the top ten percent, the people who had\nreal money coming in on top of their"
    } ]
  }, {
    "tStartMs": 101500,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "check."
    } ]
  }, {
    "tStartMs": 102800,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Everybody else was meant to\nbe left completely alone."
    } ]
  }, {
    "tStartMs": 106060,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Then the government did something that\ncosts older Americans money every single"
    } ]
  }, {
    "tStartMs": 110920,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "year since. It never adjusted\nthose two amounts again."
    } ]
  }, {
    "tStartMs": 114960,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Not once. Almost everything else in\nthe tax system moves a little each year"
    } ]
  }, {
    "tStartMs": 119580,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "to keep pace with the cost of living,\nbut these two numbers were set down and"
    } ]
  }, {
    "tStartMs": 124520,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "left exactly where they were. So the\nrule stayed still while the world moved"
    } ]
  }, {
    "tStartMs": 129640,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "past it. Twenty five thousand dollars\ntoday is a modest retirement, and in"
    } ]
  }, {
    "tStartMs": 134780,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "many places it is a tight one."
    } ]
  }, {
    "tStartMs": 137280,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "A rule aimed at the richest ten percent\nnow reaches about half of everybody"
    } ]
  }, {
    "tStartMs": 141640,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "drawing a Social Security check, and\nit reached them without one vote ever"
    } ]
  }, {
    "tStartMs": 146000,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "being taken. That is the\npart worth holding onto."
    } ]
  }, {
    "tStartMs": 149740,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Nothing about you changed. The\nrule did not change either."
    } ]
  }, {
    "tStartMs": 153440,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "The money simply moved underneath both\nof you, and nobody was ever sent a letter"
    } ]
  }, {
    "tStartMs": 157800,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "about it. So when you hear that part of\nyour check is taxable, understand that"
    } ]
  }, {
    "tStartMs": 162260,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "you did not do anything wrong\nand you did not become wealthy."
    } ]
  }, {
    "tStartMs": 166000,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "You stayed exactly where you were\nwhile a frozen number came to find you."
    } ]
  }, {
    "tStartMs": 170460,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Which is why the six that\nfollow matter so much."
    } ]
  }, {
    "tStartMs": 174040,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Every one of them keeps money out of\nthat sum entirely, and each one of them"
    } ]
  }, {
    "tStartMs": 178180,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "is perfectly ordinary."
    } ]
  }, {
    "tStartMs": 180420,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Nothing here is a scheme\nand nothing here is clever."
    } ]
  }, {
    "tStartMs": 183200,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "These are simply the kinds of money the\nrule was written to leave alone, and"
    } ]
  }, {
    "tStartMs": 187720,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "knowing which is which decides whether\nyour check gets taxed or gets left alone."
    } ]
  }, {
    "tStartMs": 192520,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "The second one is money\nfrom a Roth account."
    } ]
  }, {
    "tStartMs": 195460,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "When you take money out of a\nRoth, it does not enter the sum."
    } ]
  }, {
    "tStartMs": 199180,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Not the amount you put in years ago, not\nthe growth on top of it, not any part"
    } ]
  }, {
    "tStartMs": 203600,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "of it, as long as the account has been\nopen the required length of time and"
    } ]
  }, {
    "tStartMs": 207820,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "you are old enough. As far as"
    } ]
  }, {
    "tStartMs": 209880,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "the government is concerned,\nthat money is simply"
    } ]
  }, {
    "tStartMs": 212300,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "not there. It never appears in the\nsum, in any year, in any amount."
    } ]
  }, {
    "tStartMs": 217720,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "And it does not matter what\nyou spend it on afterwards."
    } ]
  }, {
    "tStartMs": 220760,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "You can put a new roof over your head\nwith it, or help a grandchild through"
    } ]
  }, {
    "tStartMs": 224280,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "a difficult year, and the sum\nstays exactly where it was."
    } ]
  }, {
    "tStartMs": 228420,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Take a moment on this one, because it\nmight be the most useful thing here."
    } ]
  }, {
    "tStartMs": 232540,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Two people can take the very same ten\nthousand dollars out in the very same"
    } ]
  }, {
    "tStartMs": 236540,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "week. The one who takes it from an\nordinary retirement account may push their"
    } ]
  }, {
    "tStartMs": 241020,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "total up and make part of\ntheir Social Security taxable."
    } ]
  }, {
    "tStartMs": 244900,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The one who takes it from a\nRoth changes nothing at all."
    } ]
  }, {
    "tStartMs": 248200,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Same money, same week, same person\neven, and a completely different answer,"
    } ]
  }, {
    "tStartMs": 253200,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "decided by nothing more than\nwhich account it came out of."
    } ]
  }, {
    "tStartMs": 256380,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "The third one is money you give straight\nto a charity from your retirement"
    } ]
  }, {
    "tStartMs": 260640,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "account. Once you are seventy and a half\nyears old, you may send money straight"
    } ]
  }, {
    "tStartMs": 264840,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "from that account to a church, or to any\ncharity you choose, instead of taking"
    } ]
  }, {
    "tStartMs": 269200,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "it yourself."
    } ]
  }, {
    "tStartMs": 270460,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "It goes from the account to them\nwithout ever passing through your hands."
    } ]
  }, {
    "tStartMs": 275360,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "And you do not have to wait until the\ngovernment starts making you take money"
    } ]
  }, {
    "tStartMs": 278860,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "out each year. This one opens\nfor you earlier than that."
    } ]
  }, {
    "tStartMs": 283080,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Here is why that is worth knowing."
    } ]
  }, {
    "tStartMs": 284540,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Once you are old enough that"
    } ]
  }, {
    "tStartMs": 286400,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "the government does require\na yearly withdrawal,"
    } ]
  }, {
    "tStartMs": 289220,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "a gift sent this way still counts as\nthat withdrawal, so the government is"
    } ]
  }, {
    "tStartMs": 293440,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "satisfied. But because the money never\ncame to you, it never enters the sum"
    } ]
  }, {
    "tStartMs": 298200,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "that decides how your\nSocial Security is treated."
    } ]
  }, {
    "tStartMs": 301020,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Most people give to their church out\nof the money already sitting in their"
    } ]
  }, {
    "tStartMs": 304440,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "bank account, and doing it\nthat way helps them not at all."
    } ]
  }, {
    "tStartMs": 307760,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "The same gift, to the same place, sent\nthe other way round, keeps their total"
    } ]
  }, {
    "tStartMs": 312900,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "lower for the entire year. The fourth one\nis money from a life insurance policy."
    } ]
  }, {
    "tStartMs": 318580,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "When a policy pays out after somebody\ndies, that money comes to the person"
    } ]
  }, {
    "tStartMs": 322460,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "named on it without going into the sum."
    } ]
  }, {
    "tStartMs": 325160,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "The size of the payment\nmakes no difference."
    } ]
  }, {
    "tStartMs": 327600,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Whether it arrives all at once or"
    } ]
  }, {
    "tStartMs": 329340,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "in pieces over several\nmonths makes no difference"
    } ]
  }, {
    "tStartMs": 331980,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "either. The part that is the payout\nitself simply is not counted."
    } ]
  }, {
    "tStartMs": 335800,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "A widow who receives a payout in the\nsame year she is already worried about"
    } ]
  }, {
    "tStartMs": 340180,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "her check does not have to worry about\nthat particular money making things"
    } ]
  }, {
    "tStartMs": 344160,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "worse. It does not count. It never did."
    } ]
  }, {
    "tStartMs": 347480,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "I mention it because this is exactly\nthe year when a person is least able to"
    } ]
  }, {
    "tStartMs": 351480,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "work anything out. Somebody has just died."
    } ]
  }, {
    "tStartMs": 354800,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "The paperwork is arriving\nfaster than anyone can read it."
    } ]
  }, {
    "tStartMs": 358020,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "And in the middle of that, a large\namount of money lands in the account and"
    } ]
  }, {
    "tStartMs": 361700,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "the fear arrives with it.\nThat fear is not needed here."
    } ]
  }, {
    "tStartMs": 364800,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "That money is not part of the sum, and\nnobody at the insurance company is likely"
    } ]
  }, {
    "tStartMs": 369500,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "to say so, because it is not their job\nto explain your Social Security to you."
    } ]
  }, {
    "tStartMs": 374600,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "The fifth one is your own\nmoney coming back to you."
    } ]
  }, {
    "tStartMs": 378480,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "If you cash in a savings bond, or close\nan account, or sell something for roughly"
    } ]
  }, {
    "tStartMs": 383380,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "what you paid for it, the part that was\nalways yours does not go into the sum."
    } ]
  }, {
    "tStartMs": 388540,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "Only the growth does. People get this\nwrong constantly and frighten themselves"
    } ]
  }, {
    "tStartMs": 393800,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "badly over it."
    } ]
  }, {
    "tStartMs": 395540,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "They see a large amount land in the\nbank and assume the whole of it will be"
    } ]
  }, {
    "tStartMs": 399500,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "counted against them, when in truth most\nof it was their own money simply returning"
    } ]
  }, {
    "tStartMs": 404680,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "home."
    } ]
  }, {
    "tStartMs": 406020,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "I have heard of people leaving a bond\nsitting untouched for years past the"
    } ]
  }, {
    "tStartMs": 410240,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "day it stopped earning anything, purely\nbecause they were afraid of what cashing"
    } ]
  }, {
    "tStartMs": 414220,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "it in would do to their check."
    } ]
  }, {
    "tStartMs": 415900,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "The fear cost them more than\nthe tax ever would have."
    } ]
  }, {
    "tStartMs": 418880,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "The same is true when you sell\nsomething at a loss or break even."
    } ]
  }, {
    "tStartMs": 423820,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Nothing is there for the government\nto count, because nothing was gained."
    } ]
  }, {
    "tStartMs": 428480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Only profit enters the sum."
    } ]
  }, {
    "tStartMs": 431140,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Your own money, coming back to you\nafter years of sitting somewhere, is not"
    } ]
  }, {
    "tStartMs": 436020,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "income and was never treated as income."
    } ]
  }, {
    "tStartMs": 439720,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "A person who sells a bond they bought\nfor ten thousand dollars and receives"
    } ]
  }, {
    "tStartMs": 444360,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "eleven thousand back has one thousand\ndollars entering the sum, not eleven."
    } ]
  }, {
    "tStartMs": 450360,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "The other ten thousand was always theirs."
    } ]
  }, {
    "tStartMs": 452940,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "It went out of their pocket years\nago and it has simply come home."
    } ]
  }, {
    "tStartMs": 457740,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "The sixth one is money you\ntake in a different year."
    } ]
  }, {
    "tStartMs": 461500,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "This one is not an account\nand it is not a rule."
    } ]
  }, {
    "tStartMs": 464640,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "It is timing, and it is the one\nyou have the most control over."
    } ]
  }, {
    "tStartMs": 469600,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The sum is worked out one year at a time."
    } ]
  }, {
    "tStartMs": 472860,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "So a large withdrawal taken all at once\ncan push you over the amounts for that"
    } ]
  }, {
    "tStartMs": 477740,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "entire year, while the very same"
    } ]
  }, {
    "tStartMs": 479880,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "withdrawal split across\nDecember and January"
    } ]
  }, {
    "tStartMs": 483220,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "can leave you under them in both years."
    } ]
  }, {
    "tStartMs": 486160,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Nothing clever is required here."
    } ]
  }, {
    "tStartMs": 488460,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "You do not need an adviser, or a\nstrategy, or anything complicated at all."
    } ]
  }, {
    "tStartMs": 493480,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "You need only to know that the year\nmatters, and to ask the question before"
    } ]
  }, {
    "tStartMs": 498840,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "the money moves rather than in March\nwhen the return is being filled in."
    } ]
  }, {
    "tStartMs": 503920,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "Once a withdrawal is made it counts, and\nthere is no putting it back afterwards."
    } ]
  }, {
    "tStartMs": 509820,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "This is the reason I would rather you\nheard all of this in August than in April,"
    } ]
  }, {
    "tStartMs": 514720,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "because in August you can still decide\nwhen the money moves, and in April you"
    } ]
  }, {
    "tStartMs": 519560,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "can only write down what already happened."
    } ]
  }, {
    "tStartMs": 522420,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Here is what to do with all of this."
    } ]
  }, {
    "tStartMs": 524860,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "I should say up front that what follows\nis general information and not tax"
    } ]
  }, {
    "tStartMs": 529380,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "advice, so please check your own position\nwith somebody who can see your actual"
    } ]
  }, {
    "tStartMs": 534140,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "numbers. Start by working\nout roughly where you stand."
    } ]
  }, {
    "tStartMs": 538480,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "Take last year. Add up everything that\ncame in, and then add on half of what"
    } ]
  }, {
    "tStartMs": 543980,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Social Security paid you. If that total\nsits comfortably under twenty five"
    } ]
  }, {
    "tStartMs": 548420,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "thousand dollars on your own, or thirty\ntwo thousand as a couple, then none"
    } ]
  }, {
    "tStartMs": 553280,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "of your check is being taxed\nand you can put this down."
    } ]
  }, {
    "tStartMs": 556520,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "If you are close to those amounts, or a\nlittle over them, that is exactly where"
    } ]
  }, {
    "tStartMs": 561620,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "the six things I have just\ngiven you turn into real money."
    } ]
  }, {
    "tStartMs": 565780,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "A person sitting two\nthousand dollars above"
    } ]
  }, {
    "tStartMs": 567840,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "the amount can often get back underneath"
    } ]
  }, {
    "tStartMs": 569800,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "it by changing where one withdrawal\ncomes from, or which year it happens in,"
    } ]
  }, {
    "tStartMs": 574520,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "and nothing else about their\nlife needs to change at all."
    } ]
  }, {
    "tStartMs": 577480,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Then, before you take money out of any\naccount this year, ask yourself one"
    } ]
  }, {
    "tStartMs": 582480,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "question. Which account is this coming\nfrom, and does that account go into"
    } ]
  }, {
    "tStartMs": 587260,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "the sum."
    } ]
  }, {
    "tStartMs": 588640,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Those are two different questions and\nthe second one is the one nobody asks."
    } ]
  }, {
    "tStartMs": 593540,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "That single question, asked before the\nmoney moves, is worth more than anything"
    } ]
  }, {
    "tStartMs": 598160,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "you can do afterwards."
    } ]
  }, {
    "tStartMs": 600220,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "And if you are not sure, the free tax\nhelp programs for older people will run"
    } ]
  }, {
    "tStartMs": 604440,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "the whole thing for you in an\nafternoon without charging you a penny."
    } ]
  }, {
    "tStartMs": 608460,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "They exist in every state, they are"
    } ]
  }, {
    "tStartMs": 610680,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "staffed by people\ntrained for exactly this,"
    } ]
  }, {
    "tStartMs": 613080,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "and they see this question so often\nthat they will not think it is a small"
    } ]
  }, {
    "tStartMs": 617320,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "one. So let me put the six in front\nof you one more time, plainly."
    } ]
  }, {
    "tStartMs": 622800,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "The year the numbers were frozen, which\nis nineteen eighty four, and they have"
    } ]
  }, {
    "tStartMs": 627620,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "never moved since."
    } ]
  }, {
    "tStartMs": 629840,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Money from a Roth account,\nwhich never enters the sum."
    } ]
  }, {
    "tStartMs": 634520,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Money given straight from a\nretirement account to a charity."
    } ]
  }, {
    "tStartMs": 638840,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Money from a life insurance policy."
    } ]
  }, {
    "tStartMs": 641520,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Your own money coming back to\nyou when something is cashed in."
    } ]
  }, {
    "tStartMs": 645680,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "And money taken in a different year,\nwhich is the one you control completely."
    } ]
  }, {
    "tStartMs": 650700,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "The government will not write\nto you about any of this."
    } ]
  }, {
    "tStartMs": 654400,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "There is no letter that arrives explaining\nwhich of your money counts and which"
    } ]
  }, {
    "tStartMs": 658680,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "of it does not. You have heard it now,\nthough, and that puts you ahead of nearly"
    } ]
  }, {
    "tStartMs": 663720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "everybody who gets the same check."
    } ]
  }, {
    "tStartMs": 666460,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "If somebody you care about is about to\ntake money out of a retirement account"
    } ]
  }, {
    "tStartMs": 671180,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "this year, pass this\nalong before they do it."
    } ]
  }, {
    "tStartMs": 675000,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Five minutes now is worth more than\nanything they will learn from a tax return"
    } ]
  }, {
    "tStartMs": 679380,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "in the spring."
    } ]
  } ]
}
