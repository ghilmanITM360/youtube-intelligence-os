{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "There is one number that decides what your\nsavings are worth to you, and almost"
    } ]
  }, {
    "tStartMs": 4640,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "nobody over sixty five can tell you what\ntheirs is."
    } ]
  }, {
    "tStartMs": 8020,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "It is not your balance. It is what the\nbank pays you for holding it."
    } ]
  }, {
    "tStartMs": 12460,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Your bank is not required to tell you when\nthat number falls."
    } ]
  }, {
    "tStartMs": 16060,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "It is not required to write, not required\nto telephone, not required to print"
    } ]
  }, {
    "tStartMs": 20640,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "it anywhere you would think to look."
    } ]
  }, {
    "tStartMs": 22880,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "It simply pays you less from one month to\nthe next, and the money that stops"
    } ]
  }, {
    "tStartMs": 27750,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "arriving never shows up as a loss because\nit was never in your hands."
    } ]
  }, {
    "tStartMs": 33010,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Two days this month set that number for\nthe winter."
    } ]
  }, {
    "tStartMs": 36810,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Neither day belongs to you, and neither\none belongs to your bank."
    } ]
  }, {
    "tStartMs": 41450,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Four things below. The one that locks for\nyears is last."
    } ]
  }, {
    "tStartMs": 46370,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Who this reaches. If you have money\nsitting in a checking or savings account"
    } ]
  }, {
    "tStartMs": 50690,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "at a bank,"
    } ]
  }, {
    "tStartMs": 52130,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "all four apply to you. There is no income\ntest, no age gate on any of it, and"
    } ]
  }, {
    "tStartMs": 57990,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "nothing here depends on how much you have."
    } ]
  }, {
    "tStartMs": 60730,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "A thousand dollars and a hundred thousand\ndollars lose at exactly the same"
    } ]
  }, {
    "tStartMs": 65130,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "rate."
    } ]
  }, {
    "tStartMs": 66290,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Number one. Two days this month decide\nwhat your money earns all winter."
    } ]
  }, {
    "tStartMs": 71610,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "The first is the twenty seventh and twenty\neighth of October."
    } ]
  }, {
    "tStartMs": 75530,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "The Federal Reserve meets on those two\ndays and decides what it charges banks"
    } ]
  }, {
    "tStartMs": 80030,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "to borrow. That figure now sits between\nthree and a half and three and three"
    } ]
  }, {
    "tStartMs": 84490,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "quarters percent. The second is the first\nof November."
    } ]
  }, {
    "tStartMs": 89030,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "On that morning the Treasury sets a new\nrate on government savings bonds."
    } ]
  }, {
    "tStartMs": 93950,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "It does that twice a year, every first of\nMay and every first of November,"
    } ]
  }, {
    "tStartMs": 98710,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "and nothing in between."
    } ]
  }, {
    "tStartMs": 100810,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Here is what each one does to your money."
    } ]
  }, {
    "tStartMs": 103510,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Within days of a decision at the first\nmeeting, the banks move."
    } ]
  }, {
    "tStartMs": 107590,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "They do not announce it. They do not need\nyour agreement."
    } ]
  }, {
    "tStartMs": 111150,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "The rate on your account is a number they\nchoose and change at will, and the"
    } ]
  }, {
    "tStartMs": 115790,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "paperwork you signed when you opened the\naccount says so."
    } ]
  }, {
    "tStartMs": 119310,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The second date works the other way."
    } ]
  }, {
    "tStartMs": 122770,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Whatever is announced on the first of\nNovember holds for everybody who buys"
    } ]
  }, {
    "tStartMs": 127430,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "in the six months after it, and part of it\nholds far longer than that."
    } ]
  }, {
    "tStartMs": 132330,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "We come back to that at the end, because\nthat is the one that costs the most."
    } ]
  }, {
    "tStartMs": 137610,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "What to do with this, and it takes four\nminutes."
    } ]
  }, {
    "tStartMs": 140810,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Before the twenty seventh, find out what\nyour bank is paying you right now."
    } ]
  }, {
    "tStartMs": 145790,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "It is printed on your statement, usually\nin small type near the interest line."
    } ]
  }, {
    "tStartMs": 150510,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "If you cannot find it, telephone and ask\nthem for the rate on your account"
    } ]
  }, {
    "tStartMs": 154930,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "today."
    } ]
  }, {
    "tStartMs": 156210,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Write it on the statement. You will want\nthat number in December."
    } ]
  }, {
    "tStartMs": 160370,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Number two. Sixty six cents, or four\ndollars fifty."
    } ]
  }, {
    "tStartMs": 164430,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Same money, same protection."
    } ]
  }, {
    "tStartMs": 167090,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Here are two figures from this week."
    } ]
  }, {
    "tStartMs": 169510,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "The average savings account in this\ncountry is paying sixty six cents a year"
    } ]
  }, {
    "tStartMs": 173910,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "on every hundred dollars."
    } ]
  }, {
    "tStartMs": 175570,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "The best ones are paying four dollars and\nfifty cents on the same hundred."
    } ]
  }, {
    "tStartMs": 180370,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Nearly seven times, for money that is\ninsured the same way in both places."
    } ]
  }, {
    "tStartMs": 185170,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "I want to be straight about what that is\nand what it is not."
    } ]
  }, {
    "tStartMs": 189130,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "It is not a scheme and it is not a trick\nand I am not going to dress it up"
    } ]
  }, {
    "tStartMs": 193610,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "as one. It is simply that some banks\ncompete for deposits and some do not,"
    } ]
  }, {
    "tStartMs": 199290,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and the ones that do not are relying on\nyou never checking."
    } ]
  }, {
    "tStartMs": 203550,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "There is no catch to explain because there\nis no catch."
    } ]
  }, {
    "tStartMs": 207390,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Work out what that costs you. On twenty\nthousand dollars, the average account"
    } ]
  }, {
    "tStartMs": 212250,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "pays about one hundred and thirty dollars\na year."
    } ]
  }, {
    "tStartMs": 215250,
    "dDurationMs": 2042,
    "segs": [ {
      "utf8": "The better one pays about nine hundred."
    } ]
  }, {
    "tStartMs": 218170,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "That is a gap of roughly seven hundred and\nseventy dollars every twelve months,"
    } ]
  }, {
    "tStartMs": 222770,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "on money you already own, sitting still\neither way."
    } ]
  }, {
    "tStartMs": 227350,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Now read that again, because it is the\nmost valuable line in this video."
    } ]
  }, {
    "tStartMs": 231470,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The gap is not caused by anything you did."
    } ]
  }, {
    "tStartMs": 234270,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "It is caused by which building the money\nis sitting in."
    } ]
  }, {
    "tStartMs": 237790,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Most people over sixty five have never\nseen those two numbers side by side,"
    } ]
  }, {
    "tStartMs": 242410,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "because nothing in ordinary life puts them\nthere."
    } ]
  }, {
    "tStartMs": 246030,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "A bank paying the lower one has no reason\nto show you the higher one, and no"
    } ]
  }, {
    "tStartMs": 250530,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "rule requiring it to. The thing to do is\nnarrow."
    } ]
  }, {
    "tStartMs": 254490,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Take the number you wrote on your\nstatement and compare it against what two"
    } ]
  }, {
    "tStartMs": 257950,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "other banks are paying this week."
    } ]
  }, {
    "tStartMs": 260030,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Not a decision. Just the comparison."
    } ]
  }, {
    "tStartMs": 262770,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "You cannot judge a thing you have never\nmeasured."
    } ]
  }, {
    "tStartMs": 264710,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Number three. A cut reaches you in days."
    } ]
  }, {
    "tStartMs": 268370,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "A rise takes weeks. Since the start of two\nthousand twenty four,"
    } ]
  }, {
    "tStartMs": 273270,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "one and three quarter percent has come off\nthe rate the Federal Reserve charges."
    } ]
  }, {
    "tStartMs": 277730,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Your bank passed every piece of that down\nto you."
    } ]
  }, {
    "tStartMs": 281230,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "The savings rate fell, quietly, in steps\nyou were not told about."
    } ]
  }, {
    "tStartMs": 286290,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Now ask yourself the honest question."
    } ]
  }, {
    "tStartMs": 288910,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "When that rate was climbing, did your\naccount climb with it at the same speed."
    } ]
  }, {
    "tStartMs": 293410,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "It did not. It almost never does."
    } ]
  }, {
    "tStartMs": 297210,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "A cut reaches a savings account within\ndays because the bank has every reason"
    } ]
  }, {
    "tStartMs": 301910,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to move fast."
    } ]
  }, {
    "tStartMs": 303650,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "A rise takes weeks or months because the\nbank has every reason to move slowly,"
    } ]
  }, {
    "tStartMs": 309250,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and nothing in any rule says it has to\nhurry."
    } ]
  }, {
    "tStartMs": 312710,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "That is not a conspiracy and I am not\ngoing to call it one."
    } ]
  }, {
    "tStartMs": 316770,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "It is simply the direction the money runs\nwhen one side writes the terms."
    } ]
  }, {
    "tStartMs": 321370,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "But understand what it means in practice."
    } ]
  }, {
    "tStartMs": 324870,
    "dDurationMs": 5920,
    "segs": [ {
      "utf8": "Over a full cycle, up and then down, you\ncollect the slow half of every increase"
    } ]
  }, {
    "tStartMs": 330790,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "and the fast half of every decrease."
    } ]
  }, {
    "tStartMs": 333970,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "And two to three more cuts are expected\nbefore this is finished."
    } ]
  }, {
    "tStartMs": 338250,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Every one of them will reach your account\nquickly, and not one will be posted"
    } ]
  }, {
    "tStartMs": 342050,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "to you. So here is the practical use of\nknowing it."
    } ]
  }, {
    "tStartMs": 346170,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "If your money is sitting in an account\nthat was slow to rise, it will be quick"
    } ]
  }, {
    "tStartMs": 350570,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to fall."
    } ]
  }, {
    "tStartMs": 351970,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The time to look at that is before the\ntwenty seventh, not after the deposit"
    } ]
  }, {
    "tStartMs": 356410,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "in December comes in smaller. Number four."
    } ]
  }, {
    "tStartMs": 359730,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "What the first of November fixes into a\nsavings bond stays fixed."
    } ]
  }, {
    "tStartMs": 364570,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Here is the one."
    } ]
  }, {
    "tStartMs": 366770,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "You already know this product."
    } ]
  }, {
    "tStartMs": 369830,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Your family gave them at graduations."
    } ]
  }, {
    "tStartMs": 372970,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "People bought them at the bank counter for\nnew babies."
    } ]
  }, {
    "tStartMs": 375570,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "There may be one in a drawer in your house\nright now."
    } ]
  }, {
    "tStartMs": 379490,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "It is a government savings bond, and the\ngovernment still sells them, through"
    } ]
  }, {
    "tStartMs": 384090,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "a site called Treasury Direct."
    } ]
  }, {
    "tStartMs": 386670,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "The rate on them has two halves."
    } ]
  }, {
    "tStartMs": 389070,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "One half moves with prices and is reset\ntwice a year."
    } ]
  }, {
    "tStartMs": 392930,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "The other half is fixed, and the word\nfixed is doing something enormous there."
    } ]
  }, {
    "tStartMs": 398050,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "The fixed half you receive is the one set\non the day you buy, and it does not"
    } ]
  }, {
    "tStartMs": 402450,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "change again for as long as you hold that\nbond."
    } ]
  }, {
    "tStartMs": 404750,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Not for six months. For the whole life of\nit, which can run thirty years."
    } ]
  }, {
    "tStartMs": 410270,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "Right now, for bonds bought since the\nfirst of May, the two halves together"
    } ]
  }, {
    "tStartMs": 415290,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "come to four dollars and twenty six cents\non every hundred, and the fixed part"
    } ]
  }, {
    "tStartMs": 420290,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "of that is ninety cents."
    } ]
  }, {
    "tStartMs": 422590,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "On the first of November, a new fixed\nnumber is set."
    } ]
  }, {
    "tStartMs": 426450,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Sit with the shape of that."
    } ]
  }, {
    "tStartMs": 428430,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Somebody who buys on the thirty first of\nOctober and somebody who buys on the"
    } ]
  }, {
    "tStartMs": 432610,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "second of November are tied to two"
    } ]
  }, {
    "tStartMs": 434970,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "different fixed numbers, and they stay\ntied"
    } ]
  }, {
    "tStartMs": 437370,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to them for decades."
    } ]
  }, {
    "tStartMs": 439250,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "One date, one morning, and the difference\nfollows both of them for the rest"
    } ]
  }, {
    "tStartMs": 443890,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "of their lives. Nobody writes to tell you\nthe new figure."
    } ]
  }, {
    "tStartMs": 448030,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "It is published, it is free, and it is\nannounced on a morning when almost nothing"
    } ]
  }, {
    "tStartMs": 453290,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "else is happening. I am not telling you to\nbuy anything, and I am not going"
    } ]
  }, {
    "tStartMs": 458690,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "to pretend I know which way that number\nmoves."
    } ]
  }, {
    "tStartMs": 461870,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "Nobody does. What I can tell you is the\ndate it is set, which is the first"
    } ]
  }, {
    "tStartMs": 466910,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "of November, and the fact that whatever is\nset that morning is the number you"
    } ]
  }, {
    "tStartMs": 471630,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "carry if you buy afterwards. Here is the\nline through all four."
    } ]
  }, {
    "tStartMs": 477210,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Every one of them is a decision made by\nsomebody who will never know your name,"
    } ]
  }, {
    "tStartMs": 482210,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "on a day nobody posts to you, about money\nthat is already yours."
    } ]
  }, {
    "tStartMs": 487110,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "You are not asked. You are not told."
    } ]
  }, {
    "tStartMs": 490050,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "You are simply paid less, starting from a\nmorning you did not notice."
    } ]
  }, {
    "tStartMs": 496390,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Now the correction, because the internet\nis loud with it this month."
    } ]
  }, {
    "tStartMs": 500310,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "The Federal Reserve did not warn savers\nabout anything."
    } ]
  }, {
    "tStartMs": 504250,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "It has issued no alert and sent no notice\nto a single household."
    } ]
  }, {
    "tStartMs": 508830,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It meets, it sets one rate, and it says so\npublicly."
    } ]
  }, {
    "tStartMs": 513270,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Everything that happens to your account\nafter that is a choice your bank makes"
    } ]
  }, {
    "tStartMs": 517450,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "about how fast to pass it on, and how\nslowly to pass it back."
    } ]
  }, {
    "tStartMs": 521710,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "When a channel tells you a warning went\nout to savers, check who benefits from"
    } ]
  }, {
    "tStartMs": 525870,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "you believing it. There was no warning."
    } ]
  }, {
    "tStartMs": 528470,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "There is a meeting, on the twenty seventh\nand twenty eighth, and a bank that"
    } ]
  }, {
    "tStartMs": 532210,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "will not write to you whichever way it\ngoes."
    } ]
  }, {
    "tStartMs": 535070,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "The difference matters because fear sends\npeople to the wrong move."
    } ]
  }, {
    "tStartMs": 539170,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "A person who believes an emergency is\ncoming pulls money out in a hurry, often"
    } ]
  }, {
    "tStartMs": 543890,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "into something worse, usually after paying\nsomebody to help them do it."
    } ]
  }, {
    "tStartMs": 548190,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "A person who knows there is only a meeting\nand a rate does one thing instead."
    } ]
  }, {
    "tStartMs": 552830,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "They look up what they are being paid."
    } ]
  }, {
    "tStartMs": 554790,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Now the edge of what this video can do."
    } ]
  }, {
    "tStartMs": 557190,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "I cannot see your account and I do not\nknow your bank."
    } ]
  }, {
    "tStartMs": 560510,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "The figures here are national ones from\nthis week and your own may sit above"
    } ]
  }, {
    "tStartMs": 564390,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "or below them."
    } ]
  }, {
    "tStartMs": 566050,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Rates move, and the two dates are\nscheduled, not guaranteed."
    } ]
  }, {
    "tStartMs": 570150,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "The four, said quickly. Two days this\nmonth set what your savings earn, and"
    } ]
  }, {
    "tStartMs": 574650,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "neither one is your bank. The average\naccount pays sixty six cents on a hundred"
    } ]
  }, {
    "tStartMs": 578830,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "while the best pays four dollars fifty,"
    } ]
  }, {
    "tStartMs": 581070,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "for the same money with the same\nprotection."
    } ]
  }, {
    "tStartMs": 583970,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "A cut reaches you in days and a rise takes\nweeks, and one and three quarter"
    } ]
  }, {
    "tStartMs": 588430,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "percent has already come down."
    } ]
  }, {
    "tStartMs": 590270,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "And whatever fixed number the Treasury\nsets on the first of November follows"
    } ]
  }, {
    "tStartMs": 594470,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "a savings bond for its entire life."
    } ]
  }, {
    "tStartMs": 597310,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "None of these figures are hidden."
    } ]
  }, {
    "tStartMs": 599110,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Every one of them is published, free, and\nsitting on a government page or a"
    } ]
  }, {
    "tStartMs": 603070,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "bank page at this moment. They work\nagainst older people for a single reason."
    } ]
  }, {
    "tStartMs": 607430,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "A bank is built to hold money, and not one\npart of it is built to tell you"
    } ]
  }, {
    "tStartMs": 611510,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "when holding it has stopped paying you."
    } ]
  }, {
    "tStartMs": 614170,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "One more thing, because the calls follow\nthe headlines."
    } ]
  }, {
    "tStartMs": 617170,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "No bank telephones a customer to say the\nrate just dropped."
    } ]
  }, {
    "tStartMs": 620690,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "No government office rings anybody about\nsavings bonds."
    } ]
  }, {
    "tStartMs": 624110,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "So if a voice offers to move your money\nsomewhere safer before a deadline,"
    } ]
  }, {
    "tStartMs": 628050,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "or needs your account number to lock in a\nrate for you, understand what has"
    } ]
  }, {
    "tStartMs": 632030,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "actually happened."
    } ]
  }, {
    "tStartMs": 633710,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Somebody read the same news you did and\nbought a list with your name on it."
    } ]
  }, {
    "tStartMs": 637950,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Put the phone down without answering the\nquestion."
    } ]
  }, {
    "tStartMs": 640570,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "And if you know somebody over sixty five\nwith money sitting in one account,"
    } ]
  }, {
    "tStartMs": 644610,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "do not explain any of this to them."
    } ]
  }, {
    "tStartMs": 646690,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Ask what their bank is paying them, and\nwatch how long it takes them to answer."
    } ]
  } ]
}
