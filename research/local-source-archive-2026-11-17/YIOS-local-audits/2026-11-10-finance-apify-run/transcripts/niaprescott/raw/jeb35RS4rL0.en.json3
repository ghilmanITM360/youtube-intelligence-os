    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "money passes to your family in a few quiet days,"
    } ]
  }, {
    "tStartMs": 481579,
    "dDurationMs": 3965,
    "segs": [ {
      "utf8": "or whether it vanishes into months of court and thousands"
    } ]
  }, {
    "tStartMs": 485544,
    "dDurationMs": 4765,
    "segs": [ {
      "utf8": "in fees. That single difference is decided long before you"
    } ]
  }, {
    "tStartMs": 490309,
    "dDurationMs": 2963,
    "segs": [ {
      "utf8": "are gone, by whether you took ten minutes to name"
    } ]
  }, {
    "tStartMs": 493272,
    "dDurationMs": 3844,
    "segs": [ {
      "utf8": "the people you love on your own accounts. Nobody at"
    } ]
  }, {
    "tStartMs": 497116,
    "dDurationMs": 2563,
    "segs": [ {
      "utf8": "the bank is ever going to call and remind you"
    } ]
  }, {
    "tStartMs": 499679,
    "dDurationMs": 3924,
    "segs": [ {
      "utf8": "to do it. The system is perfectly content to let"
    } ]
  }, {
    "tStartMs": 503603,
    "dDurationMs": 4105,
    "segs": [ {
      "utf8": "the account fall into probate, because probate is simply what"
    } ]
  }, {
    "tStartMs": 507708,
    "dDurationMs": 4424,
    "segs": [ {
      "utf8": "happens when you do nothing. Doing nothing is the default."
    } ]
  }, {
    "tStartMs": 512633,
    "dDurationMs": 3644,
    "segs": [ {
      "utf8": "And doing nothing is what quietly costs your family everything."
    } ]
  }, {
    "tStartMs": 516878,
    "dDurationMs": 3363,
    "segs": [ {
      "utf8": "So do not let this become a someday task, the"
    } ]
  }, {
    "tStartMs": 520241,
    "dDurationMs": 2943,
    "segs": [ {
      "utf8": "kind you mean to get to and never quite do."
    } ]
  }, {
    "tStartMs": 523725,
    "dDurationMs": 3844,
    "segs": [ {
      "utf8": "Make it a this week task. Call your bank, or"
    } ]
  }, {
    "tStartMs": 527569,
    "dDurationMs": 3284,
    "segs": [ {
      "utf8": "walk into the branch, and say a few simple words."
    } ]
  }, {
    "tStartMs": 531513,
    "dDurationMs": 4425,
    "segs": [ {
      "utf8": "Add a beneficiary, please, payable on death. They will know"
    } ]
  }, {
    "tStartMs": 535938,
    "dDurationMs": 3404,
    "segs": [ {
      "utf8": "exactly what you mean, and in ten minutes you will"
    } ]
  }, {
    "tStartMs": 539342,
    "dDurationMs": 3424,
    "segs": [ {
      "utf8": "have handed your family the greatest gift there is, the"
    } ]
  }, {
    "tStartMs": 542766,
    "dDurationMs": 2763,
    "segs": [ {
      "utf8": "gift of not having to fight the bank and the"
    } ]
  }, {
    "tStartMs": 545529,
    "dDurationMs": 3483,
    "segs": [ {
      "utf8": "courts in the days after they lose you. You will"
    } ]
  }, {
    "tStartMs": 549012,
    "dDurationMs": 2863,
    "segs": [ {
      "utf8": "have made certain that the money you spent a lifetime"
    } ]
  }, {
    "tStartMs": 551875,
    "dDurationMs": 4525,
    "segs": [ {
      "utf8": "saving actually reaches the hands you saved it for. That"
    } ]
  }, {
    "tStartMs": 556400,
    "dDurationMs": 4585,
    "segs": [ {
      "utf8": "is not paperwork. That is love, written down where it"
    } ]
  }, {
    "tStartMs": 560985,
    "dDurationMs": 3324,
    "segs": [ {
      "utf8": "finally counts. And if there is one person in your"
    } ]
  }, {
    "tStartMs": 564309,
    "dDurationMs": 3223,
    "segs": [ {
      "utf8": "life who keeps money in the bank and has no"
    } ]
  }, {
    "tStartMs": 567532,
    "dDurationMs": 2643,
    "segs": [ {
      "utf8": "plan at all for the day they are gone, a"
    } ]
  }, {
    "tStartMs": 570175,
    "dDurationMs": 3424,
    "segs": [ {
      "utf8": "parent, an old friend, a neighbor living on their own,"
    } ]
  }, {
    "tStartMs": 574099,
    "dDurationMs": 2683,
    "segs": [ {
      "utf8": "this is the one thing worth putting in front of"
    } ]
  }, {
    "tStartMs": 576782,
    "dDurationMs": 3684,
    "segs": [ {
      "utf8": "them. Not for my sake. For the family they would"
    } ]
  }, {
    "tStartMs": 580466,
    "dDurationMs": 3604,
    "segs": [ {
      "utf8": "never want to leave standing outside a locked account, grieving"
    } ]
  }, {
    "tStartMs": 584070,
    "dDurationMs": 3844,
    "segs": [ {
      "utf8": "and reaching for money they cannot touch. Go and set"
    } ]
  }, {
    "tStartMs": 587914,
    "dDurationMs": 3404,
    "segs": [ {
      "utf8": "yours up this week, and then let yourself rest a"
    } ]
  }, {
    "tStartMs": 591318,
    "dDurationMs": 2623,
    "segs": [ {
      "utf8": "little easier, knowing it is finally done."
    } ]
  } ]
}
