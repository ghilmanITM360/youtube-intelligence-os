{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "The house you spent your whole life paying off is the first"
    } ]
  }, {
    "tStartMs": 4200,
    "dDurationMs": 8161,
    "segs": [ {
      "utf8": "thing the government comes for when you need a nursing home and"
    } ]
  }, {
    "tStartMs": 12361,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "the worst part is they wait until you are gone before they"
    } ]
  }, {
    "tStartMs": 12961,
    "dDurationMs": 481,
    "segs": [ {
      "utf8": "send the bill to your family."
    } ]
  }, {
    "tStartMs": 14782,
    "dDurationMs": 9131,
    "segs": [ {
      "utf8": "There is a federal program called M E R P, the Medicaid"
    } ]
  }, {
    "tStartMs": 23913,
    "dDurationMs": 1750,
    "segs": [ {
      "utf8": "Estate Recovery Program, and it requires every single state in the country"
    } ]
  }, {
    "tStartMs": 25663,
    "dDurationMs": 8132,
    "segs": [ {
      "utf8": "to recover the cost of your long term care from your estate"
    } ]
  }, {
    "tStartMs": 33795,
    "dDurationMs": 150,
    "segs": [ {
      "utf8": "after you die."
    } ]
  }, {
    "tStartMs": 33945,
    "dDurationMs": 3550,
    "segs": [ {
      "utf8": "That means if Medicaid paid for your nursing home, and a typical"
    } ]
  }, {
    "tStartMs": 37495,
    "dDurationMs": 6992,
    "segs": [ {
      "utf8": "stay runs between nine thousand and eleven thousand dollars a month in"
    } ]
  }, {
    "tStartMs": 44487,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "twenty twenty six, the state adds up every dollar it spent and"
    } ]
  }, {
    "tStartMs": 46647,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "files a claim against whatever you left behind."
    } ]
  }, {
    "tStartMs": 47047,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And the biggest thing you left behind is the house."
    } ]
  }, {
    "tStartMs": 49827,
    "dDurationMs": 4001,
    "segs": [ {
      "utf8": "The paid off three bedroom house your family thought they were inheriting"
    } ]
  }, {
    "tStartMs": 53828,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "becomes the state's reimbursement fund."
    } ]
  }, {
    "tStartMs": 57469,
    "dDurationMs": 5961,
    "segs": [ {
      "utf8": "This has been the law since nineteen ninety three."
    } ]
  }, {
    "tStartMs": 63430,
    "dDurationMs": 200,
    "segs": [ {
      "utf8": "It is not new."
    } ]
  }, {
    "tStartMs": 63630,
    "dDurationMs": 6140,
    "segs": [ {
      "utf8": "But the reason most families only find out about it after it"
    } ]
  }, {
    "tStartMs": 69770,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "is too late is because nobody in the system has any reason"
    } ]
  }, {
    "tStartMs": 72571,
    "dDurationMs": 150,
    "segs": [ {
      "utf8": "to warn you."
    } ]
  }, {
    "tStartMs": 77072,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "The hospital social worker who helped your mother qualify for Medicaid told"
    } ]
  }, {
    "tStartMs": 77822,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "you the house was safe."
    } ]
  }, {
    "tStartMs": 81712,
    "dDurationMs": 1711,
    "segs": [ {
      "utf8": "The nursing home admissions coordinator said your mother could keep the home"
    } ]
  }, {
    "tStartMs": 83423,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "as long as she intended to return."
    } ]
  }, {
    "tStartMs": 88663,
    "dDurationMs": 2031,
    "segs": [ {
      "utf8": "And both of those statements were technically true while she was alive."
    } ]
  }, {
    "tStartMs": 90694,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "The moment she passed away the rules flipped."
    } ]
  }, {
    "tStartMs": 95655,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "The home became a recoverable asset and the state filed its claim."
    } ]
  }, {
    "tStartMs": 97695,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "What I am going to walk you through is exactly how this"
    } ]
  }, {
    "tStartMs": 101235,
    "dDurationMs": 4941,
    "segs": [ {
      "utf8": "works, exactly who it affects, and four legitimate legal strategies you can"
    } ]
  }, {
    "tStartMs": 106176,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "put in place right now to make sure your home passes to"
    } ]
  }, {
    "tStartMs": 109577,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "your family and not to the state."
    } ]
  }, {
    "tStartMs": 112317,
    "dDurationMs": 3981,
    "segs": [ {
      "utf8": "These are real, these are legal, and every single one of them"
    } ]
  }, {
    "tStartMs": 116298,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "requires you to act before you need care because once you are"
    } ]
  }, {
    "tStartMs": 119978,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "in a nursing home the window has already closed."
    } ]
  }, {
    "tStartMs": 123819,
    "dDurationMs": 4261,
    "segs": [ {
      "utf8": "The first thing you need to understand is why Medicare does not save you."
    } ]
  }, {
    "tStartMs": 128640,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Most people assume that because they paid into Medicare their entire working"
    } ]
  }, {
    "tStartMs": 132360,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "life, Medicare will cover a nursing home when they need one."
    } ]
  }, {
    "tStartMs": 136441,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "That assumption is wrong."
    } ]
  }, {
    "tStartMs": 138721,
    "dDurationMs": 5181,
    "segs": [ {
      "utf8": "Medicare covers what is called skilled nursing care, things like physical therapy"
    } ]
  }, {
    "tStartMs": 143902,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "after a hip replacement or wound care that needs a registered nurse,"
    } ]
  }, {
    "tStartMs": 148183,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "and it covers that for a maximum of one hundred days."
    } ]
  }, {
    "tStartMs": 151983,
    "dDurationMs": 4081,
    "segs": [ {
      "utf8": "After day one hundred Medicare stops paying entirely."
    } ]
  }, {
    "tStartMs": 156864,
    "dDurationMs": 3961,
    "segs": [ {
      "utf8": "But eighty five percent of people in nursing homes are not there"
    } ]
  }, {
    "tStartMs": 160825,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "for skilled nursing care."
    } ]
  }, {
    "tStartMs": 162885,
    "dDurationMs": 4801,
    "segs": [ {
      "utf8": "They are there for custodial care, help bathing, help eating, help getting"
    } ]
  }, {
    "tStartMs": 167686,
    "dDurationMs": 4881,
    "segs": [ {
      "utf8": "dressed, help taking their medication, help not wandering outside at three in"
    } ]
  }, {
    "tStartMs": 172567,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "the morning because the dementia took the part of the brain that"
    } ]
  }, {
    "tStartMs": 175747,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "knows where the front door leads."
    } ]
  }, {
    "tStartMs": 178328,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Medicare does not pay for custodial care."
    } ]
  }, {
    "tStartMs": 181268,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Not for one day."
    } ]
  }, {
    "tStartMs": 182728,
    "dDurationMs": 6301,
    "segs": [ {
      "utf8": "In twenty twenty six the average cost of custodial nursing home care"
    } ]
  }, {
    "tStartMs": 189029,
    "dDurationMs": 6071,
    "segs": [ {
      "utf8": "in this country is between nine thousand and eleven thousand dollars a"
    } ]
  }, {
    "tStartMs": 195100,
    "dDurationMs": 50,
    "segs": [ {
      "utf8": "month."
    } ]
  }, {
    "tStartMs": 196511,
    "dDurationMs": 3010,
    "segs": [ {
      "utf8": "In a memory care unit you are closer to eight thousand for"
    } ]
  }, {
    "tStartMs": 199521,
    "dDurationMs": 3771,
    "segs": [ {
      "utf8": "assisted living and significantly more for a full nursing facility."
    } ]
  }, {
    "tStartMs": 203292,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The median retirement savings for an American sixty five year old is"
    } ]
  }, {
    "tStartMs": 205372,
    "dDurationMs": 7071,
    "segs": [ {
      "utf8": "roughly two hundred and eighty thousand dollars."
    } ]
  }, {
    "tStartMs": 212443,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "That entire nest egg gets burned through in about two and a"
    } ]
  }, {
    "tStartMs": 213043,
    "dDurationMs": 1190,
    "segs": [ {
      "utf8": "half years of nursing home care."
    } ]
  }, {
    "tStartMs": 214433,
    "dDurationMs": 5541,
    "segs": [ {
      "utf8": "After that the family applies for Medicaid because Medicaid is the only"
    } ]
  }, {
    "tStartMs": 219974,
    "dDurationMs": 4361,
    "segs": [ {
      "utf8": "government program that covers unlimited custodial long term care."
    } ]
  }, {
    "tStartMs": 225355,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "But Medicaid is a poverty program."
    } ]
  }, {
    "tStartMs": 228636,
    "dDurationMs": 6741,
    "segs": [ {
      "utf8": "To qualify you need to have two thousand dollars or less in countable assets."
    } ]
  }, {
    "tStartMs": 240998,
    "dDurationMs": 210,
    "segs": [ {
      "utf8": "Two thousand."
    } ]
  }, {
    "tStartMs": 241208,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "Your savings, your investments, your life insurance cash value, almost everything has"
    } ]
  }, {
    "tStartMs": 242138,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "to be spent down to almost nothing before Medicaid steps in."
    } ]
  }, {
    "tStartMs": 245458,
    "dDurationMs": 5641,
    "segs": [ {
      "utf8": "The one asset that is technically exempt during your lifetime is your"
    } ]
  }, {
    "tStartMs": 251099,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "home, as long as you have the legal intent to return."
    } ]
  }, {
    "tStartMs": 255440,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "But that exemption ends the day you die."
    } ]
  }, {
    "tStartMs": 258800,
    "dDurationMs": 4181,
    "segs": [ {
      "utf8": "The second thing you need to understand is the five year lookback trap."
    } ]
  }, {
    "tStartMs": 263761,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "Some people hear all of this and think the solution is simple,"
    } ]
  }, {
    "tStartMs": 267462,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "just give the house to the kids before you need care and"
    } ]
  }, {
    "tStartMs": 270742,
    "dDurationMs": 2121,
    "segs": [ {
      "utf8": "the state cannot touch what you do not own."
    } ]
  }, {
    "tStartMs": 273623,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "The federal government anticipated that move decades ago."
    } ]
  }, {
    "tStartMs": 277463,
    "dDurationMs": 4281,
    "segs": [ {
      "utf8": "When you apply for Medicaid the state goes through every financial transaction"
    } ]
  }, {
    "tStartMs": 281744,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "you made in the prior sixty months."
    } ]
  }, {
    "tStartMs": 284744,
    "dDurationMs": 5141,
    "segs": [ {
      "utf8": "Five full years of bank statements, real estate transfers, gifts, everything."
    } ]
  }, {
    "tStartMs": 290585,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "If they find that you gave away assets or sold them for"
    } ]
  }, {
    "tStartMs": 293766,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "less than fair market value they impose a transfer penalty."
    } ]
  }, {
    "tStartMs": 298227,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "The penalty is calculated by dividing the value of what you gave"
    } ]
  }, {
    "tStartMs": 301847,
    "dDurationMs": 3661,
    "segs": [ {
      "utf8": "away by the average monthly cost of care in your state."
    } ]
  }, {
    "tStartMs": 306128,
    "dDurationMs": 6011,
    "segs": [ {
      "utf8": "On a three hundred thousand dollar house in a state where nursing"
    } ]
  }, {
    "tStartMs": 312139,
    "dDurationMs": 4090,
    "segs": [ {
      "utf8": "home care costs ten thousand a month that works out to a"
    } ]
  }, {
    "tStartMs": 316229,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "thirty month penalty, two and a half years during which you cannot"
    } ]
  }, {
    "tStartMs": 318170,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "receive Medicaid."
    } ]
  }, {
    "tStartMs": 319690,
    "dDurationMs": 4081,
    "segs": [ {
      "utf8": "You need care, you cannot pay for it, and Medicaid will not"
    } ]
  }, {
    "tStartMs": 323771,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "cover you because you tried to give the house away too close"
    } ]
  }, {
    "tStartMs": 327671,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "to when you needed help."
    } ]
  }, {
    "tStartMs": 329311,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "This is why last minute planning does not work."
    } ]
  }, {
    "tStartMs": 332692,
    "dDurationMs": 3761,
    "segs": [ {
      "utf8": "The architecture has to be built while you are still healthy, still"
    } ]
  }, {
    "tStartMs": 336453,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "walking, still mowing your own lawn."
    } ]
  }, {
    "tStartMs": 339533,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "Every month you wait the five year clock starts that much later."
    } ]
  }, {
    "tStartMs": 343834,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Now here are the four strategies that actually protect your home."
    } ]
  }, {
    "tStartMs": 347934,
    "dDurationMs": 3581,
    "segs": [ {
      "utf8": "Each one is real, each one is legal, and each one works"
    } ]
  }, {
    "tStartMs": 351515,
    "dDurationMs": 3441,
    "segs": [ {
      "utf8": "differently depending on your state and your situation."
    } ]
  }, {
    "tStartMs": 355416,
    "dDurationMs": 6181,
    "segs": [ {
      "utf8": "Strategy number one is the Medicaid Asset Protection Trust, sometimes called a"
    } ]
  }, {
    "tStartMs": 361597,
    "dDurationMs": 2830,
    "segs": [ {
      "utf8": "M A P T."
    } ]
  }, {
    "tStartMs": 364427,
    "dDurationMs": 3030,
    "segs": [ {
      "utf8": "This is the most powerful tool available to middle class families in"
    } ]
  }, {
    "tStartMs": 367457,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "twenty twenty six."
    } ]
  }, {
    "tStartMs": 369418,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "It is an irrevocable trust which means once you transfer your home"
    } ]
  }, {
    "tStartMs": 372738,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "into it you no longer legally own it."
    } ]
  }, {
    "tStartMs": 375999,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "You continue living in the house, you continue paying the property taxes,"
    } ]
  }, {
    "tStartMs": 380420,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "you continue maintaining it, nothing changes from the outside."
    } ]
  }, {
    "tStartMs": 384180,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "But legally the home belongs to the trust."
    } ]
  }, {
    "tStartMs": 387701,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Once five years have passed from the date of the transfer the"
    } ]
  }, {
    "tStartMs": 390941,
    "dDurationMs": 4621,
    "segs": [ {
      "utf8": "lookback window has closed and the home is completely invisible to Medicaid."
    } ]
  }, {
    "tStartMs": 396422,
    "dDurationMs": 4051,
    "segs": [ {
      "utf8": "When you die the state files its M E R P claim"
    } ]
  }, {
    "tStartMs": 400473,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "against your estate but the house is not in your estate."
    } ]
  }, {
    "tStartMs": 403223,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "It is in the trust."
    } ]
  }, {
    "tStartMs": 404783,
    "dDurationMs": 3361,
    "segs": [ {
      "utf8": "The trust distributes the home to your children free and clear."
    } ]
  }, {
    "tStartMs": 408144,
    "dDurationMs": 4321,
    "segs": [ {
      "utf8": "The cost to set up a properly drafted M A P T"
    } ]
  }, {
    "tStartMs": 412465,
    "dDurationMs": 6051,
    "segs": [ {
      "utf8": "through an elder law attorney runs between three thousand and ten thousand"
    } ]
  }, {
    "tStartMs": 418516,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "dollars depending on your state and the complexity of your situation."
    } ]
  }, {
    "tStartMs": 420976,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "On a house worth three hundred thousand dollars or more that is"
    } ]
  }, {
    "tStartMs": 424877,
    "dDurationMs": 1690,
    "segs": [ {
      "utf8": "the best money you will ever spend."
    } ]
  }, {
    "tStartMs": 427367,
    "dDurationMs": 3581,
    "segs": [ {
      "utf8": "Strategy number two is the caregiver child exception."
    } ]
  }, {
    "tStartMs": 431508,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "This one is written directly into federal Medicaid law and it is"
    } ]
  }, {
    "tStartMs": 435368,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "one of the cleanest exemptions that exists."
    } ]
  }, {
    "tStartMs": 438489,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "If an adult child moves into your home, lives there for at"
    } ]
  }, {
    "tStartMs": 441969,
    "dDurationMs": 4641,
    "segs": [ {
      "utf8": "least two continuous years immediately before you enter a nursing home, and"
    } ]
  }, {
    "tStartMs": 446610,
    "dDurationMs": 4081,
    "segs": [ {
      "utf8": "provides care during that time that allowed you to stay home rather"
    } ]
  }, {
    "tStartMs": 450691,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "than go into a facility sooner, you can transfer the home to"
    } ]
  }, {
    "tStartMs": 454551,
    "dDurationMs": 2561,
    "segs": [ {
      "utf8": "that child with zero lookback penalty."
    } ]
  }, {
    "tStartMs": 457832,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "The transfer is exempt."
    } ]
  }, {
    "tStartMs": 459792,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "The requirements are strict."
    } ]
  }, {
    "tStartMs": 461192,
    "dDurationMs": 6101,
    "segs": [ {
      "utf8": "The child must be a biological or adopted child, not a stepchild or grandchild."
    } ]
  }, {
    "tStartMs": 467953,
    "dDurationMs": 4801,
    "segs": [ {
      "utf8": "The two years must be continuous and immediately before your institutionalization."
    } ]
  }, {
    "tStartMs": 472774,
    "dDurationMs": 4541,
    "segs": [ {
      "utf8": "And there must be documentation, medical records showing you would have needed"
    } ]
  }, {
    "tStartMs": 477315,
    "dDurationMs": 5401,
    "segs": [ {
      "utf8": "facility care without the child's help, a caregiving log, and ideally an"
    } ]
  }, {
    "tStartMs": 482716,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "attorney structuring the transfer."
    } ]
  }, {
    "tStartMs": 484936,
    "dDurationMs": 4061,
    "segs": [ {
      "utf8": "But done correctly this is a complete escape from both the lookback"
    } ]
  }, {
    "tStartMs": 489217,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "penalty and M E R P recovery."
    } ]
  }, {
    "tStartMs": 493057,
    "dDurationMs": 6241,
    "segs": [ {
      "utf8": "Strategy number three is the ladybird deed, also called an enhanced life estate deed."
    } ]
  }, {
    "tStartMs": 499438,
    "dDurationMs": 5101,
    "segs": [ {
      "utf8": "This is only available in a handful of states including Florida, Texas,"
    } ]
  }, {
    "tStartMs": 504979,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "Michigan, Vermont, and West Virginia."
    } ]
  }, {
    "tStartMs": 508560,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "A ladybird deed lets you retain full control of your home during"
    } ]
  }, {
    "tStartMs": 512020,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "your lifetime, you can sell it, you can mortgage it, you can"
    } ]
  }, {
    "tStartMs": 515561,
    "dDurationMs": 4361,
    "segs": [ {
      "utf8": "do whatever you want with it, while automatically transferring the property to"
    } ]
  }, {
    "tStartMs": 519922,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "your named beneficiary when you die without going through probate."
    } ]
  }, {
    "tStartMs": 524902,
    "dDurationMs": 4681,
    "segs": [ {
      "utf8": "Because the home never enters probate many states cannot recover it through"
    } ]
  }, {
    "tStartMs": 529583,
    "dDurationMs": 2450,
    "segs": [ {
      "utf8": "M E R P."
    } ]
  }, {
    "tStartMs": 532033,
    "dDurationMs": 2891,
    "segs": [ {
      "utf8": "In Florida a ladybird deed is one of the most powerful and"
    } ]
  }, {
    "tStartMs": 534924,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "least expensive Medicaid protection tools available."
    } ]
  }, {
    "tStartMs": 538484,
    "dDurationMs": 5181,
    "segs": [ {
      "utf8": "An attorney can draft one for between four hundred and one thousand dollars."
    } ]
  }, {
    "tStartMs": 543665,
    "dDurationMs": 2501,
    "segs": [ {
      "utf8": "It does not help you qualify for Medicaid and it does not"
    } ]
  }, {
    "tStartMs": 546166,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "protect the home during the lookback period."
    } ]
  }, {
    "tStartMs": 549066,
    "dDurationMs": 3321,
    "segs": [ {
      "utf8": "But for M E R P recovery after death in the states"
    } ]
  }, {
    "tStartMs": 552387,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "that recognise it, it is devastatingly effective."
    } ]
  }, {
    "tStartMs": 555907,
    "dDurationMs": 4261,
    "segs": [ {
      "utf8": "Strategy number four is for married couples and it is called the"
    } ]
  }, {
    "tStartMs": 560168,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "community spouse resource allowance."
    } ]
  }, {
    "tStartMs": 563368,
    "dDurationMs": 3701,
    "segs": [ {
      "utf8": "When one spouse needs nursing home care and the other does not,"
    } ]
  }, {
    "tStartMs": 567609,
    "dDurationMs": 3801,
    "segs": [ {
      "utf8": "federal law allows the healthy spouse to keep a protected amount of"
    } ]
  }, {
    "tStartMs": 571410,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "assets."
    } ]
  }, {
    "tStartMs": 572730,
    "dDurationMs": 5501,
    "segs": [ {
      "utf8": "In twenty twenty six the maximum community spouse resource allowance is approximately"
    } ]
  }, {
    "tStartMs": 578231,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "one hundred and fifty seven thousand dollars in countable assets plus the"
    } ]
  }, {
    "tStartMs": 582731,
    "dDurationMs": 4261,
    "segs": [ {
      "utf8": "home, plus one vehicle, plus various other exempt categories."
    } ]
  }, {
    "tStartMs": 587752,
    "dDurationMs": 3821,
    "segs": [ {
      "utf8": "The healthy spouse keeps that allowance and continues living in the home."
    } ]
  }, {
    "tStartMs": 592433,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "The home cannot be sold while they are living in it."
    } ]
  }, {
    "tStartMs": 595453,
    "dDurationMs": 3801,
    "segs": [ {
      "utf8": "In some states including New York and Florida there is also an"
    } ]
  }, {
    "tStartMs": 599254,
    "dDurationMs": 5541,
    "segs": [ {
      "utf8": "aggressive technique called spousal refusal where the healthy spouse formally declines to"
    } ]
  }, {
    "tStartMs": 604795,
    "dDurationMs": 4141,
    "segs": [ {
      "utf8": "make their income and assets available for the institutionalised spouse's care."
    } ]
  }, {
    "tStartMs": 609976,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "This forces Medicaid to evaluate the nursing home spouse based only on"
    } ]
  }, {
    "tStartMs": 614256,
    "dDurationMs": 4341,
    "segs": [ {
      "utf8": "their own resources which can accelerate eligibility significantly."
    } ]
  }, {
    "tStartMs": 619457,
    "dDurationMs": 4301,
    "segs": [ {
      "utf8": "The state may later attempt to recover from the healthy spouse but"
    } ]
  }, {
    "tStartMs": 623758,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "the immediate Medicaid qualification is preserved."
    } ]
  }, {
    "tStartMs": 627539,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Now here is what I need you to understand about timing."
    } ]
  }, {
    "tStartMs": 632239,
    "dDurationMs": 3941,
    "segs": [ {
      "utf8": "Every one of these strategies works best when you are healthy."
    } ]
  }, {
    "tStartMs": 636960,
    "dDurationMs": 7351,
    "segs": [ {
      "utf8": "The M A P T needs five years to clear the lookback."
    } ]
  }, {
    "tStartMs": 644311,
    "dDurationMs": 1770,
    "segs": [ {
      "utf8": "The caregiver child exception needs two years of documented live in care."
    } ]
  }, {
    "tStartMs": 646782,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "The ladybird deed needs to be recorded before you need Medicaid."
    } ]
  }, {
    "tStartMs": 651302,
    "dDurationMs": 4841,
    "segs": [ {
      "utf8": "The spousal protections need to be in place before the nursing home admission."
    } ]
  }, {
    "tStartMs": 656923,
    "dDurationMs": 4741,
    "segs": [ {
      "utf8": "Once the crisis hits, once the fall happens, once the dementia diagnosis"
    } ]
  }, {
    "tStartMs": 661664,
    "dDurationMs": 5101,
    "segs": [ {
      "utf8": "lands, your options shrink dramatically and the cost of whatever protection you"
    } ]
  }, {
    "tStartMs": 666765,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "can still get goes up."
    } ]
  }, {
    "tStartMs": 669285,
    "dDurationMs": 3701,
    "segs": [ {
      "utf8": "The average American over sixty five has a nearly one in three"
    } ]
  }, {
    "tStartMs": 672986,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "chance of needing some form of long term care."
    } ]
  }, {
    "tStartMs": 676546,
    "dDurationMs": 8452,
    "segs": [ {
      "utf8": "The average stay in a nursing home is just over two years."
    } ]
  }, {
    "tStartMs": 684998,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "The average cost over that stay can easily reach two hundred thousand"
    } ]
  }, {
    "tStartMs": 690128,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "to three hundred thousand dollars."
    } ]
  }, {
    "tStartMs": 694029,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "And M E R P operates in every single state in the country."
    } ]
  }, {
    "tStartMs": 695749,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "So here is what you do."
    } ]
  }, {
    "tStartMs": 696049,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "Step one, find out how your home is titled right now."
    } ]
  }, {
    "tStartMs": 699470,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "Is it in your name alone, is it joint tenancy, is it"
    } ]
  }, {
    "tStartMs": 707651,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "in a trust."
    } ]
  }, {
    "tStartMs": 707971,
    "dDurationMs": 200,
    "segs": [ {
      "utf8": "You need to know."
    } ]
  }, {
    "tStartMs": 708171,
    "dDurationMs": 6761,
    "segs": [ {
      "utf8": "Step two, find an elder law attorney in your state, not a"
    } ]
  }, {
    "tStartMs": 714932,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "general attorney, not a tax preparer, an elder law attorney who specialises"
    } ]
  }, {
    "tStartMs": 715532,
    "dDurationMs": 3661,
    "segs": [ {
      "utf8": "in Medicaid planning."
    } ]
  }, {
    "tStartMs": 719193,
    "dDurationMs": 3691,
    "segs": [ {
      "utf8": "The National Academy of Elder Law Attorneys maintains a directory."
    } ]
  }, {
    "tStartMs": 722884,
    "dDurationMs": 5470,
    "segs": [ {
      "utf8": "Step three, schedule the consultation."
    } ]
  }, {
    "tStartMs": 728354,
    "dDurationMs": 5491,
    "segs": [ {
      "utf8": "It will cost you between two hundred and seven hundred and fifty dollars."
    } ]
  }, {
    "tStartMs": 733845,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "That consultation will tell you which of these four strategies fits your"
    } ]
  }, {
    "tStartMs": 734445,
    "dDurationMs": 571,
    "segs": [ {
      "utf8": "state, your situation, and your family."
    } ]
  }, {
    "tStartMs": 735196,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Step four, start the clock."
    } ]
  }, {
    "tStartMs": 737596,
    "dDurationMs": 4701,
    "segs": [ {
      "utf8": "Whatever the attorney recommends, get the paperwork done because every month you"
    } ]
  }, {
    "tStartMs": 742297,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "wait is a month the five year window slides further back."
    } ]
  }, {
    "tStartMs": 746017,
    "dDurationMs": 3501,
    "segs": [ {
      "utf8": "I will put all the details and links in the description below."
    } ]
  }, {
    "tStartMs": 749958,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "Send this to someone in your family who owns their home and"
    } ]
  }, {
    "tStartMs": 754059,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "has no plan for this."
    } ]
  }, {
    "tStartMs": 755859,
    "dDurationMs": 5161,
    "segs": [ {
      "utf8": "A parent, a brother, a sister, someone at church, someone you care about."
    } ]
  }, {
    "tStartMs": 761720,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Because right now the most common way families find out about M"
    } ]
  }, {
    "tStartMs": 767201,
    "dDurationMs": 7411,
    "segs": [ {
      "utf8": "E R P is from a certified letter that arrives after the"
    } ]
  }, {
    "tStartMs": 774612,
    "dDurationMs": 50,
    "segs": [ {
      "utf8": "funeral."
    } ]
  }, {
    "tStartMs": 774662,
    "dDurationMs": 450,
    "segs": [ {
      "utf8": "By then the house is already on the line."
    } ]
  }, {
    "tStartMs": 775112,
    "dDurationMs": 470,
    "segs": [ {
      "utf8": "One share from you changes that."
    } ]
  }, {
    "tStartMs": 776102,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "I will see you in the next one."
    } ]
  } ]
}
