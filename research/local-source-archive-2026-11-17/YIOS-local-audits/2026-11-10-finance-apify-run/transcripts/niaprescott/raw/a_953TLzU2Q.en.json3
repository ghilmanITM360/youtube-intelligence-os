  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Right now, in twenty twenty six, there is one"
    } ]
  }, {
    "tStartMs": 4100,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "collector in this country that can reach straight into your"
    } ]
  }, {
    "tStartMs": 7061,
    "dDurationMs": 3721,
    "segs": [ {
      "utf8": "bank account and pull your money out, without ever suing"
    } ]
  }, {
    "tStartMs": 10782,
    "dDurationMs": 3881,
    "segs": [ {
      "utf8": "you, without going to court, and without a single judge"
    } ]
  }, {
    "tStartMs": 14663,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "signing off on it."
    } ]
  }, {
    "tStartMs": 16463,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "It is the Internal Revenue Service."
    } ]
  }, {
    "tStartMs": 19784,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "Most people believe that before anyone can touch the money"
    } ]
  }, {
    "tStartMs": 23245,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "in your account, they first have to take you to"
    } ]
  }, {
    "tStartMs": 26326,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "court and win, and for almost every creditor in this"
    } ]
  }, {
    "tStartMs": 30427,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "country, that is exactly true."
    } ]
  }, {
    "tStartMs": 33848,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "But the tax agency is the one great exception, and"
    } ]
  }, {
    "tStartMs": 37668,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "that is what makes it so frightening."
    } ]
  }, {
    "tStartMs": 40229,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "Welcome back, and I am really glad you are here"
    } ]
  }, {
    "tStartMs": 43430,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "today, because what I am about to walk you through"
    } ]
  }, {
    "tStartMs": 46311,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "could protect the money you depend on most."
    } ]
  }, {
    "tStartMs": 49831,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "Here is what they will never sit you down and"
    } ]
  }, {
    "tStartMs": 52052,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "explain."
    } ]
  }, {
    "tStartMs": 53452,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "There are strict limits on what they are allowed to"
    } ]
  }, {
    "tStartMs": 56153,
    "dDurationMs": 3301,
    "segs": [ {
      "utf8": "take, there is a thirty day window that can stop"
    } ]
  }, {
    "tStartMs": 59454,
    "dDurationMs": 4201,
    "segs": [ {
      "utf8": "them cold, and your Social Security is far more protected"
    } ]
  }, {
    "tStartMs": 63655,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "than you think."
    } ]
  }, {
    "tStartMs": 64995,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "So stay with me to the end, because by the"
    } ]
  }, {
    "tStartMs": 67676,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "time we are done you will know exactly how this"
    } ]
  }, {
    "tStartMs": 70276,
    "dDurationMs": 3321,
    "segs": [ {
      "utf8": "works, and exactly how to keep your money safe."
    } ]
  }, {
    "tStartMs": 73897,
    "dDurationMs": 3941,
    "segs": [ {
      "utf8": "Let me start with what this power actually is, because"
    } ]
  }, {
    "tStartMs": 77838,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "understanding it is the first step to not being afraid"
    } ]
  }, {
    "tStartMs": 81019,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "of it."
    } ]
  }, {
    "tStartMs": 82139,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "When you owe back taxes and the matter goes unresolved"
    } ]
  }, {
    "tStartMs": 85240,
    "dDurationMs": 3761,
    "segs": [ {
      "utf8": "for long enough, the Internal Revenue Service can issue what"
    } ]
  }, {
    "tStartMs": 89001,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "is called a levy."
    } ]
  }, {
    "tStartMs": 91221,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "A bank levy means they instruct your bank to freeze"
    } ]
  }, {
    "tStartMs": 94282,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "the money in your account and send it to the"
    } ]
  }, {
    "tStartMs": 96723,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "government to pay down what you owe."
    } ]
  }, {
    "tStartMs": 99643,
    "dDurationMs": 3121,
    "segs": [ {
      "utf8": "Unlike a credit card company or a hospital or a"
    } ]
  }, {
    "tStartMs": 102764,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "collection agency, all of whom must sue you in court"
    } ]
  }, {
    "tStartMs": 105725,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "first, the tax agency has the legal authority to do"
    } ]
  }, {
    "tStartMs": 109626,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "this on its own."
    } ]
  }, {
    "tStartMs": 111066,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "That is what makes it different, and that is why"
    } ]
  }, {
    "tStartMs": 113927,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "it scares people."
    } ]
  }, {
    "tStartMs": 115287,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "But I want you to hear this clearly, because it"
    } ]
  }, {
    "tStartMs": 117728,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "is the most important thing in this whole video."
    } ]
  }, {
    "tStartMs": 120628,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "This does not happen out of nowhere."
    } ]
  }, {
    "tStartMs": 122909,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "It does not happen by surprise."
    } ]
  }, {
    "tStartMs": 125229,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "The law requires them to warn you first, and that"
    } ]
  }, {
    "tStartMs": 128430,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "warning is your protection."
    } ]
  }, {
    "tStartMs": 130791,
    "dDurationMs": 3581,
    "segs": [ {
      "utf8": "Here is how the timeline really works, and the timeline"
    } ]
  }, {
    "tStartMs": 134372,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "is everything."
    } ]
  }, {
    "tStartMs": 135852,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "Before the tax agency can touch a single dollar in"
    } ]
  }, {
    "tStartMs": 138693,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "your account, they are required by law to send you"
    } ]
  }, {
    "tStartMs": 142293,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "a specific letter."
    } ]
  }, {
    "tStartMs": 144014,
    "dDurationMs": 3301,
    "segs": [ {
      "utf8": "It is called a final notice of intent to levy,"
    } ]
  }, {
    "tStartMs": 147335,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and it also tells you about your right to a"
    } ]
  }, {
    "tStartMs": 150255,
    "dDurationMs": 260,
    "segs": [ {
      "utf8": "hearing."
    } ]
  }, {
    "tStartMs": 150515,
    "dDurationMs": 3521,
    "segs": [ {
      "utf8": "From the day they send that final notice, they must"
    } ]
  }, {
    "tStartMs": 154036,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "wait at least thirty days before they can take any"
    } ]
  }, {
    "tStartMs": 157377,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "money."
    } ]
  }, {
    "tStartMs": 157697,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "Thirty days."
    } ]
  }, {
    "tStartMs": 158277,
    "dDurationMs": 3581,
    "segs": [ {
      "utf8": "That window exists for one reason, to give you the"
    } ]
  }, {
    "tStartMs": 161858,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "chance to act, and the people who lose their money"
    } ]
  }, {
    "tStartMs": 164919,
    "dDurationMs": 3141,
    "segs": [ {
      "utf8": "are almost always the people who let that window close"
    } ]
  }, {
    "tStartMs": 168060,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "without doing anything."
    } ]
  }, {
    "tStartMs": 170360,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "During those thirty days, you have the right to request"
    } ]
  }, {
    "tStartMs": 173421,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "a formal hearing, and the moment you request it, the"
    } ]
  }, {
    "tStartMs": 176962,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "law forbids them from going ahead with the levy until"
    } ]
  }, {
    "tStartMs": 180062,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "your hearing is resolved."
    } ]
  }, {
    "tStartMs": 182363,
    "dDurationMs": 3841,
    "segs": [ {
      "utf8": "In plain terms, asking for that hearing pushes the pause"
    } ]
  }, {
    "tStartMs": 186204,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "button on the whole thing."
    } ]
  }, {
    "tStartMs": 188004,
    "dDurationMs": 3601,
    "segs": [ {
      "utf8": "That single step, a written request made inside the thirty"
    } ]
  }, {
    "tStartMs": 191605,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "day window, is one of the most powerful protections you"
    } ]
  }, {
    "tStartMs": 194686,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "have, and almost nobody uses it."
    } ]
  }, {
    "tStartMs": 197627,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Now let me tell you what happens even if a"
    } ]
  }, {
    "tStartMs": 200907,
    "dDurationMs": 3501,
    "segs": [ {
      "utf8": "levy does go through, because there is a second safety"
    } ]
  }, {
    "tStartMs": 204408,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "net most people have no idea exists."
    } ]
  }, {
    "tStartMs": 208009,
    "dDurationMs": 2741,
    "segs": [ {
      "utf8": "When the tax agency does send a levy to your"
    } ]
  }, {
    "tStartMs": 210750,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "bank, the bank does not hand the money over that"
    } ]
  }, {
    "tStartMs": 213670,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "same day."
    } ]
  }, {
    "tStartMs": 214891,
    "dDurationMs": 3721,
    "segs": [ {
      "utf8": "By law, the bank must hold the frozen funds for"
    } ]
  }, {
    "tStartMs": 218612,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "twenty one days before sending anything to the government."
    } ]
  }, {
    "tStartMs": 223013,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "That twenty one day hold is deliberate."
    } ]
  }, {
    "tStartMs": 225693,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "It is a final chance for you to fix the"
    } ]
  }, {
    "tStartMs": 228014,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "situation, to prove the money should not be taken, or"
    } ]
  }, {
    "tStartMs": 231915,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "to set up an arrangement that releases the hold."
    } ]
  }, {
    "tStartMs": 235216,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So between the thirty day notice and the twenty one"
    } ]
  }, {
    "tStartMs": 237856,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "day bank hold, you actually have a great deal more"
    } ]
  }, {
    "tStartMs": 240797,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "time and a great deal more control than the fear"
    } ]
  }, {
    "tStartMs": 244038,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "would ever lead you to believe."
    } ]
  }, {
    "tStartMs": 246118,
    "dDurationMs": 3321,
    "segs": [ {
      "utf8": "So what are your options during that time, when you"
    } ]
  }, {
    "tStartMs": 249439,
    "dDurationMs": 2831,
    "segs": [ {
      "utf8": "owe but you cannot simply write a check for the"
    } ]
  }, {
    "tStartMs": 252270,
    "dDurationMs": 670,
    "segs": [ {
      "utf8": "full amount?"
    } ]
  }, {
    "tStartMs": 253440,
    "dDurationMs": 3321,
    "segs": [ {
      "utf8": "You have several, and they all stop the bleeding."
    } ]
  }, {
    "tStartMs": 257501,
    "dDurationMs": 2821,
    "segs": [ {
      "utf8": "You can set up a payment plan, where you agree"
    } ]
  }, {
    "tStartMs": 260322,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "to pay the debt over time in monthly amounts you"
    } ]
  }, {
    "tStartMs": 263262,
    "dDurationMs": 3321,
    "segs": [ {
      "utf8": "can actually afford, and once that plan is in place"
    } ]
  }, {
    "tStartMs": 267043,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "the levy threat goes away."
    } ]
  }, {
    "tStartMs": 269364,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "If the debt is large and there is a genuine"
    } ]
  }, {
    "tStartMs": 272024,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "case that you will never be able to pay all"
    } ]
  }, {
    "tStartMs": 274185,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "of it, there is a process where the government agrees"
    } ]
  }, {
    "tStartMs": 277046,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "to settle for less than the full amount."
    } ]
  }, {
    "tStartMs": 280806,
    "dDurationMs": 2741,
    "segs": [ {
      "utf8": "And here is the one that matters most for seniors"
    } ]
  }, {
    "tStartMs": 283547,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "living on a fixed income."
    } ]
  }, {
    "tStartMs": 285608,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "If your income and your resources are low enough that"
    } ]
  }, {
    "tStartMs": 288768,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "paying the tax debt would leave you unable to cover"
    } ]
  }, {
    "tStartMs": 291669,
    "dDurationMs": 3221,
    "segs": [ {
      "utf8": "your basic living expenses, you can be placed in a"
    } ]
  }, {
    "tStartMs": 294890,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "status that the agency calls not collectible."
    } ]
  }, {
    "tStartMs": 298711,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "When you are in that status, they stop all collection"
    } ]
  }, {
    "tStartMs": 301871,
    "dDurationMs": 561,
    "segs": [ {
      "utf8": "activity."
    } ]
  }, {
    "tStartMs": 302432,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "No levy, no seizure, nothing, for as long"
    } ]
  }, {
    "tStartMs": 306533,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "as your situation stays that tight."
    } ]
  }, {
    "tStartMs": 309473,
    "dDurationMs": 4121,
    "segs": [ {
      "utf8": "Many retirees living mostly on Social Security qualify for"
    } ]
  }, {
    "tStartMs": 313594,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "exactly this protection and never know to ask for it."
    } ]
  }, {
    "tStartMs": 317475,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "And that brings me to the part I most want"
    } ]
  }, {
    "tStartMs": 320156,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "you to hear, because it is the part that lets"
    } ]
  }, {
    "tStartMs": 322956,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "you breathe."
    } ]
  }, {
    "tStartMs": 324497,
    "dDurationMs": 4441,
    "segs": [ {
      "utf8": "People imagine the tax agency emptying their entire Social Security"
    } ]
  }, {
    "tStartMs": 328938,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "check, leaving them with nothing to live on."
    } ]
  }, {
    "tStartMs": 332019,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "That is not what the law allows."
    } ]
  }, {
    "tStartMs": 334719,
    "dDurationMs": 4181,
    "segs": [ {
      "utf8": "Your Social Security retirement and survivors benefits cannot be drained"
    } ]
  }, {
    "tStartMs": 338900,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "completely to pay a tax debt."
    } ]
  }, {
    "tStartMs": 341621,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "The most they are allowed to take through their main"
    } ]
  }, {
    "tStartMs": 343681,
    "dDurationMs": 3561,
    "segs": [ {
      "utf8": "program for this is fifteen percent of your monthly benefit."
    } ]
  }, {
    "tStartMs": 347742,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Not all of it."
    } ]
  }, {
    "tStartMs": 349123,
    "dDurationMs": 1570,
    "segs": [ {
      "utf8": "Fifteen percent."
    } ]
  }, {
    "tStartMs": 350693,
    "dDurationMs": 3591,
    "segs": [ {
      "utf8": "So even in the worst case, eighty five percent of"
    } ]
  }, {
    "tStartMs": 354284,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "that check is still yours and still arrives."
    } ]
  }, {
    "tStartMs": 358065,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "And it gets better from there."
    } ]
  }, {
    "tStartMs": 360625,
    "dDurationMs": 4141,
    "segs": [ {
      "utf8": "If your only income is Supplemental Security Income, the needs"
    } ]
  }, {
    "tStartMs": 364766,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "based payment for people with very little, that money is"
    } ]
  }, {
    "tStartMs": 368147,
    "dDurationMs": 1461,
    "segs": [ {
      "utf8": "completely off limits."
    } ]
  }, {
    "tStartMs": 370408,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The tax agency cannot take a single dollar of it."
    } ]
  }, {
    "tStartMs": 374409,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "And if you are a veteran receiving benefits from the"
    } ]
  }, {
    "tStartMs": 377009,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "Department of Veterans Affairs, those benefits are protected too."
    } ]
  }, {
    "tStartMs": 381430,
    "dDurationMs": 4241,
    "segs": [ {
      "utf8": "The agency cannot levy your veterans disability or your veterans"
    } ]
  }, {
    "tStartMs": 385671,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "pension to collect a tax debt."
    } ]
  }, {
    "tStartMs": 388152,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "So the very income that a senior depends on most"
    } ]
  }, {
    "tStartMs": 390853,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "to survive is the income the law shields the hardest."
    } ]
  }, {
    "tStartMs": 395574,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "Let me make this real for a moment, because the"
    } ]
  }, {
    "tStartMs": 398915,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "difference between the two paths could not be sharper."
    } ]
  }, {
    "tStartMs": 402895,
    "dDurationMs": 3501,
    "segs": [ {
      "utf8": "Picture two people who owe the very same back taxes"
    } ]
  }, {
    "tStartMs": 406396,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "and who receive the very same final notice on the"
    } ]
  }, {
    "tStartMs": 410077,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "very same day."
    } ]
  }, {
    "tStartMs": 412038,
    "dDurationMs": 3721,
    "segs": [ {
      "utf8": "The first one opens the envelope, sees the words about"
    } ]
  }, {
    "tStartMs": 415759,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "the levy and the right to a hearing, and within"
    } ]
  }, {
    "tStartMs": 418599,
    "dDurationMs": 2721,
    "segs": [ {
      "utf8": "those thirty days simply picks up the phone."
    } ]
  }, {
    "tStartMs": 422000,
    "dDurationMs": 2381,
    "segs": [ {
      "utf8": "They either set up a small monthly payment they can"
    } ]
  }, {
    "tStartMs": 424381,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "actually manage, or they explain that they live mostly on"
    } ]
  }, {
    "tStartMs": 428282,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Social Security and cannot pay right now."
    } ]
  }, {
    "tStartMs": 431162,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "For that person, the levy never happens."
    } ]
  }, {
    "tStartMs": 434583,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "The account is never frozen, the monthly check keeps arriving"
    } ]
  }, {
    "tStartMs": 437964,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "on time, and the whole matter quietly moves onto a"
    } ]
  }, {
    "tStartMs": 441505,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "path they can handle."
    } ]
  }, {
    "tStartMs": 443325,
    "dDurationMs": 3761,
    "segs": [ {
      "utf8": "The second person feels the exact same fear, but instead"
    } ]
  }, {
    "tStartMs": 447086,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "of opening the letter, they slide it into a drawer"
    } ]
  }, {
    "tStartMs": 449887,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and try not to think about it."
    } ]
  }, {
    "tStartMs": 452527,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "The thirty days pass."
    } ]
  }, {
    "tStartMs": 454268,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "The levy goes through."
    } ]
  }, {
    "tStartMs": 455968,
    "dDurationMs": 3361,
    "segs": [ {
      "utf8": "The account is frozen, the money is pulled out, and"
    } ]
  }, {
    "tStartMs": 459329,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "only then, in a panic, do they finally reach for"
    } ]
  }, {
    "tStartMs": 462370,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "the phone."
    } ]
  }, {
    "tStartMs": 463430,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "Same debt, same letter, same income."
    } ]
  }, {
    "tStartMs": 466931,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The only thing that separated keeping their money from losing"
    } ]
  }, {
    "tStartMs": 469811,
    "dDurationMs": 3761,
    "segs": [ {
      "utf8": "it was whether they opened the envelope and acted while"
    } ]
  }, {
    "tStartMs": 473572,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "the window was still open."
    } ]
  }, {
    "tStartMs": 475313,
    "dDurationMs": 3781,
    "segs": [ {
      "utf8": "Now let me name the one mistake that turns all"
    } ]
  }, {
    "tStartMs": 479094,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "of this protection into a disaster, because it is the"
    } ]
  }, {
    "tStartMs": 482454,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "same mistake every single time."
    } ]
  }, {
    "tStartMs": 485175,
    "dDurationMs": 3261,
    "segs": [ {
      "utf8": "It is ignoring the letters."
    } ]
  }, {
    "tStartMs": 488436,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "The levy, the frozen account, the money pulled out, none"
    } ]
  }, {
    "tStartMs": 491377,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "of that happens to the person who opens the mail"
    } ]
  }, {
    "tStartMs": 494137,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "and responds."
    } ]
  }, {
    "tStartMs": 495978,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "It happens to the person who sees an envelope from"
    } ]
  }, {
    "tStartMs": 498638,
    "dDurationMs": 3721,
    "segs": [ {
      "utf8": "the tax agency, feels a wave of dread, and puts"
    } ]
  }, {
    "tStartMs": 502359,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "it in a drawer unopened because they cannot bear to"
    } ]
  }, {
    "tStartMs": 505760,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "look."
    } ]
  }, {
    "tStartMs": 506280,
    "dDurationMs": 4221,
    "segs": [ {
      "utf8": "Every protection I just described, the thirty day window,"
    } ]
  }, {
    "tStartMs": 510921,
    "dDurationMs": 3121,
    "segs": [ {
      "utf8": "the right to a hearing, the payment plans, the not"
    } ]
  }, {
    "tStartMs": 514042,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "collectible status, every one of them depends on you acting"
    } ]
  }, {
    "tStartMs": 518143,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "inside the deadlines."
    } ]
  }, {
    "tStartMs": 520003,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "And you cannot act on a deadline you never read."
    } ]
  }, {
    "tStartMs": 523764,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "So if a letter from the Internal Revenue Service ever"
    } ]
  }, {
    "tStartMs": 526425,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "arrives, the bravest and the smartest thing you can do"
    } ]
  }, {
    "tStartMs": 529906,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "is the same thing."
    } ]
  }, {
    "tStartMs": 531746,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "Open it that day."
    } ]
  }, {
    "tStartMs": 533387,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "Find the deadline."
    } ]
  }, {
    "tStartMs": 534787,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "And respond before it passes."
    } ]
  }, {
    "tStartMs": 537268,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "So here is exactly what to do if this is"
    } ]
  }, {
    "tStartMs": 539808,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "you, or if it ever becomes you."
    } ]
  }, {
    "tStartMs": 542369,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Do not panic, and do not hide from it."
    } ]
  }, {
    "tStartMs": 545169,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "Open every notice the day it comes and look for"
    } ]
  }, {
    "tStartMs": 548370,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "the date."
    } ]
  }, {
    "tStartMs": 549530,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "If you see the words final notice of intent to"
    } ]
  }, {
    "tStartMs": 552151,
    "dDurationMs": 3861,
    "segs": [ {
      "utf8": "levy, understand that your thirty day clock has started and"
    } ]
  }, {
    "tStartMs": 556012,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "you need to act now, not next month."
    } ]
  }, {
    "tStartMs": 559113,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "You do not have to face the tax agency alone."
    } ]
  }, {
    "tStartMs": 562854,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "You can call them directly to set up a payment"
    } ]
  }, {
    "tStartMs": 565694,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "plan, and for anything complicated you can bring in a"
    } ]
  }, {
    "tStartMs": 569375,
    "dDurationMs": 4081,
    "segs": [ {
      "utf8": "tax professional, an enrolled agent, or a low income taxpayer"
    } ]
  }, {
    "tStartMs": 573456,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "clinic, many of which help seniors for free."
    } ]
  }, {
    "tStartMs": 577337,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "Tell them about your income, especially if you are living"
    } ]
  }, {
    "tStartMs": 580418,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "mainly on Social Security, because that is the fact that"
    } ]
  }, {
    "tStartMs": 584339,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "often unlocks the not collectible protection."
    } ]
  }, {
    "tStartMs": 588200,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "The tax agency is far more willing to work with"
    } ]
  }, {
    "tStartMs": 590760,
    "dDurationMs": 3261,
    "segs": [ {
      "utf8": "a person who responds than to chase one who disappears."
    } ]
  }, {
    "tStartMs": 594801,
    "dDurationMs": 2181,
    "segs": [ {
      "utf8": "Your power here is not in fighting."
    } ]
  }, {
    "tStartMs": 597482,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "It is in answering."
    } ]
  }, {
    "tStartMs": 598922,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "Let me bring this all together, because the thread is"
    } ]
  }, {
    "tStartMs": 602403,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "the same one that runs through so much of what"
    } ]
  }, {
    "tStartMs": 604864,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "we talk about on this channel."
    } ]
  }, {
    "tStartMs": 607104,
    "dDurationMs": 3861,
    "segs": [ {
      "utf8": "Yes, the tax agency holds a power that no ordinary"
    } ]
  }, {
    "tStartMs": 610965,
    "dDurationMs": 3581,
    "segs": [ {
      "utf8": "creditor has, the power to reach your account without a"
    } ]
  }, {
    "tStartMs": 614546,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "courtroom."
    } ]
  }, {
    "tStartMs": 615386,
    "dDurationMs": 3701,
    "segs": [ {
      "utf8": "But that power is fenced in on every side by"
    } ]
  }, {
    "tStartMs": 619087,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "rules that exist to protect you."
    } ]
  }, {
    "tStartMs": 621107,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "They have to warn you first."
    } ]
  }, {
    "tStartMs": 623308,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "They have to give you thirty days."
    } ]
  }, {
    "tStartMs": 625549,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "The bank has to wait twenty one more."
    } ]
  }, {
    "tStartMs": 628369,
    "dDurationMs": 4461,
    "segs": [ {
      "utf8": "Your Social Security is mostly shielded, your Supplemental Security"
    } ]
  }, {
    "tStartMs": 632830,
    "dDurationMs": 4141,
    "segs": [ {
      "utf8": "Income entirely so, and your veterans benefits completely."
    } ]
  }, {
    "tStartMs": 637611,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "The system is not built to leave a retiree with"
    } ]
  }, {
    "tStartMs": 640272,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "nothing."
    } ]
  }, {
    "tStartMs": 641072,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "It is built to collect from the people who never"
    } ]
  }, {
    "tStartMs": 643473,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "respond, and to leave alone the people who stand up,"
    } ]
  }, {
    "tStartMs": 647194,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "open the letter, and ask for the help that is"
    } ]
  }, {
    "tStartMs": 649994,
    "dDurationMs": 681,
    "segs": [ {
      "utf8": "already there."
    } ]
  }, {
    "tStartMs": 650875,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "So do one kind thing before you go."
    } ]
  }, {
    "tStartMs": 655416,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Think of someone you love who would rather hide a"
    } ]
  }, {
    "tStartMs": 658416,
    "dDurationMs": 3901,
    "segs": [ {
      "utf8": "scary envelope in a drawer than open it, someone who"
    } ]
  }, {
    "tStartMs": 662317,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "carries a quiet worry about money they may owe and"
    } ]
  }, {
    "tStartMs": 665798,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "has no idea how many protections already stand between them"
    } ]
  }, {
    "tStartMs": 669719,
    "dDurationMs": 1120,
    "segs": [ {
      "utf8": "and disaster."
    } ]
  }, {
    "tStartMs": 671319,
    "dDurationMs": 4241,
    "segs": [ {
      "utf8": "A brother, a sister, an old friend, a neighbor"
    } ]
  }, {
    "tStartMs": 675560,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "living alone on a fixed income."
    } ]
  }, {
    "tStartMs": 677961,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Send them this video today."
    } ]
  }, {
    "tStartMs": 680502,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "It costs you two minutes, and it could replace months"
    } ]
  }, {
    "tStartMs": 683542,
    "dDurationMs": 3441,
    "segs": [ {
      "utf8": "of silent fear with the simple knowledge that they have"
    } ]
  }, {
    "tStartMs": 686983,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "rights, they have time, and most of their money is"
    } ]
  }, {
    "tStartMs": 690904,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "already protected."
    } ]
  }, {
    "tStartMs": 692464,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "There are few things you can hand another person that"
    } ]
  }, {
    "tStartMs": 695165,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "lift a weight like that."
    } ]
  }, {
    "tStartMs": 697206,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "So go on, and help someone you care about feel"
    } ]
  }, {
    "tStartMs": 700326,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "safe in their own bank account again."
    } ]
  }, {
    "tStartMs": 703287,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I will see you in the next one."
    } ]
  } ]
}
