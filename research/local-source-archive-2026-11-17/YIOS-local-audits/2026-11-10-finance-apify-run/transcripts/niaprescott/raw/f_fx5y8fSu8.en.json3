{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "I do not get crap in Illinois."
    } ]
  }, {
    "tStartMs": 2840,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "That is a comment under the last video\nlike this one."
    } ]
  }, {
    "tStartMs": 6100,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Right below it, another comment."
    } ]
  }, {
    "tStartMs": 8440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Not in California."
    } ]
  }, {
    "tStartMs": 10120,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "And the comment that more people agreed\nwith than any other was not a complaint"
    } ]
  }, {
    "tStartMs": 13780,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "at all. It was a question. What states do\nall of these apply to."
    } ]
  }, {
    "tStartMs": 18780,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Somebody watching this paid a bill last\nmonth that stopped being theirs years"
    } ]
  }, {
    "tStartMs": 22560,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "ago. They will pay it again in 3 weeks."
    } ]
  }, {
    "tStartMs": 24900,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "And the months they already paid are gone."
    } ]
  }, {
    "tStartMs": 27200,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "There is no form for those. Nobody sends\nthem back."
    } ]
  }, {
    "tStartMs": 30940,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "You did not miss a chance. You paid."
    } ]
  }, {
    "tStartMs": 33320,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "That money is spent and you are not\ngetting it back."
    } ]
  }, {
    "tStartMs": 36920,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So I am answering the state question\nbefore I name a single bill."
    } ]
  }, {
    "tStartMs": 40660,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Most lists like this mix two different\nthings together and never say which"
    } ]
  }, {
    "tStartMs": 44520,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "is which."
    } ]
  }, {
    "tStartMs": 45700,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Some of what they name is the same in\nevery state, on every street in this"
    } ]
  }, {
    "tStartMs": 49560,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "country. The rest is run by your county,\nor your state, or a program with a"
    } ]
  }, {
    "tStartMs": 54600,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "waiting list, and whether you get it is\ndecided in an office you have never"
    } ]
  }, {
    "tStartMs": 58480,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "been to. So you call, you are told no, and\nyou decide the whole thing was nonsense."
    } ]
  }, {
    "tStartMs": 64140,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "It was not nonsense. It was the wrong half\nof the list."
    } ]
  }, {
    "tStartMs": 67580,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "That cost you a year. Today I removed the\nwrong half."
    } ]
  }, {
    "tStartMs": 71520,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "The five bills in this video are the same\nin Texas, in Illinois, in California,"
    } ]
  }, {
    "tStartMs": 76660,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "in all 50 states. Every one of them."
    } ]
  }, {
    "tStartMs": 79620,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "There is no county office in this video\nand no waiting list."
    } ]
  }, {
    "tStartMs": 83120,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And not one of the five asks what you\nearn."
    } ]
  }, {
    "tStartMs": 86180,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Nobody checks your income, nobody counts\nwhat you have saved, and no form asks"
    } ]
  }, {
    "tStartMs": 90800,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "what your house is worth. You do nothing\nand they stop."
    } ]
  }, {
    "tStartMs": 95080,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "The other two keep arriving until you pick\nup the telephone and ask for them."
    } ]
  }, {
    "tStartMs": 100120,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "No office will call you first."
    } ]
  }, {
    "tStartMs": 102440,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Every month you wait, you pay those two\nagain."
    } ]
  }, {
    "tStartMs": 105640,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "I am not reading your file and I cannot\nsee your paperwork."
    } ]
  }, {
    "tStartMs": 109080,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "What I can tell you is which of these the\nlaw requires and which one depends"
    } ]
  }, {
    "tStartMs": 114480,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "on somebody being nice to you."
    } ]
  }, {
    "tStartMs": 116440,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "All five of these are the law."
    } ]
  }, {
    "tStartMs": 118740,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Number one. The extra deduction at 65."
    } ]
  }, {
    "tStartMs": 122300,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "The day you turned 65, the amount of your\nincome that gets taxed went down."
    } ]
  }, {
    "tStartMs": 127620,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Permanently. Every year from then on."
    } ]
  }, {
    "tStartMs": 130800,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "The figure for this year is $2,050 if you\nare on your own."
    } ]
  }, {
    "tStartMs": 135360,
    "dDurationMs": 6220,
    "segs": [ {
      "utf8": "For a married couple it is $1,650 for each\nperson who is 65 or"
    } ]
  }, {
    "tStartMs": 141580,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "older, so if you are both that age it is\n$3,300."
    } ]
  }, {
    "tStartMs": 145980,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "That is not a refund you claim once."
    } ]
  }, {
    "tStartMs": 148580,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "It is subtracted every single year for the\nrest of the years you file."
    } ]
  }, {
    "tStartMs": 153340,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Now the part that makes this item worth\nmore than the money."
    } ]
  }, {
    "tStartMs": 156380,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "There is no income limit on it."
    } ]
  }, {
    "tStartMs": 158740,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "None. You can have a pension, rental\nincome, a paid off house, money in the"
    } ]
  }, {
    "tStartMs": 163860,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "bank, and it does not change this figure\nby one cent."
    } ]
  }, {
    "tStartMs": 167720,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "That matters because there is a second\nsenior deduction, the $6,000 one, and"
    } ]
  }, {
    "tStartMs": 172740,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "that one does disappear as your income\nclimbs."
    } ]
  }, {
    "tStartMs": 175760,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It starts shrinking above $75,000 for one\nperson."
    } ]
  }, {
    "tStartMs": 180040,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "People hear about that one, assume they\nearn too much, and then assume the"
    } ]
  }, {
    "tStartMs": 183900,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "same thing about this one. They are two\ndifferent lines on two different parts"
    } ]
  }, {
    "tStartMs": 188020,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "of the form. This one has no ceiling at\nall."
    } ]
  }, {
    "tStartMs": 190860,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "And it is not automatic. The number has to\nbe entered."
    } ]
  }, {
    "tStartMs": 194560,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "If somebody prepares your taxes, they\nalmost certainly caught it."
    } ]
  }, {
    "tStartMs": 198180,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "If you fill in your own return and you\nticked the wrong box about your age,"
    } ]
  }, {
    "tStartMs": 202240,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "you did not get it, and you will not be\ntold."
    } ]
  }, {
    "tStartMs": 205160,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "So here is what to do, and it takes 4\nminutes."
    } ]
  }, {
    "tStartMs": 208480,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Pull out the return you filed last year."
    } ]
  }, {
    "tStartMs": 210900,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Find the standard deduction line."
    } ]
  }, {
    "tStartMs": 212600,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "If you were 65 or older and the figure you\nsee is the plain amount with nothing"
    } ]
  }, {
    "tStartMs": 217280,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "added, it was missed. You can go back and\namend a return for 3 years, and that"
    } ]
  }, {
    "tStartMs": 222840,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "is 3 years of tax back. If somebody else\ndid your taxes, say this to them."
    } ]
  }, {
    "tStartMs": 228440,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Confirm my age 65 standard deduction was\napplied, and show me the line."
    } ]
  }, {
    "tStartMs": 233760,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Not ask whether it was. Make them show\nyou."
    } ]
  }, {
    "tStartMs": 236820,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Number two. The shingles shot, and three\nmore like it."
    } ]
  }, {
    "tStartMs": 240360,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "The shingles shot. Two doses, and for\nyears it ran past $200 for the pair,"
    } ]
  }, {
    "tStartMs": 245360,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "because it sat on the wrong side of the\nrules and your drug plan was allowed"
    } ]
  }, {
    "tStartMs": 249380,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "to charge you. That ended."
    } ]
  }, {
    "tStartMs": 252020,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Adult vaccines on the recommended list now\ncost you nothing under a Medicare"
    } ]
  }, {
    "tStartMs": 256320,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "drug plan. No copay. And no deductible,\nwhich means you do not have to spend"
    } ]
  }, {
    "tStartMs": 261520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "anything first."
    } ]
  }, {
    "tStartMs": 263140,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Shingles. The one for the lung virus they\nnow offer to older adults."
    } ]
  }, {
    "tStartMs": 267560,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Tetanus. Whooping cough. All of them,\nnothing."
    } ]
  }, {
    "tStartMs": 271280,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "This one is on the list because of how\noften it goes wrong at the counter,"
    } ]
  }, {
    "tStartMs": 274720,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "and it is not your mistake when it does."
    } ]
  }, {
    "tStartMs": 276780,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "There are two different sides to Medicare\nthat can pay for a shot."
    } ]
  }, {
    "tStartMs": 281060,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "One side is your doctor. The other side is\nyour drug plan."
    } ]
  }, {
    "tStartMs": 284640,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "These vaccines are paid by the drug plan\nside."
    } ]
  }, {
    "tStartMs": 287260,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "If the pharmacy or the clinic sends it to\nthe wrong side, the claim comes back"
    } ]
  }, {
    "tStartMs": 291360,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "as not covered, and somebody tells you\nthere is a charge."
    } ]
  }, {
    "tStartMs": 293340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So when they tell you there is a charge,"
    } ]
  }, {
    "tStartMs": 294920,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "you do not pay it and you do not walk\naway."
    } ]
  }, {
    "tStartMs": 298100,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "You say this. Please run this through my\nPart D drug plan, not the medical"
    } ]
  }, {
    "tStartMs": 302040,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "side. That one sentence fixes most of them\nwhile you stand there."
    } ]
  }, {
    "tStartMs": 306040,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "And if you already paid for a shingles\nshot after it became free, your plan"
    } ]
  }, {
    "tStartMs": 310840,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "can be made to pay you back. Call"
    } ]
  }, {
    "tStartMs": 312860,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "them, give them the date, and ask for\nreimbursement."
    } ]
  }, {
    "tStartMs": 316560,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "Number three. Insulin at $35. If you take\ninsulin, you pay no more than $35"
    } ]
  }, {
    "tStartMs": 322260,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "a month for it. Each insulin product."
    } ]
  }, {
    "tStartMs": 325160,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Not $35 for all of them together, $35\neach."
    } ]
  }, {
    "tStartMs": 328800,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Three things about that number that people\nget wrong."
    } ]
  }, {
    "tStartMs": 331540,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "It applies no matter which phase of the\nyear your plan says you are in."
    } ]
  }, {
    "tStartMs": 335420,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It applies even before you have paid your\ndeductible."
    } ]
  }, {
    "tStartMs": 338220,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "And it applies whatever tier your plan has\nput the insulin on."
    } ]
  }, {
    "tStartMs": 342420,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "There is no version of this where the plan\ngets to charge you more because"
    } ]
  }, {
    "tStartMs": 346180,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "of a tier. Before this rule, people were\npaying $300 and $400 a month, and"
    } ]
  }, {
    "tStartMs": 351340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "some of them were cutting doses in half to\nstretch a pen."
    } ]
  }, {
    "tStartMs": 354640,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "That is what this replaced. So the\ninstruction here is short."
    } ]
  }, {
    "tStartMs": 358880,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Look at what you paid at the pharmacy last\nmonth."
    } ]
  }, {
    "tStartMs": 361360,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "If the number is higher than $35 for one\ninsulin, the plan has it wrong, not"
    } ]
  }, {
    "tStartMs": 366420,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "you. Call the number on the back of the\ncard and say this."
    } ]
  }, {
    "tStartMs": 369980,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "My insulin was charged above the $35\nlimit, I want it corrected and I want"
    } ]
  }, {
    "tStartMs": 374900,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the difference back. They will fix it."
    } ]
  }, {
    "tStartMs": 377500,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "They do not fix it on their own."
    } ]
  }, {
    "tStartMs": 379560,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Number four. Your free yearly visit with\nthe doctor."
    } ]
  }, {
    "tStartMs": 382860,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Once a year you can sit with a doctor, go\nthrough your medicines, your memory,"
    } ]
  }, {
    "tStartMs": 387100,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "your balance, your risks, and build a\nwritten plan for the year."
    } ]
  }, {
    "tStartMs": 390160,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "You pay nothing for it. Not a copay, and\nthe deductible does not apply."
    } ]
  }, {
    "tStartMs": 395360,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "In your first year on Medicare there is a\nseparate one, a one off visit, and"
    } ]
  }, {
    "tStartMs": 399320,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "that is free as well. And the screenings\naround them are free too."
    } ]
  }, {
    "tStartMs": 403220,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Colon cancer. Many cancer screenings."
    } ]
  }, {
    "tStartMs": 405800,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Diabetes checks if you are at risk."
    } ]
  }, {
    "tStartMs": 407780,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "The blood check for heart disease."
    } ]
  }, {
    "tStartMs": 409440,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "A bone density scan when the rules call\nfor it."
    } ]
  }, {
    "tStartMs": 411940,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Here is the part that catches people, and\nit catches them every single year."
    } ]
  }, {
    "tStartMs": 416560,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "That yearly visit is not a physical."
    } ]
  }, {
    "tStartMs": 419520,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "It is a planning conversation."
    } ]
  }, {
    "tStartMs": 421840,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "If you walk in and start talking about a\nknee that hurts, the doctor has to"
    } ]
  }, {
    "tStartMs": 425900,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "treat that, and treating it is a different\nkind of visit that does get billed."
    } ]
  }, {
    "tStartMs": 430780,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Same chair, same day, two different\nthings."
    } ]
  }, {
    "tStartMs": 434460,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "So do two things when you book."
    } ]
  }, {
    "tStartMs": 436640,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Say the words annual wellness visit when\nyou call the office, not check up"
    } ]
  }, {
    "tStartMs": 441160,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "and not physical. And at the start of the\nappointment, say this."
    } ]
  }, {
    "tStartMs": 445500,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "I am here for the free yearly wellness\nvisit."
    } ]
  }, {
    "tStartMs": 449160,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "If anything else needs looking at, tell me\nfirst that it will be billed separately."
    } ]
  }, {
    "tStartMs": 454200,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "That sentence costs nothing and it is the\ndifference between a free visit and"
    } ]
  }, {
    "tStartMs": 458480,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "a bill in 3 weeks. One honest line."
    } ]
  }, {
    "tStartMs": 461880,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "If a free screening finds something, what\nhappens next is ordinary care, and"
    } ]
  }, {
    "tStartMs": 466700,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "ordinary care is billed. The screening is\nfree."
    } ]
  }, {
    "tStartMs": 470600,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Treating what it finds is not, and nobody\nshould tell you otherwise."
    } ]
  }, {
    "tStartMs": 475000,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Number five. The donut hole is gone."
    } ]
  }, {
    "tStartMs": 478360,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "For nearly 20 years there was a hole in\nthe middle of Medicare drug coverage."
    } ]
  }, {
    "tStartMs": 482640,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "You paid your share, then at a certain\npoint your plan stepped back and you"
    } ]
  }, {
    "tStartMs": 486620,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "paid far more, and then eventually help\ncame back."
    } ]
  }, {
    "tStartMs": 490200,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "People called it the donut hole and\nplanned their whole year around it."
    } ]
  }, {
    "tStartMs": 493920,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It is gone. It was removed last year."
    } ]
  }, {
    "tStartMs": 496780,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "There is no middle phase any more."
    } ]
  }, {
    "tStartMs": 499000,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "What replaced it is a ceiling."
    } ]
  }, {
    "tStartMs": 501340,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Once what you have paid out of your own\npocket for covered medicines reaches"
    } ]
  }, {
    "tStartMs": 504860,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "$2,100 this year, you pay nothing more for\nthose medicines until January."
    } ]
  }, {
    "tStartMs": 510480,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Not a smaller amount. Nothing."
    } ]
  }, {
    "tStartMs": 513200,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "I am putting this on the list because of\nwhat people still do in the autumn."
    } ]
  }, {
    "tStartMs": 517320,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "They skip a refill, or they split tablets,\nor they put off a new medicine until"
    } ]
  }, {
    "tStartMs": 522060,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "the new year, because they are protecting\nthemselves against a gap that no"
    } ]
  }, {
    "tStartMs": 525980,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "longer exists. That is not caution any\nmore."
    } ]
  }, {
    "tStartMs": 529120,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "That is paying for a rule somebody\ndeleted."
    } ]
  }, {
    "tStartMs": 532260,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "So the job is to know your own total."
    } ]
  }, {
    "tStartMs": 535260,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Add up what you have paid at the pharmacy\nsince January."
    } ]
  }, {
    "tStartMs": 538160,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "If it is near $2,100, you are close to the\npoint where the rest of the year"
    } ]
  }, {
    "tStartMs": 542800,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "costs you nothing. Keep your receipts,\nbecause plans do get the tally wrong,"
    } ]
  }, {
    "tStartMs": 547240,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "and if you are still being charged above\nthe ceiling you call them and say"
    } ]
  }, {
    "tStartMs": 550980,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "you have reached the yearly limit."
    } ]
  }, {
    "tStartMs": 552720,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "So that is the five. The tax line at 65."
    } ]
  }, {
    "tStartMs": 556200,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The shingles shot. The insulin ceiling."
    } ]
  }, {
    "tStartMs": 558680,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "The yearly visit. The ceiling that\nreplaced the donut hole."
    } ]
  }, {
    "tStartMs": 562500,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Three of them need nothing from you."
    } ]
  }, {
    "tStartMs": 564400,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "The vaccines, the insulin price, and the\ndrug ceiling all happen on their own,"
    } ]
  }, {
    "tStartMs": 568800,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "and your only job is to notice when a\npharmacy gets one of them wrong."
    } ]
  }, {
    "tStartMs": 573240,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Two of them need you. The deduction has to\nbe on the return."
    } ]
  }, {
    "tStartMs": 576660,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The wellness visit has to be booked, with\nthe right words."
    } ]
  }, {
    "tStartMs": 580240,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Not one of the five changes if you move\nhouse."
    } ]
  }, {
    "tStartMs": 582900,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Not one of them asks what you earn."
    } ]
  }, {
    "tStartMs": 585300,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "One last thing, and it is not a sixth\nitem, because it breaks the rule I set"
    } ]
  }, {
    "tStartMs": 590040,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "at the start. You may have heard about a\none off payment of $90 towards the"
    } ]
  }, {
    "tStartMs": 594220,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Part B premium. That is real. It is going\nto about 20 million people."
    } ]
  }, {
    "tStartMs": 598740,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "And roughly 40 million others are not\ngetting it, because it only goes to people"
    } ]
  }, {
    "tStartMs": 602660,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "on original Medicare who are not on a\nMedicare Advantage plan, who do not pay"
    } ]
  }, {
    "tStartMs": 607160,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "the higher income premium, and who do not\nalready have their premium paid for"
    } ]
  }, {
    "tStartMs": 611080,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "them. There is no form and there is no\nappeal."
    } ]
  }, {
    "tStartMs": 613900,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Look at your bank record once, and if it\nis not there, let it go."
    } ]
  }, {
    "tStartMs": 618880,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "I am telling you because somebody will try\nto sell you help getting it."
    } ]
  }, {
    "tStartMs": 622740,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Everything here is general education."
    } ]
  }, {
    "tStartMs": 625060,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "I do not know your plan, your income or\nwhat is in your file, and those three"
    } ]
  }, {
    "tStartMs": 629200,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "decide your own figure."
    } ]
  }, {
    "tStartMs": 631180,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "And if your mother or your father is still\npaying one of these five, do not"
    } ]
  }, {
    "tStartMs": 634860,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "forward them this video. Sit down beside\nthem and read their pharmacy receipt"
    } ]
  }, {
    "tStartMs": 639320,
    "dDurationMs": 730,
    "segs": [ {
      "utf8": "together."
    } ]
  } ]
}
