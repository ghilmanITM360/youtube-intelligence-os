{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Every month there is money taken out of\nyour check before you ever see it."
    } ]
  }, {
    "tStartMs": 5320,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "You have never paid it by hand."
    } ]
  }, {
    "tStartMs": 7400,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "It is simply moved."
    } ]
  }, {
    "tStartMs": 9660,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "There is a program that will pay that\namount for you."
    } ]
  }, {
    "tStartMs": 12880,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "Not refund it. Pay it, so it stops being\ntaken and your deposit is larger next"
    } ]
  }, {
    "tStartMs": 18680,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "month. You may have qualified for years."
    } ]
  }, {
    "tStartMs": 21960,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "You will not be told. A rule was written\nso the government would find people"
    } ]
  }, {
    "tStartMs": 26860,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "like you and sign them up itself."
    } ]
  }, {
    "tStartMs": 30060,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Somebody switched that rule off."
    } ]
  }, {
    "tStartMs": 32540,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "No letter will reach you, because nobody\nwrites to you about a thing that did"
    } ]
  }, {
    "tStartMs": 36980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "not happen."
    } ]
  }, {
    "tStartMs": 38280,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "That is the sixth of six, and it is the\nonly one that puts money back."
    } ]
  }, {
    "tStartMs": 42820,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "The other five take, and not one of them\nwill arrive with your name on it."
    } ]
  }, {
    "tStartMs": 47700,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "They reach you through your daughter."
    } ]
  }, {
    "tStartMs": 49660,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Through your doctor. Through a counter at\na care home you have never walked"
    } ]
  }, {
    "tStartMs": 53600,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "into. You will find out once it has\nalready happened."
    } ]
  }, {
    "tStartMs": 57700,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Number one. The letter that asks you to\nprove it again now comes twice a year."
    } ]
  }, {
    "tStartMs": 63460,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "There is a letter that goes out to\neverybody on Medicaid asking them to show"
    } ]
  }, {
    "tStartMs": 67860,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "they still qualify. It used to come once a\nyear."
    } ]
  }, {
    "tStartMs": 71400,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "For adults under sixty five it now has to\ncome every six months, and states"
    } ]
  }, {
    "tStartMs": 76360,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "have to have that running by the thirty\nfirst of December."
    } ]
  }, {
    "tStartMs": 79860,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "That sounds like paperwork."
    } ]
  }, {
    "tStartMs": 81940,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "It is not. It is counting."
    } ]
  }, {
    "tStartMs": 84480,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "The letter does not go to where a person\nis."
    } ]
  }, {
    "tStartMs": 87160,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "It goes to the last address the office\nholds."
    } ]
  }, {
    "tStartMs": 90340,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Think about who that catches. Somebody who\nmoved."
    } ]
  }, {
    "tStartMs": 93720,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "Somebody in and out of hospital."
    } ]
  }, {
    "tStartMs": 95580,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Somebody who went to another town to look\nafter a parent."
    } ]
  }, {
    "tStartMs": 98840,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "That address is not where they are\nstanding."
    } ]
  }, {
    "tStartMs": 101420,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The letter carries a deadline and the\ndeadline is short."
    } ]
  }, {
    "tStartMs": 104980,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Miss it and the coverage ends."
    } ]
  }, {
    "tStartMs": 106860,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Not because anything changed about the\nperson."
    } ]
  }, {
    "tStartMs": 109300,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Because a form did not come back."
    } ]
  }, {
    "tStartMs": 111100,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "Then the appeal, the new application, and\nthe gap in the middle where the"
    } ]
  }, {
    "tStartMs": 117140,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "medication is not covered and somebody\npays cash or goes without."
    } ]
  }, {
    "tStartMs": 122180,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "So sending that letter twice as often does\nnot create twice the paperwork."
    } ]
  }, {
    "tStartMs": 126840,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "It creates twice as many chances to fall\nthrough."
    } ]
  }, {
    "tStartMs": 130620,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "What decides who loses coverage is not\nwhat people assume."
    } ]
  }, {
    "tStartMs": 134280,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Almost nobody loses it because they\nstopped qualifying."
    } ]
  }, {
    "tStartMs": 137240,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "They lose it because they qualified and\ncould not prove it inside a window"
    } ]
  }, {
    "tStartMs": 142140,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "they never saw. So here is the most useful\nthing you can do this month."
    } ]
  }, {
    "tStartMs": 147760,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "If anybody in your family is on Medicaid,\nsit with them and look at the address"
    } ]
  }, {
    "tStartMs": 152260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "on that file."
    } ]
  }, {
    "tStartMs": 153800,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Ask whether it is the address they\nactually sleep at."
    } ]
  }, {
    "tStartMs": 156680,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "It takes one telephone call and it is\nworth more than anything else on this"
    } ]
  }, {
    "tStartMs": 160940,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "list."
    } ]
  }, {
    "tStartMs": 162140,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Number two. How far back the program will\npay just got shorter."
    } ]
  }, {
    "tStartMs": 166040,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Say somebody qualified for Medicaid but\nhad never got around to signing up."
    } ]
  }, {
    "tStartMs": 171360,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Then something serious happens."
    } ]
  }, {
    "tStartMs": 173380,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "The program could reach backwards and pay\nthe bills from before the application"
    } ]
  }, {
    "tStartMs": 177480,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "went in. That window was three months."
    } ]
  }, {
    "tStartMs": 180580,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "It is now one month for adults under sixty\nfive, and two months for everybody"
    } ]
  }, {
    "tStartMs": 184900,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "else. That was never built for organized\npeople."
    } ]
  }, {
    "tStartMs": 188240,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "It was built for the man who has a stroke\non a Tuesday and cannot fill in a"
    } ]
  }, {
    "tStartMs": 192160,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "form for two weeks. For the family in a\ncorridor being told their mother is"
    } ]
  }, {
    "tStartMs": 196180,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "not coming home, working out the paperwork\nafterwards because there was no"
    } ]
  }, {
    "tStartMs": 200360,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "afterwards to plan in. Three months was\nthe room left for the fact that a bad"
    } ]
  }, {
    "tStartMs": 205260,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "night does not wait for your forms to be\nin order."
    } ]
  }, {
    "tStartMs": 208580,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "One month is a great deal less room, and\nthe people who need it are the very"
    } ]
  }, {
    "tStartMs": 212860,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "people least able to move fast inside it."
    } ]
  }, {
    "tStartMs": 215960,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Anybody well enough to apply on time was\nnever going to need it."
    } ]
  }, {
    "tStartMs": 219840,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "Number three. There is a second door, and\nit is being held shut behind the"
    } ]
  }, {
    "tStartMs": 224820,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "first one. From the thirty first of\nDecember there is a new rule for adults"
    } ]
  }, {
    "tStartMs": 229380,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "on Medicaid aged nineteen to sixty four."
    } ]
  }, {
    "tStartMs": 232460,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Eighty hours a month. Work, study,"
    } ]
  }, {
    "tStartMs": 235360,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "training or volunteering, any of those\ncount."
    } ]
  }, {
    "tStartMs": 238500,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Report it, or claim one of the exemptions,\nor the coverage stops."
    } ]
  }, {
    "tStartMs": 243000,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "Everybody assumes that somebody who loses\nthat coverage simply buys a private"
    } ]
  }, {
    "tStartMs": 247040,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "policy instead. That is the reason the\nfirst rule does not frighten anybody."
    } ]
  }, {
    "tStartMs": 251760,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "The help that makes a private policy\naffordable is closed to them."
    } ]
  }, {
    "tStartMs": 255620,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "If the coverage was lost over the\nreporting rules, that assistance does not"
    } ]
  }, {
    "tStartMs": 259540,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "open. So it is not a gap between two\nthings."
    } ]
  }, {
    "tStartMs": 263040,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "It is a door, and a second door"
    } ]
  }, {
    "tStartMs": 265020,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "immediately behind it being held shut by\nthe"
    } ]
  }, {
    "tStartMs": 267520,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "same hand, for exactly the people who just\nwalked into the first one."
    } ]
  }, {
    "tStartMs": 271760,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "There are exemptions, and that word\ncarries a great deal."
    } ]
  }, {
    "tStartMs": 274840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "An exemption is real and written down."
    } ]
  }, {
    "tStartMs": 277440,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It is also a thing you claim, with\ndocuments, inside a window."
    } ]
  }, {
    "tStartMs": 281860,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Nobody applies it to you because your\nsituation obviously fits."
    } ]
  }, {
    "tStartMs": 285740,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "Almost everybody who loses coverage is\nsomebody who qualified for an exemption"
    } ]
  }, {
    "tStartMs": 289780,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and never knew to ask for it. Number four."
    } ]
  }, {
    "tStartMs": 293620,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "It reaches you through the person looking\nafter you."
    } ]
  }, {
    "tStartMs": 296700,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "That eighty hour rule lands on people aged\nnineteen to sixty four."
    } ]
  }, {
    "tStartMs": 300180,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "So at seventy one it looks like a problem\nbelonging to somebody else entirely,"
    } ]
  }, {
    "tStartMs": 305500,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "and that is precisely why it is on this\nlist."
    } ]
  }, {
    "tStartMs": 308480,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "There are three ways it walks into an\nordinary older household, and every one"
    } ]
  }, {
    "tStartMs": 312520,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "of them is common. The first runs through\na grown son or daughter."
    } ]
  }, {
    "tStartMs": 316360,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "If you have a son or a daughter in their\nforties or fifties on Medicaid, this"
    } ]
  }, {
    "tStartMs": 321420,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "reaches them directly. And when a person\nin that position loses coverage, the"
    } ]
  }, {
    "tStartMs": 325900,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "cost does not go away. Somebody still pays\nit."
    } ]
  }, {
    "tStartMs": 329180,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "It lands on the person who will not let\nthem go without, out of an account"
    } ]
  }, {
    "tStartMs": 333080,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "that was never built to carry two\nhouseholds."
    } ]
  }, {
    "tStartMs": 336100,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The second is the person already caring\nfor you."
    } ]
  }, {
    "tStartMs": 339000,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Say your daughter left work to look after\nyou and went onto Medicaid herself."
    } ]
  }, {
    "tStartMs": 343380,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "She now has to write down hours."
    } ]
  }, {
    "tStartMs": 345020,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "In a month where most of her waking life\nis spent inside your house."
    } ]
  }, {
    "tStartMs": 349340,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "There is usually an exemption for\ncaregivers."
    } ]
  }, {
    "tStartMs": 351840,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "She has to know it exists, and prove it,\nin the middle of doing the caring."
    } ]
  }, {
    "tStartMs": 356320,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "The third is the one nobody connects."
    } ]
  }, {
    "tStartMs": 358120,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "A large share of the care that keeps older\npeople in their own homes is paid"
    } ]
  }, {
    "tStartMs": 362900,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "for by Medicaid. And that part of the\nprogram is the part states are allowed"
    } ]
  }, {
    "tStartMs": 367020,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "to cut first when money is short."
    } ]
  }, {
    "tStartMs": 369380,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "You will never get a notice about it."
    } ]
  }, {
    "tStartMs": 371340,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "It arrives as a waiting list that is\nlonger than it was, an agency in your"
    } ]
  }, {
    "tStartMs": 375720,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "county trimming hours, a post that does\nnot get filled."
    } ]
  }, {
    "tStartMs": 379160,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "That is the one that changes your options\nin five years in a way you cannot"
    } ]
  }, {
    "tStartMs": 383180,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "see from here. There is a related thing\nworth one minute, and I am going to"
    } ]
  }, {
    "tStartMs": 387400,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "be honest that it has not been settled."
    } ]
  }, {
    "tStartMs": 389940,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "An old budget rule can trigger automatic\nreductions in what the government"
    } ]
  }, {
    "tStartMs": 393480,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "pays doctors and hospitals for treating\nMedicare patients."
    } ]
  }, {
    "tStartMs": 397100,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "It does not touch your benefit, your\npremium, or what you are covered for."
    } ]
  }, {
    "tStartMs": 401420,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "What it touches is how many doctors are\nwilling to take new Medicare patients,"
    } ]
  }, {
    "tStartMs": 405300,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "and that shows up in country areas first."
    } ]
  }, {
    "tStartMs": 408080,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "It has been postponed every time it has\ncome up before."
    } ]
  }, {
    "tStartMs": 411140,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Anybody certain either way is guessing in\nfront of you."
    } ]
  }, {
    "tStartMs": 415120,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "The useful thing does not depend on the\nanswer."
    } ]
  }, {
    "tStartMs": 417580,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Telephone the office of your own doctor,\nconfirm they still take Medicare,"
    } ]
  }, {
    "tStartMs": 422020,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "and get the name of one other practice\nnear you that does."
    } ]
  }, {
    "tStartMs": 425500,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Five minutes, and worth it whether this\nlands or not."
    } ]
  }, {
    "tStartMs": 428860,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Number five. There is no longer a national\nnumber you can rely on for a care"
    } ]
  }, {
    "tStartMs": 433060,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "home. There was a federal rule setting the\nminimum number of nursing staff"
    } ]
  }, {
    "tStartMs": 437380,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "a care home had to have. A floor."
    } ]
  }, {
    "tStartMs": 439840,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "It was being brought in slowly."
    } ]
  }, {
    "tStartMs": 442440,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "It has now been withdrawn, and nothing is\nallowed to replace it until the first"
    } ]
  }, {
    "tStartMs": 446720,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "of October two thousand and thirty four."
    } ]
  }, {
    "tStartMs": 449520,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Nine years with no floor. There is a real\nargument on the other side."
    } ]
  }, {
    "tStartMs": 454240,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Homes in country areas said they could not\nhire to that standard at any wage."
    } ]
  }, {
    "tStartMs": 458780,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "A rule they could not meet would have\nclosed them."
    } ]
  }, {
    "tStartMs": 461400,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "And a closed care home, in a county with\nonly one, is worse for everybody."
    } ]
  }, {
    "tStartMs": 465540,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "That argument holds. But here is what it\nmeans at your kitchen table, and it"
    } ]
  }, {
    "tStartMs": 470560,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "is the only part I want you to carry."
    } ]
  }, {
    "tStartMs": 472880,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "The number is gone. So the question is now\nyours to ask, and it is not a rude"
    } ]
  }, {
    "tStartMs": 478080,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "question. Ask how many nursing hours each\nresident gets per day."
    } ]
  }, {
    "tStartMs": 482460,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Ask what the staff turnover has been over\nthe last year."
    } ]
  }, {
    "tStartMs": 485720,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Ask how much agency cover they use,\nmeaning temporary staff who do not know"
    } ]
  }, {
    "tStartMs": 490120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "the residents by name."
    } ]
  }, {
    "tStartMs": 491940,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Those three answers tell you more about\nhow somebody will be looked after than"
    } ]
  }, {
    "tStartMs": 495520,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "the building, the carpet or the dining\nroom ever will."
    } ]
  }, {
    "tStartMs": 498780,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And the staffing figures a home reports\nare published, so you can look before"
    } ]
  }, {
    "tStartMs": 502540,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "you ever walk in and know whether the\nanswer you are given matches."
    } ]
  }, {
    "tStartMs": 507220,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Number six. The door that quietly never\nopened."
    } ]
  }, {
    "tStartMs": 510440,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Your state runs a program that pays your\nMedicare premium for you."
    } ]
  }, {
    "tStartMs": 514140,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Not pays you back. Pays it. So the amount\ncoming out of your payment before"
    } ]
  }, {
    "tStartMs": 518500,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "you see it simply stops coming out."
    } ]
  }, {
    "tStartMs": 521320,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Your deposit is larger every month, for as\nlong as you qualify."
    } ]
  }, {
    "tStartMs": 525400,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "There is more than one level of it, and\nthe upper levels exist for people whose"
    } ]
  }, {
    "tStartMs": 529120,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "income was too high for the first."
    } ]
  }, {
    "tStartMs": 531220,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "For years the problem was never whether\npeople qualified."
    } ]
  }, {
    "tStartMs": 534420,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Almost nobody knew it existed, and the\napplication was a job in itself, so"
    } ]
  }, {
    "tStartMs": 538920,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "millions who qualified never enrolled."
    } ]
  }, {
    "tStartMs": 541620,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "So somebody wrote a rule to close that\ngap."
    } ]
  }, {
    "tStartMs": 544240,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The office already knows what you receive\neach month."
    } ]
  }, {
    "tStartMs": 547360,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "So the rule used those figures to pick out\nthe people who qualified and sign"
    } ]
  }, {
    "tStartMs": 551300,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "them up, instead of waiting for them to\nstumble across it."
    } ]
  }, {
    "tStartMs": 554620,
    "dDurationMs": 3974,
    "segs": [ {
      "utf8": "That rule has been stopped. The number\nthey expect is roughly one million three"
    } ]
  }, {
    "tStartMs": 558634,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "hundred thousand people with Medicare,\npeople who genuinely qualify, will now"
    } ]
  }, {
    "tStartMs": 563300,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "not be enrolled who otherwise would have\nbeen."
    } ]
  }, {
    "tStartMs": 565800,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Look carefully at what that is, because it\nis not what people expect."
    } ]
  }, {
    "tStartMs": 569680,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Nobody is denied. Nobody loses anything\nthey currently have."
    } ]
  }, {
    "tStartMs": 573740,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "The door simply stays shut instead of\nopening, and there is no notice for it"
    } ]
  }, {
    "tStartMs": 578200,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and no appeal against it, because nothing\nwas refused."
    } ]
  }, {
    "tStartMs": 581840,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The only way anybody ends up on the right\nside of it is by applying the old"
    } ]
  }, {
    "tStartMs": 585680,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "way, on their own, having somehow found\nout it exists."
    } ]
  }, {
    "tStartMs": 590420,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So here is the call."
    } ]
  }, {
    "tStartMs": 592360,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Telephone your state Medicaid office, or\nyour area agency on aging, and ask"
    } ]
  }, {
    "tStartMs": 597020,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "them to check whether you qualify for the\nprograms that help pay Medicare costs."
    } ]
  }, {
    "tStartMs": 601660,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "The income limits are higher than most\npeople assume, because they are tied"
    } ]
  }, {
    "tStartMs": 605320,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "to a federal figure that moves every year,\nand the person who decides is not"
    } ]
  }, {
    "tStartMs": 609840,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "you. I want to name the pattern before I\nfinish."
    } ]
  }, {
    "tStartMs": 612940,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Once you have seen it, you will see it in\neverything that comes out of Washington."
    } ]
  }, {
    "tStartMs": 616940,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "There are two ways to spend less on a\nprogram."
    } ]
  }, {
    "tStartMs": 619380,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "You can take something away from people\nwho have it, which is visible, which"
    } ]
  }, {
    "tStartMs": 622940,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "makes the news, and which somebody has to\nstand up and defend."
    } ]
  }, {
    "tStartMs": 626420,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Or you can make it slightly harder to get\nin the first place, which is invisible,"
    } ]
  }, {
    "tStartMs": 630880,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "which produces no story at all, and which\nsaves the same money."
    } ]
  }, {
    "tStartMs": 635080,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Nothing in that second category will ever\narrive in your mail."
    } ]
  }, {
    "tStartMs": 638820,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "You cannot send somebody a notice about a\nbenefit they were never told about."
    } ]
  }, {
    "tStartMs": 642660,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "So, six things, and how each one reaches\nyou."
    } ]
  }, {
    "tStartMs": 646080,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "The letter that proves you still qualify\nnow arrives every six months, at whatever"
    } ]
  }, {
    "tStartMs": 650300,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "address they last wrote down. How far back\nthe program will pay has shrunk"
    } ]
  }, {
    "tStartMs": 654760,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "from three months to one for most people."
    } ]
  }, {
    "tStartMs": 657360,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "The private policy everybody assumes is\nthe fallback is closed to the people"
    } ]
  }, {
    "tStartMs": 661300,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "who just lost the first thing."
    } ]
  }, {
    "tStartMs": 663180,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "The eighty hour rule lands on people under\nsixty five and walks into your house"
    } ]
  }, {
    "tStartMs": 667060,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "through your own family. The care home\nstaffing floor is gone for nine years"
    } ]
  }, {
    "tStartMs": 671400,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "and the questions are now yours to ask."
    } ]
  }, {
    "tStartMs": 673640,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "And the program that would pay your\nMedicare premium is still there, but the"
    } ]
  }, {
    "tStartMs": 677260,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "rule that was going to come and find you\nhas been switched off."
    } ]
  }, {
    "tStartMs": 680940,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "None of this is advice about your own\nsituation."
    } ]
  }, {
    "tStartMs": 683660,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "Every state writes its own figures and\nyours will not be the ones spoken here."
    } ]
  }, {
    "tStartMs": 688820,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "One last thing, and hold on to it for the\nnext six months."
    } ]
  }, {
    "tStartMs": 693840,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Nobody legitimate is going to telephone\nyou about any of this."
    } ]
  }, {
    "tStartMs": 698120,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "A call or a letter may tell you to verify\nsomething, or confirm something,"
    } ]
  }, {
    "tStartMs": 703120,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "or sign up again, or pay a fee to protect\na benefit."
    } ]
  }, {
    "tStartMs": 707080,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Because of this law, it is a fraud."
    } ]
  }, {
    "tStartMs": 709620,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Every time, without exception."
    } ]
  }, {
    "tStartMs": 712160,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Put the telephone down. And if there is\nsomebody in your family on Medicaid"
    } ]
  }, {
    "tStartMs": 716140,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "tonight, do not ask them whether their\npaperwork is in order."
    } ]
  }, {
    "tStartMs": 720160,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Ask them one thing. What address is on the\nfile."
    } ]
  } ]
}
