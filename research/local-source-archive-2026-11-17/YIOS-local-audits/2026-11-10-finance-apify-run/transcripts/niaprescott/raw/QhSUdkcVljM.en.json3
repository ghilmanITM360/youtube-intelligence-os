{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "On the first of October a set of numbers\nchanges, and not one office holding"
    } ]
  }, {
    "tStartMs": 5640,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "those numbers is required to write to you\nbefore it happens."
    } ]
  }, {
    "tStartMs": 9840,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "You find out in November."
    } ]
  }, {
    "tStartMs": 12000,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "The amount that lands is wrong, or the\ndoor you meant to knock on is already"
    } ]
  }, {
    "tStartMs": 16700,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "shut, and the person who could have told\nyou in September was never asked to."
    } ]
  }, {
    "tStartMs": 22180,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Five things move on that one date."
    } ]
  }, {
    "tStartMs": 24580,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "The same single figure decides all five of\nthem, and most people look at that"
    } ]
  }, {
    "tStartMs": 29060,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "figure once, decide they are above it, and\nnever speak to anybody again."
    } ]
  }, {
    "tStartMs": 34660,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "Number one. The food help amount changes\non the first, and nobody posts you"
    } ]
  }, {
    "tStartMs": 39960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "the new number."
    } ]
  }, {
    "tStartMs": 41480,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "The federal year turns over on the first\nof October, and the monthly maximums"
    } ]
  }, {
    "tStartMs": 46300,
    "dDurationMs": 5016,
    "segs": [ {
      "utf8": "turn over with it. For one person living\nalone the ceiling moves from two hundred"
    } ]
  }, {
    "tStartMs": 51356,
    "dDurationMs": 2191,
    "segs": [ {
      "utf8": "and ninety eight dollars to three hundred\nand six."
    } ]
  }, {
    "tStartMs": 54620,
    "dDurationMs": 4911,
    "segs": [ {
      "utf8": "For a household of four it moves from nine\nhundred and ninety four to one thousand"
    } ]
  }, {
    "tStartMs": 59571,
    "dDurationMs": 4489,
    "segs": [ {
      "utf8": "and twenty three. That is not a large rise\nand I am not going to pretend it"
    } ]
  }, {
    "tStartMs": 64060,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "is. Eight dollars a month for one person."
    } ]
  }, {
    "tStartMs": 67180,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "But notice what nobody does with it."
    } ]
  }, {
    "tStartMs": 69280,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "The figure is set in Washington."
    } ]
  }, {
    "tStartMs": 71560,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "The letter, if one comes at all, comes\nfrom your own state, and it comes after"
    } ]
  }, {
    "tStartMs": 76020,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the change rather than before it."
    } ]
  }, {
    "tStartMs": 78740,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "So a household that was told last winter\nit earned too much is judged this"
    } ]
  }, {
    "tStartMs": 83000,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "winter against a different ceiling, and\nnobody in that household knows the"
    } ]
  }, {
    "tStartMs": 87320,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "ceiling moved."
    } ]
  }, {
    "tStartMs": 88960,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "People do not reapply because they\nremember being refused."
    } ]
  }, {
    "tStartMs": 92940,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "They remember the refusal, not the year it\nhappened in."
    } ]
  }, {
    "tStartMs": 96500,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "And a refusal from two years ago is a\nrefusal against numbers that no longer"
    } ]
  }, {
    "tStartMs": 100820,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "exist."
    } ]
  }, {
    "tStartMs": 102060,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "If you were turned down before, you were\nturned down against an older figure."
    } ]
  }, {
    "tStartMs": 106480,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Telephone your state benefit office and\nask what the monthly ceiling is for"
    } ]
  }, {
    "tStartMs": 110760,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "the year that begins in October."
    } ]
  }, {
    "tStartMs": 112320,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "The figure from two winters ago is not the\nfigure they are using now."
    } ]
  }, {
    "tStartMs": 117660,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "Number two. If you are between fifty five\nand sixty four, something was taken"
    } ]
  }, {
    "tStartMs": 122840,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "away from you this month. Until now that\nage band was excused from the work"
    } ]
  }, {
    "tStartMs": 127600,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "rules. That exemption has gone."
    } ]
  }, {
    "tStartMs": 130740,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "From the first of October a person in that\nband has to be working, volunteering"
    } ]
  }, {
    "tStartMs": 135660,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "or training for eighty hours a month, and\nif they are not, the help stops after"
    } ]
  }, {
    "tStartMs": 140360,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "three months and cannot start again for\nthree years."
    } ]
  }, {
    "tStartMs": 144280,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Three months, then three years of nothing."
    } ]
  }, {
    "tStartMs": 146960,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "I am not going to dress that up."
    } ]
  }, {
    "tStartMs": 149500,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And here is the piece that catches\nhouseholds rather than individuals."
    } ]
  }, {
    "tStartMs": 153800,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "The rule lands on one person, but the\nmoney it removes was feeding a house."
    } ]
  }, {
    "tStartMs": 159120,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "A woman of sixty eight with a brother of\nsixty living under her roof is not"
    } ]
  }, {
    "tStartMs": 163160,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "covered by this rule and will still lose\nmoney from her kitchen because of"
    } ]
  }, {
    "tStartMs": 166920,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "it. Eighty hours a month is under twenty\nhours a week, and volunteering counts"
    } ]
  }, {
    "tStartMs": 172200,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "in most places, and training counts, and\nso does looking after certain family"
    } ]
  }, {
    "tStartMs": 176940,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "members in some states."
    } ]
  }, {
    "tStartMs": 179120,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "Almost nobody is told that. They hear work\nrequirement, they know they cannot"
    } ]
  }, {
    "tStartMs": 183660,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "hold a job, and they walk away from money\nthey could still have kept."
    } ]
  }, {
    "tStartMs": 187820,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "If anybody under your roof is between\nthose two ages, the office can list what"
    } ]
  }, {
    "tStartMs": 192140,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "counts towards the eighty hours in your\nstate."
    } ]
  }, {
    "tStartMs": 194820,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "That list is longer than people assume."
    } ]
  }, {
    "tStartMs": 197820,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "Number three. Your county opens a door on\nthe first of October, and most people"
    } ]
  }, {
    "tStartMs": 202800,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "find it already shut. Nearly every state\nhas some relief on the property tax"
    } ]
  }, {
    "tStartMs": 207360,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "for older owners."
    } ]
  }, {
    "tStartMs": 209160,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Almost none of it arrives on its own."
    } ]
  }, {
    "tStartMs": 211200,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "It is claimed inside a window, and the\nwindow is set locally, and the dates"
    } ]
  }, {
    "tStartMs": 215520,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "are not the same anywhere."
    } ]
  }, {
    "tStartMs": 217620,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "In California the filing period for the\nsenior relief opens on the first of"
    } ]
  }, {
    "tStartMs": 221740,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "October and closes on the tenth of\nFebruary."
    } ]
  }, {
    "tStartMs": 224940,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "In New Jersey the reimbursement deadline\nfalls on the thirty first of October."
    } ]
  }, {
    "tStartMs": 229420,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Different states, one month apart, and\nnothing connects them except that both"
    } ]
  }, {
    "tStartMs": 233260,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "open and close while people are thinking\nabout it."
    } ]
  }, {
    "tStartMs": 236380,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "I cannot tell you your own date and I am\nnot going to guess at it."
    } ]
  }, {
    "tStartMs": 240080,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "What I can tell you is that no county in\nthis country telephones an older owner"
    } ]
  }, {
    "tStartMs": 244380,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "to say the window is open. The bill\narrives on time every year."
    } ]
  }, {
    "tStartMs": 248440,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "The notice about the relief does not\narrive at all."
    } ]
  }, {
    "tStartMs": 251800,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "The county assessor holds one piece of\ninformation you need."
    } ]
  }, {
    "tStartMs": 255100,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The filing window for the senior exemption\nthis year."
    } ]
  }, {
    "tStartMs": 258240,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Four minutes on the telephone and the date\nis yours."
    } ]
  }, {
    "tStartMs": 261720,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Number four. The paper that sets the price\nyou pay in January is already inside"
    } ]
  }, {
    "tStartMs": 266360,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "your house."
    } ]
  }, {
    "tStartMs": 267560,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "If you are on a health plan, a document\nhad to reach you before the thirtieth"
    } ]
  }, {
    "tStartMs": 271420,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "of September setting out what changes in\nJanuary."
    } ]
  }, {
    "tStartMs": 274280,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The cost. The list of medicines."
    } ]
  }, {
    "tStartMs": 276400,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "The doctors. It has arrived. It is\nsomewhere in the post from the last two"
    } ]
  }, {
    "tStartMs": 280100,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "or three weeks. It does not come from the\ngovernment."
    } ]
  }, {
    "tStartMs": 282700,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "It comes from the insurance company that\nruns the plan, and it looks exactly"
    } ]
  }, {
    "tStartMs": 287420,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "like the advertising they send you the\nother eleven months of the year."
    } ]
  }, {
    "tStartMs": 291640,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Now look at the timing, because the timing\nis the trap."
    } ]
  }, {
    "tStartMs": 295380,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "The paper is in your house today."
    } ]
  }, {
    "tStartMs": 297560,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "The period when you are allowed to act on\nit does not open until the fifteenth"
    } ]
  }, {
    "tStartMs": 301580,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "of October, and it closes on the seventh\nof December."
    } ]
  }, {
    "tStartMs": 304260,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "So you are handed the bad news two or\nthree weeks before you are permitted"
    } ]
  }, {
    "tStartMs": 308160,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "to do anything about it. Plenty of people\nread it, feel a flicker of worry,"
    } ]
  }, {
    "tStartMs": 312740,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "put it on a pile, and by the middle of\nOctober that pile has been cleared."
    } ]
  }, {
    "tStartMs": 316900,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Find it this week, while the post is still\non the table rather than buried"
    } ]
  }, {
    "tStartMs": 320700,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "in a drawer. If it has already gone, the\nplan will send it out a second time."
    } ]
  }, {
    "tStartMs": 325880,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "The document is called the annual notice\nof change, and they are required to"
    } ]
  }, {
    "tStartMs": 329740,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "give it to you. Number five. For thirty\ndays the heating money is yours alone."
    } ]
  }, {
    "tStartMs": 334260,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "On the first of November you are standing\nin line with everybody."
    } ]
  }, {
    "tStartMs": 338220,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "There is federal money that pays part of a\nwinter heating bill, and the new"
    } ]
  }, {
    "tStartMs": 341720,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "year of it opens on the first of October."
    } ]
  }, {
    "tStartMs": 344360,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "For the first thirty days it is open to a\nnarrow group."
    } ]
  }, {
    "tStartMs": 347980,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "People aged sixty and over. People with a\ndisability."
    } ]
  }, {
    "tStartMs": 351440,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Households with a child under five."
    } ]
  }, {
    "tStartMs": 353560,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Households already facing disconnection."
    } ]
  }, {
    "tStartMs": 356340,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Everybody else has to wait until the first\nof November."
    } ]
  }, {
    "tStartMs": 359840,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Read that again, because it is the most\nvaluable thing in this video."
    } ]
  }, {
    "tStartMs": 363120,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "If you are over sixty, you have a month of\nclear ground in front of you, and"
    } ]
  }, {
    "tStartMs": 367740,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "on the first of November everybody else\nsteps in behind you."
    } ]
  }, {
    "tStartMs": 370900,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The money runs from October until the\nmiddle of August, or until it is gone,"
    } ]
  }, {
    "tStartMs": 374980,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "whichever happens first. In a hard winter\nit goes first."
    } ]
  }, {
    "tStartMs": 378320,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "And the people who ring in January are\nasking for whatever is left after a"
    } ]
  }, {
    "tStartMs": 382580,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "month of everybody else. Telephone your\nstate energy assistance office and"
    } ]
  }, {
    "tStartMs": 386600,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "say you are over sixty and you want to\napply for heating help for this winter."
    } ]
  }, {
    "tStartMs": 390440,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Say those words and they will know exactly\nwhich list to put you on."
    } ]
  }, {
    "tStartMs": 394900,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Now the line that runs through all five of\nthem."
    } ]
  }, {
    "tStartMs": 397400,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Every one of these is decided by a single\nfigure, and it is the same figure"
    } ]
  }, {
    "tStartMs": 402260,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "every time. What came in last month."
    } ]
  }, {
    "tStartMs": 405480,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "That is the line people are asked for, and\nit is the line that stops them."
    } ]
  }, {
    "tStartMs": 410020,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "They look at it, compare it against\nsomething they half remember, decide they"
    } ]
  }, {
    "tStartMs": 414100,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "are above it, and never file. And they are\nwrong far more often than they are"
    } ]
  }, {
    "tStartMs": 418560,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "right, because the number they are"
    } ]
  }, {
    "tStartMs": 420580,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "comparing against is usually the wrong\nyear,"
    } ]
  }, {
    "tStartMs": 423520,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and because several of these programs do\nnot count everything that arrives."
    } ]
  }, {
    "tStartMs": 428380,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Some ignore certain payments entirely."
    } ]
  }, {
    "tStartMs": 430760,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "Some allow costs to be taken off before\nthe figure is judged."
    } ]
  }, {
    "tStartMs": 434360,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "The office decides that. You do not."
    } ]
  }, {
    "tStartMs": 437180,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "And a person who decides it for"
    } ]
  }, {
    "tStartMs": 438740,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "themselves, at the kitchen table, in\nadvance,"
    } ]
  }, {
    "tStartMs": 441800,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "has refused themselves on a rule they have\nnever read."
    } ]
  }, {
    "tStartMs": 445000,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "So the instruction for all five is the\nsame, and it is smaller than people"
    } ]
  }, {
    "tStartMs": 449560,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "expect. Do not open with what you earn."
    } ]
  }, {
    "tStartMs": 452820,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Say that you want to put in an"
    } ]
  }, {
    "tStartMs": 454200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "application, and let the office decide the\nrest."
    } ]
  }, {
    "tStartMs": 457420,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Deciding it is the work they are paid for."
    } ]
  }, {
    "tStartMs": 459640,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "It has never been yours."
    } ]
  }, {
    "tStartMs": 461740,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Before I give you the dates together, one\ncorrection, because the internet"
    } ]
  }, {
    "tStartMs": 465480,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "is full of it this month. Nothing\ncollapses on the first of October."
    } ]
  }, {
    "tStartMs": 469080,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "The funding was signed on the second of\nSeptember and runs to the eleventh"
    } ]
  }, {
    "tStartMs": 473400,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "of December."
    } ]
  }, {
    "tStartMs": 474600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Payments continue."
    } ]
  }, {
    "tStartMs": 476120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "No deposit stops."
    } ]
  }, {
    "tStartMs": 477940,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Anybody telling you the country changes\novernight on the first is selling you"
    } ]
  }, {
    "tStartMs": 481740,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "a fear that was cancelled three weeks ago,\nand they are usually selling it"
    } ]
  }, {
    "tStartMs": 485380,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "alongside something else. The date that\nactually matters next is the eleventh"
    } ]
  }, {
    "tStartMs": 489820,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "of December. Write that one down instead."
    } ]
  }, {
    "tStartMs": 492840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So, five things and the dates on them."
    } ]
  }, {
    "tStartMs": 495680,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "The food help ceiling moves on the first\nof October, and if you were refused"
    } ]
  }, {
    "tStartMs": 499620,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "before, you were refused against an older\nnumber."
    } ]
  }, {
    "tStartMs": 503160,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "The work rules land on the fifty five to\nsixty four band on the same day, and"
    } ]
  }, {
    "tStartMs": 508140,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "volunteering and training count."
    } ]
  }, {
    "tStartMs": 510460,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "The property tax window in your own county\nopens or closes around now and no"
    } ]
  }, {
    "tStartMs": 514980,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "one will tell you which. The health plan\npaper is already in your house and"
    } ]
  }, {
    "tStartMs": 518880,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "you cannot act on it until the fifteenth\nof October."
    } ]
  }, {
    "tStartMs": 521480,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "And the heating money belongs to people\nover sixty alone until the first of"
    } ]
  }, {
    "tStartMs": 525620,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "November. None of this is hidden."
    } ]
  }, {
    "tStartMs": 527480,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "It is written down, it is published, and\nthe dates have been fixed for months."
    } ]
  }, {
    "tStartMs": 532820,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "It works badly for people only because\nevery single one of these offices is"
    } ]
  }, {
    "tStartMs": 537240,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "built to answer, and not one of them is\nbuilt to ask."
    } ]
  }, {
    "tStartMs": 540680,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "This is education and not advice about\nyour own circumstances."
    } ]
  }, {
    "tStartMs": 544620,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Your state sets its own figures and yours\nmay sit higher than the ones above."
    } ]
  }, {
    "tStartMs": 548980,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "If somebody in your family is living on a\nfixed amount this winter, they do"
    } ]
  }, {
    "tStartMs": 552620,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "not need this explained to them."
    } ]
  }, {
    "tStartMs": 554420,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "They need the dates. Give them the first\nof October and the first of November,"
    } ]
  }, {
    "tStartMs": 558820,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "and let them make the two telephone calls\nthemselves."
    } ]
  } ]
}
