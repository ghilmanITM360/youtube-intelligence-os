{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "$25,000."
    } ]
  }, {
    "tStartMs": 2880,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "If you are on your own, that is the line."
    } ]
  }, {
    "tStartMs": 6460,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "$32,000 if you are married. Go $1 past it\nand the government starts taxing"
    } ]
  }, {
    "tStartMs": 12420,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "The Social Security you already paid for."
    } ]
  }, {
    "tStartMs": 15820,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Nobody writes to tell you where you stand\nagainst that number."
    } ]
  }, {
    "tStartMs": 19240,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "Not the agency that sends your check, not\nthe office that takes the tax, not"
    } ]
  }, {
    "tStartMs": 24340,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "The people who announce the raise every\nOctober."
    } ]
  }, {
    "tStartMs": 26760,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Here is the gap that costs people money\nevery January."
    } ]
  }, {
    "tStartMs": 32300,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Being under that line and believing you\nare under it are two different things,"
    } ]
  }, {
    "tStartMs": 36600,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Because the number they test you with is\nlarger than the number in your head."
    } ]
  }, {
    "tStartMs": 40680,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "And the one thing that decides it is a\ncalculation you can do at your own table"
    } ]
  }, {
    "tStartMs": 45600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "In four minutes."
    } ]
  }, {
    "tStartMs": 47640,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "$25,000. $32,000 if you are married."
    } ]
  }, {
    "tStartMs": 51040,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Hold those. Now, before you decide this\ndoes not reach you."
    } ]
  }, {
    "tStartMs": 55620,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This is not about wealthy retirees."
    } ]
  }, {
    "tStartMs": 58140,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "A single person with a modest pension and\nan ordinary Social Security check"
    } ]
  }, {
    "tStartMs": 62340,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "Is already close to that line, and in some\nhouseholds already past it."
    } ]
  }, {
    "tStartMs": 67540,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And it is not only about people who are\ncomfortable either."
    } ]
  }, {
    "tStartMs": 71040,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "The line has stayed in the same place\nsince the law was written, and your check"
    } ]
  }, {
    "tStartMs": 75100,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Has gone up every single year since."
    } ]
  }, {
    "tStartMs": 77660,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "The two were always going to meet."
    } ]
  }, {
    "tStartMs": 79900,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Six things to check, and I will tell you\nwhich part is yours as we go."
    } ]
  }, {
    "tStartMs": 84600,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "The last one is the one most people have\nalready got wrong this year, because"
    } ]
  }, {
    "tStartMs": 88720,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "A new rule arrived and it does less than\nthe headlines said."
    } ]
  }, {
    "tStartMs": 93140,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Two names, said once."
    } ]
  }, {
    "tStartMs": 95640,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Social Security is the check. A Roth is a\nretirement account that was already"
    } ]
  }, {
    "tStartMs": 99920,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Taxed when the money went in."
    } ]
  }, {
    "tStartMs": 102140,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Check number one. $25,000. Cross it and\nyour own check starts getting taxed."
    } ]
  }, {
    "tStartMs": 106940,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "Here is the rule as it sits today."
    } ]
  }, {
    "tStartMs": 109920,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "If you file on your own, the first line is\n$25,000."
    } ]
  }, {
    "tStartMs": 114840,
    "dDurationMs": 4168,
    "segs": [ {
      "utf8": "If you are married and file together, it\nis $32,000."
    } ]
  }, {
    "tStartMs": 119760,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Underneath those lines, none of your\nSocial Security is taxed."
    } ]
  }, {
    "tStartMs": 123960,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Above them, up to half of your benefit\nbecomes taxable."
    } ]
  }, {
    "tStartMs": 128040,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "And there is a second line higher up,\n$34,000 on your own and $44,000 married,"
    } ]
  }, {
    "tStartMs": 133740,
    "dDurationMs": 8680,
    "segs": [ {
      "utf8": "Where the share rises to as much as 85%."
    } ]
  }, {
    "tStartMs": 143220,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Read those four numbers again, because\nthey decide whether a letter arrives"
    } ]
  }, {
    "tStartMs": 147900,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "In April."
    } ]
  }, {
    "tStartMs": 149260,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Now the part that matters more than the\nnumbers themselves."
    } ]
  }, {
    "tStartMs": 153200,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Not one of those four figures has ever\nbeen raised."
    } ]
  }, {
    "tStartMs": 156240,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Not for inflation, not for wages, not\nonce."
    } ]
  }, {
    "tStartMs": 160320,
    "dDurationMs": 5980,
    "segs": [ {
      "utf8": "They were written into law in 1983, the\ntax began in 1984, and the numbers"
    } ]
  }, {
    "tStartMs": 166300,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Have sat exactly where they were put."
    } ]
  }, {
    "tStartMs": 169320,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Think about everything else in that\nstretch of years."
    } ]
  }, {
    "tStartMs": 172060,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Bread. Petrol. A doctor visit."
    } ]
  }, {
    "tStartMs": 174820,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Your own check, which has had a raise in\nalmost every one of them."
    } ]
  }, {
    "tStartMs": 179060,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Everything moved except the line."
    } ]
  }, {
    "tStartMs": 181880,
    "dDurationMs": 5814,
    "segs": [ {
      "utf8": "A woman named Ruth retired in 1991 on a\ncheck that was nowhere near $25,000"
    } ]
  }, {
    "tStartMs": 187980,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "A year. She never paid a dollar of tax on\nit."
    } ]
  }, {
    "tStartMs": 191900,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "The same woman, with the same job behind\nher and the same modest life, retiring"
    } ]
  }, {
    "tStartMs": 196960,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Today would be over the line in her first\nyear."
    } ]
  }, {
    "tStartMs": 200680,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So write the two numbers on the back of an\nenvelope."
    } ]
  }, {
    "tStartMs": 203560,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "$25,000 on your own. $32,000 married."
    } ]
  }, {
    "tStartMs": 207160,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Everything that follows is measured\nagainst those."
    } ]
  }, {
    "tStartMs": 210800,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "Check number two. Half of your own Social\nSecurity gets added in before anything"
    } ]
  }, {
    "tStartMs": 215700,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "Else does. This is where almost everybody\nmiscounts, and it is the whole reason"
    } ]
  }, {
    "tStartMs": 220900,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "People think they are safe."
    } ]
  }, {
    "tStartMs": 222980,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "When they work out whether you are over\nthe line, they do not look at your"
    } ]
  }, {
    "tStartMs": 226600,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Pension and your interest and stop there."
    } ]
  }, {
    "tStartMs": 229600,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "They start by taking half of your Social\nSecurity benefit and putting it on"
    } ]
  }, {
    "tStartMs": 233440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The pile."
    } ]
  }, {
    "tStartMs": 234760,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Say that out loud, because it is strange\nand it is true."
    } ]
  }, {
    "tStartMs": 238900,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Your Social Security is counted against\nyou to decide whether your Social Security"
    } ]
  }, {
    "tStartMs": 243140,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Gets taxed. So the sum has three parts."
    } ]
  }, {
    "tStartMs": 246800,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Half of your yearly benefit. Then"
    } ]
  }, {
    "tStartMs": 248660,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Everything already taxed, which means a\npension,"
    } ]
  }, {
    "tStartMs": 251660,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "A withdrawal from a regular retirement\naccount, wages if you still work, and"
    } ]
  }, {
    "tStartMs": 255800,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Savings interest. Then one more piece that\ncatches people out, interest from"
    } ]
  }, {
    "tStartMs": 260380,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Municipal bonds."
    } ]
  }, {
    "tStartMs": 262040,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Those are sold as tax free, and for most\npurposes they are, except this one."
    } ]
  }, {
    "tStartMs": 267140,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Add those three together and that is the\nfigure they hold against $25,000."
    } ]
  }, {
    "tStartMs": 271920,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "A man named Clarence counted his pension\nat $18,000 and his bank interest at"
    } ]
  }, {
    "tStartMs": 276560,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "$400, decided he was $8,000 under, and\nnever thought about it again."
    } ]
  }, {
    "tStartMs": 281460,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "His benefit was $22,000 a year."
    } ]
  }, {
    "tStartMs": 284100,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "Half of that is $11,000. His real figure\nwas $29,000, $4,000 over the first"
    } ]
  }, {
    "tStartMs": 289760,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Line, and he found out in a letter."
    } ]
  }, {
    "tStartMs": 292520,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "What to do. Take the benefit statement\nfrom last year."
    } ]
  }, {
    "tStartMs": 295920,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Halve the yearly amount. Then add your\npension, any withdrawals, any wages,"
    } ]
  }, {
    "tStartMs": 300200,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Your interest, and any municipal bond\ninterest."
    } ]
  }, {
    "tStartMs": 303300,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "That total, not your income as you usually\nthink of it, is the number that"
    } ]
  }, {
    "tStartMs": 307420,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Decides this. Check number three."
    } ]
  }, {
    "tStartMs": 310460,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "The raise goes in. Half of the raise is\nused to push you over."
    } ]
  }, {
    "tStartMs": 314320,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Now put the two pieces together, because\nthis is the part that lands in the"
    } ]
  }, {
    "tStartMs": 317960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Middle of October."
    } ]
  }, {
    "tStartMs": 319560,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Every autumn, Social Security announces\nthe raise for the following year."
    } ]
  }, {
    "tStartMs": 324100,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "People hear the percentage and work out\nwhat it adds to the monthly check."
    } ]
  }, {
    "tStartMs": 327840,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "That is as far as most of it goes."
    } ]
  }, {
    "tStartMs": 330640,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Follow it one step further. A bigger\nbenefit means a bigger half."
    } ]
  }, {
    "tStartMs": 334820,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "That bigger half goes onto the pile from\ncheck number two."
    } ]
  }, {
    "tStartMs": 338320,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "The pile gets closer to the line, or\ncrosses it."
    } ]
  }, {
    "tStartMs": 341660,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "So the raise that is announced to help you\nis also the thing moving you toward"
    } ]
  }, {
    "tStartMs": 345420,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The tax."
    } ]
  }, {
    "tStartMs": 346660,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Both of those are true at once, and nobody\nsays the second half out loud."
    } ]
  }, {
    "tStartMs": 350760,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "And nothing in the system warns you."
    } ]
  }, {
    "tStartMs": 353240,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "The letter in December tells you the new\nmonthly amount."
    } ]
  }, {
    "tStartMs": 355940,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "It carries no mention of the line, no\nmention of where you now stand against"
    } ]
  }, {
    "tStartMs": 359680,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "It, and no suggestion that anything about\nyour tax has changed."
    } ]
  }, {
    "tStartMs": 363340,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "A widow named Pearl went over the first\nline by $600 in a year when her only"
    } ]
  }, {
    "tStartMs": 368380,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Change was the raise. She had done nothing\ndifferently."
    } ]
  }, {
    "tStartMs": 371820,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "She had earned nothing extra. The system\nhad simply moved her, and the first"
    } ]
  }, {
    "tStartMs": 376180,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "She knew of it was the following April."
    } ]
  }, {
    "tStartMs": 378540,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "What to do. When the new amount comes in\nDecember, redo the sum from check"
    } ]
  }, {
    "tStartMs": 382640,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Number two with the new figure."
    } ]
  }, {
    "tStartMs": 384840,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Four minutes, once a year, and you will\nknow in December instead of April."
    } ]
  }, {
    "tStartMs": 389240,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Check number four. In 1984 it caught 1 in\n10."
    } ]
  }, {
    "tStartMs": 392680,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "It now catches half. Here is what those\nfrozen numbers have actually done."
    } ]
  }, {
    "tStartMs": 398100,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "When the tax started in 1984, fewer than 1\nin 10 people receiving Social Security"
    } ]
  }, {
    "tStartMs": 403160,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Paid anything on it. It was written for\nthe small number at the top."
    } ]
  }, {
    "tStartMs": 407620,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The figure for this year is 48%."
    } ]
  }, {
    "tStartMs": 410100,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Just under half of everybody receiving a\nbenefit."
    } ]
  }, {
    "tStartMs": 412920,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "That happened without a single vote."
    } ]
  }, {
    "tStartMs": 415200,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Congress stood still, and standing still\nwas the whole mechanism."
    } ]
  }, {
    "tStartMs": 419040,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "A number that stays put while every check\nrises will swallow more people each"
    } ]
  }, {
    "tStartMs": 423600,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Year, by arithmetic alone. And it keeps\ngoing."
    } ]
  }, {
    "tStartMs": 427580,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "The line sits in the same place next year\nand the year after."
    } ]
  }, {
    "tStartMs": 431260,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Your check moves. The only question is\nwhich year you cross, and for many people"
    } ]
  }, {
    "tStartMs": 435840,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Watching, that year has already gone."
    } ]
  }, {
    "tStartMs": 438600,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Comfortably underneath is a temporary\ncondition."
    } ]
  }, {
    "tStartMs": 441580,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Check number five. Money out of a Roth\nnever gets added in."
    } ]
  }, {
    "tStartMs": 445260,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Most people have none. Here is the one\nreal lever, and I want to be straight"
    } ]
  }, {
    "tStartMs": 449360,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "About how narrow it is. Money taken out of\na Roth account stays off the pile."
    } ]
  }, {
    "tStartMs": 454400,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "It was taxed on the way in, years ago, so\nit has already done its turn."
    } ]
  }, {
    "tStartMs": 459140,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Your figure holds steady, and either line\nstays where it is."
    } ]
  }, {
    "tStartMs": 463120,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "That makes it the only kind of"
    } ]
  }, {
    "tStartMs": 464540,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Retirement money that is invisible to this\ncalculation."
    } ]
  }, {
    "tStartMs": 467860,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Everything else counts. A regular\nretirement account counts."
    } ]
  }, {
    "tStartMs": 471880,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "A pension counts. Wages count."
    } ]
  }, {
    "tStartMs": 474100,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Savings interest counts. Now the hard\npart."
    } ]
  }, {
    "tStartMs": 477880,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Most people over seventy hold little or\nnothing in a Roth."
    } ]
  }, {
    "tStartMs": 481880,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "These accounts did not exist for most of\ntheir working lives, and converting"
    } ]
  }, {
    "tStartMs": 485600,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Into one means paying the tax up front, in\none year, at an age when that is"
    } ]
  }, {
    "tStartMs": 490240,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Rarely the right move. So it is a real\nlever that is already closed for most"
    } ]
  }, {
    "tStartMs": 494500,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Of you. I am telling you anyway, because a\nfew of you have one and have been"
    } ]
  }, {
    "tStartMs": 499060,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Drawing from the wrong account for years."
    } ]
  }, {
    "tStartMs": 501680,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "What to do. Find out whether any account\nin your name has the word Roth on"
    } ]
  }, {
    "tStartMs": 505880,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "The statement. If one does, that is the\naccount to think about drawing from"
    } ]
  }, {
    "tStartMs": 509900,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "First, and that is a conversation with\nwhoever does your return, with your"
    } ]
  }, {
    "tStartMs": 514060,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Own numbers in front of them. Check number\nsix."
    } ]
  }, {
    "tStartMs": 517040,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "The new deduction lowers your tax."
    } ]
  }, {
    "tStartMs": 519220,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "It does not move the line. This is the\nnewest piece and the one being described"
    } ]
  }, {
    "tStartMs": 523460,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Wrongly almost everywhere. There is a new\ndeduction for people 65 and older,"
    } ]
  }, {
    "tStartMs": 528380,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "Up to $6,000 a person. It is real, it\nreduces what you owe, and it is worth"
    } ]
  }, {
    "tStartMs": 533740,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Claiming. What it does not do is help you\nhere, and the reason is where it"
    } ]
  }, {
    "tStartMs": 537980,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "Sits in the order. They work out your\nfigure first."
    } ]
  }, {
    "tStartMs": 541142,
    "dDurationMs": 2244,
    "segs": [ {
      "utf8": "That is the sum from check number two."
    } ]
  }, {
    "tStartMs": 543386,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "Then they compare it with $25,000 and"
    } ]
  }, {
    "tStartMs": 546120,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Decide how much of your benefit is\ntaxable."
    } ]
  }, {
    "tStartMs": 548760,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "Only after all of that is the new\ndeduction applied."
    } ]
  }, {
    "tStartMs": 551900,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "So it arrives too late to change the\nanswer."
    } ]
  }, {
    "tStartMs": 554500,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "It makes the bill smaller. It leaves the\nline exactly where it was and leaves"
    } ]
  }, {
    "tStartMs": 558860,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "You on exactly the same side of it."
    } ]
  }, {
    "tStartMs": 561120,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "I have heard it said this year that the\ndeduction means seniors no longer pay"
    } ]
  }, {
    "tStartMs": 564660,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Tax on Social Security. That is wrong, and\nanyone repeating it has skipped"
    } ]
  }, {
    "tStartMs": 569020,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The order of the sum. What to do."
    } ]
  }, {
    "tStartMs": 572000,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Claim it, because it is real money."
    } ]
  }, {
    "tStartMs": 574300,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "But do your check number two sum as though\nit did not exist, because for that"
    } ]
  }, {
    "tStartMs": 578240,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Purpose it does not."
    } ]
  }, {
    "tStartMs": 580300,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "One thing runs underneath all six of\nthese."
    } ]
  }, {
    "tStartMs": 583000,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Every part of this was already in motion\nbefore you retired."
    } ]
  }, {
    "tStartMs": 586300,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "The lines were set, and every step since\nhas been arithmetic doing what arithmetic"
    } ]
  }, {
    "tStartMs": 590560,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Does. An announcement would require\nsomebody to have decided something."
    } ]
  }, {
    "tStartMs": 594980,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Nobody did. That is why it catches careful\npeople."
    } ]
  }, {
    "tStartMs": 598140,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "There is nothing to notice, right up until\nthe year there is a letter."
    } ]
  }, {
    "tStartMs": 601720,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Now the edge of what I can tell you."
    } ]
  }, {
    "tStartMs": 603540,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "I cannot see your return and I do not know\nwhat you were paid."
    } ]
  }, {
    "tStartMs": 607140,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "These are the federal rules. States have\ntheir own and a number of them tax"
    } ]
  }, {
    "tStartMs": 611280,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Benefits as well, which is a separate\nquestion with a different answer in every"
    } ]
  }, {
    "tStartMs": 615200,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "State. What any of this means for your\nhousehold is a matter for whoever prepares"
    } ]
  }, {
    "tStartMs": 619440,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Your return, with your own figures in\nfront of them."
    } ]
  }, {
    "tStartMs": 622720,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "The six, said quickly. The line is $25,000\non your own and $32,000 married,"
    } ]
  }, {
    "tStartMs": 628600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "With a second line at $34,000 and $44,000."
    } ]
  }, {
    "tStartMs": 632300,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "Half of your Social Security is added in\nbefore anything else, along with your"
    } ]
  }, {
    "tStartMs": 636340,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Pension, your withdrawals, your wages and\nyour interest, including municipal"
    } ]
  }, {
    "tStartMs": 641120,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Bond interest. The raise lifts that half\nand moves you toward the line."
    } ]
  }, {
    "tStartMs": 645920,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "In 1984 fewer than 1 in 10 paid this and\ntoday it is 48%, with no new"
    } ]
  }, {
    "tStartMs": 652000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Law behind the change."
    } ]
  }, {
    "tStartMs": 653760,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Money from a Roth is the only kind that\nnever gets added in."
    } ]
  }, {
    "tStartMs": 656860,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "And the new $6,000 deduction arrives after\nthe sum, so it lowers the bill while"
    } ]
  }, {
    "tStartMs": 661960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Leaving the line alone."
    } ]
  }, {
    "tStartMs": 663780,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "None of this is hidden. All of it sits in\na federal publication, free, for"
    } ]
  }, {
    "tStartMs": 668240,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Anybody who goes looking. It catches older\npeople anyway, because it is written"
    } ]
  }, {
    "tStartMs": 672480,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "For somebody who already suspects there is\nsomething to look for."
    } ]
  }, {
    "tStartMs": 676100,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "One last thing. If somebody rings you\noffering to keep your Social Security"
    } ]
  }, {
    "tStartMs": 679920,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Out of the tax, put the telephone down."
    } ]
  }, {
    "tStartMs": 682500,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "No service, no product and no payment\nchanges where that line sits."
    } ]
  }, {
    "tStartMs": 686860,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "The only things that move your figure are\nwhich accounts you draw from and"
    } ]
  }, {
    "tStartMs": 690200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "How much, and those are decided at your\nown table."
    } ]
  }, {
    "tStartMs": 693440,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And if your mother or your father is on a\nfixed income and has never once done"
    } ]
  }, {
    "tStartMs": 697200,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "This sum, do it for them in December when\nthe new amount arrives."
    } ]
  }, {
    "tStartMs": 700520,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "It takes four minutes, and the alternative\nis that they find out the way Pearl"
    } ]
  }, {
    "tStartMs": 704840,
    "dDurationMs": 495,
    "segs": [ {
      "utf8": "Did."
    } ]
  } ]
}
