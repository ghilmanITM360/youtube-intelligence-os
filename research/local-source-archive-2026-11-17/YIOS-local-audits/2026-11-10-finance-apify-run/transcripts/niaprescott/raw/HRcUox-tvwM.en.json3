  }, {
    "tStartMs": 447931,
    "dDurationMs": 3642,
    "segs": [ {
      "utf8": "scam and the average loss runs into the thousands."
    } ]
  }, {
    "tStartMs": 452274,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Here is how it works."
    } ]
  }, {
    "tStartMs": 454255,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "Someone sends you a friend request or a message."
    } ]
  }, {
    "tStartMs": 457496,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "Their profile looks real."
    } ]
  }, {
    "tStartMs": 459698,
    "dDurationMs": 4342,
    "segs": [ {
      "utf8": "They have photos, friends, posts going back months or years."
    } ]
  }, {
    "tStartMs": 464700,
    "dDurationMs": 1321,
    "segs": [ {
      "utf8": "They start a conversation."
    } ]
  }, {
    "tStartMs": 466481,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "They are kind and attentive and they say all the right things."
    } ]
  }, {
    "tStartMs": 470984,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "Over weeks or months they build a relationship with you."
    } ]
  }, {
    "tStartMs": 474426,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "They call you."
    } ]
  }, {
    "tStartMs": 475607,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "They text you good morning."
    } ]
  }, {
    "tStartMs": 477167,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "They make you feel seen."
    } ]
  }, {
    "tStartMs": 478888,
    "dDurationMs": 1121,
    "segs": [ {
      "utf8": "And then the ask comes."
    } ]
  }, {
    "tStartMs": 480609,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "They are stuck overseas and need money for a plane ticket."
    } ]
  }, {
    "tStartMs": 484472,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "They have a medical emergency."
    } ]
  }, {
    "tStartMs": 486573,
    "dDurationMs": 3382,
    "segs": [ {
      "utf8": "Their business deal fell through and they need a short term loan."
    } ]
  }, {
    "tStartMs": 490715,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "They promise to pay you back."
    } ]
  }, {
    "tStartMs": 492736,
    "dDurationMs": 3782,
    "segs": [ {
      "utf8": "And because you have spent weeks or months feeling genuinely connected to"
    } ]
  }, {
    "tStartMs": 496518,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "this person you send the money."
    } ]
  }, {
    "tStartMs": 498760,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "And then they ask for more."
    } ]
  }, {
    "tStartMs": 500120,
    "dDurationMs": 981,
    "segs": [ {
      "utf8": "And more."
    } ]
  }, {
    "tStartMs": 501401,
    "dDurationMs": 1861,
    "segs": [ {
      "utf8": "And eventually they disappear."
    } ]
  }, {
    "tStartMs": 503642,
    "dDurationMs": 4263,
    "segs": [ {
      "utf8": "In twenty twenty six these scams have become even harder to spot"
    } ]
  }, {
    "tStartMs": 507905,
    "dDurationMs": 5563,
    "segs": [ {
      "utf8": "because scammers are using A I to generate photorealistic profile pictures and"
    } ]
  }, {
    "tStartMs": 513468,
    "dDurationMs": 4402,
    "segs": [ {
      "utf8": "A I chatbots to maintain conversations around the clock so the person"
    } ]
  }, {
    "tStartMs": 517870,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "you are talking to may not even be a real human being."
    } ]
  }, {
    "tStartMs": 521592,
    "dDurationMs": 2662,
    "segs": [ {
      "utf8": "The one rule that kills this scam is this."
    } ]
  }, {
    "tStartMs": 524254,
    "dDurationMs": 3302,
    "segs": [ {
      "utf8": "If someone you have never met in person asks you for money,"
    } ]
  }, {
    "tStartMs": 527996,
    "dDurationMs": 1161,
    "segs": [ {
      "utf8": "the answer is no."
    } ]
  }, {
    "tStartMs": 529817,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "It does not matter how long you have been talking."
    } ]
  }, {
    "tStartMs": 532218,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "It does not matter how real it feels."
    } ]
  }, {
    "tStartMs": 534600,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "It does not matter what the emergency is."
    } ]
  }, {
    "tStartMs": 537081,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "A real person who cares about you will never ask you to"
    } ]
  }, {
    "tStartMs": 540243,
    "dDurationMs": 3942,
    "segs": [ {
      "utf8": "wire money or send gift cards or buy cryptocurrency for them."
    } ]
  }, {
    "tStartMs": 544685,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "If they ask for money the relationship is the scam."
    } ]
  }, {
    "tStartMs": 548187,
    "dDurationMs": 4443,
    "segs": [ {
      "utf8": "Scam number five is the tech support scam and it catches people"
    } ]
  }, {
    "tStartMs": 552630,
    "dDurationMs": 3522,
    "segs": [ {
      "utf8": "in the middle of something they are already worried about which is"
    } ]
  }, {
    "tStartMs": 556152,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "why it works so well."
    } ]
  }, {
    "tStartMs": 558253,
    "dDurationMs": 1081,
    "segs": [ {
      "utf8": "Here is how it starts."
    } ]
  }, {
    "tStartMs": 559994,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "A pop up appears on your computer screen that says warning, your"
    } ]
  }, {
    "tStartMs": 563556,
    "dDurationMs": 3222,
    "segs": [ {
      "utf8": "computer has been infected, call this number immediately."
    } ]
  }, {
    "tStartMs": 567338,
    "dDurationMs": 2842,
    "segs": [ {
      "utf8": "Or you get a phone call from someone claiming to be from"
    } ]
  }, {
    "tStartMs": 570180,
    "dDurationMs": 4762,
    "segs": [ {
      "utf8": "Microsoft or Apple or your internet provider saying they have detected a"
    } ]
  }, {
    "tStartMs": 574942,
    "dDurationMs": 1081,
    "segs": [ {
      "utf8": "virus on your device."
    } ]
  }, {
    "tStartMs": 576583,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "They sound helpful."
    } ]
  }, {
    "tStartMs": 578244,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "They sound like they are trying to protect you."
    } ]
  }, {
    "tStartMs": 580385,
    "dDurationMs": 3743,
    "segs": [ {
      "utf8": "They ask you to give them remote access to your computer so"
    } ]
  }, {
    "tStartMs": 584128,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "they can fix the problem."
    } ]
  }, {
    "tStartMs": 585969,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "Once they are in they can see everything."
    } ]
  }, {
    "tStartMs": 588770,
    "dDurationMs": 4263,
    "segs": [ {
      "utf8": "Your bank login, your email, your saved passwords, your personal documents."
    } ]
  }, {
    "tStartMs": 593613,
    "dDurationMs": 4522,
    "segs": [ {
      "utf8": "They install software that gives them permanent access to your machine even"
    } ]
  }, {
    "tStartMs": 598135,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "after the call ends."
    } ]
  }, {
    "tStartMs": 599736,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "And then they either steal directly from your accounts or they tell"
    } ]
  }, {
    "tStartMs": 603418,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "you they have found a serious problem and it will cost you"
    } ]
  }, {
    "tStartMs": 606740,
    "dDurationMs": 2622,
    "segs": [ {
      "utf8": "three hundred or five hundred dollars to fix."
    } ]
  }, {
    "tStartMs": 609362,
    "dDurationMs": 4702,
    "segs": [ {
      "utf8": "The one rule that kills this scam is knowing that no legitimate"
    } ]
  }, {
    "tStartMs": 614064,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "technology company will ever call you out of the blue to tell"
    } ]
  }, {
    "tStartMs": 617526,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "you your computer has a virus."
    } ]
  }, {
    "tStartMs": 620028,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "Microsoft does not do this."
    } ]
  }, {
    "tStartMs": 622289,
    "dDurationMs": 1441,
    "segs": [ {
      "utf8": "Apple does not do this."
    } ]
  }, {
    "tStartMs": 623990,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "Your internet provider does not do this."
    } ]
  }, {
    "tStartMs": 626912,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "If you see a pop up warning on your screen close the"
    } ]
  }, {
    "tStartMs": 629873,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "browser entirely."
    } ]
  }, {
    "tStartMs": 631354,
    "dDurationMs": 2562,
    "segs": [ {
      "utf8": "Do not call the number on the screen."
    } ]
  }, {
    "tStartMs": 634416,
    "dDurationMs": 3762,
    "segs": [ {
      "utf8": "If someone calls you claiming to be tech support, hang up."
    } ]
  }, {
    "tStartMs": 638178,
    "dDurationMs": 4643,
    "segs": [ {
      "utf8": "If you genuinely believe something is wrong with your computer take it"
    } ]
  }, {
    "tStartMs": 642821,
    "dDurationMs": 4282,
    "segs": [ {
      "utf8": "to a local repair shop or call the company directly using the"
    } ]
  }, {
    "tStartMs": 647103,
    "dDurationMs": 1661,
    "segs": [ {
      "utf8": "number on their official website."
    } ]
  }, {
    "tStartMs": 649204,
    "dDurationMs": 3942,
    "segs": [ {
      "utf8": "Now here is the pattern that ties every one of these scams"
    } ]
  }, {
    "tStartMs": 653146,
    "dDurationMs": 3642,
    "segs": [ {
      "utf8": "together and once you see it you will never miss it again."
    } ]
  }, {
    "tStartMs": 657569,
    "dDurationMs": 3022,
    "segs": [ {
      "utf8": "Every scam follows the same five steps."
    } ]
  }, {
    "tStartMs": 660971,
    "dDurationMs": 4742,
    "segs": [ {
      "utf8": "They pretend to be someone you trust, a government agency, a family"
    } ]
  }, {
    "tStartMs": 665713,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "member, Medicare, a love interest, a tech company."
    } ]
  }, {
    "tStartMs": 669996,
    "dDurationMs": 4202,
    "segs": [ {
      "utf8": "They invent a problem or a prize that requires your immediate attention."
    } ]
  }, {
    "tStartMs": 674819,
    "dDurationMs": 3161,
    "segs": [ {
      "utf8": "They create pressure so you do not have time to think."
    } ]
  }, {
    "tStartMs": 678421,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "They ask you to pay in a way that cannot be reversed,"
    } ]
  }, {
    "tStartMs": 682103,
    "dDurationMs": 5183,
    "segs": [ {
      "utf8": "gift cards, wire transfers, cryptocurrency, or cash handed to a"
    } ]
  }, {
    "tStartMs": 687286,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "stranger."
    } ]
  }, {
    "tStartMs": 688386,
    "dDurationMs": 3082,
    "segs": [ {
      "utf8": "And they tell you not to talk to anyone else about it."
    } ]
  }, {
    "tStartMs": 691648,
    "dDurationMs": 4342,
    "segs": [ {
      "utf8": "If any interaction you have follows that pattern, stop."
    } ]
  }, {
    "tStartMs": 696791,
    "dDurationMs": 4502,
    "segs": [ {
      "utf8": "Hang up the phone, close the browser, step away from the computer,"
    } ]
  }, {
    "tStartMs": 701894,
    "dDurationMs": 3542,
    "segs": [ {
      "utf8": "and call someone you trust before you do anything else."
    } ]
  }, {
    "tStartMs": 706096,
    "dDurationMs": 841,
    "segs": [ {
      "utf8": "Call your son."
    } ]
  }, {
    "tStartMs": 707477,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "Call your daughter."
    } ]
  }, {
    "tStartMs": 708678,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "Call your neighbour."
    } ]
  }, {
    "tStartMs": 710018,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "Call a friend."
    } ]
  }, {
    "tStartMs": 711459,
    "dDurationMs": 2842,
    "segs": [ {
      "utf8": "One phone call to someone who is not in the middle of"
    } ]
  }, {
    "tStartMs": 714301,
    "dDurationMs": 4742,
    "segs": [ {
      "utf8": "the situation with you is the single best protection against every scam"
    } ]
  }, {
    "tStartMs": 719043,
    "dDurationMs": 741,
    "segs": [ {
      "utf8": "that exists."
    } ]
  }, {
    "tStartMs": 720344,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "I will put all the reporting numbers and links in the description"
    } ]
  }, {
    "tStartMs": 723906,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "below."
    } ]
  }, {
    "tStartMs": 724366,
    "dDurationMs": 4903,
    "segs": [ {
      "utf8": "Send this video to one person over sixty that you care about."
    } ]
  }, {
    "tStartMs": 729829,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "A parent, a grandparent, a friend, someone at church."
    } ]
  }, {
    "tStartMs": 734452,
    "dDurationMs": 3142,
    "segs": [ {
      "utf8": "Because these scams do not target stupid people."
    } ]
  }, {
    "tStartMs": 738094,
    "dDurationMs": 3482,
    "segs": [ {
      "utf8": "They target people who pick up the phone, who trust the voice"
    } ]
  }, {
    "tStartMs": 741576,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "on the other end, who want to help their family, who are"
    } ]
  }, {
    "tStartMs": 745138,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "lonely and open to connection."
    } ]
  }, {
    "tStartMs": 747579,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "They target good people."
    } ]
  }, {
    "tStartMs": 749981,
    "dDurationMs": 3922,
    "segs": [ {
      "utf8": "And the only defense is knowing what to listen for before the"
    } ]
  }, {
    "tStartMs": 753903,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "call comes."
    } ]
  }, {
    "tStartMs": 755344,
    "dDurationMs": 4662,
    "segs": [ {
      "utf8": "One share from you could save someone thirty eight thousand dollars."
    } ]
  }, {
    "tStartMs": 760006,
    "dDurationMs": 2042,
    "segs": [ {
      "utf8": "I will see you in the next one."
    } ]
  } ]
