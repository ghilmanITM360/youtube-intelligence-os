  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4349,
    "segs": [ {
      "utf8": "There is a change coming to your Social Security that very few"
    } ]
  }, {
    "tStartMs": 4349,
    "dDurationMs": 3627,
    "segs": [ {
      "utf8": "people are explaining to you plainly, and if you are one of"
    } ]
  }, {
    "tStartMs": 7976,
    "dDurationMs": 3287,
    "segs": [ {
      "utf8": "the millions of people who still receive a paper check in the"
    } ]
  }, {
    "tStartMs": 11263,
    "dDurationMs": 3247,
    "segs": [ {
      "utf8": "mail, or you help take care of a parent or someone you"
    } ]
  }, {
    "tStartMs": 14510,
    "dDurationMs": 3447,
    "segs": [ {
      "utf8": "love who does, it lands squarely on you."
    } ]
  }, {
    "tStartMs": 18318,
    "dDurationMs": 3607,
    "segs": [ {
      "utf8": "The federal government is ending the paper Social Security check."
    } ]
  }, {
    "tStartMs": 22426,
    "dDurationMs": 2225,
    "segs": [ {
      "utf8": "Not at some vague point years from now."
    } ]
  }, {
    "tStartMs": 25212,
    "dDurationMs": 3588,
    "segs": [ {
      "utf8": "A federal law and a presidential order have already taken effect,"
    } ]
  }, {
    "tStartMs": 29401,
    "dDurationMs": 3768,
    "segs": [ {
      "utf8": "and the Social Security Administration has confirmed that it is finishing the"
    } ]
  }, {
    "tStartMs": 33169,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "move to all electronic payments before the end of this year."
    } ]
  }, {
    "tStartMs": 37337,
    "dDurationMs": 4209,
    "segs": [ {
      "utf8": "The plain paper envelope that has arrived in your mailbox on the"
    } ]
  }, {
    "tStartMs": 41546,
    "dDurationMs": 3648,
    "segs": [ {
      "utf8": "same few days every month for decades is going away."
    } ]
  }, {
    "tStartMs": 45735,
    "dDurationMs": 3287,
    "segs": [ {
      "utf8": "And if you do nothing at all, you are leaving the single"
    } ]
  }, {
    "tStartMs": 49022,
    "dDurationMs": 3307,
    "segs": [ {
      "utf8": "most important payment in your life open to delay,"
    } ]
  }, {
    "tStartMs": 52810,
    "dDurationMs": 3728,
    "segs": [ {
      "utf8": "to confusion, and to a kind of theft that is spreading fast"
    } ]
  }, {
    "tStartMs": 56538,
    "dDurationMs": 3647,
    "segs": [ {
      "utf8": "right now. Let me show you what this looks like when it"
    } ]
  }, {
    "tStartMs": 60185,
    "dDurationMs": 3548,
    "segs": [ {
      "utf8": "goes wrong, because it is already happening to people."
    } ]
  }, {
    "tStartMs": 64454,
    "dDurationMs": 3688,
    "segs": [ {
      "utf8": "Picture a woman in her late seventies who has received a paper"
    } ]
  }, {
    "tStartMs": 68142,
    "dDurationMs": 3006,
    "segs": [ {
      "utf8": "check her whole life. She does not use a computer."
    } ]
  }, {
    "tStartMs": 71649,
    "dDurationMs": 3207,
    "segs": [ {
      "utf8": "She has never had much reason to. Her check comes,"
    } ]
  }, {
    "tStartMs": 75297,
    "dDurationMs": 2806,
    "segs": [ {
      "utf8": "she walks it to the bank, and that is how it has"
    } ]
  }, {
    "tStartMs": 78103,
    "dDurationMs": 4389,
    "segs": [ {
      "utf8": "always been. Then one month, the check simply does not come."
    } ]
  }, {
    "tStartMs": 82893,
    "dDurationMs": 2685,
    "segs": [ {
      "utf8": "She waits a few days, thinking it is the mail."
    } ]
  }, {
    "tStartMs": 86721,
    "dDurationMs": 4469,
    "segs": [ {
      "utf8": "It is not the mail. The paper check program has wound down,"
    } ]
  }, {
    "tStartMs": 91571,
    "dDurationMs": 3126,
    "segs": [ {
      "utf8": "and because nobody ever told her in plain words what to do,"
    } ]
  }, {
    "tStartMs": 94958,
    "dDurationMs": 3287,
    "segs": [ {
      "utf8": "there was no bank account and no card set up to catch"
    } ]
  }, {
    "tStartMs": 98245,
    "dDurationMs": 3968,
    "segs": [ {
      "utf8": "her money. Her payment did not vanish, but it did not reach"
    } ]
  }, {
    "tStartMs": 102213,
    "dDurationMs": 4189,
    "segs": [ {
      "utf8": "her either, and now she is making frightened phone calls while her"
    } ]
  }, {
    "tStartMs": 106402,
    "dDurationMs": 3868,
    "segs": [ {
      "utf8": "rent sits unpaid. That is the situation I do not want for"
    } ]
  }, {
    "tStartMs": 110270,
    "dDurationMs": 3968,
    "segs": [ {
      "utf8": "you or for anyone you love, and it is completely avoidable."
    } ]
  }, {
    "tStartMs": 114639,
    "dDurationMs": 2986,
    "segs": [ {
      "utf8": "So let me keep this calm and simple,"
    } ]
  }, {
    "tStartMs": 118046,
    "dDurationMs": 4109,
    "segs": [ {
      "utf8": "because there is no reason to panic, only a reason to act."
    } ]
  }, {
    "tStartMs": 122676,
    "dDurationMs": 3687,
    "segs": [ {
      "utf8": "By the end of these few minutes you will understand exactly what"
    } ]
  }, {
    "tStartMs": 126363,
    "dDurationMs": 4289,
    "segs": [ {
      "utf8": "is changing, the two safe ways to make sure your money keeps"
    } ]
  }, {
    "tStartMs": 130652,
    "dDurationMs": 5031,
    "segs": [ {
      "utf8": "arriving on time, the one quiet exception that protects the people who"
    } ]
  }, {
    "tStartMs": 135683,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "truly cannot switch, and the single rule that keeps the scammers who"
    } ]
  }, {
    "tStartMs": 140313,
    "dDurationMs": 2986,
    "segs": [ {
      "utf8": "are circling this change away from your benefits."
    } ]
  }, {
    "tStartMs": 144201,
    "dDurationMs": 2505,
    "segs": [ {
      "utf8": "Stay with me until that last part especially,"
    } ]
  }, {
    "tStartMs": 147147,
    "dDurationMs": 3387,
    "segs": [ {
      "utf8": "because that is where seniors are losing real money this year."
    } ]
  }, {
    "tStartMs": 150774,
    "dDurationMs": 3909,
    "segs": [ {
      "utf8": "Here is what is actually happening. For a long time the government"
    } ]
  }, {
    "tStartMs": 154683,
    "dDurationMs": 2906,
    "segs": [ {
      "utf8": "has been moving away from paper checks of every kind,"
    } ]
  }, {
    "tStartMs": 158050,
    "dDurationMs": 2826,
    "segs": [ {
      "utf8": "and Social Security was the last big holdout."
    } ]
  }, {
    "tStartMs": 161377,
    "dDurationMs": 3226,
    "segs": [ {
      "utf8": "Now the rule is in force. As of the end of September"
    } ]
  }, {
    "tStartMs": 164603,
    "dDurationMs": 4069,
    "segs": [ {
      "utf8": "in two thousand twenty five, the Treasury was directed to stop issuing"
    } ]
  }, {
    "tStartMs": 168672,
    "dDurationMs": 4529,
    "segs": [ {
      "utf8": "paper checks for federal benefits, and the Social Security Administration has said"
    } ]
  }, {
    "tStartMs": 173201,
    "dDurationMs": 3908,
    "segs": [ {
      "utf8": "it will complete the switch for everyone before this year is over."
    } ]
  }, {
    "tStartMs": 177510,
    "dDurationMs": 3327,
    "segs": [ {
      "utf8": "The reason they give is hard to argue with."
    } ]
  }, {
    "tStartMs": 181418,
    "dDurationMs": 4049,
    "segs": [ {
      "utf8": "A paper check sitting in a mailbox is about sixteen times more"
    } ]
  }, {
    "tStartMs": 185467,
    "dDurationMs": 5331,
    "segs": [ {
      "utf8": "likely to be lost, stolen, altered, or returned than a payment sent"
    } ]
  }, {
    "tStartMs": 190798,
    "dDurationMs": 5071,
    "segs": [ {
      "utf8": "electronically. Every single year, checks are lifted out of mailboxes,"
    } ]
  }, {
    "tStartMs": 196149,
    "dDurationMs": 3047,
    "segs": [ {
      "utf8": "forged, and cashed by people they were never meant for."
    } ]
  }, {
    "tStartMs": 199837,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "The government wants that to end, and the way they are ending"
    } ]
  }, {
    "tStartMs": 203104,
    "dDurationMs": 2826,
    "segs": [ {
      "utf8": "it is by ending the paper check itself."
    } ]
  }, {
    "tStartMs": 206290,
    "dDurationMs": 4029,
    "segs": [ {
      "utf8": "Now, if your benefit already goes straight into your bank account by"
    } ]
  }, {
    "tStartMs": 210319,
    "dDurationMs": 3687,
    "segs": [ {
      "utf8": "direct deposit, then much of this is already handled for you,"
    } ]
  }, {
    "tStartMs": 214357,
    "dDurationMs": 2956,
    "segs": [ {
      "utf8": "and the main thing you need from this video is the scam"
    } ]
  }, {
    "tStartMs": 217313,
    "dDurationMs": 3468,
    "segs": [ {
      "utf8": "warning near the end, because that part is for absolutely everyone."
    } ]
  }, {
    "tStartMs": 221582,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "But if you still receive an actual paper check,"
    } ]
  }, {
    "tStartMs": 224629,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "or if you are not completely certain how your payment reaches you,"
    } ]
  }, {
    "tStartMs": 228336,
    "dDurationMs": 2506,
    "segs": [ {
      "utf8": "then this is the most important thing you will sort out all"
    } ]
  }, {
    "tStartMs": 230842,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "month. Because once the paper checks stop, a payment with nowhere electronic"
    } ]
  }, {
    "tStartMs": 235612,
    "dDurationMs": 2745,
    "segs": [ {
      "utf8": "to land is a payment that does not arrive."
    } ]
  }, {
    "tStartMs": 238959,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "And a missed Social Security payment, even for a single month,"
    } ]
  }, {
    "tStartMs": 242807,
    "dDurationMs": 4409,
    "segs": [ {
      "utf8": "is something almost no retiree can absorb. Before I show you the"
    } ]
  }, {
    "tStartMs": 247216,
    "dDurationMs": 3527,
    "segs": [ {
      "utf8": "two ways to fix this, let me take away one fear right"
    } ]
  }, {
    "tStartMs": 250743,
    "dDurationMs": 3528,
    "segs": [ {
      "utf8": "now, because I know some of you are sitting there thinking that"
    } ]
  }, {
    "tStartMs": 254271,
    "dDurationMs": 2745,
    "segs": [ {
      "utf8": "you do not have a bank account and you do not use"
    } ]
  }, {
    "tStartMs": 257016,
    "dDurationMs": 3307,
    "segs": [ {
      "utf8": "the internet, and you are afraid this leaves you with nothing."
    } ]
  }, {
    "tStartMs": 260884,
    "dDurationMs": 3468,
    "segs": [ {
      "utf8": "It does not. The government has built in an exception."
    } ]
  }, {
    "tStartMs": 264993,
    "dDurationMs": 5071,
    "segs": [ {
      "utf8": "People who genuinely cannot use electronic payments, those without access to a"
    } ]
  }, {
    "tStartMs": 270064,
    "dDurationMs": 4128,
    "segs": [ {
      "utf8": "bank or who face a real hardship, can still request to keep"
    } ]
  }, {
    "tStartMs": 274192,
    "dDurationMs": 3447,
    "segs": [ {
      "utf8": "receiving a paper check. You are not going to be cut off"
    } ]
  }, {
    "tStartMs": 277639,
    "dDurationMs": 2486,
    "segs": [ {
      "utf8": "and left with no way to get your own money."
    } ]
  }, {
    "tStartMs": 280646,
    "dDurationMs": 4349,
    "segs": [ {
      "utf8": "But here is the part that matters. That exception is something you"
    } ]
  }, {
    "tStartMs": 284995,
    "dDurationMs": 3627,
    "segs": [ {
      "utf8": "have to ask for. It is not handed to you automatically."
    } ]
  }, {
    "tStartMs": 289244,
    "dDurationMs": 4168,
    "segs": [ {
      "utf8": "So whether you are moving to electronic payment or asking to stay"
    } ]
  }, {
    "tStartMs": 293412,
    "dDurationMs": 3007,
    "segs": [ {
      "utf8": "on paper, the lesson is exactly the same."
    } ]
  }, {
    "tStartMs": 297080,
    "dDurationMs": 4690,
    "segs": [ {
      "utf8": "You have to take one action. Doing nothing is the only choice"
    } ]
  }, {
    "tStartMs": 301770,
    "dDurationMs": 4128,
    "segs": [ {
      "utf8": "that actually hurts you. So here are your two safe options."
    } ]
  }, {
    "tStartMs": 306580,
    "dDurationMs": 2405,
    "segs": [ {
      "utf8": "The first, and the one most people will use,"
    } ]
  }, {
    "tStartMs": 309386,
    "dDurationMs": 3307,
    "segs": [ {
      "utf8": "is direct deposit straight into a bank or credit union account."
    } ]
  }, {
    "tStartMs": 312693,
    "dDurationMs": 4389,
    "segs": [ {
      "utf8": "If you have an account, your benefit lands inside it on your"
    } ]
  }, {
    "tStartMs": 317082,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "payment day automatically. No envelope, no mail carrier,"
    } ]
  }, {
    "tStartMs": 321611,
    "dDurationMs": 3347,
    "segs": [ {
      "utf8": "no waiting by the window. It is faster than a check,"
    } ]
  }, {
    "tStartMs": 324958,
    "dDurationMs": 2385,
    "segs": [ {
      "utf8": "and it cannot be stolen out of a mailbox."
    } ]
  }, {
    "tStartMs": 328385,
    "dDurationMs": 3127,
    "segs": [ {
      "utf8": "You can set this up through your own my Social Security account"
    } ]
  }, {
    "tStartMs": 331512,
    "dDurationMs": 4108,
    "segs": [ {
      "utf8": "online, or by calling the Social Security Administration directly,"
    } ]
  }, {
    "tStartMs": 336242,
    "dDurationMs": 3487,
    "segs": [ {
      "utf8": "or by walking into your local Social Security office,"
    } ]
  }, {
    "tStartMs": 339729,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "or even by asking your bank to send your account details over"
    } ]
  }, {
    "tStartMs": 343858,
    "dDurationMs": 4469,
    "segs": [ {
      "utf8": "to Social Security for you. I will put the official phone number"
    } ]
  }, {
    "tStartMs": 348327,
    "dDurationMs": 2405,
    "segs": [ {
      "utf8": "and the official website down in the description,"
    } ]
  }, {
    "tStartMs": 350732,
    "dDurationMs": 4409,
    "segs": [ {
      "utf8": "so that you are dealing only with the real Social Security Administration"
    } ]
  }, {
    "tStartMs": 355141,
    "dDurationMs": 4570,
    "segs": [ {
      "utf8": "and with nobody pretending to be them. The second option is built"
    } ]
  }, {
    "tStartMs": 359711,
    "dDurationMs": 3728,
    "segs": [ {
      "utf8": "specifically for the people who do not have a bank account and"
    } ]
  }, {
    "tStartMs": 363439,
    "dDurationMs": 3687,
    "segs": [ {
      "utf8": "do not want one. It is called the Direct Express card."
    } ]
  }, {
    "tStartMs": 367627,
    "dDurationMs": 4369,
    "segs": [ {
      "utf8": "It is a prepaid debit card, and your Social Security payment is"
    } ]
  }, {
    "tStartMs": 371996,
    "dDurationMs": 4249,
    "segs": [ {
      "utf8": "loaded onto it automatically every month. You can use it to buy"
    } ]
  }, {
    "tStartMs": 376245,
    "dDurationMs": 3347,
    "segs": [ {
      "utf8": "your groceries, pay your bills, and take out cash,"
    } ]
  }, {
    "tStartMs": 379973,
    "dDurationMs": 3447,
    "segs": [ {
      "utf8": "exactly like any other card, and you never needed a bank to"
    } ]
  }, {
    "tStartMs": 383420,
    "dDurationMs": 3728,
    "segs": [ {
      "utf8": "get it. There is no monthly fee just to use it."
    } ]
  }, {
    "tStartMs": 387328,
    "dDurationMs": 2405,
    "segs": [ {
      "utf8": "If that sounds like the right fit for you,"
    } ]
  }, {
    "tStartMs": 390134,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "you can sign up over the phone, and once again I will"
    } ]
  }, {
    "tStartMs": 393762,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "leave the official Direct Express number in the description,"
    } ]
  }, {
    "tStartMs": 396929,
    "dDurationMs": 3848,
    "segs": [ {
      "utf8": "so you reach the genuine program and not an imposter."
    } ]
  }, {
    "tStartMs": 401759,
    "dDurationMs": 3707,
    "segs": [ {
      "utf8": "One important note for either choice. When you set up a new"
    } ]
  }, {
    "tStartMs": 405466,
    "dDurationMs": 3888,
    "segs": [ {
      "utf8": "direct deposit or a new card, it can take thirty to sixty"
    } ]
  }, {
    "tStartMs": 409354,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "days to fully take effect. So please do not wait until the"
    } ]
  }, {
    "tStartMs": 413984,
    "dDurationMs": 4610,
    "segs": [ {
      "utf8": "last moment. Begin now, while you still have plenty of time before"
    } ]
  }, {
    "tStartMs": 418594,
    "dDurationMs": 4068,
    "segs": [ {
      "utf8": "the change is finished. And now the part I told you to"
    } ]
  }, {
    "tStartMs": 422662,
    "dDurationMs": 4189,
    "segs": [ {
      "utf8": "wait for, because this is where the real danger of this whole"
    } ]
  }, {
    "tStartMs": 426851,
    "dDurationMs": 3547,
    "segs": [ {
      "utf8": "change lives, and it is the reason I sat down to make"
    } ]
  }, {
    "tStartMs": 430398,
    "dDurationMs": 4851,
    "segs": [ {
      "utf8": "this for you. Wherever the government announces a big change in how"
    } ]
  }, {
    "tStartMs": 435249,
    "dDurationMs": 4329,
    "segs": [ {
      "utf8": "seniors receive their money, the scammers move in right behind it,"
    } ]
  }, {
    "tStartMs": 439578,
    "dDurationMs": 2525,
    "segs": [ {
      "utf8": "and they have moved in on this one hard."
    } ]
  }, {
    "tStartMs": 443005,
    "dDurationMs": 4309,
    "segs": [ {
      "utf8": "Here is how their trick works. A scammer reaches out to you,"
    } ]
  }, {
    "tStartMs": 447314,
    "dDurationMs": 4589,
    "segs": [ {
      "utf8": "by phone, by text message, by letter, or by a message on"
    } ]
  }, {
    "tStartMs": 451903,
    "dDurationMs": 4931,
    "segs": [ {
      "utf8": "social media, and they pretend to be from the Social Security Administration."
    } ]
  }, {
    "tStartMs": 457435,
    "dDurationMs": 4289,
    "segs": [ {
      "utf8": "They can even fake the number, so that the caller identification on"
    } ]
  }, {
    "tStartMs": 461724,
    "dDurationMs": 3387,
    "segs": [ {
      "utf8": "your phone shows what looks like a real government line."
    } ]
  }, {
    "tStartMs": 465672,
    "dDurationMs": 3347,
    "segs": [ {
      "utf8": "They tell you that because of the switch to electronic payments,"
    } ]
  }, {
    "tStartMs": 469500,
    "dDurationMs": 3928,
    "segs": [ {
      "utf8": "you need to verify your account, or confirm your bank details,"
    } ]
  }, {
    "tStartMs": 473428,
    "dDurationMs": 5652,
    "segs": [ {
      "utf8": "or update your direct deposit information immediately, or else your benefits will"
    } ]
  }, {
    "tStartMs": 479080,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "be suspended. It sounds official. It sounds urgent."
    } ]
  }, {
    "tStartMs": 483690,
    "dDurationMs": 2305,
    "segs": [ {
      "utf8": "They want you afraid and in a hurry,"
    } ]
  }, {
    "tStartMs": 485995,
    "dDurationMs": 5551,
    "segs": [ {
      "utf8": "because frightened people stop thinking clearly. And if you give them what"
    } ]
  }, {
    "tStartMs": 491546,
    "dDurationMs": 3147,
    "segs": [ {
      "utf8": "they ask for, they do not protect your payment."
    } ]
  }, {
    "tStartMs": 495434,
    "dDurationMs": 4349,
    "segs": [ {
      "utf8": "They quietly change the banking details on your record and send your"
    } ]
  }, {
    "tStartMs": 499783,
    "dDurationMs": 5171,
    "segs": [ {
      "utf8": "next payment straight into their own account. The cruelest part is that"
    } ]
  }, {
    "tStartMs": 504954,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "you often do not discover any of it until the day your"
    } ]
  }, {
    "tStartMs": 508421,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "money simply fails to arrive, and by then it has already been"
    } ]
  }, {
    "tStartMs": 512971,
    "dDurationMs": 4409,
    "segs": [ {
      "utf8": "taken. This is not rare, and it is not happening to careless"
    } ]
  }, {
    "tStartMs": 517380,
    "dDurationMs": 4890,
    "segs": [ {
      "utf8": "people. It is happening to sharp, careful seniors who were caught at"
    } ]
  }, {
    "tStartMs": 522270,
    "dDurationMs": 4109,
    "segs": [ {
      "utf8": "the wrong moment by a story that sounded exactly like the news"
    } ]
  }, {
    "tStartMs": 526379,
    "dDurationMs": 2826,
    "segs": [ {
      "utf8": "they had just heard about paper checks ending."
    } ]
  }, {
    "tStartMs": 529926,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "Let me make it concrete, because these calls are far more convincing"
    } ]
  }, {
    "tStartMs": 534476,
    "dDurationMs": 4549,
    "segs": [ {
      "utf8": "than you would expect. Imagine the phone rings on a quiet weekday"
    } ]
  }, {
    "tStartMs": 539025,
    "dDurationMs": 3468,
    "segs": [ {
      "utf8": "afternoon. The voice on the other end is calm,"
    } ]
  }, {
    "tStartMs": 542933,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "polite, and professional. The caller already knows your name,"
    } ]
  }, {
    "tStartMs": 547483,
    "dDurationMs": 4389,
    "segs": [ {
      "utf8": "and perhaps even repeats back the last few digits of something familiar,"
    } ]
  }, {
    "tStartMs": 552534,
    "dDurationMs": 3026,
    "segs": [ {
      "utf8": "which is just enough to make you believe they must be official."
    } ]
  }, {
    "tStartMs": 556241,
    "dDurationMs": 2906,
    "segs": [ {
      "utf8": "They tell you there is a problem with the switch to electronic"
    } ]
  }, {
    "tStartMs": 559147,
    "dDurationMs": 4149,
    "segs": [ {
      "utf8": "payments on your account, and that unless you confirm your banking information"
    } ]
  }, {
    "tStartMs": 563296,
    "dDurationMs": 3608,
    "segs": [ {
      "utf8": "in the next few minutes, your next deposit will be placed on"
    } ]
  }, {
    "tStartMs": 566904,
    "dDurationMs": 3146,
    "segs": [ {
      "utf8": "hold. There is no anger in the voice,"
    } ]
  }, {
    "tStartMs": 570591,
    "dDurationMs": 4149,
    "segs": [ {
      "utf8": "only concern, as though they are on your side and simply trying"
    } ]
  }, {
    "tStartMs": 574740,
    "dDurationMs": 5070,
    "segs": [ {
      "utf8": "to spare you a delay. That gentle, helpful tone is the weapon."
    } ]
  }, {
    "tStartMs": 580512,
    "dDurationMs": 3126,
    "segs": [ {
      "utf8": "By the time the call ends, you have read out the very"
    } ]
  }, {
    "tStartMs": 583638,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "numbers that let them walk straight into your account,"
    } ]
  }, {
    "tStartMs": 586605,
    "dDurationMs": 4429,
    "segs": [ {
      "utf8": "and you hang up feeling relieved, certain you just protected your money,"
    } ]
  }, {
    "tStartMs": 591034,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "when in truth you have just handed it away."
    } ]
  }, {
    "tStartMs": 594381,
    "dDurationMs": 3227,
    "segs": [ {
      "utf8": "That is how careful people lose a whole month of income,"
    } ]
  }, {
    "tStartMs": 597608,
    "dDurationMs": 4409,
    "segs": [ {
      "utf8": "and there is no shame in it. The only real protection is"
    } ]
  }, {
    "tStartMs": 602017,
    "dDurationMs": 3387,
    "segs": [ {
      "utf8": "knowing in advance that the call itself is the lie."
    } ]
  }, {
    "tStartMs": 605404,
    "dDurationMs": 3768,
    "segs": [ {
      "utf8": "So here is the one rule that keeps you safe,"
    } ]
  }, {
    "tStartMs": 609172,
    "dDurationMs": 3287,
    "segs": [ {
      "utf8": "and I want you to hold onto it more tightly than anything"
    } ]
  }, {
    "tStartMs": 612459,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "else I have told you today. The real Social Security Administration will"
    } ]
  }, {
    "tStartMs": 617589,
    "dDurationMs": 3548,
    "segs": [ {
      "utf8": "not call you, will not text you, and will not email you"
    } ]
  }, {
    "tStartMs": 621137,
    "dDurationMs": 3287,
    "segs": [ {
      "utf8": "out of nowhere demanding that you verify your bank information,"
    } ]
  }, {
    "tStartMs": 625045,
    "dDurationMs": 2946,
    "segs": [ {
      "utf8": "and they will not threaten to cut off your benefits if you"
    } ]
  }, {
    "tStartMs": 627991,
    "dDurationMs": 4149,
    "segs": [ {
      "utf8": "do not act this very minute. That is simply not how they"
    } ]
  }, {
    "tStartMs": 632140,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "operate. So if someone contacts you first and pressures you for your"
    } ]
  }, {
    "tStartMs": 637050,
    "dDurationMs": 3407,
    "segs": [ {
      "utf8": "bank details or your Social Security number over this change,"
    } ]
  }, {
    "tStartMs": 641078,
    "dDurationMs": 3728,
    "segs": [ {
      "utf8": "it is a scam, every single time, with no exceptions."
    } ]
  }, {
    "tStartMs": 645247,
    "dDurationMs": 2425,
    "segs": [ {
      "utf8": "Do not press the button they tell you to press."
    } ]
  }, {
    "tStartMs": 648273,
    "dDurationMs": 2245,
    "segs": [ {
      "utf8": "Do not call the number they read out to you."
    } ]
  }, {
    "tStartMs": 650919,
    "dDurationMs": 3106,
    "segs": [ {
      "utf8": "Hang up. And if you want to check on your own account,"
    } ]
  }, {
    "tStartMs": 654647,
    "dDurationMs": 4650,
    "segs": [ {
      "utf8": "you reach out to Social Security yourself, using only the official number"
    } ]
  }, {
    "tStartMs": 659297,
    "dDurationMs": 3727,
    "segs": [ {
      "utf8": "and the official website that I will leave in the description below."
    } ]
  }, {
    "tStartMs": 663405,
    "dDurationMs": 4149,
    "segs": [ {
      "utf8": "You reaching out to them is safe. Them reaching out to you"
    } ]
  }, {
    "tStartMs": 667554,
    "dDurationMs": 2445,
    "segs": [ {
      "utf8": "and asking for your details is the trap,"
    } ]
  }, {
    "tStartMs": 669999,
    "dDurationMs": 2204,
    "segs": [ {
      "utf8": "every time. Let me bring this all together,"
    } ]
  }, {
    "tStartMs": 672203,
    "dDurationMs": 3788,
    "segs": [ {
      "utf8": "because underneath everything the message is calm and clear."
    } ]
  }, {
    "tStartMs": 676472,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "The paper check is ending. That part is not a scam."
    } ]
  }, {
    "tStartMs": 680180,
    "dDurationMs": 2746,
    "segs": [ {
      "utf8": "It is real, and it is happening this year."
    } ]
  }, {
    "tStartMs": 683226,
    "dDurationMs": 3327,
    "segs": [ {
      "utf8": "But you are not powerless, and you are not going to be"
    } ]
  }, {
    "tStartMs": 686553,
    "dDurationMs": 3969,
    "segs": [ {
      "utf8": "abandoned. If you have a bank account, set up direct deposit."
    } ]
  }, {
    "tStartMs": 691023,
    "dDurationMs": 3327,
    "segs": [ {
      "utf8": "If you do not have one, get the Direct Express card."
    } ]
  }, {
    "tStartMs": 694791,
    "dDurationMs": 4028,
    "segs": [ {
      "utf8": "If you truly cannot manage either, ask to keep your paper check."
    } ]
  }, {
    "tStartMs": 699280,
    "dDurationMs": 2746,
    "segs": [ {
      "utf8": "Choose the one that fits your life, and do it soon,"
    } ]
  }, {
    "tStartMs": 702026,
    "dDurationMs": 3968,
    "segs": [ {
      "utf8": "because the change is almost complete, and a payment with nowhere to"
    } ]
  }, {
    "tStartMs": 705994,
    "dDurationMs": 2185,
    "segs": [ {
      "utf8": "land is a payment that does not come."
    } ]
  }, {
    "tStartMs": 708620,
    "dDurationMs": 2445,
    "segs": [ {
      "utf8": "And through all of it, hold the rule close."
    } ]
  }, {
    "tStartMs": 711506,
    "dDurationMs": 3006,
    "segs": [ {
      "utf8": "You reach out to them. They do not get to call you"
    } ]
  }, {
    "tStartMs": 714512,
    "dDurationMs": 3507,
    "segs": [ {
      "utf8": "and ask for your bank details. The moment you understand that,"
    } ]
  }, {
    "tStartMs": 718460,
    "dDurationMs": 3568,
    "segs": [ {
      "utf8": "no scammer alive can touch your check. And let me make the"
    } ]
  }, {
    "tStartMs": 722028,
    "dDurationMs": 3306,
    "segs": [ {
      "utf8": "action small enough that you can actually do it tonight,"
    } ]
  }, {
    "tStartMs": 725334,
    "dDurationMs": 3187,
    "segs": [ {
      "utf8": "because I do not want this to feel like a mountain."
    } ]
  }, {
    "tStartMs": 729142,
    "dDurationMs": 2506,
    "segs": [ {
      "utf8": "You do not have to solve everything at once."
    } ]
  }, {
    "tStartMs": 732229,
    "dDurationMs": 4810,
    "segs": [ {
      "utf8": "This week, do one single thing. Find out how your Social Security"
    } ]
  }, {
    "tStartMs": 737039,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "payment reaches you right now. If it already arrives by direct deposit,"
    } ]
  }, {
    "tStartMs": 742370,
    "dDurationMs": 4089,
    "segs": [ {
      "utf8": "then you are in good shape, and your only job is to"
    } ]
  }, {
    "tStartMs": 746459,
    "dDurationMs": 3727,
    "segs": [ {
      "utf8": "remember the rule about the scam calls. If it still comes as"
    } ]
  }, {
    "tStartMs": 750186,
    "dDurationMs": 4249,
    "segs": [ {
      "utf8": "a paper check, make one call to the official Social Security number"
    } ]
  }, {
    "tStartMs": 754435,
    "dDurationMs": 4269,
    "segs": [ {
      "utf8": "in the description, or sit down with one person you trust who"
    } ]
  }, {
    "tStartMs": 758704,
    "dDurationMs": 2746,
    "segs": [ {
      "utf8": "can help you set up direct deposit or the card."
    } ]
  }, {
    "tStartMs": 762191,
    "dDurationMs": 3408,
    "segs": [ {
      "utf8": "One phone call. That is the entire task."
    } ]
  }, {
    "tStartMs": 766300,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "Everything else follows naturally from it. So do one kind thing before"
    } ]
  }, {
    "tStartMs": 771030,
    "dDurationMs": 4289,
    "segs": [ {
      "utf8": "you go. Think of someone you know who still watches for that"
    } ]
  }, {
    "tStartMs": 775319,
    "dDurationMs": 3307,
    "segs": [ {
      "utf8": "paper envelope in the mail each month. A parent,"
    } ]
  }, {
    "tStartMs": 779027,
    "dDurationMs": 3908,
    "segs": [ {
      "utf8": "a neighbor, an old friend who does not spend much time online"
    } ]
  }, {
    "tStartMs": 782935,
    "dDurationMs": 3768,
    "segs": [ {
      "utf8": "and would never hear about this change until it was already too"
    } ]
  }, {
    "tStartMs": 786703,
    "dDurationMs": 5090,
    "segs": [ {
      "utf8": "late. Send this to them today. A two minute warning from you"
    } ]
  }, {
    "tStartMs": 791793,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "could be the single reason their Social Security keeps arriving without one"
    } ]
  }, {
    "tStartMs": 796563,
    "dDurationMs": 4550,
    "segs": [ {
      "utf8": "missed month, and the reason a stranger pretending to help never gets"
    } ]
  }, {
    "tStartMs": 801113,
    "dDurationMs": 3888,
    "segs": [ {
      "utf8": "the chance to take it. There are not many messages you can"
    } ]
  }, {
    "tStartMs": 805001,
    "dDurationMs": 3487,
    "segs": [ {
      "utf8": "send that protect somebody's whole income in one move."
    } ]
  }, {
    "tStartMs": 809109,
    "dDurationMs": 1003,
    "segs": [ {
      "utf8": "This is one of them."
    } ]
  } ]
}
