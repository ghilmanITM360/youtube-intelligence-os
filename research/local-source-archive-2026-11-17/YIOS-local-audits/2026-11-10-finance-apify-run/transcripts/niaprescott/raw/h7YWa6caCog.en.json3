{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "On the thirtieth of October a payment\nlands in a great many bank accounts."
    } ]
  }, {
    "tStartMs": 6060,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "In a great many houses it will be gone\nbefore the eighth of November."
    } ]
  }, {
    "tStartMs": 10900,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Then nothing arrives for twenty eight\ndays."
    } ]
  }, {
    "tStartMs": 13780,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "That is not a guess. That is the calendar,\nand it is already decided."
    } ]
  }, {
    "tStartMs": 18920,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Now the thing you were told. Move your\nmoney before the first of November."
    } ]
  }, {
    "tStartMs": 23800,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "I went looking for that rule. It is not\nthere."
    } ]
  }, {
    "tStartMs": 27280,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Nothing changes at your bank that day."
    } ]
  }, {
    "tStartMs": 29200,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "No law takes effect. And not one person\ntelling you to move your money has"
    } ]
  }, {
    "tStartMs": 34300,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "ever shown you the rule, because there is\nno rule to show."
    } ]
  }, {
    "tStartMs": 38440,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So there is your answer. Nothing changes\non the first of November."
    } ]
  }, {
    "tStartMs": 42800,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "But five things are real, and every one of\nthem is already set."
    } ]
  }, {
    "tStartMs": 47280,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "The first one empties a month."
    } ]
  }, {
    "tStartMs": 49900,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "I cannot see your account and I am not\ngoing to pretend that I can."
    } ]
  }, {
    "tStartMs": 53360,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "What I can do is tell you which of the\nfive reach you."
    } ]
  }, {
    "tStartMs": 57560,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Two of them touch only people on one kind\nof payment."
    } ]
  }, {
    "tStartMs": 61080,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Three touch everybody over 65."
    } ]
  }, {
    "tStartMs": 64200,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "None of this is hidden. Every number here\nsits on a government website, free,"
    } ]
  }, {
    "tStartMs": 69000,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "for anybody who looks."
    } ]
  }, {
    "tStartMs": 71120,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "It works badly for people only because\nnobody posts it to you."
    } ]
  }, {
    "tStartMs": 75500,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Number one. The money that lands on the\nthirtieth of October is November money."
    } ]
  }, {
    "tStartMs": 80380,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Spend it and November is empty."
    } ]
  }, {
    "tStartMs": 82220,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Here is why it comes early. The first of\nNovember falls on a Sunday this year."
    } ]
  }, {
    "tStartMs": 87560,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Payments do not go out on a Sunday."
    } ]
  }, {
    "tStartMs": 89520,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "So they go out on the working day before,\nand that day is Friday the thirtieth"
    } ]
  }, {
    "tStartMs": 94350,
    "dDurationMs": 1130,
    "segs": [ {
      "utf8": "of October."
    } ]
  }, {
    "tStartMs": 95520,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "This is the extra payment for people with\nvery little income, the one that"
    } ]
  }, {
    "tStartMs": 99160,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "arrives on top of a small Social Security\ncheck."
    } ]
  }, {
    "tStartMs": 102160,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "If that is you, two deposits land in\nOctober."
    } ]
  }, {
    "tStartMs": 105320,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "One at the start of the month, and one on\nthe thirtieth."
    } ]
  }, {
    "tStartMs": 109093,
    "dDurationMs": 2067,
    "segs": [ {
      "utf8": "Now the part that empties a house."
    } ]
  }, {
    "tStartMs": 111720,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "That second deposit is not a bonus."
    } ]
  }, {
    "tStartMs": 114620,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It is not back pay. It is not extra."
    } ]
  }, {
    "tStartMs": 117480,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "It is November, handed to you two days\nearly."
    } ]
  }, {
    "tStartMs": 121140,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "There is no payment at all in November."
    } ]
  }, {
    "tStartMs": 123880,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "The next one is the first of December."
    } ]
  }, {
    "tStartMs": 126460,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "So the money in your hand on the thirtieth\nof October has to carry you to the"
    } ]
  }, {
    "tStartMs": 130560,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "first of December. That is 32 days."
    } ]
  }, {
    "tStartMs": 135000,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Every year some people see that deposit,\ndecide the government sent something"
    } ]
  }, {
    "tStartMs": 139160,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "extra, and spend it. By the middle of\nNovember the account is empty and the"
    } ]
  }, {
    "tStartMs": 144020,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "rent is still due. If you get the ordinary\nSocial Security retirement payment,"
    } ]
  }, {
    "tStartMs": 149520,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "none of this touches you. Your date does\nnot move."
    } ]
  }, {
    "tStartMs": 153320,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "You are paid on a Wednesday that depends\non your birthday, and the thirtieth"
    } ]
  }, {
    "tStartMs": 157340,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "of October is not your date. Mark the\nthirtieth of October on your calendar"
    } ]
  }, {
    "tStartMs": 161840,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "today and write one word beside it."
    } ]
  }, {
    "tStartMs": 164700,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "November. Number two. Your savings decide\nwhether the government pays your"
    } ]
  }, {
    "tStartMs": 170000,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "Medicare bill. One dollar over and it\nstops."
    } ]
  }, {
    "tStartMs": 173700,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Most people rule themselves out on income."
    } ]
  }, {
    "tStartMs": 176340,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "They hear there is help, they think about\nwhat they earn, they decide they"
    } ]
  }, {
    "tStartMs": 180000,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "earn too much, and they never ask."
    } ]
  }, {
    "tStartMs": 182620,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "That is the wrong number. There are two\ntests, not one."
    } ]
  }, {
    "tStartMs": 187120,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Income is the first. What is sitting in\nthe bank is the second, and almost"
    } ]
  }, {
    "tStartMs": 191440,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "nobody is told about it. Take the program\nthat cuts what you pay for medicine."
    } ]
  }, {
    "tStartMs": 196140,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "It is called Extra Help. This year the\nincome line is $23,940 a year"
    } ]
  }, {
    "tStartMs": 202380,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "for one person, and $32,460 for a married\ncouple living together."
    } ]
  }, {
    "tStartMs": 208600,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Those lines are higher than most people\nguess."
    } ]
  }, {
    "tStartMs": 211720,
    "dDurationMs": 6020,
    "segs": [ {
      "utf8": "The savings line is $18,090 for one\nperson, and $36,100 for"
    } ]
  }, {
    "tStartMs": 217740,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "a couple."
    } ]
  }, {
    "tStartMs": 218920,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Now the hard part. It is not a slope."
    } ]
  }, {
    "tStartMs": 221520,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It is a cliff. Under the line the help\ncontinues."
    } ]
  }, {
    "tStartMs": 225160,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Over the line it stops. Not reduced."
    } ]
  }, {
    "tStartMs": 228300,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Stopped. So a man who sells a car in\nNovember, puts the money in his savings"
    } ]
  }, {
    "tStartMs": 232720,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "account and leaves it sitting there, can\nlose help he has had for years, and"
    } ]
  }, {
    "tStartMs": 237200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "nobody will telephone to tell him what he\ndid."
    } ]
  }, {
    "tStartMs": 239800,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Your home does not count. One car does not\ncount."
    } ]
  }, {
    "tStartMs": 242940,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "What counts is money in accounts."
    } ]
  }, {
    "tStartMs": 245540,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Add your own accounts up once, this week,\non paper."
    } ]
  }, {
    "tStartMs": 248560,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Then ask. A refusal costs you nothing."
    } ]
  }, {
    "tStartMs": 252520,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Not asking costs you every single month."
    } ]
  }, {
    "tStartMs": 255420,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Number three. The price of your medicine\nnext year is already set."
    } ]
  }, {
    "tStartMs": 259660,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "It went up, and nobody wrote to tell you."
    } ]
  }, {
    "tStartMs": 262280,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Two numbers moved, and both are decided."
    } ]
  }, {
    "tStartMs": 265060,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "They are not proposals. They are not\nprojections."
    } ]
  }, {
    "tStartMs": 267700,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "They are published. The amount you pay\nyourself before the plan pays anything"
    } ]
  }, {
    "tStartMs": 272220,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "goes from $615 to $700. That is $85 more\nout of"
    } ]
  }, {
    "tStartMs": 278260,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "your pocket, and most of it lands in\nJanuary when money is already tight."
    } ]
  }, {
    "tStartMs": 283120,
    "dDurationMs": 5508,
    "segs": [ {
      "utf8": "The most you can be made to pay in a whole\nyear goes from $2,100 to $2,400."
    } ]
  }, {
    "tStartMs": 289240,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "If you take expensive medicine you reach\nthat ceiling every year, so that is"
    } ]
  }, {
    "tStartMs": 293820,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "$300 more on top. Here is what nobody says\nout loud."
    } ]
  }, {
    "tStartMs": 297880,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "Your plan is allowed to change its list of\ncovered medicines every January."
    } ]
  }, {
    "tStartMs": 302280,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "It can move your medicine into a group\nthat costs you more."
    } ]
  }, {
    "tStartMs": 305020,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It can change which pharmacies it works\nwith."
    } ]
  }, {
    "tStartMs": 308220,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "None of that needs your permission, and\nthe letter that tells you arrives in"
    } ]
  }, {
    "tStartMs": 312060,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "an envelope most people throw away."
    } ]
  }, {
    "tStartMs": 315080,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The window to change plans is open now and\nit shuts on the seventh of December."
    } ]
  }, {
    "tStartMs": 320260,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "After that your price is fixed for the\nwhole of next year."
    } ]
  }, {
    "tStartMs": 323860,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Go to medicare.gov, or telephone\n1-800-MEDICARE."
    } ]
  }, {
    "tStartMs": 329140,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Put in every medicine you take, with the\ndose, and your own pharmacy."
    } ]
  }, {
    "tStartMs": 333000,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Then look at the total for the year, not\nthe monthly price."
    } ]
  }, {
    "tStartMs": 337400,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "A cheap monthly price very often hides an\nexpensive medicine."
    } ]
  }, {
    "tStartMs": 341820,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Number four. Your Medicare payment for\nnext year has not been announced, and"
    } ]
  }, {
    "tStartMs": 346060,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "anybody telling you the number is\nguessing."
    } ]
  }, {
    "tStartMs": 348900,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Right now it is $202.90 a month."
    } ]
  }, {
    "tStartMs": 352520,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "It comes out of your Social Security check\nbefore the money ever reaches you."
    } ]
  }, {
    "tStartMs": 357000,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "You never touch it. For next year there is\na projection."
    } ]
  }, {
    "tStartMs": 359980,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "The people who run the numbers put it near\n$209.50."
    } ]
  }, {
    "tStartMs": 365040,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "A projection is not a price. The real\nfigure comes out in November, and until"
    } ]
  }, {
    "tStartMs": 369520,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "it does, nobody has it. So when you see a\nvideo with next year number in the"
    } ]
  }, {
    "tStartMs": 373900,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "title, you are watching somebody guess."
    } ]
  }, {
    "tStartMs": 376320,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Ask where they got it, because there is\nnowhere to get it yet."
    } ]
  }, {
    "tStartMs": 380060,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Here is why it matters more than it\nsounds."
    } ]
  }, {
    "tStartMs": 382520,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "You were told your raise is 3.6%."
    } ]
  }, {
    "tStartMs": 385340,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "That is true. But this payment comes out\nbefore the raise reaches your bank,"
    } ]
  }, {
    "tStartMs": 389780,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and it has climbed every year."
    } ]
  }, {
    "tStartMs": 392420,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "Last year it jumped almost $18 in one\nstep, and every cent of that climb came"
    } ]
  }, {
    "tStartMs": 397440,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "out of the raise people were given."
    } ]
  }, {
    "tStartMs": 399160,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "So the raise you were promised and"
    } ]
  }, {
    "tStartMs": 401120,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the money that lands are two different\nnumbers,"
    } ]
  }, {
    "tStartMs": 403360,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "and the second one is not finished."
    } ]
  }, {
    "tStartMs": 405960,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Do not plan your winter on the headline."
    } ]
  }, {
    "tStartMs": 407880,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Plan it on the smaller of the two."
    } ]
  }, {
    "tStartMs": 409580,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "If the bigger number lands, you are ahead."
    } ]
  }, {
    "tStartMs": 412100,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "If you planned the other way round,\nJanuary is where you find out."
    } ]
  }, {
    "tStartMs": 416440,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Number five. On the first of November the\ngovernment sets the savings bond"
    } ]
  }, {
    "tStartMs": 420220,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "rate, and it locks for six months."
    } ]
  }, {
    "tStartMs": 422900,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "This is the savings bond built to keep\npace with prices."
    } ]
  }, {
    "tStartMs": 426140,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "The government sets a new rate twice a\nyear, on the first of May and the first"
    } ]
  }, {
    "tStartMs": 430340,
    "dDurationMs": 4530,
    "segs": [ {
      "utf8": "of November. The rate running now is\n4.26%."
    } ]
  }, {
    "tStartMs": 434910,
    "dDurationMs": 2230,
    "segs": [ {
      "utf8": "It holds until the thirty first of\nOctober."
    } ]
  }, {
    "tStartMs": 437140,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "On the first of November a new rate is\nset, and whatever it says that morning"
    } ]
  }, {
    "tStartMs": 442000,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "is the rate you are locked into for six\nmonths if you buy after it."
    } ]
  }, {
    "tStartMs": 446720,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "That new number has not been announced\neither."
    } ]
  }, {
    "tStartMs": 449560,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Anybody quoting it to you today is\nguessing, the same as the Medicare one."
    } ]
  }, {
    "tStartMs": 454140,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "Here is the part that costs people."
    } ]
  }, {
    "tStartMs": 456260,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Most have never heard of this, so they\nleave every dollar in a bank account"
    } ]
  }, {
    "tStartMs": 460160,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "that pays almost nothing. And the bank is\nnot required to tell them when that"
    } ]
  }, {
    "tStartMs": 464700,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "almost nothing gets smaller. It does not\nwrite."
    } ]
  }, {
    "tStartMs": 467940,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "It does not telephone. It simply pays\nless, and the money that stops arriving"
    } ]
  }, {
    "tStartMs": 472580,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "never shows up as a loss."
    } ]
  }, {
    "tStartMs": 474980,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "You buy these straight from the government\nat treasurydirect.gov."
    } ]
  }, {
    "tStartMs": 478820,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "There is no salesman and there is no fee."
    } ]
  }, {
    "tStartMs": 481800,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "The one rule to know is that your money\nstays in for at least a year, so this"
    } ]
  }, {
    "tStartMs": 486420,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "is for savings you will not need next\nmonth."
    } ]
  }, {
    "tStartMs": 489660,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "And this is the only one of the five where\nwaiting a few days may be the right"
    } ]
  }, {
    "tStartMs": 493480,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "move. If you were going to buy this week,\nthe rate on the first of November"
    } ]
  }, {
    "tStartMs": 497820,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "is worth seeing first. That is the five."
    } ]
  }, {
    "tStartMs": 501440,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Now look at what they have in common."
    } ]
  }, {
    "tStartMs": 503620,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Not one of them is a new rule."
    } ]
  }, {
    "tStartMs": 505740,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Not one of them is a change on"
    } ]
  }, {
    "tStartMs": 507220,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "the thirtieth of October or the first of\nNovember."
    } ]
  }, {
    "tStartMs": 510580,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Every one of them was decided months ago\nby somebody who was never going to"
    } ]
  }, {
    "tStartMs": 514720,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "write to you. The people telling you to\nmove your money by Friday have the"
    } ]
  }, {
    "tStartMs": 518720,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "date right and the reason wrong."
    } ]
  }, {
    "tStartMs": 521180,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "The date is real. What happens on it is a\npayment arriving early and a rate"
    } ]
  }, {
    "tStartMs": 525820,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "being set. That is all of it. So treat\nthis as education and not as advice"
    } ]
  }, {
    "tStartMs": 531100,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "about your own money. Your plan, your\nstate and your own account are three"
    } ]
  }, {
    "tStartMs": 535740,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "things I cannot see, and those three\ndecide your figure."
    } ]
  }, {
    "tStartMs": 539380,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "If you take one thing from this, take the\nfirst one."
    } ]
  }, {
    "tStartMs": 542500,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "If a deposit lands on the thirtieth of\nOctober and you are on the extra payment"
    } ]
  }, {
    "tStartMs": 546880,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "for people with very little income, that\nmoney is November."
    } ]
  }, {
    "tStartMs": 550940,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Write the word November beside it on your\ncalendar, and make it last to the"
    } ]
  }, {
    "tStartMs": 554520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "first of December."
    } ]
  }, {
    "tStartMs": 555980,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "And if your mother or your father is on\nthat payment, do not send them this"
    } ]
  }, {
    "tStartMs": 559520,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "video. Sit down beside them, open the\ncalendar, and write it there yourself."
    } ]
  }, {
    "tStartMs": 564740,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "By the middle of November it is already\nspent."
    } ]
  } ]
}
