{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "Since June, your direct deposit is looked\nat twice before you can spend it."
    } ]
  }, {
    "tStartMs": 5800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Once by the Treasury before the money\nleaves Washington."
    } ]
  }, {
    "tStartMs": 9220,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Once by your own bank the moment it lands."
    } ]
  }, {
    "tStartMs": 12160,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "The second one is new. Every bank and\nevery credit union in this country now"
    } ]
  }, {
    "tStartMs": 16900,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "has to watch money arriving, not just\nmoney leaving, and hunt for the signs"
    } ]
  }, {
    "tStartMs": 21660,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "that somebody redirected a payment to\nthemselves."
    } ]
  }, {
    "tStartMs": 25280,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Here is what that means on a Wednesday\nmorning."
    } ]
  }, {
    "tStartMs": 27480,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Your bank can hold the money after it\nposts."
    } ]
  }, {
    "tStartMs": 30960,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "And nobody has to write to you first."
    } ]
  }, {
    "tStartMs": 33620,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "You find out at the counter, or you find\nout when the mortgage bounces."
    } ]
  }, {
    "tStartMs": 37980,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Now the part nobody says out loud."
    } ]
  }, {
    "tStartMs": 40840,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "There is no rule aimed at Social Security."
    } ]
  }, {
    "tStartMs": 44000,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Nobody wrote a list with retirees on it."
    } ]
  }, {
    "tStartMs": 46780,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "Nothing starts in January."
    } ]
  }, {
    "tStartMs": 49100,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "What actually happened is quieter than\nthat, and it does not end."
    } ]
  }, {
    "tStartMs": 53100,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "The signs these systems hunt for are"
    } ]
  }, {
    "tStartMs": 56360,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "the ordinary money life of a retired\nhousehold."
    } ]
  }, {
    "tStartMs": 59820,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Three similar payments in one week."
    } ]
  }, {
    "tStartMs": 62160,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "An account you just opened. An account you\nhave not touched in a year."
    } ]
  }, {
    "tStartMs": 66100,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "None of that is wrong. All of it is on the\nlist."
    } ]
  }, {
    "tStartMs": 69320,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "And one of those two checks, your bank\ncannot fix at all."
    } ]
  }, {
    "tStartMs": 73120,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "If the Treasury stops your payment before\nit is sent, your branch can do nothing"
    } ]
  }, {
    "tStartMs": 77160,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "for you. Only Social Security can, and\nonly in person."
    } ]
  }, {
    "tStartMs": 81460,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "So one question for the next 15 minutes."
    } ]
  }, {
    "tStartMs": 85020,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "If your payment did not land tomorrow\nmorning, do you know which office to"
    } ]
  }, {
    "tStartMs": 88980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "call first?"
    } ]
  }, {
    "tStartMs": 90320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Most people call the wrong one and lose a\nweek on it."
    } ]
  }, {
    "tStartMs": 94000,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Five things to check before your next\npayment day."
    } ]
  }, {
    "tStartMs": 97200,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Number three is the one sentence to say at\nthe counter."
    } ]
  }, {
    "tStartMs": 100360,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Numbers four and five are two free blocks\nat Social Security, and almost nobody"
    } ]
  }, {
    "tStartMs": 105000,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "has been offered either one."
    } ]
  }, {
    "tStartMs": 106940,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Everything here comes from the rule books."
    } ]
  }, {
    "tStartMs": 109320,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Nacha, the Treasury, Social Security, and\nthe federal regulations that govern"
    } ]
  }, {
    "tStartMs": 113940,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "your account."
    } ]
  }, {
    "tStartMs": 115200,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Every source is in the description."
    } ]
  }, {
    "tStartMs": 117460,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "My examples are invented. The rules are\nnot."
    } ]
  }, {
    "tStartMs": 120940,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Before we start, tell me in the comments."
    } ]
  }, {
    "tStartMs": 123520,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Has a deposit of yours ever been late,\nshort, or held, even for one day?"
    } ]
  }, {
    "tStartMs": 128840,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Number one. The name on the account."
    } ]
  }, {
    "tStartMs": 131540,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Start here, because this is the one the\nnew checks were built to catch, and"
    } ]
  }, {
    "tStartMs": 135620,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "it is the one honest families break\nwithout knowing."
    } ]
  }, {
    "tStartMs": 138860,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Under the Treasury rules, a federal\nbenefit payment has to go into an account"
    } ]
  }, {
    "tStartMs": 142940,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "in the name of the person receiving it."
    } ]
  }, {
    "tStartMs": 145340,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Your own account meets that. A joint\naccount with your daughter, with your"
    } ]
  }, {
    "tStartMs": 149240,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "name on it, meets that. An account in your\ndaughter name alone does not."
    } ]
  }, {
    "tStartMs": 154000,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "That sounds like paperwork until you see\nwhat changed last year."
    } ]
  }, {
    "tStartMs": 157880,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "The Treasury now checks whether the\naccount really belongs to the person being"
    } ]
  }, {
    "tStartMs": 161460,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "paid, and those checks became fully\noperational at the end of September."
    } ]
  }, {
    "tStartMs": 166080,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "In its own report it screened more than a\nbillion federal payments, worth trillions"
    } ]
  }, {
    "tStartMs": 170460,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "of dollars, and it stopped thousands that\nwere about to go to people who had"
    } ]
  }, {
    "tStartMs": 174220,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "died."
    } ]
  }, {
    "tStartMs": 175420,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "So picture how this happens. A woman in\nher eighties has a fall."
    } ]
  }, {
    "tStartMs": 179540,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Her daughter starts handling the bills,\nand to keep things simple she has the"
    } ]
  }, {
    "tStartMs": 183640,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "deposit sent to her own checking account."
    } ]
  }, {
    "tStartMs": 186320,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Everyone acted out of love. Nothing was\nstolen."
    } ]
  }, {
    "tStartMs": 189540,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "And an account that belongs to somebody\nelse is exactly the thing an ownership"
    } ]
  }, {
    "tStartMs": 193760,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "check is built to notice. Now here is the\npart that catches people."
    } ]
  }, {
    "tStartMs": 197700,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "The daughter has power of attorney, and\nshe assumed that covered it."
    } ]
  }, {
    "tStartMs": 201440,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It does not."
    } ]
  }, {
    "tStartMs": 202820,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Social Security does not recognize a power\nof attorney for receiving federal"
    } ]
  }, {
    "tStartMs": 206320,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "payments. I want to say that again,\nbecause almost every family I hear from"
    } ]
  }, {
    "tStartMs": 210460,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "gets this wrong. The document your lawyer\ndrew up, the one that lets her sell"
    } ]
  }, {
    "tStartMs": 214860,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "the house and talk to the hospital, does\nnot let her receive your benefit into"
    } ]
  }, {
    "tStartMs": 219480,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "her own account."
    } ]
  }, {
    "tStartMs": 221200,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The tool that does exist is called a\nrepresentative payee."
    } ]
  }, {
    "tStartMs": 224840,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "You apply to Social Security for it."
    } ]
  }, {
    "tStartMs": 227080,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "It is not the same thing and it is not\nautomatic."
    } ]
  }, {
    "tStartMs": 230280,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "So the check before your next payment day\nis short."
    } ]
  }, {
    "tStartMs": 233640,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Open your banking app. Read the name on\nthe account."
    } ]
  }, {
    "tStartMs": 236600,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Then look at your last letter from Social\nSecurity and read the name on that."
    } ]
  }, {
    "tStartMs": 240940,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "If they are not the same name, spelled the\nsame way, that is your first phone"
    } ]
  }, {
    "tStartMs": 245260,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "call. If you changed your name after a\nmarriage or after losing a husband or"
    } ]
  }, {
    "tStartMs": 249420,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "wife, this is where that shows up."
    } ]
  }, {
    "tStartMs": 252240,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Number two. The four things banks look\nfor."
    } ]
  }, {
    "tStartMs": 254600,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "This is the rule everybody is shouting\nabout, so let me tell you exactly what"
    } ]
  }, {
    "tStartMs": 259040,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "it says. The organization that writes the\nrules for electronic payments is"
    } ]
  }, {
    "tStartMs": 263320,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "called Nacha. It is not a government\nagency, but every bank and credit union"
    } ]
  }, {
    "tStartMs": 267840,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "that moves an electronic payment agrees to\nfollow it, and in practice it works"
    } ]
  }, {
    "tStartMs": 272280,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "like law. It brought this in over two\nstages."
    } ]
  }, {
    "tStartMs": 275500,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "From March, it applied only to the largest\nbanks, the ones taking in 10 million"
    } ]
  }, {
    "tStartMs": 279920,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "or more of these payments. From June, the\nsize limit disappeared."
    } ]
  }, {
    "tStartMs": 284460,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Every bank and every credit union now\nfalls under it, down to the smallest"
    } ]
  }, {
    "tStartMs": 288200,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "one in your town. What it requires is\nthis."
    } ]
  }, {
    "tStartMs": 291480,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Each bank must have processes built to\nspot money coming in that may have been"
    } ]
  }, {
    "tStartMs": 295620,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "sent because somebody lied. And they have\nto review those processes at least"
    } ]
  }, {
    "tStartMs": 299860,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "once a year. So this is not a crackdown\nthat fades out."
    } ]
  }, {
    "tStartMs": 303180,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "It is the new normal. Now the four\npatterns."
    } ]
  }, {
    "tStartMs": 306500,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "These come from the guidance the banks\nthemselves were given."
    } ]
  }, {
    "tStartMs": 309660,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The first is a payment that does not fit\nthe kind of account it lands in."
    } ]
  }, {
    "tStartMs": 313660,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The second is a payment that is unusually\nlarge for that account."
    } ]
  }, {
    "tStartMs": 317160,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "The third is several similar payments\narriving close together, and benefit"
    } ]
  }, {
    "tStartMs": 321620,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "payments are named in that example."
    } ]
  }, {
    "tStartMs": 323200,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "The fourth is any of those landing in an\naccount that is brand new, or one"
    } ]
  }, {
    "tStartMs": 327720,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "that has been sitting untouched."
    } ]
  }, {
    "tStartMs": 329780,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Read those four again and think about an\nhonest retired couple."
    } ]
  }, {
    "tStartMs": 334720,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "His payment arrives on the second\nWednesday."
    } ]
  }, {
    "tStartMs": 337580,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "Hers arrives on the fourth."
    } ]
  }, {
    "tStartMs": 339960,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "A pension lands on the first."
    } ]
  }, {
    "tStartMs": 342280,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Their branch closed in the summer, so they\nopened an account at a credit union"
    } ]
  }, {
    "tStartMs": 346660,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "and moved all three across in a single\nweek."
    } ]
  }, {
    "tStartMs": 351220,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "Three similar payments, into an account\nwith no history, in seven days."
    } ]
  }, {
    "tStartMs": 356460,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Nothing about it is improper. Every piece\nof it is on that list."
    } ]
  }, {
    "tStartMs": 361220,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "So here is the move, and it is free."
    } ]
  }, {
    "tStartMs": 363960,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "If you are ever changing banks, do not\nmove the deposit first."
    } ]
  }, {
    "tStartMs": 368540,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Open the new account. Use it for a month,\nso it has a history."
    } ]
  }, {
    "tStartMs": 373040,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Then move your deposit over in the days\nright after a payment has landed, never"
    } ]
  }, {
    "tStartMs": 377560,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "in the days before one is due."
    } ]
  }, {
    "tStartMs": 380040,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "That single change in order takes you off\nthree of the four patterns at once."
    } ]
  }, {
    "tStartMs": 385300,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "And if you have an old savings account you\nnever touch, either use it now and"
    } ]
  }, {
    "tStartMs": 389420,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "then or close it. A dormant account that\nsuddenly fills up tells a story, whether"
    } ]
  }, {
    "tStartMs": 394960,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "the story is true or not."
    } ]
  }, {
    "tStartMs": 397980,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Number three. Held, or sent back."
    } ]
  }, {
    "tStartMs": 401120,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "This is the one you can actually fix, so\nif you remember one thing today, remember"
    } ]
  }, {
    "tStartMs": 406100,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "this sentence. If your payment is not\nthere, you walk up to the counter and"
    } ]
  }, {
    "tStartMs": 410660,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "you ask exactly this. Is my deposit posted\nand held, or was it returned."
    } ]
  }, {
    "tStartMs": 416380,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Those are two completely different\nsituations and almost nobody knows there"
    } ]
  }, {
    "tStartMs": 420520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "is a difference."
    } ]
  }, {
    "tStartMs": 422100,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Held means the money arrived. It is\nsitting in your account."
    } ]
  }, {
    "tStartMs": 425860,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "The bank has put a stop on your ability to\nspend it while it looks at something."
    } ]
  }, {
    "tStartMs": 430280,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "The money is still yours and it is still\nthere."
    } ]
  }, {
    "tStartMs": 433400,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "What the bank usually needs is to confirm\nwho you are, so take your identification,"
    } ]
  }, {
    "tStartMs": 437860,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "and take a letter from Social Security\nthat shows what they pay you."
    } ]
  }, {
    "tStartMs": 442680,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "You can print that from your own account\non their website."
    } ]
  }, {
    "tStartMs": 446120,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Returned means the money is gone."
    } ]
  }, {
    "tStartMs": 448400,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "The bank sent it back back to the\nTreasury."
    } ]
  }, {
    "tStartMs": 451020,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Nothing you say at that counter will bring\nit back, because it is no longer"
    } ]
  }, {
    "tStartMs": 454880,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "in the building."
    } ]
  }, {
    "tStartMs": 456260,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "That is the moment you stop talking to the\nbank and start talking to Social"
    } ]
  }, {
    "tStartMs": 460200,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Security, because the payment has to be\nsent out to you again, and only they"
    } ]
  }, {
    "tStartMs": 464360,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "can do that. Get those two the wrong way\naround and you lose days you cannot"
    } ]
  }, {
    "tStartMs": 468740,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "afford to lose. Rent does not wait while\nyou learn the difference, and neither"
    } ]
  }, {
    "tStartMs": 472840,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "does a car payment. People stand in a bank\narguing about money that left the"
    } ]
  }, {
    "tStartMs": 477120,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "building on Tuesday, or they sit on the\nphone to Social Security about money"
    } ]
  }, {
    "tStartMs": 481380,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "that is sitting in their own account\nwaiting for a signature."
    } ]
  }, {
    "tStartMs": 485120,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Now two rules that are on your side, and\nalmost nobody is told either one."
    } ]
  }, {
    "tStartMs": 490280,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The first. A bank may not hold your money\nsimply because it has not got round"
    } ]
  }, {
    "tStartMs": 494720,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "to looking at it. A delay needs an actual\nreason."
    } ]
  }, {
    "tStartMs": 498440,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "The rule does not require them to check\nevery payment before it posts, and"
    } ]
  }, {
    "tStartMs": 502460,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "most of this watching happens after your\nmoney is already in your account."
    } ]
  }, {
    "tStartMs": 507020,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "The second. You may have heard that a new\naccount means long holds."
    } ]
  }, {
    "tStartMs": 511160,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "That is true for paper checks."
    } ]
  }, {
    "tStartMs": 513420,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "It is not true for yours."
    } ]
  }, {
    "tStartMs": 515700,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Under the federal availability rules, an\nelectronic payment like your benefit"
    } ]
  }, {
    "tStartMs": 519720,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "generally has to be available by the next\nbusiness day, even in an account"
    } ]
  }, {
    "tStartMs": 523820,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "less than 30 days old."
    } ]
  }, {
    "tStartMs": 526280,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "The long holds on new accounts are about\npaper."
    } ]
  }, {
    "tStartMs": 529080,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "What can actually slow your deposit is a\nsuspicion, not the age of the account."
    } ]
  }, {
    "tStartMs": 533920,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "So if someone tells you it is held because\nthe account is new, that is the"
    } ]
  }, {
    "tStartMs": 537560,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "moment to ask the question again."
    } ]
  }, {
    "tStartMs": 539440,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Posted and held, or returned. Number four."
    } ]
  }, {
    "tStartMs": 542880,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "The Direct Deposit Fraud Prevention block."
    } ]
  }, {
    "tStartMs": 544940,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Here is something Social Security will\ngive you for nothing, and will almost"
    } ]
  }, {
    "tStartMs": 549100,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "certainly never offer you. Ask for it by\nits full name and the person on the"
    } ]
  }, {
    "tStartMs": 553320,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "phone will know exactly what you mean."
    } ]
  }, {
    "tStartMs": 555940,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "Direct Deposit Fraud Prevention."
    } ]
  }, {
    "tStartMs": 558520,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Say those four words and nothing else."
    } ]
  }, {
    "tStartMs": 561120,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "What it does is simple and it is strong."
    } ]
  }, {
    "tStartMs": 563720,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "It stops anyone from enrolling you in\ndirect deposit, or changing your address,"
    } ]
  }, {
    "tStartMs": 568260,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "or changing where your deposit goes,\nthrough the website or through a bank."
    } ]
  }, {
    "tStartMs": 572780,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Anyone. Including you. That last part is\nthe whole point, so let me explain"
    } ]
  }, {
    "tStartMs": 577340,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "why it matters. When you open an account,\na lot of banks can sign you up for"
    } ]
  }, {
    "tStartMs": 581500,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "direct deposit with Social Security\ndirectly, without you ever calling the"
    } ]
  }, {
    "tStartMs": 585700,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "agency. It is convenient. It is also a\ndoor."
    } ]
  }, {
    "tStartMs": 589700,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Somebody who has enough of your details\ncan walk through it."
    } ]
  }, {
    "tStartMs": 592460,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "The block closes the door. Once that block\nis on your record, a change has"
    } ]
  }, {
    "tStartMs": 596560,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "to be made in person. You or your\nrepresentative go to the office."
    } ]
  }, {
    "tStartMs": 600580,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "That is the cost, and I am not going to\npretend it is nothing."
    } ]
  }, {
    "tStartMs": 603060,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "If you move house every other year, this\nwill annoy you."
    } ]
  }, {
    "tStartMs": 606860,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "But if your deposit has gone to the same\naccount for years, and you have no"
    } ]
  }, {
    "tStartMs": 610480,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "plan to move it, that inconvenience costs\nyou almost nothing and it shuts the"
    } ]
  }, {
    "tStartMs": 614740,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "most common way this crime is actually\ndone."
    } ]
  }, {
    "tStartMs": 617600,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Nobody can quietly redirect a payment they\nare not allowed to touch."
    } ]
  }, {
    "tStartMs": 621660,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Number five. The eServices block."
    } ]
  }, {
    "tStartMs": 624520,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The second block goes further, and it\nsuits a different person entirely."
    } ]
  }, {
    "tStartMs": 628660,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "The eServices block stops anyone from\nseeing or changing your information online"
    } ]
  }, {
    "tStartMs": 632960,
    "dDurationMs": 2690,
    "segs": [ {
      "utf8": "at all. Not just the deposit. Everything."
    } ]
  }, {
    "tStartMs": 635690,
    "dDurationMs": 3190,
    "segs": [ {
      "utf8": "This one is for the person who is never\ngoing to use that website."
    } ]
  }, {
    "tStartMs": 639440,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "If you do all your business at the office\nor on the telephone, and you have"
    } ]
  }, {
    "tStartMs": 642920,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "no intention of logging in, then an online\naccount in your name is a liability"
    } ]
  }, {
    "tStartMs": 647860,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "and not a convenience."
    } ]
  }, {
    "tStartMs": 649700,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Close the online door completely and the\nonly way to reach your record is in"
    } ]
  }, {
    "tStartMs": 653960,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "person."
    } ]
  }, {
    "tStartMs": 655060,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "If you do use the website, this is not\nyour block."
    } ]
  }, {
    "tStartMs": 658500,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Take the first one instead."
    } ]
  }, {
    "tStartMs": 660740,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "And one last thing, because it is the\nother side of the same coin."
    } ]
  }, {
    "tStartMs": 664660,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "There is a genuine account you should\nopen, in your own name, before anybody"
    } ]
  }, {
    "tStartMs": 668700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "else does."
    } ]
  }, {
    "tStartMs": 670120,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "An account you control is an account a\ncriminal cannot quietly open pretending"
    } ]
  }, {
    "tStartMs": 674360,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to be you."
    } ]
  }, {
    "tStartMs": 675700,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Set it up, look at the bank details on\nfile, and check that they are the ones"
    } ]
  }, {
    "tStartMs": 679880,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "you expect. While you are in there, look\nat your payment history and see what"
    } ]
  }, {
    "tStartMs": 684480,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "actually arrived, not what you remember\narriving."
    } ]
  }, {
    "tStartMs": 687540,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "So that is the five. The name on the\naccount has to be your name, and a power"
    } ]
  }, {
    "tStartMs": 691720,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "of attorney does not change that."
    } ]
  }, {
    "tStartMs": 693960,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Four patterns are being watched for, and\nthe ordinary life of a retired household"
    } ]
  }, {
    "tStartMs": 698320,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "hits three of them in a bad week."
    } ]
  }, {
    "tStartMs": 700960,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "If the money is missing, there is one\nsentence that tells you which office"
    } ]
  }, {
    "tStartMs": 704520,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "to call. And there are two free blocks\nsitting at Social Security that nobody"
    } ]
  }, {
    "tStartMs": 708620,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "will offer you. Here is the part I want\nyou to actually do, and it takes one"
    } ]
  }, {
    "tStartMs": 712880,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "afternoon."
    } ]
  }, {
    "tStartMs": 714100,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Open your banking app and read the name on\nthe account."
    } ]
  }, {
    "tStartMs": 717500,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Compare it with your last letter."
    } ]
  }, {
    "tStartMs": 718800,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Then call Social Security and ask about\nthe Direct Deposit Fraud Prevention"
    } ]
  }, {
    "tStartMs": 723180,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "block by name, and decide whether the in\nperson trade is worth it to you."
    } ]
  }, {
    "tStartMs": 727500,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Then turn on an alert at your bank for\nevery deposit that arrives, so you know"
    } ]
  }, {
    "tStartMs": 731740,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "on the same morning if something is\nmissing, instead of finding out when a"
    } ]
  }, {
    "tStartMs": 735220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "payment bounces."
    } ]
  }, {
    "tStartMs": 736800,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And write one page and leave it somewhere\nyou will find it."
    } ]
  }, {
    "tStartMs": 740060,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Your payment date. Your bank fraud\ndepartment number."
    } ]
  }, {
    "tStartMs": 743400,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "The Social Security number for your local\noffice."
    } ]
  }, {
    "tStartMs": 745580,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And the name of one person besides you who\nis allowed to see your accounts."
    } ]
  }, {
    "tStartMs": 750160,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "Nobody is coming to take your check, and I\nam not going to tell you otherwise"
    } ]
  }, {
    "tStartMs": 753460,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "to keep you watching. But the system that\nmoves it has more hands on it than"
    } ]
  }, {
    "tStartMs": 757760,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "it had in June, and the people who get\ntheir money back quickly are the ones"
    } ]
  }, {
    "tStartMs": 761860,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "who knew which door to knock on before\nthey needed to."
    } ]
  }, {
    "tStartMs": 765200,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "If your situation has a twist I did not\ncover, a payee, a joint account after"
    } ]
  }, {
    "tStartMs": 769720,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "a death, a deposit already being held,\ntell me in the comments."
    } ]
  }, {
    "tStartMs": 773540,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "I read them and they decide what I dig\ninto next."
    } ]
  }, {
    "tStartMs": 777080,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Everything here is general information,\nnot guidance about your own money."
    } ]
  }, {
    "tStartMs": 781180,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "What your bank does, and what Social\nSecurity has on your record, decide what"
    } ]
  }, {
    "tStartMs": 785260,
    "dDurationMs": 910,
    "segs": [ {
      "utf8": "happens to you."
    } ]
  } ]
}
