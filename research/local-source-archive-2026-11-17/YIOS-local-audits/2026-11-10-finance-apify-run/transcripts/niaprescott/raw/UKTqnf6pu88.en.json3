  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3685,
    "segs": [ {
      "utf8": "Add them all up and a senior who qualifies could"
    } ]
  }, {
    "tStartMs": 3685,
    "dDurationMs": 2905,
    "segs": [ {
      "utf8": "be handing over more than ten thousand dollars a year"
    } ]
  }, {
    "tStartMs": 6590,
    "dDurationMs": 3185,
    "segs": [ {
      "utf8": "in bills that the law itself says they do not"
    } ]
  }, {
    "tStartMs": 9775,
    "dDurationMs": 702,
    "segs": [ {
      "utf8": "have to pay."
    } ]
  }, {
    "tStartMs": 11057,
    "dDurationMs": 1523,
    "segs": [ {
      "utf8": "Not a discount on those bills."
    } ]
  }, {
    "tStartMs": 12981,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "Not a coupon that shaves off a little."
    } ]
  }, {
    "tStartMs": 15284,
    "dDurationMs": 1002,
    "segs": [ {
      "utf8": "The full amount,"
    } ]
  }, {
    "tStartMs": 16286,
    "dDurationMs": 741,
    "segs": [ {
      "utf8": "gone,"
    } ]
  }, {
    "tStartMs": 17027,
    "dDurationMs": 1663,
    "segs": [ {
      "utf8": "every single month,"
    } ]
  }, {
    "tStartMs": 18690,
    "dDurationMs": 2744,
    "segs": [ {
      "utf8": "for one reason and one reason only."
    } ]
  }, {
    "tStartMs": 22095,
    "dDurationMs": 2705,
    "segs": [ {
      "utf8": "Nobody ever told you that you were allowed to stop."
    } ]
  }, {
    "tStartMs": 25421,
    "dDurationMs": 2584,
    "segs": [ {
      "utf8": "And some of these expanded just this year,"
    } ]
  }, {
    "tStartMs": 28005,
    "dDurationMs": 1983,
    "segs": [ {
      "utf8": "in twenty twenty six,"
    } ]
  }, {
    "tStartMs": 29988,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "which is exactly why so many people are still paying"
    } ]
  }, {
    "tStartMs": 32833,
    "dDurationMs": 841,
    "segs": [ {
      "utf8": "the old way,"
    } ]
  }, {
    "tStartMs": 34115,
    "dDurationMs": 2724,
    "segs": [ {
      "utf8": "never realizing the rules moved underneath them."
    } ]
  }, {
    "tStartMs": 37180,
    "dDurationMs": 2063,
    "segs": [ {
      "utf8": "I am not talking about a senior discount."
    } ]
  }, {
    "tStartMs": 39704,
    "dDurationMs": 2965,
    "segs": [ {
      "utf8": "I am talking about bills you are legally exempt from,"
    } ]
  }, {
    "tStartMs": 42669,
    "dDurationMs": 741,
    "segs": [ {
      "utf8": "completely,"
    } ]
  }, {
    "tStartMs": 43971,
    "dDurationMs": 2384,
    "segs": [ {
      "utf8": "where the right answer is not to pay a smaller"
    } ]
  }, {
    "tStartMs": 46355,
    "dDurationMs": 2644,
    "segs": [ {
      "utf8": "amount but to pay nothing at all."
    } ]
  }, {
    "tStartMs": 49400,
    "dDurationMs": 2624,
    "segs": [ {
      "utf8": "By the end of this you will know exactly which"
    } ]
  }, {
    "tStartMs": 52024,
    "dDurationMs": 421,
    "segs": [ {
      "utf8": "ones,"
    } ]
  }, {
    "tStartMs": 52445,
    "dDurationMs": 1162,
    "segs": [ {
      "utf8": "who qualifies,"
    } ]
  }, {
    "tStartMs": 53607,
    "dDurationMs": 3826,
    "segs": [ {
      "utf8": "and the single quiet mistake that keeps that money draining"
    } ]
  }, {
    "tStartMs": 57433,
    "dDurationMs": 2263,
    "segs": [ {
      "utf8": "out of your account year after year."
    } ]
  }, {
    "tStartMs": 60117,
    "dDurationMs": 2945,
    "segs": [ {
      "utf8": "Let me start with the biggest one for the most"
    } ]
  }, {
    "tStartMs": 63062,
    "dDurationMs": 481,
    "segs": [ {
      "utf8": "people,"
    } ]
  }, {
    "tStartMs": 63543,
    "dDurationMs": 4226,
    "segs": [ {
      "utf8": "because almost every senior on Medicare is paying this right"
    } ]
  }, {
    "tStartMs": 67769,
    "dDurationMs": 2064,
    "segs": [ {
      "utf8": "now without ever questioning it."
    } ]
  }, {
    "tStartMs": 70514,
    "dDurationMs": 621,
    "segs": [ {
      "utf8": "Every month,"
    } ]
  }, {
    "tStartMs": 71496,
    "dDurationMs": 3245,
    "segs": [ {
      "utf8": "a payment for Medicare Part B is pulled straight out"
    } ]
  }, {
    "tStartMs": 74741,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "of your Social Security check before that check ever reaches"
    } ]
  }, {
    "tStartMs": 78327,
    "dDurationMs": 641,
    "segs": [ {
      "utf8": "your hands,"
    } ]
  }, {
    "tStartMs": 79328,
    "dDurationMs": 3736,
    "segs": [ {
      "utf8": "and in twenty twenty six that amount is two hundred"
    } ]
  }, {
    "tStartMs": 83064,
    "dDurationMs": 1242,
    "segs": [ {
      "utf8": "and two dollars and ninety cents."
    } ]
  }, {
    "tStartMs": 84306,
    "dDurationMs": 1192,
    "segs": [ {
      "utf8": "Gone,"
    } ]
  }, {
    "tStartMs": 85498,
    "dDurationMs": 1322,
    "segs": [ {
      "utf8": "every single month,"
    } ]
  }, {
    "tStartMs": 86820,
    "dDurationMs": 1883,
    "segs": [ {
      "utf8": "before you see a dime of it."
    } ]
  }, {
    "tStartMs": 89044,
    "dDurationMs": 3025,
    "segs": [ {
      "utf8": "Most people simply accept it as the price of having"
    } ]
  }, {
    "tStartMs": 92069,
    "dDurationMs": 421,
    "segs": [ {
      "utf8": "Medicare."
    } ]
  }, {
    "tStartMs": 92910,
    "dDurationMs": 1603,
    "segs": [ {
      "utf8": "But there are programs,"
    } ]
  }, {
    "tStartMs": 94513,
    "dDurationMs": 1723,
    "segs": [ {
      "utf8": "run by your own state,"
    } ]
  }, {
    "tStartMs": 96236,
    "dDurationMs": 3786,
    "segs": [ {
      "utf8": "whose entire purpose is to pay that premium for you."
    } ]
  }, {
    "tStartMs": 100503,
    "dDurationMs": 2053,
    "segs": [ {
      "utf8": "They are called the Medicare Savings Programs."
    } ]
  }, {
    "tStartMs": 103257,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "If your income is modest,"
    } ]
  }, {
    "tStartMs": 105721,
    "dDurationMs": 4007,
    "segs": [ {
      "utf8": "these programs cover your Part B premium completely and put"
    } ]
  }, {
    "tStartMs": 109728,
    "dDurationMs": 2784,
    "segs": [ {
      "utf8": "that two hundred dollars a month back into your check."
    } ]
  }, {
    "tStartMs": 113053,
    "dDurationMs": 4587,
    "segs": [ {
      "utf8": "That by itself is more than two thousand four hundred"
    } ]
  }, {
    "tStartMs": 117640,
    "dDurationMs": 782,
    "segs": [ {
      "utf8": "dollars a year handed back to you,"
    } ]
  }, {
    "tStartMs": 118802,
    "dDurationMs": 3386,
    "segs": [ {
      "utf8": "money you are giving away right now without realizing you"
    } ]
  }, {
    "tStartMs": 122188,
    "dDurationMs": 961,
    "segs": [ {
      "utf8": "might not owe it."
    } ]
  }, {
    "tStartMs": 123470,
    "dDurationMs": 1903,
    "segs": [ {
      "utf8": "And it does not stop there."
    } ]
  }, {
    "tStartMs": 125894,
    "dDurationMs": 2564,
    "segs": [ {
      "utf8": "The moment you are enrolled in one of those programs,"
    } ]
  }, {
    "tStartMs": 128458,
    "dDurationMs": 4207,
    "segs": [ {
      "utf8": "you are also signed up automatically for another benefit called"
    } ]
  }, {
    "tStartMs": 132665,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "Extra Help,"
    } ]
  }, {
    "tStartMs": 134267,
    "dDurationMs": 2264,
    "segs": [ {
      "utf8": "which cuts down what you pay for your prescriptions,"
    } ]
  }, {
    "tStartMs": 137092,
    "dDurationMs": 4307,
    "segs": [ {
      "utf8": "a benefit the government itself values at around five thousand"
    } ]
  }, {
    "tStartMs": 141399,
    "dDurationMs": 421,
    "segs": [ {
      "utf8": "seven hundred dollars a year."
    } ]
  }, {
    "tStartMs": 142741,
    "dDurationMs": 2845,
    "segs": [ {
      "utf8": "Put the premium and the drug help together and you"
    } ]
  }, {
    "tStartMs": 145586,
    "dDurationMs": 2604,
    "segs": [ {
      "utf8": "are looking at close to eight thousand dollars a year,"
    } ]
  }, {
    "tStartMs": 148190,
    "dDurationMs": 1663,
    "segs": [ {
      "utf8": "from a single application,"
    } ]
  }, {
    "tStartMs": 149853,
    "dDurationMs": 3505,
    "segs": [ {
      "utf8": "on programs that most of the people who qualify have"
    } ]
  }, {
    "tStartMs": 153358,
    "dDurationMs": 1883,
    "segs": [ {
      "utf8": "never once heard named out loud."
    } ]
  }, {
    "tStartMs": 156063,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "That is the most expensive secret in this entire video,"
    } ]
  }, {
    "tStartMs": 159609,
    "dDurationMs": 2864,
    "segs": [ {
      "utf8": "and it is sitting at the very top for a"
    } ]
  }, {
    "tStartMs": 162473,
    "dDurationMs": 321,
    "segs": [ {
      "utf8": "reason."
    } ]
  }, {
    "tStartMs": 163295,
    "dDurationMs": 2323,
    "segs": [ {
      "utf8": "Let me give you the rough lines so you know"
    } ]
  }, {
    "tStartMs": 165618,
    "dDurationMs": 942,
    "segs": [ {
      "utf8": "whether this is you."
    } ]
  }, {
    "tStartMs": 166981,
    "dDurationMs": 2944,
    "segs": [ {
      "utf8": "The most generous version is for a single person whose"
    } ]
  }, {
    "tStartMs": 169925,
    "dDurationMs": 4678,
    "segs": [ {
      "utf8": "monthly income is under about one thousand three hundred and"
    } ]
  }, {
    "tStartMs": 174603,
    "dDurationMs": 100,
    "segs": [ {
      "utf8": "fifty dollars,"
    } ]
  }, {
    "tStartMs": 174703,
    "dDurationMs": 1432,
    "segs": [ {
      "utf8": "and it does not just cover the premium,"
    } ]
  }, {
    "tStartMs": 176676,
    "dDurationMs": 3165,
    "segs": [ {
      "utf8": "it can cover your deductibles and your copays on top"
    } ]
  }, {
    "tStartMs": 179841,
    "dDurationMs": 561,
    "segs": [ {
      "utf8": "of it."
    } ]
  }, {
    "tStartMs": 180502,
    "dDurationMs": 1823,
    "segs": [ {
      "utf8": "If your income is a little higher,"
    } ]
  }, {
    "tStartMs": 182486,
    "dDurationMs": 2704,
    "segs": [ {
      "utf8": "up to about one thousand six hundred dollars a month,"
    } ]
  }, {
    "tStartMs": 185551,
    "dDurationMs": 2664,
    "segs": [ {
      "utf8": "there is still a version that wipes out that two"
    } ]
  }, {
    "tStartMs": 188215,
    "dDurationMs": 1883,
    "segs": [ {
      "utf8": "hundred dollar monthly premium entirely."
    } ]
  }, {
    "tStartMs": 190639,
    "dDurationMs": 2965,
    "segs": [ {
      "utf8": "These limits shift a little each year and they are"
    } ]
  }, {
    "tStartMs": 193604,
    "dDurationMs": 1482,
    "segs": [ {
      "utf8": "higher than most people assume,"
    } ]
  }, {
    "tStartMs": 195587,
    "dDurationMs": 2704,
    "segs": [ {
      "utf8": "so the mistake is talking yourself out of it before"
    } ]
  }, {
    "tStartMs": 198291,
    "dDurationMs": 1322,
    "segs": [ {
      "utf8": "you ever pick up the phone."
    } ]
  }, {
    "tStartMs": 200275,
    "dDurationMs": 3625,
    "segs": [ {
      "utf8": "You apply through your state Medicaid office or by calling"
    } ]
  }, {
    "tStartMs": 203900,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "Medicare directly,"
    } ]
  }, {
    "tStartMs": 205523,
    "dDurationMs": 2184,
    "segs": [ {
      "utf8": "and I will put the official number in the description"
    } ]
  }, {
    "tStartMs": 207707,
    "dDurationMs": 3746,
    "segs": [ {
      "utf8": "below so you reach the real program and nobody pretending"
    } ]
  }, {
    "tStartMs": 211453,
    "dDurationMs": 621,
    "segs": [ {
      "utf8": "to be it."
    } ]
  }, {
    "tStartMs": 213236,
    "dDurationMs": 2083,
    "segs": [ {
      "utf8": "The second one is your property tax,"
    } ]
  }, {
    "tStartMs": 215319,
    "dDurationMs": 2584,
    "segs": [ {
      "utf8": "and for a homeowner it is very often the single"
    } ]
  }, {
    "tStartMs": 217903,
    "dDurationMs": 1843,
    "segs": [ {
      "utf8": "largest bill you face all year."
    } ]
  }, {
    "tStartMs": 220447,
    "dDurationMs": 3226,
    "segs": [ {
      "utf8": "Nearly every state in this country gives people sixty five"
    } ]
  }, {
    "tStartMs": 223673,
    "dDurationMs": 2784,
    "segs": [ {
      "utf8": "and older a way to stop that bill from ever"
    } ]
  }, {
    "tStartMs": 226457,
    "dDurationMs": 781,
    "segs": [ {
      "utf8": "climbing again,"
    } ]
  }, {
    "tStartMs": 227238,
    "dDurationMs": 2865,
    "segs": [ {
      "utf8": "and in many places a way to wipe out a"
    } ]
  }, {
    "tStartMs": 230103,
    "dDurationMs": 1022,
    "segs": [ {
      "utf8": "large part of it."
    } ]
  }, {
    "tStartMs": 231125,
    "dDurationMs": 2924,
    "segs": [ {
      "utf8": "Some states offer what is called a senior freeze."
    } ]
  }, {
    "tStartMs": 234650,
    "dDurationMs": 1062,
    "segs": [ {
      "utf8": "The day you qualify,"
    } ]
  }, {
    "tStartMs": 236133,
    "dDurationMs": 2384,
    "segs": [ {
      "utf8": "the value your home is taxed on is locked in"
    } ]
  }, {
    "tStartMs": 238517,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "place,"
    } ]
  }, {
    "tStartMs": 239498,
    "dDurationMs": 2484,
    "segs": [ {
      "utf8": "so even as the homes around you keep rising in"
    } ]
  }, {
    "tStartMs": 241982,
    "dDurationMs": 2584,
    "segs": [ {
      "utf8": "value and your neighbors watch their bills grow,"
    } ]
  }, {
    "tStartMs": 245047,
    "dDurationMs": 2705,
    "segs": [ {
      "utf8": "yours stays frozen for the rest of the time you"
    } ]
  }, {
    "tStartMs": 247752,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "live there."
    } ]
  }, {
    "tStartMs": 248613,
    "dDurationMs": 3706,
    "segs": [ {
      "utf8": "Other states simply take a large slice off the taxable"
    } ]
  }, {
    "tStartMs": 252319,
    "dDurationMs": 1122,
    "segs": [ {
      "utf8": "value of your home,"
    } ]
  }, {
    "tStartMs": 253441,
    "dDurationMs": 3225,
    "segs": [ {
      "utf8": "or cap your tax at a small share of your"
    } ]
  }, {
    "tStartMs": 256666,
    "dDurationMs": 341,
    "segs": [ {
      "utf8": "income."
    } ]
  }, {
    "tStartMs": 257688,
    "dDurationMs": 3646,
    "segs": [ {
      "utf8": "In some places the savings run well over a thousand"
    } ]
  }, {
    "tStartMs": 261334,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "dollars a year,"
    } ]
  }, {
    "tStartMs": 262375,
    "dDurationMs": 1222,
    "segs": [ {
      "utf8": "every year,"
    } ]
  }, {
    "tStartMs": 263597,
    "dDurationMs": 2605,
    "segs": [ {
      "utf8": "for the rest of your life in that home,"
    } ]
  }, {
    "tStartMs": 266843,
    "dDurationMs": 2744,
    "segs": [ {
      "utf8": "which adds up to tens of thousands of dollars over"
    } ]
  }, {
    "tStartMs": 269587,
    "dDurationMs": 461,
    "segs": [ {
      "utf8": "time."
    } ]
  }, {
    "tStartMs": 270789,
    "dDurationMs": 1462,
    "segs": [ {
      "utf8": "But here is the catch,"
    } ]
  }, {
    "tStartMs": 272251,
    "dDurationMs": 1783,
    "segs": [ {
      "utf8": "and it is a cruel one,"
    } ]
  }, {
    "tStartMs": 274154,
    "dDurationMs": 1182,
    "segs": [ {
      "utf8": "so listen closely."
    } ]
  }, {
    "tStartMs": 275977,
    "dDurationMs": 2104,
    "segs": [ {
      "utf8": "This is almost never automatic."
    } ]
  }, {
    "tStartMs": 278702,
    "dDurationMs": 1843,
    "segs": [ {
      "utf8": "You have to file for it,"
    } ]
  }, {
    "tStartMs": 280545,
    "dDurationMs": 2844,
    "segs": [ {
      "utf8": "usually in the year you turn the qualifying age,"
    } ]
  }, {
    "tStartMs": 283389,
    "dDurationMs": 1743,
    "segs": [ {
      "utf8": "and if you miss that window,"
    } ]
  }, {
    "tStartMs": 285132,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "that year is gone,"
    } ]
  }, {
    "tStartMs": 286715,
    "dDurationMs": 2384,
    "segs": [ {
      "utf8": "and most states will not give it back."
    } ]
  }, {
    "tStartMs": 289099,
    "dDurationMs": 3746,
    "segs": [ {
      "utf8": "And the savings are real money in real places."
    } ]
  }, {
    "tStartMs": 293987,
    "dDurationMs": 3626,
    "segs": [ {
      "utf8": "In Texas the school tax freeze alone can save a"
    } ]
  }, {
    "tStartMs": 297613,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "homeowner thousands of dollars and it does not even have"
    } ]
  }, {
    "tStartMs": 300657,
    "dDurationMs": 762,
    "segs": [ {
      "utf8": "an income limit,"
    } ]
  }, {
    "tStartMs": 301839,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "your age is enough."
    } ]
  }, {
    "tStartMs": 303963,
    "dDurationMs": 3185,
    "segs": [ {
      "utf8": "In several states there is an exemption that simply knocks"
    } ]
  }, {
    "tStartMs": 307148,
    "dDurationMs": 2945,
    "segs": [ {
      "utf8": "a large fixed amount off the value your home is"
    } ]
  }, {
    "tStartMs": 310093,
    "dDurationMs": 2884,
    "segs": [ {
      "utf8": "taxed on before the rate is ever applied."
    } ]
  }, {
    "tStartMs": 312977,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "The exact program depends on your state and your county,"
    } ]
  }, {
    "tStartMs": 317144,
    "dDurationMs": 2645,
    "segs": [ {
      "utf8": "but the pattern is always the same."
    } ]
  }, {
    "tStartMs": 320410,
    "dDurationMs": 861,
    "segs": [ {
      "utf8": "There is an age,"
    } ]
  }, {
    "tStartMs": 321271,
    "dDurationMs": 2324,
    "segs": [ {
      "utf8": "usually sixty or sixty five."
    } ]
  }, {
    "tStartMs": 324216,
    "dDurationMs": 3345,
    "segs": [ {
      "utf8": "There is sometimes an income limit and sometimes none at"
    } ]
  }, {
    "tStartMs": 327561,
    "dDurationMs": 341,
    "segs": [ {
      "utf8": "all."
    } ]
  }, {
    "tStartMs": 327902,
    "dDurationMs": 3525,
    "segs": [ {
      "utf8": "And in every single case you have to file for"
    } ]
  }, {
    "tStartMs": 331427,
    "dDurationMs": 662,
    "segs": [ {
      "utf8": "it yourself,"
    } ]
  }, {
    "tStartMs": 332089,
    "dDurationMs": 3565,
    "segs": [ {
      "utf8": "because your county does not look at your birthday and"
    } ]
  }, {
    "tStartMs": 335654,
    "dDurationMs": 2484,
    "segs": [ {
      "utf8": "quietly lower your bill out of kindness."
    } ]
  }, {
    "tStartMs": 339080,
    "dDurationMs": 3005,
    "segs": [ {
      "utf8": "Every dollar of relief they give you is a dollar"
    } ]
  }, {
    "tStartMs": 342085,
    "dDurationMs": 1382,
    "segs": [ {
      "utf8": "of revenue they lose,"
    } ]
  }, {
    "tStartMs": 343467,
    "dDurationMs": 3065,
    "segs": [ {
      "utf8": "so they have no reason to come find you."
    } ]
  }, {
    "tStartMs": 347153,
    "dDurationMs": 2264,
    "segs": [ {
      "utf8": "One phone call to your county assessor,"
    } ]
  }, {
    "tStartMs": 349417,
    "dDurationMs": 3165,
    "segs": [ {
      "utf8": "asking what the over sixty five exemption is and how"
    } ]
  }, {
    "tStartMs": 352582,
    "dDurationMs": 1122,
    "segs": [ {
      "utf8": "to file for it,"
    } ]
  }, {
    "tStartMs": 353704,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "can freeze or shrink the biggest bill you pay all"
    } ]
  }, {
    "tStartMs": 357470,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "year."
    } ]
  }, {
    "tStartMs": 358792,
    "dDurationMs": 2885,
    "segs": [ {
      "utf8": "The third one is your federal income tax,"
    } ]
  }, {
    "tStartMs": 361677,
    "dDurationMs": 3085,
    "segs": [ {
      "utf8": "and this is the one that surprises people the most,"
    } ]
  }, {
    "tStartMs": 364762,
    "dDurationMs": 3024,
    "segs": [ {
      "utf8": "because there is a deep belief in this country that"
    } ]
  }, {
    "tStartMs": 367786,
    "dDurationMs": 3486,
    "segs": [ {
      "utf8": "everyone owes the government something every April no matter what."
    } ]
  }, {
    "tStartMs": 371272,
    "dDurationMs": 3626,
    "segs": [ {
      "utf8": "But for a great many older Americans living on Social"
    } ]
  }, {
    "tStartMs": 374898,
    "dDurationMs": 2484,
    "segs": [ {
      "utf8": "Security and a modest amount on top,"
    } ]
  }, {
    "tStartMs": 377382,
    "dDurationMs": 2704,
    "segs": [ {
      "utf8": "the correct amount owed is zero."
    } ]
  }, {
    "tStartMs": 380727,
    "dDurationMs": 3256,
    "segs": [ {
      "utf8": "The standard deduction grows larger the year you turn sixty"
    } ]
  }, {
    "tStartMs": 383983,
    "dDurationMs": 711,
    "segs": [ {
      "utf8": "five."
    } ]
  }, {
    "tStartMs": 384694,
    "dDurationMs": 3205,
    "segs": [ {
      "utf8": "And starting with the twenty twenty five tax year,"
    } ]
  }, {
    "tStartMs": 387899,
    "dDurationMs": 3346,
    "segs": [ {
      "utf8": "there is now a new bonus deduction worth up to"
    } ]
  }, {
    "tStartMs": 391245,
    "dDurationMs": 2343,
    "segs": [ {
      "utf8": "six thousand dollars for a single person,"
    } ]
  }, {
    "tStartMs": 393588,
    "dDurationMs": 3246,
    "segs": [ {
      "utf8": "and up to twelve thousand dollars for a married couple"
    } ]
  }, {
    "tStartMs": 396834,
    "dDurationMs": 1843,
    "segs": [ {
      "utf8": "where both have turned sixty five."
    } ]
  }, {
    "tStartMs": 399518,
    "dDurationMs": 3426,
    "segs": [ {
      "utf8": "Stack those together and a large share of seniors can"
    } ]
  }, {
    "tStartMs": 402944,
    "dDurationMs": 3345,
    "segs": [ {
      "utf8": "legally bring their federal income tax all the way down"
    } ]
  }, {
    "tStartMs": 406289,
    "dDurationMs": 521,
    "segs": [ {
      "utf8": "to nothing."
    } ]
  }, {
    "tStartMs": 406810,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "And here is the cruel twist on this one,"
    } ]
  }, {
    "tStartMs": 409855,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "because the bill is not just hidden,"
    } ]
  }, {
    "tStartMs": 411898,
    "dDurationMs": 1282,
    "segs": [ {
      "utf8": "it is reversed."
    } ]
  }, {
    "tStartMs": 413901,
    "dDurationMs": 2064,
    "segs": [ {
      "utf8": "The law is not asking you for money."
    } ]
  }, {
    "tStartMs": 415965,
    "dDurationMs": 2464,
    "segs": [ {
      "utf8": "The law is telling you to keep it."
    } ]
  }, {
    "tStartMs": 418429,
    "dDurationMs": 3405,
    "segs": [ {
      "utf8": "But unless your return is filled out with those age"
    } ]
  }, {
    "tStartMs": 421834,
    "dDurationMs": 2324,
    "segs": [ {
      "utf8": "sixty five deductions correctly applied,"
    } ]
  }, {
    "tStartMs": 424158,
    "dDurationMs": 3506,
    "segs": [ {
      "utf8": "the form quietly defaults to the ordinary amount,"
    } ]
  }, {
    "tStartMs": 427664,
    "dDurationMs": 2744,
    "segs": [ {
      "utf8": "and you end up paying a tax you do not"
    } ]
  }, {
    "tStartMs": 430408,
    "dDurationMs": 2664,
    "segs": [ {
      "utf8": "owe to a government that never asked for it."
    } ]
  }, {
    "tStartMs": 433814,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "If someone prepares your taxes,"
    } ]
  }, {
    "tStartMs": 435216,
    "dDurationMs": 3325,
    "segs": [ {
      "utf8": "the single most valuable question you can ask this year"
    } ]
  }, {
    "tStartMs": 438541,
    "dDurationMs": 3786,
    "segs": [ {
      "utf8": "is whether your full age sixty five deductions were applied."
    } ]
  }, {
    "tStartMs": 442848,
    "dDurationMs": 2104,
    "segs": [ {
      "utf8": "You have every right to that answer."
    } ]
  }, {
    "tStartMs": 444952,
    "dDurationMs": 4126,
    "segs": [ {
      "utf8": "And there is an urgency to this one that most"
    } ]
  }, {
    "tStartMs": 449078,
    "dDurationMs": 882,
    "segs": [ {
      "utf8": "people miss."
    } ]
  }, {
    "tStartMs": 450601,
    "dDurationMs": 1843,
    "segs": [ {
      "utf8": "As the law is written right now,"
    } ]
  }, {
    "tStartMs": 452444,
    "dDurationMs": 4026,
    "segs": [ {
      "utf8": "that six thousand dollar bonus deduction only exists for four"
    } ]
  }, {
    "tStartMs": 456470,
    "dDurationMs": 1122,
    "segs": [ {
      "utf8": "tax years,"
    } ]
  }, {
    "tStartMs": 457592,
    "dDurationMs": 3135,
    "segs": [ {
      "utf8": "twenty twenty five through twenty twenty eight,"
    } ]
  }, {
    "tStartMs": 460727,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "unless Congress extends it."
    } ]
  }, {
    "tStartMs": 462500,
    "dDurationMs": 3185,
    "segs": [ {
      "utf8": "So this is a claim it every single year while"
    } ]
  }, {
    "tStartMs": 465685,
    "dDurationMs": 1182,
    "segs": [ {
      "utf8": "it lasts situation,"
    } ]
  }, {
    "tStartMs": 466867,
    "dDurationMs": 1603,
    "segs": [ {
      "utf8": "not a someday thing."
    } ]
  }, {
    "tStartMs": 468470,
    "dDurationMs": 3746,
    "segs": [ {
      "utf8": "There is also a quieter version of this same mistake."
    } ]
  }, {
    "tStartMs": 472216,
    "dDurationMs": 1182,
    "segs": [ {
      "utf8": "Many people,"
    } ]
  }, {
    "tStartMs": 473398,
    "dDurationMs": 2624,
    "segs": [ {
      "utf8": "when they first started Social Security,"
    } ]
  }, {
    "tStartMs": 476022,
    "dDurationMs": 3265,
    "segs": [ {
      "utf8": "told the government to hold back federal tax from every"
    } ]
  }, {
    "tStartMs": 479287,
    "dDurationMs": 2084,
    "segs": [ {
      "utf8": "monthly check just to be safe,"
    } ]
  }, {
    "tStartMs": 481371,
    "dDurationMs": 2404,
    "segs": [ {
      "utf8": "and then a chunk of it comes back as a"
    } ]
  }, {
    "tStartMs": 483775,
    "dDurationMs": 1662,
    "segs": [ {
      "utf8": "refund the following year."
    } ]
  }, {
    "tStartMs": 485437,
    "dDurationMs": 2364,
    "segs": [ {
      "utf8": "Think about what that means."
    } ]
  }, {
    "tStartMs": 487801,
    "dDurationMs": 3386,
    "segs": [ {
      "utf8": "You are letting the government hold your money for free"
    } ]
  }, {
    "tStartMs": 491187,
    "dDurationMs": 2904,
    "segs": [ {
      "utf8": "all year long on a tax you may not even"
    } ]
  }, {
    "tStartMs": 494091,
    "dDurationMs": 301,
    "segs": [ {
      "utf8": "owe."
    } ]
  }, {
    "tStartMs": 494392,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "If that is you,"
    } ]
  }, {
    "tStartMs": 496255,
    "dDurationMs": 2905,
    "segs": [ {
      "utf8": "the fix is to look at your real numbers and"
    } ]
  }, {
    "tStartMs": 499160,
    "dDurationMs": 3385,
    "segs": [ {
      "utf8": "adjust that withholding so it matches what you actually owe,"
    } ]
  }, {
    "tStartMs": 502545,
    "dDurationMs": 1843,
    "segs": [ {
      "utf8": "and not a dollar more."
    } ]
  }, {
    "tStartMs": 504388,
    "dDurationMs": 2725,
    "segs": [ {
      "utf8": "The fourth one is what you hand over at the"
    } ]
  }, {
    "tStartMs": 507113,
    "dDurationMs": 480,
    "segs": [ {
      "utf8": "pharmacy."
    } ]
  }, {
    "tStartMs": 507593,
    "dDurationMs": 3346,
    "segs": [ {
      "utf8": "If you did not qualify for the Medicare Savings Program"
    } ]
  }, {
    "tStartMs": 510939,
    "dDurationMs": 1122,
    "segs": [ {
      "utf8": "I mentioned earlier,"
    } ]
  }, {
    "tStartMs": 512061,
    "dDurationMs": 3385,
    "segs": [ {
      "utf8": "you can still apply directly for that Extra Help benefit"
    } ]
  }, {
    "tStartMs": 515446,
    "dDurationMs": 1442,
    "segs": [ {
      "utf8": "through Social Security,"
    } ]
  }, {
    "tStartMs": 516888,
    "dDurationMs": 1182,
    "segs": [ {
      "utf8": "all on its own."
    } ]
  }, {
    "tStartMs": 518070,
    "dDurationMs": 2925,
    "segs": [ {
      "utf8": "It lowers what you pay for your medications,"
    } ]
  }, {
    "tStartMs": 520995,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "your pharmacy copays,"
    } ]
  }, {
    "tStartMs": 522798,
    "dDurationMs": 2164,
    "segs": [ {
      "utf8": "and the premium on your drug plan."
    } ]
  }, {
    "tStartMs": 524962,
    "dDurationMs": 3165,
    "segs": [ {
      "utf8": "For someone who takes several prescriptions a month,"
    } ]
  }, {
    "tStartMs": 528127,
    "dDurationMs": 3746,
    "segs": [ {
      "utf8": "that is the difference between rationing your pills and actually"
    } ]
  }, {
    "tStartMs": 531873,
    "dDurationMs": 621,
    "segs": [ {
      "utf8": "filling them."
    } ]
  }, {
    "tStartMs": 532494,
    "dDurationMs": 3205,
    "segs": [ {
      "utf8": "And nobody should be cutting tablets in half to save"
    } ]
  }, {
    "tStartMs": 535699,
    "dDurationMs": 3486,
    "segs": [ {
      "utf8": "money while a benefit worth thousands of dollars a year"
    } ]
  }, {
    "tStartMs": 539185,
    "dDurationMs": 1803,
    "segs": [ {
      "utf8": "sits there with their name on it,"
    } ]
  }, {
    "tStartMs": 540988,
    "dDurationMs": 1742,
    "segs": [ {
      "utf8": "waiting on nothing but a form."
    } ]
  }, {
    "tStartMs": 542730,
    "dDurationMs": 3887,
    "segs": [ {
      "utf8": "The fifth one is a bill you pay every month"
    } ]
  }, {
    "tStartMs": 546617,
    "dDurationMs": 2263,
    "segs": [ {
      "utf8": "and have probably never once questioned,"
    } ]
  }, {
    "tStartMs": 548880,
    "dDurationMs": 2745,
    "segs": [ {
      "utf8": "and that is your phone and your internet."
    } ]
  }, {
    "tStartMs": 551625,
    "dDurationMs": 5028,
    "segs": [ {
      "utf8": "There is a long standing federal program called Lifeline that"
    } ]
  }, {
    "tStartMs": 556653,
    "dDurationMs": 3626,
    "segs": [ {
      "utf8": "places a monthly discount on phone or internet service for"
    } ]
  }, {
    "tStartMs": 560279,
    "dDurationMs": 1322,
    "segs": [ {
      "utf8": "people with a modest income,"
    } ]
  }, {
    "tStartMs": 561601,
    "dDurationMs": 4227,
    "segs": [ {
      "utf8": "or for anyone already enrolled in certain assistance programs."
    } ]
  }, {
    "tStartMs": 565828,
    "dDurationMs": 2464,
    "segs": [ {
      "utf8": "It will not erase the whole bill,"
    } ]
  }, {
    "tStartMs": 568292,
    "dDurationMs": 3225,
    "segs": [ {
      "utf8": "but it takes a set amount off every month,"
    } ]
  }, {
    "tStartMs": 571517,
    "dDurationMs": 1162,
    "segs": [ {
      "utf8": "month after month,"
    } ]
  }, {
    "tStartMs": 572679,
    "dDurationMs": 2805,
    "segs": [ {
      "utf8": "on a service you were going to pay for no"
    } ]
  }, {
    "tStartMs": 575484,
    "dDurationMs": 861,
    "segs": [ {
      "utf8": "matter what."
    } ]
  }, {
    "tStartMs": 576345,
    "dDurationMs": 3486,
    "segs": [ {
      "utf8": "For someone counting every dollar on a fixed income,"
    } ]
  }, {
    "tStartMs": 579831,
    "dDurationMs": 3445,
    "segs": [ {
      "utf8": "a steady discount on a bill that never goes away"
    } ]
  }, {
    "tStartMs": 583276,
    "dDurationMs": 2344,
    "segs": [ {
      "utf8": "adds up quietly across the years."
    } ]
  }, {
    "tStartMs": 585620,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "You apply through the official Lifeline system,"
    } ]
  }, {
    "tStartMs": 588665,
    "dDurationMs": 3165,
    "segs": [ {
      "utf8": "and then you bring that benefit to a participating phone"
    } ]
  }, {
    "tStartMs": 591830,
    "dDurationMs": 1282,
    "segs": [ {
      "utf8": "or internet company."
    } ]
  }, {
    "tStartMs": 593112,
    "dDurationMs": 4027,
    "segs": [ {
      "utf8": "Now step back and look at what all five of"
    } ]
  }, {
    "tStartMs": 597139,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "these share,"
    } ]
  }, {
    "tStartMs": 597840,
    "dDurationMs": 3626,
    "segs": [ {
      "utf8": "because it is the whole reason they stay hidden in"
    } ]
  }, {
    "tStartMs": 601466,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "plain sight."
    } ]
  }, {
    "tStartMs": 602948,
    "dDurationMs": 2644,
    "segs": [ {
      "utf8": "Not one of them switches itself off."
    } ]
  }, {
    "tStartMs": 605592,
    "dDurationMs": 4528,
    "segs": [ {
      "utf8": "The program that pays your Medicare premium waits in silence"
    } ]
  }, {
    "tStartMs": 610120,
    "dDurationMs": 1422,
    "segs": [ {
      "utf8": "until you apply."
    } ]
  }, {
    "tStartMs": 611542,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "The property tax freeze waits until you file."
    } ]
  }, {
    "tStartMs": 615509,
    "dDurationMs": 4026,
    "segs": [ {
      "utf8": "The deductions that zero out your tax bill only work"
    } ]
  }, {
    "tStartMs": 619535,
    "dDurationMs": 1603,
    "segs": [ {
      "utf8": "if the return is done right."
    } ]
  }, {
    "tStartMs": 621138,
    "dDurationMs": 3565,
    "segs": [ {
      "utf8": "The drug help and the phone discount both sit there"
    } ]
  }, {
    "tStartMs": 624703,
    "dDurationMs": 3486,
    "segs": [ {
      "utf8": "completely untouched until you reach out and claim them."
    } ]
  }, {
    "tStartMs": 628189,
    "dDurationMs": 3025,
    "segs": [ {
      "utf8": "Every single one of these was written into the law"
    } ]
  }, {
    "tStartMs": 631214,
    "dDurationMs": 821,
    "segs": [ {
      "utf8": "to help you,"
    } ]
  }, {
    "tStartMs": 632035,
    "dDurationMs": 3386,
    "segs": [ {
      "utf8": "and every single one was wrapped in just enough paperwork"
    } ]
  }, {
    "tStartMs": 635421,
    "dDurationMs": 3445,
    "segs": [ {
      "utf8": "that most people give up partway through or never start"
    } ]
  }, {
    "tStartMs": 638866,
    "dDurationMs": 621,
    "segs": [ {
      "utf8": "at all."
    } ]
  }, {
    "tStartMs": 639487,
    "dDurationMs": 2805,
    "segs": [ {
      "utf8": "The system is not exactly lying to you."
    } ]
  }, {
    "tStartMs": 642292,
    "dDurationMs": 3085,
    "segs": [ {
      "utf8": "It is simply built on the quiet hope that you"
    } ]
  }, {
    "tStartMs": 645377,
    "dDurationMs": 2184,
    "segs": [ {
      "utf8": "will stay silent and keep paying."
    } ]
  }, {
    "tStartMs": 648422,
    "dDurationMs": 3085,
    "segs": [ {
      "utf8": "So here is the only thing I am asking of"
    } ]
  }, {
    "tStartMs": 651507,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "you."
    } ]
  }, {
    "tStartMs": 652208,
    "dDurationMs": 3185,
    "segs": [ {
      "utf8": "Pick the biggest one for your life and chase it"
    } ]
  }, {
    "tStartMs": 655393,
    "dDurationMs": 982,
    "segs": [ {
      "utf8": "down this week."
    } ]
  }, {
    "tStartMs": 656375,
    "dDurationMs": 3165,
    "segs": [ {
      "utf8": "If Medicare comes out of your check every month,"
    } ]
  }, {
    "tStartMs": 659540,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "call your state about the Medicare Savings Program first,"
    } ]
  }, {
    "tStartMs": 663086,
    "dDurationMs": 2824,
    "segs": [ {
      "utf8": "because that is the eight thousand dollar door."
    } ]
  }, {
    "tStartMs": 665910,
    "dDurationMs": 1483,
    "segs": [ {
      "utf8": "If you own your home,"
    } ]
  }, {
    "tStartMs": 667393,
    "dDurationMs": 2604,
    "segs": [ {
      "utf8": "call the county about the property tax freeze."
    } ]
  }, {
    "tStartMs": 669997,
    "dDurationMs": 2083,
    "segs": [ {
      "utf8": "If you file a tax return,"
    } ]
  }, {
    "tStartMs": 672080,
    "dDurationMs": 3426,
    "segs": [ {
      "utf8": "make sure the age sixty five deductions are actually on"
    } ]
  }, {
    "tStartMs": 675506,
    "dDurationMs": 280,
    "segs": [ {
      "utf8": "it."
    } ]
  }, {
    "tStartMs": 675786,
    "dDurationMs": 3005,
    "segs": [ {
      "utf8": "You do not have to do all five at once"
    } ]
  }, {
    "tStartMs": 678791,
    "dDurationMs": 1423,
    "segs": [ {
      "utf8": "and wear yourself out."
    } ]
  }, {
    "tStartMs": 680214,
    "dDurationMs": 2804,
    "segs": [ {
      "utf8": "You only have to open one of those doors,"
    } ]
  }, {
    "tStartMs": 683018,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "because the money waiting behind it has belonged to you"
    } ]
  }, {
    "tStartMs": 686604,
    "dDurationMs": 961,
    "segs": [ {
      "utf8": "the whole time."
    } ]
  }, {
    "tStartMs": 687565,
    "dDurationMs": 1964,
    "segs": [ {
      "utf8": "And before you go,"
    } ]
  }, {
    "tStartMs": 689529,
    "dDurationMs": 3405,
    "segs": [ {
      "utf8": "think of one person who would never believe any of"
    } ]
  }, {
    "tStartMs": 692934,
    "dDurationMs": 761,
    "segs": [ {
      "utf8": "this is real."
    } ]
  }, {
    "tStartMs": 693695,
    "dDurationMs": 1423,
    "segs": [ {
      "utf8": "Someone careful,"
    } ]
  }, {
    "tStartMs": 695118,
    "dDurationMs": 1222,
    "segs": [ {
      "utf8": "someone proud,"
    } ]
  }, {
    "tStartMs": 696340,
    "dDurationMs": 2684,
    "segs": [ {
      "utf8": "who has been paying every one of these bills in"
    } ]
  }, {
    "tStartMs": 699024,
    "dDurationMs": 3846,
    "segs": [ {
      "utf8": "full for years simply because nobody ever told them they"
    } ]
  }, {
    "tStartMs": 702870,
    "dDurationMs": 1322,
    "segs": [ {
      "utf8": "did not have to."
    } ]
  }, {
    "tStartMs": 704192,
    "dDurationMs": 1563,
    "segs": [ {
      "utf8": "Send this to them today."
    } ]
  }, {
    "tStartMs": 705755,
    "dDurationMs": 3165,
    "segs": [ {
      "utf8": "There are very few things you can hand another person"
    } ]
  }, {
    "tStartMs": 708920,
    "dDurationMs": 3426,
    "segs": [ {
      "utf8": "that put real money back in their pocket every single"
    } ]
  }, {
    "tStartMs": 712346,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "month for the rest of their life."
    } ]
  }, {
    "tStartMs": 714048,
    "dDurationMs": 1863,
    "segs": [ {
      "utf8": "This is one of them."
    } ]
  }, {
    "tStartMs": 715911,
    "dDurationMs": 1283,
    "segs": [ {
      "utf8": "So go on,"
    } ]
  }, {
    "tStartMs": 717194,
    "dDurationMs": 1802,
    "segs": [ {
      "utf8": "and claim what was already yours."
    } ]
