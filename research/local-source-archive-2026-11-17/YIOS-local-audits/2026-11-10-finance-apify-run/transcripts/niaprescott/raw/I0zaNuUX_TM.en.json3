{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "One thing decides how hard all four of\nthese are going to be."
    } ]
  }, {
    "tStartMs": 4560,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Not your age. Not your bank. Whether you\ncan get into one website."
    } ]
  }, {
    "tStartMs": 9860,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "If you can, this is ten minutes at your\nown kitchen table."
    } ]
  }, {
    "tStartMs": 13860,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "If you cannot, the same job now means\nfinding the office, getting to it, and"
    } ]
  }, {
    "tStartMs": 18960,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "standing in it. Nobody wrote to tell you\nthat."
    } ]
  }, {
    "tStartMs": 22480,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "The rule changed in April of last year,\nand the people who found out were the"
    } ]
  }, {
    "tStartMs": 26940,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "ones who tried to change something and\nwere turned away at the counter."
    } ]
  }, {
    "tStartMs": 30860,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "Four things. The one that traps people is\nlast."
    } ]
  }, {
    "tStartMs": 34640,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Before any of it, who it lands on."
    } ]
  }, {
    "tStartMs": 37400,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "If a payment from Social Security arrives\nin an account every month, all four"
    } ]
  }, {
    "tStartMs": 42000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of these are yours."
    } ]
  }, {
    "tStartMs": 43620,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "Not one of them has an income test, not\none asks what you own, and the size"
    } ]
  }, {
    "tStartMs": 48540,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "of the payment changes nothing about which\nrule you fall under."
    } ]
  }, {
    "tStartMs": 52780,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Two names, said once. The payment is\nSocial Security."
    } ]
  }, {
    "tStartMs": 56700,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "The website where you handle it is called\nmy Social Security, and it is free."
    } ]
  }, {
    "tStartMs": 62720,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Number one. If you cannot log in, you go\nto the office."
    } ]
  }, {
    "tStartMs": 66900,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "For most of the last twenty years, moving\nyour payment to a different account"
    } ]
  }, {
    "tStartMs": 70880,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "was a telephone call. You rang, you gave\nthe new numbers, you waited."
    } ]
  }, {
    "tStartMs": 76460,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "That door is closed. Since the middle of\nApril last year, a person who cannot"
    } ]
  }, {
    "tStartMs": 81460,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "use the website has to prove who they are\nin person before that change will"
    } ]
  }, {
    "tStartMs": 86140,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "be made. Not by post. Not over the\ntelephone."
    } ]
  }, {
    "tStartMs": 90040,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "In the building, with identification, in\nfront of somebody."
    } ]
  }, {
    "tStartMs": 94180,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Now think about who that actually lands\non."
    } ]
  }, {
    "tStartMs": 96660,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "A man of eighty one who has never owned a\ncomputer."
    } ]
  }, {
    "tStartMs": 99980,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "A widow whose husband handled every form\nin the house for fifty years and who"
    } ]
  }, {
    "tStartMs": 104580,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "has never once logged in anywhere."
    } ]
  }, {
    "tStartMs": 106900,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "Somebody whose nearest office is sixty\nmiles away and who stopped driving after"
    } ]
  }, {
    "tStartMs": 111880,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "the second fall. The people least able to\nuse the website are, almost without"
    } ]
  }, {
    "tStartMs": 117200,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "exception, the same people least able to\nget themselves to the building, and"
    } ]
  }, {
    "tStartMs": 122020,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that overlap is not an accident that\nsomebody failed to notice."
    } ]
  }, {
    "tStartMs": 125740,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "It is the shape of the rule itself."
    } ]
  }, {
    "tStartMs": 128920,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "A person comfortable enough with a\ncomputer to log in was never going to need"
    } ]
  }, {
    "tStartMs": 133580,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "the counter in the first place."
    } ]
  }, {
    "tStartMs": 135680,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "And there is a quieter version of the same\ntrap."
    } ]
  }, {
    "tStartMs": 138360,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "A woman named Rosa, seventy four,"
    } ]
  }, {
    "tStartMs": 141840,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "had an account at a bank that was\nswallowed in a merger."
    } ]
  }, {
    "tStartMs": 145060,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Her old account number stopped existing."
    } ]
  }, {
    "tStartMs": 147580,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "She did not do anything wrong and she\nnever ignored a letter."
    } ]
  }, {
    "tStartMs": 151420,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "But the payment had nowhere to land, and\nthe one way to fix it fast was the"
    } ]
  }, {
    "tStartMs": 156220,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "website she had never set up."
    } ]
  }, {
    "tStartMs": 158620,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "So here is the thing to do, and do it\nbefore anything goes wrong."
    } ]
  }, {
    "tStartMs": 162980,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Set the account up now, while nothing is\nurgent."
    } ]
  }, {
    "tStartMs": 165660,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "It is free, it takes about twenty minutes,\nand the whole point of doing it"
    } ]
  }, {
    "tStartMs": 170240,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "today is so you never have to find the\noffice on the worst week of your life."
    } ]
  }, {
    "tStartMs": 175540,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Number two. Medicare, disability and SSI\nnever have to."
    } ]
  }, {
    "tStartMs": 181040,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Here is the part almost nobody knows."
    } ]
  }, {
    "tStartMs": 183380,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "The in person rule does not fall on\neverybody."
    } ]
  }, {
    "tStartMs": 187060,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Three groups are carved out of it\ncompletely."
    } ]
  }, {
    "tStartMs": 189820,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "If you are claiming Medicare, you are\nexempt."
    } ]
  }, {
    "tStartMs": 192320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "If you are claiming disability, you are\nexempt."
    } ]
  }, {
    "tStartMs": 196080,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "If you are claiming SSI, the payment for\npeople with very little, you are exempt."
    } ]
  }, {
    "tStartMs": 201280,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "Retirement is not exempt. Survivors\nbenefits are not exempt."
    } ]
  }, {
    "tStartMs": 205920,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "A payment on a record of a husband or a\nwife is not exempt."
    } ]
  }, {
    "tStartMs": 209620,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "A payment for a child is not exempt."
    } ]
  }, {
    "tStartMs": 212520,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Read that again, because it decides which\ndoor you walk through."
    } ]
  }, {
    "tStartMs": 216220,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Two people in the same house can get two\ndifferent answers."
    } ]
  }, {
    "tStartMs": 218860,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "A husband on retirement and a wife on\ndisability are standing on opposite sides"
    } ]
  }, {
    "tStartMs": 224240,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "of this rule, in the same kitchen, and\nneither of them has been told."
    } ]
  }, {
    "tStartMs": 228900,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Why that carve out exists is simple enough\nonce somebody explains it, which"
    } ]
  }, {
    "tStartMs": 233220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "nobody does."
    } ]
  }, {
    "tStartMs": 234820,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Those three have other points in the\nprocess where the identity of the person"
    } ]
  }, {
    "tStartMs": 238660,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "is examined anyway, so an extra check at\nthe counter adds nothing that the"
    } ]
  }, {
    "tStartMs": 242820,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "file does not already contain."
    } ]
  }, {
    "tStartMs": 244320,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "That is the entire reason, and it is worth\nbeing clear that it is an administrative"
    } ]
  }, {
    "tStartMs": 249440,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "convenience rather than a kindness\nextended to anybody."
    } ]
  }, {
    "tStartMs": 253520,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "What to do with it. Before you set out for\nany office, find out which of those"
    } ]
  }, {
    "tStartMs": 258140,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "four words describes your own payment."
    } ]
  }, {
    "tStartMs": 261060,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Retirement. Survivors. Disability."
    } ]
  }, {
    "tStartMs": 264200,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Supplemental. If it is one of the last\ntwo, you may not need the trip at all."
    } ]
  }, {
    "tStartMs": 269200,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Number three. They said the thirty day\nwait is gone."
    } ]
  }, {
    "tStartMs": 272200,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "It is not. I have watched a number of\nchannels this month tell older people"
    } ]
  }, {
    "tStartMs": 276380,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "that the thirty day hold on changing your\ndeposit has been removed, and that"
    } ]
  }, {
    "tStartMs": 280360,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "a change now goes through in a single day."
    } ]
  }, {
    "tStartMs": 283260,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "That is half a fact, and the half they\ndropped is the half that protects you."
    } ]
  }, {
    "tStartMs": 287840,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Here is what is true. Requests made in\nperson or on the telephone are now handled"
    } ]
  }, {
    "tStartMs": 292220,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "far faster than they used to be."
    } ]
  }, {
    "tStartMs": 294140,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "And the Treasury now checks the\ndestination bank account almost instantly,"
    } ]
  }, {
    "tStartMs": 298340,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "which it never used to do. Here is what\nthey left out."
    } ]
  }, {
    "tStartMs": 301220,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "A change made online, through your own\naccount, is still held for thirty days."
    } ]
  }, {
    "tStartMs": 306700,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "That hold is not a nuisance and it was\nnever meant to be convenient."
    } ]
  }, {
    "tStartMs": 310520,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "It is a wall, and it is the stretch of\ntime in which a change that nobody in"
    } ]
  }, {
    "tStartMs": 314680,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "the household authorised can be spotted\nand stopped before one dollar actually"
    } ]
  }, {
    "tStartMs": 319240,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "moves anywhere. Take that wall out of the\nmind of a person and you have taught"
    } ]
  }, {
    "tStartMs": 323500,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "them not to expect it, which is worth more\nto a thief than any single password."
    } ]
  }, {
    "tStartMs": 328620,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "So when a voice on the telephone tells you\na change can be done today, understand"
    } ]
  }, {
    "tStartMs": 333080,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "what that sentence is doing. It is not\ndescribing the system."
    } ]
  }, {
    "tStartMs": 337020,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It is describing what the caller needs you\nto believe."
    } ]
  }, {
    "tStartMs": 340140,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "And remember which direction the real\nagency works in."
    } ]
  }, {
    "tStartMs": 343420,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "It confirms identity sensitive changes by\npost."
    } ]
  }, {
    "tStartMs": 346560,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "It does not telephone you asking for a\nrouting number."
    } ]
  }, {
    "tStartMs": 349560,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "It does not text. It does not email asking\nfor account details to keep your"
    } ]
  }, {
    "tStartMs": 354320,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "payment safe. Number four. If you cannot\ngo, one phone number fixes it."
    } ]
  }, {
    "tStartMs": 360020,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Here is the one. Everything above assumes\nyou can get to the building if you"
    } ]
  }, {
    "tStartMs": 363900,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "have to. For some people that is simply\nnot true, and it is not a small group."
    } ]
  }, {
    "tStartMs": 368940,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "Somebody in a care home. Somebody who\ncannot be left alone."
    } ]
  }, {
    "tStartMs": 372820,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Somebody in a county with no bank branch\nleft in it at all, and the nearest"
    } ]
  }, {
    "tStartMs": 376720,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "office two hours each way on a road they\nno longer drive."
    } ]
  }, {
    "tStartMs": 380520,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "The paper check that used to catch these\npeople is gone."
    } ]
  }, {
    "tStartMs": 383180,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Federal law closed that door at the end of\nSeptember last year, and the agency"
    } ]
  }, {
    "tStartMs": 387740,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "is finishing the switch to electronic\npayments this year."
    } ]
  }, {
    "tStartMs": 391700,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Now here is the thing that nobody puts in\na video, and it is the reason this"
    } ]
  }, {
    "tStartMs": 395400,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "item is last. There is a waiver."
    } ]
  }, {
    "tStartMs": 398380,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "If you genuinely cannot make the switch,\nbecause of where you live or because"
    } ]
  }, {
    "tStartMs": 402300,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "of your health, the Treasury can grant an\nexception."
    } ]
  }, {
    "tStartMs": 405500,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "It is written down. It is not a favour and\nit is not discretionary kindness."
    } ]
  }, {
    "tStartMs": 410560,
    "dDurationMs": 7880,
    "segs": [ {
      "utf8": "It is a process with a telephone number,\nand the number is 1-877-874-6347."
    } ]
  }, {
    "tStartMs": 418480,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "I am not going to pretend the waiver is\neasy or that it is granted to everybody"
    } ]
  }, {
    "tStartMs": 422020,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "who rings. I do not know how often it is\ngiven and I am not going to guess"
    } ]
  }, {
    "tStartMs": 426140,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "at it. What I can tell you is that the\nexception exists, it is published by"
    } ]
  }, {
    "tStartMs": 430480,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "the agency itself, and almost nobody over\nseventy has ever been told the number"
    } ]
  }, {
    "tStartMs": 434780,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "out loud. If somebody in your family is in\nthat position, that number is worth"
    } ]
  }, {
    "tStartMs": 439020,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "more than everything else in this video\nput together."
    } ]
  }, {
    "tStartMs": 442340,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "There is one thread running through all\nfour of these, and once you see it"
    } ]
  }, {
    "tStartMs": 446340,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "the whole thing stops looking like four\nseparate rules."
    } ]
  }, {
    "tStartMs": 449540,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Every one of them turns on whether a\nperson can get into a website."
    } ]
  }, {
    "tStartMs": 453160,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Not how much money they have. Not how long\nthey worked."
    } ]
  }, {
    "tStartMs": 456540,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Whether they can remember a password and\ncollect a code on a telephone that"
    } ]
  }, {
    "tStartMs": 460520,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "may be sitting in a drawer with a flat\nbattery."
    } ]
  }, {
    "tStartMs": 462860,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "That is the line the system now draws\nbetween people, and it was drawn quietly,"
    } ]
  }, {
    "tStartMs": 468580,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "without a single letter going out to the\nhouseholds standing on the wrong side"
    } ]
  }, {
    "tStartMs": 472540,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "of it. A man who built roads for forty\nyears and a man who sold insurance for"
    } ]
  }, {
    "tStartMs": 477520,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "forty years are treated identically if\nthey both have an account."
    } ]
  }, {
    "tStartMs": 481820,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "If one of them does not, he is in a\ndifferent country."
    } ]
  }, {
    "tStartMs": 485240,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "And notice what that does to the people\naround them."
    } ]
  }, {
    "tStartMs": 487680,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "The daughter who drives her mother to the\nappointment is now also the daughter"
    } ]
  }, {
    "tStartMs": 492400,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "who sets up the login, remembers the\npassword, and holds the telephone that"
    } ]
  }, {
    "tStartMs": 496900,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "the code arrives on."
    } ]
  }, {
    "tStartMs": 498760,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "The rule did not just move a task."
    } ]
  }, {
    "tStartMs": 500980,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "It moved it onto somebody else, and nobody\nasked her either."
    } ]
  }, {
    "tStartMs": 505240,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Now where this stops being useful."
    } ]
  }, {
    "tStartMs": 507400,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "I cannot see your file and I do not know\nwhich payment lands in your account."
    } ]
  }, {
    "tStartMs": 511380,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "Offices differ from one another, waiting\ntimes differ enormously by county,"
    } ]
  }, {
    "tStartMs": 516780,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "and the person at the counter has far more\ndiscretion than any written rule"
    } ]
  }, {
    "tStartMs": 520400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "makes it sound."
    } ]
  }, {
    "tStartMs": 522020,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Everything here is the national rule\nrather than your own case, and your own"
    } ]
  }, {
    "tStartMs": 526260,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "case is decided by somebody who has your\nfile open in front of them."
    } ]
  }, {
    "tStartMs": 530340,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "The four, said quickly. If you cannot use\nthe website, changing where your"
    } ]
  }, {
    "tStartMs": 534680,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "payment lands now means going to an office\nin person."
    } ]
  }, {
    "tStartMs": 538420,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "Medicare, disability and SSI are carved\nout of that, and retirement, survivors"
    } ]
  }, {
    "tStartMs": 544220,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "and spouse payments are not. The thirty\nday hold on online changes is still"
    } ]
  }, {
    "tStartMs": 549040,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "in place no matter who told you otherwise."
    } ]
  }, {
    "tStartMs": 551820,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "And if you cannot get to a building at\nall, the Treasury has a waiver and a"
    } ]
  }, {
    "tStartMs": 555920,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "telephone number. Not one of these is\nhidden."
    } ]
  }, {
    "tStartMs": 558820,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Each one sits on a government page, free,\nwhere anybody can read it."
    } ]
  }, {
    "tStartMs": 563380,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "They catch older people anyway, because a\nrule that lives on a website finds"
    } ]
  }, {
    "tStartMs": 567920,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "the people who use websites, and the\npeople it was most likely to hurt were"
    } ]
  }, {
    "tStartMs": 571940,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "never going to see it there."
    } ]
  }, {
    "tStartMs": 573840,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "One more thing, since this is exactly the\nseason when these calls go out."
    } ]
  }, {
    "tStartMs": 578360,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "No official body rings you to help update\na deposit, and no official body needs"
    } ]
  }, {
    "tStartMs": 582760,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "a routing number to keep a payment safe."
    } ]
  }, {
    "tStartMs": 585140,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "A man named Arthur, seventy nine, lost two\nmonths of payments to a caller who"
    } ]
  }, {
    "tStartMs": 589860,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "already knew his address and knew the date\nhis money arrived each month, and"
    } ]
  }, {
    "tStartMs": 593860,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "both of those details came off a list that\ncost the caller almost nothing to"
    } ]
  }, {
    "tStartMs": 597820,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "buy. What made Arthur answer the second\nquestion was that the caller got the"
    } ]
  }, {
    "tStartMs": 602140,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "first two right. That is the whole\ntechnique, and it works on careful people"
    } ]
  }, {
    "tStartMs": 606660,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "more often than it works on careless ones."
    } ]
  }, {
    "tStartMs": 609580,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Put the telephone down before you answer\nanything at all."
    } ]
  }, {
    "tStartMs": 613120,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "And if you know somebody over sixty five\nwho still handles everything on paper,"
    } ]
  }, {
    "tStartMs": 617700,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "do not explain this to them. Sit beside\nthem and set the website up while nothing"
    } ]
  }, {
    "tStartMs": 622260,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "is wrong."
    } ]
  }, {
    "tStartMs": 623480,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Twenty minutes today, or a sixty mile\ndrive on the worst week they will ever"
    } ]
  }, {
    "tStartMs": 627440,
    "dDurationMs": 821,
    "segs": [ {
      "utf8": "have."
    } ]
  } ]
}
