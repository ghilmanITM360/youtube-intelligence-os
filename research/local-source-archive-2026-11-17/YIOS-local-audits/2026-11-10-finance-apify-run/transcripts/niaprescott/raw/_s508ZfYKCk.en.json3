{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "This morning Social Security told you your\nraise for next year."
    } ]
  }, {
    "tStartMs": 5080,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "They did not tell you what lands in the\nbank."
    } ]
  }, {
    "tStartMs": 7680,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "That is a different number. It does not\nexist yet."
    } ]
  }, {
    "tStartMs": 11520,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "The office that sets it does not meet\nuntil November."
    } ]
  }, {
    "tStartMs": 15400,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "Here is yours. Take your check, the full\namount, before anything comes out"
    } ]
  }, {
    "tStartMs": 20220,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "of it. For every $1,000 in that check,\nthis raise adds about $35."
    } ]
  }, {
    "tStartMs": 27280,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "A $1,500 check goes up about $53."
    } ]
  }, {
    "tStartMs": 31020,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "$2,000 goes up about $70."
    } ]
  }, {
    "tStartMs": 33560,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Work out your own and hold on to it."
    } ]
  }, {
    "tStartMs": 36040,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Now the part that costs people."
    } ]
  }, {
    "tStartMs": 37960,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "That number is not what arrives."
    } ]
  }, {
    "tStartMs": 40080,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Something comes out of it first, and the\namount has not been set yet."
    } ]
  }, {
    "tStartMs": 44480,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "So if you have already decided where this\nmoney goes, the heating bill, the"
    } ]
  }, {
    "tStartMs": 49120,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "grocery run, the one bill you keep pushing\nto next month, wait."
    } ]
  }, {
    "tStartMs": 54060,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "You are spending a number nobody has\nfinished."
    } ]
  }, {
    "tStartMs": 57160,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Before you decide this is somebody else\nproblem."
    } ]
  }, {
    "tStartMs": 60720,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Some of you hear Medicare and stop\nlistening, because you are not on it yet."
    } ]
  }, {
    "tStartMs": 65520,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Some of you hear raise and stop listening,\nbecause you already know what yours"
    } ]
  }, {
    "tStartMs": 69920,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "went up by. Both of you are in this."
    } ]
  }, {
    "tStartMs": 73220,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Five things sit between this morning and\nthe day your money arrives."
    } ]
  }, {
    "tStartMs": 77920,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Two of them you can still change."
    } ]
  }, {
    "tStartMs": 80540,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "One of them closes tomorrow."
    } ]
  }, {
    "tStartMs": 82760,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And if you get a payment on the thirty\nfirst of December, stay with me."
    } ]
  }, {
    "tStartMs": 87080,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "That one is the trap."
    } ]
  }, {
    "tStartMs": 89220,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Number one. Your Medicare premium."
    } ]
  }, {
    "tStartMs": 91940,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "This is the one that eats the raise, and\nthe number is not out yet."
    } ]
  }, {
    "tStartMs": 96140,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "Right now the standard premium is $202.90\na month."
    } ]
  }, {
    "tStartMs": 101540,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "It comes out of your check before you ever\nsee it."
    } ]
  }, {
    "tStartMs": 104960,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "You never touch that money. It is gone\nbefore the deposit lands."
    } ]
  }, {
    "tStartMs": 109880,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Twelve months ago that same premium was\n$185."
    } ]
  }, {
    "tStartMs": 114080,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "So it climbed almost $18 in a single year,\nand every cent of that climb came"
    } ]
  }, {
    "tStartMs": 119800,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "out of the raise people were given last\nOctober."
    } ]
  }, {
    "tStartMs": 123040,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "For next year, nobody knows. The people\nwho run the numbers for Medicare put"
    } ]
  }, {
    "tStartMs": 128060,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "it near $209.50. That is a projection, not\nthe real figure."
    } ]
  }, {
    "tStartMs": 133600,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Some private forecasters say they are\nbeing too hopeful and put it between"
    } ]
  }, {
    "tStartMs": 138560,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "$216 and $219. So take the number you\nworked out at the start."
    } ]
  }, {
    "tStartMs": 144380,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Then take $6 off it. Then take $16 off it."
    } ]
  }, {
    "tStartMs": 148580,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Your real raise sits somewhere between\nthose two, and you will not know which"
    } ]
  }, {
    "tStartMs": 153180,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "until November. Write both numbers on the\nsame piece of paper."
    } ]
  }, {
    "tStartMs": 158060,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Plan your winter on the smaller one."
    } ]
  }, {
    "tStartMs": 160340,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "If the bigger one arrives, that is a good\nsurprise."
    } ]
  }, {
    "tStartMs": 164380,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "The other way round is a bad month."
    } ]
  }, {
    "tStartMs": 167240,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Number two. Your drug plan price."
    } ]
  }, {
    "tStartMs": 170040,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "This is the one you can still change, and\nthe window opens tomorrow."
    } ]
  }, {
    "tStartMs": 175340,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "From tomorrow until the seventh of\nDecember, you can move to a different drug"
    } ]
  }, {
    "tStartMs": 179440,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "plan or a different Medicare plan."
    } ]
  }, {
    "tStartMs": 182300,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "After the seventh of December it shuts,\nand your price is fixed for the whole"
    } ]
  }, {
    "tStartMs": 186640,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "of next year. It does not open again until\nnext October."
    } ]
  }, {
    "tStartMs": 191620,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Here is why it matters more than the\npremium."
    } ]
  }, {
    "tStartMs": 194760,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Three things are moving at once on the\ndrug side."
    } ]
  }, {
    "tStartMs": 198180,
    "dDurationMs": 6500,
    "segs": [ {
      "utf8": "The amount you pay first, before the plan\npays anything, goes from $615 to"
    } ]
  }, {
    "tStartMs": 204680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "$700."
    } ]
  }, {
    "tStartMs": 205960,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "That is $85 more out of your pocket, and\nmost of it hits in January when"
    } ]
  }, {
    "tStartMs": 212000,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "money is already tight."
    } ]
  }, {
    "tStartMs": 214140,
    "dDurationMs": 6174,
    "segs": [ {
      "utf8": "The most you can be made to pay in a year\nclimbs from $2,100 to $2,400."
    } ]
  }, {
    "tStartMs": 220580,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "If you take expensive medicine, you reach\nthat ceiling every year, and that"
    } ]
  }, {
    "tStartMs": 226260,
    "dDurationMs": 5780,
    "segs": [ {
      "utf8": "is $300 more. And a discount that has been\nholding standalone drug plan prices"
    } ]
  }, {
    "tStartMs": 232040,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "down runs out at the end of this year."
    } ]
  }, {
    "tStartMs": 235120,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "When it goes, those monthly prices go up\nabout $16."
    } ]
  }, {
    "tStartMs": 239600,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Add those together and the drug side can\ntake more than the whole raise."
    } ]
  }, {
    "tStartMs": 245160,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "Switching plans can hand it back."
    } ]
  }, {
    "tStartMs": 247520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Your move."
    } ]
  }, {
    "tStartMs": 248880,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "Go to medicare.gov, or call\n1-800-MEDICARE, and compare."
    } ]
  }, {
    "tStartMs": 254760,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It is free."
    } ]
  }, {
    "tStartMs": 256100,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "When you compare, look at three numbers\nand not one."
    } ]
  }, {
    "tStartMs": 259560,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "The monthly price. The amount you pay\nfirst."
    } ]
  }, {
    "tStartMs": 262960,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "And what your own medicines cost under\nthat plan."
    } ]
  }, {
    "tStartMs": 266420,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "The cheapest monthly price very often\nhides the most expensive medicine."
    } ]
  }, {
    "tStartMs": 271640,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Number three. The letter with your real\nnumber."
    } ]
  }, {
    "tStartMs": 274800,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "Some time in December a plain white\nenvelope arrives from Social Security."
    } ]
  }, {
    "tStartMs": 280620,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "A lot of people never open it."
    } ]
  }, {
    "tStartMs": 282720,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It is the only place your real figures are\nwritten down."
    } ]
  }, {
    "tStartMs": 286460,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Three of them. Your new full check."
    } ]
  }, {
    "tStartMs": 289120,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "What comes out for Medicare. And what\nactually reaches your bank."
    } ]
  }, {
    "tStartMs": 293660,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Everything in this video is me telling you\nhow the gap works."
    } ]
  }, {
    "tStartMs": 297480,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "That letter tells you your own gap, in\nyour own dollars."
    } ]
  }, {
    "tStartMs": 301520,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Now the part that catches people a year\nlater."
    } ]
  }, {
    "tStartMs": 305360,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Keep it. Put it somewhere safe the day it\narrives."
    } ]
  }, {
    "tStartMs": 309240,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "When you renew food help, or Medicaid, or\nhousing help, or the program that"
    } ]
  }, {
    "tStartMs": 314320,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "pays your Medicare premium, the office\nasks for that letter."
    } ]
  }, {
    "tStartMs": 318960,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "People who threw it out spend weeks\ngetting another one."
    } ]
  }, {
    "tStartMs": 322180,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "And if January looks wrong, that letter is\nyour proof."
    } ]
  }, {
    "tStartMs": 325900,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Without it you are arguing from memory."
    } ]
  }, {
    "tStartMs": 328160,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "You can also read it online."
    } ]
  }, {
    "tStartMs": 330480,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Sign in to your account on the Social\nSecurity website and look in the message"
    } ]
  }, {
    "tStartMs": 334580,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "center. It usually shows up there in early\nDecember."
    } ]
  }, {
    "tStartMs": 338520,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Your move. When the white envelope comes,\nopen it the same day."
    } ]
  }, {
    "tStartMs": 343620,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Write the third number, the one that\nreaches your bank, on your calendar for"
    } ]
  }, {
    "tStartMs": 348000,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "January. Then put the letter somewhere you\nwill find it in a year."
    } ]
  }, {
    "tStartMs": 352520,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Number four. Two payments in December,\nnone in January."
    } ]
  }, {
    "tStartMs": 357080,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "This one surprises people every single\nyear, and it empties a whole month."
    } ]
  }, {
    "tStartMs": 362580,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "The first of January next year is a\nholiday."
    } ]
  }, {
    "tStartMs": 366040,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Payments do not go out on a holiday."
    } ]
  }, {
    "tStartMs": 368240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "They go out the working day before."
    } ]
  }, {
    "tStartMs": 370720,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "That day is the thirty first of December."
    } ]
  }, {
    "tStartMs": 373000,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "So if your money normally lands on the\nfirst of the month, this is what December"
    } ]
  }, {
    "tStartMs": 377920,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "looks like for you. One payment at the\nstart of December."
    } ]
  }, {
    "tStartMs": 381900,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Then a second payment on the thirty first."
    } ]
  }, {
    "tStartMs": 384460,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Two payments in one month. And then\nnothing at all in January."
    } ]
  }, {
    "tStartMs": 389000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Here is who this hits."
    } ]
  }, {
    "tStartMs": 390960,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "People who get the payment for those with\nvery little income."
    } ]
  }, {
    "tStartMs": 394420,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "And people who get paid on the third of\nthe month, which is usually anybody"
    } ]
  }, {
    "tStartMs": 398460,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "who started Social Security before May of\n1997."
    } ]
  }, {
    "tStartMs": 403260,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "Every year some of those people see money\narrive on New Year Eve and think"
    } ]
  }, {
    "tStartMs": 408560,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "it is extra. A bonus. A gift for the new\nyear."
    } ]
  }, {
    "tStartMs": 412560,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "So they spend it. Then January comes and\nthe account stays empty, and the rent"
    } ]
  }, {
    "tStartMs": 417940,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "is still due. It was never extra."
    } ]
  }, {
    "tStartMs": 420980,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "It was January money, handed over one day\nearly."
    } ]
  }, {
    "tStartMs": 424600,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Everybody else is on a different schedule."
    } ]
  }, {
    "tStartMs": 427780,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Their January money comes on a Wednesday\nthat depends on their birthday."
    } ]
  }, {
    "tStartMs": 431900,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Born between the first and the tenth, the\nthirteenth of January."
    } ]
  }, {
    "tStartMs": 436220,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Between the eleventh and the twentieth,\nthe twentieth."
    } ]
  }, {
    "tStartMs": 439380,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Between the twenty first and the thirty\nfirst, the twenty seventh."
    } ]
  }, {
    "tStartMs": 443400,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "Your move. If you are paid on the first or\nthe third, mark the thirty first"
    } ]
  }, {
    "tStartMs": 448480,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "of December on your calendar right now and\nwrite one word next to it."
    } ]
  }, {
    "tStartMs": 453160,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "January. That money has to carry you to\nthe start of February."
    } ]
  }, {
    "tStartMs": 458100,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "And if your mother or your father or a\nneighbor is on the payment for people"
    } ]
  }, {
    "tStartMs": 462200,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "with very little income, tell them this\nweek."
    } ]
  }, {
    "tStartMs": 465660,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "By January it is already spent."
    } ]
  }, {
    "tStartMs": 468700,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Number five. The check that goes down."
    } ]
  }, {
    "tStartMs": 472160,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "There is a rule that is supposed to stop\nthis happening, and three groups of"
    } ]
  }, {
    "tStartMs": 475840,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "people fall outside it."
    } ]
  }, {
    "tStartMs": 478100,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "The rule works like this. If the Medicare\npremium climbs by more than your"
    } ]
  }, {
    "tStartMs": 482680,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "raise, your check would shrink."
    } ]
  }, {
    "tStartMs": 485040,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "For most people the law does not allow\nthat."
    } ]
  }, {
    "tStartMs": 487800,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Your check is held where it was."
    } ]
  }, {
    "tStartMs": 489800,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It can stay flat. It cannot drop."
    } ]
  }, {
    "tStartMs": 492620,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Everybody tells you that part."
    } ]
  }, {
    "tStartMs": 494520,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Here is the part they leave out."
    } ]
  }, {
    "tStartMs": 496280,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "It leaves out anybody who is only starting\nMedicare this year."
    } ]
  }, {
    "tStartMs": 500060,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "It leaves out anybody who pays a higher\npremium because of what they earned"
    } ]
  }, {
    "tStartMs": 503940,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "two years ago. And it leaves out anybody\nwho pays the premium by bill instead"
    } ]
  }, {
    "tStartMs": 508740,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "of having it taken out of the check."
    } ]
  }, {
    "tStartMs": 510960,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "If you are in one of those three groups,\nyour check can come out smaller next"
    } ]
  }, {
    "tStartMs": 514140,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "year than it is this year. In a year\neverybody was told their money went up."
    } ]
  }, {
    "tStartMs": 518920,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "That second group catches people who\nstopped work recently."
    } ]
  }, {
    "tStartMs": 522720,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Medicare looks at what you earned two\nyears back."
    } ]
  }, {
    "tStartMs": 525440,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "So somebody who retired last year, or\nsomebody whose husband or wife died last"
    } ]
  }, {
    "tStartMs": 529820,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "year, can still be charged on an income\nthey no longer have."
    } ]
  }, {
    "tStartMs": 533920,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "There is a form for that. You tell\nMedicare your money dropped and why, and"
    } ]
  }, {
    "tStartMs": 538360,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "they look again at what they charge you."
    } ]
  }, {
    "tStartMs": 540740,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Most people never hear it exists, so they\npay the higher amount for years."
    } ]
  }, {
    "tStartMs": 545380,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Your move. If your income fell because you\nstopped work, or because you lost"
    } ]
  }, {
    "tStartMs": 549600,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "a husband or a wife, call Social Security\nand say one sentence."
    } ]
  }, {
    "tStartMs": 553940,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "My income has gone down and I want my\nMedicare charge looked at again."
    } ]
  }, {
    "tStartMs": 558040,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "They will tell you which form to fill in."
    } ]
  }, {
    "tStartMs": 560860,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "The same shape sits under all five."
    } ]
  }, {
    "tStartMs": 563540,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "The raise and the cost are set"
    } ]
  }, {
    "tStartMs": 564980,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "by two different offices, in two different\nmonths,"
    } ]
  }, {
    "tStartMs": 567400,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "and the two offices never speak to each\nother."
    } ]
  }, {
    "tStartMs": 570240,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "October hands you a percentage."
    } ]
  }, {
    "tStartMs": 572320,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "November hands you a price. The job of\nputting them together is left to you."
    } ]
  }, {
    "tStartMs": 577600,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "That is why the letter in December matters\nso much."
    } ]
  }, {
    "tStartMs": 581440,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "It is the only document in this"
    } ]
  }, {
    "tStartMs": 583140,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "whole chain where somebody has done the\narithmetic"
    } ]
  }, {
    "tStartMs": 585840,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "for you. They are not hiding any of it."
    } ]
  }, {
    "tStartMs": 588780,
    "dDurationMs": 7280,
    "segs": [ {
      "utf8": "The numbers go up on"
    } ]
  }, {
    "tStartMs": 596060,
    "dDurationMs": 74,
    "segs": [ {
      "utf8": "public websites, free, for anybody who\nlooks."
    } ]
  }, {
    "tStartMs": 596174,
    "dDurationMs": 2366,
    "segs": [ {
      "utf8": "Careful people still miss it, because\nnothing arrives to tell you the first"
    } ]
  }, {
    "tStartMs": 598540,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "number has changed."
    } ]
  }, {
    "tStartMs": 600440,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Here is the line where my own knowledge\nstops."
    } ]
  }, {
    "tStartMs": 603440,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "Your check, your plan and your state are\nthree things I cannot see, and those"
    } ]
  }, {
    "tStartMs": 608700,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "three decide your figure. I can show you\nhow the pieces move."
    } ]
  }, {
    "tStartMs": 613800,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "The figure itself belongs to you."
    } ]
  }, {
    "tStartMs": 616340,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "The premium for next year has not been\nset, so anybody handing you an exact"
    } ]
  }, {
    "tStartMs": 620660,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "number today is guessing at it."
    } ]
  }, {
    "tStartMs": 623000,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Your real answer sits in that December\nletter, and with the people who run"
    } ]
  }, {
    "tStartMs": 627520,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "your plan. All five, one last time."
    } ]
  }, {
    "tStartMs": 631360,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Take a screenshot of this. One."
    } ]
  }, {
    "tStartMs": 634220,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "The premium is $202.90 now, and next year\nis set in November."
    } ]
  }, {
    "tStartMs": 640280,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Plan on the smaller outcome. Two."
    } ]
  }, {
    "tStartMs": 643120,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Your drug plan window opens tomorrow and\nshuts on the seventh of December,"
    } ]
  }, {
    "tStartMs": 647340,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "and the drug side can take more than the\nwhole raise."
    } ]
  }, {
    "tStartMs": 651300,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Three."
    } ]
  }, {
    "tStartMs": 652240,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "The white envelope in December holds your\nreal number."
    } ]
  }, {
    "tStartMs": 655940,
    "dDurationMs": 5980,
    "segs": [ {
      "utf8": "Open it and keep it. Four. If you are paid\non the first or the third, two payments"
    } ]
  }, {
    "tStartMs": 661920,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "land in December and nothing lands in\nJanuary."
    } ]
  }, {
    "tStartMs": 665200,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Five. The rule that stops your check\ndropping leaves out three groups, and"
    } ]
  }, {
    "tStartMs": 669980,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "one form can help the second group."
    } ]
  }, {
    "tStartMs": 672320,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Now the phone, and treat this as a rule."
    } ]
  }, {
    "tStartMs": 675640,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Social Security will never telephone you\nabout your raise."
    } ]
  }, {
    "tStartMs": 679780,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "It arrives on its own. There is no form to\nsend, nothing to confirm, nothing"
    } ]
  }, {
    "tStartMs": 685300,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "to pay. So if a voice asks you to confirm\nyour details to receive your increase,"
    } ]
  }, {
    "tStartMs": 691420,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "put the phone down. That call is a scam\nevery single time."
    } ]
  }, {
    "tStartMs": 696180,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "And if one of your parents is paid on the\nfirst or the third of the month,"
    } ]
  }, {
    "tStartMs": 701760,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "hand this to them in person."
    } ]
  }, {
    "tStartMs": 704400,
    "dDurationMs": 5880,
    "segs": [ {
      "utf8": "Sit beside them, find the thirty first of\nDecember on their calendar, and write"
    } ]
  }, {
    "tStartMs": 710280,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "January next to it."
    } ]
  }, {
    "tStartMs": 712460,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "That one minute is worth more than\neverything else here."
    } ]
  } ]
}
