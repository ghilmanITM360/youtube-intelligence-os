{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4961,
    "segs": [ {
      "utf8": "Social Security is the one check that almost every American will lean on for the"
    } ]
  }, {
    "tStartMs": 4961,
    "dDurationMs": 5381,
    "segs": [ {
      "utf8": "rest of their life, and most people quietly accept whatever the government decides to send"
    } ]
  }, {
    "tStartMs": 10342,
    "dDurationMs": 5481,
    "segs": [ {
      "utf8": "them. They assume the amount is fixed, that it is simply calculated by a computer"
    } ]
  }, {
    "tStartMs": 15823,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "somewhere and there is nothing to be done about it."
    } ]
  }, {
    "tStartMs": 19624,
    "dDurationMs": 3541,
    "segs": [ {
      "utf8": "That is the most expensive assumption in retirement."
    } ]
  }, {
    "tStartMs": 23865,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "The truth is that the size of your check is the result of a series"
    } ]
  }, {
    "tStartMs": 27505,
    "dDurationMs": 5042,
    "segs": [ {
      "utf8": "of choices, and the wrong choices can cost you tens of thousands of dollars that"
    } ]
  }, {
    "tStartMs": 32547,
    "dDurationMs": 4581,
    "segs": [ {
      "utf8": "you earned and were owed, every year, for the rest of your life."
    } ]
  }, {
    "tStartMs": 37668,
    "dDurationMs": 6201,
    "segs": [ {
      "utf8": "Almost nobody is shown how these choices work, because the Social Security Administration will pay"
    } ]
  }, {
    "tStartMs": 43869,
    "dDurationMs": 4841,
    "segs": [ {
      "utf8": "you exactly what you ask for, and not one dollar more, even when you are"
    } ]
  }, {
    "tStartMs": 48710,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "leaving money on the table by accident."
    } ]
  }, {
    "tStartMs": 51351,
    "dDurationMs": 4341,
    "segs": [ {
      "utf8": "I am going to walk you through seven things that decide how big your check"
    } ]
  }, {
    "tStartMs": 55692,
    "dDurationMs": 4921,
    "segs": [ {
      "utf8": "is, and how to make sure you are collecting every dollar you are entitled to."
    } ]
  }, {
    "tStartMs": 61193,
    "dDurationMs": 3821,
    "segs": [ {
      "utf8": "Stay with me to the end, because the last one is a brand new change"
    } ]
  }, {
    "tStartMs": 65014,
    "dDurationMs": 4261,
    "segs": [ {
      "utf8": "in the law that is putting hundreds of dollars a month back into the pockets"
    } ]
  }, {
    "tStartMs": 69275,
    "dDurationMs": 4761,
    "segs": [ {
      "utf8": "of more than three million people, and many of them still have no idea it"
    } ]
  }, {
    "tStartMs": 74036,
    "dDurationMs": 6381,
    "segs": [ {
      "utf8": "happened. Number one is the single biggest lever you control, and it is the age"
    } ]
  }, {
    "tStartMs": 80417,
    "dDurationMs": 5301,
    "segs": [ {
      "utf8": "you start. You can claim as early as sixty two, but if you do, you"
    } ]
  }, {
    "tStartMs": 85718,
    "dDurationMs": 4401,
    "segs": [ {
      "utf8": "lock in a permanent cut of around thirty percent for the rest of your life."
    } ]
  }, {
    "tStartMs": 90919,
    "dDurationMs": 5181,
    "segs": [ {
      "utf8": "Your full retirement age, the age where you get your complete benefit, is sixty seven"
    } ]
  }, {
    "tStartMs": 96100,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "for everyone born in nineteen sixty or later."
    } ]
  }, {
    "tStartMs": 99981,
    "dDurationMs": 2421,
    "segs": [ {
      "utf8": "And here is the part most people never use."
    } ]
  }, {
    "tStartMs": 103022,
    "dDurationMs": 5801,
    "segs": [ {
      "utf8": "For every year you wait beyond your full retirement age, up until seventy, the government"
    } ]
  }, {
    "tStartMs": 108823,
    "dDurationMs": 4681,
    "segs": [ {
      "utf8": "adds about eight percent to your check, and that increase is permanent."
    } ]
  }, {
    "tStartMs": 113864,
    "dDurationMs": 5081,
    "segs": [ {
      "utf8": "Waiting from sixty two to seventy can leave you with a monthly check that is"
    } ]
  }, {
    "tStartMs": 118945,
    "dDurationMs": 3441,
    "segs": [ {
      "utf8": "more than seventy percent larger for the rest of your life."
    } ]
  }, {
    "tStartMs": 123186,
    "dDurationMs": 4641,
    "segs": [ {
      "utf8": "Now, claiming early is the right move for some people, especially if you are in"
    } ]
  }, {
    "tStartMs": 127827,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "poor health or you truly need the income."
    } ]
  }, {
    "tStartMs": 130748,
    "dDurationMs": 4181,
    "segs": [ {
      "utf8": "But it should be a decision you make on purpose with the real numbers in"
    } ]
  }, {
    "tStartMs": 134929,
    "dDurationMs": 4001,
    "segs": [ {
      "utf8": "front of you, not a default you fall into because you did not know waiting"
    } ]
  }, {
    "tStartMs": 138930,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "was worth that much."
    } ]
  }, {
    "tStartMs": 141110,
    "dDurationMs": 5681,
    "segs": [ {
      "utf8": "Number two is the rule that scares people into claiming at the wrong time, and"
    } ]
  }, {
    "tStartMs": 146791,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "it is misunderstood almost universally."
    } ]
  }, {
    "tStartMs": 149872,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "It is called the earnings test."
    } ]
  }, {
    "tStartMs": 152933,
    "dDurationMs": 5701,
    "segs": [ {
      "utf8": "If you claim Social Security before your full retirement age and you keep working, the"
    } ]
  }, {
    "tStartMs": 158634,
    "dDurationMs": 5501,
    "segs": [ {
      "utf8": "government withholds one dollar of benefits for every two dollars you earn above a yearly"
    } ]
  }, {
    "tStartMs": 164135,
    "dDurationMs": 8642,
    "segs": [ {
      "utf8": "limit, and in twenty twenty six that limit is twenty four thousand four hundred and"
    } ]
  }, {
    "tStartMs": 174017,
    "dDurationMs": 3731,
    "segs": [ {
      "utf8": "eighty dollars. People hear that and panic and think their benefits are being taken away"
    } ]
  }, {
    "tStartMs": 177748,
    "dDurationMs": 170,
    "segs": [ {
      "utf8": "forever. They are not."
    } ]
  }, {
    "tStartMs": 178538,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "That money is not lost."
    } ]
  }, {
    "tStartMs": 181099,
    "dDurationMs": 5601,
    "segs": [ {
      "utf8": "The day you reach full retirement age, the government recalculates your benefit and gives it"
    } ]
  }, {
    "tStartMs": 186700,
    "dDurationMs": 3121,
    "segs": [ {
      "utf8": "back to you in the form of a higher check going forward."
    } ]
  }, {
    "tStartMs": 190581,
    "dDurationMs": 5861,
    "segs": [ {
      "utf8": "So the earnings test is not a penalty, it is a delay, and understanding that"
    } ]
  }, {
    "tStartMs": 196442,
    "dDurationMs": 6502,
    "segs": [ {
      "utf8": "one fact stops people from making a rushed, permanent decision based on a temporary withholding"
    } ]
  }, {
    "tStartMs": 202944,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "they were always going to get back."
    } ]
  }, {
    "tStartMs": 205524,
    "dDurationMs": 5021,
    "segs": [ {
      "utf8": "Number three costs people real money and it takes ten minutes to fix."
    } ]
  }, {
    "tStartMs": 211365,
    "dDurationMs": 5842,
    "segs": [ {
      "utf8": "Your benefit is calculated from your own earnings history, the record of what you made"
    } ]
  }, {
    "tStartMs": 217207,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "every year that you worked."
    } ]
  }, {
    "tStartMs": 218707,
    "dDurationMs": 4581,
    "segs": [ {
      "utf8": "And that record contains mistakes more often than you would think."
    } ]
  }, {
    "tStartMs": 224028,
    "dDurationMs": 5601,
    "segs": [ {
      "utf8": "An employer reports the wrong amount, a year of income goes missing, your name or"
    } ]
  }, {
    "tStartMs": 229629,
    "dDurationMs": 5602,
    "segs": [ {
      "utf8": "number gets entered wrong, and every one of those errors quietly lowers the check you"
    } ]
  }, {
    "tStartMs": 235231,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "will collect for the rest of your life."
    } ]
  }, {
    "tStartMs": 238911,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "You can create a free account on the Social Security website and pull up your"
    } ]
  }, {
    "tStartMs": 243332,
    "dDurationMs": 4561,
    "segs": [ {
      "utf8": "entire earnings record and check it year by year against your own memory and your"
    } ]
  }, {
    "tStartMs": 247893,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "old tax forms."
    } ]
  }, {
    "tStartMs": 249574,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "If you find a gap or a wrong number, you can have it corrected."
    } ]
  }, {
    "tStartMs": 253675,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Nobody at the agency is going to catch these for you."
    } ]
  }, {
    "tStartMs": 256635,
    "dDurationMs": 4601,
    "segs": [ {
      "utf8": "The record is yours to check, and the money lost to an uncorrected error is"
    } ]
  }, {
    "tStartMs": 261236,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "yours to lose."
    } ]
  }, {
    "tStartMs": 262877,
    "dDurationMs": 4961,
    "segs": [ {
      "utf8": "Number four is connected to that record, and it is the thirty five year rule."
    } ]
  }, {
    "tStartMs": 268518,
    "dDurationMs": 6221,
    "segs": [ {
      "utf8": "Social Security calculates your benefit by taking your highest thirty five years of earnings and"
    } ]
  }, {
    "tStartMs": 274739,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "averaging them together."
    } ]
  }, {
    "tStartMs": 276540,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Here is the catch that hurts people."
    } ]
  }, {
    "tStartMs": 279220,
    "dDurationMs": 4461,
    "segs": [ {
      "utf8": "If you worked fewer than thirty five years, the government does not just use the"
    } ]
  }, {
    "tStartMs": 283681,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "years you have."
    } ]
  }, {
    "tStartMs": 285081,
    "dDurationMs": 5121,
    "segs": [ {
      "utf8": "It fills in the missing years with zeros, and those zeros drag your average down"
    } ]
  }, {
    "tStartMs": 290202,
    "dDurationMs": 4822,
    "segs": [ {
      "utf8": "hard. So if you are close to retirement and you only have thirty two or"
    } ]
  }, {
    "tStartMs": 295024,
    "dDurationMs": 5341,
    "segs": [ {
      "utf8": "thirty three years of solid earnings, working even one or two more years, or replacing"
    } ]
  }, {
    "tStartMs": 300365,
    "dDurationMs": 4401,
    "segs": [ {
      "utf8": "an early low earning year with a higher one now, can raise your benefit for"
    } ]
  }, {
    "tStartMs": 304766,
    "dDurationMs": 5241,
    "segs": [ {
      "utf8": "life. A single zero replaced with a good year can be worth more than people"
    } ]
  }, {
    "tStartMs": 310007,
    "dDurationMs": 6561,
    "segs": [ {
      "utf8": "ever realize. Number five is the benefit that millions of people, especially women, never claim,"
    } ]
  }, {
    "tStartMs": 316568,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "and it is the spousal benefit."
    } ]
  }, {
    "tStartMs": 319469,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "If you are married, you are entitled to a benefit based on your own work"
    } ]
  }, {
    "tStartMs": 323570,
    "dDurationMs": 4261,
    "segs": [ {
      "utf8": "record or up to half of your spouse's full benefit, whichever is higher."
    } ]
  }, {
    "tStartMs": 328591,
    "dDurationMs": 4041,
    "segs": [ {
      "utf8": "So if you spent years out of the paid workforce raising a family, or you"
    } ]
  }, {
    "tStartMs": 332632,
    "dDurationMs": 4441,
    "segs": [ {
      "utf8": "simply earned less than your husband or wife over your career, your own check might"
    } ]
  }, {
    "tStartMs": 337073,
    "dDurationMs": 4261,
    "segs": [ {
      "utf8": "be small, but you may be entitled to as much as fifty percent of theirs"
    } ]
  }, {
    "tStartMs": 341334,
    "dDurationMs": 5621,
    "segs": [ {
      "utf8": "instead. A lot of lower earning spouses claim their own tiny benefit and never find"
    } ]
  }, {
    "tStartMs": 346955,
    "dDurationMs": 3441,
    "segs": [ {
      "utf8": "out they could have had a much larger one based on their partner's record."
    } ]
  }, {
    "tStartMs": 350956,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "It is not automatic."
    } ]
  }, {
    "tStartMs": 352136,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "You have to know to ask for it."
    } ]
  }, {
    "tStartMs": 355137,
    "dDurationMs": 6221,
    "segs": [ {
      "utf8": "Number six is the money that grieving and divorced people leave behind without ever knowing"
    } ]
  }, {
    "tStartMs": 361358,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "it was theirs."
    } ]
  }, {
    "tStartMs": 363018,
    "dDurationMs": 5081,
    "segs": [ {
      "utf8": "If your spouse passes away, you are entitled to a survivor benefit that can be"
    } ]
  }, {
    "tStartMs": 368099,
    "dDurationMs": 4381,
    "segs": [ {
      "utf8": "as much as one hundred percent of what they were receiving, and for many widows"
    } ]
  }, {
    "tStartMs": 372860,
    "dDurationMs": 2181,
    "segs": [ {
      "utf8": "that is significantly more than their own check."
    } ]
  }, {
    "tStartMs": 375801,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "And here is what almost nobody knows."
    } ]
  }, {
    "tStartMs": 378502,
    "dDurationMs": 4381,
    "segs": [ {
      "utf8": "If you were married for at least ten years and then divorced, you can claim"
    } ]
  }, {
    "tStartMs": 382883,
    "dDurationMs": 5441,
    "segs": [ {
      "utf8": "a benefit based on your former spouse's record, even if they have remarried, and claiming"
    } ]
  }, {
    "tStartMs": 388324,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "it takes nothing away from them or their new family."
    } ]
  }, {
    "tStartMs": 391624,
    "dDurationMs": 6302,
    "segs": [ {
      "utf8": "There are billions of dollars in survivor and divorced spouse benefits going unclaimed every year,"
    } ]
  }, {
    "tStartMs": 397926,
    "dDurationMs": 6441,
    "segs": [ {
      "utf8": "simply because people do not know these benefits exist or assume they would not qualify."
    } ]
  }, {
    "tStartMs": 404967,
    "dDurationMs": 3941,
    "segs": [ {
      "utf8": "If you have lost a spouse, or you were married for a decade or more"
    } ]
  }, {
    "tStartMs": 408908,
    "dDurationMs": 4841,
    "segs": [ {
      "utf8": "and then divorced, it is worth one phone call to find out what you are"
    } ]
  }, {
    "tStartMs": 413749,
    "dDurationMs": 5241,
    "segs": [ {
      "utf8": "owed. Number seven is brand new, and if it applies to you, it could be"
    } ]
  }, {
    "tStartMs": 418990,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "the most valuable thing in this entire video."
    } ]
  }, {
    "tStartMs": 422391,
    "dDurationMs": 5041,
    "segs": [ {
      "utf8": "For decades, there were two rules that cut the Social Security benefits of people who"
    } ]
  }, {
    "tStartMs": 427432,
    "dDurationMs": 3781,
    "segs": [ {
      "utf8": "had earned a pension from a job that did not pay into Social Security."
    } ]
  }, {
    "tStartMs": 431823,
    "dDurationMs": 7432,
    "segs": [ {
      "utf8": "This hit teachers, firefighters, police officers, and certain federal and government workers especially hard, slashing"
    } ]
  }, {
    "tStartMs": 439255,
    "dDurationMs": 5601,
    "segs": [ {
      "utf8": "their own benefits and in many cases wiping out their spousal and survivor benefits entirely."
    } ]
  }, {
    "tStartMs": 445396,
    "dDurationMs": 4981,
    "segs": [ {
      "utf8": "At the very end of twenty twenty four, Congress passed the Social Security Fairness Act,"
    } ]
  }, {
    "tStartMs": 450577,
    "dDurationMs": 3581,
    "segs": [ {
      "utf8": "and in twenty twenty five those two rules were repealed."
    } ]
  }, {
    "tStartMs": 454458,
    "dDurationMs": 4721,
    "segs": [ {
      "utf8": "More than three million people are now entitled to larger checks, and because the change"
    } ]
  }, {
    "tStartMs": 459179,
    "dDurationMs": 4601,
    "segs": [ {
      "utf8": "reaches back to January of twenty twenty four, many are owed a one time back"
    } ]
  }, {
    "tStartMs": 463780,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "payment on top of the higher monthly amount going forward."
    } ]
  }, {
    "tStartMs": 467781,
    "dDurationMs": 4581,
    "segs": [ {
      "utf8": "The increases are real, averaging a few hundred dollars a month for the workers themselves"
    } ]
  }, {
    "tStartMs": 472362,
    "dDurationMs": 5041,
    "segs": [ {
      "utf8": "and in some cases over a thousand dollars a month for affected spouses and survivors."
    } ]
  }, {
    "tStartMs": 478403,
    "dDurationMs": 4541,
    "segs": [ {
      "utf8": "If you, or your late spouse, ever worked as a teacher or a firefighter or"
    } ]
  }, {
    "tStartMs": 482944,
    "dDurationMs": 4521,
    "segs": [ {
      "utf8": "a police officer or a government employee with a pension and you were told your"
    } ]
  }, {
    "tStartMs": 487465,
    "dDurationMs": 5121,
    "segs": [ {
      "utf8": "Social Security would be reduced, you need to make sure the Social Security Administration has"
    } ]
  }, {
    "tStartMs": 492586,
    "dDurationMs": 3601,
    "segs": [ {
      "utf8": "your current information so your corrected payment reaches you."
    } ]
  }, {
    "tStartMs": 496567,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "This is money that is now legally yours."
    } ]
  }, {
    "tStartMs": 499188,
    "dDurationMs": 5221,
    "segs": [ {
      "utf8": "Before I tie this together, here are two quick safety nets most people never hear"
    } ]
  }, {
    "tStartMs": 504409,
    "dDurationMs": 5381,
    "segs": [ {
      "utf8": "about. If you claimed your benefit within the last twelve months and you now realize"
    } ]
  }, {
    "tStartMs": 509790,
    "dDurationMs": 5861,
    "segs": [ {
      "utf8": "you started too early, you can formally withdraw your application, pay back what you received,"
    } ]
  }, {
    "tStartMs": 516052,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "and reset as if you never claimed, which lets you start over and claim a"
    } ]
  }, {
    "tStartMs": 520572,
    "dDurationMs": 1081,
    "segs": [ {
      "utf8": "larger amount later."
    } ]
  }, {
    "tStartMs": 522393,
    "dDurationMs": 5481,
    "segs": [ {
      "utf8": "And separately, once you reach full retirement age, even if you are already collecting, you"
    } ]
  }, {
    "tStartMs": 527874,
    "dDurationMs": 4221,
    "segs": [ {
      "utf8": "can ask the government to suspend your benefit and let it grow by that eight"
    } ]
  }, {
    "tStartMs": 532095,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "percent a year until seventy."
    } ]
  }, {
    "tStartMs": 534335,
    "dDurationMs": 5202,
    "segs": [ {
      "utf8": "Two different doors, both of which let you undo an early decision, and almost nobody"
    } ]
  }, {
    "tStartMs": 539537,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "knows either one exists."
    } ]
  }, {
    "tStartMs": 541697,
    "dDurationMs": 4301,
    "segs": [ {
      "utf8": "Let me bring all seven together, because the thread is the same one that runs"
    } ]
  }, {
    "tStartMs": 545998,
    "dDurationMs": 4501,
    "segs": [ {
      "utf8": "through everything. The claiming age sets the size of your check for life."
    } ]
  }, {
    "tStartMs": 551139,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "The earnings test is a delay, not a loss."
    } ]
  }, {
    "tStartMs": 554760,
    "dDurationMs": 3761,
    "segs": [ {
      "utf8": "Your earnings record may contain errors that are costing you right now."
    } ]
  }, {
    "tStartMs": 559081,
    "dDurationMs": 3221,
    "segs": [ {
      "utf8": "Missing work years drag your benefit down with zeros."
    } ]
  }, {
    "tStartMs": 563042,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "A spousal benefit may be worth far more than your own."
    } ]
  }, {
    "tStartMs": 566943,
    "dDurationMs": 5121,
    "segs": [ {
      "utf8": "Survivor and divorced spouse benefits are sitting unclaimed by the people who earned them."
    } ]
  }, {
    "tStartMs": 572724,
    "dDurationMs": 4621,
    "segs": [ {
      "utf8": "And a brand new law is owed to millions who spent their lives serving their"
    } ]
  }, {
    "tStartMs": 577345,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "communities. Not one of these is a loophole."
    } ]
  }, {
    "tStartMs": 581146,
    "dDurationMs": 4521,
    "segs": [ {
      "utf8": "Every one of them is money you earned, sitting inside a system that pays you"
    } ]
  }, {
    "tStartMs": 585667,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "what you ask for and stays silent about the rest."
    } ]
  }, {
    "tStartMs": 589347,
    "dDurationMs": 4021,
    "segs": [ {
      "utf8": "Nobody from the government is going to call you and tell you that you claimed"
    } ]
  }, {
    "tStartMs": 593368,
    "dDurationMs": 4901,
    "segs": [ {
      "utf8": "too early, or that your record has a missing year, or that you qualify for"
    } ]
  }, {
    "tStartMs": 598269,
    "dDurationMs": 5281,
    "segs": [ {
      "utf8": "a benefit on a former spouse, or that the law just changed in your favor."
    } ]
  }, {
    "tStartMs": 604371,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The Social Security Administration processes what you submit."
    } ]
  }, {
    "tStartMs": 608692,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The rest is on you to know and to ask for."
    } ]
  }, {
    "tStartMs": 612772,
    "dDurationMs": 5122,
    "segs": [ {
      "utf8": "So before you claim, and even if you have already claimed, sit down with your"
    } ]
  }, {
    "tStartMs": 617894,
    "dDurationMs": 5461,
    "segs": [ {
      "utf8": "earnings record and the real numbers, and if it is at all complicated, talk to"
    } ]
  }, {
    "tStartMs": 623355,
    "dDurationMs": 4541,
    "segs": [ {
      "utf8": "a fee only fiduciary adviser who can run your specific situation."
    } ]
  }, {
    "tStartMs": 628656,
    "dDurationMs": 4641,
    "segs": [ {
      "utf8": "I will put the things to ask about and the details in the description below."
    } ]
  }, {
    "tStartMs": 633477,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "So do one thing for me."
    } ]
  }, {
    "tStartMs": 635838,
    "dDurationMs": 4721,
    "segs": [ {
      "utf8": "Send this to one person you care about who is on Social Security or getting"
    } ]
  }, {
    "tStartMs": 640559,
    "dDurationMs": 1020,
    "segs": [ {
      "utf8": "close to it."
    } ]
  }, {
    "tStartMs": 641779,
    "dDurationMs": 6121,
    "segs": [ {
      "utf8": "A parent, a sibling, a friend, the widow down the street, the recently divorced woman"
    } ]
  }, {
    "tStartMs": 647900,
    "dDurationMs": 4321,
    "segs": [ {
      "utf8": "at church, the retired teacher who was always told her benefit would be cut."
    } ]
  }, {
    "tStartMs": 652921,
    "dDurationMs": 4201,
    "segs": [ {
      "utf8": "The chances are very good that at least one of these seven things applies to"
    } ]
  }, {
    "tStartMs": 657122,
    "dDurationMs": 4401,
    "segs": [ {
      "utf8": "them right now, and one share from you could put real money back where it"
    } ]
  }, {
    "tStartMs": 661523,
    "dDurationMs": 3281,
    "segs": [ {
      "utf8": "belongs, in their hands, for the rest of their life."
    } ]
  }, {
    "tStartMs": 665524,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "That is what we are here for."
    } ]
  }, {
    "tStartMs": 668004,
    "dDurationMs": 1521,
    "segs": [ {
      "utf8": "I will see you in the next one."
    } ]
  } ]
}
