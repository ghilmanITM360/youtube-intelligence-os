{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "If you were born in the first ten days of\nany month, your November money comes"
    } ]
  }, {
    "tStartMs": 5340,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "on Tuesday the tenth. Not Wednesday."
    } ]
  }, {
    "tStartMs": 8540,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "One day early, because the eleventh is\nVeterans Day, and a payment never waits"
    } ]
  }, {
    "tStartMs": 13660,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "for a holiday. It moves back."
    } ]
  }, {
    "tStartMs": 16580,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Here are the other four, and then I am\ndone with dates."
    } ]
  }, {
    "tStartMs": 19780,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "If you get the extra payment for people\nwith very little income, yours already"
    } ]
  }, {
    "tStartMs": 24240,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "arrived, on the thirtieth of October."
    } ]
  }, {
    "tStartMs": 27060,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The first of November was a Sunday, so it\nmoved back too."
    } ]
  }, {
    "tStartMs": 31580,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "If you filed before 1997, or you get both\npayments, yours comes on the third."
    } ]
  }, {
    "tStartMs": 37960,
    "dDurationMs": 3775,
    "segs": [ {
      "utf8": "Born from the eleventh to the twentieth,\nWednesday the eighteenth."
    } ]
  }, {
    "tStartMs": 41775,
    "dDurationMs": 2205,
    "segs": [ {
      "utf8": "Born from the twenty first on, Wednesday"
    } ]
  }, {
    "tStartMs": 43980,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "the twenty fifth, the day before\nThanksgiving."
    } ]
  }, {
    "tStartMs": 47060,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "That is all five. Write yours down."
    } ]
  }, {
    "tStartMs": 50220,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "And the raise is not in any of them."
    } ]
  }, {
    "tStartMs": 52860,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "Not one cent of the 3.6%. That starts with\nJanuary money, so if your November"
    } ]
  }, {
    "tStartMs": 58660,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "deposit looks the same as October, nothing\nis wrong."
    } ]
  }, {
    "tStartMs": 62520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Dates done."
    } ]
  }, {
    "tStartMs": 63920,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Here is what actually changed, and I am\nnaming all five now so you know whether"
    } ]
  }, {
    "tStartMs": 67980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to keep watching."
    } ]
  }, {
    "tStartMs": 69540,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "One. Some plans pay part of your Medicare\npremium back into your Social Security"
    } ]
  }, {
    "tStartMs": 73820,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "check."
    } ]
  }, {
    "tStartMs": 74920,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Humana is cutting or ending that payment\nfor 62% of the people who have it."
    } ]
  }, {
    "tStartMs": 80140,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Two. About a million Medicare Advantage\nplans close in January."
    } ]
  }, {
    "tStartMs": 83900,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "600,000 Humana members, 390,000 from\nUnitedHealthcare."
    } ]
  }, {
    "tStartMs": 89780,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "Three. In 16 states, 638,000 people will\nhave no Medicare Advantage drug"
    } ]
  }, {
    "tStartMs": 95820,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "plan they can join at all. Four."
    } ]
  }, {
    "tStartMs": 98500,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "A letter went out by the second of October\nthat told some people their plan"
    } ]
  }, {
    "tStartMs": 102200,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "is ending. It does not look like one."
    } ]
  }, {
    "tStartMs": 104800,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Five. If your plan is one of the ones\nending, you have a window that runs past"
    } ]
  }, {
    "tStartMs": 109220,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "the seventh of December, and most people\ndo not know it exists."
    } ]
  }, {
    "tStartMs": 112880,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "The first three were announced in the last\n4 weeks."
    } ]
  }, {
    "tStartMs": 117280,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "The deadline on most of this is the\nseventh of December, and after that you"
    } ]
  }, {
    "tStartMs": 122280,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "keep what you are holding for all of next\nyear."
    } ]
  }, {
    "tStartMs": 125840,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Two of the five only matter if you are on\na Medicare Advantage plan."
    } ]
  }, {
    "tStartMs": 129940,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "The other three reach you whichever\nMedicare you have."
    } ]
  }, {
    "tStartMs": 133800,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "None of them asks what you earn."
    } ]
  }, {
    "tStartMs": 136540,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "Every figure is from Social Security, from\nMedicare, or from what the insurance"
    } ]
  }, {
    "tStartMs": 141740,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "companies filed themselves."
    } ]
  }, {
    "tStartMs": 144180,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "I cannot see your plan, and your plan\ndecides your own answer."
    } ]
  }, {
    "tStartMs": 148900,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Number one. The Part B give-back, and who\nis losing it."
    } ]
  }, {
    "tStartMs": 153160,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Start with the money that leaves your\ncheck every month before you touch it."
    } ]
  }, {
    "tStartMs": 157580,
    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "$202.90. That is the Medicare Part B\npremium this year, and it is"
    } ]
  }, {
    "tStartMs": 163660,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "taken out of your Social Security before\nthe deposit lands."
    } ]
  }, {
    "tStartMs": 167060,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Some Medicare Advantage plans pay part of\nthat back."
    } ]
  }, {
    "tStartMs": 171340,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Not a discount on the plan. An"
    } ]
  }, {
    "tStartMs": 173540,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "actual amount added back into your Social\nSecurity"
    } ]
  }, {
    "tStartMs": 176440,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "deposit every month. It is written on the\nplan as a Part B premium reduction,"
    } ]
  }, {
    "tStartMs": 181320,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "and people who have it see a bigger number\nin the bank than the person next"
    } ]
  }, {
    "tStartMs": 185780,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "door on the same benefit."
    } ]
  }, {
    "tStartMs": 188120,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "The amounts are not small. One plan for\nnext year, in northern Indiana, puts"
    } ]
  }, {
    "tStartMs": 193360,
    "dDurationMs": 6340,
    "segs": [ {
      "utf8": "$174.90 a month back. That is more than\n$2,000 across"
    } ]
  }, {
    "tStartMs": 199700,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "a year, on a plan with no monthly premium\nof its own."
    } ]
  }, {
    "tStartMs": 204000,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Now the part that is new, and it is the\nreason this is item one."
    } ]
  }, {
    "tStartMs": 208160,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Humana is cutting or removing that payment\nentirely for 62% of the members"
    } ]
  }, {
    "tStartMs": 212840,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "who currently have it. Not a reduction for\neveryone."
    } ]
  }, {
    "tStartMs": 216260,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Nearly two thirds lose it or see it\nshrink."
    } ]
  }, {
    "tStartMs": 219600,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "UnitedHealthcare is cutting it for about\n7% of theirs."
    } ]
  }, {
    "tStartMs": 223280,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "Centene for about 11%. If you chose your\nplan because of that money, and most"
    } ]
  }, {
    "tStartMs": 228540,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "people who have it did, then the reason\nyou chose it may not be there in January."
    } ]
  }, {
    "tStartMs": 233700,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "And here is the thing nobody says about\nthis benefit."
    } ]
  }, {
    "tStartMs": 236760,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Nobody checks your income for it."
    } ]
  }, {
    "tStartMs": 238940,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "Not once. It is not a government program,\nit is a feature a private plan chooses"
    } ]
  }, {
    "tStartMs": 243760,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "to offer, so nobody checks what you earn,\nnobody counts your savings, and there"
    } ]
  }, {
    "tStartMs": 248600,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "is no form to qualify. If a plan in your\narea offers it, you can take it."
    } ]
  }, {
    "tStartMs": 253660,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "So the job this week is one line on one\npage."
    } ]
  }, {
    "tStartMs": 257480,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "Go to medicare.gov, open the plan\ncomparison tool, put in your own zip code,"
    } ]
  }, {
    "tStartMs": 262520,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "and look at each plan for the line that\nsays Part B premium reduction."
    } ]
  }, {
    "tStartMs": 266560,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "If your current plan shows a smaller\nnumber for next year than this year, that"
    } ]
  }, {
    "tStartMs": 270720,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "is the cut, in writing. Or telephone the\nnumber on the back of your card and"
    } ]
  }, {
    "tStartMs": 275260,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "ask them directly. Is my Part B premium\nreduction changing in January, and"
    } ]
  }, {
    "tStartMs": 280300,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "what will the amount be. Make them give\nyou a figure, not a reassurance."
    } ]
  }, {
    "tStartMs": 285240,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Number two. One million plans end in\nJanuary."
    } ]
  }, {
    "tStartMs": 289040,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Humana has said that plan exits for next\nyear will affect about 600,000 of"
    } ]
  }, {
    "tStartMs": 293840,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "its Medicare Advantage members."
    } ]
  }, {
    "tStartMs": 295840,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "That is roughly 8% of everyone it covers."
    } ]
  }, {
    "tStartMs": 299160,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "UnitedHealthcare has confirmed about\n390,000"
    } ]
  }, {
    "tStartMs": 302220,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "members are in plans being discontinued,"
    } ]
  }, {
    "tStartMs": 304460,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "and most of those are the kind that let\nyou go outside the network."
    } ]
  }, {
    "tStartMs": 308480,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "Together that is close to a million people\nwhose plan stops existing on the"
    } ]
  }, {
    "tStartMs": 313220,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "thirty first of December. Let me be\naccurate about what that does and does"
    } ]
  }, {
    "tStartMs": 317160,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "not mean, because the headline has been\nread wrongly in a lot of places."
    } ]
  }, {
    "tStartMs": 322040,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "It does not mean a million people lose\ntheir health coverage."
    } ]
  }, {
    "tStartMs": 325440,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Humana has said most of its affected\nmembers will have another Humana plan"
    } ]
  }, {
    "tStartMs": 329220,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "available to them. What it means is that\nthe specific plan you are on, with"
    } ]
  }, {
    "tStartMs": 334020,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "its specific doctors, its specific drug\nlist and its specific extras, ends."
    } ]
  }, {
    "tStartMs": 339680,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Something else replaces it, and the\nsomething else is not the same."
    } ]
  }, {
    "tStartMs": 343800,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "That is the part that costs money."
    } ]
  }, {
    "tStartMs": 346080,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "Your doctor may not be in the new network."
    } ]
  }, {
    "tStartMs": 348320,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Your medicine may sit on a different tier."
    } ]
  }, {
    "tStartMs": 350940,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "The dental or the hearing allowance you\nwere using may be smaller or gone."
    } ]
  }, {
    "tStartMs": 355980,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Aetna and Centene are pulling back as\nwell."
    } ]
  }, {
    "tStartMs": 358120,
    "dDurationMs": 6340,
    "segs": [ {
      "utf8": "And the total number of plans across the\ncountry barely drops, from about 5,553"
    } ]
  }, {
    "tStartMs": 364460,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "this year to about 5,532 next year."
    } ]
  }, {
    "tStartMs": 368920,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "So this is not plans vanishing from the\nmap."
    } ]
  }, {
    "tStartMs": 372000,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "It is plans being closed and reshaped, and\nthe reshaping is where you lose"
    } ]
  }, {
    "tStartMs": 376240,
    "dDurationMs": 5170,
    "segs": [ {
      "utf8": "things. The action is the same page as\nitem one, and you do it before the seventh"
    } ]
  }, {
    "tStartMs": 381450,
    "dDurationMs": 3250,
    "segs": [ {
      "utf8": "of December. Put your own medicines and\nyour own doctors in."
    } ]
  }, {
    "tStartMs": 385120,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Not the plan name. The doctors and the\nmedicines."
    } ]
  }, {
    "tStartMs": 387960,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "That is the only comparison that tells you\nanything."
    } ]
  }, {
    "tStartMs": 391420,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Number three. The counties with no drug\nplan left."
    } ]
  }, {
    "tStartMs": 394820,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "This one is the hardest number in the"
    } ]
  }, {
    "tStartMs": 396300,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "video, and it comes from an outside\nanalysis,"
    } ]
  }, {
    "tStartMs": 399160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "not from a company."
    } ]
  }, {
    "tStartMs": 400880,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "In 193 counties across 16 states, there\nwill be no Medicare Advantage plan"
    } ]
  }, {
    "tStartMs": 405920,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "with drug coverage that is open to general\nenrollment next year."
    } ]
  }, {
    "tStartMs": 409900,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "None."
    } ]
  }, {
    "tStartMs": 411200,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "638,000 people live in those counties."
    } ]
  }, {
    "tStartMs": 414220,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "Last year that figure was 399,000 people\nin 123 counties."
    } ]
  }, {
    "tStartMs": 419880,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "So it has grown by well over half in 12\nmonths, and it is concentrated in rural"
    } ]
  }, {
    "tStartMs": 424700,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "places. If you are in one of those\ncounties, the Medicare Advantage route to"
    } ]
  }, {
    "tStartMs": 429900,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "drug coverage is closed to you."
    } ]
  }, {
    "tStartMs": 432540,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "That does not leave you without medicine\ncoverage."
    } ]
  }, {
    "tStartMs": 435460,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "It means your route changes. You go to\nOriginal Medicare and you buy a standalone"
    } ]
  }, {
    "tStartMs": 441100,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "drug plan to sit alongside it, and those\nstandalone plans are still available"
    } ]
  }, {
    "tStartMs": 445680,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "everywhere. But you have to actually do\nit, and the people most likely to be"
    } ]
  }, {
    "tStartMs": 451160,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "caught are the ones who assume that\nbecause they had a plan this year, there"
    } ]
  }, {
    "tStartMs": 454920,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "will be one next year. So if you live\nsomewhere rural, do not assume."
    } ]
  }, {
    "tStartMs": 460180,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Check the plan tool for your own zip code\nbefore December,"
    } ]
  }, {
    "tStartMs": 463900,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "and if the drug plan list comes back\nempty, that is not a website fault."
    } ]
  }, {
    "tStartMs": 468360,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "That is the answer, and your next step is\na standalone drug plan."
    } ]
  }, {
    "tStartMs": 472560,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Number four. The letter that came by the\nsecond of October."
    } ]
  }, {
    "tStartMs": 476500,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "Every plan that is closing had to mail a\nnotice to its members by the second"
    } ]
  }, {
    "tStartMs": 480580,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "of October. It is called a non renewal\nnotice."
    } ]
  }, {
    "tStartMs": 484220,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Here is why I am giving it a whole item."
    } ]
  }, {
    "tStartMs": 486540,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "It arrives in a plain envelope from your\ninsurance company, in the same month"
    } ]
  }, {
    "tStartMs": 491200,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "as a pile of other plan post, and it does\nnot say your plan is being cancelled"
    } ]
  }, {
    "tStartMs": 495800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "in large letters on the outside."
    } ]
  }, {
    "tStartMs": 498160,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "People open the marketing and throw out\nthe rest."
    } ]
  }, {
    "tStartMs": 500900,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "If you threw it away, or if it is still in\na pile on the side, you may not"
    } ]
  }, {
    "tStartMs": 505160,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "know that your plan ends on the thirty\nfirst of December."
    } ]
  }, {
    "tStartMs": 508100,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "And the first time you find out will be at\na pharmacy counter or a doctor reception"
    } ]
  }, {
    "tStartMs": 512800,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "in January. So go and look. Anything from\nyour Medicare plan that arrived in"
    } ]
  }, {
    "tStartMs": 517960,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "the last 4 weeks, open it. You are looking\nfor two phrases."
    } ]
  }, {
    "tStartMs": 522360,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Non renewal, and will not be offered in\nyour area."
    } ]
  }, {
    "tStartMs": 525480,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Either of those means your plan is ending."
    } ]
  }, {
    "tStartMs": 527840,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "If you cannot find the mail, telephone the\nplan and ask one question."
    } ]
  }, {
    "tStartMs": 532180,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Is my plan being offered in my area next\nyear, yes or no."
    } ]
  }, {
    "tStartMs": 535640,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "They have to tell you. And if you are the\nson or daughter watching this, this"
    } ]
  }, {
    "tStartMs": 539400,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "is the single most useful thing you can do\nfor a parent this month."
    } ]
  }, {
    "tStartMs": 543220,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Ask to see their Medicare mail from this\nmonth."
    } ]
  }, {
    "tStartMs": 545980,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Not next month. Number five. The window\nthat runs past the seventh of December."
    } ]
  }, {
    "tStartMs": 551660,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Now the one item that is a right you\nalready hold, not something taken."
    } ]
  }, {
    "tStartMs": 555360,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "Everybody is told that the seventh of\nDecember is the last day to change a"
    } ]
  }, {
    "tStartMs": 559900,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Medicare plan. For most people that is\ntrue."
    } ]
  }, {
    "tStartMs": 562540,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "But if your plan is one of the ones being\nclosed, it is not true for you."
    } ]
  }, {
    "tStartMs": 567240,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "You get a longer window, and it exists\nprecisely because the plan ended on"
    } ]
  }, {
    "tStartMs": 571080,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "you and not the other way round."
    } ]
  }, {
    "tStartMs": 573440,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "That window runs from the eighth of\nDecember to the last day of February."
    } ]
  }, {
    "tStartMs": 577940,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Inside it you can pick a new Medicare\nAdvantage plan, or a standalone drug"
    } ]
  }, {
    "tStartMs": 582080,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "plan, and you are not limited to the\nnormal deadline."
    } ]
  }, {
    "tStartMs": 585740,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Two timing details that matter and that\nnobody explains."
    } ]
  }, {
    "tStartMs": 589340,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "If you choose by the thirty first of\nDecember, your new cover starts on the"
    } ]
  }, {
    "tStartMs": 593100,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "first of January, with no gap."
    } ]
  }, {
    "tStartMs": 595240,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "If you leave it until January or February,\nthe new cover starts the first of"
    } ]
  }, {
    "tStartMs": 600080,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "the month after you ask, which means you\ncan be left with a gap of weeks."
    } ]
  }, {
    "tStartMs": 604620,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "So the window is real, but using it late\ncosts you."
    } ]
  }, {
    "tStartMs": 608900,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "And there is one more right sitting\nunderneath it."
    } ]
  }, {
    "tStartMs": 611940,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "When a plan is withdrawn from you, that\ncan also open a guaranteed right to"
    } ]
  }, {
    "tStartMs": 616020,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "buy a Medigap policy, which is the cover\nthat sits beside Original Medicare,"
    } ]
  }, {
    "tStartMs": 620520,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "without being asked a single health\nquestion."
    } ]
  }, {
    "tStartMs": 623280,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Outside those protected windows, a Medigap\ncompany can ask about your health"
    } ]
  }, {
    "tStartMs": 627200,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "and charge you more for it or turn you\ndown."
    } ]
  }, {
    "tStartMs": 630400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Inside one, it cannot."
    } ]
  }, {
    "tStartMs": 632640,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "That right does not apply to every\nsituation, so you confirm yours before you"
    } ]
  }, {
    "tStartMs": 636780,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "rely on it. The free advice service in\nyour own state will tell you in one"
    } ]
  }, {
    "tStartMs": 641060,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "call, and they do not sell plans."
    } ]
  }, {
    "tStartMs": 643780,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Ask Medicare to put you through to the\nfree counseling office for your own"
    } ]
  }, {
    "tStartMs": 647280,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "state. So that is the five. The give-back\nbeing cut."
    } ]
  }, {
    "tStartMs": 651300,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "A million plans closing. 16 states with no\nMedicare Advantage drug plan."
    } ]
  }, {
    "tStartMs": 655980,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The letter from the second of October."
    } ]
  }, {
    "tStartMs": 658020,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "And the window that runs to the end of\nFebruary if your plan was one of the"
    } ]
  }, {
    "tStartMs": 661420,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "ones that closed. Four of them are things\nbeing taken."
    } ]
  }, {
    "tStartMs": 664740,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "One of them is a right you already have."
    } ]
  }, {
    "tStartMs": 666540,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "And the dates at the top are the easy\npart."
    } ]
  }, {
    "tStartMs": 669140,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "If you only do one thing this week, find\nyour Medicare mail from the last 4 weeks"
    } ]
  }, {
    "tStartMs": 673460,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "and open all of it. That is where you find\nout whether any of this is yours,"
    } ]
  }, {
    "tStartMs": 677720,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "and it costs nothing but 20 minutes at the\nkitchen table."
    } ]
  }, {
    "tStartMs": 681920,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "This is education and nothing more."
    } ]
  }, {
    "tStartMs": 684120,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Your plan, your zip code and your"
    } ]
  }, {
    "tStartMs": 685820,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "medicines decide your own answer, and I\ncan"
    } ]
  }, {
    "tStartMs": 688620,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "see none of the three. And if your mother\nor father is on one of these plans,"
    } ]
  }, {
    "tStartMs": 692840,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "do not forward them this video."
    } ]
  }, {
    "tStartMs": 694260,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "Go and sit with them and open the envelope\ntogether."
    } ]
  } ]
}
