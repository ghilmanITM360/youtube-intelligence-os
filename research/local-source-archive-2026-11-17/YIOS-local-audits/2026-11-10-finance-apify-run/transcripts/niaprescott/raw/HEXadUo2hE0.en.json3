{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "If you are past sixty five, there is a\nvery real chance you paid a bill this"
    } ]
  }, {
    "tStartMs": 5160,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "month that the law does not require you to\npay."
    } ]
  }, {
    "tStartMs": 8600,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "You paid it last month as well."
    } ]
  }, {
    "tStartMs": 10540,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "And the month before that, and most likely\nevery month for the last several"
    } ]
  }, {
    "tStartMs": 14740,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "years. That money is gone. Nobody is\nholding it for you."
    } ]
  }, {
    "tStartMs": 19180,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "There is no notice coming and no refund\nwaiting, because the offices collecting"
    } ]
  }, {
    "tStartMs": 23800,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "it have no legal duty to tell you that you\nstopped owing it the day you turned"
    } ]
  }, {
    "tStartMs": 28780,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "sixty five."
    } ]
  }, {
    "tStartMs": 30220,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "Their job is to collect. Telling you to\nstop is not part of that job and never"
    } ]
  }, {
    "tStartMs": 35380,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "has been."
    } ]
  }, {
    "tStartMs": 36680,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "I want to be blunt about that,"
    } ]
  }, {
    "tStartMs": 38040,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "because it is the single most expensive\nmisunderstanding"
    } ]
  }, {
    "tStartMs": 41100,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "I see on this channel."
    } ]
  }, {
    "tStartMs": 43360,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "Turning sixty five did not only make you\neligible for Medicare."
    } ]
  }, {
    "tStartMs": 47100,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "It moved you into a different category,\nand several agencies are required to"
    } ]
  }, {
    "tStartMs": 51460,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "treat you differently now."
    } ]
  }, {
    "tStartMs": 53500,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Almost all of them simply wait to be\nasked, and most people never ask."
    } ]
  }, {
    "tStartMs": 57740,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Six of them. Number six takes one letter."
    } ]
  }, {
    "tStartMs": 60920,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Number one is worth roughly two thousand\ndollars a year and it has a deadline"
    } ]
  }, {
    "tStartMs": 65080,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "that almost nobody hears about."
    } ]
  }, {
    "tStartMs": 67360,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Let us start. Number six. Jury duty."
    } ]
  }, {
    "tStartMs": 70960,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Every county keeps a list of names, and\nyours stays on it long after most people"
    } ]
  }, {
    "tStartMs": 75240,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "assume it has been taken off. The summons\narrives."
    } ]
  }, {
    "tStartMs": 78560,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "You arrange a ride, you move a doctor\nappointment, you sit in a room for a"
    } ]
  }, {
    "tStartMs": 82740,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "day, because you believe you have no\nchoice in the matter."
    } ]
  }, {
    "tStartMs": 86320,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "In most states you do have a choice once\nyou pass a certain age, and that age"
    } ]
  }, {
    "tStartMs": 90480,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "is commonly sixty five or seventy."
    } ]
  }, {
    "tStartMs": 93400,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "Some states excuse you permanently once\nyou ask."
    } ]
  }, {
    "tStartMs": 96300,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Others excuse you for a term of years and\nthen ask again."
    } ]
  }, {
    "tStartMs": 100000,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "A few want a doctor to sign something."
    } ]
  }, {
    "tStartMs": 102200,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Many want nothing more than your date of\nbirth on a line."
    } ]
  }, {
    "tStartMs": 105180,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "The form is usually printed on the back of\nthe summons itself, in small type,"
    } ]
  }, {
    "tStartMs": 110940,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "inside a box most people never turn over\nto read."
    } ]
  }, {
    "tStartMs": 115140,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Look for the word exemption or the word\nexcusal."
    } ]
  }, {
    "tStartMs": 119440,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "If it is not printed there, the clerk of\ncourt in your county can tell you"
    } ]
  }, {
    "tStartMs": 123920,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "in one phone call, and that call takes\nabout four minutes."
    } ]
  }, {
    "tStartMs": 128400,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "None of this is automatic. The county does\nnot check ages and remove people."
    } ]
  }, {
    "tStartMs": 133980,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "The list is the list until somebody asks\nto come off it."
    } ]
  }, {
    "tStartMs": 137720,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "Number five."
    } ]
  }, {
    "tStartMs": 139820,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "The trash fee on your county bill."
    } ]
  }, {
    "tStartMs": 142680,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Find the bill your county sends for solid\nwaste, refuse collection, or sanitation."
    } ]
  }, {
    "tStartMs": 148420,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "In many counties there is a reduction for\nresidents past a certain age, and"
    } ]
  }, {
    "tStartMs": 152980,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "in a fair number there is a full waiver."
    } ]
  }, {
    "tStartMs": 155880,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "It can run eighty to four hundred dollars\na year depending on where you live."
    } ]
  }, {
    "tStartMs": 160740,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "It is almost never printed on the bill\nitself."
    } ]
  }, {
    "tStartMs": 164180,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "It sits on the county website under"
    } ]
  }, {
    "tStartMs": 166420,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "a heading like senior exemption, age\nexemption,"
    } ]
  }, {
    "tStartMs": 169780,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "or hardship relief, and it is claimed by\nfilling in a single page and showing"
    } ]
  }, {
    "tStartMs": 175360,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "proof of age and proof of address."
    } ]
  }, {
    "tStartMs": 177780,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Some counties take it over the counter the\nsame day."
    } ]
  }, {
    "tStartMs": 180900,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Now the part that stings. Most counties do\nnot backdate it."
    } ]
  }, {
    "tStartMs": 185680,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "You are exempt from the day they process\nyour form and not one day before."
    } ]
  }, {
    "tStartMs": 190860,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Every month you spend meaning to get\naround to it is another month you paid"
    } ]
  }, {
    "tStartMs": 195000,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "for something you did not owe, and that\nmoney is not recoverable."
    } ]
  }, {
    "tStartMs": 199380,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Number four. Your vehicle inspection."
    } ]
  }, {
    "tStartMs": 202700,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "If your state requires a safety inspection\nor an emissions test before you"
    } ]
  }, {
    "tStartMs": 207160,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "can renew your registration,"
    } ]
  }, {
    "tStartMs": 209180,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "check whether you are still required to\nhave one at all."
    } ]
  }, {
    "tStartMs": 212260,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "Many states exempt vehicles past a certain\nage from emissions testing."
    } ]
  }, {
    "tStartMs": 217860,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Several exempt drivers who report very low\nannual mileage."
    } ]
  }, {
    "tStartMs": 221780,
    "dDurationMs": 5560,
    "segs": [ {
      "utf8": "A number of rural counties are exempt\nentirely because the testing requirement"
    } ]
  }, {
    "tStartMs": 227340,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "was written for metropolitan areas and\nnever applied outside them."
    } ]
  }, {
    "tStartMs": 232020,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "And some states have dropped safety\ninspections completely in the last few"
    } ]
  }, {
    "tStartMs": 236120,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "years while people carried on booking them\nout of habit."
    } ]
  }, {
    "tStartMs": 240140,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "People keep paying for a test the vehicle\nno longer needs, because the reminder"
    } ]
  }, {
    "tStartMs": 244760,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "still arrives every year. That reminder is\ngenerated by a schedule."
    } ]
  }, {
    "tStartMs": 248980,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "No person reviews your file to see whether\nyou fell outside the requirement"
    } ]
  }, {
    "tStartMs": 253460,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "two years ago and nobody is going to write\nand tell you."
    } ]
  }, {
    "tStartMs": 257520,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "Your state motor vehicle department lists\nevery exemption on its own website"
    } ]
  }, {
    "tStartMs": 262640,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "under inspection requirements."
    } ]
  }, {
    "tStartMs": 265440,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Read that list before you pay for the next\none, and if your vehicle is on it,"
    } ]
  }, {
    "tStartMs": 270160,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "the money stops this year rather than\nnext."
    } ]
  }, {
    "tStartMs": 273780,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Number three. Your registration and your\nplate renewal."
    } ]
  }, {
    "tStartMs": 277360,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "This is the one people ask me about most,\nand I am going to be straight with"
    } ]
  }, {
    "tStartMs": 282120,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "you rather than sell you something that\ndoes not exist."
    } ]
  }, {
    "tStartMs": 286060,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "There is no state that hands every senior\na free vehicle registration."
    } ]
  }, {
    "tStartMs": 290780,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "What exists is narrower than that, and it\nis still real money every year."
    } ]
  }, {
    "tStartMs": 295980,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Some states reduce the registration fee\nonce you reach a set birthday."
    } ]
  }, {
    "tStartMs": 300440,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Some waive it entirely for a disabled\nveteran, and a number of those states"
    } ]
  }, {
    "tStartMs": 304680,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "extend the same waiver to a surviving\nspouse who never knew to claim it."
    } ]
  }, {
    "tStartMs": 309940,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Several states offer a reduced or free\ndisability plate or placard, and that"
    } ]
  }, {
    "tStartMs": 314800,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "placard can also remove parking charges\nyou are paying now in your own town."
    } ]
  }, {
    "tStartMs": 319840,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The one almost nobody checks is this."
    } ]
  }, {
    "tStartMs": 323000,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "If there is a second vehicle you no longer\ndrive, sitting in the driveway or"
    } ]
  }, {
    "tStartMs": 327640,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "the garage, you can surrender the plate\nand stop the registration charge on"
    } ]
  }, {
    "tStartMs": 332400,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "it entirely."
    } ]
  }, {
    "tStartMs": 334180,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "People keep paying year after year because\ncancelling sounds like paperwork."
    } ]
  }, {
    "tStartMs": 339500,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "It is one form at the motor vehicle office\nand it ends the charge that same"
    } ]
  }, {
    "tStartMs": 344260,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "day."
    } ]
  }, {
    "tStartMs": 345380,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "I have watched people pay to register a\ncar they have not started in three"
    } ]
  }, {
    "tStartMs": 350000,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "years. Not because they wanted to keep it\non the road."
    } ]
  }, {
    "tStartMs": 353700,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "Because the renewal notice arrived, and\npaying it took four minutes, and asking"
    } ]
  }, {
    "tStartMs": 358600,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "the question took longer than that."
    } ]
  }, {
    "tStartMs": 361120,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Number two. The part of your Medicare\npremium a plan can pay back."
    } ]
  }, {
    "tStartMs": 366700,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Some Medicare Advantage plans reduce what\ncomes out of your Social Security"
    } ]
  }, {
    "tStartMs": 371340,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "deposit for your Part B premium."
    } ]
  }, {
    "tStartMs": 374560,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "The plan covers a portion of that premium\nand your monthly deposit rises by"
    } ]
  }, {
    "tStartMs": 379500,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "that amount. In some counties it is a\nsmall amount."
    } ]
  }, {
    "tStartMs": 383080,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "In others it is most of the premium."
    } ]
  }, {
    "tStartMs": 386320,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "I am not going to tell you to take one."
    } ]
  }, {
    "tStartMs": 389380,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "These plans are not offered everywhere,"
    } ]
  }, {
    "tStartMs": 392040,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "and a plan that returns part of your"
    } ]
  }, {
    "tStartMs": 393920,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "premium may have a shorter list of\ndoctors,"
    } ]
  }, {
    "tStartMs": 397300,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "different rules about seeing a specialist,\nor different costs when you need"
    } ]
  }, {
    "tStartMs": 401260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a hospital."
    } ]
  }, {
    "tStartMs": 402820,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "That is a comparison you make with your\nown doctors written down in front of"
    } ]
  }, {
    "tStartMs": 406620,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "you. But it is money, it is decided during\nthe enrollment window each fall,"
    } ]
  }, {
    "tStartMs": 411800,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "and most people never once look at whether\nany plan in their own county offers"
    } ]
  }, {
    "tStartMs": 416680,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "it. Your state health insurance assistance\nprogram will sit down and compare"
    } ]
  }, {
    "tStartMs": 421520,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "the plans with you at no charge, and they\ndo not sell anything."
    } ]
  }, {
    "tStartMs": 426040,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Number one."
    } ]
  }, {
    "tStartMs": 427700,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "Your Part B premium paid for you, even\nwhen you are certain you earn too much."
    } ]
  }, {
    "tStartMs": 433080,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "This is the one that costs people the\nmost, and the reason is a single number"
    } ]
  }, {
    "tStartMs": 438540,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "repeated everywhere until it becomes the\nonly number anybody remembers."
    } ]
  }, {
    "tStartMs": 443540,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Your state runs programs that pay your\nPart B premium."
    } ]
  }, {
    "tStartMs": 448080,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "There are three levels of them, and almost\neveryone has heard only the first."
    } ]
  }, {
    "tStartMs": 452560,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "For a single person in two thousand and\ntwenty six, the first level stops at"
    } ]
  }, {
    "tStartMs": 458220,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "one thousand three hundred and fifty\ndollars a month of income."
    } ]
  }, {
    "tStartMs": 461640,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "That is the figure people carry in their\nheads, and it is the figure that makes"
    } ]
  }, {
    "tStartMs": 466120,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "them decide they earn too much and never\napply."
    } ]
  }, {
    "tStartMs": 469680,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "The second level goes up to one thousand\nsix hundred and sixteen dollars a"
    } ]
  }, {
    "tStartMs": 473800,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "month. The third level goes up to one\nthousand eight hundred and sixteen dollars"
    } ]
  }, {
    "tStartMs": 478320,
    "dDurationMs": 4835,
    "segs": [ {
      "utf8": "a month. For a married couple the third\nlevel reaches two thousand four hundred"
    } ]
  }, {
    "tStartMs": 483195,
    "dDurationMs": 1845,
    "segs": [ {
      "utf8": "and fifty five dollars a month."
    } ]
  }, {
    "tStartMs": 485600,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "So a widow bringing in seventeen hundred a\nmonth hears the first figure, decides"
    } ]
  }, {
    "tStartMs": 490680,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "she is over the line, and keeps paying\nthat premium out of every single deposit"
    } ]
  }, {
    "tStartMs": 495140,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "for years."
    } ]
  }, {
    "tStartMs": 496700,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "She was inside the third level the entire\ntime and nobody told her the other"
    } ]
  }, {
    "tStartMs": 500980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "two levels existed."
    } ]
  }, {
    "tStartMs": 502840,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "The resource limit on all three is nine\nthousand nine hundred and fifty dollars"
    } ]
  }, {
    "tStartMs": 507120,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "for one person and fourteen thousand nine\nhundred and ten for a couple."
    } ]
  }, {
    "tStartMs": 512340,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Your house is not counted. Your car is not\ncounted."
    } ]
  }, {
    "tStartMs": 516380,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Now the part with the deadline on it."
    } ]
  }, {
    "tStartMs": 518620,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "That third level is funded in a fixed\namount each year, and the states approve"
    } ]
  }, {
    "tStartMs": 522880,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "it first come, first served. Priority goes\nto the people who already had it"
    } ]
  }, {
    "tStartMs": 527580,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "the year before. You also have to apply\nagain every single year to keep it."
    } ]
  }, {
    "tStartMs": 532900,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Miss your application and your place goes\nto somebody else, and you wait until"
    } ]
  }, {
    "tStartMs": 537400,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "the following year to try again."
    } ]
  }, {
    "tStartMs": 539900,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Medicare states it plainly on its own\npage."
    } ]
  }, {
    "tStartMs": 542740,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Even if you do not think you qualify,\napply anyway, because several states"
    } ]
  }, {
    "tStartMs": 547220,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "do not count certain kinds of income or\ncertain resources at all, which means"
    } ]
  }, {
    "tStartMs": 551900,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "the real limit where you live can sit\nhigher than the printed federal one."
    } ]
  }, {
    "tStartMs": 556100,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "There is one more thing attached to all\nthree levels."
    } ]
  }, {
    "tStartMs": 560160,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Everyone approved also receives help with\nprescription costs, and no covered"
    } ]
  }, {
    "tStartMs": 564480,
    "dDurationMs": 3931,
    "segs": [ {
      "utf8": "drug costs more than twelve dollars and\nsixty five cents in two thousand and"
    } ]
  }, {
    "tStartMs": 568451,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "twenty six."
    } ]
  }, {
    "tStartMs": 570060,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Sit with that for a moment. Somebody\nreading the first figure and walking away"
    } ]
  }, {
    "tStartMs": 574260,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "is not only paying a premium they do not\nowe."
    } ]
  }, {
    "tStartMs": 577300,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "They are also paying full price at the\npharmacy counter every month on top"
    } ]
  }, {
    "tStartMs": 580940,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "of it, for the same reason, because of the\nsame single number."
    } ]
  }, {
    "tStartMs": 584960,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And there is no mechanism anywhere that\ncatches this."
    } ]
  }, {
    "tStartMs": 588540,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "The state does not compare your income\nagainst the second and third levels"
    } ]
  }, {
    "tStartMs": 592180,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "and write to you. Social Security does not\nflag it."
    } ]
  }, {
    "tStartMs": 595780,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Your plan does not mention it."
    } ]
  }, {
    "tStartMs": 597760,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "The only event that starts any of it is\nyou picking up a telephone."
    } ]
  }, {
    "tStartMs": 602220,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "I want to put a figure on the delay,\nbecause delay is the whole cost here."
    } ]
  }, {
    "tStartMs": 606900,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "The Part B premium comes out of your\ndeposit every month whether you asked"
    } ]
  }, {
    "tStartMs": 610780,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "for it or not. A year of not making the\ncall is roughly two thousand dollars,"
    } ]
  }, {
    "tStartMs": 615360,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "plus whatever you paid at the pharmacy\nthat you did not have to."
    } ]
  }, {
    "tStartMs": 619040,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Two years is double. Nobody sends any of\nit back."
    } ]
  }, {
    "tStartMs": 623700,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Now put the six together, in the order\nthat costs you least to act on."
    } ]
  }, {
    "tStartMs": 628080,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Turn over your next jury summons and read\nthe box on the back."
    } ]
  }, {
    "tStartMs": 631720,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Open your county website and search the\nwords senior exemption next to solid"
    } ]
  }, {
    "tStartMs": 635660,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "waste."
    } ]
  }, {
    "tStartMs": 636940,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Check your state motor vehicle site for\ninspection exemptions, and surrender"
    } ]
  }, {
    "tStartMs": 641100,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "the plate on any vehicle you no longer\ndrive."
    } ]
  }, {
    "tStartMs": 644920,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Then do number one today, because it is\nthe only one of the six with a queue"
    } ]
  }, {
    "tStartMs": 649080,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "in front of it. Your state Medicaid office\nis the one that runs these three"
    } ]
  }, {
    "tStartMs": 653220,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "levels, and the words you need are simple."
    } ]
  }, {
    "tStartMs": 656260,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Tell them you want to file an application\nfor premium help under Medicare."
    } ]
  }, {
    "tStartMs": 661040,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "Do not tell them your income and ask\nwhether you qualify."
    } ]
  }, {
    "tStartMs": 664460,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Ask them to take the application."
    } ]
  }, {
    "tStartMs": 666720,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The determination belongs to them and not\nto you, and people talk themselves"
    } ]
  }, {
    "tStartMs": 671160,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "out of thousands of dollars every year by\ndeciding the answer in advance."
    } ]
  }, {
    "tStartMs": 676280,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Every one of these waits to be asked."
    } ]
  }, {
    "tStartMs": 678600,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Not one of them reaches out. And the\nmonths you spend deciding whether it is"
    } ]
  }, {
    "tStartMs": 682740,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "worth a phone call are months you keep\npaying for something that stopped being"
    } ]
  }, {
    "tStartMs": 686460,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "yours to pay."
    } ]
  }, {
    "tStartMs": 688060,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "This is education, not financial, legal,\nor medical advice."
    } ]
  }, {
    "tStartMs": 692300,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "The limits above are the federal figures\nfor two thousand and twenty six, and"
    } ]
  }, {
    "tStartMs": 696100,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "your own state may set them higher."
    } ]
  }, {
    "tStartMs": 698340,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Send this to the one person you can think\nof who is still paying one of these"
    } ]
  }, {
    "tStartMs": 702200,
    "dDurationMs": 632,
    "segs": [ {
      "utf8": "six."
    } ]
  } ]
}
