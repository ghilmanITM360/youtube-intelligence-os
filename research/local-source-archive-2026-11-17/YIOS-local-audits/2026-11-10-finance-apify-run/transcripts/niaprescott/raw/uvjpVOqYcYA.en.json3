{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 5992,
    "segs": [ {
      "utf8": "Every spring, millions of older Americans hand the I R S more money than the"
    } ]
  }, {
    "tStartMs": 5992,
    "dDurationMs": 1643,
    "segs": [ {
      "utf8": "law actually says they owe."
    } ]
  }, {
    "tStartMs": 8236,
    "dDurationMs": 1163,
    "segs": [ {
      "utf8": "Not because they cheated."
    } ]
  }, {
    "tStartMs": 9860,
    "dDurationMs": 2184,
    "segs": [ {
      "utf8": "Not because they made a mistake on a form."
    } ]
  }, {
    "tStartMs": 12685,
    "dDurationMs": 4790,
    "segs": [ {
      "utf8": "They overpay because the money that was meant to come back to them sits behind"
    } ]
  }, {
    "tStartMs": 17475,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "a door that nobody ever shows them how to open."
    } ]
  }, {
    "tStartMs": 21463,
    "dDurationMs": 1623,
    "segs": [ {
      "utf8": "A credit goes unclaimed."
    } ]
  }, {
    "tStartMs": 23928,
    "dDurationMs": 1704,
    "segs": [ {
      "utf8": "A deduction goes unused."
    } ]
  }, {
    "tStartMs": 26413,
    "dDurationMs": 5491,
    "segs": [ {
      "utf8": "A refund the state is already holding in their own name slips quietly back into"
    } ]
  }, {
    "tStartMs": 31904,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "a government account."
    } ]
  }, {
    "tStartMs": 33908,
    "dDurationMs": 2726,
    "segs": [ {
      "utf8": "And the part that should make you angry is this."
    } ]
  }, {
    "tStartMs": 37536,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "Almost none of these people have the faintest idea it is happening."
    } ]
  }, {
    "tStartMs": 42225,
    "dDurationMs": 1964,
    "segs": [ {
      "utf8": "They assume that if they were owed money,"
    } ]
  }, {
    "tStartMs": 44810,
    "dDurationMs": 2165,
    "segs": [ {
      "utf8": "somebody, somewhere, would have told them."
    } ]
  }, {
    "tStartMs": 47676,
    "dDurationMs": 4750,
    "segs": [ {
      "utf8": "That single assumption is the most expensive thing a senior can believe."
    } ]
  }, {
    "tStartMs": 52807,
    "dDurationMs": 3226,
    "segs": [ {
      "utf8": "Let me give you a picture of how quietly it happens."
    } ]
  }, {
    "tStartMs": 56634,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "Think of a woman who has just turned sixty six."
    } ]
  }, {
    "tStartMs": 60402,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "She lives on her Social Security and a small pension,"
    } ]
  }, {
    "tStartMs": 63869,
    "dDurationMs": 2746,
    "segs": [ {
      "utf8": "she has paid taxes honestly her whole life,"
    } ]
  }, {
    "tStartMs": 67156,
    "dDurationMs": 3627,
    "segs": [ {
      "utf8": "and she does her return the same way she has always done it,"
    } ]
  }, {
    "tStartMs": 70923,
    "dDurationMs": 2145,
    "segs": [ {
      "utf8": "the same way her late husband used to."
    } ]
  }, {
    "tStartMs": 73589,
    "dDurationMs": 942,
    "segs": [ {
      "utf8": "She is careful."
    } ]
  }, {
    "tStartMs": 74912,
    "dDurationMs": 2344,
    "segs": [ {
      "utf8": "She is not careless with a single dollar."
    } ]
  }, {
    "tStartMs": 77898,
    "dDurationMs": 4138,
    "segs": [ {
      "utf8": "And yet this year she will very likely leave a brand new six thousand dollar"
    } ]
  }, {
    "tStartMs": 82036,
    "dDurationMs": 4519,
    "segs": [ {
      "utf8": "deduction sitting on the table, miss a credit that could have come straight off her"
    } ]
  }, {
    "tStartMs": 86555,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "tax, pay a property tax bill that was hundreds of dollars higher than it needed"
    } ]
  }, {
    "tStartMs": 91385,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "to be, and never once learn that her old bank,"
    } ]
  }, {
    "tStartMs": 94912,
    "dDurationMs": 4269,
    "segs": [ {
      "utf8": "the one that closed years ago, turned over money in her name to the state."
    } ]
  }, {
    "tStartMs": 99822,
    "dDurationMs": 1062,
    "segs": [ {
      "utf8": "She is not foolish."
    } ]
  }, {
    "tStartMs": 101445,
    "dDurationMs": 2525,
    "segs": [ {
      "utf8": "She simply trusted that the system would tell her."
    } ]
  }, {
    "tStartMs": 104311,
    "dDurationMs": 882,
    "segs": [ {
      "utf8": "It did not."
    } ]
  }, {
    "tStartMs": 105193,
    "dDurationMs": 1082,
    "segs": [ {
      "utf8": "And there are millions of her."
    } ]
  }, {
    "tStartMs": 106275,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "I want to be very clear about what this is,"
    } ]
  }, {
    "tStartMs": 108941,
    "dDurationMs": 5290,
    "segs": [ {
      "utf8": "because there are channels that will promise you a fake check for some made up"
    } ]
  }, {
    "tStartMs": 114231,
    "dDurationMs": 441,
    "segs": [ {
      "utf8": "amount."
    } ]
  }, {
    "tStartMs": 115293,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "This is not that."
    } ]
  }, {
    "tStartMs": 117177,
    "dDurationMs": 2866,
    "segs": [ {
      "utf8": "Every single thing I am about to show you is real,"
    } ]
  }, {
    "tStartMs": 120404,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "it is written into the law, and it has a name you can look up."
    } ]
  }, {
    "tStartMs": 124652,
    "dDurationMs": 4109,
    "segs": [ {
      "utf8": "The only reason it stays hidden is that the system was built on the quiet"
    } ]
  }, {
    "tStartMs": 128761,
    "dDurationMs": 1864,
    "segs": [ {
      "utf8": "hope that you will never ask."
    } ]
  }, {
    "tStartMs": 131246,
    "dDurationMs": 3627,
    "segs": [ {
      "utf8": "So let me take that hope apart, one piece at a time,"
    } ]
  }, {
    "tStartMs": 134873,
    "dDurationMs": 3046,
    "segs": [ {
      "utf8": "and show you the money that already belongs to you."
    } ]
  }, {
    "tStartMs": 139322,
    "dDurationMs": 3928,
    "segs": [ {
      "utf8": "There are five of these, and I have put them roughly in order,"
    } ]
  }, {
    "tStartMs": 143250,
    "dDurationMs": 3147,
    "segs": [ {
      "utf8": "from the newest one that the most people will miss this year,"
    } ]
  }, {
    "tStartMs": 146397,
    "dDurationMs": 4709,
    "segs": [ {
      "utf8": "all the way to the largest pool of forgotten money in the entire country."
    } ]
  }, {
    "tStartMs": 151767,
    "dDurationMs": 3047,
    "segs": [ {
      "utf8": "That last one is sitting in a government account right now,"
    } ]
  }, {
    "tStartMs": 155375,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "it may very well have your name on it,"
    } ]
  }, {
    "tStartMs": 157419,
    "dDurationMs": 3888,
    "segs": [ {
      "utf8": "and checking it takes about two minutes and costs you nothing."
    } ]
  }, {
    "tStartMs": 161868,
    "dDurationMs": 4770,
    "segs": [ {
      "utf8": "Stay with me until then, because people who were sure they had nothing waiting have"
    } ]
  }, {
    "tStartMs": 166638,
    "dDurationMs": 2765,
    "segs": [ {
      "utf8": "pulled thousands of dollars out of that final one."
    } ]
  }, {
    "tStartMs": 169904,
    "dDurationMs": 5411,
    "segs": [ {
      "utf8": "Let me begin with the newest, because new is exactly what makes it dangerous."
    } ]
  }, {
    "tStartMs": 175997,
    "dDurationMs": 4970,
    "segs": [ {
      "utf8": "People miss it for the simple reason that last year it did not exist."
    } ]
  }, {
    "tStartMs": 181568,
    "dDurationMs": 2946,
    "segs": [ {
      "utf8": "Starting with the twenty twenty five tax year,"
    } ]
  }, {
    "tStartMs": 184514,
    "dDurationMs": 5190,
    "segs": [ {
      "utf8": "there is a brand new deduction written into the law just for people who are"
    } ]
  }, {
    "tStartMs": 189704,
    "dDurationMs": 1183,
    "segs": [ {
      "utf8": "sixty five and older."
    } ]
  }, {
    "tStartMs": 190887,
    "dDurationMs": 4168,
    "segs": [ {
      "utf8": "It is worth up to six thousand dollars for a single person,"
    } ]
  }, {
    "tStartMs": 195055,
    "dDurationMs": 5171,
    "segs": [ {
      "utf8": "and up to twelve thousand dollars for a married couple where both husband and wife"
    } ]
  }, {
    "tStartMs": 200226,
    "dDurationMs": 1723,
    "segs": [ {
      "utf8": "have turned sixty five."
    } ]
  }, {
    "tStartMs": 202611,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "This sits on top of your regular standard deduction,"
    } ]
  }, {
    "tStartMs": 205196,
    "dDurationMs": 3808,
    "segs": [ {
      "utf8": "and on top of the extra amount that seniors already receive."
    } ]
  }, {
    "tStartMs": 209865,
    "dDurationMs": 1844,
    "segs": [ {
      "utf8": "And here is the part that catches everyone."
    } ]
  }, {
    "tStartMs": 212270,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "You do not have to itemize to get it."
    } ]
  }, {
    "tStartMs": 214615,
    "dDurationMs": 4068,
    "segs": [ {
      "utf8": "You can take the plain standard deduction and still claim this on top."
    } ]
  }, {
    "tStartMs": 218683,
    "dDurationMs": 4570,
    "segs": [ {
      "utf8": "Most people who lose this one lose it for two reasons."
    } ]
  }, {
    "tStartMs": 223834,
    "dDurationMs": 4549,
    "segs": [ {
      "utf8": "Either they never heard it existed, or they heard about it and assumed it was"
    } ]
  }, {
    "tStartMs": 228383,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "only for the wealthy."
    } ]
  }, {
    "tStartMs": 230046,
    "dDurationMs": 982,
    "segs": [ {
      "utf8": "It is the opposite."
    } ]
  }, {
    "tStartMs": 231449,
    "dDurationMs": 5511,
    "segs": [ {
      "utf8": "The full amount goes to seniors with income under seventy five thousand dollars for a"
    } ]
  }, {
    "tStartMs": 236960,
    "dDurationMs": 3908,
    "segs": [ {
      "utf8": "single person, or one hundred fifty thousand dollars for a couple,"
    } ]
  }, {
    "tStartMs": 241189,
    "dDurationMs": 2846,
    "segs": [ {
      "utf8": "and it only starts to shrink above those lines."
    } ]
  }, {
    "tStartMs": 244696,
    "dDurationMs": 3708,
    "segs": [ {
      "utf8": "It runs all the way through the twenty twenty eight tax year."
    } ]
  }, {
    "tStartMs": 249245,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "That means there are four full years of this money on the table,"
    } ]
  }, {
    "tStartMs": 252512,
    "dDurationMs": 3928,
    "segs": [ {
      "utf8": "and every year you do not claim it is a year of it gone for"
    } ]
  }, {
    "tStartMs": 256440,
    "dDurationMs": 260,
    "segs": [ {
      "utf8": "good."
    } ]
  }, {
    "tStartMs": 257041,
    "dDurationMs": 4569,
    "segs": [ {
      "utf8": "Think about what six thousand dollars actually is in a retired person's life."
    } ]
  }, {
    "tStartMs": 262091,
    "dDurationMs": 1523,
    "segs": [ {
      "utf8": "It is months of groceries."
    } ]
  }, {
    "tStartMs": 264095,
    "dDurationMs": 2145,
    "segs": [ {
      "utf8": "It is a year of a Medicare supplement."
    } ]
  }, {
    "tStartMs": 266581,
    "dDurationMs": 3747,
    "segs": [ {
      "utf8": "It is the cushion that lets you keep the heat on without flinching at the"
    } ]
  }, {
    "tStartMs": 270328,
    "dDurationMs": 341,
    "segs": [ {
      "utf8": "bill."
    } ]
  }, {
    "tStartMs": 271190,
    "dDurationMs": 3727,
    "segs": [ {
      "utf8": "For a couple, twelve thousand dollars is even more than that."
    } ]
  }, {
    "tStartMs": 275398,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "This is not pocket change, and it is not a loophole."
    } ]
  }, {
    "tStartMs": 279006,
    "dDurationMs": 3447,
    "segs": [ {
      "utf8": "It is a deduction the law wrote specifically with you in mind."
    } ]
  }, {
    "tStartMs": 283114,
    "dDurationMs": 4189,
    "segs": [ {
      "utf8": "If a person prepares your taxes, this is the first thing you should ask them"
    } ]
  }, {
    "tStartMs": 287303,
    "dDurationMs": 841,
    "segs": [ {
      "utf8": "about this year."
    } ]
  }, {
    "tStartMs": 288725,
    "dDurationMs": 4229,
    "segs": [ {
      "utf8": "And if you file your own, do not let the form move past it without"
    } ]
  }, {
    "tStartMs": 292954,
    "dDurationMs": 1303,
    "segs": [ {
      "utf8": "stopping to claim it."
    } ]
  }, {
    "tStartMs": 294597,
    "dDurationMs": 4870,
    "segs": [ {
      "utf8": "Number two is much older, but you would be amazed how many people still walk"
    } ]
  }, {
    "tStartMs": 299467,
    "dDurationMs": 922,
    "segs": [ {
      "utf8": "right past it."
    } ]
  }, {
    "tStartMs": 300830,
    "dDurationMs": 4730,
    "segs": [ {
      "utf8": "The moment you turn sixty five, the I R S gives you a bigger standard"
    } ]
  }, {
    "tStartMs": 305560,
    "dDurationMs": 2465,
    "segs": [ {
      "utf8": "deduction than younger taxpayers get."
    } ]
  }, {
    "tStartMs": 308025,
    "dDurationMs": 4869,
    "segs": [ {
      "utf8": "For a single person that is well over a thousand extra dollars of your income"
    } ]
  }, {
    "tStartMs": 312894,
    "dDurationMs": 4369,
    "segs": [ {
      "utf8": "that is never taxed at all, and for a married couple where both of you"
    } ]
  }, {
    "tStartMs": 317263,
    "dDurationMs": 3227,
    "segs": [ {
      "utf8": "are sixty five, it stacks once for each of you."
    } ]
  }, {
    "tStartMs": 321091,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "This one is supposed to be automatic, but automatic only works if the return is"
    } ]
  }, {
    "tStartMs": 325921,
    "dDurationMs": 741,
    "segs": [ {
      "utf8": "done correctly."
    } ]
  }, {
    "tStartMs": 327464,
    "dDurationMs": 2505,
    "segs": [ {
      "utf8": "Every year, people who rush through their own taxes,"
    } ]
  }, {
    "tStartMs": 329969,
    "dDurationMs": 2926,
    "segs": [ {
      "utf8": "or who let old software default to the younger amount,"
    } ]
  }, {
    "tStartMs": 333336,
    "dDurationMs": 2786,
    "segs": [ {
      "utf8": "quietly hand back money the law set aside for them."
    } ]
  }, {
    "tStartMs": 336883,
    "dDurationMs": 3988,
    "segs": [ {
      "utf8": "If someone else files for you, ask them one plain question this season."
    } ]
  }, {
    "tStartMs": 341412,
    "dDurationMs": 2465,
    "segs": [ {
      "utf8": "Did you apply my age sixty five standard deduction."
    } ]
  }, {
    "tStartMs": 343877,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "You have every right to know."
    } ]
  }, {
    "tStartMs": 348507,
    "dDurationMs": 991,
    "segs": [ {
      "utf8": "Number three is not a deduction at all,"
    } ]
  }, {
    "tStartMs": 349498,
    "dDurationMs": 1233,
    "segs": [ {
      "utf8": "and that is what makes it so powerful."
    } ]
  }, {
    "tStartMs": 351353,
    "dDurationMs": 881,
    "segs": [ {
      "utf8": "It is a credit."
    } ]
  }, {
    "tStartMs": 352936,
    "dDurationMs": 3106,
    "segs": [ {
      "utf8": "A deduction only lowers the income you get taxed on."
    } ]
  }, {
    "tStartMs": 356523,
    "dDurationMs": 2726,
    "segs": [ {
      "utf8": "A credit comes straight off the tax you owe,"
    } ]
  }, {
    "tStartMs": 359689,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "dollar for dollar."
    } ]
  }, {
    "tStartMs": 361413,
    "dDurationMs": 3206,
    "segs": [ {
      "utf8": "It is called the Credit for the Elderly or the Disabled,"
    } ]
  }, {
    "tStartMs": 364619,
    "dDurationMs": 2966,
    "segs": [ {
      "utf8": "and it has been sitting on the books for decades,"
    } ]
  }, {
    "tStartMs": 367585,
    "dDurationMs": 2165,
    "segs": [ {
      "utf8": "and almost nobody claims it."
    } ]
  }, {
    "tStartMs": 370391,
    "dDurationMs": 3748,
    "segs": [ {
      "utf8": "It is built for older Americans living on a modest income,"
    } ]
  }, {
    "tStartMs": 374139,
    "dDurationMs": 7685,
    "segs": [ {
      "utf8": "and depending on your filing status it can be worth between three thousand seven hundred"
    } ]
  }, {
    "tStartMs": 381824,
    "dDurationMs": 2155,
    "segs": [ {
      "utf8": "and fifty dollars and seven thousand five hundred dollars."
    } ]
  }, {
    "tStartMs": 383979,
    "dDurationMs": 2745,
    "segs": [ {
      "utf8": "The income limits on this one are low,"
    } ]
  }, {
    "tStartMs": 387205,
    "dDurationMs": 5071,
    "segs": [ {
      "utf8": "which means it is aimed squarely at the seniors getting by on Social Security and"
    } ]
  }, {
    "tStartMs": 392276,
    "dDurationMs": 5170,
    "segs": [ {
      "utf8": "a small amount on top, the very people who can least afford to overpay a"
    } ]
  }, {
    "tStartMs": 397446,
    "dDurationMs": 281,
    "segs": [ {
      "utf8": "dime."
    } ]
  }, {
    "tStartMs": 398628,
    "dDurationMs": 2846,
    "segs": [ {
      "utf8": "If that sounds like you, or like someone you love,"
    } ]
  }, {
    "tStartMs": 401955,
    "dDurationMs": 1984,
    "segs": [ {
      "utf8": "the form is called Schedule R."
    } ]
  }, {
    "tStartMs": 403939,
    "dDurationMs": 2606,
    "segs": [ {
      "utf8": "And here is a gift that goes with it."
    } ]
  }, {
    "tStartMs": 406965,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "The I R S runs a program of free tax help staffed by trained volunteers,"
    } ]
  }, {
    "tStartMs": 411875,
    "dDurationMs": 5291,
    "segs": [ {
      "utf8": "built specifically for older people, and they will sit with you and fill out forms"
    } ]
  }, {
    "tStartMs": 417166,
    "dDurationMs": 2505,
    "segs": [ {
      "utf8": "exactly like this one at no charge."
    } ]
  }, {
    "tStartMs": 420292,
    "dDurationMs": 3187,
    "segs": [ {
      "utf8": "You do not have to pay anyone to claim what is yours."
    } ]
  }, {
    "tStartMs": 424381,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "Number four moves away from the federal government and down to your own state and"
    } ]
  }, {
    "tStartMs": 429391,
    "dDurationMs": 5090,
    "segs": [ {
      "utf8": "your own county, and this is where some of the very largest unclaimed money of"
    } ]
  }, {
    "tStartMs": 434481,
    "dDurationMs": 1684,
    "segs": [ {
      "utf8": "all is hiding in plain sight."
    } ]
  }, {
    "tStartMs": 436866,
    "dDurationMs": 4269,
    "segs": [ {
      "utf8": "Nearly every state gives older homeowners a way to lower their property tax,"
    } ]
  }, {
    "tStartMs": 441135,
    "dDurationMs": 3547,
    "segs": [ {
      "utf8": "and a stunning number of people never file for it."
    } ]
  }, {
    "tStartMs": 445203,
    "dDurationMs": 3848,
    "segs": [ {
      "utf8": "Some states cap your property tax at a small percentage of your income,"
    } ]
  }, {
    "tStartMs": 449051,
    "dDurationMs": 3507,
    "segs": [ {
      "utf8": "so that when the tax bill climbs faster than your income does,"
    } ]
  }, {
    "tStartMs": 453139,
    "dDurationMs": 1704,
    "segs": [ {
      "utf8": "the state pays back the difference."
    } ]
  }, {
    "tStartMs": 454843,
    "dDurationMs": 3406,
    "segs": [ {
      "utf8": "That kind of program is often called a circuit breaker,"
    } ]
  }, {
    "tStartMs": 458249,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "and in some states the refund runs to well over two thousand dollars in a"
    } ]
  }, {
    "tStartMs": 462839,
    "dDurationMs": 581,
    "segs": [ {
      "utf8": "single year."
    } ]
  }, {
    "tStartMs": 464161,
    "dDurationMs": 4269,
    "segs": [ {
      "utf8": "On top of that, most places offer what is called a homestead exemption,"
    } ]
  }, {
    "tStartMs": 469051,
    "dDurationMs": 4449,
    "segs": [ {
      "utf8": "which simply lowers the value your home is taxed on before the tax rate is"
    } ]
  }, {
    "tStartMs": 473500,
    "dDurationMs": 682,
    "segs": [ {
      "utf8": "ever applied."
    } ]
  }, {
    "tStartMs": 475084,
    "dDurationMs": 4369,
    "segs": [ {
      "utf8": "And many states add an extra exemption just for homeowners who are sixty five and"
    } ]
  }, {
    "tStartMs": 479453,
    "dDurationMs": 5471,
    "segs": [ {
      "utf8": "older, which in some places knocks tens of thousands of dollars off the taxable value"
    } ]
  }, {
    "tStartMs": 484924,
    "dDurationMs": 641,
    "segs": [ {
      "utf8": "of the house."
    } ]
  }, {
    "tStartMs": 485886,
    "dDurationMs": 2765,
    "segs": [ {
      "utf8": "But there is a catch, and it is a cruel one."
    } ]
  }, {
    "tStartMs": 489192,
    "dDurationMs": 2245,
    "segs": [ {
      "utf8": "You almost always have to file for these,"
    } ]
  }, {
    "tStartMs": 491437,
    "dDurationMs": 4850,
    "segs": [ {
      "utf8": "and they are usually not retroactive, which means if you miss the window this year,"
    } ]
  }, {
    "tStartMs": 496687,
    "dDurationMs": 1844,
    "segs": [ {
      "utf8": "that year of savings is gone for good."
    } ]
  }, {
    "tStartMs": 499052,
    "dDurationMs": 2285,
    "segs": [ {
      "utf8": "One phone call to your county tax office,"
    } ]
  }, {
    "tStartMs": 501337,
    "dDurationMs": 3707,
    "segs": [ {
      "utf8": "asking what exemptions a homeowner over sixty five can claim,"
    } ]
  }, {
    "tStartMs": 505044,
    "dDurationMs": 4109,
    "segs": [ {
      "utf8": "can lower a bill you pay every single year for as long as you live"
    } ]
  }, {
    "tStartMs": 509153,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "in that home."
    } ]
  }, {
    "tStartMs": 510415,
    "dDurationMs": 1764,
    "segs": [ {
      "utf8": "That is not a one time refund."
    } ]
  }, {
    "tStartMs": 512800,
    "dDurationMs": 3227,
    "segs": [ {
      "utf8": "It is money back in your pocket year after year."
    } ]
  }, {
    "tStartMs": 516568,
    "dDurationMs": 2565,
    "segs": [ {
      "utf8": "Let me show you how big this can get."
    } ]
  }, {
    "tStartMs": 519594,
    "dDurationMs": 4249,
    "segs": [ {
      "utf8": "Picture a man who is sixty eight and has owned his home for thirty years."
    } ]
  }, {
    "tStartMs": 524324,
    "dDurationMs": 5170,
    "segs": [ {
      "utf8": "His house has climbed in value, so every year his property tax climbs with it,"
    } ]
  }, {
    "tStartMs": 529594,
    "dDurationMs": 2505,
    "segs": [ {
      "utf8": "even though his income has not moved at all."
    } ]
  }, {
    "tStartMs": 532520,
    "dDurationMs": 2425,
    "segs": [ {
      "utf8": "He assumes there is nothing he can do."
    } ]
  }, {
    "tStartMs": 535426,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "But his state has a homestead exemption, an extra exemption just for owners over sixty"
    } ]
  }, {
    "tStartMs": 540346,
    "dDurationMs": 4579,
    "segs": [ {
      "utf8": "five, and a program that will not let his tax climb past a set share"
    } ]
  }, {
    "tStartMs": 544925,
    "dDurationMs": 742,
    "segs": [ {
      "utf8": "of his income."
    } ]
  }, {
    "tStartMs": 546248,
    "dDurationMs": 3327,
    "segs": [ {
      "utf8": "He qualifies for all three, and has for years."
    } ]
  }, {
    "tStartMs": 550276,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "He has simply never filed the one page form at the county office."
    } ]
  }, {
    "tStartMs": 554465,
    "dDurationMs": 5030,
    "segs": [ {
      "utf8": "The difference, once he files, is well over a thousand dollars every single year."
    } ]
  }, {
    "tStartMs": 559796,
    "dDurationMs": 4629,
    "segs": [ {
      "utf8": "That is more than ten thousand dollars he has handed over across the last decade,"
    } ]
  }, {
    "tStartMs": 564425,
    "dDurationMs": 4689,
    "segs": [ {
      "utf8": "because nobody at the county was ever going to knock on his door and tell"
    } ]
  }, {
    "tStartMs": 569114,
    "dDurationMs": 842,
    "segs": [ {
      "utf8": "him to ask."
    } ]
  }, {
    "tStartMs": 570377,
    "dDurationMs": 3888,
    "segs": [ {
      "utf8": "And now the last one, the one I asked you to wait for,"
    } ]
  }, {
    "tStartMs": 574726,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "because it is the largest pool of forgotten money in the whole country,"
    } ]
  }, {
    "tStartMs": 579115,
    "dDurationMs": 3306,
    "segs": [ {
      "utf8": "and it has nothing to do with how you filed your taxes."
    } ]
  }, {
    "tStartMs": 583123,
    "dDurationMs": 5912,
    "segs": [ {
      "utf8": "Right now, spread across all fifty states, the government is holding more than seventy three"
    } ]
  }, {
    "tStartMs": 589035,
    "dDurationMs": 4008,
    "segs": [ {
      "utf8": "billion dollars in what is called unclaimed property."
    } ]
  }, {
    "tStartMs": 593724,
    "dDurationMs": 5632,
    "segs": [ {
      "utf8": "This is ordinary money that belongs to ordinary people and was simply lost track of"
    } ]
  }, {
    "tStartMs": 599356,
    "dDurationMs": 1022,
    "segs": [ {
      "utf8": "over the years."
    } ]
  }, {
    "tStartMs": 600959,
    "dDurationMs": 4128,
    "segs": [ {
      "utf8": "An old bank account from a bank that merged into another one."
    } ]
  }, {
    "tStartMs": 605588,
    "dDurationMs": 2967,
    "segs": [ {
      "utf8": "A final paycheck that never got cashed."
    } ]
  }, {
    "tStartMs": 608755,
    "dDurationMs": 2325,
    "segs": [ {
      "utf8": "A deposit refund from a utility company."
    } ]
  }, {
    "tStartMs": 611881,
    "dDurationMs": 4509,
    "segs": [ {
      "utf8": "A dividend check that was mailed to a house you moved away from twenty years"
    } ]
  }, {
    "tStartMs": 616390,
    "dDurationMs": 381,
    "segs": [ {
      "utf8": "ago."
    } ]
  }, {
    "tStartMs": 617493,
    "dDurationMs": 2605,
    "segs": [ {
      "utf8": "By law, when a company cannot find you,"
    } ]
  }, {
    "tStartMs": 620479,
    "dDurationMs": 2625,
    "segs": [ {
      "utf8": "that money is eventually turned over to the state,"
    } ]
  }, {
    "tStartMs": 623525,
    "dDurationMs": 3327,
    "segs": [ {
      "utf8": "and the state holds it for you, sometimes for decades,"
    } ]
  }, {
    "tStartMs": 627252,
    "dDurationMs": 1764,
    "segs": [ {
      "utf8": "waiting for you to come and ask."
    } ]
  }, {
    "tStartMs": 629397,
    "dDurationMs": 5571,
    "segs": [ {
      "utf8": "It is estimated that one in every ten Americans has money sitting and waiting like"
    } ]
  }, {
    "tStartMs": 634968,
    "dDurationMs": 461,
    "segs": [ {
      "utf8": "this."
    } ]
  }, {
    "tStartMs": 635690,
    "dDurationMs": 3146,
    "segs": [ {
      "utf8": "And for older people, who have lived in more homes,"
    } ]
  }, {
    "tStartMs": 639357,
    "dDurationMs": 4409,
    "segs": [ {
      "utf8": "opened more accounts, and worked for more employers across a long life,"
    } ]
  }, {
    "tStartMs": 644247,
    "dDurationMs": 1784,
    "segs": [ {
      "utf8": "the odds are even higher than that."
    } ]
  }, {
    "tStartMs": 646672,
    "dDurationMs": 4529,
    "segs": [ {
      "utf8": "So here is exactly how you check, and please pay close attention to this next"
    } ]
  }, {
    "tStartMs": 651201,
    "dDurationMs": 4189,
    "segs": [ {
      "utf8": "part, because there are companies that will try to charge you for something that is"
    } ]
  }, {
    "tStartMs": 655390,
    "dDurationMs": 1002,
    "segs": [ {
      "utf8": "completely free."
    } ]
  }, {
    "tStartMs": 656973,
    "dDurationMs": 2926,
    "segs": [ {
      "utf8": "Go to the official website called Missing Money,"
    } ]
  }, {
    "tStartMs": 660300,
    "dDurationMs": 2244,
    "segs": [ {
      "utf8": "which is run by the state governments themselves,"
    } ]
  }, {
    "tStartMs": 662905,
    "dDurationMs": 1343,
    "segs": [ {
      "utf8": "and type in your name."
    } ]
  }, {
    "tStartMs": 664729,
    "dDurationMs": 4669,
    "segs": [ {
      "utf8": "You can also go straight to the unclaimed property office of any state you have"
    } ]
  }, {
    "tStartMs": 669398,
    "dDurationMs": 1804,
    "segs": [ {
      "utf8": "ever lived in and search there."
    } ]
  }, {
    "tStartMs": 671763,
    "dDurationMs": 3707,
    "segs": [ {
      "utf8": "If money comes up, you file the claim directly with the state,"
    } ]
  }, {
    "tStartMs": 675871,
    "dDurationMs": 1784,
    "segs": [ {
      "utf8": "and it does not cost you a thing."
    } ]
  }, {
    "tStartMs": 678276,
    "dDurationMs": 4830,
    "segs": [ {
      "utf8": "Never, ever pay a finder who calls or writes offering to recover it for a"
    } ]
  }, {
    "tStartMs": 683106,
    "dDurationMs": 421,
    "segs": [ {
      "utf8": "percentage."
    } ]
  }, {
    "tStartMs": 684068,
    "dDurationMs": 2986,
    "segs": [ {
      "utf8": "You do not need them, and you should not give them a cent."
    } ]
  }, {
    "tStartMs": 687715,
    "dDurationMs": 1784,
    "segs": [ {
      "utf8": "The money is already yours."
    } ]
  }, {
    "tStartMs": 689960,
    "dDurationMs": 1383,
    "segs": [ {
      "utf8": "Claiming it is free."
    } ]
  }, {
    "tStartMs": 691343,
    "dDurationMs": 4429,
    "segs": [ {
      "utf8": "Now step back with me and look at what all five of these share,"
    } ]
  }, {
    "tStartMs": 696313,
    "dDurationMs": 2384,
    "segs": [ {
      "utf8": "because the pattern is the entire lesson."
    } ]
  }, {
    "tStartMs": 699599,
    "dDurationMs": 4249,
    "segs": [ {
      "utf8": "Not one of them shows up in your mailbox with your name on it and"
    } ]
  }, {
    "tStartMs": 703848,
    "dDurationMs": 3206,
    "segs": [ {
      "utf8": "a friendly note that says please come and claim me."
    } ]
  }, {
    "tStartMs": 707836,
    "dDurationMs": 3808,
    "segs": [ {
      "utf8": "The new deduction is not applied unless your return is done right."
    } ]
  }, {
    "tStartMs": 712325,
    "dDurationMs": 3607,
    "segs": [ {
      "utf8": "The credit sits untouched unless someone fills out the form."
    } ]
  }, {
    "tStartMs": 716514,
    "dDurationMs": 4409,
    "segs": [ {
      "utf8": "The property tax break expires unless you file for it on time."
    } ]
  }, {
    "tStartMs": 721584,
    "dDurationMs": 4910,
    "segs": [ {
      "utf8": "The money the state is holding stays locked in a government account until the day"
    } ]
  }, {
    "tStartMs": 726494,
    "dDurationMs": 1763,
    "segs": [ {
      "utf8": "you walk up and ask for it."
    } ]
  }, {
    "tStartMs": 728979,
    "dDurationMs": 4549,
    "segs": [ {
      "utf8": "Every single one of these was built around the quiet assumption that you will not"
    } ]
  }, {
    "tStartMs": 733528,
    "dDurationMs": 2485,
    "segs": [ {
      "utf8": "know about it, will not ask about it,"
    } ]
  }, {
    "tStartMs": 736073,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "and will not file for it."
    } ]
  }, {
    "tStartMs": 738478,
    "dDurationMs": 3507,
    "segs": [ {
      "utf8": "That is how thousands of dollars slip away from honest,"
    } ]
  }, {
    "tStartMs": 742166,
    "dDurationMs": 1924,
    "segs": [ {
      "utf8": "careful people every year."
    } ]
  }, {
    "tStartMs": 744651,
    "dDurationMs": 4328,
    "segs": [ {
      "utf8": "Not through any fault of their own, but through a system that simply never tells"
    } ]
  }, {
    "tStartMs": 748979,
    "dDurationMs": 2325,
    "segs": [ {
      "utf8": "them what they are owed in the first place."
    } ]
  }, {
    "tStartMs": 751745,
    "dDurationMs": 2285,
    "segs": [ {
      "utf8": "So here is what I am asking you to do,"
    } ]
  }, {
    "tStartMs": 754471,
    "dDurationMs": 1182,
    "segs": [ {
      "utf8": "and it is small."
    } ]
  }, {
    "tStartMs": 756254,
    "dDurationMs": 2265,
    "segs": [ {
      "utf8": "Pick just one of these five this week."
    } ]
  }, {
    "tStartMs": 759040,
    "dDurationMs": 862,
    "segs": [ {
      "utf8": "Only one."
    } ]
  }, {
    "tStartMs": 760803,
    "dDurationMs": 3708,
    "segs": [ {
      "utf8": "Maybe it is the two minute search on the Missing Money website tonight,"
    } ]
  }, {
    "tStartMs": 764511,
    "dDurationMs": 1523,
    "segs": [ {
      "utf8": "before you go to bed."
    } ]
  }, {
    "tStartMs": 766856,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "Maybe it is one phone call to your county tomorrow about the property tax exemption."
    } ]
  }, {
    "tStartMs": 772948,
    "dDurationMs": 5050,
    "segs": [ {
      "utf8": "Maybe it is one question to whoever handles your taxes about the new deduction for"
    } ]
  }, {
    "tStartMs": 777998,
    "dDurationMs": 1283,
    "segs": [ {
      "utf8": "people over sixty five."
    } ]
  }, {
    "tStartMs": 780423,
    "dDurationMs": 3928,
    "segs": [ {
      "utf8": "You do not have to chase down all five at once and wear yourself out."
    } ]
  }, {
    "tStartMs": 785173,
    "dDurationMs": 2024,
    "segs": [ {
      "utf8": "You only have to open one of those doors,"
    } ]
  }, {
    "tStartMs": 787197,
    "dDurationMs": 4289,
    "segs": [ {
      "utf8": "because the money waiting behind it has belonged to you the whole time."
    } ]
  }, {
    "tStartMs": 792267,
    "dDurationMs": 2265,
    "segs": [ {
      "utf8": "And if you will do one last thing,"
    } ]
  }, {
    "tStartMs": 794772,
    "dDurationMs": 882,
    "segs": [ {
      "utf8": "do this."
    } ]
  }, {
    "tStartMs": 795975,
    "dDurationMs": 4269,
    "segs": [ {
      "utf8": "Picture one person you know who is older and careful with every dollar,"
    } ]
  }, {
    "tStartMs": 800805,
    "dDurationMs": 4148,
    "segs": [ {
      "utf8": "the kind of person who would never in a hundred years imagine that the government"
    } ]
  }, {
    "tStartMs": 804953,
    "dDurationMs": 2846,
    "segs": [ {
      "utf8": "might be sitting on cash with their name on it."
    } ]
  }, {
    "tStartMs": 808280,
    "dDurationMs": 1443,
    "segs": [ {
      "utf8": "Send this to them today."
    } ]
  }, {
    "tStartMs": 810384,
    "dDurationMs": 4269,
    "segs": [ {
      "utf8": "It costs you nothing, and it may be the one message that puts a few"
    } ]
  }, {
    "tStartMs": 814653,
    "dDurationMs": 2505,
    "segs": [ {
      "utf8": "thousand dollars back into their hands this year."
    } ]
  }, {
    "tStartMs": 817739,
    "dDurationMs": 1523,
    "segs": [ {
      "utf8": "Money that was always theirs."
    } ]
  }, {
    "tStartMs": 820104,
    "dDurationMs": 4489,
    "segs": [ {
      "utf8": "Money that was only ever waiting on the far side of a question that nobody"
    } ]
  }, {
    "tStartMs": 824593,
    "dDurationMs": 1262,
    "segs": [ {
      "utf8": "had told them to ask."
    } ]
  } ]
}
