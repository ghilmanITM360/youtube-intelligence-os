{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Every month, money you are not required to\npay leaves your account anyway."
    } ]
  }, {
    "tStartMs": 5460,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Not by mistake. Not by fraud. The"
    } ]
  }, {
    "tStartMs": 8540,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "rule already exists, your name already\nqualifies,"
    } ]
  }, {
    "tStartMs": 12420,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "and nobody turns it on, because nobody is\npaid to turn it on for you."
    } ]
  }, {
    "tStartMs": 17340,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "The county does not telephone."
    } ]
  }, {
    "tStartMs": 19380,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Your state does not write."
    } ]
  }, {
    "tStartMs": 21640,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Social Security does not go through your\nfile and fix it."
    } ]
  }, {
    "tStartMs": 24660,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Every one of these stops the day you ask,\nand not one day sooner."
    } ]
  }, {
    "tStartMs": 29920,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "The years you did not ask are gone, and no\none pays them back."
    } ]
  }, {
    "tStartMs": 34660,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Four bills. Four places to ask."
    } ]
  }, {
    "tStartMs": 37480,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Here they are, and who you say them to."
    } ]
  }, {
    "tStartMs": 40300,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Number one is the extra amount Medicare\ncharges you for money you no longer"
    } ]
  }, {
    "tStartMs": 44940,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "earn. Here is how it works, and it catches\nalmost everybody who retires."
    } ]
  }, {
    "tStartMs": 49920,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "The amount taken out of your Social\nSecurity for Medicare is not set on what"
    } ]
  }, {
    "tStartMs": 54220,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "you earn now. It is set on your tax return\nfrom two years ago."
    } ]
  }, {
    "tStartMs": 58780,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "Two years. So the year you stop working,\nthe year the salary ends, you carry"
    } ]
  }, {
    "tStartMs": 63860,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "on being charged as though you were still\non it."
    } ]
  }, {
    "tStartMs": 66620,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "That is not a mistake in their system."
    } ]
  }, {
    "tStartMs": 68920,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "That is the system. It looks back two\nyears because two years is the most recent"
    } ]
  }, {
    "tStartMs": 74120,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "return they hold, and nobody at Social\nSecurity opens your file and thinks,"
    } ]
  }, {
    "tStartMs": 78820,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "this person retired, we should look at\nthis again."
    } ]
  }, {
    "tStartMs": 81480,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "There is no such person and there is no\nsuch review."
    } ]
  }, {
    "tStartMs": 85980,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Think about who that catches hardest."
    } ]
  }, {
    "tStartMs": 88220,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Somebody who worked right up to sixty\nseven, on a decent wage, and stopped."
    } ]
  }, {
    "tStartMs": 93380,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Their income falls off a cliff in one\nweek."
    } ]
  }, {
    "tStartMs": 96300,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Everything else in their life adjusts\nwithin a month or two."
    } ]
  }, {
    "tStartMs": 99820,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "This one does not adjust for two years\nunless they make it, and those are exactly"
    } ]
  }, {
    "tStartMs": 104920,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "the two years when the money is tightest\nand every dollar is being counted."
    } ]
  }, {
    "tStartMs": 109260,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "But there is a form, and it exists\nprecisely for this."
    } ]
  }, {
    "tStartMs": 114220,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "It is called form S S A forty four, and it\nis a request to have that amount"
    } ]
  }, {
    "tStartMs": 118940,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "recalculated because your life changed."
    } ]
  }, {
    "tStartMs": 122280,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Stopping work counts as one of those\nchanges."
    } ]
  }, {
    "tStartMs": 125320,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "So does the death of a spouse, a divorce,\nlosing a pension, or a business that"
    } ]
  }, {
    "tStartMs": 130140,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "closed. You fill in what happened and\nwhen, you show something that proves"
    } ]
  }, {
    "tStartMs": 134780,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "it, and you send it to a Social Security\noffice."
    } ]
  }, {
    "tStartMs": 137460,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "A letter from an employer saying you\nretired."
    } ]
  }, {
    "tStartMs": 141040,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "A death certificate. Whatever fits the\nevent."
    } ]
  }, {
    "tStartMs": 144200,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "If your income really did fall, the amount\nthey take can come down, and it"
    } ]
  }, {
    "tStartMs": 148780,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "comes down in the money that lands in your\naccount every month."
    } ]
  }, {
    "tStartMs": 152740,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "And be clear about the size of this one,\nbecause it is not small."
    } ]
  }, {
    "tStartMs": 157240,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "The base amount most people pay for"
    } ]
  }, {
    "tStartMs": 159260,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Medicare is a little over two hundred\ndollars"
    } ]
  }, {
    "tStartMs": 161400,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "a month. Anyone charged the higher amount\nbecause of an old salary can be paying"
    } ]
  }, {
    "tStartMs": 166980,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "well above that, month after month, out of\na payment that was meant to cover"
    } ]
  }, {
    "tStartMs": 171340,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "their living. Now hear the part that\nshould annoy you."
    } ]
  }, {
    "tStartMs": 174820,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "That form has existed for years."
    } ]
  }, {
    "tStartMs": 177400,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "It sits on their own website. And a person\nwho never hears about it goes on"
    } ]
  }, {
    "tStartMs": 182460,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "paying an amount calculated from a salary\nthey have not earned since the day"
    } ]
  }, {
    "tStartMs": 186880,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "they walked out of the building, sometimes\nfor years, and every single one"
    } ]
  }, {
    "tStartMs": 191760,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of those months is money gone."
    } ]
  }, {
    "tStartMs": 194600,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "Number two is the phone and internet\ndiscount that drops you without a word."
    } ]
  }, {
    "tStartMs": 200620,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "There is a federal discount for older\npeople on a low income that cuts a set"
    } ]
  }, {
    "tStartMs": 205440,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "amount from what you pay for phone or\ninternet every month."
    } ]
  }, {
    "tStartMs": 209720,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "That much a good many of you already know."
    } ]
  }, {
    "tStartMs": 212760,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Here is the part almost nobody knows, and\nit is where the damage is done."
    } ]
  }, {
    "tStartMs": 217480,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "That discount is not permanent."
    } ]
  }, {
    "tStartMs": 220700,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "Once a year your eligibility has to be\nconfirmed."
    } ]
  }, {
    "tStartMs": 224260,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "A lot of the time that happens"
    } ]
  }, {
    "tStartMs": 225760,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "automatically in the background and you do\nnothing,"
    } ]
  }, {
    "tStartMs": 228860,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "which is the way it should work."
    } ]
  }, {
    "tStartMs": 231040,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "But when it does not happen automatically,\na letter is sent to you asking you"
    } ]
  }, {
    "tStartMs": 235420,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "to confirm. From that point you have sixty\ndays."
    } ]
  }, {
    "tStartMs": 239560,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "Answer it and the discount continues."
    } ]
  }, {
    "tStartMs": 241620,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "Do not answer it, for any reason at all,\nand you are dropped from the program"
    } ]
  }, {
    "tStartMs": 246720,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "entirely."
    } ]
  }, {
    "tStartMs": 248080,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Think about what that letter looks like\narriving at your house."
    } ]
  }, {
    "tStartMs": 252040,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "It is an official looking envelope about a\nphone discount."
    } ]
  }, {
    "tStartMs": 256240,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "It sits in the pile with the\nadvertisements."
    } ]
  }, {
    "tStartMs": 258540,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "And there is no follow up, no telephone\ncall, and no second warning at day"
    } ]
  }, {
    "tStartMs": 264380,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "fifty nine. On day sixty one the discount\nis simply gone, your bill goes up,"
    } ]
  }, {
    "tStartMs": 270000,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "and nothing on the bill explains why."
    } ]
  }, {
    "tStartMs": 273080,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "I have heard from people who assumed the\ncompany had raised the price."
    } ]
  }, {
    "tStartMs": 277560,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "They rang and complained about the price."
    } ]
  }, {
    "tStartMs": 280680,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Nobody at the company mentioned that a\nletter had gone unanswered, because"
    } ]
  }, {
    "tStartMs": 284740,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "the person answering the telephone has no\nidea either."
    } ]
  }, {
    "tStartMs": 288780,
    "dDurationMs": 5620,
    "segs": [ {
      "utf8": "So if your phone or internet bill went up\nand you never found out why, that"
    } ]
  }, {
    "tStartMs": 294400,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "is the first thing to go and check, and it\ncosts nothing to check it."
    } ]
  }, {
    "tStartMs": 298840,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "And notice the shape of this one, because\nyou will see it again and again."
    } ]
  }, {
    "tStartMs": 303880,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "The benefit is not taken from you."
    } ]
  }, {
    "tStartMs": 306100,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "It is allowed to lapse."
    } ]
  }, {
    "tStartMs": 308280,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Nobody decided you should lose it and\nnobody had to sign anything."
    } ]
  }, {
    "tStartMs": 312900,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "A letter went out, sixty days passed, and\na computer removed you."
    } ]
  }, {
    "tStartMs": 317440,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "There is no argument to have with anybody,\nbecause nobody did anything wrong."
    } ]
  }, {
    "tStartMs": 322600,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "That is what makes it so hard to get angry\nat, and so easy to miss."
    } ]
  }, {
    "tStartMs": 327580,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Number three is the heating money that\nruns out before winter does."
    } ]
  }, {
    "tStartMs": 332400,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "There is federal money that helps older\npeople pay to heat and cool their homes,"
    } ]
  }, {
    "tStartMs": 337000,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "and your own state runs it. Most people\nwho have heard of it think of it the"
    } ]
  }, {
    "tStartMs": 341320,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "way they think of Social Security, as\nsomething that is simply there when you"
    } ]
  }, {
    "tStartMs": 345740,
    "dDurationMs": 5740,
    "segs": [ {
      "utf8": "need it. It is not. It is a fixed pot of\nmoney, and when the pot is empty the"
    } ]
  }, {
    "tStartMs": 351480,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "program stops for the year. Many states\nhand it out first come, first served,"
    } ]
  }, {
    "tStartMs": 356480,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "and it is common for programs to run out\nof money before the season is over."
    } ]
  }, {
    "tStartMs": 361380,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "Applications open in the fall, most states\nin October or November, and the"
    } ]
  }, {
    "tStartMs": 366120,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "people who apply in the first weeks get\npaid while the ones who wait until"
    } ]
  }, {
    "tStartMs": 370440,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "January are told there is nothing left."
    } ]
  }, {
    "tStartMs": 373500,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "Sit with that, because it is not how\nanybody expects a benefit to work."
    } ]
  }, {
    "tStartMs": 377900,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "It is not that you did not qualify."
    } ]
  }, {
    "tStartMs": 380980,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "You did qualify. You still qualify."
    } ]
  }, {
    "tStartMs": 384340,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "The money went to people who asked\nearlier, and you asked in February."
    } ]
  }, {
    "tStartMs": 389300,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "Nobody rings to tell you the pot is\nemptying."
    } ]
  }, {
    "tStartMs": 392340,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "No notice arrives in October telling you\nthe doors are open."
    } ]
  }, {
    "tStartMs": 396280,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "The people who know, know, and they apply,\nand the rest find out when it is"
    } ]
  }, {
    "tStartMs": 401340,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "too late to matter. And it is worth saying\nwho usually knows."
    } ]
  }, {
    "tStartMs": 405500,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Somebody in the family works in an office\nwhere this comes up."
    } ]
  }, {
    "tStartMs": 409460,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "A neighbor mentions it over a fence."
    } ]
  }, {
    "tStartMs": 411720,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "A church runs a session about it in\nSeptember."
    } ]
  }, {
    "tStartMs": 414720,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "It is passed between people, not sent out\nby anybody, which means the person"
    } ]
  }, {
    "tStartMs": 419300,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "living alone with no one to mention it is\nthe person least likely to hear,"
    } ]
  }, {
    "tStartMs": 424080,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and often the person who needs it most."
    } ]
  }, {
    "tStartMs": 426600,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "So the action is simple and the timing is\neverything."
    } ]
  }, {
    "tStartMs": 431240,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "Telephone your state energy assistance\noffice now, before the cold weather,"
    } ]
  }, {
    "tStartMs": 436140,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "and ask when applications open and what\nyou need to have ready."
    } ]
  }, {
    "tStartMs": 441660,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "Do that in September and October, not in\nDecember when your house is already"
    } ]
  }, {
    "tStartMs": 446900,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "cold and you are frightened by the bill."
    } ]
  }, {
    "tStartMs": 450180,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Number four is the one search that finds\neverything you are entitled to at"
    } ]
  }, {
    "tStartMs": 454560,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "once. Everything I have given you so far\nis a separate door with a separate"
    } ]
  }, {
    "tStartMs": 459760,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "person behind it. Social Security for one."
    } ]
  }, {
    "tStartMs": 463460,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Your phone company for another."
    } ]
  }, {
    "tStartMs": 465540,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Your state for a third. Nobody holds a\nlist of all of them for you, and no"
    } ]
  }, {
    "tStartMs": 470500,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "office looks at your situation and says,\nhere is everything you are owed."
    } ]
  }, {
    "tStartMs": 475020,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "There is one place that comes close, and\nlet me be exact about what it is."
    } ]
  }, {
    "tStartMs": 480280,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "It is a free service run by a national\ncharity for older people, not a government"
    } ]
  }, {
    "tStartMs": 485340,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "office and not connected to any of them."
    } ]
  }, {
    "tStartMs": 487780,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "You put in your zip code and some basic\ndetails about your income and situation,"
    } ]
  }, {
    "tStartMs": 493060,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "and it tells you which programs in your\nstate you are likely to qualify for."
    } ]
  }, {
    "tStartMs": 497780,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "It is called Benefits Check Up, run by the\nNational Council on Aging."
    } ]
  }, {
    "tStartMs": 502740,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "It takes about ten minutes and it does not\nask for a payment or a card."
    } ]
  }, {
    "tStartMs": 507740,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "What it gives you back is a list, and that\nlist is the thing you cannot get"
    } ]
  }, {
    "tStartMs": 512460,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "anywhere else, because the programs are\nrun by different offices at different"
    } ]
  }, {
    "tStartMs": 517120,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "levels of government who do not talk to\none another about you."
    } ]
  }, {
    "tStartMs": 521020,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "One more thing about this one."
    } ]
  }, {
    "tStartMs": 522540,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "It will show you programs you have never\nheard of and did not think applied"
    } ]
  }, {
    "tStartMs": 527280,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "to you, and the first reaction most people\nhave is that it must be for somebody"
    } ]
  }, {
    "tStartMs": 531800,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "worse off. Read the numbers before you\ndecide that."
    } ]
  }, {
    "tStartMs": 535580,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "The income limits on a good many of these\nare far higher than people assume,"
    } ]
  }, {
    "tStartMs": 539220,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "and a person on an ordinary Social\nSecurity payment qualifies for more than"
    } ]
  }, {
    "tStartMs": 543680,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "they expect. And do it with somebody if\nyou can."
    } ]
  }, {
    "tStartMs": 547580,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "A daughter, a son, a neighbor who is\ncomfortable with a computer."
    } ]
  }, {
    "tStartMs": 552240,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Not because you cannot do it, but because\ntwo people reading a list catch more"
    } ]
  }, {
    "tStartMs": 556860,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "than one, and the list is longer than most\npeople expect."
    } ]
  }, {
    "tStartMs": 561240,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Now let me be plain about what to actually\ndo this week, and I should say that"
    } ]
  }, {
    "tStartMs": 565740,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "everything here is general information and\nnot advice about your own case,"
    } ]
  }, {
    "tStartMs": 570040,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "so do check your own position, because\nstates and situations differ."
    } ]
  }, {
    "tStartMs": 575400,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Start with the Medicare one, because it is\nthe largest amount and the slowest"
    } ]
  }, {
    "tStartMs": 580120,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "to move. If you or your husband or your\nwife stopped working in the last two"
    } ]
  }, {
    "tStartMs": 585000,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "years, look up form S S A forty four, fill\nit in, and send it with something"
    } ]
  }, {
    "tStartMs": 590860,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "that proves the date."
    } ]
  }, {
    "tStartMs": 592760,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "That single form has the biggest number\nattached to it of anything in this"
    } ]
  }, {
    "tStartMs": 597040,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "video. Do not write a letter for that one."
    } ]
  }, {
    "tStartMs": 600740,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "Telephone."
    } ]
  }, {
    "tStartMs": 601940,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "A letter to a Social Security office can\nsit for weeks, and you will not know"
    } ]
  }, {
    "tStartMs": 606420,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "whether it arrived."
    } ]
  }, {
    "tStartMs": 608020,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "On the telephone you get a name and a\ndate, and that is worth more than anything"
    } ]
  }, {
    "tStartMs": 612960,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "you post. Then telephone your phone or\ninternet company and ask one question."
    } ]
  }, {
    "tStartMs": 618820,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Am I still on the low income discount, and\nhas anything been sent to me that"
    } ]
  }, {
    "tStartMs": 622980,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "I have not returned. Write down the date\nyou called and who you spoke to."
    } ]
  }, {
    "tStartMs": 627900,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Then telephone your state energy"
    } ]
  }, {
    "tStartMs": 629480,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "assistance office and ask when\napplications"
    } ]
  }, {
    "tStartMs": 632100,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "open for the winter. Put the date in your\ncalendar the same day you are told"
    } ]
  }, {
    "tStartMs": 636120,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "it. Then sit down for ten minutes with\nBenefits Check Up and read what comes"
    } ]
  }, {
    "tStartMs": 642440,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "back."
    } ]
  }, {
    "tStartMs": 643740,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "And write all four on one sheet of paper\nbefore you start."
    } ]
  }, {
    "tStartMs": 648220,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "The date you called. Who you spoke to."
    } ]
  }, {
    "tStartMs": 651400,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "What they said. Not because anybody is\ngoing to argue with you, but because"
    } ]
  }, {
    "tStartMs": 656320,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "these things take a second telephone call\nmore often than a first one, and"
    } ]
  }, {
    "tStartMs": 660960,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "the person you get the second time will\nnot know anything about the first."
    } ]
  }, {
    "tStartMs": 665700,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "If any of that feels like a lot at once,\ndo them in that order and do one a"
    } ]
  }, {
    "tStartMs": 670520,
    "dDurationMs": 220,
    "segs": [ {
      "utf8": "day."
    } ]
  }, {
    "tStartMs": 671460,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Monday the form. Tuesday the phone\ncompany."
    } ]
  }, {
    "tStartMs": 674780,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Wednesday the state office. Thursday the\nsearch."
    } ]
  }, {
    "tStartMs": 678800,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "By Friday every one of the four is moving,\nand not one of them needed permission"
    } ]
  }, {
    "tStartMs": 683080,
    "dDurationMs": 660,
    "segs": [ {
      "utf8": "from anybody."
    } ]
  }, {
    "tStartMs": 684460,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Four things. None of them costs anything."
    } ]
  }, {
    "tStartMs": 687500,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "All four can be started this week, and the\nwhole list takes less time than"
    } ]
  }, {
    "tStartMs": 692200,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "one afternoon. One warning before I\nfinish, because these people follow videos"
    } ]
  }, {
    "tStartMs": 698000,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "like this one. If somebody telephones you\noffering to claim benefits on your"
    } ]
  }, {
    "tStartMs": 702840,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "behalf for a fee, or asking for a payment\nto check what you qualify for, hang"
    } ]
  }, {
    "tStartMs": 707980,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "up. Every single thing in this video is\nfree."
    } ]
  }, {
    "tStartMs": 711580,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The form is free. The discount is free to\napply for."
    } ]
  }, {
    "tStartMs": 715360,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "The heating money is free to apply for."
    } ]
  }, {
    "tStartMs": 718040,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "The search is free."
    } ]
  }, {
    "tStartMs": 720200,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Anybody asking to be paid to stand between\nyou and money you are already owed"
    } ]
  }, {
    "tStartMs": 724780,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "is not helping you. So there are the four,\none last time."
    } ]
  }, {
    "tStartMs": 730040,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "The Medicare amount charged on a salary\nyou no longer earn, which form S S"
    } ]
  }, {
    "tStartMs": 734660,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "A forty four exists to correct."
    } ]
  }, {
    "tStartMs": 738120,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "The phone and internet discount that drops\nyou after sixty days of silence."
    } ]
  }, {
    "tStartMs": 743740,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "The heating money that runs out before\nwinter ends, which is why you apply"
    } ]
  }, {
    "tStartMs": 747920,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "in the fall and not in January."
    } ]
  }, {
    "tStartMs": 750140,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "And the one free search that finds the\nrest."
    } ]
  }, {
    "tStartMs": 753480,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "And there is a pattern under all four that\nis worth carrying with you after"
    } ]
  }, {
    "tStartMs": 758840,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "this video ends. None of these systems is\ndesigned to find you."
    } ]
  }, {
    "tStartMs": 763960,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "They are designed to answer you."
    } ]
  }, {
    "tStartMs": 766460,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "That is a completely different thing, and\nonce you see it you will spot it"
    } ]
  }, {
    "tStartMs": 771220,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "everywhere, in every office and every bill\nand every letter that arrives."
    } ]
  }, {
    "tStartMs": 776440,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Not one of those switches itself on."
    } ]
  }, {
    "tStartMs": 779340,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Not one office in this country is going to\nlook at your file, notice what you"
    } ]
  }, {
    "tStartMs": 783640,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "qualify for, and put it right without\nbeing asked."
    } ]
  }, {
    "tStartMs": 786500,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "That is not cruelty and it is not a\nconspiracy."
    } ]
  }, {
    "tStartMs": 790300,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "It is simply how it is built, and it is\nbuilt that way because the money stays"
    } ]
  }, {
    "tStartMs": 794960,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "where it is when nobody asks. You know\nwhat to ask for now, and you know who"
    } ]
  }, {
    "tStartMs": 800540,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "to ask."
    } ]
  }, {
    "tStartMs": 801820,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "If somebody in your family retired in the\nlast two years and has never heard"
    } ]
  }, {
    "tStartMs": 806460,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "of that form,"
    } ]
  }, {
    "tStartMs": 807960,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "telephone them tonight and tell them the\nnumber."
    } ]
  }, {
    "tStartMs": 811660,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Every month they wait is a month nobody\ngives back."
    } ]
  } ]
}
