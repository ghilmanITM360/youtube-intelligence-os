{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Six months."
    } ]
  }, {
    "tStartMs": 1520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "That is how long the bank keeps treating\nthe account the way it did when both"
    } ]
  }, {
    "tStartMs": 5360,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "of you were alive."
    } ]
  }, {
    "tStartMs": 7340,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Nobody starts that clock in front of you."
    } ]
  }, {
    "tStartMs": 9980,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "Nobody writes to you on the day it runs\nout."
    } ]
  }, {
    "tStartMs": 12580,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "It runs anyway, and on the morning it\nfinishes, a protection you have had for"
    } ]
  }, {
    "tStartMs": 17460,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "forty years is simply smaller."
    } ]
  }, {
    "tStartMs": 21200,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Most people spend those six months doing\nthe hardest things they will ever"
    } ]
  }, {
    "tStartMs": 25080,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "do. Sorting papers. Answering calls."
    } ]
  }, {
    "tStartMs": 28340,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Learning how to be one person in a house\nbuilt for two."
    } ]
  }, {
    "tStartMs": 32820,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "The clock does not wait for any of that."
    } ]
  }, {
    "tStartMs": 35680,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Three things happen to a joint bank\naccount when a husband or a wife dies."
    } ]
  }, {
    "tStartMs": 40040,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "The costliest one is first, and it costs\nquietly, without a letter, without"
    } ]
  }, {
    "tStartMs": 44920,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "a call, without anybody at the bank being\nrequired to raise it."
    } ]
  }, {
    "tStartMs": 48800,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "Who this lands on. If your name and one\nother name are both on a bank account,"
    } ]
  }, {
    "tStartMs": 53900,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "all three belong to you. No income test."
    } ]
  }, {
    "tStartMs": 57260,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "Nobody asks what you own. The size of the\nbalance changes nothing, except that"
    } ]
  }, {
    "tStartMs": 62060,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "the first one gets more expensive as the\nnumber climbs."
    } ]
  }, {
    "tStartMs": 65760,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "Two names, said once."
    } ]
  }, {
    "tStartMs": 68040,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "The protection on your deposits comes from\nthe FDIC, which is the federal body"
    } ]
  }, {
    "tStartMs": 72380,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "that insures money in banks."
    } ]
  }, {
    "tStartMs": 74520,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The account itself is called a joint\naccount, which just means two names on"
    } ]
  }, {
    "tStartMs": 78360,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "one account."
    } ]
  }, {
    "tStartMs": 79680,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Number one. Six months. Then half of it is\nnot covered."
    } ]
  }, {
    "tStartMs": 84120,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Here is the rule as it stands today, and\nalmost nobody over sixty five has"
    } ]
  }, {
    "tStartMs": 88780,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "heard it out loud. A joint account is\ninsured for $250,000 per owner."
    } ]
  }, {
    "tStartMs": 94860,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "Two names on the account, $500,000\nprotected."
    } ]
  }, {
    "tStartMs": 98580,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "That is how it works while both of you are\nliving, and it is why couples with"
    } ]
  }, {
    "tStartMs": 102080,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "real savings were told for years to keep\nthe money jointly."
    } ]
  }, {
    "tStartMs": 106200,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "When one owner dies, the FDIC does"
    } ]
  }, {
    "tStartMs": 109340,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "something that sounds generous and is\nactually"
    } ]
  }, {
    "tStartMs": 112340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a countdown."
    } ]
  }, {
    "tStartMs": 113900,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "For six months it goes on treating the\naccount exactly as it was."
    } ]
  }, {
    "tStartMs": 118880,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "The person who died is counted as though\nhe were still alive."
    } ]
  }, {
    "tStartMs": 123260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "$500,000 stays protected."
    } ]
  }, {
    "tStartMs": 126480,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "Then the six months end. On that day the\naccount becomes yours alone in the"
    } ]
  }, {
    "tStartMs": 131520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "eyes of the insurance,"
    } ]
  }, {
    "tStartMs": 133320,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "and yours alone means $250,000."
    } ]
  }, {
    "tStartMs": 136360,
    "dDurationMs": 6420,
    "segs": [ {
      "utf8": "Not per name. Not as it was. One limit,\nfor one person, across"
    } ]
  }, {
    "tStartMs": 142780,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "everything you hold in your own name at\nthat one bank."
    } ]
  }, {
    "tStartMs": 146060,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "The FDIC writes this out plainly in its\nown example."
    } ]
  }, {
    "tStartMs": 150900,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "A joint account holding $500,000."
    } ]
  }, {
    "tStartMs": 154140,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "One owner dies. Nothing is changed within\nthe six months."
    } ]
  }, {
    "tStartMs": 158060,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "$250,000 is now uninsured."
    } ]
  }, {
    "tStartMs": 162280,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "That is not a penalty and nobody did it to\nyou."
    } ]
  }, {
    "tStartMs": 165600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It is arithmetic."
    } ]
  }, {
    "tStartMs": 167380,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Two names bought two limits. One name buys\none."
    } ]
  }, {
    "tStartMs": 171280,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Think about who is standing inside those\nsix months."
    } ]
  }, {
    "tStartMs": 174300,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "A woman of seventy three who has never\nmoved money between banks in her life,"
    } ]
  }, {
    "tStartMs": 178520,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "because her husband did that. A man of\neighty who could not tell you which"
    } ]
  }, {
    "tStartMs": 183260,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "of the two local branches holds the bigger\naccount."
    } ]
  }, {
    "tStartMs": 186440,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "A widow who was told at the funeral to\nchange nothing for a year, which is"
    } ]
  }, {
    "tStartMs": 190540,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "kind advice for a will and expensive\nadvice for this."
    } ]
  }, {
    "tStartMs": 194500,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And here is the part that makes it worse."
    } ]
  }, {
    "tStartMs": 196840,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "The FDIC does not know your husband died."
    } ]
  }, {
    "tStartMs": 199940,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "It is not sent a death certificate."
    } ]
  }, {
    "tStartMs": 202140,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "It does not read obituaries. The clock\nstarts from the date of death whether"
    } ]
  }, {
    "tStartMs": 206640,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "or not anybody at the bank has been told,\nso the six months can be partly spent"
    } ]
  }, {
    "tStartMs": 211140,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "before the bank even updates its records."
    } ]
  }, {
    "tStartMs": 214520,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Two more pieces of this that matter and\nare never mentioned together."
    } ]
  }, {
    "tStartMs": 218240,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "The six months is not given if giving it\nwould make your cover smaller."
    } ]
  }, {
    "tStartMs": 222220,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "The rule exists to protect you, not to\ntrap you, so if the ordinary arithmetic"
    } ]
  }, {
    "tStartMs": 227040,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "would already protect you better, the\nordinary arithmetic is what applies."
    } ]
  }, {
    "tStartMs": 231860,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "And there is no six months at all when the\nperson who dies is a named beneficiary"
    } ]
  }, {
    "tStartMs": 236400,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "rather than an owner. If you have an\naccount that pays out to a named person"
    } ]
  }, {
    "tStartMs": 240740,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "on your death, and that person dies first,\nthe cover can drop that same day."
    } ]
  }, {
    "tStartMs": 245800,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "No window. No countdown."
    } ]
  }, {
    "tStartMs": 248400,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "What to do with this one. Write down every\nbank where you hold money, and next"
    } ]
  }, {
    "tStartMs": 252700,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "to each one write what is in it."
    } ]
  }, {
    "tStartMs": 254840,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "If any single bank holds more than\n$250,000 in your name alone, that is the"
    } ]
  }, {
    "tStartMs": 260060,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "number to deal with, and the answer is\nusually boring."
    } ]
  }, {
    "tStartMs": 263480,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "Move part of it to a second bank."
    } ]
  }, {
    "tStartMs": 265700,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "The FDIC has a free calculator on its own\nwebsite called EDIE that tells you"
    } ]
  }, {
    "tStartMs": 271100,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "exactly what is covered, and it costs\nnothing and asks for no personal details."
    } ]
  }, {
    "tStartMs": 276380,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Do it inside the six months. After that\nyou are not protecting money, you are"
    } ]
  }, {
    "tStartMs": 281140,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "hoping."
    } ]
  }, {
    "tStartMs": 282280,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Number two. Close that account and you\ncannot open it again."
    } ]
  }, {
    "tStartMs": 286300,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "This is the one that comes from doing the\nright thing."
    } ]
  }, {
    "tStartMs": 288840,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "A sensible person wants the paperwork\nfinished."
    } ]
  }, {
    "tStartMs": 291620,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "The account has his name on it, the name\nhurts to read, and closing it feels"
    } ]
  }, {
    "tStartMs": 295900,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "like one task taken off a list that has\nthirty tasks on it."
    } ]
  }, {
    "tStartMs": 300320,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "Here is what is still moving through that\naccount on the day you close it."
    } ]
  }, {
    "tStartMs": 303640,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Money is still coming in. A pension\npayment that runs a month behind."
    } ]
  }, {
    "tStartMs": 307900,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "A refund from a company that was told\nabout the death in March and processes"
    } ]
  }, {
    "tStartMs": 311900,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "it in May. An insurance payment that was\nfiled weeks ago."
    } ]
  }, {
    "tStartMs": 315540,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "A final wage, a dividend, a rebate on a\npolicy nobody remembered."
    } ]
  }, {
    "tStartMs": 320240,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Money is still going out. The electricity."
    } ]
  }, {
    "tStartMs": 323040,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "The water. The mortgage or the property\ntax."
    } ]
  }, {
    "tStartMs": 326120,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "The house insurance, which is the"
    } ]
  }, {
    "tStartMs": 328460,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "dangerous one, because an insurance\npremium"
    } ]
  }, {
    "tStartMs": 330860,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "that fails to come out does not send you a\nletter the same day."
    } ]
  }, {
    "tStartMs": 334420,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "It lapses quietly, and you find out about\nthe lapse at the worst possible moment,"
    } ]
  }, {
    "tStartMs": 339080,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "which is after something has already\nhappened to the house."
    } ]
  }, {
    "tStartMs": 342600,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "Close the account and every one of those\nstops at once."
    } ]
  }, {
    "tStartMs": 346340,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Payments coming in are returned to the\nsender and begin a chain of letters."
    } ]
  }, {
    "tStartMs": 350000,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "Payments going out fail, and each failure\nhas to be chased, re-authorised and"
    } ]
  }, {
    "tStartMs": 355840,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "explained to somebody who has never heard\nof you."
    } ]
  }, {
    "tStartMs": 358380,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "And a closed account does not come back."
    } ]
  }, {
    "tStartMs": 360820,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "You cannot reopen it. You open a new one,\nwith a new number, and then every"
    } ]
  }, {
    "tStartMs": 365360,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "single person who was paying into it or\ntaking out of it has to be told again,"
    } ]
  }, {
    "tStartMs": 369980,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "one at a time, by you, in the same month\nyou buried him."
    } ]
  }, {
    "tStartMs": 373420,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "A woman named Eleanor closed her husband's\nside of things four weeks after"
    } ]
  }, {
    "tStartMs": 376900,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "the funeral because her son said it was\ntidy."
    } ]
  }, {
    "tStartMs": 379220,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Her car insurance was on that account."
    } ]
  }, {
    "tStartMs": 381980,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "She did not know, because she had never\nbeen the one to look."
    } ]
  }, {
    "tStartMs": 385000,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "She found out in July."
    } ]
  }, {
    "tStartMs": 386920,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "What to do with this one. Keep the account\nopen and keep it funded for at least"
    } ]
  }, {
    "tStartMs": 391120,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "six months. Do not treat it as finished."
    } ]
  }, {
    "tStartMs": 393940,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Sit down once, write a list of every\npayment that goes in and every payment"
    } ]
  }, {
    "tStartMs": 398200,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "that comes out, and then deal with them\none at a time, deliberately, over months."
    } ]
  }, {
    "tStartMs": 403360,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "The electricity stays. The gym membership\ngoes."
    } ]
  }, {
    "tStartMs": 406700,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Nothing is closed until the list is empty."
    } ]
  }, {
    "tStartMs": 409400,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Number three. Two names kept you out of\ncourt."
    } ]
  }, {
    "tStartMs": 412500,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Now there is one. This is the thing almost\nnobody says out loud, and it is"
    } ]
  }, {
    "tStartMs": 416720,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "the reason this item is last. Most joint\naccounts between husband and wife"
    } ]
  }, {
    "tStartMs": 420620,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "carry something called right of\nsurvivorship."
    } ]
  }, {
    "tStartMs": 423860,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "Three words on a form you signed decades\nago and never looked at again."
    } ]
  }, {
    "tStartMs": 428280,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "What they mean is that when one of you\ndies, the account passes to the other"
    } ]
  }, {
    "tStartMs": 431740,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "one directly, without a judge, without a\ncourt, without the months of waiting"
    } ]
  }, {
    "tStartMs": 435980,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "that other things go through. That is real\nand it works and it is the reason"
    } ]
  }, {
    "tStartMs": 440460,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "the first weeks are survivable."
    } ]
  }, {
    "tStartMs": 442420,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "But stop and ask where that protection\nactually came from."
    } ]
  }, {
    "tStartMs": 446100,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "It came from the second name. Not from the\nbank being kind."
    } ]
  }, {
    "tStartMs": 450620,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Not from the account being special."
    } ]
  }, {
    "tStartMs": 452940,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "The account skipped the court because\nthere was somebody else already on it,"
    } ]
  }, {
    "tStartMs": 457300,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "waiting to take it. The second name is\ngone."
    } ]
  }, {
    "tStartMs": 460400,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "What you have now is an account with one\nname on it, and an account with one"
    } ]
  }, {
    "tStartMs": 465640,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "name on it does not skip anything."
    } ]
  }, {
    "tStartMs": 468320,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "When your turn comes, that money stops."
    } ]
  }, {
    "tStartMs": 471420,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "It waits."
    } ]
  }, {
    "tStartMs": 472640,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Your daughter cannot touch it to pay for\nthe funeral, your son cannot use it"
    } ]
  }, {
    "tStartMs": 476840,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "for the house, and nobody gets near it\nuntil a court appoints somebody and"
    } ]
  }, {
    "tStartMs": 481620,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "says so in writing. That can take months,\nand in some places longer."
    } ]
  }, {
    "tStartMs": 486180,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "So the protection that carried you through\nthis did not transfer to you."
    } ]
  }, {
    "tStartMs": 491460,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "It died with the second name, and nothing\nreplaced it."
    } ]
  }, {
    "tStartMs": 495460,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "The fix takes about ten minutes and it is\nfree."
    } ]
  }, {
    "tStartMs": 498720,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Ask the bank for a payable on death form."
    } ]
  }, {
    "tStartMs": 501600,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Some banks call it a beneficiary form."
    } ]
  }, {
    "tStartMs": 504000,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "You write down who should receive the\naccount when you die, you sign it, and"
    } ]
  }, {
    "tStartMs": 508240,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "the account skips the court again, the\nsame way it just did for you."
    } ]
  }, {
    "tStartMs": 512300,
    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "No lawyer. No fee. No court. A man named\nHoward sat in a branch for twenty"
    } ]
  }, {
    "tStartMs": 518140,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "minutes doing exactly this, four months\nafter his wife died, because somebody"
    } ]
  }, {
    "tStartMs": 523340,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "told him to. It cost him nothing and his\ntwo daughters will never know how"
    } ]
  }, {
    "tStartMs": 528280,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "much it saved them, because the thing it\nprevented will simply never happen."
    } ]
  }, {
    "tStartMs": 533560,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "While you are there, ask the same question\nabout every other account in your"
    } ]
  }, {
    "tStartMs": 537540,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "name. The current account. The savings."
    } ]
  }, {
    "tStartMs": 541000,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "The certificate. Each one is separate and\neach one needs its own form."
    } ]
  }, {
    "tStartMs": 545940,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "There is one thread running through all\nthree of these, and once you see it,"
    } ]
  }, {
    "tStartMs": 550080,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "they stop being three separate problems."
    } ]
  }, {
    "tStartMs": 552740,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Every single one of them is about a second\nname that is no longer there."
    } ]
  }, {
    "tStartMs": 556780,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Two names bought you twice the insurance."
    } ]
  }, {
    "tStartMs": 559380,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Two names kept the money out of court."
    } ]
  }, {
    "tStartMs": 561820,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Two names meant somebody else knew which\nbank held what, and which payment"
    } ]
  }, {
    "tStartMs": 565820,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "went out on the fourteenth."
    } ]
  }, {
    "tStartMs": 567800,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "The accounts did not change when he died."
    } ]
  }, {
    "tStartMs": 570340,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "The arithmetic underneath them did, all at\nonce, on a date nobody marked."
    } ]
  }, {
    "tStartMs": 574940,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "And none of it generates a letter."
    } ]
  }, {
    "tStartMs": 577240,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "The bank is not required to tell you the\ninsurance limit has moved."
    } ]
  }, {
    "tStartMs": 581260,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "No office is required to say the\nprotection has gone."
    } ]
  }, {
    "tStartMs": 584700,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "The only notification any of this produces\nis the moment something goes wrong,"
    } ]
  }, {
    "tStartMs": 589280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "and by then the window has closed."
    } ]
  }, {
    "tStartMs": 592380,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Here is the honest limit on everything I\nhave just said."
    } ]
  }, {
    "tStartMs": 595540,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "I cannot see your accounts and I do not\nknow which words are on them."
    } ]
  }, {
    "tStartMs": 600000,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Banks differ in what they ask for and how\nfast they do it."
    } ]
  }, {
    "tStartMs": 603700,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Some states handle these accounts\ndifferently,"
    } ]
  }, {
    "tStartMs": 605780,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "and a few handle them very differently."
    } ]
  }, {
    "tStartMs": 608200,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "Everything above is the general federal\nrule on deposit insurance and the ordinary"
    } ]
  }, {
    "tStartMs": 612660,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "shape of how these accounts work."
    } ]
  }, {
    "tStartMs": 614980,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Your own case is decided by paperwork\nsitting in a drawer at your branch."
    } ]
  }, {
    "tStartMs": 619440,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "The three, said quickly. The insurance on\na joint account holds for six months"
    } ]
  }, {
    "tStartMs": 624240,
    "dDurationMs": 6340,
    "segs": [ {
      "utf8": "after one owner dies, then falls to\n$250,000 for one person, and"
    } ]
  }, {
    "tStartMs": 630580,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "the FDIC's own example has a quarter of a\nmillion dollars going uninsured."
    } ]
  }, {
    "tStartMs": 636400,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Closing the account is the common mistake,\nbecause money is still arriving"
    } ]
  }, {
    "tStartMs": 640820,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "and bills are still leaving, and a closed\naccount cannot be opened again."
    } ]
  }, {
    "tStartMs": 645820,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "And the protection that kept this money\nout of court came from the second name,"
    } ]
  }, {
    "tStartMs": 650480,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "so with one name left you need a payable\non death form to put it back."
    } ]
  }, {
    "tStartMs": 655100,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "None of this is secret. All three sit on\ngovernment pages, free, where anybody"
    } ]
  }, {
    "tStartMs": 659920,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "can read them. They catch older people\nanyway, because they are written for"
    } ]
  }, {
    "tStartMs": 663860,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "somebody already looking, and nobody who\nhas just buried a husband is looking"
    } ]
  }, {
    "tStartMs": 667760,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "at a deposit insurance page. One last\nthing, since this is the season when"
    } ]
  }, {
    "tStartMs": 672280,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "these calls go out. No official body\ntelephones a widow to help her reorganise"
    } ]
  }, {
    "tStartMs": 676880,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "her accounts. If somebody rings offering\nto help move money to keep it protected,"
    } ]
  }, {
    "tStartMs": 681860,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "that call is not coming from the FDIC, and\nit is not coming from your bank's"
    } ]
  }, {
    "tStartMs": 686100,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "fraud department either. Put the phone\ndown and ring the number printed on"
    } ]
  }, {
    "tStartMs": 690160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "your own statement."
    } ]
  }, {
    "tStartMs": 691680,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "And if you know a woman who buried her\nhusband this year, do not send her this."
    } ]
  }, {
    "tStartMs": 696040,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Sit down beside her, find out which banks\nhold what, and count the six months"
    } ]
  }, {
    "tStartMs": 700520,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "from the date on the certificate."
    } ]
  }, {
    "tStartMs": 702100,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "She has probably already lost two of them."
    } ]
  } ]
}
