{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "If you were born before nineteen sixty\nseven,"
    } ]
  }, {
    "tStartMs": 3380,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "one number on your Social Security file\nchanged, and nobody at the agency wrote"
    } ]
  }, {
    "tStartMs": 8340,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "to tell you which year it lands on."
    } ]
  }, {
    "tStartMs": 11220,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Here is what gets left out every time it\nis repeated."
    } ]
  }, {
    "tStartMs": 14520,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It does not land on everyone born before\nnineteen sixty seven."
    } ]
  }, {
    "tStartMs": 18340,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "It lands on one birth year, and that year\narrives next year."
    } ]
  }, {
    "tStartMs": 23380,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Everybody else either walked past it\nalready or is still waiting their turn,"
    } ]
  }, {
    "tStartMs": 27660,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "and the two situations could not be\nfurther apart."
    } ]
  }, {
    "tStartMs": 31540,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "So I am going to take the birth years one\nat a time."
    } ]
  }, {
    "tStartMs": 34640,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "For each one I will tell you what your\nfull age actually is, the year you reach"
    } ]
  }, {
    "tStartMs": 39340,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "it, and the one thing worth doing before\nyou file anything."
    } ]
  }, {
    "tStartMs": 43580,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Five groups."
    } ]
  }, {
    "tStartMs": 44940,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Find yours and you can stop guessing."
    } ]
  }, {
    "tStartMs": 47580,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "And stay for the last one, because"
    } ]
  }, {
    "tStartMs": 50540,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "nineteen sixty seven is the year every\nchannel"
    } ]
  }, {
    "tStartMs": 53880,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "on this website is naming right now, and\nwhat actually happens to that group"
    } ]
  }, {
    "tStartMs": 58760,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "is not what they are telling you."
    } ]
  }, {
    "tStartMs": 61680,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Everything here comes from the rules the\nagency publishes, and the sources"
    } ]
  }, {
    "tStartMs": 66460,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "are in the description."
    } ]
  }, {
    "tStartMs": 68340,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Check the numbers yourself."
    } ]
  }, {
    "tStartMs": 70260,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "This is education and not advice about\nyour own record."
    } ]
  }, {
    "tStartMs": 74080,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "One thing before we start. Put your birth\nyear in the comments."
    } ]
  }, {
    "tStartMs": 77800,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Just the year, nothing else."
    } ]
  }, {
    "tStartMs": 80340,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Number one. Born in nineteen fifty nine or\nearlier."
    } ]
  }, {
    "tStartMs": 84360,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "You already passed it. Start here because\nthis is the largest group watching,"
    } ]
  }, {
    "tStartMs": 89340,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "and for you the news is that there is no\nnews, which is worth knowing on its"
    } ]
  }, {
    "tStartMs": 93460,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "own. For decades the age at which you\ncould collect your whole unreduced payment"
    } ]
  }, {
    "tStartMs": 98520,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "crept upward. It moved in two month steps."
    } ]
  }, {
    "tStartMs": 102380,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Sixty six. Sixty six and two months."
    } ]
  }, {
    "tStartMs": 105260,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Sixty six and four months. Every birth\nyear got a slightly later date than"
    } ]
  }, {
    "tStartMs": 110040,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "the one before it, and the climb was so\nslow that most people never noticed"
    } ]
  }, {
    "tStartMs": 114740,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "it was happening to them. If you were born\nin nineteen fifty nine, your full"
    } ]
  }, {
    "tStartMs": 118900,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "age is sixty six and ten months."
    } ]
  }, {
    "tStartMs": 121380,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "That is the last stop before the top."
    } ]
  }, {
    "tStartMs": 124060,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "If you were born earlier than that, yours\nsits somewhere between sixty six"
    } ]
  }, {
    "tStartMs": 127840,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "and sixty six and ten months, and for\nalmost all of you it has already come"
    } ]
  }, {
    "tStartMs": 132280,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "and gone. Now understand what that means\nin practice, because people in this"
    } ]
  }, {
    "tStartMs": 137380,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "group keep worrying about a change that\ncannot reach them."
    } ]
  }, {
    "tStartMs": 140700,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Once you are past your full age, the\nearnings limit no longer applies to you"
    } ]
  }, {
    "tStartMs": 144520,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "at all. You can work as much as you want\nand the agency will not hold back"
    } ]
  }, {
    "tStartMs": 148380,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "a dollar. The reduction for filing early\ncan no longer be applied to you, because"
    } ]
  }, {
    "tStartMs": 153320,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "you are no longer early. The two things\nthat frighten everybody younger than"
    } ]
  }, {
    "tStartMs": 157160,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "you are both behind you. There is one\nthing still open to you, and it is the"
    } ]
  }, {
    "tStartMs": 161920,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "only reason this group should keep\nlistening."
    } ]
  }, {
    "tStartMs": 164320,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "If you have not filed yet, every month you\nwait past your full age still adds"
    } ]
  }, {
    "tStartMs": 168760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "to the payment, all the way to seventy."
    } ]
  }, {
    "tStartMs": 171180,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "I come back to that number in item three,\nand for your group it is the single"
    } ]
  }, {
    "tStartMs": 175060,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "largest decision left."
    } ]
  }, {
    "tStartMs": 176980,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "So for the oldest group: nothing moves."
    } ]
  }, {
    "tStartMs": 179680,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "The step you are standing on is the one\nyou were always going to stand on."
    } ]
  }, {
    "tStartMs": 183900,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "And one more thing for this group, because\nit is the question I get most."
    } ]
  }, {
    "tStartMs": 187340,
    "dDurationMs": 5162,
    "segs": [ {
      "utf8": "The raise for next year is three point six\npercent, and it reaches about seventy"
    } ]
  }, {
    "tStartMs": 192502,
    "dDurationMs": 1638,
    "segs": [ {
      "utf8": "two million people in January."
    } ]
  }, {
    "tStartMs": 194860,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "That raise has nothing to do with your\nbirth year."
    } ]
  }, {
    "tStartMs": 197900,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "It is the same percentage for everybody\ndrawing a payment, whether you were"
    } ]
  }, {
    "tStartMs": 201620,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "born in nineteen forty two or nineteen\nsixty six."
    } ]
  }, {
    "tStartMs": 205560,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "If somebody tells you the raise lands\ndifferently depending on when you were"
    } ]
  }, {
    "tStartMs": 209120,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "born, they are selling you something."
    } ]
  }, {
    "tStartMs": 211780,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Number two. Born in nineteen sixty."
    } ]
  }, {
    "tStartMs": 214740,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "This is the group that moves. This is the\nwhole video in one paragraph, so"
    } ]
  }, {
    "tStartMs": 219320,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "listen to this part twice if you need to."
    } ]
  }, {
    "tStartMs": 221480,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The climb I just described is finished."
    } ]
  }, {
    "tStartMs": 223980,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "It does not go any higher."
    } ]
  }, {
    "tStartMs": 226040,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "If you were born in nineteen sixty or in\nany year after it, your full age is"
    } ]
  }, {
    "tStartMs": 230800,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "sixty seven. Not sixty six and some\nmonths."
    } ]
  }, {
    "tStartMs": 234160,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Sixty seven, flat, with nothing attached\nto it."
    } ]
  }, {
    "tStartMs": 237780,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "And here is the part nobody is saying out\nloud."
    } ]
  }, {
    "tStartMs": 240600,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Nineteen sixty is the first birth year\nthat lives entirely under that rule,"
    } ]
  }, {
    "tStartMs": 244460,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "and that group reaches sixty seven next\nyear."
    } ]
  }, {
    "tStartMs": 247800,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "First to arrive. Not first to be punished,\nnot first to lose something, but"
    } ]
  }, {
    "tStartMs": 252320,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "first to stand on the final step after\nforty years of the staircase moving."
    } ]
  }, {
    "tStartMs": 256780,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Think about how narrow that line is."
    } ]
  }, {
    "tStartMs": 259220,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Somebody born in December of nineteen\nfifty nine has a full age of sixty six"
    } ]
  }, {
    "tStartMs": 263460,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "and ten months. Somebody born a few weeks\nlater, in January of nineteen sixty,"
    } ]
  }, {
    "tStartMs": 268220,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "has a full age of sixty seven."
    } ]
  }, {
    "tStartMs": 270960,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Same street, same job, same work record."
    } ]
  }, {
    "tStartMs": 273540,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Two months of birthday, and one of them\nwaits two extra months for the same"
    } ]
  }, {
    "tStartMs": 277900,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "unreduced payment. And there is a detail\ninside that line which catches people"
    } ]
  }, {
    "tStartMs": 282140,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "every year. If you were born on the first\nday of January, the agency treats"
    } ]
  }, {
    "tStartMs": 286340,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "you as though you were born in December of\nthe year before."
    } ]
  }, {
    "tStartMs": 289020,
    "dDurationMs": 5136,
    "segs": [ {
      "utf8": "So a person born on the first of January,\nnineteen sixty, is handled as a nineteen"
    } ]
  }, {
    "tStartMs": 294156,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "fifty nine birth."
    } ]
  }, {
    "tStartMs": 295680,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "One day decides which side of the line you\nstand on, and nobody at a field"
    } ]
  }, {
    "tStartMs": 299860,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "office is going to volunteer that to you."
    } ]
  }, {
    "tStartMs": 302060,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "There is a second thing about this group\nthat gets missed."
    } ]
  }, {
    "tStartMs": 305800,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Being first means there is nobody ahead of\nyou to watch."
    } ]
  }, {
    "tStartMs": 309480,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Every birth year before yours could look\nat the group in front and see how"
    } ]
  }, {
    "tStartMs": 312820,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "it went. Yours cannot."
    } ]
  }, {
    "tStartMs": 315020,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "The field offices have processed this\nexact situation before, because the rule"
    } ]
  }, {
    "tStartMs": 319400,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "was written in nineteen eighty three and\nthe schedule has been public the whole"
    } ]
  }, {
    "tStartMs": 322960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "time, so this is not uncharted ground for\nthem."
    } ]
  }, {
    "tStartMs": 326180,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "It is only new to you. Now the honest\nlimit of this item."
    } ]
  }, {
    "tStartMs": 330140,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "Reaching sixty seven does not mean money\narrives."
    } ]
  }, {
    "tStartMs": 333060,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "It means that if you file at that age you\nget your whole payment with nothing"
    } ]
  }, {
    "tStartMs": 336800,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "taken off for being early. Filing is still\nyour decision, and the next item"
    } ]
  }, {
    "tStartMs": 341960,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "is about what that decision is actually\nworth."
    } ]
  }, {
    "tStartMs": 345680,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Number three. The three numbers to look at\nbefore you file."
    } ]
  }, {
    "tStartMs": 350200,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "This is the one thing in this video you\ncan act on this week, and it costs"
    } ]
  }, {
    "tStartMs": 355160,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "nothing. Open your own account on the\nagency website."
    } ]
  }, {
    "tStartMs": 359380,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "If you do not have one, make one, because\nan account you control is one that"
    } ]
  }, {
    "tStartMs": 364360,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "nobody else can open in your name."
    } ]
  }, {
    "tStartMs": 367000,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Inside it, your estimated payment is shown\nat different ages."
    } ]
  }, {
    "tStartMs": 371480,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "Put three of them side by side and look at\nthem together."
    } ]
  }, {
    "tStartMs": 375460,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Sixty two."
    } ]
  }, {
    "tStartMs": 376740,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "Your full age. Seventy."
    } ]
  }, {
    "tStartMs": 379440,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "Here is what you are looking at."
    } ]
  }, {
    "tStartMs": 381280,
    "dDurationMs": 5400,
    "segs": [ {
      "utf8": "If your full age is sixty seven and you\nfile at sixty two, the payment is cut"
    } ]
  }, {
    "tStartMs": 386680,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "by roughly thirty percent, and it is cut\nfor the rest of your life."
    } ]
  }, {
    "tStartMs": 390940,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Not for a year. Not until you reach sixty\nseven either."
    } ]
  }, {
    "tStartMs": 394960,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "For good. The reduction is built into the\namount and it never comes back."
    } ]
  }, {
    "tStartMs": 400080,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "If you wait past your full age, the\nopposite happens."
    } ]
  }, {
    "tStartMs": 403220,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "The agency adds roughly eight percent for\nevery year you delay, up to seventy."
    } ]
  }, {
    "tStartMs": 409340,
    "dDurationMs": 3930,
    "segs": [ {
      "utf8": "Wait the whole way and the payment is\nabout one hundred and twenty four percent"
    } ]
  }, {
    "tStartMs": 413310,
    "dDurationMs": 1550,
    "segs": [ {
      "utf8": "of what it would have been at sixty seven."
    } ]
  }, {
    "tStartMs": 415740,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Same person, same record, same work\nhistory."
    } ]
  }, {
    "tStartMs": 419340,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Only the start date changed."
    } ]
  }, {
    "tStartMs": 421620,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "Now the gap between the two ends."
    } ]
  }, {
    "tStartMs": 423960,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Filing at sixty two against waiting to\nseventy is not a small difference."
    } ]
  }, {
    "tStartMs": 428060,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "On the same record it is the difference\nbetween seventy percent and one hundred"
    } ]
  }, {
    "tStartMs": 433400,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "and twenty four percent. That is the\nnumber that stops people in their tracks"
    } ]
  }, {
    "tStartMs": 436900,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "when they finally sit and look at it, and\nalmost nobody looks until the month"
    } ]
  }, {
    "tStartMs": 441240,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "they file."
    } ]
  }, {
    "tStartMs": 442540,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And notice what that gap is actually made\nof."
    } ]
  }, {
    "tStartMs": 445280,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "It is not a reward the agency hands out\nfor patience."
    } ]
  }, {
    "tStartMs": 448520,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "It is arithmetic that was built into the\nsystem from the beginning, designed"
    } ]
  }, {
    "tStartMs": 452940,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "so that whenever you start, the total you\ncollect over an average lifetime"
    } ]
  }, {
    "tStartMs": 456980,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "comes out roughly similar."
    } ]
  }, {
    "tStartMs": 459460,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "The system is not trying to trick you into\nfiling early."
    } ]
  }, {
    "tStartMs": 462400,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "It is also not trying to talk you into\nwaiting."
    } ]
  }, {
    "tStartMs": 465500,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "It is indifferent, and that is exactly why\nnobody calls to advise you either"
    } ]
  }, {
    "tStartMs": 469920,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "way. I am not going to tell you which one\nto pick, because the right answer"
    } ]
  }, {
    "tStartMs": 474340,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "depends on things I cannot see from here."
    } ]
  }, {
    "tStartMs": 476900,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Your health. Whether you have a spouse."
    } ]
  }, {
    "tStartMs": 479600,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Whether you have anything else to live on\nin the meantime."
    } ]
  }, {
    "tStartMs": 482040,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "Plenty of people need the money at sixty\ntwo and that is a real answer, not"
    } ]
  }, {
    "tStartMs": 487060,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "a mistake. But look at the three numbers\nbefore you decide, not after."
    } ]
  }, {
    "tStartMs": 492140,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "Once you file, that reduction is attached\nto you."
    } ]
  }, {
    "tStartMs": 495680,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Number four. Born between nineteen sixty\none and nineteen sixty six."
    } ]
  }, {
    "tStartMs": 500200,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "Same age, later year. If this is your\ngroup, your full age is also sixty seven."
    } ]
  }, {
    "tStartMs": 506140,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Exactly the same as the group before you."
    } ]
  }, {
    "tStartMs": 508760,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "The only thing that differs is the year\nyou get there."
    } ]
  }, {
    "tStartMs": 511620,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "So nothing on this list is aimed at you\nspecifically."
    } ]
  }, {
    "tStartMs": 515120,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "What you should be paying attention to\ninstead is the thing that affects you"
    } ]
  }, {
    "tStartMs": 518480,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "right now, while you are still working,\nbecause most of this group still is."
    } ]
  }, {
    "tStartMs": 523420,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "If you are under your full age for a whole\nyear and you are drawing a payment"
    } ]
  }, {
    "tStartMs": 527480,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "while you work, the agency holds back one\ndollar for every two you earn above"
    } ]
  }, {
    "tStartMs": 532640,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a yearly line."
    } ]
  }, {
    "tStartMs": 534340,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Next year that line is twenty five\nthousand five hundred and sixty dollars."
    } ]
  }, {
    "tStartMs": 538520,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "In the year you actually reach your full\nage the arithmetic softens."
    } ]
  }, {
    "tStartMs": 543100,
    "dDurationMs": 4424,
    "segs": [ {
      "utf8": "The hold back becomes one dollar for every\nthree, the line jumps to sixty seven"
    } ]
  }, {
    "tStartMs": 547524,
    "dDurationMs": 3996,
    "segs": [ {
      "utf8": "thousand nine hundred and twenty dollars,\nand only what you earn in the months"
    } ]
  }, {
    "tStartMs": 551520,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "before your birthday month counts at all."
    } ]
  }, {
    "tStartMs": 554380,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "And the day you reach your full age the\nlimit disappears completely."
    } ]
  }, {
    "tStartMs": 558540,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "Earn whatever you like. Nothing is held\nback from that point forward."
    } ]
  }, {
    "tStartMs": 562780,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Now the part that keeps people from\npanicking, and almost nobody is told it."
    } ]
  }, {
    "tStartMs": 567380,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "The money held back is not a fine."
    } ]
  }, {
    "tStartMs": 569560,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "It is not gone. Once you reach your full\nage the agency recalculates your payment"
    } ]
  }, {
    "tStartMs": 574140,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "upward to account for the months it held\nback, and you get it returned to you"
    } ]
  }, {
    "tStartMs": 578260,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "over time. It feels like a punishment\nwhile it is happening."
    } ]
  }, {
    "tStartMs": 582260,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It is a delay."
    } ]
  }, {
    "tStartMs": 583900,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "What that means for your group is simple."
    } ]
  }, {
    "tStartMs": 586200,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "If you are in your early sixties, still\nworking, and thinking about filing"
    } ]
  }, {
    "tStartMs": 590500,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "because you heard something changes,\nunderstand that filing early while you"
    } ]
  }, {
    "tStartMs": 594680,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "are still earning can mean a permanent\nreduction and a temporary hold back"
    } ]
  }, {
    "tStartMs": 599020,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "at the same time. That is the one\ncombination worth avoiding."
    } ]
  }, {
    "tStartMs": 603460,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Number five. Born in nineteen sixty seven."
    } ]
  }, {
    "tStartMs": 606740,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "The year everyone is naming. Now the year\nI promised you, and the reason I"
    } ]
  }, {
    "tStartMs": 611280,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "made this video."
    } ]
  }, {
    "tStartMs": 612900,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Search this website right now and you will\nfind videos telling you that Social"
    } ]
  }, {
    "tStartMs": 616800,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Security just changed for anyone born\nbefore nineteen sixty seven."
    } ]
  }, {
    "tStartMs": 621500,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "I counted fourteen of them while I was\nwriting this."
    } ]
  }, {
    "tStartMs": 624200,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "So let me be direct about it. There is no\nline at nineteen sixty seven."
    } ]
  }, {
    "tStartMs": 628940,
    "dDurationMs": 4428,
    "segs": [ {
      "utf8": "Your full age is sixty seven, the same as\nevery birth year back to nineteen"
    } ]
  }, {
    "tStartMs": 633368,
    "dDurationMs": 992,
    "segs": [ {
      "utf8": "sixty."
    } ]
  }, {
    "tStartMs": 634400,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Nothing special begins for that group,\nnothing is taken from it, and no rule"
    } ]
  }, {
    "tStartMs": 638920,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "singles it out. The staircase stopped\nclimbing at nineteen sixty and it has"
    } ]
  }, {
    "tStartMs": 643560,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "not moved since. I am not saying that to\nmake anybody look bad."
    } ]
  }, {
    "tStartMs": 648620,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "I am saying it because if you were born in\nthat year and you have been worrying"
    } ]
  }, {
    "tStartMs": 652760,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "for a week about something landing on you,\nit is not landing."
    } ]
  }, {
    "tStartMs": 656900,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "But do not click away, because something\nreal does happen to that group next"
    } ]
  }, {
    "tStartMs": 661360,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "year, and it is the reason the year keeps\ngetting mentioned at all."
    } ]
  }, {
    "tStartMs": 665780,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "If you were born in nineteen sixty seven,\nyou turn sixty next year."
    } ]
  }, {
    "tStartMs": 670960,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Sixty is the earliest age at which a widow\nor a widower can claim a payment"
    } ]
  }, {
    "tStartMs": 675460,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "on the record of a husband or a wife who\nhas died."
    } ]
  }, {
    "tStartMs": 678580,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Not sixty two."
    } ]
  }, {
    "tStartMs": 680260,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "Sixty."
    } ]
  }, {
    "tStartMs": 681340,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "And the vast majority of people have no\nidea that door opens that early, because"
    } ]
  }, {
    "tStartMs": 686460,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "it is the one age in this whole system\nthat nobody advertises."
    } ]
  }, {
    "tStartMs": 691060,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "There is a cost to walking through it at\nsixty rather than waiting, and you"
    } ]
  }, {
    "tStartMs": 695240,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "should know it before you do anything."
    } ]
  }, {
    "tStartMs": 697940,
    "dDurationMs": 4590,
    "segs": [ {
      "utf8": "Claimed at sixty, a survivor payment is\nabout seventy one and a half percent"
    } ]
  }, {
    "tStartMs": 702570,
    "dDurationMs": 2730,
    "segs": [ {
      "utf8": "of what the person who died was receiving\nor had earned."
    } ]
  }, {
    "tStartMs": 706240,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Wait until your own full age and it rises\ntoward the whole amount."
    } ]
  }, {
    "tStartMs": 710700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "So for that group,"
    } ]
  }, {
    "tStartMs": 712340,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "nineteen sixty seven matters, but not for\nthe reason fourteen videos are telling"
    } ]
  }, {
    "tStartMs": 716280,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "you. It matters because of a door at sixty\nthat most people walk past without"
    } ]
  }, {
    "tStartMs": 721180,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "seeing it. So here is the whole thing in\none breath."
    } ]
  }, {
    "tStartMs": 724800,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "The staircase is finished. It stopped at\nsixty seven and it stopped for everybody"
    } ]
  }, {
    "tStartMs": 729840,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "born in nineteen sixty or later."
    } ]
  }, {
    "tStartMs": 732160,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "If you were born in nineteen fifty nine or\nearlier, your step is lower and"
    } ]
  }, {
    "tStartMs": 736760,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "you are already standing on it."
    } ]
  }, {
    "tStartMs": 738600,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "If you were born in nineteen sixty, you\nare the first group to reach the top,"
    } ]
  }, {
    "tStartMs": 742800,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "and you reach it next year. If you were\nborn between nineteen sixty one and"
    } ]
  }, {
    "tStartMs": 746600,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "nineteen sixty six, the top is the same,\nyou just get there later, and the"
    } ]
  }, {
    "tStartMs": 751400,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "thing to watch is the earnings line while\nyou are still working."
    } ]
  }, {
    "tStartMs": 755060,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "And if you were born in nineteen sixty\nseven, nothing lands on you, but a door"
    } ]
  }, {
    "tStartMs": 759240,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "opens at sixty that nobody mentions."
    } ]
  }, {
    "tStartMs": 761960,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "One group moves. The rest of you were told\notherwise."
    } ]
  }, {
    "tStartMs": 765480,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "Here is what I would do this week."
    } ]
  }, {
    "tStartMs": 767320,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "Open your account. Look at the three\nnumbers together, not one at a time."
    } ]
  }, {
    "tStartMs": 771500,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "Write down your own full age and the year\nyou reach it, on paper, where you"
    } ]
  }, {
    "tStartMs": 775960,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "will find it again."
    } ]
  }, {
    "tStartMs": 777520,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "And if a husband or a wife has died and\nyou are anywhere near sixty, find out"
    } ]
  }, {
    "tStartMs": 781680,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "what a survivor payment on their record is\nworth before you assume you have"
    } ]
  }, {
    "tStartMs": 785260,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "to wait."
    } ]
  }, {
    "tStartMs": 786480,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "If your situation has a twist I did not\ncover, a public pension, a divorce,"
    } ]
  }, {
    "tStartMs": 791380,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "a year you barely worked, tell me in the\ncomments."
    } ]
  }, {
    "tStartMs": 794460,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "I read them and they decide what I look\ninto next."
    } ]
  }, {
    "tStartMs": 797260,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "This is general information and not\nguidance about your own record."
    } ]
  }, {
    "tStartMs": 802200,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Your own earnings history and your own\nbirth date decide your figures."
    } ]
  } ]
}
