{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Born before 1961?"
    } ]
  }, {
    "tStartMs": 2860,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Then you stopped owing a stack of bills\nthe day you turned 65."
    } ]
  }, {
    "tStartMs": 7380,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "You probably paid every one of them again\nthis year."
    } ]
  }, {
    "tStartMs": 10740,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Turning 65 did not just hand you Medicare."
    } ]
  }, {
    "tStartMs": 13960,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "It moved you into a different class of\ntaxpayer."
    } ]
  }, {
    "tStartMs": 17460,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "The federal government, your state and\nyour county are all required by law"
    } ]
  }, {
    "tStartMs": 21920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "to treat you differently now."
    } ]
  }, {
    "tStartMs": 24460,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "Nobody is going to call you about it."
    } ]
  }, {
    "tStartMs": 26720,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The tax office stays quiet."
    } ]
  }, {
    "tStartMs": 29140,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "So does Medicare, and so does the state."
    } ]
  }, {
    "tStartMs": 32340,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Every one of them is paid to collect, and\nthat is where their job ends."
    } ]
  }, {
    "tStartMs": 36960,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "The law says you are off the hook."
    } ]
  }, {
    "tStartMs": 39480,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Being off the hook and keeping the money\nare two different things."
    } ]
  }, {
    "tStartMs": 43340,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "One form stands between them, and it never\narrives in your mailbox."
    } ]
  }, {
    "tStartMs": 48200,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Before you wave this away as somebody else\nbusiness."
    } ]
  }, {
    "tStartMs": 51300,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Some of you hear a break for seniors and\nthink you have to be poor."
    } ]
  }, {
    "tStartMs": 55240,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Your home is paid off, so you stop\nlistening."
    } ]
  }, {
    "tStartMs": 58460,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Others think this is for people with an\naccountant."
    } ]
  }, {
    "tStartMs": 61100,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "You live on Social Security and a small\npension, so you stop listening too."
    } ]
  }, {
    "tStartMs": 65600,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Both of you are wrong. I will tell you\nwhich group each one helps."
    } ]
  }, {
    "tStartMs": 69240,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "And if you rent, stay. One of these five\ndecides how fast your rent is allowed"
    } ]
  }, {
    "tStartMs": 74540,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to rise."
    } ]
  }, {
    "tStartMs": 75800,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Five bills. I will name the form and the\noffice for every one."
    } ]
  }, {
    "tStartMs": 80240,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "Bill number one. Your property tax."
    } ]
  }, {
    "tStartMs": 82960,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "This is the big one, and it is not one\nbreak."
    } ]
  }, {
    "tStartMs": 85600,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "It is three, stacked on top of each other,\nand almost nobody has all three."
    } ]
  }, {
    "tStartMs": 91360,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The first one knocks money off the value\nthe county puts on your house, before"
    } ]
  }, {
    "tStartMs": 95800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "they work out the bill."
    } ]
  }, {
    "tStartMs": 97600,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Most places call it a homestead break, and\nthat is all it is."
    } ]
  }, {
    "tStartMs": 101580,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "In most states it is one page, filed once,\nand it is not automatic."
    } ]
  }, {
    "tStartMs": 106480,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "The second sits on top of the first."
    } ]
  }, {
    "tStartMs": 109220,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "A separate break just for being 65."
    } ]
  }, {
    "tStartMs": 112540,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "And here is where the paid-off house crowd\nwalks away, because they hear a"
    } ]
  }, {
    "tStartMs": 116600,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "break for seniors and assume somebody will\ncheck their income."
    } ]
  }, {
    "tStartMs": 120520,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "In more than half the states that offer\nthis, there is no income check at all."
    } ]
  }, {
    "tStartMs": 125560,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Age is the whole qualification."
    } ]
  }, {
    "tStartMs": 128020,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "The third is the one worth the most over\ntime."
    } ]
  }, {
    "tStartMs": 131440,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "A freeze. Once you qualify, the number\nyour house is counted at stops moving."
    } ]
  }, {
    "tStartMs": 137040,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Your neighbors watch theirs climb every\nyear."
    } ]
  }, {
    "tStartMs": 139860,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Yours sits still. And in some counties it\ngoes further than a discount."
    } ]
  }, {
    "tStartMs": 144760,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "In Cobb County in Georgia, a homeowner of\n62 gets the entire school portion"
    } ]
  }, {
    "tStartMs": 150220,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "of the bill removed. Not reduced."
    } ]
  }, {
    "tStartMs": 153280,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Removed. No income limit."
    } ]
  }, {
    "tStartMs": 156020,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The school part is usually the biggest\npiece of the whole bill."
    } ]
  }, {
    "tStartMs": 159960,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Now the part that costs people a year at a\ntime."
    } ]
  }, {
    "tStartMs": 163400,
    "dDurationMs": 5960,
    "segs": [ {
      "utf8": "You must be the right age by the first of\nJanuary, and in Cobb the deadline"
    } ]
  }, {
    "tStartMs": 169360,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "to file is the first of April."
    } ]
  }, {
    "tStartMs": 172620,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "A birthday two weeks into January costs\nyou the whole year."
    } ]
  }, {
    "tStartMs": 177060,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Your move. Call the county tax assessor\nand ask three things."
    } ]
  }, {
    "tStartMs": 182100,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "What breaks do I get now that I am 65."
    } ]
  }, {
    "tStartMs": 185580,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Is there a freeze and how do I lock it in."
    } ]
  }, {
    "tStartMs": 188760,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "And what is the last day to hand the form\nin this year."
    } ]
  }, {
    "tStartMs": 192320,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "Bill number two. Your Medicare Part B\npremium."
    } ]
  }, {
    "tStartMs": 196320,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "The number in your head is out of date."
    } ]
  }, {
    "tStartMs": 198920,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "For this year the standard Part B premium\nis $202.90 a month."
    } ]
  }, {
    "tStartMs": 204800,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "It comes straight out of your Social\nSecurity payment before you ever see it."
    } ]
  }, {
    "tStartMs": 209300,
    "dDurationMs": 1648,
    "segs": [ {
      "utf8": "Last year it was $185."
    } ]
  }, {
    "tStartMs": 212020,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "That is a jump of nearly 10% in one year."
    } ]
  }, {
    "tStartMs": 215680,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "Here is what almost nobody is told."
    } ]
  }, {
    "tStartMs": 218260,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "If your income sits under a line, your\nstate pays that premium for you."
    } ]
  }, {
    "tStartMs": 222960,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Not a discount. The whole thing, every\nmonth, going forward."
    } ]
  }, {
    "tStartMs": 227260,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "There are three levels and the numbers are\nexact."
    } ]
  }, {
    "tStartMs": 230500,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "The first level pays the whole monthly\ncharge, and it wipes out most of what"
    } ]
  }, {
    "tStartMs": 234520,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "you hand over at the doctor and the\nhospital as well."
    } ]
  }, {
    "tStartMs": 237740,
    "dDurationMs": 6280,
    "segs": [ {
      "utf8": "The monthly income line is $1,350 for one\nperson, $1,824"
    } ]
  }, {
    "tStartMs": 244020,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "for a couple."
    } ]
  }, {
    "tStartMs": 245600,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The second level pays the premium only."
    } ]
  }, {
    "tStartMs": 248220,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "$1,616 for one person, $2,184 for a\ncouple."
    } ]
  }, {
    "tStartMs": 253920,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "The third level also pays the premium\nonly, and it goes higher."
    } ]
  }, {
    "tStartMs": 258360,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "$1,816 for one person, $2,455 for a\ncouple."
    } ]
  }, {
    "tStartMs": 263920,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Now two things that nobody mentions, and\nboth of them cost people money."
    } ]
  }, {
    "tStartMs": 268140,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "The first $20 of your monthly income does\nnot count."
    } ]
  }, {
    "tStartMs": 272040,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "Neither does the first $65 of anything you\nearn from work."
    } ]
  }, {
    "tStartMs": 275800,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "So your income on paper can sit above\nthose lines and you can still qualify."
    } ]
  }, {
    "tStartMs": 281280,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "People read the number, do the sum in\ntheir head, and rule themselves out on"
    } ]
  }, {
    "tStartMs": 284920,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "a figure that was never the figure."
    } ]
  }, {
    "tStartMs": 287140,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "The second is about that third level."
    } ]
  }, {
    "tStartMs": 289480,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Congress puts a cap on how much money goes\ninto it each year, and it is handed"
    } ]
  }, {
    "tStartMs": 293180,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "out in the order people apply."
    } ]
  }, {
    "tStartMs": 295300,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "When the money is gone for the year, it is\ngone."
    } ]
  }, {
    "tStartMs": 298300,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "Make this call. Call your state Medicaid\noffice and ask for the Medicare Savings"
    } ]
  }, {
    "tStartMs": 302900,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Program application. It is the state that\nruns it, not Medicare."
    } ]
  }, {
    "tStartMs": 308020,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Bill number three. The tax on your own\nSocial Security check."
    } ]
  }, {
    "tStartMs": 311360,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Here is how they work out whether your\nbenefit gets taxed, and it is simpler"
    } ]
  }, {
    "tStartMs": 315460,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "than people think."
    } ]
  }, {
    "tStartMs": 317000,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Take half of your Social Security for the\nyear."
    } ]
  }, {
    "tStartMs": 319600,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "Add everything else you have coming in."
    } ]
  }, {
    "tStartMs": 321640,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "A pension. Money out of a retirement\naccount."
    } ]
  }, {
    "tStartMs": 324440,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Wages. Interest. That total is the number\nthey measure."
    } ]
  }, {
    "tStartMs": 328280,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Under $25,000 on your own, none of your\nbenefit is taxed."
    } ]
  }, {
    "tStartMs": 332420,
    "dDurationMs": 2746,
    "segs": [ {
      "utf8": "Married and filing together, that line is\n$32,000."
    } ]
  }, {
    "tStartMs": 335800,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Go over it and up to half your benefit\nstarts getting taxed."
    } ]
  }, {
    "tStartMs": 338840,
    "dDurationMs": 6985,
    "segs": [ {
      "utf8": "Go higher, past $34,000 on your own and\n$44,000 married, and it can reach 85%."
    } ]
  }, {
    "tStartMs": 345865,
    "dDurationMs": 4955,
    "segs": [ {
      "utf8": "Hold on to one thing there. Even at the\nvery top, 15% of your Social Security"
    } ]
  }, {
    "tStartMs": 350820,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "is never taxed. That part is yours no\nmatter how high your income goes."
    } ]
  }, {
    "tStartMs": 356240,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "When people sign up for Social Security\nthey are handed a form asking whether"
    } ]
  }, {
    "tStartMs": 360580,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "they want federal tax taken out\nautomatically."
    } ]
  }, {
    "tStartMs": 363880,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Plenty tick the box without doing the sum."
    } ]
  }, {
    "tStartMs": 365980,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "If your total sits under those lines, you\nare handing money to the government"
    } ]
  }, {
    "tStartMs": 370320,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "every month that you were never going to\nowe, and you wait until the following"
    } ]
  }, {
    "tStartMs": 374520,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "spring to get it back."
    } ]
  }, {
    "tStartMs": 376560,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "Do the sum once, tonight, with the figures\nfrom last year."
    } ]
  }, {
    "tStartMs": 380180,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "If you come out under the line and they\nare still taking tax out every month,"
    } ]
  }, {
    "tStartMs": 383880,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "the form that stops it is a W-4V, and it\ngoes to Social Security."
    } ]
  }, {
    "tStartMs": 389240,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Bill number four. A deduction that did not\nexist two years ago."
    } ]
  }, {
    "tStartMs": 392920,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "This one is a gift, and it is the newest\nthing on this list."
    } ]
  }, {
    "tStartMs": 397260,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "Starting with the 2025 tax year there is a\nnew one just for people 65 and older."
    } ]
  }, {
    "tStartMs": 402880,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "$6,000 each, taken straight off the income\nthey tax you on."
    } ]
  }, {
    "tStartMs": 407140,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "It replaces nothing. It sits on top of\nwhat you already had."
    } ]
  }, {
    "tStartMs": 411040,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "Stack the whole lot and look at what it\ncomes to."
    } ]
  }, {
    "tStartMs": 413860,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "The IRS does not tax every dollar you\nbring in."
    } ]
  }, {
    "tStartMs": 416820,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "A set amount comes off the top first, and\neverybody gets it."
    } ]
  }, {
    "tStartMs": 420180,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "This year that set amount is $16,100 on\nyour own, $32,200 if you are married."
    } ]
  }, {
    "tStartMs": 426940,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "On top of that, everyone of 65 gets more."
    } ]
  }, {
    "tStartMs": 430440,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "$2,050 on your own. $1,650 each if you are\nmarried and file together."
    } ]
  }, {
    "tStartMs": 436300,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "And now the $6,000 stacks on as well."
    } ]
  }, {
    "tStartMs": 439080,
    "dDurationMs": 5540,
    "segs": [ {
      "utf8": "A married couple, both over 65, lands\nsomewhere around $47,500 in deductions"
    } ]
  }, {
    "tStartMs": 444620,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "before one single receipt is counted."
    } ]
  }, {
    "tStartMs": 446780,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "For a lot of people living on Social\nSecurity and a modest pension, that number"
    } ]
  }, {
    "tStartMs": 451560,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "alone takes the federal tax bill to\nnothing."
    } ]
  }, {
    "tStartMs": 454340,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Two things to know. If you are both 65 and\nblind, that extra amount is counted"
    } ]
  }, {
    "tStartMs": 458960,
    "dDurationMs": 3243,
    "segs": [ {
      "utf8": "twice. On your own that comes to $4,100."
    } ]
  }, {
    "tStartMs": 462980,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "And the $6,000 is temporary. It runs\nthrough the 2028 tax year and then it"
    } ]
  }, {
    "tStartMs": 467820,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "is gone unless the law is changed."
    } ]
  }, {
    "tStartMs": 470260,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "One question for whoever prepares your\nreturn."
    } ]
  }, {
    "tStartMs": 472920,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Did you take the new senior deduction on\nmy last return."
    } ]
  }, {
    "tStartMs": 475540,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "If the answer is no, that return can be\namended."
    } ]
  }, {
    "tStartMs": 479600,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Bill number five. Your phone, your\ninternet and your heat."
    } ]
  }, {
    "tStartMs": 483620,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Smaller money, easier to get, and the one\nmost people never bother with."
    } ]
  }, {
    "tStartMs": 489100,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "There is a federal program called\nLifeline."
    } ]
  }, {
    "tStartMs": 492300,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "It takes $9.25 a month off a phone bill or\nan internet bill."
    } ]
  }, {
    "tStartMs": 498480,
    "dDurationMs": 6020,
    "segs": [ {
      "utf8": "On tribal land it is $34.25. One per\nhousehold, and"
    } ]
  }, {
    "tStartMs": 504500,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "it is one or the other, not both."
    } ]
  }, {
    "tStartMs": 507680,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Here is the part worth hearing."
    } ]
  }, {
    "tStartMs": 509540,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "If anyone in the house receives food\nassistance, Medicaid,"
    } ]
  }, {
    "tStartMs": 513960,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "Supplemental Security Income, federal\nhousing help or a veterans pension, you"
    } ]
  }, {
    "tStartMs": 519100,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "qualify on that alone. No income check at\nall."
    } ]
  }, {
    "tStartMs": 523220,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Separately there is a program that helps\npay the heating bill itself, and it"
    } ]
  }, {
    "tStartMs": 527420,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "runs on a different application."
    } ]
  }, {
    "tStartMs": 529560,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "In a lot of states it opens on the first\nof October for households with someone"
    } ]
  }, {
    "tStartMs": 534100,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "60 or over, a month before everybody else."
    } ]
  }, {
    "tStartMs": 537820,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Read that again, because it is the part\nthat matters."
    } ]
  }, {
    "tStartMs": 540880,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "60 or over gets in a month early."
    } ]
  }, {
    "tStartMs": 543640,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "That head start exists because the people\nwho run it know that a cold house"
    } ]
  }, {
    "tStartMs": 547820,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "kills older people first. Most of the\nhouseholds it was built for apply in"
    } ]
  }, {
    "tStartMs": 552720,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "November with everybody else and find the\nmoney already committed."
    } ]
  }, {
    "tStartMs": 556760,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "And getting one of these two usually means\nyou get the other."
    } ]
  }, {
    "tStartMs": 559900,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "People apply for the phone discount, get\nit, and never learn the heating one"
    } ]
  }, {
    "tStartMs": 564740,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "was sitting in the same drawer."
    } ]
  }, {
    "tStartMs": 567260,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Now the thing that quietly ends both of\nthem."
    } ]
  }, {
    "tStartMs": 569780,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "You have to confirm you still qualify once\na year."
    } ]
  }, {
    "tStartMs": 573180,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Miss that, and the discount stops."
    } ]
  }, {
    "tStartMs": 575440,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "No warning, no letter, and the bill simply\ngoes back to full price."
    } ]
  }, {
    "tStartMs": 579940,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "People think they lost it. They did not\nlose it."
    } ]
  }, {
    "tStartMs": 582980,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Nobody reminded them. Last thing on this\none."
    } ]
  }, {
    "tStartMs": 586480,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "Lifeline is applied for free, and anybody\nasking you for a fee to do it is"
    } ]
  }, {
    "tStartMs": 590820,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "lying to you. For the heating program,\ncall your local community action agency"
    } ]
  }, {
    "tStartMs": 595700,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "and ask when applications open in your\nstate."
    } ]
  }, {
    "tStartMs": 599240,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "One thing runs underneath all five of\nthese."
    } ]
  }, {
    "tStartMs": 602120,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "Every one of them exists on a form, and\nevery one waits for you to arrive."
    } ]
  }, {
    "tStartMs": 607760,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "The county assessor has your birthday on\nfile and sits on it."
    } ]
  }, {
    "tStartMs": 611420,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "The state knows your income to the dollar\nand sits on it."
    } ]
  }, {
    "tStartMs": 616240,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Social Security knows exactly how much tax\nit is taking out of you every month,"
    } ]
  }, {
    "tStartMs": 620200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "and sits on that too."
    } ]
  }, {
    "tStartMs": 622520,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "They are not hiding anything."
    } ]
  }, {
    "tStartMs": 624700,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "The paperwork sits on public websites,\nfree, for anybody who looks."
    } ]
  }, {
    "tStartMs": 630060,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Careful people still miss it, because a\ndoor opening makes no sound."
    } ]
  }, {
    "tStartMs": 634640,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "Here is where my ground gives out."
    } ]
  }, {
    "tStartMs": 636560,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "I cannot see your return, your county or\nyour income, and those three decide"
    } ]
  }, {
    "tStartMs": 641160,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "most of what is above."
    } ]
  }, {
    "tStartMs": 643000,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Property tax rules and the income lines\nfor state programs are set where you"
    } ]
  }, {
    "tStartMs": 646900,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "live, and they move. For your own"
    } ]
  }, {
    "tStartMs": 649240,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "household the answer sits with whoever\ndoes"
    } ]
  }, {
    "tStartMs": 651620,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "your return, and with the county office\nthat sends the bill."
    } ]
  }, {
    "tStartMs": 655440,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "The five, one more time. Your property tax\ncomes off in three layers, the freeze"
    } ]
  }, {
    "tStartMs": 661240,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "is worth the most, and the deadline is in\nthe spring."
    } ]
  }, {
    "tStartMs": 664360,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "Your Part B premium is $202.90 a month and\nyour state will pay it if your income"
    } ]
  }, {
    "tStartMs": 670220,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "sits under one of three lines, with the\nfirst $20 not counted."
    } ]
  }, {
    "tStartMs": 674880,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "The tax on your Social Security starts at\n$25,000 on your own and $32,000 married,"
    } ]
  }, {
    "tStartMs": 680580,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "and 15% of it is never taxed at all."
    } ]
  }, {
    "tStartMs": 683680,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "There is a new $6,000 deduction for being\n65, it stacks on everything else,"
    } ]
  }, {
    "tStartMs": 688840,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "and it ends after 2028. And the discount\non your phone and your heat needs"
    } ]
  }, {
    "tStartMs": 693460,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "confirming once a year or it quietly\nstops."
    } ]
  }, {
    "tStartMs": 696920,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Somebody calls offering to claim any of\nthis for you, for a fee."
    } ]
  }, {
    "tStartMs": 701340,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "That person is working you."
    } ]
  }, {
    "tStartMs": 703580,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "All five are free to apply for, and the\noffices behind them have never once"
    } ]
  }, {
    "tStartMs": 707720,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "used a salesman."
    } ]
  }, {
    "tStartMs": 709320,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "And if one of your parents is over 65 and\nhas never filed a single one of these,"
    } ]
  }, {
    "tStartMs": 713700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "do not send them this."
    } ]
  }, {
    "tStartMs": 715440,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Sit beside them with the tax bill from\nlast year and start with the county."
    } ]
  } ]
}
