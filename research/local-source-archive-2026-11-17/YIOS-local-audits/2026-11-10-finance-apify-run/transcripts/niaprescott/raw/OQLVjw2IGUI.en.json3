{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Six hundred thousand people are about to\nopen a paper telling them their health"
    } ]
  }, {
    "tStartMs": 4260,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "plan will not exist next year."
    } ]
  }, {
    "tStartMs": 6920,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Not cost more. Not change. End."
    } ]
  }, {
    "tStartMs": 10500,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "The insurers told their investors months\nago which plans were being killed."
    } ]
  }, {
    "tStartMs": 14760,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "The people inside those plans are told\nlast, and the deadline for telling them"
    } ]
  }, {
    "tStartMs": 18860,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "is the second of October."
    } ]
  }, {
    "tStartMs": 21300,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "And if you do nothing after that paper\narrives, you are not moved into a new"
    } ]
  }, {
    "tStartMs": 25540,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "plan. On the first of January you have\nhospital cover, you have doctor cover,"
    } ]
  }, {
    "tStartMs": 30560,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "and you have no cover at all for a single\none of your medicines."
    } ]
  }, {
    "tStartMs": 35280,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Four things decide what that paper costs\nyou."
    } ]
  }, {
    "tStartMs": 38440,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "One of them is a right that lasts sixty\nthree days and disappears, and almost"
    } ]
  }, {
    "tStartMs": 42580,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "nobody is told it exists."
    } ]
  }, {
    "tStartMs": 45000,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Four things. What each one is, and the\ndate each one runs out."
    } ]
  }, {
    "tStartMs": 49860,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Number one is the paper itself, and it is\nnot the one you were warned about"
    } ]
  }, {
    "tStartMs": 54060,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "in September. There are two different\ndocuments and they arrive within days"
    } ]
  }, {
    "tStartMs": 58380,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "of each other, which is exactly why people\nconfuse them."
    } ]
  }, {
    "tStartMs": 62040,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The first is the yearly notice about\nprice."
    } ]
  }, {
    "tStartMs": 64680,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Every plan sends one, every year, and it\ntells you what changes in January."
    } ]
  }, {
    "tStartMs": 69540,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "That paper assumes your plan continues."
    } ]
  }, {
    "tStartMs": 72060,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "It is about a number moving."
    } ]
  }, {
    "tStartMs": 74140,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "The second is the one this video is about."
    } ]
  }, {
    "tStartMs": 76760,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "It says the plan is being withdrawn where\nyou live."
    } ]
  }, {
    "tStartMs": 79680,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "There is no new price on it, because there\nis nothing left to price."
    } ]
  }, {
    "tStartMs": 83720,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "The deadline for that paper to reach you\nis the second of October."
    } ]
  }, {
    "tStartMs": 88240,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The difference matters because the two\ndemand opposite reactions."
    } ]
  }, {
    "tStartMs": 91880,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "The price paper can be read in November\nand still acted on."
    } ]
  }, {
    "tStartMs": 95360,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "The withdrawal paper starts a clock that\nruns past Christmas and into February,"
    } ]
  }, {
    "tStartMs": 99320,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "and you cannot start that clock late."
    } ]
  }, {
    "tStartMs": 102620,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Now the scale of it, because this is not a\nrare event this year."
    } ]
  }, {
    "tStartMs": 107900,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "One insurer alone is dropping around six\nhundred thousand members."
    } ]
  }, {
    "tStartMs": 112920,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "Across the carriers pulling out of\ncounties for next year, reporting puts the"
    } ]
  }, {
    "tStartMs": 117840,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "number affected in the region of three\nmillion older Americans."
    } ]
  }, {
    "tStartMs": 122480,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "That is not a handful of unlucky people in\none town."
    } ]
  }, {
    "tStartMs": 125800,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "That is an entire class of plan being\nclosed in whole counties at once, and"
    } ]
  }, {
    "tStartMs": 131380,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "the closures are decided by profit in\nthose counties, not by anything you did."
    } ]
  }, {
    "tStartMs": 136760,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "And understand the sequence, because it\ntells you where you sit."
    } ]
  }, {
    "tStartMs": 140140,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "The company knew months ago. The stock\nmarket knew months ago."
    } ]
  }, {
    "tStartMs": 145020,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "The office of the doctor you see may\nalready know."
    } ]
  }, {
    "tStartMs": 149520,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "The last person in the chain is the\nmember, and the law lets it be that way"
    } ]
  }, {
    "tStartMs": 154120,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "as long as the paper is posted by the\nsecond of October."
    } ]
  }, {
    "tStartMs": 158720,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Number two is what happens if that paper\ngoes in the bin."
    } ]
  }, {
    "tStartMs": 162140,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "I want to be exact here, because the\nanswer is the opposite of what people"
    } ]
  }, {
    "tStartMs": 166240,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "assume from every other year. In an\nordinary year, ignoring the mail means"
    } ]
  }, {
    "tStartMs": 171520,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "your plan rolls over. It continues at the\nnew price with the new rules, and"
    } ]
  }, {
    "tStartMs": 176820,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "silence is read as agreement."
    } ]
  }, {
    "tStartMs": 179140,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "That is how it has worked every year you\nhave been in it."
    } ]
  }, {
    "tStartMs": 182380,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "This is not that. There is nothing to roll\nover into."
    } ]
  }, {
    "tStartMs": 186300,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "The plan is gone on the thirty first of\nDecember."
    } ]
  }, {
    "tStartMs": 189700,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "So on the first of January you fall back\nto what the government provides directly."
    } ]
  }, {
    "tStartMs": 195080,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Hospital cover continues. Doctor and\noutpatient cover continues."
    } ]
  }, {
    "tStartMs": 199820,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "You are not uninsured and nobody is going\nto turn you away at an emergency"
    } ]
  }, {
    "tStartMs": 203960,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "room. But that basic cover has never\nincluded medicines."
    } ]
  }, {
    "tStartMs": 208320,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Not one. Prescription cover has always\nbeen a separate thing you have to hold,"
    } ]
  }, {
    "tStartMs": 213640,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "and inside your old plan it was bundled in\nso completely that most members"
    } ]
  }, {
    "tStartMs": 218400,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "have no memory of choosing it."
    } ]
  }, {
    "tStartMs": 220400,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "So the woman who throws the paper away has\na working hospital card in January"
    } ]
  }, {
    "tStartMs": 224680,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "and nothing at the pharmacy counter."
    } ]
  }, {
    "tStartMs": 227080,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "She finds out on the day she goes to\ncollect what she takes every morning."
    } ]
  }, {
    "tStartMs": 230860,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "And there is a second cost that arrives\nlater and never leaves."
    } ]
  }, {
    "tStartMs": 235300,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Going without prescription cover builds a\npermanent charge."
    } ]
  }, {
    "tStartMs": 238480,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "For every month you are without it, an\namount is added to what you pay for"
    } ]
  }, {
    "tStartMs": 242660,
    "dDurationMs": 4210,
    "segs": [ {
      "utf8": "drug cover for the rest of your life, and\nit does not stop after a year of"
    } ]
  }, {
    "tStartMs": 246870,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "paying on time."
    } ]
  }, {
    "tStartMs": 248470,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "It is added on and it stays on."
    } ]
  }, {
    "tStartMs": 251090,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So doing nothing here is not neutral and\nit is not a delay."
    } ]
  }, {
    "tStartMs": 255130,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "It buys you a January with no medicines\nand a surcharge you carry until you"
    } ]
  }, {
    "tStartMs": 259630,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "die."
    } ]
  }, {
    "tStartMs": 260750,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Number three is the window, and there are\ntwo of them, and being told about"
    } ]
  }, {
    "tStartMs": 264610,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "only the first one is what costs people\nthe most."
    } ]
  }, {
    "tStartMs": 267730,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "The window everybody talks about opens on\nthe fifteenth of October and shuts"
    } ]
  }, {
    "tStartMs": 272550,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "on the seventh of December."
    } ]
  }, {
    "tStartMs": 274610,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "That one applies to everyone on Medicare,\nevery year, whether anything happened"
    } ]
  }, {
    "tStartMs": 279370,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "to them or not. If your plan is being\nwithdrawn, you get a second window that"
    } ]
  }, {
    "tStartMs": 284490,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "most members never hear about."
    } ]
  }, {
    "tStartMs": 286630,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "It is opened by the withdrawal itself, and\nit runs past the seventh of December."
    } ]
  }, {
    "tStartMs": 291370,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "It begins before the plan ends and"
    } ]
  }, {
    "tStartMs": 293710,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "continues into the new year, through\nFebruary."
    } ]
  }, {
    "tStartMs": 296930,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Read what that actually gives you."
    } ]
  }, {
    "tStartMs": 298610,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "If the seventh of December passes and you\nhave not chosen anything, you are"
    } ]
  }, {
    "tStartMs": 302510,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "not locked out for twelve months the way\nan ordinary member would be."
    } ]
  }, {
    "tStartMs": 306410,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "You still have weeks. The situation is\nbad."
    } ]
  }, {
    "tStartMs": 309590,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "It is not sealed. But two things have to\nbe true for you to use it."
    } ]
  }, {
    "tStartMs": 313790,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "The withdrawal has to have happened to\nyou, and you have to know it has."
    } ]
  }, {
    "tStartMs": 317930,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "A member who never opened the paper does\nnot know she holds an extra window,"
    } ]
  }, {
    "tStartMs": 322170,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "so she does not ask for it, and the person\non the telephone has no reason to"
    } ]
  }, {
    "tStartMs": 326410,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "volunteer it. I will be straight about the\ntrade inside this."
    } ]
  }, {
    "tStartMs": 330250,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Using the second window means part of\nJanuary can pass while your new cover"
    } ]
  }, {
    "tStartMs": 334090,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "is being set up. Using the first window\nmeans everything begins cleanly on"
    } ]
  }, {
    "tStartMs": 339430,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "the first of January. So the second window\nis a rescue, not a plan."
    } ]
  }, {
    "tStartMs": 344790,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Aim for the seventh of December and keep\nthe later one as the thing that saves"
    } ]
  }, {
    "tStartMs": 348590,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "you if you miss."
    } ]
  }, {
    "tStartMs": 350690,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "Number four is the one that is worth the\nmost money and has the shortest life,"
    } ]
  }, {
    "tStartMs": 354850,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "and it is the reason I made this video."
    } ]
  }, {
    "tStartMs": 357490,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Most people over sixty five who want the\nother kind of coverage, the kind that"
    } ]
  }, {
    "tStartMs": 361790,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "sits alongside government Medicare and\npays the share it leaves behind, cannot"
    } ]
  }, {
    "tStartMs": 366270,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "simply buy it. Outside one window at sixty\nfive, an insurer in most states"
    } ]
  }, {
    "tStartMs": 371590,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "is allowed to ask about your health, and\nis allowed to say no, and is allowed"
    } ]
  }, {
    "tStartMs": 376130,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "to charge you more because of what you\nhave had."
    } ]
  }, {
    "tStartMs": 378570,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "A person who has had cancer, or heart\ntrouble, or diabetes, is not going to"
    } ]
  }, {
    "tStartMs": 383810,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "be sold that policy on ordinary terms."
    } ]
  }, {
    "tStartMs": 386250,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "That is the reality, and it is why so many\npeople stay in a plan they dislike."
    } ]
  }, {
    "tStartMs": 391090,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "They believe the door closed years ago."
    } ]
  }, {
    "tStartMs": 393850,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "When your plan is withdrawn, that door\nopens again by law."
    } ]
  }, {
    "tStartMs": 397930,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "A withdrawal gives you a guaranteed right\nto buy certain of those policies."
    } ]
  }, {
    "tStartMs": 401950,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "The insurer must sell to you. They are not\nallowed to ask about your health."
    } ]
  }, {
    "tStartMs": 405730,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "They are not allowed to charge you more\nbecause of your history, and they are"
    } ]
  }, {
    "tStartMs": 409470,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "not allowed to make you wait out a\ncondition you already have."
    } ]
  }, {
    "tStartMs": 412810,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "For somebody with a real medical history,\nthat is the most valuable thing in"
    } ]
  }, {
    "tStartMs": 416690,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "this entire video, and it exists only\nbecause the company walked away from"
    } ]
  }, {
    "tStartMs": 420990,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "the county. Now the part that makes it\nurgent rather than merely good."
    } ]
  }, {
    "tStartMs": 426070,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The right lasts sixty three days from the\nday your cover ends."
    } ]
  }, {
    "tStartMs": 429870,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Sixty three days. Not sixty three days\nfrom when you get round to reading the"
    } ]
  }, {
    "tStartMs": 433730,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "paper. On day sixty four you are an\nordinary applicant again."
    } ]
  }, {
    "tStartMs": 438450,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "In most states that means the health\nquestions come back, and the answer for"
    } ]
  }, {
    "tStartMs": 442190,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "a person with a history is often no, or\nyes at a price built for somebody who"
    } ]
  }, {
    "tStartMs": 446690,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "has been ill. So the sequence that costs a\nperson the most is not dramatic."
    } ]
  }, {
    "tStartMs": 450950,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "She opens the paper in October."
    } ]
  }, {
    "tStartMs": 452890,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "She is upset. She decides to deal with it\nafter the holidays."
    } ]
  }, {
    "tStartMs": 456810,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "She telephones in the middle of February,\nand the right that would have got"
    } ]
  }, {
    "tStartMs": 460490,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "her in without a single question expired\nwhile she was waiting for a quieter"
    } ]
  }, {
    "tStartMs": 464630,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "week. What to do now, and a plain word\nbefore the list."
    } ]
  }, {
    "tStartMs": 468930,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "This describes how these rules work\ngenerally."
    } ]
  }, {
    "tStartMs": 471690,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Which plans are being withdrawn depends\nentirely on the county you live in,"
    } ]
  }, {
    "tStartMs": 475690,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "and the exact dates on your own notice\ngovern your case, so use the paper in"
    } ]
  }, {
    "tStartMs": 480290,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "your hand and the free help named below\nrather than my word for any of it."
    } ]
  }, {
    "tStartMs": 485070,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "Go and find the mail from the last two\nweeks and separate it into two piles."
    } ]
  }, {
    "tStartMs": 489410,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Anything from the government in one."
    } ]
  }, {
    "tStartMs": 491710,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Anything from your insurance company in\nthe other."
    } ]
  }, {
    "tStartMs": 494330,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Open every single item in the second pile,\nincluding the ones that look like"
    } ]
  }, {
    "tStartMs": 497910,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "advertising. You are looking for one\nsentence."
    } ]
  }, {
    "tStartMs": 500810,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "It will say the plan is being"
    } ]
  }, {
    "tStartMs": 502230,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "discontinued, or withdrawn, or will not be\noffered"
    } ]
  }, {
    "tStartMs": 505550,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "in your area next year. If you find it,\nwrite on the top of that paper the"
    } ]
  }, {
    "tStartMs": 510010,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "date your cover ends, and count sixty\nthree days forward from it, and write"
    } ]
  }, {
    "tStartMs": 514290,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "that date too. That second date is the one\nnobody will remind you of."
    } ]
  }, {
    "tStartMs": 519050,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Then telephone the number printed on your\nplan card and ask two questions in"
    } ]
  }, {
    "tStartMs": 522810,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "these words. Is my plan being offered in\nmy county next year."
    } ]
  }, {
    "tStartMs": 526730,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "And if it is not, what is the last date my\ncover runs."
    } ]
  }, {
    "tStartMs": 530230,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Whatever they say, ask for it in writing."
    } ]
  }, {
    "tStartMs": 532670,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "A telephone answer will not prove anything\nin February."
    } ]
  }, {
    "tStartMs": 535750,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "If no such paper turns up and you are\nstill unsure, there is somewhere to ask"
    } ]
  }, {
    "tStartMs": 539630,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "that costs nothing and has no stake in\nyour answer."
    } ]
  }, {
    "tStartMs": 542290,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "Every state runs an advice office for\nexactly this, paid for publicly, with"
    } ]
  }, {
    "tStartMs": 547410,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "no commission attached to anything you\ndecide."
    } ]
  }, {
    "tStartMs": 550010,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "It is called the state health insurance\nassistance program."
    } ]
  }, {
    "tStartMs": 553370,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Telephone yours and put it as a single\nquestion."
    } ]
  }, {
    "tStartMs": 556230,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "Is my plan being offered in my county next\nyear."
    } ]
  }, {
    "tStartMs": 559430,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "Now the warning, and this season is\nexactly when it happens."
    } ]
  }, {
    "tStartMs": 563190,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "A withdrawal notice makes you valuable."
    } ]
  }, {
    "tStartMs": 565670,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "Lists of affected members circulate, and\nthe telephone starts."
    } ]
  }, {
    "tStartMs": 569410,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The caller will already seem to know your\nplan ended, which is how they earn"
    } ]
  }, {
    "tStartMs": 573090,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "your trust in the first ten seconds, and\nthe pressure will be to decide today"
    } ]
  }, {
    "tStartMs": 577250,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "because time is short."
    } ]
  }, {
    "tStartMs": 579010,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "Time is short. That is true. It is also\nthe oldest reason ever used to make"
    } ]
  }, {
    "tStartMs": 583550,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "an older person sign something in one\nsitting."
    } ]
  }, {
    "tStartMs": 586350,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Nothing here requires a salesperson."
    } ]
  }, {
    "tStartMs": 589090,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "The free state service will walk through\nyour options and takes no commission."
    } ]
  }, {
    "tStartMs": 593790,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Your right to buy without health questions\nbelongs to you because a company"
    } ]
  }, {
    "tStartMs": 597810,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "left your county, and no agent creates it,\ngrants it, or can take it away."
    } ]
  }, {
    "tStartMs": 603270,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "And nobody legitimate needs your bank\ndetails or your Medicare number to tell"
    } ]
  }, {
    "tStartMs": 606990,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "you whether your plan is continuing."
    } ]
  }, {
    "tStartMs": 608990,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "That answer is on the card in your purse\nand on the paper they were required"
    } ]
  }, {
    "tStartMs": 612430,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to send you."
    } ]
  }, {
    "tStartMs": 613910,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Put the four together and this is the\nwhole picture."
    } ]
  }, {
    "tStartMs": 616810,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Two papers arrive within days of each\nother and they mean opposite things."
    } ]
  }, {
    "tStartMs": 620750,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "One says the price is moving. The other\nsays the plan is ending, and the last"
    } ]
  }, {
    "tStartMs": 625670,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "date for it to reach you is the second of\nOctober."
    } ]
  }, {
    "tStartMs": 629010,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Ignoring it does not renew anything."
    } ]
  }, {
    "tStartMs": 631070,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "It drops you to government cover with no\nprescription cover at all, and starts"
    } ]
  }, {
    "tStartMs": 635090,
    "dDurationMs": 2060,
    "segs": [ {
      "utf8": "a surcharge that stays with you for life."
    } ]
  }, {
    "tStartMs": 637910,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "The seventh of December is the date to aim\nfor, but a withdrawal gives you"
    } ]
  }, {
    "tStartMs": 641610,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "a second window that runs into February,\nand that one is a rescue rather than"
    } ]
  }, {
    "tStartMs": 646370,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "a plan. And a withdrawal opens the door to\nbuy the coverage that health questions"
    } ]
  }, {
    "tStartMs": 650730,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "normally keep closed, for sixty three days\nfrom the day your cover ends, and"
    } ]
  }, {
    "tStartMs": 655410,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "not one day longer. Not one of these four\nis secret."
    } ]
  }, {
    "tStartMs": 659130,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Every one is printed, posted and dated."
    } ]
  }, {
    "tStartMs": 661790,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "They work the way they do because a\ndecision made in a boardroom in the spring"
    } ]
  }, {
    "tStartMs": 665170,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "reaches the person it affects in October,\nin a paper that looks like every"
    } ]
  }, {
    "tStartMs": 669250,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "other paper that company has ever sent."
    } ]
  }, {
    "tStartMs": 671330,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "So go and open the mail tonight."
    } ]
  }, {
    "tStartMs": 673570,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "And if your mother or your father is on\none of these plans, telephone and ask"
    } ]
  }, {
    "tStartMs": 677810,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "them one thing. Has anything come from the\ninsurance company this month, and"
    } ]
  }, {
    "tStartMs": 682050,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "did you open it."
    } ]
  } ]
}
