{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "Social Security does not have to tell you\nwhat is left of your raise."
    } ]
  }, {
    "tStartMs": 5080,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Nobody at that agency is required to send\nyou that number."
    } ]
  }, {
    "tStartMs": 8800,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "They gave you 3.6% back in October."
    } ]
  }, {
    "tStartMs": 12260,
    "dDurationMs": 6020,
    "segs": [ {
      "utf8": "About $75 a month. Both real. Neither one\nis what lands in your January check."
    } ]
  }, {
    "tStartMs": 19080,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Five things come for that money on the\nfirst of January."
    } ]
  }, {
    "tStartMs": 22220,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Not one of them needs your permission."
    } ]
  }, {
    "tStartMs": 24640,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "One of them arrives as a letter, and it\ncan take half your check."
    } ]
  }, {
    "tStartMs": 28420,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "Half. There are three forms that stop it\nand roughly 90 days to send one, and"
    } ]
  }, {
    "tStartMs": 33900,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "most people who get that letter sit on it\nuntil the money is already gone."
    } ]
  }, {
    "tStartMs": 38620,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Two of the five have numbers that nobody\ncan give you today."
    } ]
  }, {
    "tStartMs": 41980,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "Not me, not your plan, not the agency."
    } ]
  }, {
    "tStartMs": 45520,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "The figures are not published yet."
    } ]
  }, {
    "tStartMs": 47800,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "The money comes out anyway. No county\noffice."
    } ]
  }, {
    "tStartMs": 51200,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "No number you have to beg someone for."
    } ]
  }, {
    "tStartMs": 53820,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "Five things, in order, and what each one\ntakes."
    } ]
  }, {
    "tStartMs": 57180,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Before the five, here is where my\nknowledge stops."
    } ]
  }, {
    "tStartMs": 60680,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "I can tell you what is already decided and\nsigned."
    } ]
  }, {
    "tStartMs": 63900,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "I cannot tell you your own figure, because\nyour plan, your state and your own"
    } ]
  }, {
    "tStartMs": 68880,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "record decide that."
    } ]
  }, {
    "tStartMs": 70640,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Three of these five reach everybody on\nMedicare."
    } ]
  }, {
    "tStartMs": 74080,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Two of them reach you only in certain\nsituations, and when we get to those"
    } ]
  }, {
    "tStartMs": 78060,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "two I will say so at the top, not at the\nbottom."
    } ]
  }, {
    "tStartMs": 81780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "Number one. The Part B premium."
    } ]
  }, {
    "tStartMs": 83760,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Nobody can tell you the amount yet."
    } ]
  }, {
    "tStartMs": 86780,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "This is the one that reaches your money\nfirst."
    } ]
  }, {
    "tStartMs": 89500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Before the raise ever shows up in your\naccount, the Part B premium comes out"
    } ]
  }, {
    "tStartMs": 93500,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "of it. Right now that is $202.90 every\nmonth."
    } ]
  }, {
    "tStartMs": 98340,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "It goes up almost every January, and the\namount for next year is not published."
    } ]
  }, {
    "tStartMs": 103680,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "Think about what that means for a second."
    } ]
  }, {
    "tStartMs": 106280,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "They announced your raise in October."
    } ]
  }, {
    "tStartMs": 108480,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "The thing that eats the biggest piece of\nthat raise will not be announced until"
    } ]
  }, {
    "tStartMs": 113020,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "the middle of November. So for about a\nmonth, every senior in this country"
    } ]
  }, {
    "tStartMs": 118020,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "was told a number that nobody could\nfinish."
    } ]
  }, {
    "tStartMs": 121180,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So the $75 they talked about is not $75."
    } ]
  }, {
    "tStartMs": 125880,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "Part B gets there before you do."
    } ]
  }, {
    "tStartMs": 128120,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "And today nobody can tell you by how much,\nbecause the figure is not out."
    } ]
  }, {
    "tStartMs": 133400,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "Here is the part people get wrong."
    } ]
  }, {
    "tStartMs": 135460,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "They think the premium is a bill they pay."
    } ]
  }, {
    "tStartMs": 137720,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "For most people it is not a bill at all."
    } ]
  }, {
    "tStartMs": 141100,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "It is pulled straight out of the payment\nbefore the payment reaches the bank."
    } ]
  }, {
    "tStartMs": 145920,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "You never see the money. You never write\nanything."
    } ]
  }, {
    "tStartMs": 150020,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "There is no moment where you decide."
    } ]
  }, {
    "tStartMs": 152700,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "That is also why the increase is so easy\nto miss."
    } ]
  }, {
    "tStartMs": 156320,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "A bill that goes up, you notice."
    } ]
  }, {
    "tStartMs": 158940,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "A deduction that goes up inside a payment\nthat also went up in the same month,"
    } ]
  }, {
    "tStartMs": 163000,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "you do not notice. The raise and the\ndeduction land together, and the number"
    } ]
  }, {
    "tStartMs": 167780,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "in your account looks bigger, so you\nassume the raise came through."
    } ]
  }, {
    "tStartMs": 171880,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "There is one more thing about this\ndeduction that nobody explains."
    } ]
  }, {
    "tStartMs": 176000,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "It does not come out evenly across the\nyear."
    } ]
  }, {
    "tStartMs": 179160,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "It comes out at the full new amount from\nthe very first payment of January."
    } ]
  }, {
    "tStartMs": 184300,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "So whatever the increase turns out to be,\nyou absorb all of it immediately."
    } ]
  }, {
    "tStartMs": 189140,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "There is no easing in. There is a rule\nthat stops your payment from actually"
    } ]
  }, {
    "tStartMs": 194320,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "dropping. If the premium increase would be\nlarger in dollars than your raise,"
    } ]
  }, {
    "tStartMs": 199520,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "the increase gets cut back so your payment\nstays level instead of shrinking."
    } ]
  }, {
    "tStartMs": 204660,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "That sounds like protection, and for that\nmonth it is."
    } ]
  }, {
    "tStartMs": 208220,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "What it really means is that you were told\nabout a raise and will receive none"
    } ]
  }, {
    "tStartMs": 212520,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "of it. And that rule does not cover\neverybody."
    } ]
  }, {
    "tStartMs": 216380,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "It reaches you only if the premium already\ncomes out of your Social Security"
    } ]
  }, {
    "tStartMs": 220960,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "payment. If you pay Medicare directly\ninstead, you are not covered."
    } ]
  }, {
    "tStartMs": 226580,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "If next year is your first year on Part B,\nyou are not covered."
    } ]
  }, {
    "tStartMs": 231500,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "If your income is high enough that you pay\nextra for Medicare, you are not"
    } ]
  }, {
    "tStartMs": 235880,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "covered at all, not even on the basic\namount."
    } ]
  }, {
    "tStartMs": 239180,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "And if your state pays your premium for\nyou, the rule does not reach you either."
    } ]
  }, {
    "tStartMs": 245440,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Roughly three in every ten people on\nMedicare sit outside it."
    } ]
  }, {
    "tStartMs": 248760,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "It also does not cover the doctor costs I\ncome to in a few minutes, and it"
    } ]
  }, {
    "tStartMs": 253540,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "does not cover any late penalty you are\ncarrying."
    } ]
  }, {
    "tStartMs": 256820,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "What you can actually do about this one is\nalmost nothing, and I am not going"
    } ]
  }, {
    "tStartMs": 261180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to pretend otherwise."
    } ]
  }, {
    "tStartMs": 262980,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "You cannot refuse it. You cannot pay it\nlater."
    } ]
  }, {
    "tStartMs": 266820,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "You cannot ask for it monthly instead of\ntaken at the source."
    } ]
  }, {
    "tStartMs": 270440,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "The one thing you can do is know the\nfigure the day it comes out, so you can"
    } ]
  }, {
    "tStartMs": 275760,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "work out what is really left instead of\nguessing."
    } ]
  }, {
    "tStartMs": 279480,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "The middle of November. Mark it."
    } ]
  }, {
    "tStartMs": 282280,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Number two. The first $700 of your\nmedicine."
    } ]
  }, {
    "tStartMs": 286420,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "That part is yours. If you have a drug\nplan, there is an amount you pay yourself"
    } ]
  }, {
    "tStartMs": 291660,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "before the plan pays anything at all."
    } ]
  }, {
    "tStartMs": 293980,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "This year that amount tops out at $615."
    } ]
  }, {
    "tStartMs": 297720,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "Starting the first of January it tops out\nat $700."
    } ]
  }, {
    "tStartMs": 302440,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "That is $85 more out of your own pocket,\nand it comes at"
    } ]
  }, {
    "tStartMs": 308640,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "the worst possible time of year, because\nit resets on the first."
    } ]
  }, {
    "tStartMs": 314260,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Whatever you paid this year is finished."
    } ]
  }, {
    "tStartMs": 317020,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It does not carry."
    } ]
  }, {
    "tStartMs": 318940,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "On the second of January you are back at\nthe beginning of the ladder."
    } ]
  }, {
    "tStartMs": 323480,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "I want you to see how this collides with\nthe thing I just told you."
    } ]
  }, {
    "tStartMs": 327780,
    "dDurationMs": 5480,
    "segs": [ {
      "utf8": "Your raise lands in January. Your medicine\nbill also restarts in January."
    } ]
  }, {
    "tStartMs": 333620,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "If you fill anything in the first week,\nthe money the raise was supposed to"
    } ]
  }, {
    "tStartMs": 338000,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "give you is already at the pharmacy\ncounter."
    } ]
  }, {
    "tStartMs": 341080,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Some plans do not have that starting\namount at all, or they have a smaller"
    } ]
  }, {
    "tStartMs": 345140,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "one. That is real, and if that is your\nplan, good."
    } ]
  }, {
    "tStartMs": 349120,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "But the plans with no starting amount\nusually charge more every month instead,"
    } ]
  }, {
    "tStartMs": 353820,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "so you paid it anyway, just spread out."
    } ]
  }, {
    "tStartMs": 356380,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "And here is the piece that makes people\nangry."
    } ]
  }, {
    "tStartMs": 359780,
    "dDurationMs": 2220,
    "segs": [ {
      "utf8": "Your plan did write to you about this."
    } ]
  }, {
    "tStartMs": 362380,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "The notice went out at the end of\nSeptember."
    } ]
  }, {
    "tStartMs": 364760,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "It is a thick envelope that looks like\nadvertising, and it tells you exactly"
    } ]
  }, {
    "tStartMs": 369300,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "what your plan is doing in January."
    } ]
  }, {
    "tStartMs": 371760,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Most people throw it away. I am not going\nto tell you that is your fault, because"
    } ]
  }, {
    "tStartMs": 376200,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "the thing is written to be thrown away."
    } ]
  }, {
    "tStartMs": 378020,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "But the letter exists, and if you still\nhave it, the number is in there."
    } ]
  }, {
    "tStartMs": 382860,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "There is also a trap in the order of\nevents here, and it is worth two minutes"
    } ]
  }, {
    "tStartMs": 387340,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "of your life. The window to change drug\nplans for next year closes on the seventh"
    } ]
  }, {
    "tStartMs": 392680,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "of December. The amount you will pay was\ndecided months before that."
    } ]
  }, {
    "tStartMs": 397120,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "So the people who find out in January what\ntheir starting amount is are finding"
    } ]
  }, {
    "tStartMs": 401500,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "out several weeks after the last day they\ncould have done anything about it."
    } ]
  }, {
    "tStartMs": 405740,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "That is the whole design."
    } ]
  }, {
    "tStartMs": 408500,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "The price is set in the autumn, the\nwarning goes out in an envelope that looks"
    } ]
  }, {
    "tStartMs": 412960,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "like junk, the door shuts in early"
    } ]
  }, {
    "tStartMs": 415460,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "December, and the money comes out in\nJanuary."
    } ]
  }, {
    "tStartMs": 419120,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Nobody breaks a rule anywhere in that\nsequence."
    } ]
  }, {
    "tStartMs": 422020,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "It just happens in an order that works\nagainst you."
    } ]
  }, {
    "tStartMs": 426060,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "So if you are watching this before the\nseventh of December, you still have"
    } ]
  }, {
    "tStartMs": 430380,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a door."
    } ]
  }, {
    "tStartMs": 431660,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Compare what you have against what else is\noffered in your area, and look at"
    } ]
  }, {
    "tStartMs": 435860,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "the starting amount, not only at the\nmonthly cost."
    } ]
  }, {
    "tStartMs": 439640,
    "dDurationMs": 5800,
    "segs": [ {
      "utf8": "A plan that charges you less every month\nand makes you pay $700 first is not"
    } ]
  }, {
    "tStartMs": 445440,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "cheaper. It is just cheaper until you get\nsick."
    } ]
  }, {
    "tStartMs": 448800,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Number three. The overpayment letter."
    } ]
  }, {
    "tStartMs": 452240,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Half your check, and the three forms that\nstop it."
    } ]
  }, {
    "tStartMs": 455400,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "This is the one that can take the most,\nand it is the only one on this list"
    } ]
  }, {
    "tStartMs": 460360,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "you can actually stop."
    } ]
  }, {
    "tStartMs": 462880,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "So if you remember one thing from today,\nremember this one."
    } ]
  }, {
    "tStartMs": 467080,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "If the agency decides it paid you more\nthan it should have, at any point, going"
    } ]
  }, {
    "tStartMs": 472280,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "back years, it sends a letter."
    } ]
  }, {
    "tStartMs": 474580,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "That letter says you owe the money back."
    } ]
  }, {
    "tStartMs": 477700,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "And unless you answer it, the agency"
    } ]
  }, {
    "tStartMs": 480100,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "starts taking the money out of your\nmonthly"
    } ]
  }, {
    "tStartMs": 482260,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "payment. There is a number inside that\nletter that almost nobody knows about."
    } ]
  }, {
    "tStartMs": 488020,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "The amount it takes by default is half."
    } ]
  }, {
    "tStartMs": 491460,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Half of your monthly retirement, survivor\nor disability payment, every month,"
    } ]
  }, {
    "tStartMs": 496320,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "until the balance is cleared. It used to\nbe a tenth."
    } ]
  }, {
    "tStartMs": 500200,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "For letters sent out since the spring of\nlast year, the standard is half."
    } ]
  }, {
    "tStartMs": 505880,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Read that again if you need to."
    } ]
  }, {
    "tStartMs": 508460,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "Not half of the extra."
    } ]
  }, {
    "tStartMs": 510660,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "Half of the whole payment. If your check\nis the thing that pays the rent, the"
    } ]
  }, {
    "tStartMs": 515640,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "agency can cut it down the middle while it\ncollects, and it does not need a"
    } ]
  }, {
    "tStartMs": 519780,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "judge or a hearing to do it, because the\nmoney was never ruled to be yours."
    } ]
  }, {
    "tStartMs": 524300,
    "dDurationMs": 6320,
    "segs": [ {
      "utf8": "And understand where these letters come\nfrom, because it is almost never fraud."
    } ]
  }, {
    "tStartMs": 531520,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "Somebody worked a few months and the\nearnings got counted late."
    } ]
  }, {
    "tStartMs": 535380,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "A spouse died and two payments crossed in\nthe same month."
    } ]
  }, {
    "tStartMs": 539400,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "A disability review changed a date going\nbackward."
    } ]
  }, {
    "tStartMs": 542820,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "The agency made an arithmetic error years\nago and found it in a cleanup."
    } ]
  }, {
    "tStartMs": 547900,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "You did nothing. The letter still comes,\nand the letter still says you owe."
    } ]
  }, {
    "tStartMs": 553540,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "If what you get is the payment for people\nwith very little income and few resources,"
    } ]
  }, {
    "tStartMs": 558820,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "the standard for that one is still a\ntenth, not half."
    } ]
  }, {
    "tStartMs": 562740,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "That difference matters, so know which\npayment you receive."
    } ]
  }, {
    "tStartMs": 566180,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Now the part that actually helps you."
    } ]
  }, {
    "tStartMs": 568340,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "You get roughly 90 days before the money\nstarts coming out."
    } ]
  }, {
    "tStartMs": 571680,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "In that window you can do three things,\nand all three of them are free."
    } ]
  }, {
    "tStartMs": 576040,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "You can ask them to wipe the debt."
    } ]
  }, {
    "tStartMs": 578740,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "That is the waiver request. You use it\nwhen the mistake was not yours and paying"
    } ]
  }, {
    "tStartMs": 583980,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "it back would leave you unable to cover\nyour own bills."
    } ]
  }, {
    "tStartMs": 587380,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "You can tell them they are wrong about the\nmoney."
    } ]
  }, {
    "tStartMs": 590720,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "That is the reconsideration request."
    } ]
  }, {
    "tStartMs": 593500,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "You use it when you do not believe you\nwere overpaid at all."
    } ]
  }, {
    "tStartMs": 597580,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Or you can accept the debt and refuse the\nspeed."
    } ]
  }, {
    "tStartMs": 601620,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "That is the request to change the rate."
    } ]
  }, {
    "tStartMs": 604080,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "You tell them what you can actually afford\neach month, and they lower the amount"
    } ]
  }, {
    "tStartMs": 608560,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "they take. Sending any one of those\nfreezes the collection while they look"
    } ]
  }, {
    "tStartMs": 613680,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "at it. Sending nothing is what starts the\nclock."
    } ]
  }, {
    "tStartMs": 617700,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "And that is exactly what most people do."
    } ]
  }, {
    "tStartMs": 621000,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "The letter is long, it is frightening, it\nuses language nobody speaks, and"
    } ]
  }, {
    "tStartMs": 626640,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "it sits on the kitchen table until the\nfirst short payment arrives and it is"
    } ]
  }, {
    "tStartMs": 631340,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "too late to be gentle about it."
    } ]
  }, {
    "tStartMs": 633920,
    "dDurationMs": 5160,
    "segs": [ {
      "utf8": "You can start any of the three by calling\nthe agency or by going into your"
    } ]
  }, {
    "tStartMs": 639080,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "own account on their website. You do not\nneed a lawyer and you do not need"
    } ]
  }, {
    "tStartMs": 643700,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "to pay anybody."
    } ]
  }, {
    "tStartMs": 645360,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "If someone offers to handle it for a fee,\nthat is a person making money from"
    } ]
  }, {
    "tStartMs": 650080,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "your fear."
    } ]
  }, {
    "tStartMs": 651580,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "Number four. On the first of January your\ndoctor bill starts over at zero."
    } ]
  }, {
    "tStartMs": 656800,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "There is a second starting amount,\nseparate from your medicine, and this one"
    } ]
  }, {
    "tStartMs": 661540,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "is for doctors, tests and outpatient care."
    } ]
  }, {
    "tStartMs": 664620,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "This year it is $283."
    } ]
  }, {
    "tStartMs": 668460,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "It resets on the first of January, and the\namount for next year is not published"
    } ]
  }, {
    "tStartMs": 673240,
    "dDurationMs": 5220,
    "segs": [ {
      "utf8": "yet either. So that is two of the five\nwhere the figure does not exist today."
    } ]
  }, {
    "tStartMs": 678900,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "What resetting means in practice is simple\nand it is harsh."
    } ]
  }, {
    "tStartMs": 683500,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "If you had a hard year, if you hit that\namount in February and the coverage"
    } ]
  }, {
    "tStartMs": 687900,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "carried you through to December, none of\nthat follows you."
    } ]
  }, {
    "tStartMs": 691000,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The first of January, you owe it again\nfrom the beginning."
    } ]
  }, {
    "tStartMs": 695320,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "The calendar does not care that you only\nfinished paying it 11 months ago."
    } ]
  }, {
    "tStartMs": 700120,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "This is the one that catches people who\nget sick early in the year."
    } ]
  }, {
    "tStartMs": 704540,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "January, February, March is when this\nbites, because that is when everybody"
    } ]
  }, {
    "tStartMs": 708880,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "is starting over at once. And because it\nis a starting amount and not a monthly"
    } ]
  }, {
    "tStartMs": 713360,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "bill, there is no envelope to warn you."
    } ]
  }, {
    "tStartMs": 716100,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "You find out at the front desk."
    } ]
  }, {
    "tStartMs": 718000,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "I am not giving you a way around this one,\nbecause there is not one."
    } ]
  }, {
    "tStartMs": 722980,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "What I can tell you is that if you have a\nchoice about when something gets"
    } ]
  }, {
    "tStartMs": 726520,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "done, and it is not urgent, the end of a\nyear that you have already paid through"
    } ]
  }, {
    "tStartMs": 731480,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "is cheaper than the start of a year you\nhave not."
    } ]
  }, {
    "tStartMs": 734540,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "A test in late December and the same test\nin early January are the same test"
    } ]
  }, {
    "tStartMs": 739640,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "at two very different prices, and the only\nthing that changed was the calendar."
    } ]
  }, {
    "tStartMs": 745260,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "One more thing about this amount, because\npeople assume wrongly."
    } ]
  }, {
    "tStartMs": 748840,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "The rule I mentioned earlier, the one that\nstops your payment from dropping,"
    } ]
  }, {
    "tStartMs": 753440,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "does not touch this. It covers the monthly\npremium only."
    } ]
  }, {
    "tStartMs": 757580,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "This starting amount can rise every\nJanuary no matter what your raise was,"
    } ]
  }, {
    "tStartMs": 762540,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and nothing holds it back. Number five."
    } ]
  }, {
    "tStartMs": 765640,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "The $2,400 line."
    } ]
  }, {
    "tStartMs": 768780,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "Nothing is free until you cross it."
    } ]
  }, {
    "tStartMs": 771220,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "This one reaches you only if your medicine\nis expensive,"
    } ]
  }, {
    "tStartMs": 776200,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "so if your prescriptions are cheap, this\nis not yours and you can stop worrying"
    } ]
  }, {
    "tStartMs": 781460,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "about it right now. For everybody else."
    } ]
  }, {
    "tStartMs": 784760,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "There is a point in the year where you\nhave paid so much for covered medicine"
    } ]
  }, {
    "tStartMs": 788540,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "that the plan takes over completely and\nyou pay nothing more for the rest of"
    } ]
  }, {
    "tStartMs": 794040,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "the year."
    } ]
  }, {
    "tStartMs": 795120,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "That point is the best thing in this whole\nsystem."
    } ]
  }, {
    "tStartMs": 797840,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "It is also moving further away."
    } ]
  }, {
    "tStartMs": 801160,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "This year that line sits at $2,100."
    } ]
  }, {
    "tStartMs": 804700,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Starting the first of January it sits at\n$2,400."
    } ]
  }, {
    "tStartMs": 808780,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "$300 further out. $300 more out of your\nown money before the protection switches"
    } ]
  }, {
    "tStartMs": 814280,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "on. And it resets on the first too."
    } ]
  }, {
    "tStartMs": 818020,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "So if you crossed that line in September\nand have been paying nothing since,"
    } ]
  }, {
    "tStartMs": 822760,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "the first of January puts you back at the\nbottom of the hill, and the hill"
    } ]
  }, {
    "tStartMs": 826920,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "is now taller."
    } ]
  }, {
    "tStartMs": 829000,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "There is one thing worth knowing here."
    } ]
  }, {
    "tStartMs": 831480,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "Only what you pay for the medicine itself\ncounts toward that line."
    } ]
  }, {
    "tStartMs": 836360,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "The monthly amount you pay for the plan\ndoes not count."
    } ]
  }, {
    "tStartMs": 839660,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "People add it up wrong every single year\nand think they are closer than they"
    } ]
  }, {
    "tStartMs": 843640,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "are. And watch what these two amounts do\ntogether, because this is the part"
    } ]
  }, {
    "tStartMs": 848120,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "that actually hurts."
    } ]
  }, {
    "tStartMs": 850320,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "The money you pay first went up."
    } ]
  }, {
    "tStartMs": 852900,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "The line where you finally stop paying\nmoved further out."
    } ]
  }, {
    "tStartMs": 857060,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Both ends moved against you in the same\nmonth."
    } ]
  }, {
    "tStartMs": 859660,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "The stretch in the middle where you are\npaying out of your own pocket got longer"
    } ]
  }, {
    "tStartMs": 863500,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "at the bottom and longer at the top."
    } ]
  }, {
    "tStartMs": 866440,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "If your medicine costs are anywhere near\nthis, there is help that pays a large"
    } ]
  }, {
    "tStartMs": 870740,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "part of it, and it is free to apply for."
    } ]
  }, {
    "tStartMs": 873760,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "I am putting the page in the description."
    } ]
  }, {
    "tStartMs": 876400,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Nobody should ever charge you to fill in\nthat form."
    } ]
  }, {
    "tStartMs": 879060,
    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "If a company calls you offering to get it\nfor you, hang up, because the same"
    } ]
  }, {
    "tStartMs": 883860,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "form is sitting there for nothing."
    } ]
  }, {
    "tStartMs": 886660,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "One more, and it only reaches you if you\nare still working."
    } ]
  }, {
    "tStartMs": 890960,
    "dDurationMs": 5420,
    "segs": [ {
      "utf8": "Social Security holds back $1 for every\ntwo you earn above a yearly line, and"
    } ]
  }, {
    "tStartMs": 896380,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "that line goes up in January. If you are\nunder full retirement age next year,"
    } ]
  }, {
    "tStartMs": 900880,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "the line is $25,560."
    } ]
  }, {
    "tStartMs": 904020,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "If you reach full retirement age during\nthe year, the line is much higher,"
    } ]
  }, {
    "tStartMs": 908880,
    "dDurationMs": 6200,
    "segs": [ {
      "utf8": "$67,920, and it only counts what you earn\nbefore the month you reach it."
    } ]
  }, {
    "tStartMs": 915660,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "If you are fully retired, this one is not\nyours."
    } ]
  }, {
    "tStartMs": 918920,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Add the five together and this is what\nJanuary actually looks like."
    } ]
  }, {
    "tStartMs": 923440,
    "dDurationMs": 5580,
    "segs": [ {
      "utf8": "3.6% sounds like a raise. By the time it\nreaches your hand, Part B has taken"
    } ]
  }, {
    "tStartMs": 929020,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "its piece before you saw it, your medicine\nhas restarted at a higher floor,"
    } ]
  }, {
    "tStartMs": 934000,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "your doctor costs have restarted from\nzero, and the point where the drug plan"
    } ]
  }, {
    "tStartMs": 938100,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "finally carries you has moved $300 further\naway."
    } ]
  }, {
    "tStartMs": 942580,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Two of those four numbers are not even\npublished yet, and they will be taken"
    } ]
  }, {
    "tStartMs": 946000,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "out of your January payment regardless."
    } ]
  }, {
    "tStartMs": 948460,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Four of those five, you cannot stop."
    } ]
  }, {
    "tStartMs": 951040,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "I am not going to dress that up for you."
    } ]
  }, {
    "tStartMs": 953180,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "The fifth one you can stop, and it is the\none that takes the most."
    } ]
  }, {
    "tStartMs": 957080,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "If a letter arrives saying you owe money\nback, you have about 90 days and three"
    } ]
  }, {
    "tStartMs": 961740,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "free requests. Make one of them."
    } ]
  }, {
    "tStartMs": 964180,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Do not let it sit. That is the whole list."
    } ]
  }, {
    "tStartMs": 966820,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "Tell me in the comments which of the five\nyou did not know about, and if you"
    } ]
  }, {
    "tStartMs": 971080,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "have ever had one of those letters, tell\nme what happened, because somebody"
    } ]
  }, {
    "tStartMs": 974660,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "reading is holding one right now and does\nnot know there is a form."
    } ]
  }, {
    "tStartMs": 978520,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "This is education, not advice about your\nown situation."
    } ]
  }, {
    "tStartMs": 982400,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "Your plan, your state and your own record\ndecide your figures."
    } ]
  } ]
}
