{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Social Security has already worked out\nyour new amount for next year."
    } ]
  }, {
    "tStartMs": 5300,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "It is sitting in a file with your name on\nit."
    } ]
  }, {
    "tStartMs": 8260,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "There is no rule anywhere that requires\nanybody to show it to you before the"
    } ]
  }, {
    "tStartMs": 12800,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "middle of December."
    } ]
  }, {
    "tStartMs": 14480,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "One date changes that, and it is the\neighteenth of November."
    } ]
  }, {
    "tStartMs": 18420,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "On one side of that date you read your own\nfigure in late November."
    } ]
  }, {
    "tStartMs": 22660,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "On the other side you wait for an\nenvelope, and by the time it reaches your"
    } ]
  }, {
    "tStartMs": 26980,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "table your January bills are already\ndecided."
    } ]
  }, {
    "tStartMs": 30720,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "Three weeks. The same money either way."
    } ]
  }, {
    "tStartMs": 33700,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "The difference is whether you spend the\nmost expensive six weeks of the year"
    } ]
  }, {
    "tStartMs": 37700,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "knowing your number or guessing at it."
    } ]
  }, {
    "tStartMs": 40820,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Before I start, one word in the comments."
    } ]
  }, {
    "tStartMs": 43760,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Does your yearly letter reach you on\npaper, or on a screen."
    } ]
  }, {
    "tStartMs": 47840,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Paper or screen, nothing else."
    } ]
  }, {
    "tStartMs": 50320,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "I will give you the date and what is\ndecided on it, the two settings that put"
    } ]
  }, {
    "tStartMs": 54600,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "you on one side or the other, what is\ninside that message besides the raise,"
    } ]
  }, {
    "tStartMs": 59300,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "and what those three weeks actually take\nfrom you."
    } ]
  }, {
    "tStartMs": 62720,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Everything here comes from the agency\nitself"
    } ]
  }, {
    "tStartMs": 64920,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "and the sources are in the description."
    } ]
  }, {
    "tStartMs": 67800,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "Number one. The eighteenth of November."
    } ]
  }, {
    "tStartMs": 70620,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "What is decided that day, and by whom."
    } ]
  }, {
    "tStartMs": 73540,
    "dDurationMs": 2885,
    "segs": [ {
      "utf8": "Nothing about your money changes on the\neighteenth."
    } ]
  }, {
    "tStartMs": 76465,
    "dDurationMs": 3515,
    "segs": [ {
      "utf8": "Your payment does not move. Your raise\ndoes not grow or shrink."
    } ]
  }, {
    "tStartMs": 80380,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "What changes is who gets to read it early."
    } ]
  }, {
    "tStartMs": 83160,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "The agency posts the figures for next year\ninto the message area of its own"
    } ]
  }, {
    "tStartMs": 87160,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "website in late November. If your account\nis set up and set to receive notices"
    } ]
  }, {
    "tStartMs": 92160,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "without paper, yours appears there."
    } ]
  }, {
    "tStartMs": 94640,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "If it is not, your copy is printed and\nposted, and printing and posting takes"
    } ]
  }, {
    "tStartMs": 100020,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "until December."
    } ]
  }, {
    "tStartMs": 101480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So the eighteenth is not a benefits\ndeadline."
    } ]
  }, {
    "tStartMs": 104040,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "It is a sorting date. It decides which\npile you are in."
    } ]
  }, {
    "tStartMs": 108160,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "And here is the part worth sitting with."
    } ]
  }, {
    "tStartMs": 110420,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "Nobody is going to write to you to warn\nyou about a date that only matters"
    } ]
  }, {
    "tStartMs": 114200,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "if you already know about it. There is no\nletter telling you to set up the"
    } ]
  }, {
    "tStartMs": 118420,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "thing that would have stopped the letter\nbeing necessary."
    } ]
  }, {
    "tStartMs": 120980,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "That is the whole shape of it."
    } ]
  }, {
    "tStartMs": 123200,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "I want to be straight about what this is\nand is not."
    } ]
  }, {
    "tStartMs": 126660,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Missing the eighteenth does not cost you a\ndollar directly."
    } ]
  }, {
    "tStartMs": 129820,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "You are not fined and you do not lose the\nraise."
    } ]
  }, {
    "tStartMs": 133060,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "Anybody telling you otherwise is selling\nsomething."
    } ]
  }, {
    "tStartMs": 136180,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "What it costs you is time, at the exact\npoint in the year when time is the"
    } ]
  }, {
    "tStartMs": 140640,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "thing you need, and I will show you why in\nthe last item."
    } ]
  }, {
    "tStartMs": 144680,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Number two. The account. Four minutes, and\nit has to be opened by you."
    } ]
  }, {
    "tStartMs": 149600,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The account is free. It is on the agency\nwebsite and nowhere else."
    } ]
  }, {
    "tStartMs": 153820,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It takes about as long as filling in a\nform at a doctor office."
    } ]
  }, {
    "tStartMs": 157380,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Now the part that stops people, and it is\nnot the form."
    } ]
  }, {
    "tStartMs": 160520,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "It is the identity check. The system asks\nyou questions pulled from your own"
    } ]
  }, {
    "tStartMs": 164960,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "financial history, old addresses, an old\nloan, a card you had years ago."
    } ]
  }, {
    "tStartMs": 169740,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "People get one wrong, get locked out, and\ndecide the whole thing is not for"
    } ]
  }, {
    "tStartMs": 174240,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "them. If that happens, you are not\nfinished."
    } ]
  }, {
    "tStartMs": 177280,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "You can complete the check in person\ninstead, at a local office or at many"
    } ]
  }, {
    "tStartMs": 181180,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "post office branches, and the person\nbehind"
    } ]
  }, {
    "tStartMs": 183520,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "the counter does it in a few minutes"
    } ]
  }, {
    "tStartMs": 185060,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "with your identity document."
    } ]
  }, {
    "tStartMs": 187380,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Two things to be hard about. Nobody else\nshould open this for you."
    } ]
  }, {
    "tStartMs": 191200,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "Not a helpful neighbor, not a man who\ncalled offering to set it up."
    } ]
  }, {
    "tStartMs": 194760,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "The account is the single place that shows\nyour payment details and the single"
    } ]
  }, {
    "tStartMs": 199240,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "place they can be changed, and an account\nsomebody else controls is worse than"
    } ]
  }, {
    "tStartMs": 203640,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "no account at all. And nobody charges for\nthis."
    } ]
  }, {
    "tStartMs": 207320,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "If a website asks for a card number to\ncreate it, you are on the wrong website."
    } ]
  }, {
    "tStartMs": 212240,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "There is one address and it is in the\ndescription."
    } ]
  }, {
    "tStartMs": 215540,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Number three. The setting almost everybody\nmisses after opening it."
    } ]
  }, {
    "tStartMs": 220140,
    "dDurationMs": 2780,
    "segs": [ {
      "utf8": "This is the one that catches people who\ndid everything right."
    } ]
  }, {
    "tStartMs": 222920,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Opening the account is not enough."
    } ]
  }, {
    "tStartMs": 225820,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "An account on its own still gets you a\nposted letter."
    } ]
  }, {
    "tStartMs": 228940,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "There is a separate choice inside it,\nunder the settings for how they contact"
    } ]
  }, {
    "tStartMs": 233020,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "you, where you say you want your notices\ndelivered without paper."
    } ]
  }, {
    "tStartMs": 237100,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "That is the switch. Until it is on, you\nare still in the December pile."
    } ]
  }, {
    "tStartMs": 241800,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "So somebody who opened an account two\nyears ago, who logs in now and then,"
    } ]
  }, {
    "tStartMs": 246520,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "who would tell you confidently that they\nare sorted, is very often not."
    } ]
  }, {
    "tStartMs": 250720,
    "dDurationMs": 1980,
    "segs": [ {
      "utf8": "They have the account and not the setting."
    } ]
  }, {
    "tStartMs": 253500,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Go and look. Open the account, find the\npart about communication preferences,"
    } ]
  }, {
    "tStartMs": 258060,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "and make sure notices without paper is\nturned on."
    } ]
  }, {
    "tStartMs": 261520,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "While you are there, add your cell number\nor your email so the system can tell"
    } ]
  }, {
    "tStartMs": 265580,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "you the moment something lands."
    } ]
  }, {
    "tStartMs": 267600,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "That alert is the difference between\nreading your figure on the day it appears"
    } ]
  }, {
    "tStartMs": 270900,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and finding it three weeks later when you\nhappen to log in."
    } ]
  }, {
    "tStartMs": 274640,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "One honest caution. Turning off paper\nmeans turning off paper."
    } ]
  }, {
    "tStartMs": 278700,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "If you are the kind of person who files\nletters in a drawer and finds them"
    } ]
  }, {
    "tStartMs": 282500,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "later, decide now where the screen version\ngets written down, because there"
    } ]
  }, {
    "tStartMs": 286980,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "will not be a second copy arriving."
    } ]
  }, {
    "tStartMs": 289080,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "Let me put a face on it. Picture a man I\nwill call Delroy, seventy one, who"
    } ]
  }, {
    "tStartMs": 294220,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "opened his account the year he retired\nbecause his daughter sat with him and"
    } ]
  }, {
    "tStartMs": 297340,
    "dDurationMs": 2020,
    "segs": [ {
      "utf8": "did it. He logs in twice a year."
    } ]
  }, {
    "tStartMs": 299840,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "He would tell you, with complete\nconfidence, that he is on the list."
    } ]
  }, {
    "tStartMs": 303280,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "He is not. Nobody ever showed him the\nsecond screen, and no letter has ever"
    } ]
  }, {
    "tStartMs": 308040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "mentioned it, because the letter is the\nthing he is still getting."
    } ]
  }, {
    "tStartMs": 311320,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Two years of waiting for post he did not\nhave to wait for, and not once did"
    } ]
  }, {
    "tStartMs": 315200,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "anything arrive to tell him so."
    } ]
  }, {
    "tStartMs": 317560,
    "dDurationMs": 3380,
    "segs": [ {
      "utf8": "Number four. What else is inside that\nmessage besides your raise."
    } ]
  }, {
    "tStartMs": 321680,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Everybody is quoting the raise."
    } ]
  }, {
    "tStartMs": 323760,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Three point six percent, and for a worker\non the average retirement payment"
    } ]
  }, {
    "tStartMs": 327600,
    "dDurationMs": 3522,
    "segs": [ {
      "utf8": "it moves the monthly amount from two\nthousand and ninety five dollars to two"
    } ]
  }, {
    "tStartMs": 331122,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "thousand one hundred and seventy."
    } ]
  }, {
    "tStartMs": 332420,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "That reaches about seventy six million\npeople counting both programs, and it"
    } ]
  }, {
    "tStartMs": 337860,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "begins with the January payment."
    } ]
  }, {
    "tStartMs": 340140,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "That part is settled. You do not apply for\nit and nobody can take it."
    } ]
  }, {
    "tStartMs": 345520,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "But the raise is not the only number in\nthat message, and the second one decides"
    } ]
  }, {
    "tStartMs": 349820,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "what actually lands in your account."
    } ]
  }, {
    "tStartMs": 352560,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Medicare takes its monthly charge out of\nyour payment before the deposit is"
    } ]
  }, {
    "tStartMs": 356580,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "made. This year that charge is two hundred\nand two dollars and ninety cents."
    } ]
  }, {
    "tStartMs": 362000,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "It never appears as a bill. It is simply\ngone before the money is yours."
    } ]
  }, {
    "tStartMs": 367020,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "The figure for next year has not been\npublished."
    } ]
  }, {
    "tStartMs": 369660,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Not by anybody."
    } ]
  }, {
    "tStartMs": 371320,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "The official projection sits around two\nhundred and nine dollars and fifty"
    } ]
  }, {
    "tStartMs": 374840,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "cents, and a projection is a forecast\nwritten down, not a decision made."
    } ]
  }, {
    "tStartMs": 380180,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "It is normally announced in the middle of\nNovember, which is to say in the"
    } ]
  }, {
    "tStartMs": 384160,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "days right around the date this whole\nvideo is about."
    } ]
  }, {
    "tStartMs": 386760,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "So understand what that message in late\nNovember actually contains."
    } ]
  }, {
    "tStartMs": 391440,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Not the average raise everybody is\nquoting."
    } ]
  }, {
    "tStartMs": 394480,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Your gross amount, and the Medicare figure\ncoming out of it, and the difference"
    } ]
  }, {
    "tStartMs": 398700,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "between them, which is the only number\nthat matters to your bank."
    } ]
  }, {
    "tStartMs": 402600,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "And when somebody tells you with\nconfidence what your January deposit will"
    } ]
  }, {
    "tStartMs": 406380,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "be, ask them where the second number came\nfrom."
    } ]
  }, {
    "tStartMs": 409360,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "If it was published, they can name the\nday."
    } ]
  }, {
    "tStartMs": 412320,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "If they cannot, they are reading a\nforecast out loud and calling it a fact."
    } ]
  }, {
    "tStartMs": 417060,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Number five. The three weeks. What they\nactually cost at this time of year."
    } ]
  }, {
    "tStartMs": 422160,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "Here is where I stop being gentle about\nit."
    } ]
  }, {
    "tStartMs": 424500,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Between late November and the middle of\nDecember you are deciding things that"
    } ]
  }, {
    "tStartMs": 428300,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "lock for a year, and here is what that\nlooks like on a kitchen table."
    } ]
  }, {
    "tStartMs": 432320,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "The Medicare plan choice closes on the\nseventh of December and after that you"
    } ]
  }, {
    "tStartMs": 436780,
    "dDurationMs": 1780,
    "segs": [ {
      "utf8": "live with it until the following January."
    } ]
  }, {
    "tStartMs": 439360,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Insurance renewals land. Heating runs at\nits highest."
    } ]
  }, {
    "tStartMs": 443040,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "People decide what they can give at\nChristmas."
    } ]
  }, {
    "tStartMs": 445520,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Every one of those decisions is better\nwith your real figure in front of you"
    } ]
  }, {
    "tStartMs": 449160,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "and worse with the average figure off the\nnews."
    } ]
  }, {
    "tStartMs": 452020,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "The average is not your number."
    } ]
  }, {
    "tStartMs": 454020,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "Your work history is not the average work\nhistory, your Medicare charge may"
    } ]
  }, {
    "tStartMs": 458100,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "not be the standard charge, and the gap\nbetween what you expect and what arrives"
    } ]
  }, {
    "tStartMs": 462340,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "is exactly the gap people spend January\ntrying to understand."
    } ]
  }, {
    "tStartMs": 466620,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "There is a second cost, and it is the one\nnobody mentions."
    } ]
  }, {
    "tStartMs": 470700,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "If the figure is wrong, and figures are\nsometimes wrong, the clock on sorting"
    } ]
  }, {
    "tStartMs": 474780,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "it out starts when you see it."
    } ]
  }, {
    "tStartMs": 477100,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "See it in late November and you have the\nwhole of December to query it before"
    } ]
  }, {
    "tStartMs": 481020,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "the first payment of the year."
    } ]
  }, {
    "tStartMs": 483260,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "See it in late December and you are making\nthat call in January, after the"
    } ]
  }, {
    "tStartMs": 487320,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "money has already landed short, and the\npeople answering the phone are at their"
    } ]
  }, {
    "tStartMs": 490940,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "busiest of the year. Picture a widow I\nwill call Esther,"
    } ]
  }, {
    "tStartMs": 494660,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "seventy eight, living on one payment."
    } ]
  }, {
    "tStartMs": 497200,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "In early December she is looking at a plan\nrenewal, a heating bill that has"
    } ]
  }, {
    "tStartMs": 501300,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "already turned, and a figure she heard on\nthe news."
    } ]
  }, {
    "tStartMs": 504400,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "She picks the cheaper plan because the\nnews figure told her she had room."
    } ]
  }, {
    "tStartMs": 508280,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "Her own number arrives on the twentieth of\nDecember and it is lower than the"
    } ]
  }, {
    "tStartMs": 511960,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "news figure, because her Medicare charge\nis not the standard one."
    } ]
  }, {
    "tStartMs": 515500,
    "dDurationMs": 2487,
    "segs": [ {
      "utf8": "The plan window shut on the seventh."
    } ]
  }, {
    "tStartMs": 518027,
    "dDurationMs": 1773,
    "segs": [ {
      "utf8": "She carries that choice for twelve months."
    } ]
  }, {
    "tStartMs": 519800,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Nothing was hidden from Esther."
    } ]
  }, {
    "tStartMs": 522300,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "The figure existed in November."
    } ]
  }, {
    "tStartMs": 524180,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "She was simply in the pile that reads it\nlast."
    } ]
  }, {
    "tStartMs": 527080,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "One last thing, because it happens every\nsingle year at exactly this point."
    } ]
  }, {
    "tStartMs": 531840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "When the figures are announced, the calls\nstart."
    } ]
  }, {
    "tStartMs": 534720,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "Somebody rings, says they are from the\nagency, says your raise needs confirming"
    } ]
  }, {
    "tStartMs": 538600,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "or your account needs verifying, and asks\nfor your number or your bank details."
    } ]
  }, {
    "tStartMs": 543100,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "The raise is automatic. It needs nothing\nfrom you."
    } ]
  }, {
    "tStartMs": 546240,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "The agency does not call people to hand\nthem money."
    } ]
  }, {
    "tStartMs": 548660,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "Put the phone down, and if you want to\ncheck anything, you call them on the"
    } ]
  }, {
    "tStartMs": 552760,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "number in the description rather than the\nnumber that called you."
    } ]
  }, {
    "tStartMs": 555940,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "So here is all of it in one breath."
    } ]
  }, {
    "tStartMs": 557980,
    "dDurationMs": 3540,
    "segs": [ {
      "utf8": "The eighteenth of November does not change\nyour money, it changes when you"
    } ]
  }, {
    "tStartMs": 561520,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "are allowed to see it. Open the account\nyourself, on the agency website, and"
    } ]
  }, {
    "tStartMs": 566100,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "open it nobody else. Then turn on notices\nwithout paper, because the account"
    } ]
  }, {
    "tStartMs": 570460,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "alone leaves you in the December pile."
    } ]
  }, {
    "tStartMs": 572760,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "What arrives is two numbers, not one, and\nthe second has not been published"
    } ]
  }, {
    "tStartMs": 576900,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "yet. And the three weeks you save are the\nthree weeks you spend deciding a"
    } ]
  }, {
    "tStartMs": 580940,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "plan, a renewal and a Christmas on either\na real figure or a borrowed one."
    } ]
  }, {
    "tStartMs": 586180,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "If you have already done all of this, say\nso in the comments, because somebody"
    } ]
  }, {
    "tStartMs": 589840,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "reading them has not and will believe you\nbefore they believe me."
    } ]
  }, {
    "tStartMs": 593620,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "None of this is advice about your own\nrecord."
    } ]
  }, {
    "tStartMs": 596000,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Your own work history and your own state\ndecide what you see."
    } ]
  } ]
}
