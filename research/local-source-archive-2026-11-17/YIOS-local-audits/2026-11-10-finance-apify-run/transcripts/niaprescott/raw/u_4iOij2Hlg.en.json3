{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Four letters will reach your house between\nnow and November."
    } ]
  }, {
    "tStartMs": 4940,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "The colors are different, and the color is\nthe message."
    } ]
  }, {
    "tStartMs": 8920,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Nobody has told you that. Next year is\nalready decided."
    } ]
  }, {
    "tStartMs": 13520,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "It was printed before anybody asked you."
    } ]
  }, {
    "tStartMs": 16840,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "The amount you hand over from your own\npocket before your medicines stop costing"
    } ]
  }, {
    "tStartMs": 21240,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "you anything went up three hundred\ndollars."
    } ]
  }, {
    "tStartMs": 24720,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "The most a drug plan is allowed to take\nfrom you before it pays a single cent"
    } ]
  }, {
    "tStartMs": 28960,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "went up eighty five dollars."
    } ]
  }, {
    "tStartMs": 31820,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "Those are not guesses. They are set, and\nthey begin on the first of January."
    } ]
  }, {
    "tStartMs": 37580,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "One of those four letters comes from a job\nyou left years ago."
    } ]
  }, {
    "tStartMs": 41420,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "It has to be in your hands before the\nfifteenth of October, and it answers"
    } ]
  }, {
    "tStartMs": 46040,
    "dDurationMs": 5010,
    "segs": [ {
      "utf8": "one question. If the answer is the wrong\none, and you stay quiet for sixty"
    } ]
  }, {
    "tStartMs": 51050,
    "dDurationMs": 3430,
    "segs": [ {
      "utf8": "three days, a charge is fixed onto your\nmonthly price."
    } ]
  }, {
    "tStartMs": 55420,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "It stays there for as long as you hold\ndrug cover under Medicare."
    } ]
  }, {
    "tStartMs": 59400,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Not for a year. Not until you move to\nanother plan."
    } ]
  }, {
    "tStartMs": 63020,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "For as long as you hold it."
    } ]
  }, {
    "tStartMs": 65260,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "And the figure that charge is built from\nhas just gone up."
    } ]
  }, {
    "tStartMs": 69000,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "So every person already paying it will pay\nmore in January, with no letter,"
    } ]
  }, {
    "tStartMs": 74100,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "no warning, and nobody required to mention\nit."
    } ]
  }, {
    "tStartMs": 77340,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Five things. The one that never ends is\nlast."
    } ]
  }, {
    "tStartMs": 80860,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "Who this reaches, because that question\nsits under every one of these videos."
    } ]
  }, {
    "tStartMs": 85580,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "If you are on Medicare, all five apply to\nyou."
    } ]
  }, {
    "tStartMs": 89180,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "Not one of them has an income test."
    } ]
  }, {
    "tStartMs": 91640,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "Nothing here depends on what you have or\nwhat you earn."
    } ]
  }, {
    "tStartMs": 95160,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "Three names, and then no more."
    } ]
  }, {
    "tStartMs": 97500,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "Medicare. The drug side of it is Part D."
    } ]
  }, {
    "tStartMs": 100700,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The help some people get with drug costs\nis Extra Help."
    } ]
  }, {
    "tStartMs": 104500,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "Nothing else in this video has a name you\nneed to learn."
    } ]
  }, {
    "tStartMs": 107580,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Number one. What comes out of your own\npocket before the year goes quiet went"
    } ]
  }, {
    "tStartMs": 112220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "up three hundred dollars."
    } ]
  }, {
    "tStartMs": 114140,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "There is a point each year where your own\nmoney stops going out and the cover"
    } ]
  }, {
    "tStartMs": 118640,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "takes over. Reach it, and your medicines\ncost you nothing for the rest of the"
    } ]
  }, {
    "tStartMs": 123540,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "year. This year that point is two thousand\none hundred dollars."
    } ]
  }, {
    "tStartMs": 128100,
    "dDurationMs": 2291,
    "segs": [ {
      "utf8": "Next year it is two thousand four hundred."
    } ]
  }, {
    "tStartMs": 131000,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "Three hundred dollars further away."
    } ]
  }, {
    "tStartMs": 132920,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Out of your pocket, not theirs."
    } ]
  }, {
    "tStartMs": 135120,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "That is the number being announced right\nnow as a cap, and the word is doing"
    } ]
  }, {
    "tStartMs": 139300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "a lot of work."
    } ]
  }, {
    "tStartMs": 140900,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "A cap sounds like protection."
    } ]
  }, {
    "tStartMs": 143080,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "It is the distance you have to cross\nbefore protection starts, and the distance"
    } ]
  }, {
    "tStartMs": 147600,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "was made longer. Understand who it lands\non."
    } ]
  }, {
    "tStartMs": 150760,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "If you take one cheap pill a month, you\nwill never reach that line and this"
    } ]
  }, {
    "tStartMs": 154540,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "changes nothing for you. If you take four\nor five, or one of the expensive"
    } ]
  }, {
    "tStartMs": 159160,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "ones, you crossed that line in the spring\nthis year."
    } ]
  }, {
    "tStartMs": 163460,
    "dDurationMs": 5640,
    "segs": [ {
      "utf8": "Next year you cross it later, and every\nweek of delay is paid at full price"
    } ]
  }, {
    "tStartMs": 169100,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "at the counter. Work out roughly what you\nspent on medicines by June."
    } ]
  }, {
    "tStartMs": 173780,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "If you were already past two thousand,\nthis change takes three hundred dollars"
    } ]
  }, {
    "tStartMs": 178120,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "from you and there is nothing to sign and\nnothing to appeal."
    } ]
  }, {
    "tStartMs": 183040,
    "dDurationMs": 5202,
    "segs": [ {
      "utf8": "Number two. The most a plan can take\nbefore it pays anything went up eighty"
    } ]
  }, {
    "tStartMs": 188242,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "five dollars."
    } ]
  }, {
    "tStartMs": 189620,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "Before a drug plan pays a cent, there is a\nstretch where you pay everything."
    } ]
  }, {
    "tStartMs": 195220,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "The law puts a ceiling on how long that\nstretch can be."
    } ]
  }, {
    "tStartMs": 199420,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "This year that ceiling is six hundred and\nfifteen dollars."
    } ]
  }, {
    "tStartMs": 202900,
    "dDurationMs": 2047,
    "segs": [ {
      "utf8": "Next year it is seven hundred."
    } ]
  }, {
    "tStartMs": 205780,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "That is the ceiling, not your number."
    } ]
  }, {
    "tStartMs": 208980,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "Your plan can sit under it. What matters\nis that the room to move went up,"
    } ]
  }, {
    "tStartMs": 213980,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "and plans tend to use the room they are\ngiven."
    } ]
  }, {
    "tStartMs": 216860,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Here is what makes this one bite."
    } ]
  }, {
    "tStartMs": 220280,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "It falls in January. Every year the first\nweeks are when people find out what"
    } ]
  }, {
    "tStartMs": 225420,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "changed, at the counter, in front of other\npeople, being asked for a sum they"
    } ]
  }, {
    "tStartMs": 230600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "were not expecting."
    } ]
  }, {
    "tStartMs": 232500,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "The bill is at its heaviest in exactly the\nmonth when the heating is at its"
    } ]
  }, {
    "tStartMs": 237380,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "heaviest."
    } ]
  }, {
    "tStartMs": 238860,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "Your own number is printed in the letter\nyour plan sent you."
    } ]
  }, {
    "tStartMs": 242460,
    "dDurationMs": 5660,
    "segs": [ {
      "utf8": "Not the ceiling. Yours. Find the page that\nsays what you pay before the plan"
    } ]
  }, {
    "tStartMs": 248120,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "starts paying, and read it before the\nfifteenth of October, because after that"
    } ]
  }, {
    "tStartMs": 253460,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "you are choosing under time pressure."
    } ]
  }, {
    "tStartMs": 256320,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "Number three. Three letters, three colors,\nthree different messages, and people"
    } ]
  }, {
    "tStartMs": 261360,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "read the first line of each and stop."
    } ]
  }, {
    "tStartMs": 264760,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "The government sends these. They are\ncolored on purpose, and the color tells"
    } ]
  }, {
    "tStartMs": 268940,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "you which one you are holding."
    } ]
  }, {
    "tStartMs": 270540,
    "dDurationMs": 5720,
    "segs": [ {
      "utf8": "The orange one says you still qualify for\nhelp with drug costs automatically."
    } ]
  }, {
    "tStartMs": 277000,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "People read that and feel relief and put\nit down."
    } ]
  }, {
    "tStartMs": 280260,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "The relief is where they stop."
    } ]
  }, {
    "tStartMs": 282600,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "The second half of that letter says the\namounts you hand over at the counter"
    } ]
  }, {
    "tStartMs": 286680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "change on the first of January."
    } ]
  }, {
    "tStartMs": 289820,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Same help, different price, and the price\nis in the part nobody finishes."
    } ]
  }, {
    "tStartMs": 295340,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The grey one says the opposite."
    } ]
  }, {
    "tStartMs": 297360,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "From the first of January you no longer\nqualify automatically."
    } ]
  }, {
    "tStartMs": 301860,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "You are allowed to apply again."
    } ]
  }, {
    "tStartMs": 304280,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "Nobody applies for you, nobody telephones\nto ask why you have not, and if you"
    } ]
  }, {
    "tStartMs": 309540,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "do nothing the help simply stops and the\nfull price starts."
    } ]
  }, {
    "tStartMs": 314140,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "The blue one arrives in November and it is\nthe one people misread worst."
    } ]
  }, {
    "tStartMs": 319020,
    "dDurationMs": 5460,
    "segs": [ {
      "utf8": "It does not ask you anything. It tells you\nyour drug plan is leaving Medicare"
    } ]
  }, {
    "tStartMs": 324480,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and that you have already been moved to a\ndifferent one."
    } ]
  }, {
    "tStartMs": 327920,
    "dDurationMs": 6040,
    "segs": [ {
      "utf8": "Not a suggestion. Done. A plan you did not\nchoose, with its own list of medicines"
    } ]
  }, {
    "tStartMs": 333960,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "and its own prices, unless you pick for\nyourself before the end of December."
    } ]
  }, {
    "tStartMs": 339280,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "Hold that for a second. A letter arrives,\nyou do not open it, and in January"
    } ]
  }, {
    "tStartMs": 344140,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "you are inside a plan you never agreed to."
    } ]
  }, {
    "tStartMs": 346640,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "That is allowed, it is the system working\nas designed, and the only thing standing"
    } ]
  }, {
    "tStartMs": 352020,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "between you and it is whether you opened\nan envelope in November."
    } ]
  }, {
    "tStartMs": 356720,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Look at the color before you look at\nanything else."
    } ]
  }, {
    "tStartMs": 359760,
    "dDurationMs": 4840,
    "segs": [ {
      "utf8": "Orange, read to the end. Grey, you have\nlost something and you have to ask"
    } ]
  }, {
    "tStartMs": 364600,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "for it back. Blue, a decision has already\nbeen made for you."
    } ]
  }, {
    "tStartMs": 368900,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Number four. The letter from the job you\nleft, and the one question it answers."
    } ]
  }, {
    "tStartMs": 373720,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "Somewhere there is an old employer or an\nold union still sending you one piece"
    } ]
  }, {
    "tStartMs": 378900,
    "dDurationMs": 4280,
    "segs": [ {
      "utf8": "of paper a year. It has to reach you\nbefore the fifteenth of October."
    } ]
  }, {
    "tStartMs": 383680,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It is required."
    } ]
  }, {
    "tStartMs": 385240,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "It looks like nothing. It reads like the\npension paperwork you have been filing"
    } ]
  }, {
    "tStartMs": 389440,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "without reading for a decade."
    } ]
  }, {
    "tStartMs": 391680,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "It answers one question. Does the drug\ncover you already have count as good"
    } ]
  }, {
    "tStartMs": 397040,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "enough? That is the whole letter."
    } ]
  }, {
    "tStartMs": 399300,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "One word, buried in a page of language\nbuilt by people who were not thinking"
    } ]
  }, {
    "tStartMs": 404320,
    "dDurationMs": 5020,
    "segs": [ {
      "utf8": "about your eyesight. If it counts, you are\nfine, and you can keep what you"
    } ]
  }, {
    "tStartMs": 409340,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "have and ignore the rest of this."
    } ]
  }, {
    "tStartMs": 411320,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "If it does not count, you are standing\nnext to the most expensive mistake in"
    } ]
  }, {
    "tStartMs": 416320,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "this video. And you do not know it."
    } ]
  }, {
    "tStartMs": 419140,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "Nothing on the envelope says so, and\nnobody is going to telephone and explain."
    } ]
  }, {
    "tStartMs": 423620,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "Find that letter. Find the sentence that\nsays whether your drug cover counts."
    } ]
  }, {
    "tStartMs": 428880,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "If the letter is gone, telephone the\nnumber on your old plan card and put the"
    } ]
  }, {
    "tStartMs": 434140,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "question in those exact words."
    } ]
  }, {
    "tStartMs": 436680,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Somebody on that line knows, and the\nanswer takes them ten seconds."
    } ]
  }, {
    "tStartMs": 441160,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "Number five. The charge that is never\ntaken off, and it has just been made"
    } ]
  }, {
    "tStartMs": 445600,
    "dDurationMs": 5380,
    "segs": [ {
      "utf8": "bigger. Here is the one. If you go sixty\nthree days in a row with no drug cover"
    } ]
  }, {
    "tStartMs": 450980,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "that counts, a charge is added to what you\npay every month."
    } ]
  }, {
    "tStartMs": 454880,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "Not a fine you settle once. Not a bill you\nargue about."
    } ]
  }, {
    "tStartMs": 458580,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "It is built into your monthly price from\nthen on, and it stays there for as"
    } ]
  }, {
    "tStartMs": 463620,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "long as you hold drug cover under\nMedicare."
    } ]
  }, {
    "tStartMs": 465580,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "You can change plans every single year and\nit follows you to each one."
    } ]
  }, {
    "tStartMs": 470560,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "This is how it is worked out. One percent\nof a national figure, for every full"
    } ]
  }, {
    "tStartMs": 475420,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "month you were without cover, added on\ntop."
    } ]
  }, {
    "tStartMs": 478160,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "Two years without, and it is a quarter\nmore every month, forever."
    } ]
  }, {
    "tStartMs": 482820,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "Now the part that has not been reported\nanywhere, and it is why this item sits"
    } ]
  }, {
    "tStartMs": 487460,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "at the end. That national figure is not\nfixed."
    } ]
  }, {
    "tStartMs": 491020,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "It is reset every year. This year it is\nthirty eight dollars and ninety nine"
    } ]
  }, {
    "tStartMs": 496340,
    "dDurationMs": 4440,
    "segs": [ {
      "utf8": "cents. Next year it is forty one dollars\nand thirty three cents."
    } ]
  }, {
    "tStartMs": 500820,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "So the charge is calculated from a bigger\nnumber in January."
    } ]
  }, {
    "tStartMs": 504540,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Which means every person already paying it\npays more next year."
    } ]
  }, {
    "tStartMs": 508840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "They did nothing. They made no choice."
    } ]
  }, {
    "tStartMs": 511580,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "No letter is going out to tell them."
    } ]
  }, {
    "tStartMs": 513660,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "The amount simply grows, quietly, on a\nline they have stopped reading, and"
    } ]
  }, {
    "tStartMs": 518600,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "it will grow again the year after"
    } ]
  }, {
    "tStartMs": 521020,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "that. That is the difference between this\nand everything else here."
    } ]
  }, {
    "tStartMs": 524680,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "The other four cost you a year."
    } ]
  }, {
    "tStartMs": 526760,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "This one gets larger while you are not\nlooking, and it does not end."
    } ]
  }, {
    "tStartMs": 530820,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "Here is the line joining all five."
    } ]
  }, {
    "tStartMs": 532880,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "Every one of them reaches you on paper, in\nOctober or November, dressed as"
    } ]
  }, {
    "tStartMs": 537780,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "junk. Nothing follows up. No second copy\ncomes in December."
    } ]
  }, {
    "tStartMs": 542620,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "No voice checks that the envelope was ever\nopened."
    } ]
  }, {
    "tStartMs": 545360,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "One delivery is the entire warning, and\nthat is all anybody is obliged to give"
    } ]
  }, {
    "tStartMs": 550680,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "you. Now the edge of what I can do for\nyou."
    } ]
  }, {
    "tStartMs": 553380,
    "dDurationMs": 3520,
    "segs": [ {
      "utf8": "Your own figures are not in this video and\nI will not pretend otherwise."
    } ]
  }, {
    "tStartMs": 557580,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "Your plan, your state and your own history\ndecide what is printed on your page."
    } ]
  }, {
    "tStartMs": 563600,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "The amounts here are the national ones for\nnext year, and those are settled."
    } ]
  }, {
    "tStartMs": 568120,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "What your plan does underneath them sits\nin your envelope and nowhere else"
    } ]
  }, {
    "tStartMs": 573180,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "on earth. Five things, said quickly."
    } ]
  }, {
    "tStartMs": 576360,
    "dDurationMs": 4383,
    "segs": [ {
      "utf8": "What you pay from your own pocket before\nthe year goes quiet moved from two"
    } ]
  }, {
    "tStartMs": 580743,
    "dDurationMs": 2957,
    "segs": [ {
      "utf8": "thousand one hundred to two thousand four\nhundred."
    } ]
  }, {
    "tStartMs": 584700,
    "dDurationMs": 4506,
    "segs": [ {
      "utf8": "The most a plan may take before it pays\nanything moved from six hundred and"
    } ]
  }, {
    "tStartMs": 589206,
    "dDurationMs": 1874,
    "segs": [ {
      "utf8": "fifteen to seven hundred."
    } ]
  }, {
    "tStartMs": 591880,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "Three letters arrive in three colors and\nonly one of them is good news, and"
    } ]
  }, {
    "tStartMs": 596920,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "even that one has a price change in the\nsecond half."
    } ]
  }, {
    "tStartMs": 599660,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "A letter from an old job, due before the\nfifteenth of October, answers whether"
    } ]
  }, {
    "tStartMs": 604980,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "your drug cover counts. And sixty three\ndays without cover that counts fixes"
    } ]
  }, {
    "tStartMs": 610480,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "a charge onto your monthly price for as\nlong as you live on Medicare, calculated"
    } ]
  }, {
    "tStartMs": 615680,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "from a figure that just went up."
    } ]
  }, {
    "tStartMs": 618720,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Nothing here was kept from you."
    } ]
  }, {
    "tStartMs": 620680,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "All of it is printed, all of it is free,\nand all of it was settled months before"
    } ]
  }, {
    "tStartMs": 625380,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "your envelope was sealed. It beats older\npeople anyway, for one reason only."
    } ]
  }, {
    "tStartMs": 630580,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "It comes as paper, once, in the same\nhandful of post as the advertisements,"
    } ]
  }, {
    "tStartMs": 636480,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "and not one person in the whole"
    } ]
  }, {
    "tStartMs": 638640,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "arrangement is paid to find out whether\nyou"
    } ]
  }, {
    "tStartMs": 641240,
    "dDurationMs": 4940,
    "segs": [ {
      "utf8": "understood a word of it. One more thing,\nbecause these calls run through every"
    } ]
  }, {
    "tStartMs": 646180,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "October. No official body telephones you\nabout open enrollment."
    } ]
  }, {
    "tStartMs": 651180,
    "dDurationMs": 4860,
    "segs": [ {
      "utf8": "If a voice offers to sort your plan out\nthere and then, or wants your Medicare"
    } ]
  }, {
    "tStartMs": 656040,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "number before anything can move, you are\ntalking to somebody reading off a"
    } ]
  }, {
    "tStartMs": 660940,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "bought list. Hang up on them."
    } ]
  }, {
    "tStartMs": 663940,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "Send this to one person over sixty five\nwho still has post sitting unopened."
    } ]
  }, {
    "tStartMs": 669840,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "Do not ask whether they have read their\nletters, because they will say yes."
    } ]
  }, {
    "tStartMs": 674160,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "Ask something narrower."
    } ]
  }, {
    "tStartMs": 676180,
    "dDurationMs": 5080,
    "segs": [ {
      "utf8": "Ask whether anything came this month that\nwas orange, grey or blue, and whether"
    } ]
  }, {
    "tStartMs": 681260,
    "dDurationMs": 1091,
    "segs": [ {
      "utf8": "it is still sealed."
    } ]
  } ]
}
