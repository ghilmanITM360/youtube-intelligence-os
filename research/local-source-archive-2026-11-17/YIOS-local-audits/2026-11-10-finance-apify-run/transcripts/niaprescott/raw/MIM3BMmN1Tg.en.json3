{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3582,
    "segs": [ {
      "utf8": "You know the feeling, even if you have\nnever put words to it."
    } ]
  }, {
    "tStartMs": 4162,
    "dDurationMs": 3742,
    "segs": [ {
      "utf8": "You look at what is left in your account,\nand it is less than it should be,"
    } ]
  }, {
    "tStartMs": 8365,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "and you cannot quite say where it went."
    } ]
  }, {
    "tStartMs": 11026,
    "dDurationMs": 3242,
    "segs": [ {
      "utf8": "You were careful. You did not spend\nfoolishly."
    } ]
  }, {
    "tStartMs": 14808,
    "dDurationMs": 4223,
    "segs": [ {
      "utf8": "You watched the big ones, the groceries,\nthe medicine, the light bill."
    } ]
  }, {
    "tStartMs": 19071,
    "dDurationMs": 4962,
    "segs": [ {
      "utf8": "And still, somehow, there is less at the\nend of the month than there ought"
    } ]
  }, {
    "tStartMs": 24033,
    "dDurationMs": 4983,
    "segs": [ {
      "utf8": "to be. That feeling is not you losing\ntrack, and it is not in your head."
    } ]
  }, {
    "tStartMs": 29576,
    "dDurationMs": 5103,
    "segs": [ {
      "utf8": "For a great many older people, a real part\nof that missing money is being pulled"
    } ]
  }, {
    "tStartMs": 34679,
    "dDurationMs": 4923,
    "segs": [ {
      "utf8": "quietly out of their account every single\nmonth, for things that stopped existing"
    } ]
  }, {
    "tStartMs": 39602,
    "dDurationMs": 4563,
    "segs": [ {
      "utf8": "years ago. A service you cancelled and\nthought was long finished."
    } ]
  }, {
    "tStartMs": 44565,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "A warranty on something you no longer even\nown."
    } ]
  }, {
    "tStartMs": 47967,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "A tax you may no longer owe at all."
    } ]
  }, {
    "tStartMs": 50688,
    "dDurationMs": 3542,
    "segs": [ {
      "utf8": "Each one is small enough that you have\ntrained yourself to skip right past"
    } ]
  }, {
    "tStartMs": 54230,
    "dDurationMs": 941,
    "segs": [ {
      "utf8": "it on the statement."
    } ]
  }, {
    "tStartMs": 55951,
    "dDurationMs": 4983,
    "segs": [ {
      "utf8": "But added up, over a year, they can\nquietly take more than a thousand dollars"
    } ]
  }, {
    "tStartMs": 60934,
    "dDurationMs": 4823,
    "segs": [ {
      "utf8": "that was yours to keep, and they will do\nit again next year, and the year after"
    } ]
  }, {
    "tStartMs": 65757,
    "dDurationMs": 5343,
    "segs": [ {
      "utf8": "that, unless you catch them. And here is\nthe part that should truly frighten"
    } ]
  }, {
    "tStartMs": 71100,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "you. These charges do not ever stop on\ntheir own."
    } ]
  }, {
    "tStartMs": 74541,
    "dDurationMs": 1922,
    "segs": [ {
      "utf8": "No letter comes in the mail to warn you."
    } ]
  }, {
    "tStartMs": 76763,
    "dDurationMs": 4082,
    "segs": [ {
      "utf8": "No one calls. Nothing on your statement\nlights up to say, you do not have to"
    } ]
  }, {
    "tStartMs": 80845,
    "dDurationMs": 5043,
    "segs": [ {
      "utf8": "pay this anymore. The money simply keeps\nleaving your account, quietly, month"
    } ]
  }, {
    "tStartMs": 85888,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "after month, and every single month you do\nnot catch it is another month of"
    } ]
  }, {
    "tStartMs": 89850,
    "dDurationMs": 3782,
    "segs": [ {
      "utf8": "the money you worked your whole life for\nstaying in the hands of a company"
    } ]
  }, {
    "tStartMs": 93632,
    "dDurationMs": 1661,
    "segs": [ {
      "utf8": "instead of staying with you."
    } ]
  }, {
    "tStartMs": 96033,
    "dDurationMs": 2282,
    "segs": [ {
      "utf8": "And left alone, it does not fade away."
    } ]
  }, {
    "tStartMs": 98715,
    "dDurationMs": 5183,
    "segs": [ {
      "utf8": "It keeps draining, silently, for the rest\nof your life, until one single person"
    } ]
  }, {
    "tStartMs": 103898,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "finally reaches in and shuts it off."
    } ]
  }, {
    "tStartMs": 107120,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "That person is never going to be them."
    } ]
  }, {
    "tStartMs": 109781,
    "dDurationMs": 5463,
    "segs": [ {
      "utf8": "It can only ever be you. There is good\nnews, though, and it is the reason this"
    } ]
  }, {
    "tStartMs": 115244,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "is the year to finally catch it."
    } ]
  }, {
    "tStartMs": 117705,
    "dDurationMs": 6084,
    "segs": [ {
      "utf8": "In twenty twenty six, this exact problem\nhas grown so widespread that the people"
    } ]
  }, {
    "tStartMs": 123789,
    "dDurationMs": 5643,
    "segs": [ {
      "utf8": "whose job it is to protect consumers are\ncracking down hard, forcing these"
    } ]
  }, {
    "tStartMs": 129432,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "companies to make their charges far easier\nto escape."
    } ]
  }, {
    "tStartMs": 133254,
    "dDurationMs": 4363,
    "segs": [ {
      "utf8": "So there has never been a better moment\nthan this year to hunt yours down and"
    } ]
  }, {
    "tStartMs": 137617,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "shut them off for good."
    } ]
  }, {
    "tStartMs": 139578,
    "dDurationMs": 5022,
    "segs": [ {
      "utf8": "Stay with me all the way to the end,\nbecause the fifth one is not a company"
    } ]
  }, {
    "tStartMs": 144600,
    "dDurationMs": 4783,
    "segs": [ {
      "utf8": "at all. It is money pulled straight out of\nyour Social Security check every"
    } ]
  }, {
    "tStartMs": 149383,
    "dDurationMs": 5143,
    "segs": [ {
      "utf8": "single month, for a reason that may have\nquietly stopped being true years ago."
    } ]
  }, {
    "tStartMs": 155126,
    "dDurationMs": 4703,
    "segs": [ {
      "utf8": "The first one hides inside your own bank\nor credit card statement, and it is"
    } ]
  }, {
    "tStartMs": 159829,
    "dDurationMs": 3662,
    "segs": [ {
      "utf8": "that small monthly charge you no longer\nremember agreeing to."
    } ]
  }, {
    "tStartMs": 163991,
    "dDurationMs": 5563,
    "segs": [ {
      "utf8": "A subscription. Maybe it was a free trial\nyou signed up for once, years ago,"
    } ]
  }, {
    "tStartMs": 169554,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "and never got around to canceling."
    } ]
  }, {
    "tStartMs": 172116,
    "dDurationMs": 4923,
    "segs": [ {
      "utf8": "Maybe it is antivirus software on a\ncomputer you barely turn on anymore, quietly"
    } ]
  }, {
    "tStartMs": 177039,
    "dDurationMs": 3361,
    "segs": [ {
      "utf8": "renewing itself every year at a hundred\ndollars or more."
    } ]
  }, {
    "tStartMs": 181061,
    "dDurationMs": 4822,
    "segs": [ {
      "utf8": "Maybe it is a streaming service, a news\nsite, a club, or an app you have not"
    } ]
  }, {
    "tStartMs": 185883,
    "dDurationMs": 861,
    "segs": [ {
      "utf8": "opened in a year."
    } ]
  }, {
    "tStartMs": 187504,
    "dDurationMs": 3852,
    "segs": [ {
      "utf8": "On their own, each one looks far too small\nto bother with."
    } ]
  }, {
    "tStartMs": 191537,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "Nine dollars here. Twelve dollars there."
    } ]
  }, {
    "tStartMs": 194318,
    "dDurationMs": 5203,
    "segs": [ {
      "utf8": "But added together, for the average\nhousehold, they come to well over a hundred"
    } ]
  }, {
    "tStartMs": 199521,
    "dDurationMs": 4963,
    "segs": [ {
      "utf8": "and fifty dollars a year, poured straight\ndown the drain for things nobody"
    } ]
  }, {
    "tStartMs": 204484,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "is even using."
    } ]
  }, {
    "tStartMs": 206225,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "And the companies design it that way on\npurpose."
    } ]
  }, {
    "tStartMs": 209827,
    "dDurationMs": 5363,
    "segs": [ {
      "utf8": "It is called set it and forget it, and\nthey are betting everything on the forget."
    } ]
  }, {
    "tStartMs": 215990,
    "dDurationMs": 4623,
    "segs": [ {
      "utf8": "The way to stop it is simple, but you are\nthe one who has to do it."
    } ]
  }, {
    "tStartMs": 220853,
    "dDurationMs": 4302,
    "segs": [ {
      "utf8": "Sit down with a single month of your bank\nstatement and read every charge on"
    } ]
  }, {
    "tStartMs": 225155,
    "dDurationMs": 6524,
    "segs": [ {
      "utf8": "it, line by line. Any charge you do not\nrecognize, or do not use anymore, call"
    } ]
  }, {
    "tStartMs": 231679,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "the number on the statement and cancel it."
    } ]
  }, {
    "tStartMs": 234541,
    "dDurationMs": 4842,
    "segs": [ {
      "utf8": "If a company makes it hard to cancel, and\nsome of them will, that is exactly"
    } ]
  }, {
    "tStartMs": 239383,
    "dDurationMs": 5023,
    "segs": [ {
      "utf8": "the behavior regulators are cracking down\non this year, so be firm and keep"
    } ]
  }, {
    "tStartMs": 244406,
    "dDurationMs": 4723,
    "segs": [ {
      "utf8": "asking until it is done. If they give you\nthe runaround, know that the law"
    } ]
  }, {
    "tStartMs": 249129,
    "dDurationMs": 5263,
    "segs": [ {
      "utf8": "is finally on your side. The second one is\na fee your cable or internet company"
    } ]
  }, {
    "tStartMs": 254392,
    "dDurationMs": 4742,
    "segs": [ {
      "utf8": "has been charging you, month after month,\nfor a piece of equipment, usually"
    } ]
  }, {
    "tStartMs": 259134,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "the modem or the box that brings the\nsignal into your home."
    } ]
  }, {
    "tStartMs": 262736,
    "dDurationMs": 2181,
    "segs": [ {
      "utf8": "Now here is what almost no one realizes."
    } ]
  }, {
    "tStartMs": 265458,
    "dDurationMs": 4862,
    "segs": [ {
      "utf8": "If you bought your own equipment, or if\nyou returned theirs and they kept charging"
    } ]
  }, {
    "tStartMs": 270320,
    "dDurationMs": 5023,
    "segs": [ {
      "utf8": "you anyway, that fee is not merely unfair,\nit is against the law."
    } ]
  }, {
    "tStartMs": 276164,
    "dDurationMs": 4362,
    "segs": [ {
      "utf8": "A federal law passed a few years ago made\nit illegal for these companies to"
    } ]
  }, {
    "tStartMs": 280526,
    "dDurationMs": 3242,
    "segs": [ {
      "utf8": "bill you for equipment you are not\nactually renting from them."
    } ]
  }, {
    "tStartMs": 284008,
    "dDurationMs": 4903,
    "segs": [ {
      "utf8": "And yet the charge, often fifteen dollars\na month, which comes to a hundred"
    } ]
  }, {
    "tStartMs": 288911,
    "dDurationMs": 5323,
    "segs": [ {
      "utf8": "and eighty dollars every year, keeps\nshowing up, because their system quietly"
    } ]
  }, {
    "tStartMs": 294234,
    "dDurationMs": 5163,
    "segs": [ {
      "utf8": "kept it running. Look at your cable or\ninternet bill and find the line that"
    } ]
  }, {
    "tStartMs": 299397,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "says equipment, or rental, or gateway."
    } ]
  }, {
    "tStartMs": 302999,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "Then call and ask one plain question."
    } ]
  }, {
    "tStartMs": 305680,
    "dDurationMs": 4763,
    "segs": [ {
      "utf8": "Am I being charged to rent equipment, and\ndo I actually own it, or did I already"
    } ]
  }, {
    "tStartMs": 310443,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "return it."
    } ]
  }, {
    "tStartMs": 311783,
    "dDurationMs": 4503,
    "segs": [ {
      "utf8": "If it turns out you own it, tell them to\ntake the fee off, and then ask them"
    } ]
  }, {
    "tStartMs": 316286,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "to pay you back for what they wrongly\ncharged."
    } ]
  }, {
    "tStartMs": 319388,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "A great many people get months of that\nmoney returned with a single phone call."
    } ]
  }, {
    "tStartMs": 323350,
    "dDurationMs": 5423,
    "segs": [ {
      "utf8": "The third one is a warranty, or a service\ncontract, the kind you were sold"
    } ]
  }, {
    "tStartMs": 328773,
    "dDurationMs": 5383,
    "segs": [ {
      "utf8": "on a car, an appliance, or a piece of\nelectronics, promising to cover repairs"
    } ]
  }, {
    "tStartMs": 334156,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "down the road."
    } ]
  }, {
    "tStartMs": 335857,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "Here is the quiet trap."
    } ]
  }, {
    "tStartMs": 338038,
    "dDurationMs": 5203,
    "segs": [ {
      "utf8": "A great many of these renew themselves\nautomatically, year after year, long"
    } ]
  }, {
    "tStartMs": 343241,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "after the item is gone or the coverage has\nalready run out."
    } ]
  }, {
    "tStartMs": 347323,
    "dDurationMs": 4643,
    "segs": [ {
      "utf8": "People keep paying for a warranty on a car\nthey sold two years ago, or on a"
    } ]
  }, {
    "tStartMs": 351966,
    "dDurationMs": 5163,
    "segs": [ {
      "utf8": "refrigerator that broke and was replaced,\nsimply because the charge kept renewing"
    } ]
  }, {
    "tStartMs": 357129,
    "dDurationMs": 1861,
    "segs": [ {
      "utf8": "and nobody ever stopped it."
    } ]
  }, {
    "tStartMs": 359870,
    "dDurationMs": 4763,
    "segs": [ {
      "utf8": "And even when the item is still sitting in\nyour home, these contracts are well"
    } ]
  }, {
    "tStartMs": 364633,
    "dDurationMs": 4082,
    "segs": [ {
      "utf8": "known for being nearly impossible to\nactually use when the day comes to file"
    } ]
  }, {
    "tStartMs": 368715,
    "dDurationMs": 4603,
    "segs": [ {
      "utf8": "a claim. So if you are paying for one, ask\nyourself just two questions."
    } ]
  }, {
    "tStartMs": 373898,
    "dDurationMs": 4823,
    "segs": [ {
      "utf8": "Do I still own the thing it is supposed to\ncover, and have I ever once actually"
    } ]
  }, {
    "tStartMs": 378721,
    "dDurationMs": 4942,
    "segs": [ {
      "utf8": "been able to use it. If the answer to\neither question is no, call and cancel"
    } ]
  }, {
    "tStartMs": 383663,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "it, and ask whether you are owed money\nback for the part you never used."
    } ]
  }, {
    "tStartMs": 388266,
    "dDurationMs": 4983,
    "segs": [ {
      "utf8": "Very often, you are. The fourth one is a\nmonthly charge for something called"
    } ]
  }, {
    "tStartMs": 393249,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "credit monitoring, or identity protection."
    } ]
  }, {
    "tStartMs": 396851,
    "dDurationMs": 4943,
    "segs": [ {
      "utf8": "So many people signed up for one of these\nyears ago, often right after a store"
    } ]
  }, {
    "tStartMs": 401794,
    "dDurationMs": 4862,
    "segs": [ {
      "utf8": "or a bank sent a letter saying their\ninformation might have been exposed, and"
    } ]
  }, {
    "tStartMs": 406656,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "it came with a few free months at the\nstart."
    } ]
  }, {
    "tStartMs": 409438,
    "dDurationMs": 4662,
    "segs": [ {
      "utf8": "Then those free months ended, the monthly\ncharge quietly began, and it has"
    } ]
  }, {
    "tStartMs": 414100,
    "dDurationMs": 5143,
    "segs": [ {
      "utf8": "been running ever since, sometimes for\nyears, at fifteen or twenty dollars"
    } ]
  }, {
    "tStartMs": 419243,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "a month. And here is what stings."
    } ]
  }, {
    "tStartMs": 422525,
    "dDurationMs": 4262,
    "segs": [ {
      "utf8": "For most people it is money spent on\nsomething you can do yourself, for free."
    } ]
  }, {
    "tStartMs": 427368,
    "dDurationMs": 4853,
    "segs": [ {
      "utf8": "You are allowed to freeze your own credit\nat no cost at all, and that freeze"
    } ]
  }, {
    "tStartMs": 432221,
    "dDurationMs": 4752,
    "segs": [ {
      "utf8": "is stronger protection than most of these\npaid services will ever give you."
    } ]
  }, {
    "tStartMs": 437573,
    "dDurationMs": 4023,
    "segs": [ {
      "utf8": "Look on your statement for any charge with\nwords like protection, monitoring,"
    } ]
  }, {
    "tStartMs": 441976,
    "dDurationMs": 5263,
    "segs": [ {
      "utf8": "or secure in the name. If you are not\ntruly using it, cancel it, and put a"
    } ]
  }, {
    "tStartMs": 447239,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "free freeze on your credit instead."
    } ]
  }, {
    "tStartMs": 449740,
    "dDurationMs": 4483,
    "segs": [ {
      "utf8": "And the fifth one, the one I promised\nwould be different, is not a company"
    } ]
  }, {
    "tStartMs": 454223,
    "dDurationMs": 4542,
    "segs": [ {
      "utf8": "at all. It is a piece of money pulled\nstraight out of your Social Security"
    } ]
  }, {
    "tStartMs": 458765,
    "dDurationMs": 5043,
    "segs": [ {
      "utf8": "check, or your pension, every single\nmonth, and handed to the government as"
    } ]
  }, {
    "tStartMs": 463808,
    "dDurationMs": 781,
    "segs": [ {
      "utf8": "income tax."
    } ]
  }, {
    "tStartMs": 465289,
    "dDurationMs": 4182,
    "segs": [ {
      "utf8": "Now, at some point in the past, a great\nmany people chose to have this tax"
    } ]
  }, {
    "tStartMs": 469471,
    "dDurationMs": 5283,
    "segs": [ {
      "utf8": "taken out on purpose, just to be safe, so\nthey would not face a big bill in"
    } ]
  }, {
    "tStartMs": 474754,
    "dDurationMs": 4042,
    "segs": [ {
      "utf8": "the spring. And back then, that may have\nmade perfect sense."
    } ]
  }, {
    "tStartMs": 479297,
    "dDurationMs": 4622,
    "segs": [ {
      "utf8": "But here is what quietly changes as you\nget older, and what almost no one ever"
    } ]
  }, {
    "tStartMs": 483919,
    "dDurationMs": 5243,
    "segs": [ {
      "utf8": "goes back to check. Each year past sixty\nfive, the slice of your income the"
    } ]
  }, {
    "tStartMs": 489162,
    "dDurationMs": 4783,
    "segs": [ {
      "utf8": "government does not tax grows larger, and\nwith the newer deductions written"
    } ]
  }, {
    "tStartMs": 493945,
    "dDurationMs": 4983,
    "segs": [ {
      "utf8": "for seniors, a great many older people\nliving on Social Security and a modest"
    } ]
  }, {
    "tStartMs": 498928,
    "dDurationMs": 4502,
    "segs": [ {
      "utf8": "amount more now owe little or nothing at\nall in federal income tax."
    } ]
  }, {
    "tStartMs": 504151,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "And yet the withholding just keeps going."
    } ]
  }, {
    "tStartMs": 506992,
    "dDurationMs": 4723,
    "segs": [ {
      "utf8": "Every month, month after month, tax is\npulled out of your check for a bill"
    } ]
  }, {
    "tStartMs": 511715,
    "dDurationMs": 5003,
    "segs": [ {
      "utf8": "you may no longer owe, and the government\nsimply holds your own money all year"
    } ]
  }, {
    "tStartMs": 516718,
    "dDurationMs": 5383,
    "segs": [ {
      "utf8": "long, handing it back, without a single\npenny of interest, and only if you"
    } ]
  }, {
    "tStartMs": 522101,
    "dDurationMs": 5162,
    "segs": [ {
      "utf8": "remember to file for it. Think for a\nmoment about someone who has had that"
    } ]
  }, {
    "tStartMs": 527263,
    "dDurationMs": 5884,
    "segs": [ {
      "utf8": "tax taken from every check for the last\nfive or six years, never once stopping"
    } ]
  }, {
    "tStartMs": 533147,
    "dDurationMs": 4862,
    "segs": [ {
      "utf8": "to ask whether they still owe it, quietly\nhanding over money that was theirs"
    } ]
  }, {
    "tStartMs": 538009,
    "dDurationMs": 5383,
    "segs": [ {
      "utf8": "to keep the entire time. If that might be\nyou, you do not have to guess about"
    } ]
  }, {
    "tStartMs": 543392,
    "dDurationMs": 5603,
    "segs": [ {
      "utf8": "it. A free tax counselor for seniors can\nlook at your income in a few minutes"
    } ]
  }, {
    "tStartMs": 548995,
    "dDurationMs": 3723,
    "segs": [ {
      "utf8": "and tell you plainly whether you owe any\nfederal tax at all."
    } ]
  }, {
    "tStartMs": 552958,
    "dDurationMs": 4182,
    "segs": [ {
      "utf8": "And if the answer is that you do not, you\ncan stop the withholding with one"
    } ]
  }, {
    "tStartMs": 557140,
    "dDurationMs": 4723,
    "segs": [ {
      "utf8": "short form, handed to Social Security, or\nto whoever pays your pension."
    } ]
  }, {
    "tStartMs": 561863,
    "dDurationMs": 5263,
    "segs": [ {
      "utf8": "It is a simple voluntary withholding\nrequest, and turning it off means that"
    } ]
  }, {
    "tStartMs": 567126,
    "dDurationMs": 4642,
    "segs": [ {
      "utf8": "money finally stays in your check, where\nit belonged all along, starting with"
    } ]
  }, {
    "tStartMs": 571768,
    "dDurationMs": 1241,
    "segs": [ {
      "utf8": "your very next payment."
    } ]
  }, {
    "tStartMs": 574089,
    "dDurationMs": 3903,
    "segs": [ {
      "utf8": "For someone stretching a modest check to\ncover the month, that can be more"
    } ]
  }, {
    "tStartMs": 577992,
    "dDurationMs": 4042,
    "segs": [ {
      "utf8": "than a thousand dollars a year handed\nback, money they could have been living"
    } ]
  }, {
    "tStartMs": 582034,
    "dDurationMs": 5663,
    "segs": [ {
      "utf8": "on the whole time. Now step back and look\nat what all five of these share,"
    } ]
  }, {
    "tStartMs": 587697,
    "dDurationMs": 5503,
    "segs": [ {
      "utf8": "because it is the very same quiet thread\nrunning through every one."
    } ]
  }, {
    "tStartMs": 593200,
    "dDurationMs": 4883,
    "segs": [ {
      "utf8": "Each of them is a charge that kept running\non its own, long after the reason"
    } ]
  }, {
    "tStartMs": 598083,
    "dDurationMs": 4662,
    "segs": [ {
      "utf8": "for it had ended. And not a single one of\nthem will ever stop by itself."
    } ]
  }, {
    "tStartMs": 603486,
    "dDurationMs": 3942,
    "segs": [ {
      "utf8": "The company will not stop it. The\ngovernment will not stop it."
    } ]
  }, {
    "tStartMs": 607788,
    "dDurationMs": 3782,
    "segs": [ {
      "utf8": "The only person on this earth who can\nswitch these off is you."
    } ]
  }, {
    "tStartMs": 611750,
    "dDurationMs": 3883,
    "segs": [ {
      "utf8": "But that also means the power is entirely\nin your hands,"
    } ]
  }, {
    "tStartMs": 616353,
    "dDurationMs": 4202,
    "segs": [ {
      "utf8": "and switching them off costs you nothing\nbut a little time and a few phone"
    } ]
  }, {
    "tStartMs": 620555,
    "dDurationMs": 941,
    "segs": [ {
      "utf8": "calls this week."
    } ]
  }, {
    "tStartMs": 622276,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "So here is exactly what to do."
    } ]
  }, {
    "tStartMs": 624758,
    "dDurationMs": 4722,
    "segs": [ {
      "utf8": "First, pull one month of your bank and\ncard statements, and read every charge,"
    } ]
  }, {
    "tStartMs": 629480,
    "dDurationMs": 5683,
    "segs": [ {
      "utf8": "line by line. Second, cancel any\nsubscription or service you no longer use."
    } ]
  }, {
    "tStartMs": 635864,
    "dDurationMs": 4803,
    "segs": [ {
      "utf8": "Third, call your cable or internet company\nabout that equipment fee, and ask"
    } ]
  }, {
    "tStartMs": 640667,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "for a refund."
    } ]
  }, {
    "tStartMs": 641987,
    "dDurationMs": 4923,
    "segs": [ {
      "utf8": "Fourth, cancel any warranty or credit\nmonitoring you are not using, and ask"
    } ]
  }, {
    "tStartMs": 646910,
    "dDurationMs": 5683,
    "segs": [ {
      "utf8": "for your money back. And fifth, if tax is\nbeing taken out of your Social Security"
    } ]
  }, {
    "tStartMs": 652593,
    "dDurationMs": 5183,
    "segs": [ {
      "utf8": "or your pension, have a free senior tax\ncounselor check whether you even still"
    } ]
  }, {
    "tStartMs": 657776,
    "dDurationMs": 4663,
    "segs": [ {
      "utf8": "owe it, and if you do not, file the one\nform that stops it."
    } ]
  }, {
    "tStartMs": 662939,
    "dDurationMs": 4442,
    "segs": [ {
      "utf8": "Every one of these is free to do, and\ntogether they can put hundreds, and for"
    } ]
  }, {
    "tStartMs": 667381,
    "dDurationMs": 4183,
    "segs": [ {
      "utf8": "some people well over a thousand dollars a\nyear, back where it belongs."
    } ]
  }, {
    "tStartMs": 672804,
    "dDurationMs": 4763,
    "segs": [ {
      "utf8": "This is general information to help you\nknow what to look for, and it is not"
    } ]
  }, {
    "tStartMs": 677567,
    "dDurationMs": 4443,
    "segs": [ {
      "utf8": "tax or legal advice, because every\nsituation is a little different."
    } ]
  }, {
    "tStartMs": 682710,
    "dDurationMs": 4302,
    "segs": [ {
      "utf8": "I have put where to start for each one of\nthese in the description just below"
    } ]
  }, {
    "tStartMs": 687012,
    "dDurationMs": 2682,
    "segs": [ {
      "utf8": "this video. And before you go,"
    } ]
  }, {
    "tStartMs": 690434,
    "dDurationMs": 5603,
    "segs": [ {
      "utf8": "think of one person who is quietly paying\nfor things that ended long ago, and"
    } ]
  }, {
    "tStartMs": 696037,
    "dDurationMs": 2462,
    "segs": [ {
      "utf8": "has no idea it is still happening."
    } ]
  }, {
    "tStartMs": 699139,
    "dDurationMs": 4222,
    "segs": [ {
      "utf8": "A friend. A parent. A neighbor living on a\nfixed check."
    } ]
  }, {
    "tStartMs": 704002,
    "dDurationMs": 5283,
    "segs": [ {
      "utf8": "Send them this video. One hour with their\nbank statement this week could hand"
    } ]
  }, {
    "tStartMs": 709285,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "them back money they never knew they were\nlosing."
    } ]
  }, {
    "tStartMs": 713067,
    "dDurationMs": 4522,
    "segs": [ {
      "utf8": "Then go and check your own, and help\nsomeone you love check theirs."
    } ]
  } ]
}
