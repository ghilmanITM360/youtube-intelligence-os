{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3661,
    "segs": [ {
      "utf8": "There is a real chance that,\nsomewhere in this country"
    } ]
  }, {
    "tStartMs": 3661,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "right now, there is money sitting\nin an account with"
    } ]
  }, {
    "tStartMs": 7121,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "your name on it that you have\ncompletely forgotten about,"
    } ]
  }, {
    "tStartMs": 10561,
    "dDurationMs": 2282,
    "segs": [ {
      "utf8": "or never even knew existed."
    } ]
  }, {
    "tStartMs": 13682,
    "dDurationMs": 2721,
    "segs": [ {
      "utf8": "A pension from a company that\nshut its doors years"
    } ]
  }, {
    "tStartMs": 16403,
    "dDurationMs": 441,
    "segs": [ {
      "utf8": "ago."
    } ]
  }, {
    "tStartMs": 17524,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "A life insurance payout from\na parent who passed away."
    } ]
  }, {
    "tStartMs": 21285,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "A savings bond going stale in a drawer."
    } ]
  }, {
    "tStartMs": 24826,
    "dDurationMs": 2939,
    "segs": [ {
      "utf8": "A retirement account you\nleft behind at a job you"
    } ]
  }, {
    "tStartMs": 27765,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "walked away from decades back."
    } ]
  }, {
    "tStartMs": 30867,
    "dDurationMs": 3861,
    "segs": [ {
      "utf8": "Billions of dollars sit waiting\nexactly like this, and here"
    } ]
  }, {
    "tStartMs": 34728,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "is the cruel part."
    } ]
  }, {
    "tStartMs": 36649,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Not one single agency holding\nthat money has any real"
    } ]
  }, {
    "tStartMs": 40289,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "reason to find you and give it back."
    } ]
  }, {
    "tStartMs": 43189,
    "dDurationMs": 4161,
    "segs": [ {
      "utf8": "They are content to hold it, quietly,\nsometimes for years,"
    } ]
  }, {
    "tStartMs": 47811,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "sometimes forever, until the day\nyou decide to come looking"
    } ]
  }, {
    "tStartMs": 51851,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "for it."
    } ]
  }, {
    "tStartMs": 52652,
    "dDurationMs": 2121,
    "segs": [ {
      "utf8": "So let me make you a promise."
    } ]
  }, {
    "tStartMs": 54773,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "In the next few minutes\nI will hand you five"
    } ]
  }, {
    "tStartMs": 58194,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "free and official places\nto look, and not one of"
    } ]
  }, {
    "tStartMs": 61274,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "them will cost you a dollar."
    } ]
  }, {
    "tStartMs": 63195,
    "dDurationMs": 2119,
    "segs": [ {
      "utf8": "Not a service that charges you a fee."
    } ]
  }, {
    "tStartMs": 65775,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "Not a company that takes a cut."
    } ]
  }, {
    "tStartMs": 68215,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "Free government and official databases,\nthe very same ones the"
    } ]
  }, {
    "tStartMs": 71897,
    "dDurationMs": 699,
    "segs": [ {
      "utf8": "experts use."
    } ]
  }, {
    "tStartMs": 73277,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Stay with me to the end,\nbecause most people have"
    } ]
  }, {
    "tStartMs": 76257,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "never checked a single one\nof these, and the money"
    } ]
  }, {
    "tStartMs": 79138,
    "dDurationMs": 1181,
    "segs": [ {
      "utf8": "does not come to you."
    } ]
  }, {
    "tStartMs": 80319,
    "dDurationMs": 2379,
    "segs": [ {
      "utf8": "You have to go and look for it."
    } ]
  }, {
    "tStartMs": 83039,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Before we begin, let me\ntell you who is most"
    } ]
  }, {
    "tStartMs": 85859,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "likely to have money sitting and\nwaiting like this, because"
    } ]
  }, {
    "tStartMs": 88960,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "it may very well be you."
    } ]
  }, {
    "tStartMs": 91180,
    "dDurationMs": 2122,
    "segs": [ {
      "utf8": "If you have lived in more\nthan one home over"
    } ]
  }, {
    "tStartMs": 93302,
    "dDurationMs": 1759,
    "segs": [ {
      "utf8": "the years, the odds go up."
    } ]
  }, {
    "tStartMs": 95501,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "If you have worked for more\nthan one employer in"
    } ]
  }, {
    "tStartMs": 97662,
    "dDurationMs": 1720,
    "segs": [ {
      "utf8": "your life, they go up again."
    } ]
  }, {
    "tStartMs": 100123,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "If you have ever changed\nbanks, moved to a new"
    } ]
  }, {
    "tStartMs": 103024,
    "dDurationMs": 3641,
    "segs": [ {
      "utf8": "state, lost a husband or\na wife, or settled the"
    } ]
  }, {
    "tStartMs": 106665,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "affairs of a parent who passed\naway, they climb higher"
    } ]
  }, {
    "tStartMs": 109805,
    "dDurationMs": 461,
    "segs": [ {
      "utf8": "still."
    } ]
  }, {
    "tStartMs": 110986,
    "dDurationMs": 1039,
    "segs": [ {
      "utf8": "The truth is simple."
    } ]
  }, {
    "tStartMs": 112665,
    "dDurationMs": 2842,
    "segs": [ {
      "utf8": "The longer and the fuller\nyour life has been, the"
    } ]
  }, {
    "tStartMs": 115507,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "more places your money has\nhad to slip through the"
    } ]
  }, {
    "tStartMs": 117947,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "cracks."
    } ]
  }, {
    "tStartMs": 119427,
    "dDurationMs": 3521,
    "segs": [ {
      "utf8": "Older Americans are, by far,\nthe most likely of anyone"
    } ]
  }, {
    "tStartMs": 122948,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "to be owed money they have\nlost track of, and"
    } ]
  }, {
    "tStartMs": 125588,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "they are also the least likely\nto ever go looking"
    } ]
  }, {
    "tStartMs": 127989,
    "dDurationMs": 621,
    "segs": [ {
      "utf8": "for it."
    } ]
  }, {
    "tStartMs": 129349,
    "dDurationMs": 2862,
    "segs": [ {
      "utf8": "So as I walk you through\nthese five, keep a"
    } ]
  }, {
    "tStartMs": 132211,
    "dDurationMs": 2859,
    "segs": [ {
      "utf8": "pen and a piece of paper\nnearby, and write down"
    } ]
  }, {
    "tStartMs": 135070,
    "dDurationMs": 2282,
    "segs": [ {
      "utf8": "the ones that sound like\nthey could be you."
    } ]
  }, {
    "tStartMs": 137592,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The first place is unclaimed pensions."
    } ]
  }, {
    "tStartMs": 140832,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "Think back over every job you ever held."
    } ]
  }, {
    "tStartMs": 143432,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "If a company you worked for offered\na traditional pension,"
    } ]
  }, {
    "tStartMs": 146354,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "and that company later closed,\nwas bought out, or ended"
    } ]
  }, {
    "tStartMs": 149974,
    "dDurationMs": 3501,
    "segs": [ {
      "utf8": "its pension plan, the money\nyou earned did not simply"
    } ]
  }, {
    "tStartMs": 153475,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "vanish."
    } ]
  }, {
    "tStartMs": 154536,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "By law, it is often turned\nover to a federal"
    } ]
  }, {
    "tStartMs": 157576,
    "dDurationMs": 4361,
    "segs": [ {
      "utf8": "agency whose entire job is to\nprotect pensions and hold"
    } ]
  }, {
    "tStartMs": 161937,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "that money until the rightful\nowner claims it."
    } ]
  }, {
    "tStartMs": 165258,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "That agency keeps a free, searchable\ndatabase of unclaimed pensions."
    } ]
  }, {
    "tStartMs": 170219,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "You enter your name, and\nit tells you whether a"
    } ]
  }, {
    "tStartMs": 172699,
    "dDurationMs": 1381,
    "segs": [ {
      "utf8": "pension is being held for you."
    } ]
  }, {
    "tStartMs": 174700,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "There are people owed thousands\nof dollars a year who"
    } ]
  }, {
    "tStartMs": 177721,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "have no idea, because the company\nthey worked for disappeared"
    } ]
  }, {
    "tStartMs": 181701,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "decades ago and never had a\ncurrent address for them."
    } ]
  }, {
    "tStartMs": 185082,
    "dDurationMs": 3661,
    "segs": [ {
      "utf8": "This happens most often to\npeople who gave years to"
    } ]
  }, {
    "tStartMs": 188743,
    "dDurationMs": 4462,
    "segs": [ {
      "utf8": "industries that went through hard times,\nthe factories, the airlines,"
    } ]
  }, {
    "tStartMs": 193645,
    "dDurationMs": 4141,
    "segs": [ {
      "utf8": "the retailers, the companies that\nmerged, were swallowed up, or"
    } ]
  }, {
    "tStartMs": 197786,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "simply closed their doors for good."
    } ]
  }, {
    "tStartMs": 200347,
    "dDurationMs": 1079,
    "segs": [ {
      "utf8": "The work was real."
    } ]
  }, {
    "tStartMs": 201866,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "The pension was earned."
    } ]
  }, {
    "tStartMs": 203067,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "And then the paperwork got\nlost in the shuffle of"
    } ]
  }, {
    "tStartMs": 206307,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "a company that no longer exists."
    } ]
  }, {
    "tStartMs": 208788,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "But the money did not get lost."
    } ]
  }, {
    "tStartMs": 211088,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "It was handed to that federal\nagency, and it is"
    } ]
  }, {
    "tStartMs": 214250,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "sitting there waiting."
    } ]
  }, {
    "tStartMs": 215770,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "If you or your spouse ever worked\nsomewhere that offered"
    } ]
  }, {
    "tStartMs": 218631,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "a pension, this is worth\nchecking, and I will put"
    } ]
  }, {
    "tStartMs": 221951,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "the name of the database in\nthe description below."
    } ]
  }, {
    "tStartMs": 225111,
    "dDurationMs": 3481,
    "segs": [ {
      "utf8": "The second place is a retirement\naccount left behind at"
    } ]
  }, {
    "tStartMs": 228592,
    "dDurationMs": 981,
    "segs": [ {
      "utf8": "an old employer."
    } ]
  }, {
    "tStartMs": 230133,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Most people change jobs several\ntimes in a working life,"
    } ]
  }, {
    "tStartMs": 233373,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "and a surprising number of us\nleave a workplace retirement"
    } ]
  }, {
    "tStartMs": 236715,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "account behind and simply\nforget it ever existed."
    } ]
  }, {
    "tStartMs": 240695,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "Let me give you a sense\nof how enormous this"
    } ]
  }, {
    "tStartMs": 242996,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "problem truly is."
    } ]
  }, {
    "tStartMs": 244676,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "As of last year, there were\nclose to thirty million"
    } ]
  }, {
    "tStartMs": 247858,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "forgotten retirement accounts in this\ncountry, holding more than two"
    } ]
  }, {
    "tStartMs": 251758,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "trillion dollars between them."
    } ]
  }, {
    "tStartMs": 253479,
    "dDurationMs": 1119,
    "segs": [ {
      "utf8": "Two trillion."
    } ]
  }, {
    "tStartMs": 254598,
    "dDurationMs": 4262,
    "segs": [ {
      "utf8": "And the average forgotten account\nheld nearly sixty seven thousand"
    } ]
  }, {
    "tStartMs": 258860,
    "dDurationMs": 579,
    "segs": [ {
      "utf8": "dollars."
    } ]
  }, {
    "tStartMs": 260040,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Sit with that number for a\nmoment, because it could"
    } ]
  }, {
    "tStartMs": 262440,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "just as easily be sitting in your name."
    } ]
  }, {
    "tStartMs": 265221,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "That money is still yours."
    } ]
  }, {
    "tStartMs": 268002,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "It does not belong to the\nold employer, and it"
    } ]
  }, {
    "tStartMs": 270942,
    "dDurationMs": 1161,
    "segs": [ {
      "utf8": "does not disappear."
    } ]
  }, {
    "tStartMs": 273103,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "There are now free national databases,\nincluding a brand new"
    } ]
  }, {
    "tStartMs": 276863,
    "dDurationMs": 4141,
    "segs": [ {
      "utf8": "one run by the federal Department\nof Labor, built specifically"
    } ]
  }, {
    "tStartMs": 281004,
    "dDurationMs": 3501,
    "segs": [ {
      "utf8": "to reunite people with retirement\nmoney left at former jobs."
    } ]
  }, {
    "tStartMs": 285185,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "You search using your own information,\nand it points you"
    } ]
  }, {
    "tStartMs": 288507,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "toward accounts that may still\nbe holding your money."
    } ]
  }, {
    "tStartMs": 291487,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "For someone who worked for\nthirty or forty years and"
    } ]
  }, {
    "tStartMs": 294408,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "changed jobs along the way,\nan account left behind back"
    } ]
  }, {
    "tStartMs": 297668,
    "dDurationMs": 3161,
    "segs": [ {
      "utf8": "in their forties could have quietly\ngrown into a serious"
    } ]
  }, {
    "tStartMs": 300829,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "sum by now, just waiting\nthere with their name on"
    } ]
  }, {
    "tStartMs": 304011,
    "dDurationMs": 479,
    "segs": [ {
      "utf8": "it."
    } ]
  }, {
    "tStartMs": 304711,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "The third place is one that breaks\nfamilies' hearts when"
    } ]
  }, {
    "tStartMs": 308531,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "they find out too late."
    } ]
  }, {
    "tStartMs": 310312,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "It is unclaimed life insurance."
    } ]
  }, {
    "tStartMs": 312913,
    "dDurationMs": 4021,
    "segs": [ {
      "utf8": "When someone passes away, their\nlife insurance only pays out"
    } ]
  }, {
    "tStartMs": 316934,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "if a family member knows the\npolicy exists and files"
    } ]
  }, {
    "tStartMs": 320615,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "a claim."
    } ]
  }, {
    "tStartMs": 321754,
    "dDurationMs": 2940,
    "segs": [ {
      "utf8": "The insurance company does not\nalways go looking for the"
    } ]
  }, {
    "tStartMs": 324694,
    "dDurationMs": 582,
    "segs": [ {
      "utf8": "beneficiaries."
    } ]
  }, {
    "tStartMs": 326175,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "So when a husband, a wife,\nor a parent dies,"
    } ]
  }, {
    "tStartMs": 329357,
    "dDurationMs": 4101,
    "segs": [ {
      "utf8": "and nobody knew about an old\npolicy, that money can"
    } ]
  }, {
    "tStartMs": 333458,
    "dDurationMs": 2059,
    "segs": [ {
      "utf8": "sit unclaimed for years."
    } ]
  }, {
    "tStartMs": 335697,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "Think for a moment of how\neasily this happens."
    } ]
  }, {
    "tStartMs": 339319,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "A man takes out a modest\npolicy through his job"
    } ]
  }, {
    "tStartMs": 342079,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "back in his fifties, mentions\nit once to his wife"
    } ]
  }, {
    "tStartMs": 345339,
    "dDurationMs": 3281,
    "segs": [ {
      "utf8": "at the kitchen table, and then\ntwenty or thirty years"
    } ]
  }, {
    "tStartMs": 348620,
    "dDurationMs": 1221,
    "segs": [ {
      "utf8": "quietly go by."
    } ]
  }, {
    "tStartMs": 350440,
    "dDurationMs": 3442,
    "segs": [ {
      "utf8": "When he passes, she is grieving,\nshe is buried in"
    } ]
  }, {
    "tStartMs": 353882,
    "dDurationMs": 4201,
    "segs": [ {
      "utf8": "paperwork, and one short conversation\nfrom decades ago is the"
    } ]
  }, {
    "tStartMs": 358083,
    "dDurationMs": 1340,
    "segs": [ {
      "utf8": "furthest thing from her mind."
    } ]
  }, {
    "tStartMs": 359704,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "The policy is real."
    } ]
  }, {
    "tStartMs": 361783,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "The money is hers by right."
    } ]
  }, {
    "tStartMs": 364425,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "But unless she knows to\ngo and claim it, it"
    } ]
  }, {
    "tStartMs": 367185,
    "dDurationMs": 3581,
    "segs": [ {
      "utf8": "simply sits there, unclaimed,\nyear after year."
    } ]
  }, {
    "tStartMs": 371266,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "And that is exactly why this\nnext tool matters so"
    } ]
  }, {
    "tStartMs": 374607,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "much."
    } ]
  }, {
    "tStartMs": 375567,
    "dDurationMs": 3401,
    "segs": [ {
      "utf8": "There is a free, official\ntool, run by the national"
    } ]
  }, {
    "tStartMs": 378968,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "association of state insurance regulators,\ncalled the life insurance policy"
    } ]
  }, {
    "tStartMs": 383608,
    "dDurationMs": 661,
    "segs": [ {
      "utf8": "locator."
    } ]
  }, {
    "tStartMs": 384928,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "You give them the information\nof the person who passed,"
    } ]
  }, {
    "tStartMs": 387589,
    "dDurationMs": 4302,
    "segs": [ {
      "utf8": "and participating insurance companies\nsearch their records and reach out"
    } ]
  }, {
    "tStartMs": 391891,
    "dDurationMs": 2421,
    "segs": [ {
      "utf8": "to you if there is a policy with your name"
    } ]
  }, {
    "tStartMs": 394312,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "on it as the beneficiary."
    } ]
  }, {
    "tStartMs": 396771,
    "dDurationMs": 4161,
    "segs": [ {
      "utf8": "This single free tool has already\nconnected families with more"
    } ]
  }, {
    "tStartMs": 400932,
    "dDurationMs": 3361,
    "segs": [ {
      "utf8": "than six billion dollars they\ndid not know was theirs."
    } ]
  }, {
    "tStartMs": 404853,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "The fourth place is paper savings\nbonds that have stopped"
    } ]
  }, {
    "tStartMs": 408415,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "earning interest."
    } ]
  }, {
    "tStartMs": 410214,
    "dDurationMs": 8336,
    "segs": [ {
      "utf8": "For generations, savings bonds\nwere one of the most common"
    } ]
  }, {
    "tStartMs": 418550,
    "dDurationMs": 4308,
    "segs": [ {
      "utf8": "gifts in this country, handed\nout for graduations, for new"
    } ]
  }, {
    "tStartMs": 422858,
    "dDurationMs": 6031,
    "segs": [ {
      "utf8": "babies, for birthdays, and then\ntucked into a drawer or"
    } ]
  }, {
    "tStartMs": 428889,
    "dDurationMs": 1712,
    "segs": [ {
      "utf8": "a safe deposit box and quietly forgotten."
    } ]
  }, {
    "tStartMs": 430601,
    "dDurationMs": 1868,
    "segs": [ {
      "utf8": "Here is the part most people do not know."
    } ]
  }, {
    "tStartMs": 432469,
    "dDurationMs": 1451,
    "segs": [ {
      "utf8": "A savings bond does not\npay interest forever."
    } ]
  }, {
    "tStartMs": 433920,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Most of them stop growing completely\nafter thirty years, which"
    } ]
  }, {
    "tStartMs": 435440,
    "dDurationMs": 4221,
    "segs": [ {
      "utf8": "means a forgotten bond is simply\nsitting there, fully matured,"
    } ]
  }, {
    "tStartMs": 439661,
    "dDurationMs": 3802,
    "segs": [ {
      "utf8": "no longer earning a single penny,\nwaiting to be cashed"
    } ]
  }, {
    "tStartMs": 443483,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and losing value to inflation\nevery year that it is"
    } ]
  }, {
    "tStartMs": 446403,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "not."
    } ]
  }, {
    "tStartMs": 447324,
    "dDurationMs": 2159,
    "segs": [ {
      "utf8": "And the scale of this is staggering."
    } ]
  }, {
    "tStartMs": 450504,
    "dDurationMs": 3221,
    "segs": [ {
      "utf8": "At this very moment, there\nis more than thirty nine"
    } ]
  }, {
    "tStartMs": 453725,
    "dDurationMs": 3721,
    "segs": [ {
      "utf8": "billion dollars in matured savings\nbonds that have never been"
    } ]
  }, {
    "tStartMs": 457446,
    "dDurationMs": 4621,
    "segs": [ {
      "utf8": "cashed, just sitting there unredeemed,\nmuch of it belonging to"
    } ]
  }, {
    "tStartMs": 462067,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "older Americans and their families\nwho simply lost track of"
    } ]
  }, {
    "tStartMs": 465927,
    "dDurationMs": 840,
    "segs": [ {
      "utf8": "a piece of paper."
    } ]
  }, {
    "tStartMs": 467649,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The United States Treasury runs\na free search tool, often"
    } ]
  }, {
    "tStartMs": 471329,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "called Treasury Hunt, where you\ncan look up matured bonds"
    } ]
  }, {
    "tStartMs": 475149,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "that were never cashed using\nyour Social Security number."
    } ]
  }, {
    "tStartMs": 478891,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "If your parents or grandparents\never bought savings bonds for"
    } ]
  }, {
    "tStartMs": 482211,
    "dDurationMs": 3522,
    "segs": [ {
      "utf8": "you, or if you bought some\nyourself long ago and"
    } ]
  }, {
    "tStartMs": 485733,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "lost track of them, this\none is very much worth"
    } ]
  }, {
    "tStartMs": 488754,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "a look."
    } ]
  }, {
    "tStartMs": 489673,
    "dDurationMs": 3502,
    "segs": [ {
      "utf8": "The fifth place is one that\nalmost no homeowner ever"
    } ]
  }, {
    "tStartMs": 493175,
    "dDurationMs": 3219,
    "segs": [ {
      "utf8": "thinks to check, and that\nis a refund on mortgage"
    } ]
  }, {
    "tStartMs": 496394,
    "dDurationMs": 581,
    "segs": [ {
      "utf8": "insurance."
    } ]
  }, {
    "tStartMs": 497675,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "If you ever had a home\nloan that was insured"
    } ]
  }, {
    "tStartMs": 500375,
    "dDurationMs": 4041,
    "segs": [ {
      "utf8": "by the Federal Housing Administration,\nthe kind often used by"
    } ]
  }, {
    "tStartMs": 504416,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "first time buyers and by\npeople who put down a"
    } ]
  }, {
    "tStartMs": 507017,
    "dDurationMs": 3711,
    "segs": [ {
      "utf8": "smaller down payment, you paid\nan extra insurance premium up"
    } ]
  }, {
    "tStartMs": 510728,
    "dDurationMs": 1031,
    "segs": [ {
      "utf8": "front at the closing."
    } ]
  }, {
    "tStartMs": 512778,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "Here is what most people never learn."
    } ]
  }, {
    "tStartMs": 515379,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "If you later sold that home,\npaid the loan off,"
    } ]
  }, {
    "tStartMs": 518561,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "or refinanced into a different\nkind of loan, and you"
    } ]
  }, {
    "tStartMs": 521441,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "did not fall behind on your\npayments, you may be"
    } ]
  }, {
    "tStartMs": 524322,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "owed a refund of the unused\nportion of that premium."
    } ]
  }, {
    "tStartMs": 528102,
    "dDurationMs": 3801,
    "segs": [ {
      "utf8": "The federal housing agency is\nright now holding hundreds of"
    } ]
  }, {
    "tStartMs": 531903,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "millions of dollars in these refunds\nthat were never collected,"
    } ]
  }, {
    "tStartMs": 535904,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "simply because people moved and\nthe check had nowhere to"
    } ]
  }, {
    "tStartMs": 538985,
    "dDurationMs": 319,
    "segs": [ {
      "utf8": "go."
    } ]
  }, {
    "tStartMs": 539764,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "There is a free, official search\nwhere you enter your"
    } ]
  }, {
    "tStartMs": 542725,
    "dDurationMs": 2741,
    "segs": [ {
      "utf8": "name and the places you\nhave owned a home, and"
    } ]
  }, {
    "tStartMs": 545466,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "if your name comes up, you\ncall the housing agency"
    } ]
  }, {
    "tStartMs": 548267,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "directly and they mail you an application."
    } ]
  }, {
    "tStartMs": 550587,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "If you have owned a home with that kind of"
    } ]
  }, {
    "tStartMs": 553389,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "government backed loan at any point\nsince the early nineteen"
    } ]
  }, {
    "tStartMs": 557309,
    "dDurationMs": 2580,
    "segs": [ {
      "utf8": "eighties, this is well worth\na few minutes to check."
    } ]
  }, {
    "tStartMs": 560330,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "Now let me tie all five of\nthese together, because"
    } ]
  }, {
    "tStartMs": 564530,
    "dDurationMs": 2382,
    "segs": [ {
      "utf8": "they share the same quiet truth."
    } ]
  }, {
    "tStartMs": 567412,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "Not one of them will ever\ncome looking for you."
    } ]
  }, {
    "tStartMs": 570972,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "The agency holding your\npension will not call."
    } ]
  }, {
    "tStartMs": 574413,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "The old employer will not write."
    } ]
  }, {
    "tStartMs": 577114,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "The insurance company will\nnot knock on your door."
    } ]
  }, {
    "tStartMs": 580715,
    "dDurationMs": 3361,
    "segs": [ {
      "utf8": "The Treasury will not mail\nyou a reminder, and the"
    } ]
  }, {
    "tStartMs": 584076,
    "dDurationMs": 2799,
    "segs": [ {
      "utf8": "housing agency will not\nsend you a check out of"
    } ]
  }, {
    "tStartMs": 586875,
    "dDurationMs": 400,
    "segs": [ {
      "utf8": "kindness."
    } ]
  }, {
    "tStartMs": 588197,
    "dDurationMs": 2759,
    "segs": [ {
      "utf8": "Every one of these systems\nis built to hold the"
    } ]
  }, {
    "tStartMs": 590956,
    "dDurationMs": 3881,
    "segs": [ {
      "utf8": "money safely and simply wait,\nand the only thing that"
    } ]
  }, {
    "tStartMs": 594837,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "ever moves it from their\nhands back into yours is"
    } ]
  }, {
    "tStartMs": 597839,
    "dDurationMs": 1359,
    "segs": [ {
      "utf8": "you deciding to look."
    } ]
  }, {
    "tStartMs": 599759,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "The good news is that checking\nevery single one of"
    } ]
  }, {
    "tStartMs": 602700,
    "dDurationMs": 3560,
    "segs": [ {
      "utf8": "these is free, it is official,\nand it takes an"
    } ]
  }, {
    "tStartMs": 606260,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "afternoon at the very most."
    } ]
  }, {
    "tStartMs": 608740,
    "dDurationMs": 3221,
    "segs": [ {
      "utf8": "I want to be honest with you\nabout something, because"
    } ]
  }, {
    "tStartMs": 611961,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "it matters."
    } ]
  }, {
    "tStartMs": 613163,
    "dDurationMs": 2439,
    "segs": [ {
      "utf8": "Not everyone has money waiting\nin every one of these"
    } ]
  }, {
    "tStartMs": 615602,
    "dDurationMs": 421,
    "segs": [ {
      "utf8": "places."
    } ]
  }, {
    "tStartMs": 616503,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "Some people will check all\nfive and find nothing, and"
    } ]
  }, {
    "tStartMs": 619604,
    "dDurationMs": 1299,
    "segs": [ {
      "utf8": "that is perfectly normal."
    } ]
  }, {
    "tStartMs": 621524,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "But a great many people check\nand are stunned to"
    } ]
  }, {
    "tStartMs": 624325,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "find something real, and since\nevery one of these tools"
    } ]
  }, {
    "tStartMs": 627145,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "is free and official, the\nonly thing it ever costs"
    } ]
  }, {
    "tStartMs": 629806,
    "dDurationMs": 1861,
    "segs": [ {
      "utf8": "you to look is a little of your time."
    } ]
  }, {
    "tStartMs": 632067,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "And please be careful."
    } ]
  }, {
    "tStartMs": 634366,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "If a company contacts you\nand offers to find your"
    } ]
  }, {
    "tStartMs": 637347,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "money for a fee, you do\nnot need them, because"
    } ]
  }, {
    "tStartMs": 640109,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "everything I have described you\ncan do yourself, for free,"
    } ]
  }, {
    "tStartMs": 643389,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "through the official sources."
    } ]
  }, {
    "tStartMs": 645850,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "This is general information to\nhelp you check for yourself,"
    } ]
  }, {
    "tStartMs": 648711,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "and not financial or legal advice\nabout your own particular"
    } ]
  }, {
    "tStartMs": 652371,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "situation."
    } ]
  }, {
    "tStartMs": 653471,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "So here is what to do."
    } ]
  }, {
    "tStartMs": 655491,
    "dDurationMs": 3142,
    "segs": [ {
      "utf8": "Pick one of these five this\nweek and check it."
    } ]
  }, {
    "tStartMs": 658852,
    "dDurationMs": 2181,
    "segs": [ {
      "utf8": "If you ever had a pension\nat a company that"
    } ]
  }, {
    "tStartMs": 661033,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "closed, start there."
    } ]
  }, {
    "tStartMs": 663153,
    "dDurationMs": 2702,
    "segs": [ {
      "utf8": "If you left a job with a retirement\naccount behind,"
    } ]
  }, {
    "tStartMs": 666254,
    "dDurationMs": 760,
    "segs": [ {
      "utf8": "start there."
    } ]
  }, {
    "tStartMs": 667674,
    "dDurationMs": 2721,
    "segs": [ {
      "utf8": "If you lost a spouse or a parent and never"
    } ]
  }, {
    "tStartMs": 670395,
    "dDurationMs": 3382,
    "segs": [ {
      "utf8": "knew whether they carried life insurance,\nstart with the policy"
    } ]
  }, {
    "tStartMs": 673777,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "locator."
    } ]
  }, {
    "tStartMs": 675017,
    "dDurationMs": 2239,
    "segs": [ {
      "utf8": "And if you have ever owned a home with a"
    } ]
  }, {
    "tStartMs": 677256,
    "dDurationMs": 3681,
    "segs": [ {
      "utf8": "loan from the Federal Housing Administration,\ncheck whether you are"
    } ]
  }, {
    "tStartMs": 680937,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "owed a refund on the mortgage\ninsurance you paid."
    } ]
  }, {
    "tStartMs": 684038,
    "dDurationMs": 2282,
    "segs": [ {
      "utf8": "I will put the names of every one of these"
    } ]
  }, {
    "tStartMs": 686320,
    "dDurationMs": 3579,
    "segs": [ {
      "utf8": "free and official tools in the\ndescription below, so you"
    } ]
  }, {
    "tStartMs": 689899,
    "dDurationMs": 1182,
    "segs": [ {
      "utf8": "can find them safely."
    } ]
  }, {
    "tStartMs": 691780,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "So here is my challenge to you, and it is"
    } ]
  }, {
    "tStartMs": 694881,
    "dDurationMs": 921,
    "segs": [ {
      "utf8": "a simple one."
    } ]
  }, {
    "tStartMs": 696461,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "Do not let this become\none more video you nod"
    } ]
  }, {
    "tStartMs": 699423,
    "dDurationMs": 2519,
    "segs": [ {
      "utf8": "along to and then forget by the morning."
    } ]
  }, {
    "tStartMs": 702822,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "Tonight, before you sleep, pick\njust one of these five"
    } ]
  }, {
    "tStartMs": 706504,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "and write yourself a note\nto check it this week."
    } ]
  }, {
    "tStartMs": 710144,
    "dDurationMs": 2322,
    "segs": [ {
      "utf8": "The pension search takes\nabout ten minutes."
    } ]
  }, {
    "tStartMs": 712905,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "The life insurance locator\ntakes about five."
    } ]
  }, {
    "tStartMs": 716025,
    "dDurationMs": 2882,
    "segs": [ {
      "utf8": "Every one of them is free,\nand every one of"
    } ]
  }, {
    "tStartMs": 718907,
    "dDurationMs": 2721,
    "segs": [ {
      "utf8": "them could put money back\nin your hands that was"
    } ]
  }, {
    "tStartMs": 721628,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "yours the entire time."
    } ]
  }, {
    "tStartMs": 723727,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "And if you do turn something\nup, do not keep"
    } ]
  }, {
    "tStartMs": 726668,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "the secret to yourself."
    } ]
  }, {
    "tStartMs": 728509,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "The friend beside you at church,\nthe brother you call"
    } ]
  }, {
    "tStartMs": 731549,
    "dDurationMs": 3221,
    "segs": [ {
      "utf8": "on a Sunday, the neighbor who\nworked forty years and"
    } ]
  }, {
    "tStartMs": 734770,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "never once thought to look,\nthey may be owed even"
    } ]
  }, {
    "tStartMs": 737932,
    "dDurationMs": 1019,
    "segs": [ {
      "utf8": "more than you are."
    } ]
  }, {
    "tStartMs": 739552,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Because in the end, the people\nwho find this money"
    } ]
  }, {
    "tStartMs": 742212,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "are not luckier than anyone else."
    } ]
  }, {
    "tStartMs": 744793,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "They are simply the ones who stopped\nwondering and started"
    } ]
  }, {
    "tStartMs": 748033,
    "dDurationMs": 481,
    "segs": [ {
      "utf8": "searching."
    } ]
  }, {
    "tStartMs": 749313,
    "dDurationMs": 2282,
    "segs": [ {
      "utf8": "So go on now, and be one of them."
    } ]
  } ]
}
