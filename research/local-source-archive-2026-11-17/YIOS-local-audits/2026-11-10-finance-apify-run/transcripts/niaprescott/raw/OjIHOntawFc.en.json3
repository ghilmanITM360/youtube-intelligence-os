{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 3582,
    "segs": [ {
      "utf8": "There are five bills that the government itself says"
    } ]
  }, {
    "tStartMs": 3582,
    "dDurationMs": 2581,
    "segs": [ {
      "utf8": "you may no longer have to pay once you"
    } ]
  }, {
    "tStartMs": 6163,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "turn sixty five."
    } ]
  }, {
    "tStartMs": 7944,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "Not a smaller amount."
    } ]
  }, {
    "tStartMs": 9764,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "Not a discount shaved off the top."
    } ]
  }, {
    "tStartMs": 12486,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "The whole bill, gone, wiped away by a rule"
    } ]
  }, {
    "tStartMs": 15947,
    "dDurationMs": 3262,
    "segs": [ {
      "utf8": "that already exists and already has your name on"
    } ]
  }, {
    "tStartMs": 19209,
    "dDurationMs": 340,
    "segs": [ {
      "utf8": "it."
    } ]
  }, {
    "tStartMs": 19869,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "And here is the part that should make you"
    } ]
  }, {
    "tStartMs": 22170,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "angry."
    } ]
  }, {
    "tStartMs": 23250,
    "dDurationMs": 2342,
    "segs": [ {
      "utf8": "Nobody whose job it is to collect that money"
    } ]
  }, {
    "tStartMs": 25592,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "from you has the slightest reason to pick up"
    } ]
  }, {
    "tStartMs": 28573,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "the phone and tell you that you are allowed"
    } ]
  }, {
    "tStartMs": 30794,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "to stop."
    } ]
  }, {
    "tStartMs": 31934,
    "dDurationMs": 1561,
    "segs": [ {
      "utf8": "The hospital will not tell you."
    } ]
  }, {
    "tStartMs": 33855,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "The county will not tell you."
    } ]
  }, {
    "tStartMs": 35736,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "Not even the government office that runs the program"
    } ]
  }, {
    "tStartMs": 38357,
    "dDurationMs": 1781,
    "segs": [ {
      "utf8": "will call to say you qualify."
    } ]
  }, {
    "tStartMs": 41018,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "It is all left sitting there,"
    } ]
  }, {
    "tStartMs": 42739,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "quietly, in the hope that you will keep on"
    } ]
  }, {
    "tStartMs": 45801,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "paying out of a lifetime of habit."
    } ]
  }, {
    "tStartMs": 48322,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Thank you for stopping here,"
    } ]
  }, {
    "tStartMs": 49982,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "because most people scroll right past a video like"
    } ]
  }, {
    "tStartMs": 53144,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "this, and it quietly costs them thousands."
    } ]
  }, {
    "tStartMs": 56966,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "So today I am going to walk you through"
    } ]
  }, {
    "tStartMs": 59187,
    "dDurationMs": 1040,
    "segs": [ {
      "utf8": "all five."
    } ]
  }, {
    "tStartMs": 60667,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "Exactly which ones, who qualifies,"
    } ]
  }, {
    "tStartMs": 63248,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "and the one quiet mistake that keeps this money"
    } ]
  }, {
    "tStartMs": 66050,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "draining out of your account year after year."
    } ]
  }, {
    "tStartMs": 69471,
    "dDurationMs": 1841,
    "segs": [ {
      "utf8": "Stay with me all the way to the end,"
    } ]
  }, {
    "tStartMs": 71312,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "because the last one is the largest of them"
    } ]
  }, {
    "tStartMs": 73933,
    "dDurationMs": 3282,
    "segs": [ {
      "utf8": "all, and it is the one almost nobody has"
    } ]
  }, {
    "tStartMs": 77215,
    "dDurationMs": 800,
    "segs": [ {
      "utf8": "ever heard of."
    } ]
  }, {
    "tStartMs": 78315,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "The first one is a hospital bill."
    } ]
  }, {
    "tStartMs": 81217,
    "dDurationMs": 3161,
    "segs": [ {
      "utf8": "Most of the hospitals in this country are nonprofit"
    } ]
  }, {
    "tStartMs": 84378,
    "dDurationMs": 3642,
    "segs": [ {
      "utf8": "hospitals, and in exchange for paying no taxes at"
    } ]
  }, {
    "tStartMs": 88020,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "all, the law requires every one of them to"
    } ]
  }, {
    "tStartMs": 91201,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "run a program that forgives the bills of patients"
    } ]
  }, {
    "tStartMs": 93982,
    "dDurationMs": 1141,
    "segs": [ {
      "utf8": "whose income is modest."
    } ]
  }, {
    "tStartMs": 95823,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "It is not charity in the way you are"
    } ]
  }, {
    "tStartMs": 97844,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "picturing it, and it is not a favor."
    } ]
  }, {
    "tStartMs": 101025,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "It is a condition of the enormous tax break"
    } ]
  }, {
    "tStartMs": 103847,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "the hospital receives every single year."
    } ]
  }, {
    "tStartMs": 107108,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "If your income is below a certain line,"
    } ]
  }, {
    "tStartMs": 109089,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "and that line is far more generous than most"
    } ]
  }, {
    "tStartMs": 111690,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "people expect, the hospital must reduce your bill,"
    } ]
  }, {
    "tStartMs": 115312,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "and in a great many cases it must erase"
    } ]
  }, {
    "tStartMs": 118153,
    "dDurationMs": 1161,
    "segs": [ {
      "utf8": "the entire thing."
    } ]
  }, {
    "tStartMs": 119814,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "This is true whether you have insurance or not,"
    } ]
  }, {
    "tStartMs": 122495,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "because even an insured senior can be left with"
    } ]
  }, {
    "tStartMs": 125496,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "thousands of dollars that Medicare did not cover."
    } ]
  }, {
    "tStartMs": 129098,
    "dDurationMs": 1141,
    "segs": [ {
      "utf8": "But here is the catch,"
    } ]
  }, {
    "tStartMs": 130699,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "the same catch that runs through all five of"
    } ]
  }, {
    "tStartMs": 133240,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "these."
    } ]
  }, {
    "tStartMs": 134200,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "The hospital does not have to offer it to"
    } ]
  }, {
    "tStartMs": 136421,
    "dDurationMs": 381,
    "segs": [ {
      "utf8": "you."
    } ]
  }, {
    "tStartMs": 137062,
    "dDurationMs": 1901,
    "segs": [ {
      "utf8": "You have to ask for it by name."
    } ]
  }, {
    "tStartMs": 139363,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "You call the billing department and you say,"
    } ]
  }, {
    "tStartMs": 142024,
    "dDurationMs": 2721,
    "segs": [ {
      "utf8": "I want to apply for your financial assistance program,"
    } ]
  }, {
    "tStartMs": 145285,
    "dDurationMs": 2582,
    "segs": [ {
      "utf8": "and by law they must hand you the application."
    } ]
  }, {
    "tStartMs": 148687,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "To give you a sense of how wide this"
    } ]
  }, {
    "tStartMs": 151028,
    "dDurationMs": 4462,
    "segs": [ {
      "utf8": "reaches, at many hospitals a single person earning under"
    } ]
  }, {
    "tStartMs": 155490,
    "dDurationMs": 2161,
    "segs": [ {
      "utf8": "roughly thirty thousand dollars a year,"
    } ]
  }, {
    "tStartMs": 157651,
    "dDurationMs": 3361,
    "segs": [ {
      "utf8": "or a couple under about forty thousand,"
    } ]
  }, {
    "tStartMs": 161012,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "can have the entire bill wiped away,"
    } ]
  }, {
    "tStartMs": 164214,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "and even well above those numbers the bill is"
    } ]
  }, {
    "tStartMs": 166875,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "often cut by half or more."
    } ]
  }, {
    "tStartMs": 168596,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "Picture a woman who spends five days in the"
    } ]
  }, {
    "tStartMs": 171677,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "hospital and comes home to a bill for thirty"
    } ]
  }, {
    "tStartMs": 174739,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "thousand dollars that she has no idea how she"
    } ]
  }, {
    "tStartMs": 177700,
    "dDurationMs": 740,
    "segs": [ {
      "utf8": "will ever pay."
    } ]
  }, {
    "tStartMs": 179061,
    "dDurationMs": 3121,
    "segs": [ {
      "utf8": "She may never learn that the hospital was required,"
    } ]
  }, {
    "tStartMs": 182182,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "by the terms of its own tax break,"
    } ]
  }, {
    "tStartMs": 184283,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "to erase most or all of it,"
    } ]
  }, {
    "tStartMs": 186884,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "if only she had asked."
    } ]
  }, {
    "tStartMs": 188665,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "So the bill sits on her kitchen table,"
    } ]
  }, {
    "tStartMs": 190766,
    "dDurationMs": 3521,
    "segs": [ {
      "utf8": "and she quietly starts skipping her own medicine to"
    } ]
  }, {
    "tStartMs": 194287,
    "dDurationMs": 2542,
    "segs": [ {
      "utf8": "make the payments, on a debt she may never"
    } ]
  }, {
    "tStartMs": 196829,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "have owed at all."
    } ]
  }, {
    "tStartMs": 197829,
    "dDurationMs": 3301,
    "segs": [ {
      "utf8": "The second one is what you hand over at"
    } ]
  }, {
    "tStartMs": 201130,
    "dDurationMs": 1081,
    "segs": [ {
      "utf8": "the pharmacy counter."
    } ]
  }, {
    "tStartMs": 202991,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "As of this year, there is now a hard"
    } ]
  }, {
    "tStartMs": 205232,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "limit, written into federal law,"
    } ]
  }, {
    "tStartMs": 207373,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "on how much you can be made to pay"
    } ]
  }, {
    "tStartMs": 209594,
    "dDurationMs": 2842,
    "segs": [ {
      "utf8": "out of your own pocket for your covered prescriptions"
    } ]
  }, {
    "tStartMs": 212436,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "in a single year."
    } ]
  }, {
    "tStartMs": 214276,
    "dDurationMs": 3302,
    "segs": [ {
      "utf8": "That limit is two thousand one hundred dollars."
    } ]
  }, {
    "tStartMs": 217578,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "Once your spending on covered medications reaches that number,"
    } ]
  }, {
    "tStartMs": 221119,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "you are finished for the rest of the year,"
    } ]
  }, {
    "tStartMs": 223200,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "and your drug plan must pay the entire cost"
    } ]
  }, {
    "tStartMs": 225962,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "of everything after that."
    } ]
  }, {
    "tStartMs": 228223,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "For someone taking an expensive medication for cancer,"
    } ]
  }, {
    "tStartMs": 231164,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "or for a heart condition,"
    } ]
  }, {
    "tStartMs": 233185,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "the kind of drug that used to cost people"
    } ]
  }, {
    "tStartMs": 235106,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "ten or fifteen thousand dollars a year,"
    } ]
  }, {
    "tStartMs": 237807,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "that can no longer happen to you."
    } ]
  }, {
    "tStartMs": 239988,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "The government capped it."
    } ]
  }, {
    "tStartMs": 242009,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "And there is a second step almost nobody uses."
    } ]
  }, {
    "tStartMs": 245610,
    "dDurationMs": 2782,
    "segs": [ {
      "utf8": "You can ask your drug plan to spread that"
    } ]
  }, {
    "tStartMs": 248392,
    "dDurationMs": 3501,
    "segs": [ {
      "utf8": "amount across the whole year in small monthly pieces,"
    } ]
  }, {
    "tStartMs": 251893,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "so it never lands on you all at once."
    } ]
  }, {
    "tStartMs": 255455,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "Think for a moment about what this used to"
    } ]
  }, {
    "tStartMs": 257536,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "mean."
    } ]
  }, {
    "tStartMs": 258676,
    "dDurationMs": 2822,
    "segs": [ {
      "utf8": "Before this cap existed, a senior on a fixed"
    } ]
  }, {
    "tStartMs": 261498,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "income could open the mailbox and find a pharmacy"
    } ]
  }, {
    "tStartMs": 264699,
    "dDurationMs": 3161,
    "segs": [ {
      "utf8": "bill for eight thousand dollars for a single cancer"
    } ]
  }, {
    "tStartMs": 267860,
    "dDurationMs": 3042,
    "segs": [ {
      "utf8": "drug, and be forced to choose between the medicine"
    } ]
  }, {
    "tStartMs": 270902,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "keeping her alive and the money she needed to"
    } ]
  }, {
    "tStartMs": 273583,
    "dDurationMs": 260,
    "segs": [ {
      "utf8": "eat."
    } ]
  }, {
    "tStartMs": 274403,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "That cruel choice is now gone."
    } ]
  }, {
    "tStartMs": 277085,
    "dDurationMs": 2101,
    "segs": [ {
      "utf8": "The law drew a line and said,"
    } ]
  }, {
    "tStartMs": 279726,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "no further."
    } ]
  }, {
    "tStartMs": 280846,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "But your plan will not send you a letter"
    } ]
  }, {
    "tStartMs": 282827,
    "dDurationMs": 1061,
    "segs": [ {
      "utf8": "celebrating it."
    } ]
  }, {
    "tStartMs": 283888,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "You have to know the line is there,"
    } ]
  }, {
    "tStartMs": 286209,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "and know that once you cross it,"
    } ]
  }, {
    "tStartMs": 288390,
    "dDurationMs": 1360,
    "segs": [ {
      "utf8": "you can stop worrying."
    } ]
  }, {
    "tStartMs": 290511,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "The third one is the largest bill most homeowners"
    } ]
  }, {
    "tStartMs": 293932,
    "dDurationMs": 3402,
    "segs": [ {
      "utf8": "face all year, and that is your property tax."
    } ]
  }, {
    "tStartMs": 298034,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "Now you may have heard that seniors can freeze"
    } ]
  }, {
    "tStartMs": 300575,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "their property tax, or take an exemption to lower"
    } ]
  }, {
    "tStartMs": 303737,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "it."
    } ]
  }, {
    "tStartMs": 304617,
    "dDurationMs": 4222,
    "segs": [ {
      "utf8": "This is something different, and far more powerful for"
    } ]
  }, {
    "tStartMs": 308839,
    "dDurationMs": 1641,
    "segs": [ {
      "utf8": "anyone who is truly stretched."
    } ]
  }, {
    "tStartMs": 311200,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "In most states, once you reach sixty five,"
    } ]
  }, {
    "tStartMs": 314521,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "you can apply to defer your property tax entirely."
    } ]
  }, {
    "tStartMs": 318443,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "To defer it means you do not pay it"
    } ]
  }, {
    "tStartMs": 320524,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "now at all."
    } ]
  }, {
    "tStartMs": 321505,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Not a reduced amount."
    } ]
  }, {
    "tStartMs": 323065,
    "dDurationMs": 641,
    "segs": [ {
      "utf8": "None of it."
    } ]
  }, {
    "tStartMs": 324106,
    "dDurationMs": 2741,
    "segs": [ {
      "utf8": "The state quietly steps in and pays the bill"
    } ]
  }, {
    "tStartMs": 326847,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "for you, year after year,"
    } ]
  }, {
    "tStartMs": 328808,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "and simply records what it has paid as a"
    } ]
  }, {
    "tStartMs": 331849,
    "dDurationMs": 3262,
    "segs": [ {
      "utf8": "line against your home, to be settled much later,"
    } ]
  }, {
    "tStartMs": 335111,
    "dDurationMs": 3261,
    "segs": [ {
      "utf8": "when the house is eventually sold or passes to"
    } ]
  }, {
    "tStartMs": 338372,
    "dDurationMs": 2882,
    "segs": [ {
      "utf8": "your family, usually with a low rate of interest"
    } ]
  }, {
    "tStartMs": 341254,
    "dDurationMs": 3821,
    "segs": [ {
      "utf8": "that in most states does not climb above five"
    } ]
  }, {
    "tStartMs": 345075,
    "dDurationMs": 50,
    "segs": [ {
      "utf8": "percent."
    } ]
  }, {
    "tStartMs": 345125,
    "dDurationMs": 2992,
    "segs": [ {
      "utf8": "For a senior on a fixed income being crushed"
    } ]
  }, {
    "tStartMs": 348117,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "by a property tax bill of three,"
    } ]
  }, {
    "tStartMs": 350117,
    "dDurationMs": 2121,
    "segs": [ {
      "utf8": "four, or five thousand dollars a year,"
    } ]
  }, {
    "tStartMs": 352699,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "that is money that stays in your own pocket"
    } ]
  }, {
    "tStartMs": 354920,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "for the rest of your life in that home."
    } ]
  }, {
    "tStartMs": 357641,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "And like all the others,"
    } ]
  }, {
    "tStartMs": 359202,
    "dDurationMs": 1240,
    "segs": [ {
      "utf8": "it is never automatic."
    } ]
  }, {
    "tStartMs": 361042,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "You apply for it through your county,"
    } ]
  }, {
    "tStartMs": 362843,
    "dDurationMs": 1521,
    "segs": [ {
      "utf8": "and you have to ask."
    } ]
  }, {
    "tStartMs": 364924,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "Let me put a real face on it."
    } ]
  }, {
    "tStartMs": 366665,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "Picture a widower in his late seventies who has"
    } ]
  }, {
    "tStartMs": 369906,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "lived in the same paid off house for forty"
    } ]
  }, {
    "tStartMs": 372047,
    "dDurationMs": 2722,
    "segs": [ {
      "utf8": "years, the house where he raised his children."
    } ]
  }, {
    "tStartMs": 375449,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "His only income now is his Social Security check,"
    } ]
  }, {
    "tStartMs": 378550,
    "dDurationMs": 3282,
    "segs": [ {
      "utf8": "and the property tax has climbed to five thousand"
    } ]
  }, {
    "tStartMs": 381832,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "dollars a year, more than a month and a"
    } ]
  }, {
    "tStartMs": 383853,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "half of everything he receives."
    } ]
  }, {
    "tStartMs": 386094,
    "dDurationMs": 3261,
    "segs": [ {
      "utf8": "Every year he grows a little more afraid of"
    } ]
  }, {
    "tStartMs": 389355,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "losing the home he already owns,"
    } ]
  }, {
    "tStartMs": 391436,
    "dDurationMs": 2181,
    "segs": [ {
      "utf8": "over a bill for taxes."
    } ]
  }, {
    "tStartMs": 394267,
    "dDurationMs": 2271,
    "segs": [ {
      "utf8": "If he simply applied to defer it,"
    } ]
  }, {
    "tStartMs": 396738,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "the state would carry that bill for him,"
    } ]
  }, {
    "tStartMs": 398999,
    "dDurationMs": 2622,
    "segs": [ {
      "utf8": "quietly, for the rest of his life in that"
    } ]
  }, {
    "tStartMs": 401621,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "home, and the fear would be gone."
    } ]
  }, {
    "tStartMs": 404462,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "But no one at the county has ever once"
    } ]
  }, {
    "tStartMs": 407123,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "told him the program exists."
    } ]
  }, {
    "tStartMs": 409604,
    "dDurationMs": 3542,
    "segs": [ {
      "utf8": "The fourth one is a protection so strong that"
    } ]
  }, {
    "tStartMs": 413146,
    "dDurationMs": 2581,
    "segs": [ {
      "utf8": "almost no one believes it is real until they"
    } ]
  }, {
    "tStartMs": 415727,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "see it in writing."
    } ]
  }, {
    "tStartMs": 417328,
    "dDurationMs": 2741,
    "segs": [ {
      "utf8": "There is a program, run by your own state,"
    } ]
  }, {
    "tStartMs": 420069,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "called the Qualified Medicare Beneficiary program."
    } ]
  }, {
    "tStartMs": 424371,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "If your income is modest and you qualify for"
    } ]
  }, {
    "tStartMs": 426832,
    "dDurationMs": 1461,
    "segs": [ {
      "utf8": "it, two things happen."
    } ]
  }, {
    "tStartMs": 428853,
    "dDurationMs": 2581,
    "segs": [ {
      "utf8": "The state pays your Medicare costs for you,"
    } ]
  }, {
    "tStartMs": 431434,
    "dDurationMs": 2621,
    "segs": [ {
      "utf8": "and, this is the part that stuns people,"
    } ]
  }, {
    "tStartMs": 434535,
    "dDurationMs": 2842,
    "segs": [ {
      "utf8": "it becomes against federal law for a doctor,"
    } ]
  }, {
    "tStartMs": 437797,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "a hospital, or a pharmacy to bill you for"
    } ]
  }, {
    "tStartMs": 440578,
    "dDurationMs": 4142,
    "segs": [ {
      "utf8": "the deductibles, the copays, or the coinsurance that Medicare"
    } ]
  }, {
    "tStartMs": 444720,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "would normally leave you to pay."
    } ]
  }, {
    "tStartMs": 447741,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "Against the law."
    } ]
  }, {
    "tStartMs": 449242,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "If you are in this program and a provider"
    } ]
  }, {
    "tStartMs": 450743,
    "dDurationMs": 860,
    "segs": [ {
      "utf8": "sends you a bill for those costs,"
    } ]
  }, {
    "tStartMs": 452003,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "they have broken federal law,"
    } ]
  }, {
    "tStartMs": 453944,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "and you do not owe it."
    } ]
  }, {
    "tStartMs": 456565,
    "dDurationMs": 3442,
    "segs": [ {
      "utf8": "Congress wrote this protection decades ago and strengthened it"
    } ]
  }, {
    "tStartMs": 460007,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "again in recent years, and it is fully in"
    } ]
  }, {
    "tStartMs": 462708,
    "dDurationMs": 1341,
    "segs": [ {
      "utf8": "force right now."
    } ]
  }, {
    "tStartMs": 464409,
    "dDurationMs": 3221,
    "segs": [ {
      "utf8": "Yet doctors' offices send these bills by mistake all"
    } ]
  }, {
    "tStartMs": 467630,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "the time, and the people who receive them,"
    } ]
  }, {
    "tStartMs": 470151,
    "dDurationMs": 3422,
    "segs": [ {
      "utf8": "not knowing the law, quietly pay for costs they"
    } ]
  }, {
    "tStartMs": 473573,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "never owed a single cent of."
    } ]
  }, {
    "tStartMs": 476294,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "So how do you know if this is you."
    } ]
  }, {
    "tStartMs": 479116,
    "dDurationMs": 1620,
    "segs": [ {
      "utf8": "The income limits are modest,"
    } ]
  }, {
    "tStartMs": 481236,
    "dDurationMs": 3262,
    "segs": [ {
      "utf8": "aimed at seniors living mostly on Social Security and"
    } ]
  }, {
    "tStartMs": 484498,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "a small amount on top,"
    } ]
  }, {
    "tStartMs": 485859,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "and they rise a little each year,"
    } ]
  }, {
    "tStartMs": 487899,
    "dDurationMs": 2602,
    "segs": [ {
      "utf8": "so the honest mistake is to assume you earn"
    } ]
  }, {
    "tStartMs": 490501,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "too much and never even check."
    } ]
  }, {
    "tStartMs": 493222,
    "dDurationMs": 1300,
    "segs": [ {
      "utf8": "You apply through your state,"
    } ]
  }, {
    "tStartMs": 495003,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "the same office that handles Medicaid."
    } ]
  }, {
    "tStartMs": 497564,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "And if you are already in the program and"
    } ]
  }, {
    "tStartMs": 500565,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "you find a stack of old medical bills that"
    } ]
  }, {
    "tStartMs": 502886,
    "dDurationMs": 3302,
    "segs": [ {
      "utf8": "you paid, bills you now realize a provider was"
    } ]
  }, {
    "tStartMs": 506188,
    "dDurationMs": 1440,
    "segs": [ {
      "utf8": "never allowed to send you,"
    } ]
  }, {
    "tStartMs": 508189,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "you have the right to go back and ask"
    } ]
  }, {
    "tStartMs": 510230,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "for that money to be returned to you."
    } ]
  }, {
    "tStartMs": 512050,
    "dDurationMs": 3042,
    "segs": [ {
      "utf8": "And the fifth one, the largest of them all,"
    } ]
  }, {
    "tStartMs": 515092,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "and the one almost nobody has heard of."
    } ]
  }, {
    "tStartMs": 517953,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "This one is only for some of you,"
    } ]
  }, {
    "tStartMs": 519694,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "but if it is you,"
    } ]
  }, {
    "tStartMs": 521114,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "it can be worth more than every other item"
    } ]
  }, {
    "tStartMs": 523395,
    "dDurationMs": 1861,
    "segs": [ {
      "utf8": "on this whole list combined."
    } ]
  }, {
    "tStartMs": 525857,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "If you served in the military during a time"
    } ]
  }, {
    "tStartMs": 528298,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "of war, or if you are the surviving husband"
    } ]
  }, {
    "tStartMs": 530999,
    "dDurationMs": 1521,
    "segs": [ {
      "utf8": "or wife of someone who did,"
    } ]
  }, {
    "tStartMs": 532880,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "there is a benefit from the Department of Veterans"
    } ]
  }, {
    "tStartMs": 535361,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "Affairs called Aid and Attendance."
    } ]
  }, {
    "tStartMs": 537562,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "And it is not small."
    } ]
  }, {
    "tStartMs": 540143,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "In this year it can pay a single veteran"
    } ]
  }, {
    "tStartMs": 543324,
    "dDurationMs": 3402,
    "segs": [ {
      "utf8": "more than two thousand four hundred dollars every single"
    } ]
  }, {
    "tStartMs": 546726,
    "dDurationMs": 360,
    "segs": [ {
      "utf8": "month."
    } ]
  }, {
    "tStartMs": 547826,
    "dDurationMs": 3232,
    "segs": [ {
      "utf8": "It can pay a surviving spouse more than fifteen"
    } ]
  }, {
    "tStartMs": 551058,
    "dDurationMs": 1170,
    "segs": [ {
      "utf8": "hundred dollars a month."
    } ]
  }, {
    "tStartMs": 552709,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "And for a married veteran it climbs higher still,"
    } ]
  }, {
    "tStartMs": 556170,
    "dDurationMs": 2821,
    "segs": [ {
      "utf8": "toward two thousand nine hundred dollars a month."
    } ]
  }, {
    "tStartMs": 559702,
    "dDurationMs": 1851,
    "segs": [ {
      "utf8": "That money is tax free,"
    } ]
  }, {
    "tStartMs": 561553,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "and it arrives every month for the rest of"
    } ]
  }, {
    "tStartMs": 564414,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "your life."
    } ]
  }, {
    "tStartMs": 565694,
    "dDurationMs": 2422,
    "segs": [ {
      "utf8": "It is meant for older veterans and their spouses"
    } ]
  }, {
    "tStartMs": 568116,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "who need help with the ordinary tasks of daily"
    } ]
  }, {
    "tStartMs": 571457,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "living."
    } ]
  }, {
    "tStartMs": 572317,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "You do not have to have been wounded,"
    } ]
  }, {
    "tStartMs": 574518,
    "dDurationMs": 2482,
    "segs": [ {
      "utf8": "and you do not have to have seen combat."
    } ]
  }, {
    "tStartMs": 577500,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "You only have to have served during a recognized"
    } ]
  }, {
    "tStartMs": 579901,
    "dDurationMs": 3221,
    "segs": [ {
      "utf8": "wartime period and to meet the care and income"
    } ]
  }, {
    "tStartMs": 583122,
    "dDurationMs": 521,
    "segs": [ {
      "utf8": "tests."
    } ]
  }, {
    "tStartMs": 584443,
    "dDurationMs": 3121,
    "segs": [ {
      "utf8": "Hundreds of thousands of veterans and widows who qualify"
    } ]
  }, {
    "tStartMs": 587564,
    "dDurationMs": 2421,
    "segs": [ {
      "utf8": "for this money have never once applied,"
    } ]
  }, {
    "tStartMs": 589985,
    "dDurationMs": 3242,
    "segs": [ {
      "utf8": "simply because no one ever told them it exists."
    } ]
  }, {
    "tStartMs": 593907,
    "dDurationMs": 2421,
    "segs": [ {
      "utf8": "I think of the widows most of all."
    } ]
  }, {
    "tStartMs": 597149,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "A woman whose husband served in a war a"
    } ]
  }, {
    "tStartMs": 599810,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "lifetime ago, who is now paying out of her"
    } ]
  }, {
    "tStartMs": 602671,
    "dDurationMs": 3202,
    "segs": [ {
      "utf8": "thin savings for the help she needs just to"
    } ]
  }, {
    "tStartMs": 605873,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "bathe and dress and cook,"
    } ]
  }, {
    "tStartMs": 607433,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "with no idea that the government owes her more"
    } ]
  }, {
    "tStartMs": 610415,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "than fifteen hundred dollars a month for exactly that"
    } ]
  }, {
    "tStartMs": 613596,
    "dDurationMs": 2421,
    "segs": [ {
      "utf8": "care, because of what her husband did in his"
    } ]
  }, {
    "tStartMs": 616017,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "twenties."
    } ]
  }, {
    "tStartMs": 617598,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "That money would change her entire life,"
    } ]
  }, {
    "tStartMs": 619799,
    "dDurationMs": 1841,
    "segs": [ {
      "utf8": "and it has been sitting there,"
    } ]
  }, {
    "tStartMs": 621640,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "unclaimed, the whole time."
    } ]
  }, {
    "tStartMs": 624181,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "If that is you, or your mother,"
    } ]
  }, {
    "tStartMs": 626102,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "or a widow you know from church,"
    } ]
  }, {
    "tStartMs": 628643,
    "dDurationMs": 2821,
    "segs": [ {
      "utf8": "that one phone call is worth making today."
    } ]
  }, {
    "tStartMs": 632565,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "Now step back and look at what all five"
    } ]
  }, {
    "tStartMs": 635486,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "of these share, because it is the whole reason"
    } ]
  }, {
    "tStartMs": 637947,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "they stay hidden in plain sight."
    } ]
  }, {
    "tStartMs": 640348,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "Not one of them switches itself on."
    } ]
  }, {
    "tStartMs": 642809,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "The hospital will not erase your bill until you"
    } ]
  }, {
    "tStartMs": 645650,
    "dDurationMs": 381,
    "segs": [ {
      "utf8": "ask."
    } ]
  }, {
    "tStartMs": 646571,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "The pharmacy will not remind you that your costs"
    } ]
  }, {
    "tStartMs": 648832,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "are capped."
    } ]
  }, {
    "tStartMs": 650192,
    "dDurationMs": 2342,
    "segs": [ {
      "utf8": "The county will not knock on your door and"
    } ]
  }, {
    "tStartMs": 652534,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "offer to pause your property tax."
    } ]
  }, {
    "tStartMs": 654935,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "The doctor who is breaking the law by billing"
    } ]
  }, {
    "tStartMs": 657736,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "you will not confess it."
    } ]
  }, {
    "tStartMs": 660057,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "And the Department of Veterans Affairs will not call"
    } ]
  }, {
    "tStartMs": 663739,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "a widow to tell her she has been owed"
    } ]
  }, {
    "tStartMs": 666100,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "two thousand dollars a month for years."
    } ]
  }, {
    "tStartMs": 669761,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "Every one of these was written into the law"
    } ]
  }, {
    "tStartMs": 672102,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "to help you, and every one was wrapped in"
    } ]
  }, {
    "tStartMs": 675264,
    "dDurationMs": 3441,
    "segs": [ {
      "utf8": "just enough silence that most people never claim it."
    } ]
  }, {
    "tStartMs": 679206,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "The government is not exactly lying to you."
    } ]
  }, {
    "tStartMs": 682027,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "It is simply counting on you to stay quiet,"
    } ]
  }, {
    "tStartMs": 685068,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "and to keep paying."
    } ]
  }, {
    "tStartMs": 687489,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "So here is what I want you to do,"
    } ]
  }, {
    "tStartMs": 689890,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "and it is not a someday task,"
    } ]
  }, {
    "tStartMs": 692552,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "it is a this week task."
    } ]
  }, {
    "tStartMs": 694853,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "Pick the one that fits your life and go"
    } ]
  }, {
    "tStartMs": 697334,
    "dDurationMs": 920,
    "segs": [ {
      "utf8": "and claim it."
    } ]
  }, {
    "tStartMs": 698614,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "If you are holding a hospital bill,"
    } ]
  }, {
    "tStartMs": 700855,
    "dDurationMs": 4542,
    "segs": [ {
      "utf8": "call and say the words financial assistance program before"
    } ]
  }, {
    "tStartMs": 705397,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "you pay a cent of it."
    } ]
  }, {
    "tStartMs": 707318,
    "dDurationMs": 2501,
    "segs": [ {
      "utf8": "If your property tax is crushing you,"
    } ]
  }, {
    "tStartMs": 709919,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "call your county and ask about deferring it."
    } ]
  }, {
    "tStartMs": 713161,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "And if you, or your husband or wife,"
    } ]
  }, {
    "tStartMs": 715482,
    "dDurationMs": 2181,
    "segs": [ {
      "utf8": "ever served in a time of war,"
    } ]
  }, {
    "tStartMs": 718063,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "make the call about Aid and Attendance,"
    } ]
  }, {
    "tStartMs": 720384,
    "dDurationMs": 3542,
    "segs": [ {
      "utf8": "because that single phone call has been worth tens"
    } ]
  }, {
    "tStartMs": 723926,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "of thousands of dollars to people exactly like you."
    } ]
  }, {
    "tStartMs": 728188,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "You do not have to chase all five at"
    } ]
  }, {
    "tStartMs": 730829,
    "dDurationMs": 1861,
    "segs": [ {
      "utf8": "once and wear yourself out."
    } ]
  }, {
    "tStartMs": 733290,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "You only have to open one door,"
    } ]
  }, {
    "tStartMs": 735031,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "because behind every one of them is money that"
    } ]
  }, {
    "tStartMs": 737992,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "was yours the whole time,"
    } ]
  }, {
    "tStartMs": 740093,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "quietly kept just out of your reach by a"
    } ]
  }, {
    "tStartMs": 742554,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "system that was hoping you would never ask."
    } ]
  }, {
    "tStartMs": 745275,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "So ask."
    } ]
  }, {
    "tStartMs": 746076,
    "dDurationMs": 3201,
    "segs": [ {
      "utf8": "And then let yourself feel what it is to"
    } ]
  }, {
    "tStartMs": 749277,
    "dDurationMs": 3141,
    "segs": [ {
      "utf8": "finally take back something that was always meant to"
    } ]
  }, {
    "tStartMs": 752418,
    "dDurationMs": 521,
    "segs": [ {
      "utf8": "be yours."
    } ]
  } ]
}
