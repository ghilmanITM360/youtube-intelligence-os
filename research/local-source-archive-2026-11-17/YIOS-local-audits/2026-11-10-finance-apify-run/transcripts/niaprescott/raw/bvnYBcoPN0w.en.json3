{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "The bank sends one form about you to the\ntax office each year."
    } ]
  }, {
    "tStartMs": 4680,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "It is a single page. It says how much\ninterest your money earned."
    } ]
  }, {
    "tStartMs": 9400,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Ten dollars, forty dollars, whatever it\nwas."
    } ]
  }, {
    "tStartMs": 12780,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "That is the whole of it. Nowhere on that\npage is the number that is actually"
    } ]
  }, {
    "tStartMs": 17540,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "in your account, and there is no second\nform that carries it."
    } ]
  }, {
    "tStartMs": 22000,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Nobody has told you this, because the not\ntelling is worth money."
    } ]
  }, {
    "tStartMs": 25760,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "Fear about your own bank account sells\nguides and courses and videos, and the"
    } ]
  }, {
    "tStartMs": 31120,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "people selling them need you to believe\nthat somebody is reading your balance."
    } ]
  }, {
    "tStartMs": 35840,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "Four things sit in your account right now\nthat are never reported to anyone."
    } ]
  }, {
    "tStartMs": 39980,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Not the balance. Not a check of any size."
    } ]
  }, {
    "tStartMs": 42940,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Not money your family gives you."
    } ]
  }, {
    "tStartMs": 45020,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Not what your daughter sends through her\nphone."
    } ]
  }, {
    "tStartMs": 47560,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "This is each one, and what believing the\nopposite has already cost you."
    } ]
  }, {
    "tStartMs": 52140,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Number one is the amount of money sitting\nin your account."
    } ]
  }, {
    "tStartMs": 54900,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Say you have eighty thousand dollars in\nsavings."
    } ]
  }, {
    "tStartMs": 58560,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "You have had it a long time. You worry\nabout it, and part of the worry is a"
    } ]
  }, {
    "tStartMs": 63060,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "feeling that somebody official knows it is\nthere and is thinking about it."
    } ]
  }, {
    "tStartMs": 67240,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Nobody knows it is there. There is no\nreport."
    } ]
  }, {
    "tStartMs": 70280,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "There is no file. The bank does not send a\nyearly statement of your balance"
    } ]
  }, {
    "tStartMs": 74480,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "to the tax office and there is no law that\nasks it to."
    } ]
  }, {
    "tStartMs": 78260,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "What the bank does send is one small form,\nonce a year, and it is triggered"
    } ]
  }, {
    "tStartMs": 82740,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "by ten dollars. If your money earned ten\ndollars or more in interest across"
    } ]
  }, {
    "tStartMs": 87100,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "the year, the bank must send that form."
    } ]
  }, {
    "tStartMs": 90140,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "Below ten dollars, it does not even have\nto do that."
    } ]
  }, {
    "tStartMs": 93240,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "And look at what is printed on it."
    } ]
  }, {
    "tStartMs": 95100,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "The amount of interest. That is the number\nthe tax office receives."
    } ]
  }, {
    "tStartMs": 99500,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "Eighty thousand dollars sitting in an"
    } ]
  }, {
    "tStartMs": 101160,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "account earning half of one percent\nproduces"
    } ]
  }, {
    "tStartMs": 103880,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "a form that says four hundred dollars."
    } ]
  }, {
    "tStartMs": 106360,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "The eighty thousand does not appear\nanywhere on it."
    } ]
  }, {
    "tStartMs": 109600,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "So the tax office knows what your money\nearned."
    } ]
  }, {
    "tStartMs": 112640,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "It does not know what your money is."
    } ]
  }, {
    "tStartMs": 115840,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "Those are two completely different facts\nand almost everybody has them mixed"
    } ]
  }, {
    "tStartMs": 119880,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "up."
    } ]
  }, {
    "tStartMs": 121100,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "Now think about what that mix up has cost\npeople."
    } ]
  }, {
    "tStartMs": 124440,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "I have heard from someone who kept eleven\nthousand dollars in cash in the house"
    } ]
  }, {
    "tStartMs": 128360,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "for two years because they did not want a\nbank to know they had it."
    } ]
  }, {
    "tStartMs": 133900,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "Two years of a burglary risk, two years of\nfire risk, and not one dollar of"
    } ]
  }, {
    "tStartMs": 139180,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "insurance on any of it, all to hide a\nnumber from a form that was never printed."
    } ]
  }, {
    "tStartMs": 144960,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "I have heard from someone who refused to\nmove their savings to an account paying"
    } ]
  }, {
    "tStartMs": 149300,
    "dDurationMs": 3280,
    "segs": [ {
      "utf8": "better interest, because moving it felt\nlike being noticed."
    } ]
  }, {
    "tStartMs": 153240,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "They lost several hundred dollars a year\nin interest for nothing."
    } ]
  }, {
    "tStartMs": 157420,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "And some people do the most damaging thing\nof all, which is to divide a deposit"
    } ]
  }, {
    "tStartMs": 162380,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "into smaller pieces so it looks smaller\ngoing in."
    } ]
  }, {
    "tStartMs": 166440,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "That one is not just pointless."
    } ]
  }, {
    "tStartMs": 168800,
    "dDurationMs": 4640,
    "segs": [ {
      "utf8": "It is against the law in its own right,\nand people have been prosecuted over"
    } ]
  }, {
    "tStartMs": 173440,
    "dDurationMs": 1700,
    "segs": [ {
      "utf8": "money that was completely honest."
    } ]
  }, {
    "tStartMs": 175600,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Every one of those decisions came from the\nsame wrong belief."
    } ]
  }, {
    "tStartMs": 180440,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Somebody is watching the balance."
    } ]
  }, {
    "tStartMs": 182480,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Nobody is watching the balance."
    } ]
  }, {
    "tStartMs": 184920,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "And notice who this belief lands on\nhardest."
    } ]
  }, {
    "tStartMs": 188060,
    "dDurationMs": 4140,
    "segs": [ {
      "utf8": "It is not the person with an accountant,\nbecause somebody already told them."
    } ]
  }, {
    "tStartMs": 192200,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "It is the person who did their own taxes\nfor forty years, who trusts what they"
    } ]
  }, {
    "tStartMs": 197260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "hear, and who has nobody to ask."
    } ]
  }, {
    "tStartMs": 200000,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "The fear is aimed at exactly the people\nleast able to check it, and that is"
    } ]
  }, {
    "tStartMs": 204660,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "not an accident. It is a market."
    } ]
  }, {
    "tStartMs": 205980,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "One more thing about that little form,\nbecause it is worth being exact."
    } ]
  }, {
    "tStartMs": 210460,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "If your money earned less than ten dollars\nin the whole year, the bank does"
    } ]
  }, {
    "tStartMs": 214760,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "not have to send it at all. So a person\nwith a few thousand dollars in an ordinary"
    } ]
  }, {
    "tStartMs": 219540,
    "dDurationMs": 4920,
    "segs": [ {
      "utf8": "account may go year after year with\nnothing whatever being sent about them,"
    } ]
  }, {
    "tStartMs": 224460,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and never know that is what silence means."
    } ]
  }, {
    "tStartMs": 228400,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "Number two is what the tax office actually\nlooks at, and what it never does."
    } ]
  }, {
    "tStartMs": 233120,
    "dDurationMs": 4060,
    "segs": [ {
      "utf8": "Let me set out the whole list, because it\nis much shorter than people imagine,"
    } ]
  }, {
    "tStartMs": 237180,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "and the shortness is the point."
    } ]
  }, {
    "tStartMs": 239940,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Your bank tells the tax office how much\ninterest you earned."
    } ]
  }, {
    "tStartMs": 244260,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "That is the first thing and it is the\nordinary one."
    } ]
  }, {
    "tStartMs": 248820,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Your bank files a separate report when\nsomebody moves more than ten thousand"
    } ]
  }, {
    "tStartMs": 253120,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "dollars in cash."
    } ]
  }, {
    "tStartMs": 255180,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Notice the word cash."
    } ]
  }, {
    "tStartMs": 257100,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Paper money, handed across a counter, or\ntaken out across a counter."
    } ]
  }, {
    "tStartMs": 261520,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "That report is not about you being\nsuspected of anything."
    } ]
  }, {
    "tStartMs": 265580,
    "dDurationMs": 5520,
    "segs": [ {
      "utf8": "It is automatic, it happens thousands of\ntimes a day, and if the money is yours"
    } ]
  }, {
    "tStartMs": 271100,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "and honest, nothing follows from it."
    } ]
  }, {
    "tStartMs": 273540,
    "dDurationMs": 5180,
    "segs": [ {
      "utf8": "And your bank files a third kind of report\nif a member of staff believes something"
    } ]
  }, {
    "tStartMs": 278720,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "about the account looks wrong."
    } ]
  }, {
    "tStartMs": 280980,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "You are never told when that happens."
    } ]
  }, {
    "tStartMs": 283420,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "That is written into the law, and it is\nthe one thing in this list you have"
    } ]
  }, {
    "tStartMs": 287680,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "no visibility of. That is the list."
    } ]
  }, {
    "tStartMs": 291200,
    "dDurationMs": 3940,
    "segs": [ {
      "utf8": "Three things. Interest, large cash, and\nstaff suspicion."
    } ]
  }, {
    "tStartMs": 295620,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "That third one deserves a moment, because\nit is the only one with real teeth"
    } ]
  }, {
    "tStartMs": 299520,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "and almost nobody explains it properly."
    } ]
  }, {
    "tStartMs": 302940,
    "dDurationMs": 4340,
    "segs": [ {
      "utf8": "A member of bank staff who thinks\nsomething looks unusual can file a report,"
    } ]
  }, {
    "tStartMs": 307280,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "and the law forbids them from telling you\nthey did it."
    } ]
  }, {
    "tStartMs": 310960,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "Not discourages. Forbids. There is a\npenalty attached to telling you."
    } ]
  }, {
    "tStartMs": 316120,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "Understand what that means and what it\ndoes not mean."
    } ]
  }, {
    "tStartMs": 319200,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "It means you will never be warned."
    } ]
  }, {
    "tStartMs": 321300,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "It does not mean anything happens\nafterwards."
    } ]
  }, {
    "tStartMs": 324220,
    "dDurationMs": 5860,
    "segs": [ {
      "utf8": "The overwhelming majority of those reports\nare filed, stored, and never acted"
    } ]
  }, {
    "tStartMs": 330080,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "on by anybody, because they are a net, not\nan accusation."
    } ]
  }, {
    "tStartMs": 334400,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "The thing that gets a senior into that net\nis almost always the same thing,"
    } ]
  }, {
    "tStartMs": 338960,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "and it is behaviour that looks like\nhiding, not the size of the money."
    } ]
  }, {
    "tStartMs": 343340,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "Now hold on to what is not on it, because\nthis is where the fear lives."
    } ]
  }, {
    "tStartMs": 347580,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Your balance is not on it. The tax office\nis not sent a figure for what you"
    } ]
  }, {
    "tStartMs": 352060,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "hold. Your ordinary spending is not on it."
    } ]
  }, {
    "tStartMs": 354960,
    "dDurationMs": 2620,
    "segs": [ {
      "utf8": "Nobody receives a list of what you bought."
    } ]
  }, {
    "tStartMs": 358220,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "Your transfers between your own accounts\nare not on it."
    } ]
  }, {
    "tStartMs": 362140,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Moving your own money from savings to\nchecking creates nothing, because you"
    } ]
  }, {
    "tStartMs": 366460,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "have not earned anything and nothing has\nleft your hands."
    } ]
  }, {
    "tStartMs": 369920,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "And a check is not on it, at any size."
    } ]
  }, {
    "tStartMs": 373200,
    "dDurationMs": 3960,
    "segs": [ {
      "utf8": "This is the one that surprises people\nmost, so I want to be very plain."
    } ]
  }, {
    "tStartMs": 377920,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "The ten thousand dollar report is about\ncash."
    } ]
  }, {
    "tStartMs": 380640,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "If you sell a house and a check for two\nhundred and forty thousand dollars"
    } ]
  }, {
    "tStartMs": 384560,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "is deposited into your account, no report\nof that kind is filed."
    } ]
  }, {
    "tStartMs": 389860,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "The money is traceable, of course, because\na check is a piece of paper with"
    } ]
  }, {
    "tStartMs": 393880,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "names on it. But the automatic report\npeople are frightened of does not apply"
    } ]
  }, {
    "tStartMs": 398340,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "to it. Number three is the money that\ncomes in."
    } ]
  }, {
    "tStartMs": 403220,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "People treat every deposit as if it\ncarries a tax question with it."
    } ]
  }, {
    "tStartMs": 407240,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "Most of them carry nothing at all."
    } ]
  }, {
    "tStartMs": 409440,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "A deposit is not income."
    } ]
  }, {
    "tStartMs": 412640,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "Those are separate ideas and the\ndifference decides everything."
    } ]
  }, {
    "tStartMs": 416760,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "Income is money you earned or were paid."
    } ]
  }, {
    "tStartMs": 420000,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "A deposit is simply money arriving in an\naccount, and money arrives for all"
    } ]
  }, {
    "tStartMs": 424660,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "sorts of reasons that have nothing to do\nwith earning."
    } ]
  }, {
    "tStartMs": 427880,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "You sell a car. The money for the car is\nnot income, because you already owned"
    } ]
  }, {
    "tStartMs": 432320,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "the car. You are turning one thing you own\ninto another thing you own."
    } ]
  }, {
    "tStartMs": 436680,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "You move money from one bank to another."
    } ]
  }, {
    "tStartMs": 440280,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Not income. Your daughter pays you back\nthe four hundred dollars she borrowed."
    } ]
  }, {
    "tStartMs": 445140,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "Not income. She is returning your own\nmoney to you."
    } ]
  }, {
    "tStartMs": 449060,
    "dDurationMs": 3780,
    "segs": [ {
      "utf8": "You take money out of a savings account\nyou already paid tax on years ago."
    } ]
  }, {
    "tStartMs": 453120,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "Not income now. An insurance company pays\nfor the damage to your roof."
    } ]
  }, {
    "tStartMs": 458300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Not income."
    } ]
  }, {
    "tStartMs": 459880,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "Every one of those lands in your account\nlooking exactly like every other deposit,"
    } ]
  }, {
    "tStartMs": 464360,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "and not one of them creates a tax bill or\na report."
    } ]
  }, {
    "tStartMs": 468840,
    "dDurationMs": 2080,
    "segs": [ {
      "utf8": "And here is where it does the most harm."
    } ]
  }, {
    "tStartMs": 471640,
    "dDurationMs": 4240,
    "segs": [ {
      "utf8": "Somebody in their seventies sells the old\ncar for six thousand dollars and"
    } ]
  }, {
    "tStartMs": 475880,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "then decides not to deposit it at all,\nbecause six thousand dollars appearing"
    } ]
  }, {
    "tStartMs": 480340,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "in the account feels like it will start\nsomething."
    } ]
  }, {
    "tStartMs": 483040,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "So the money sits in a kitchen drawer\ninstead, uninsured, until it is spent"
    } ]
  }, {
    "tStartMs": 487780,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "or lost or taken. Nothing would have\nstarted."
    } ]
  }, {
    "tStartMs": 491380,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "It was money from their own car."
    } ]
  }, {
    "tStartMs": 494160,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "And this is the pattern under every\nexample."
    } ]
  }, {
    "tStartMs": 497180,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "The money was never the problem."
    } ]
  }, {
    "tStartMs": 499320,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The hiding was."
    } ]
  }, {
    "tStartMs": 501140,
    "dDurationMs": 4660,
    "segs": [ {
      "utf8": "A large deposit with a clear reason behind\nit is the most ordinary thing a"
    } ]
  }, {
    "tStartMs": 505800,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "bank sees all day. A pattern of"
    } ]
  }, {
    "tStartMs": 508120,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "small deposits from a person who suddenly\nchanged"
    } ]
  }, {
    "tStartMs": 510580,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "how they bank is the thing that gets\nlooked at."
    } ]
  }, {
    "tStartMs": 513920,
    "dDurationMs": 5320,
    "segs": [ {
      "utf8": "So the very act people take to feel safer\nis the one act that creates the attention"
    } ]
  }, {
    "tStartMs": 519240,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "they were afraid of."
    } ]
  }, {
    "tStartMs": 521280,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Number four is money from your family, and\nmoney that arrives through a telephone."
    } ]
  }, {
    "tStartMs": 526480,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "This one has two halves and both of them\nare simpler than people think."
    } ]
  }, {
    "tStartMs": 530740,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "The first half. If your son or your\ndaughter gives you money, that money is"
    } ]
  }, {
    "tStartMs": 535240,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "not income to you. It does not go on your\nreturn."
    } ]
  }, {
    "tStartMs": 538940,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "You do not report it and you do not pay\ntax on it."
    } ]
  }, {
    "tStartMs": 542300,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "That is true whether it is two hundred\ndollars or twenty thousand."
    } ]
  }, {
    "tStartMs": 545720,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "There is a line, and the line matters, but\nnotice which side of it you are"
    } ]
  }, {
    "tStartMs": 550400,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "on. If one person gives another person\nmore than nineteen thousand dollars"
    } ]
  }, {
    "tStartMs": 554000,
    "dDurationMs": 4580,
    "segs": [ {
      "utf8": "in a single year, the person who gave it\nmay have to file a form about it."
    } ]
  }, {
    "tStartMs": 559140,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "The person who received it files nothing."
    } ]
  }, {
    "tStartMs": 561760,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "Not a form, not a note, nothing."
    } ]
  }, {
    "tStartMs": 564080,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "The paperwork, if there is any, belongs to\nthe giver."
    } ]
  }, {
    "tStartMs": 567180,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "So when your daughter helps you with a\nlarge bill, or your son covers a hospital"
    } ]
  }, {
    "tStartMs": 570900,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "cost, that is not a thing you must report,\nand the amount does not change your"
    } ]
  }, {
    "tStartMs": 575500,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "side of it. The second half is the\ntelephone."
    } ]
  }, {
    "tStartMs": 579040,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "More and more people your age receive\nmoney through an application on a phone,"
    } ]
  }, {
    "tStartMs": 582680,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "because that is how their children send it\nnow."
    } ]
  }, {
    "tStartMs": 585640,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "When that money is a family payment, when\nyour granddaughter is paying you"
    } ]
  }, {
    "tStartMs": 589280,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "back or sending you something for your\nbirthday, it is not reportable at all."
    } ]
  }, {
    "tStartMs": 593600,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Not at any amount."
    } ]
  }, {
    "tStartMs": 595360,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "The forms that apply to those applications\nare for business payments, for people"
    } ]
  }, {
    "tStartMs": 599160,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "selling things. And the limit on that\nbusiness reporting recently moved, in"
    } ]
  }, {
    "tStartMs": 603360,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "the direction nobody expects. For a while\nthere was talk of it dropping to"
    } ]
  }, {
    "tStartMs": 607080,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "six hundred dollars, and a great deal of\nfear was sold on that number."
    } ]
  }, {
    "tStartMs": 610860,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "It did not happen. The limit is now twenty\nthousand dollars in a year, and"
    } ]
  }, {
    "tStartMs": 615160,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "it also requires more than two hundred\nseparate payments."
    } ]
  }, {
    "tStartMs": 618200,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Both conditions. Not one. If you have"
    } ]
  }, {
    "tStartMs": 621240,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "heard a lower figure from anybody,\nincluding"
    } ]
  }, {
    "tStartMs": 623400,
    "dDurationMs": 3240,
    "segs": [ {
      "utf8": "from me in an older video, that figure has\nbeen overtaken."
    } ]
  }, {
    "tStartMs": 627120,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Twenty thousand dollars and two hundred\npayments is where it stands, and it"
    } ]
  }, {
    "tStartMs": 630760,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "applies to selling, not to your family."
    } ]
  }, {
    "tStartMs": 634040,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "What to do now, and a caution first."
    } ]
  }, {
    "tStartMs": 636460,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "Everything above describes rules that\napply across the country."
    } ]
  }, {
    "tStartMs": 639840,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "Your own account, your own state and your\nown tax position can differ, so read"
    } ]
  }, {
    "tStartMs": 644260,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "what your bank sends you and ask them\ndirectly before you act on anything here."
    } ]
  }, {
    "tStartMs": 649000,
    "dDurationMs": 1380,
    "segs": [ {
      "utf8": "Then do these four things."
    } ]
  }, {
    "tStartMs": 651080,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Put the money back in the bank."
    } ]
  }, {
    "tStartMs": 653000,
    "dDurationMs": 3720,
    "segs": [ {
      "utf8": "If you have been holding cash at home\nbecause of any of this, that decision"
    } ]
  }, {
    "tStartMs": 656720,
    "dDurationMs": 1755,
    "segs": [ {
      "utf8": "is costing you and protecting you from\nnothing."
    } ]
  }, {
    "tStartMs": 658515,
    "dDurationMs": 2265,
    "segs": [ {
      "utf8": "Cash in a house is not insured."
    } ]
  }, {
    "tStartMs": 661780,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Money in a bank is insured, and no report\nis going to be triggered by walking"
    } ]
  }, {
    "tStartMs": 665940,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "it in, unless it is over ten thousand\ndollars in paper money, in which case"
    } ]
  }, {
    "tStartMs": 670500,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "a routine form is filed and nothing\nhappens to you."
    } ]
  }, {
    "tStartMs": 674420,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Stop dividing deposits. If somebody told\nyou to make two trips instead of one,"
    } ]
  }, {
    "tStartMs": 679060,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "they gave you advice that can be\nprosecuted."
    } ]
  }, {
    "tStartMs": 681780,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "Make one deposit. If it is large, bring\nwhatever paper explains where it came"
    } ]
  }, {
    "tStartMs": 686460,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "from, and that is the end of it."
    } ]
  }, {
    "tStartMs": 688460,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Move your savings to wherever it earns\nmore."
    } ]
  }, {
    "tStartMs": 690980,
    "dDurationMs": 2740,
    "segs": [ {
      "utf8": "The move creates no report and no tax\nevent."
    } ]
  }, {
    "tStartMs": 694240,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "You are moving your own money between your\nown accounts."
    } ]
  }, {
    "tStartMs": 697280,
    "dDurationMs": 3320,
    "segs": [ {
      "utf8": "And while you are doing it, look at what\nthe old account actually paid you"
    } ]
  }, {
    "tStartMs": 700600,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "last year. Find the little form, or find\nthe line on your December statement."
    } ]
  }, {
    "tStartMs": 705460,
    "dDurationMs": 3400,
    "segs": [ {
      "utf8": "If the number is under ten dollars, you\nhave learned two things at once."
    } ]
  }, {
    "tStartMs": 709280,
    "dDurationMs": 3460,
    "segs": [ {
      "utf8": "Your money earned almost nothing, and\nnothing at all was sent about you."
    } ]
  }, {
    "tStartMs": 713360,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "People carry a fear of being watched while\nholding an account so quiet that"
    } ]
  }, {
    "tStartMs": 716940,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "no paper about it exists. And keep every\npiece of paper that explains a large"
    } ]
  }, {
    "tStartMs": 721540,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "arrival. The car sale. The house closing."
    } ]
  }, {
    "tStartMs": 724900,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "The insurance settlement."
    } ]
  }, {
    "tStartMs": 726560,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "Nobody is likely to ask. But if anybody\never does, one sheet of paper closes"
    } ]
  }, {
    "tStartMs": 731320,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "the question in a single sentence."
    } ]
  }, {
    "tStartMs": 733720,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "One warning, and it belongs in this video\nmore than in most."
    } ]
  }, {
    "tStartMs": 737500,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "The people selling fear about your bank\naccount are the ones who benefit from"
    } ]
  }, {
    "tStartMs": 741260,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "your not knowing this. If somebody offers\nyou a paid guide to protect your"
    } ]
  }, {
    "tStartMs": 744760,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "account from a rule they will not name, or\ntells you the tax office is watching"
    } ]
  }, {
    "tStartMs": 748420,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "a balance, they are selling you a problem\nyou do not have."
    } ]
  }, {
    "tStartMs": 751980,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Anything real about your account is\nwritten down and free to read."
    } ]
  }, {
    "tStartMs": 755620,
    "dDurationMs": 1420,
    "segs": [ {
      "utf8": "Run through the four a final time."
    } ]
  }, {
    "tStartMs": 757700,
    "dDurationMs": 2520,
    "segs": [ {
      "utf8": "The amount of money in your account is not\nreported to anyone."
    } ]
  }, {
    "tStartMs": 760900,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "What is reported is interest, large"
    } ]
  }, {
    "tStartMs": 763280,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "amounts of paper cash, and staff\nsuspicion,"
    } ]
  }, {
    "tStartMs": 766120,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "and that is the whole list. Money arriving\nin an account is not income, so"
    } ]
  }, {
    "tStartMs": 771620,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "a car sale, a repayment and a transfer\nbetween your own accounts create nothing."
    } ]
  }, {
    "tStartMs": 777880,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "And money from your family, in the hand or\nthrough a telephone, is not yours"
    } ]
  }, {
    "tStartMs": 782860,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "to report at any amount."
    } ]
  }, {
    "tStartMs": 785440,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "None of this was hidden from you by any\noffice."
    } ]
  }, {
    "tStartMs": 788340,
    "dDurationMs": 3160,
    "segs": [ {
      "utf8": "It sits in public rules that anybody can\nread."
    } ]
  }, {
    "tStartMs": 791500,
    "dDurationMs": 5340,
    "segs": [ {
      "utf8": "It stayed unknown because there is money\nin your believing the opposite, and"
    } ]
  }, {
    "tStartMs": 796840,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "no money at all in telling you the truth."
    } ]
  }, {
    "tStartMs": 800160,
    "dDurationMs": 2680,
    "segs": [ {
      "utf8": "So go and look at what that belief has\ncost you."
    } ]
  }, {
    "tStartMs": 803520,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "If somebody in your family is keeping cash\nin the house because they believe"
    } ]
  }, {
    "tStartMs": 807320,
    "dDurationMs": 4900,
    "segs": [ {
      "utf8": "a bank will tell on them, ring them this\nevening and read them what is actually"
    } ]
  }, {
    "tStartMs": 812220,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "printed on that form."
    } ]
  } ]
}
