{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "Hello and welcome back to the channel."
    } ]
  }, {
    "tStartMs": 3582,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "It is so good to have you here with me again today,"
    } ]
  }, {
    "tStartMs": 6924,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "so go ahead and get comfortable,"
    } ]
  }, {
    "tStartMs": 9485,
    "dDurationMs": 3802,
    "segs": [ {
      "utf8": "because what I have for you in the next few minutes could"
    } ]
  }, {
    "tStartMs": 13287,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "genuinely save you money."
    } ]
  }, {
    "tStartMs": 15549,
    "dDurationMs": 2081,
    "segs": [ {
      "utf8": "If you are over 65,"
    } ]
  }, {
    "tStartMs": 18030,
    "dDurationMs": 4162,
    "segs": [ {
      "utf8": "there are bills landing in your mailbox right now that companies are"
    } ]
  }, {
    "tStartMs": 22192,
    "dDurationMs": 1962,
    "segs": [ {
      "utf8": "not legally allowed to charge you."
    } ]
  }, {
    "tStartMs": 24294,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "Not bills you can get a discount on, not bills you can"
    } ]
  }, {
    "tStartMs": 27636,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "negotiate down a little, bills that the law says they had no"
    } ]
  }, {
    "tStartMs": 31198,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "right to send you in the first place."
    } ]
  }, {
    "tStartMs": 33759,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "And most people pay them anyway,"
    } ]
  }, {
    "tStartMs": 35981,
    "dDurationMs": 360,
    "segs": [ {
      "utf8": "quietly,"
    } ]
  }, {
    "tStartMs": 36741,
    "dDurationMs": 3162,
    "segs": [ {
      "utf8": "every single month because nobody ever told them it was against the"
    } ]
  }, {
    "tStartMs": 39903,
    "dDurationMs": 300,
    "segs": [ {
      "utf8": "rules."
    } ]
  }, {
    "tStartMs": 41044,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "The company is counting on exactly that,"
    } ]
  }, {
    "tStartMs": 43785,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "so stay with me to the end, because by the time we"
    } ]
  }, {
    "tStartMs": 46587,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "are done, you will know all eight of these bills, you will"
    } ]
  }, {
    "tStartMs": 50049,
    "dDurationMs": 3182,
    "segs": [ {
      "utf8": "know why each one is illegal, and you will know the exact"
    } ]
  }, {
    "tStartMs": 53231,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "words to say to make the charge disappear."
    } ]
  }, {
    "tStartMs": 56052,
    "dDurationMs": 3442,
    "segs": [ {
      "utf8": "The first one is the surprise bill after an emergency."
    } ]
  }, {
    "tStartMs": 60135,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "You have an emergency, you are rushed to the nearest hospital,"
    } ]
  }, {
    "tStartMs": 63717,
    "dDurationMs": 4042,
    "segs": [ {
      "utf8": "and weeks later a bill arrives for thousands of dollars because that"
    } ]
  }, {
    "tStartMs": 67759,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "hospital, or one of its doctors,"
    } ]
  }, {
    "tStartMs": 70281,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "turned out to be outside your insurance network."
    } ]
  }, {
    "tStartMs": 73142,
    "dDurationMs": 3743,
    "segs": [ {
      "utf8": "There is now a federal law called the No Surprises Act that"
    } ]
  }, {
    "tStartMs": 76885,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "makes that bill illegal."
    } ]
  }, {
    "tStartMs": 79046,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "For emergency care, you can only be charged the same share you"
    } ]
  }, {
    "tStartMs": 82728,
    "dDurationMs": 1761,
    "segs": [ {
      "utf8": "would have paid inside your network,"
    } ]
  }, {
    "tStartMs": 84989,
    "dDurationMs": 2282,
    "segs": [ {
      "utf8": "no matter where the ambulance took you."
    } ]
  }, {
    "tStartMs": 87631,
    "dDurationMs": 3722,
    "segs": [ {
      "utf8": "So if a surprise emergency bill demands far more than your normal"
    } ]
  }, {
    "tStartMs": 91353,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "share,"
    } ]
  }, {
    "tStartMs": 92214,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "do not just pay it."
    } ]
  }, {
    "tStartMs": 93714,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "You call the number on the bill and you say these exact"
    } ]
  }, {
    "tStartMs": 96716,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "words."
    } ]
  }, {
    "tStartMs": 97657,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "This is a balanced bill and it is prohibited under the No"
    } ]
  }, {
    "tStartMs": 101219,
    "dDurationMs": 940,
    "segs": [ {
      "utf8": "Surprises Act."
    } ]
  }, {
    "tStartMs": 103000,
    "dDurationMs": 3522,
    "segs": [ {
      "utf8": "The moment you show you know the rule, the charge tends to"
    } ]
  }, {
    "tStartMs": 106522,
    "dDurationMs": 3882,
    "segs": [ {
      "utf8": "disappear because they know they were never supposed to send it."
    } ]
  }, {
    "tStartMs": 110844,
    "dDurationMs": 3843,
    "segs": [ {
      "utf8": "The second one is for people in the program called the Qualified"
    } ]
  }, {
    "tStartMs": 114687,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "Medicare Beneficiary Program."
    } ]
  }, {
    "tStartMs": 117568,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "If your income is low enough to be in it, then by"
    } ]
  }, {
    "tStartMs": 120630,
    "dDurationMs": 821,
    "segs": [ {
      "utf8": "federal law,"
    } ]
  }, {
    "tStartMs": 121891,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "no doctor,"
    } ]
  }, {
    "tStartMs": 123012,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "no hospital, and no pharmacy is allowed to bill you for Medicare"
    } ]
  }, {
    "tStartMs": 126974,
    "dDurationMs": 2982,
    "segs": [ {
      "utf8": "deductibles, coinsurance, or copays."
    } ]
  }, {
    "tStartMs": 130576,
    "dDurationMs": 1461,
    "segs": [ {
      "utf8": "Not a single dollar."
    } ]
  }, {
    "tStartMs": 132757,
    "dDurationMs": 3422,
    "segs": [ {
      "utf8": "Medicare and your state cover it, and the provider has to accept"
    } ]
  }, {
    "tStartMs": 136179,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "that as payment in full."
    } ]
  }, {
    "tStartMs": 138541,
    "dDurationMs": 3722,
    "segs": [ {
      "utf8": "Yet people in this program get charged every day because the front"
    } ]
  }, {
    "tStartMs": 142263,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "desk runs the card the same as everyone else."
    } ]
  }, {
    "tStartMs": 145405,
    "dDurationMs": 3242,
    "segs": [ {
      "utf8": "If a bill arrives for a copay or a deductible, it is"
    } ]
  }, {
    "tStartMs": 148647,
    "dDurationMs": 440,
    "segs": [ {
      "utf8": "illegal,"
    } ]
  }, {
    "tStartMs": 149567,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "and money you already paid is supposed to come back to you."
    } ]
  }, {
    "tStartMs": 153309,
    "dDurationMs": 4563,
    "segs": [ {
      "utf8": "You tell them clearly, I am a qualified Medicare beneficiary and"
    } ]
  }, {
    "tStartMs": 157872,
    "dDurationMs": 2581,
    "segs": [ {
      "utf8": "federal law prohibits billing me for cost sharing,"
    } ]
  }, {
    "tStartMs": 160934,
    "dDurationMs": 3302,
    "segs": [ {
      "utf8": "and then you ask them to reverse the charge and refund you."
    } ]
  }, {
    "tStartMs": 164696,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "The third one hides inside a visit you get for free."
    } ]
  }, {
    "tStartMs": 169319,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "Once a year, Medicare gives you a wellness visit,"
    } ]
  }, {
    "tStartMs": 172741,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "and as long as your doctor accepts Medicare,"
    } ]
  }, {
    "tStartMs": 175442,
    "dDurationMs": 1661,
    "segs": [ {
      "utf8": "it costs you nothing at all."
    } ]
  }, {
    "tStartMs": 177523,
    "dDurationMs": 2142,
    "segs": [ {
      "utf8": "No copay, no deductible."
    } ]
  }, {
    "tStartMs": 180325,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "But people get billed for it almost constantly,"
    } ]
  }, {
    "tStartMs": 183007,
    "dDurationMs": 3902,
    "segs": [ {
      "utf8": "almost always because the office coded it as a regular office visit"
    } ]
  }, {
    "tStartMs": 186909,
    "dDurationMs": 720,
    "segs": [ {
      "utf8": "instead."
    } ]
  }, {
    "tStartMs": 188490,
    "dDurationMs": 3602,
    "segs": [ {
      "utf8": "The same thing happens with covered preventive screenings that are supposed to"
    } ]
  }, {
    "tStartMs": 192092,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "be free."
    } ]
  }, {
    "tStartMs": 193233,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "So if a charge shows up for your yearly wellness visit,"
    } ]
  }, {
    "tStartMs": 196515,
    "dDurationMs": 2021,
    "segs": [ {
      "utf8": "do not assume that is simply the price."
    } ]
  }, {
    "tStartMs": 199036,
    "dDurationMs": 3002,
    "segs": [ {
      "utf8": "Call the office, tell them it was meant to be your annual"
    } ]
  }, {
    "tStartMs": 202038,
    "dDurationMs": 3982,
    "segs": [ {
      "utf8": "Medicare wellness visit, and ask them to check the coding and correct"
    } ]
  }, {
    "tStartMs": 206020,
    "dDurationMs": 4243,
    "segs": [ {
      "utf8": "it. For the visit itself, the correct amount you owe is zero."
    } ]
  }, {
    "tStartMs": 210923,
    "dDurationMs": 3402,
    "segs": [ {
      "utf8": "The fourth one is the bill for something that never actually happened."
    } ]
  }, {
    "tStartMs": 215166,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "Read your own itemized statement, and you will find charges for tests"
    } ]
  }, {
    "tStartMs": 218507,
    "dDurationMs": 3703,
    "segs": [ {
      "utf8": "that were never run for a night you were never there, for"
    } ]
  }, {
    "tStartMs": 222210,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "the same procedure listed twice,"
    } ]
  }, {
    "tStartMs": 224531,
    "dDurationMs": 2722,
    "segs": [ {
      "utf8": "or for a bill your insurance already paid in full."
    } ]
  }, {
    "tStartMs": 228213,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "The industry even has names for it."
    } ]
  }, {
    "tStartMs": 230655,
    "dDurationMs": 2381,
    "segs": [ {
      "utf8": "Phantom billing for care that never occurred."
    } ]
  }, {
    "tStartMs": 233676,
    "dDurationMs": 3062,
    "segs": [ {
      "utf8": "Double billing for being charged twice for one thing."
    } ]
  }, {
    "tStartMs": 237399,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "Charging you for care you never received,"
    } ]
  }, {
    "tStartMs": 239920,
    "dDurationMs": 3382,
    "segs": [ {
      "utf8": "or collecting on a bill already paid, is against the law."
    } ]
  }, {
    "tStartMs": 243882,
    "dDurationMs": 2942,
    "segs": [ {
      "utf8": "So never pay a medical bill from the short summary page."
    } ]
  }, {
    "tStartMs": 247464,
    "dDurationMs": 1882,
    "segs": [ {
      "utf8": "Ask for the fully itemized bill,"
    } ]
  }, {
    "tStartMs": 249806,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "the one that lists every charge line by line, and read it"
    } ]
  }, {
    "tStartMs": 253368,
    "dDurationMs": 320,
    "segs": [ {
      "utf8": "slowly,"
    } ]
  }, {
    "tStartMs": 254168,
    "dDurationMs": 3923,
    "segs": [ {
      "utf8": "because the errors are sitting right there, and almost nobody ever looks"
    } ]
  }, {
    "tStartMs": 258091,
    "dDurationMs": 1481,
    "segs": [ {
      "utf8": "closely enough to catch them."
    } ]
  }, {
    "tStartMs": 260572,
    "dDurationMs": 4203,
    "segs": [ {
      "utf8": "The fifth one protects your family even more than it protects you."
    } ]
  }, {
    "tStartMs": 265455,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "If someone you love moves into a nursing home,"
    } ]
  }, {
    "tStartMs": 268457,
    "dDurationMs": 3242,
    "segs": [ {
      "utf8": "the facility hands over a thick stack of admission paperwork,"
    } ]
  }, {
    "tStartMs": 272479,
    "dDurationMs": 2742,
    "segs": [ {
      "utf8": "and buried in it, they will often try to get an adult"
    } ]
  }, {
    "tStartMs": 275221,
    "dDurationMs": 3602,
    "segs": [ {
      "utf8": "child or a close friend to sign as the guarantor,"
    } ]
  }, {
    "tStartMs": 279303,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "the person personally responsible for the bill."
    } ]
  }, {
    "tStartMs": 282505,
    "dDurationMs": 4142,
    "segs": [ {
      "utf8": "A federal law called the Nursing Home Reform Act makes it illegal"
    } ]
  }, {
    "tStartMs": 286647,
    "dDurationMs": 4003,
    "segs": [ {
      "utf8": "to require a third party to guarantee payment as a condition"
    } ]
  }, {
    "tStartMs": 290650,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "of admission."
    } ]
  }, {
    "tStartMs": 292151,
    "dDurationMs": 3502,
    "segs": [ {
      "utf8": "They cannot force your daughter or your son to sign their own"
    } ]
  }, {
    "tStartMs": 295653,
    "dDurationMs": 1781,
    "segs": [ {
      "utf8": "money away just to get you in."
    } ]
  }, {
    "tStartMs": 297894,
    "dDurationMs": 2902,
    "segs": [ {
      "utf8": "They are allowed to ask the person who manages your money to"
    } ]
  }, {
    "tStartMs": 300796,
    "dDurationMs": 1000,
    "segs": [ {
      "utf8": "pay from your funds,"
    } ]
  }, {
    "tStartMs": 302317,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "but they cannot make another person personally liable."
    } ]
  }, {
    "tStartMs": 306059,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "So if you see that guarantee clause in front of the family"
    } ]
  }, {
    "tStartMs": 308700,
    "dDurationMs": 3883,
    "segs": [ {
      "utf8": "member, you can refuse to sign that part, and the admission still"
    } ]
  }, {
    "tStartMs": 312583,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "has to stand."
    } ]
  }, {
    "tStartMs": 315144,
    "dDurationMs": 3782,
    "segs": [ {
      "utf8": "The sixth one is the extra fee piled on top of a"
    } ]
  }, {
    "tStartMs": 318926,
    "dDurationMs": 1361,
    "segs": [ {
      "utf8": "debt that goes to collections."
    } ]
  }, {
    "tStartMs": 321048,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "An old bill of yours gets handed to a collection agency,"
    } ]
  }, {
    "tStartMs": 324630,
    "dDurationMs": 3202,
    "segs": [ {
      "utf8": "and suddenly the amount is bigger than what you actually owed,"
    } ]
  }, {
    "tStartMs": 328512,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "padded with collection fees,"
    } ]
  }, {
    "tStartMs": 330313,
    "dDurationMs": 3802,
    "segs": [ {
      "utf8": "processing fees, or a charge just to take your payment over the"
    } ]
  }, {
    "tStartMs": 334115,
    "dDurationMs": 260,
    "segs": [ {
      "utf8": "phone."
    } ]
  }, {
    "tStartMs": 335256,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "Under the Federal Fair Debt Collection Practices Act,"
    } ]
  }, {
    "tStartMs": 338758,
    "dDurationMs": 3262,
    "segs": [ {
      "utf8": "a collector cannot add fees that were not part of your original"
    } ]
  }, {
    "tStartMs": 342020,
    "dDurationMs": 2381,
    "segs": [ {
      "utf8": "agreement and are not allowed by law."
    } ]
  }, {
    "tStartMs": 345202,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "That fee just to pay by card over the phone has been"
    } ]
  }, {
    "tStartMs": 348263,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "ruled illegal in many cases."
    } ]
  }, {
    "tStartMs": 350565,
    "dDurationMs": 1881,
    "segs": [ {
      "utf8": "So when a collector quotes you a number,"
    } ]
  }, {
    "tStartMs": 353026,
    "dDurationMs": 481,
    "segs": [ {
      "utf8": "you say,"
    } ]
  }, {
    "tStartMs": 354207,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "please put in writing what the original debt was and what every"
    } ]
  }, {
    "tStartMs": 357549,
    "dDurationMs": 1061,
    "segs": [ {
      "utf8": "added fee is for."
    } ]
  }, {
    "tStartMs": 359270,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "The padding very often disappears the moment you ask for it in"
    } ]
  }, {
    "tStartMs": 362612,
    "dDurationMs": 4002,
    "segs": [ {
      "utf8": "writing. The seventh one is about the money already sitting"
    } ]
  }, {
    "tStartMs": 366614,
    "dDurationMs": 1421,
    "segs": [ {
      "utf8": "in your own bank account."
    } ]
  }, {
    "tStartMs": 368755,
    "dDurationMs": 4983,
    "segs": [ {
      "utf8": "Your social security is protected by federal law from ordinary creditors."
    } ]
  }, {
    "tStartMs": 374099,
    "dDurationMs": 1100,
    "segs": [ {
      "utf8": "A credit card company,"
    } ]
  }, {
    "tStartMs": 375619,
    "dDurationMs": 1121,
    "segs": [ {
      "utf8": "a medical debt collector,"
    } ]
  }, {
    "tStartMs": 377200,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "a personal loan company,"
    } ]
  }, {
    "tStartMs": 378921,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "none of them can legally reach in and take it."
    } ]
  }, {
    "tStartMs": 382243,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "And there is a banking rule behind this."
    } ]
  }, {
    "tStartMs": 384945,
    "dDurationMs": 4142,
    "segs": [ {
      "utf8": "When your social security arrives by direct deposit and a creditor"
    } ]
  }, {
    "tStartMs": 389087,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "comes after your account,"
    } ]
  }, {
    "tStartMs": 390948,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "your bank must look back over the past two months and protect"
    } ]
  }, {
    "tStartMs": 394551,
    "dDurationMs": 3322,
    "segs": [ {
      "utf8": "that amount of benefits so you can still reach your money."
    } ]
  }, {
    "tStartMs": 398533,
    "dDurationMs": 4202,
    "segs": [ {
      "utf8": "The bank cannot simply freeze everything and leave you with"
    } ]
  }, {
    "tStartMs": 402735,
    "dDurationMs": 301,
    "segs": [ {
      "utf8": "nothing."
    } ]
  }, {
    "tStartMs": 403816,
    "dDurationMs": 3862,
    "segs": [ {
      "utf8": "There are a few exceptions where the government itself can still collect,"
    } ]
  }, {
    "tStartMs": 408199,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "such as child support,"
    } ]
  }, {
    "tStartMs": 410020,
    "dDurationMs": 420,
    "segs": [ {
      "utf8": "alimony,"
    } ]
  }, {
    "tStartMs": 411080,
    "dDurationMs": 601,
    "segs": [ {
      "utf8": "certain federal"
    } ]
  }, {
    "tStartMs": 412221,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "and federal student loans,"
    } ]
  }, {
    "tStartMs": 414662,
    "dDurationMs": 1781,
    "segs": [ {
      "utf8": "but an ordinary creditor cannot."
    } ]
  }, {
    "tStartMs": 417264,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "So if a creditor or a bank tries to freeze your social"
    } ]
  }, {
    "tStartMs": 420606,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "security,"
    } ]
  }, {
    "tStartMs": 421787,
    "dDurationMs": 980,
    "segs": [ {
      "utf8": "you say plainly,"
    } ]
  }, {
    "tStartMs": 423407,
    "dDurationMs": 4063,
    "segs": [ {
      "utf8": "these are exempt federal benefits protected under the Social Security"
    } ]
  }, {
    "tStartMs": 427470,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "Act."
    } ]
  }, {
    "tStartMs": 428270,
    "dDurationMs": 4303,
    "segs": [ {
      "utf8": "The eighth one is so small that it slides right past you,"
    } ]
  }, {
    "tStartMs": 432753,
    "dDurationMs": 1861,
    "segs": [ {
      "utf8": "which is exactly why it works."
    } ]
  }, {
    "tStartMs": 435294,
    "dDurationMs": 2702,
    "segs": [ {
      "utf8": "Look at your phone bill line by line."
    } ]
  }, {
    "tStartMs": 438436,
    "dDurationMs": 4103,
    "segs": [ {
      "utf8": "Companies sometimes slip tiny charges onto it for services you"
    } ]
  }, {
    "tStartMs": 442539,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "never signed up for."
    } ]
  }, {
    "tStartMs": 444060,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "A few dollars here,"
    } ]
  }, {
    "tStartMs": 445620,
    "dDurationMs": 1421,
    "segs": [ {
      "utf8": "a vague subscription there,"
    } ]
  }, {
    "tStartMs": 447582,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "a fee with a name you do not even recognize."
    } ]
  }, {
    "tStartMs": 450904,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "This is called cramming, and it is illegal."
    } ]
  }, {
    "tStartMs": 454346,
    "dDurationMs": 4242,
    "segs": [ {
      "utf8": "The Federal Communications Commission says a company cannot place a charge"
    } ]
  }, {
    "tStartMs": 458588,
    "dDurationMs": 3922,
    "segs": [ {
      "utf8": "from an outside third party on your phone bill without your clear"
    } ]
  }, {
    "tStartMs": 462510,
    "dDurationMs": 501,
    "segs": [ {
      "utf8": "permission."
    } ]
  }, {
    "tStartMs": 463771,
    "dDurationMs": 4103,
    "segs": [ {
      "utf8": "It carries on for because the amounts are kept small on purpose,"
    } ]
  }, {
    "tStartMs": 468314,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "just one or two dollars a month,"
    } ]
  }, {
    "tStartMs": 470415,
    "dDurationMs": 2341,
    "segs": [ {
      "utf8": "low enough that you never quite notice."
    } ]
  }, {
    "tStartMs": 473497,
    "dDurationMs": 1201,
    "segs": [ {
      "utf8": "So actually look,"
    } ]
  }, {
    "tStartMs": 475218,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "if there is a charge you do not recognize,"
    } ]
  }, {
    "tStartMs": 477919,
    "dDurationMs": 1241,
    "segs": [ {
      "utf8": "call your phone company,"
    } ]
  }, {
    "tStartMs": 479580,
    "dDurationMs": 3402,
    "segs": [ {
      "utf8": "tell them you never authorized it, and ask them to remove it"
    } ]
  }, {
    "tStartMs": 482982,
    "dDurationMs": 3042,
    "segs": [ {
      "utf8": "and to block all third party charges going forward."
    } ]
  }, {
    "tStartMs": 486424,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "Now step back and look at what all eight of these"
    } ]
  }, {
    "tStartMs": 490127,
    "dDurationMs": 2541,
    "segs": [ {
      "utf8": "because it is the whole reason they keep working."
    } ]
  }, {
    "tStartMs": 493408,
    "dDurationMs": 2462,
    "segs": [ {
      "utf8": "Not one of them ever stops on its own."
    } ]
  }, {
    "tStartMs": 496450,
    "dDurationMs": 2482,
    "segs": [ {
      "utf8": "Every single one is already against the rules,"
    } ]
  }, {
    "tStartMs": 499392,
    "dDurationMs": 3582,
    "segs": [ {
      "utf8": "and every single one keeps getting collected for one reason only."
    } ]
  }, {
    "tStartMs": 503795,
    "dDurationMs": 3622,
    "segs": [ {
      "utf8": "The company is quietly betting that you will pay it without ever"
    } ]
  }, {
    "tStartMs": 507417,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "questioning it."
    } ]
  }, {
    "tStartMs": 508657,
    "dDurationMs": 2542,
    "segs": [ {
      "utf8": "The law is already standing on your side."
    } ]
  }, {
    "tStartMs": 511639,
    "dDurationMs": 4343,
    "segs": [ {
      "utf8": "The only thing missing is one person looking closely and saying, no,"
    } ]
  }, {
    "tStartMs": 516382,
    "dDurationMs": 2001,
    "segs": [ {
      "utf8": "you are not allowed to charge me this."
    } ]
  }, {
    "tStartMs": 518763,
    "dDurationMs": 1981,
    "segs": [ {
      "utf8": "So here is your simple plan."
    } ]
  }, {
    "tStartMs": 521345,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "You do not need to chase all eight at once."
    } ]
  }, {
    "tStartMs": 524126,
    "dDurationMs": 3583,
    "segs": [ {
      "utf8": "Pick the biggest bill in your life right now and start there."
    } ]
  }, {
    "tStartMs": 528289,
    "dDurationMs": 3622,
    "segs": [ {
      "utf8": "If it is a medical bill, ask for the itemized version and"
    } ]
  }, {
    "tStartMs": 531911,
    "dDurationMs": 1041,
    "segs": [ {
      "utf8": "read every line."
    } ]
  }, {
    "tStartMs": 533492,
    "dDurationMs": 3022,
    "segs": [ {
      "utf8": "If you are in the qualified Medicare beneficiary program,"
    } ]
  }, {
    "tStartMs": 537154,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "gather the copays you have paid this year."
    } ]
  }, {
    "tStartMs": 539896,
    "dDurationMs": 3862,
    "segs": [ {
      "utf8": "Pull out your phone bill and read line by line, and make"
    } ]
  }, {
    "tStartMs": 543758,
    "dDurationMs": 4062,
    "segs": [ {
      "utf8": "sure your Social Security comes by direct deposit because that one"
    } ]
  }, {
    "tStartMs": 547820,
    "dDurationMs": 2762,
    "segs": [ {
      "utf8": "step turns on the strongest protection on your money."
    } ]
  }, {
    "tStartMs": 551242,
    "dDurationMs": 1441,
    "segs": [ {
      "utf8": "Then make one phone call."
    } ]
  }, {
    "tStartMs": 553143,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "The script is always the same."
    } ]
  }, {
    "tStartMs": 555305,
    "dDurationMs": 3262,
    "segs": [ {
      "utf8": "You name the law, you say the charge is not allowed, and"
    } ]
  }, {
    "tStartMs": 558567,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "you ask them to remove it and refund you."
    } ]
  }, {
    "tStartMs": 561068,
    "dDurationMs": 2682,
    "segs": [ {
      "utf8": "You do not need to be angry, and you do not need"
    } ]
  }, {
    "tStartMs": 563750,
    "dDurationMs": 640,
    "segs": [ {
      "utf8": "to be a lawyer."
    } ]
  }, {
    "tStartMs": 564970,
    "dDurationMs": 3142,
    "segs": [ {
      "utf8": "You only need to be one person who knows the rule."
    } ]
  }, {
    "tStartMs": 568352,
    "dDurationMs": 3342,
    "segs": [ {
      "utf8": "And keep one simple habit from now on."
    } ]
  }, {
    "tStartMs": 572255,
    "dDurationMs": 3602,
    "segs": [ {
      "utf8": "Never pay a bill the moment it arrives just because it arrived."
    } ]
  }, {
    "tStartMs": 576617,
    "dDurationMs": 4083,
    "segs": [ {
      "utf8": "Open it, read it, and ask one quiet question first."
    } ]
  }, {
    "tStartMs": 581420,
    "dDurationMs": 2481,
    "segs": [ {
      "utf8": "Are they actually allowed to charge me this?"
    } ]
  }, {
    "tStartMs": 584462,
    "dDurationMs": 3422,
    "segs": [ {
      "utf8": "So before you go, do one kind thing."
    } ]
  }, {
    "tStartMs": 588544,
    "dDurationMs": 3722,
    "segs": [ {
      "utf8": "Think of one person you love who pays every bill the moment"
    } ]
  }, {
    "tStartMs": 592266,
    "dDurationMs": 4123,
    "segs": [ {
      "utf8": "it arrives without ever reading a line of it because they were"
    } ]
  }, {
    "tStartMs": 596389,
    "dDurationMs": 3782,
    "segs": [ {
      "utf8": "raised to believe that is simply the honest thing to do."
    } ]
  }, {
    "tStartMs": 600951,
    "dDurationMs": 1381,
    "segs": [ {
      "utf8": "Send them this video today."
    } ]
  }, {
    "tStartMs": 603053,
    "dDurationMs": 3262,
    "segs": [ {
      "utf8": "It costs two minutes and it could put real money back into"
    } ]
  }, {
    "tStartMs": 606315,
    "dDurationMs": 3602,
    "segs": [ {
      "utf8": "their pocket every single month for the rest of their life."
    } ]
  }, {
    "tStartMs": 610817,
    "dDurationMs": 2882,
    "segs": [ {
      "utf8": "There are very few things you can hand another person that do"
    } ]
  }, {
    "tStartMs": 613699,
    "dDurationMs": 580,
    "segs": [ {
      "utf8": "that."
    } ]
  }, {
    "tStartMs": 614900,
    "dDurationMs": 3682,
    "segs": [ {
      "utf8": "So go on and help them stop paying what they were never"
    } ]
  }, {
    "tStartMs": 618582,
    "dDurationMs": 2922,
    "segs": [ {
      "utf8": "required to pay. I will see you in the next one."
    } ]
  } ]
}
