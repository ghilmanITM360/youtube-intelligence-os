{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "There is a line running through your\nmoney."
    } ]
  }, {
    "tStartMs": 3280,
    "dDurationMs": 3140,
    "segs": [ {
      "utf8": "On one side is everything they cannot\nreach."
    } ]
  }, {
    "tStartMs": 6840,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "On the other is everything they can."
    } ]
  }, {
    "tStartMs": 10160,
    "dDurationMs": 5260,
    "segs": [ {
      "utf8": "Almost nobody over sixty five knows where\nthat line falls in their own accounts."
    } ]
  }, {
    "tStartMs": 16160,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "They know it in a rough way. They have\nheard that a pension is safe, that Social"
    } ]
  }, {
    "tStartMs": 21360,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "Security is protected. Both of those\nsentences are half true, and the half"
    } ]
  }, {
    "tStartMs": 26500,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "that is missing is the half that costs\nmoney."
    } ]
  }, {
    "tStartMs": 30000,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Here is what is happening while you watch\nthis."
    } ]
  }, {
    "tStartMs": 33660,
    "dDurationMs": 3640,
    "segs": [ {
      "utf8": "Four hundred and fifty two thousand people\nwho receive a Social Security check"
    } ]
  }, {
    "tStartMs": 37300,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "are behind on a student loan."
    } ]
  }, {
    "tStartMs": 39920,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Collection on those loans has already\nrestarted."
    } ]
  }, {
    "tStartMs": 43200,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "The part that reaches into a monthly check\nis the part that has not started"
    } ]
  }, {
    "tStartMs": 47100,
    "dDurationMs": 4980,
    "segs": [ {
      "utf8": "yet. When it does, the law allows fifteen\nper cent of the check to be taken."
    } ]
  }, {
    "tStartMs": 52660,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "It protects the first seven hundred and\nfifty dollars."
    } ]
  }, {
    "tStartMs": 55600,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "That figure has not been raised since\nnineteen ninety eight."
    } ]
  }, {
    "tStartMs": 59420,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "There are seven things that cannot be\ntaken from you."
    } ]
  }, {
    "tStartMs": 62640,
    "dDurationMs": 4360,
    "segs": [ {
      "utf8": "Six of them hold. The seventh is where\nmost people find out they were standing"
    } ]
  }, {
    "tStartMs": 67000,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "on the wrong side of the line."
    } ]
  }, {
    "tStartMs": 69380,
    "dDurationMs": 4520,
    "segs": [ {
      "utf8": "Number one. The retirement plan you got\nthrough work has no dollar limit on"
    } ]
  }, {
    "tStartMs": 73900,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "it at all. Not a high limit. No limit at\nall."
    } ]
  }, {
    "tStartMs": 77580,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "That is worth hearing twice, because\nalmost nobody believes it the first time."
    } ]
  }, {
    "tStartMs": 82460,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "If you worked somewhere and paid into a\nplan through the payroll, that money"
    } ]
  }, {
    "tStartMs": 86640,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "sits under a federal rule that says a\ncreditor cannot reach it."
    } ]
  }, {
    "tStartMs": 91260,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "Not a credit card company. Not a hospital."
    } ]
  }, {
    "tStartMs": 94060,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Not a company that bought an old debt of\nyours for pennies."
    } ]
  }, {
    "tStartMs": 97220,
    "dDurationMs": 1920,
    "segs": [ {
      "utf8": "Not a court judgment from a lawsuit."
    } ]
  }, {
    "tStartMs": 99580,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "There is no ceiling written into it."
    } ]
  }, {
    "tStartMs": 102380,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "A person with four hundred thousand\ndollars in that plan is covered on all"
    } ]
  }, {
    "tStartMs": 106200,
    "dDurationMs": 2640,
    "segs": [ {
      "utf8": "of it, the same as a person with forty\nthousand."
    } ]
  }, {
    "tStartMs": 109320,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "Understand how unusual that is."
    } ]
  }, {
    "tStartMs": 112560,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Almost every protection in American law\ncomes with a number attached."
    } ]
  }, {
    "tStartMs": 116460,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "This one does not. And there is a reason\nso few people know it."
    } ]
  }, {
    "tStartMs": 121580,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "The protection lives in the plan, not in\nthe person."
    } ]
  }, {
    "tStartMs": 125640,
    "dDurationMs": 2820,
    "segs": [ {
      "utf8": "Nobody writes to tell you about a rule\nthat protects you."
    } ]
  }, {
    "tStartMs": 129040,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "You would only ever learn it from somebody\ntrying to collect, and it is the"
    } ]
  }, {
    "tStartMs": 133240,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "last thing they would say out loud."
    } ]
  }, {
    "tStartMs": 135440,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "If you are on the telephone with a"
    } ]
  }, {
    "tStartMs": 137200,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "collector and there is money in a work\nretirement"
    } ]
  }, {
    "tStartMs": 139700,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "plan, that money is not theirs to discuss."
    } ]
  }, {
    "tStartMs": 143060,
    "dDurationMs": 3440,
    "segs": [ {
      "utf8": "It is not an asset they are entitled to\ndiscuss."
    } ]
  }, {
    "tStartMs": 147180,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Number two. The account you opened\nyourself is a different animal, and this"
    } ]
  }, {
    "tStartMs": 151560,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "is where people get hurt. A great many\npeople have both."
    } ]
  }, {
    "tStartMs": 155080,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "A plan from an employer, and an account\nthey opened at a bank or a brokerage"
    } ]
  }, {
    "tStartMs": 159160,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "on their own. They think of it as one pot\nof retirement money."
    } ]
  }, {
    "tStartMs": 163060,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "The law does not."
    } ]
  }, {
    "tStartMs": 165020,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Here is the split, and it is worth hearing\ntwice."
    } ]
  }, {
    "tStartMs": 167740,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "If the money in your own account came out\nof an employer plan and was moved"
    } ]
  }, {
    "tStartMs": 172000,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "across, it carries the full protection\nwith it."
    } ]
  }, {
    "tStartMs": 175140,
    "dDurationMs": 2320,
    "segs": [ {
      "utf8": "No limit. It keeps what it had."
    } ]
  }, {
    "tStartMs": 178040,
    "dDurationMs": 4040,
    "segs": [ {
      "utf8": "If you opened it and paid into it yourself\nover the years, the protection stops"
    } ]
  }, {
    "tStartMs": 182080,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "at about one million seven hundred\nthousand dollars."
    } ]
  }, {
    "tStartMs": 184680,
    "dDurationMs": 1840,
    "segs": [ {
      "utf8": "And that is not for each account."
    } ]
  }, {
    "tStartMs": 186980,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "That is for every account of that kind you\nown, added together."
    } ]
  }, {
    "tStartMs": 191440,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Now, most people watching this are nowhere\nnear that figure, and there is no"
    } ]
  }, {
    "tStartMs": 195360,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "point pretending otherwise. So why does it\nmatter."
    } ]
  }, {
    "tStartMs": 199040,
    "dDurationMs": 3120,
    "segs": [ {
      "utf8": "It matters because of what it tells you\nabout the second kind of account."
    } ]
  }, {
    "tStartMs": 203000,
    "dDurationMs": 3840,
    "segs": [ {
      "utf8": "It is protected by a different rule, a\nweaker one, and one that was written"
    } ]
  }, {
    "tStartMs": 206840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "for a courtroom most people will never\nsee."
    } ]
  }, {
    "tStartMs": 209900,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "Number three. Outside of a bankruptcy\ncourt, that second kind of account has"
    } ]
  }, {
    "tStartMs": 214280,
    "dDurationMs": 4540,
    "segs": [ {
      "utf8": "no federal shield at all. That sentence is\nthe one to carry out of this video."
    } ]
  }, {
    "tStartMs": 219300,
    "dDurationMs": 2760,
    "segs": [ {
      "utf8": "The limit I just described is a bankruptcy\nrule."
    } ]
  }, {
    "tStartMs": 222360,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "It applies when somebody files."
    } ]
  }, {
    "tStartMs": 223940,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "If you never file, and a creditor simply\nsues you and wins, that rule is not"
    } ]
  }, {
    "tStartMs": 229300,
    "dDurationMs": 2860,
    "segs": [ {
      "utf8": "in the room. What decides it then is your\nown state."
    } ]
  }, {
    "tStartMs": 232160,
    "dDurationMs": 2360,
    "segs": [ {
      "utf8": "And the states are not close to each\nother."
    } ]
  }, {
    "tStartMs": 235020,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Some protect that account completely, the\nsame as a work plan."
    } ]
  }, {
    "tStartMs": 238380,
    "dDurationMs": 2880,
    "segs": [ {
      "utf8": "Some protect a portion. Some protect very\nlittle."
    } ]
  }, {
    "tStartMs": 241760,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "A person in one state can be untouchable."
    } ]
  }, {
    "tStartMs": 244360,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "A person two hundred miles away is not,\nwith the same money, in the same kind"
    } ]
  }, {
    "tStartMs": 248780,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "of account, at the same bank. There is no\nletter that tells you which one you"
    } ]
  }, {
    "tStartMs": 252800,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "are. There is no notice. The first time\nmost people find out is when somebody"
    } ]
  }, {
    "tStartMs": 257540,
    "dDurationMs": 3740,
    "segs": [ {
      "utf8": "is already trying to collect, which is the\nworst moment there is to learn it."
    } ]
  }, {
    "tStartMs": 261820,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "So find out now, while nothing is wrong."
    } ]
  }, {
    "tStartMs": 264400,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "Your state legal aid office handles this\nevery day and does it free for people"
    } ]
  }, {
    "tStartMs": 268300,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "over sixty. Ask them one question."
    } ]
  }, {
    "tStartMs": 271120,
    "dDurationMs": 4100,
    "segs": [ {
      "utf8": "In this state, is a retirement account I\nopened myself protected from a judgment."
    } ]
  }, {
    "tStartMs": 275600,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "That is a five minute call, and the answer\nchanges what happens to that money."
    } ]
  }, {
    "tStartMs": 279680,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "Number four. The money stops being\nprotected the moment it leaves."
    } ]
  }, {
    "tStartMs": 284580,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Same dollar. Different rules. Sitting in\nthe account it cannot be touched."
    } ]
  }, {
    "tStartMs": 288640,
    "dDurationMs": 1680,
    "segs": [ {
      "utf8": "Sitting in your checking account it can."
    } ]
  }, {
    "tStartMs": 290860,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "This is the one that catches careful\npeople, and it catches them while they"
    } ]
  }, {
    "tStartMs": 294080,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "are doing something sensible. Somebody\ntakes a withdrawal to cover a roof,"
    } ]
  }, {
    "tStartMs": 298000,
    "dDurationMs": 5060,
    "segs": [ {
      "utf8": "or a car, or a medical bill. The money\nlands in checking and sits there for"
    } ]
  }, {
    "tStartMs": 303060,
    "dDurationMs": 1880,
    "segs": [ {
      "utf8": "three weeks while they arrange the work."
    } ]
  }, {
    "tStartMs": 305540,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "During those three weeks it is ordinary\nmoney, with none of the protection"
    } ]
  }, {
    "tStartMs": 309420,
    "dDurationMs": 1800,
    "segs": [ {
      "utf8": "it had on the morning it left."
    } ]
  }, {
    "tStartMs": 311380,
    "dDurationMs": 4460,
    "segs": [ {
      "utf8": "If there is a judgment against that\nperson, or one arrives during those weeks,"
    } ]
  }, {
    "tStartMs": 316240,
    "dDurationMs": 3180,
    "segs": [ {
      "utf8": "that money is reachable and the money it\ncame from was not."
    } ]
  }, {
    "tStartMs": 319840,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "So the rule is narrow and it is easy."
    } ]
  }, {
    "tStartMs": 322840,
    "dDurationMs": 2240,
    "segs": [ {
      "utf8": "Do not move money out before you need it."
    } ]
  }, {
    "tStartMs": 325380,
    "dDurationMs": 3340,
    "segs": [ {
      "utf8": "Move it when the bill is in front of you,\nnot when you are thinking about the"
    } ]
  }, {
    "tStartMs": 328720,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "bill. And if somebody has already sued\nyou, or you think they are about to,"
    } ]
  }, {
    "tStartMs": 332940,
    "dDurationMs": 3220,
    "segs": [ {
      "utf8": "do not take a withdrawal at all until you\nhave spoken to somebody."
    } ]
  }, {
    "tStartMs": 336860,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "Taking your own money out of a protected\nplace, in that situation, is the single"
    } ]
  }, {
    "tStartMs": 341160,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "most expensive thing you can do by\naccident."
    } ]
  }, {
    "tStartMs": 344380,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "Number five. There are three doors that\nopen in a plan that is otherwise shut."
    } ]
  }, {
    "tStartMs": 349140,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "I would rather you heard these from me\nthan found them the hard way."
    } ]
  }, {
    "tStartMs": 352600,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The first is the government collecting tax\nit says you owe."
    } ]
  }, {
    "tStartMs": 355960,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "A work retirement plan is closed to\nprivate creditors and it is not closed"
    } ]
  }, {
    "tStartMs": 360120,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "to the tax authority. That is the largest\nexception and it is the one people"
    } ]
  }, {
    "tStartMs": 364320,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "are most surprised by. The second is a\ncourt order from a divorce."
    } ]
  }, {
    "tStartMs": 368460,
    "dDurationMs": 3880,
    "segs": [ {
      "utf8": "If a court divided that plan between two\npeople, that order reaches inside"
    } ]
  }, {
    "tStartMs": 372340,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "it. The plan does not overrule the court."
    } ]
  }, {
    "tStartMs": 375300,
    "dDurationMs": 1760,
    "segs": [ {
      "utf8": "The third is certain criminal penalties."
    } ]
  }, {
    "tStartMs": 377620,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Narrow, rare, and worth knowing exists."
    } ]
  }, {
    "tStartMs": 380000,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "Everything else stays outside."
    } ]
  }, {
    "tStartMs": 382000,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "A hospital bill, a card, a store account,\nan old debt sold on, a judgment from"
    } ]
  }, {
    "tStartMs": 386720,
    "dDurationMs": 2260,
    "segs": [ {
      "utf8": "a fall on land that belongs to somebody\nelse."
    } ]
  }, {
    "tStartMs": 389300,
    "dDurationMs": 4260,
    "segs": [ {
      "utf8": "All outside. So when somebody tells you\nyour retirement money can be taken,"
    } ]
  }, {
    "tStartMs": 393860,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "the honest answer is that three specific\nthings can reach it and nothing else"
    } ]
  }, {
    "tStartMs": 398020,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "can. Ask which of the three they mean."
    } ]
  }, {
    "tStartMs": 401080,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "Most of the time they cannot answer,\nbecause they were repeating something"
    } ]
  }, {
    "tStartMs": 403980,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "they heard."
    } ]
  }, {
    "tStartMs": 405260,
    "dDurationMs": 4160,
    "segs": [ {
      "utf8": "Number six. When one of a married couple\ngoes into care, there is an amount"
    } ]
  }, {
    "tStartMs": 409420,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "the one at home is allowed to keep."
    } ]
  }, {
    "tStartMs": 411400,
    "dDurationMs": 5680,
    "segs": [ {
      "utf8": "This is the item almost nobody knows, and\nit decides what a widow lives on."
    } ]
  }, {
    "tStartMs": 417080,
    "dDurationMs": 4760,
    "segs": [ {
      "utf8": "When a husband or a wife goes into a\nnursing home and the state pays for that"
    } ]
  }, {
    "tStartMs": 421840,
    "dDurationMs": 3020,
    "segs": [ {
      "utf8": "care, the state looks at the money the\ncouple has."
    } ]
  }, {
    "tStartMs": 425680,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "People assume that means everything is\ncounted and everything must be spent."
    } ]
  }, {
    "tStartMs": 430180,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "That is not what the rule says."
    } ]
  }, {
    "tStartMs": 432780,
    "dDurationMs": 4780,
    "segs": [ {
      "utf8": "The one still living at home keeps a share\nof what the couple built, plus their"
    } ]
  }, {
    "tStartMs": 437560,
    "dDurationMs": 2540,
    "segs": [ {
      "utf8": "own income, plus the house they live in."
    } ]
  }, {
    "tStartMs": 440420,
    "dDurationMs": 5140,
    "segs": [ {
      "utf8": "The figures move every year and they\ndiffer by state, so naming one would only"
    } ]
  }, {
    "tStartMs": 445560,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "be wrong where you live. What I want you\nto hear is that the amount is not"
    } ]
  }, {
    "tStartMs": 449760,
    "dDurationMs": 4740,
    "segs": [ {
      "utf8": "small, it is not a kindness, and it is not\nsomething you have to argue for."
    } ]
  }, {
    "tStartMs": 454920,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It is written down."
    } ]
  }, {
    "tStartMs": 456800,
    "dDurationMs": 3260,
    "segs": [ {
      "utf8": "And here is why it matters on a video\nabout what cannot be taken."
    } ]
  }, {
    "tStartMs": 460940,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "Families spend money they were entitled to\nkeep, because somebody at a kitchen"
    } ]
  }, {
    "tStartMs": 464920,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "table decided that the rules must require\nit, and nobody checked."
    } ]
  }, {
    "tStartMs": 469360,
    "dDurationMs": 3480,
    "segs": [ {
      "utf8": "So before a single dollar is spent down,\nmake one call."
    } ]
  }, {
    "tStartMs": 473280,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "Your state legal aid office, or your area\nagency on aging."
    } ]
  }, {
    "tStartMs": 477540,
    "dDurationMs": 3760,
    "segs": [ {
      "utf8": "Ask what the one still at home keeps this\nyear, in this state."
    } ]
  }, {
    "tStartMs": 481880,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "Number seven. Fifteen per cent, and a\nfloor set in nineteen ninety eight."
    } ]
  }, {
    "tStartMs": 487260,
    "dDurationMs": 2340,
    "segs": [ {
      "utf8": "Everything above is about private\ncreditors."
    } ]
  }, {
    "tStartMs": 490360,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "This one is the government, and it is the\nreason this video exists now rather"
    } ]
  }, {
    "tStartMs": 494960,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "than last year. There are three point two\nmillion people aged sixty two and"
    } ]
  }, {
    "tStartMs": 499580,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "over carrying federal student loan debt."
    } ]
  }, {
    "tStartMs": 502940,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "Nearly one hundred and forty four billion\ndollars of it."
    } ]
  }, {
    "tStartMs": 506080,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Some of it is their own, from going back\nto study."
    } ]
  }, {
    "tStartMs": 509080,
    "dDurationMs": 4480,
    "segs": [ {
      "utf8": "A great deal of it is not. It was borrowed\nfor a child or a grandchild, and"
    } ]
  }, {
    "tStartMs": 513560,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "the older person signed."
    } ]
  }, {
    "tStartMs": 515460,
    "dDurationMs": 4020,
    "segs": [ {
      "utf8": "Of those, the number already behind and\ndrawing a Social Security check is"
    } ]
  }, {
    "tStartMs": 519480,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "the one from the start of this video."
    } ]
  }, {
    "tStartMs": 521840,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "When a federal student loan is in default,\nthe government can take up to fifteen"
    } ]
  }, {
    "tStartMs": 525960,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "per cent of that check before it ever\nreaches the account."
    } ]
  }, {
    "tStartMs": 529580,
    "dDurationMs": 2840,
    "segs": [ {
      "utf8": "It does not need to sue. It does not need\na judge."
    } ]
  }, {
    "tStartMs": 532780,
    "dDurationMs": 4220,
    "segs": [ {
      "utf8": "There is no court in it. The protected\nfloor is seven hundred and fifty dollars"
    } ]
  }, {
    "tStartMs": 537000,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "a month. Below that they take nothing."
    } ]
  }, {
    "tStartMs": 540080,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "Above it, they can take fifteen per cent."
    } ]
  }, {
    "tStartMs": 542260,
    "dDurationMs": 1520,
    "segs": [ {
      "utf8": "Sit with the year on that figure."
    } ]
  }, {
    "tStartMs": 544300,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "Nineteen ninety eight."
    } ]
  }, {
    "tStartMs": 545640,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "It has not moved since."
    } ]
  }, {
    "tStartMs": 547660,
    "dDurationMs": 3060,
    "segs": [ {
      "utf8": "Everything a person buys has moved and\nthat floor has not."
    } ]
  }, {
    "tStartMs": 551160,
    "dDurationMs": 2960,
    "segs": [ {
      "utf8": "Where it stands right now is the part\npeople are getting wrong."
    } ]
  }, {
    "tStartMs": 554120,
    "dDurationMs": 2980,
    "segs": [ {
      "utf8": "Collection on these loans restarted this\nyear."
    } ]
  }, {
    "tStartMs": 557680,
    "dDurationMs": 3660,
    "segs": [ {
      "utf8": "The piece that reaches into Social\nSecurity checks was held back in January"
    } ]
  }, {
    "tStartMs": 561340,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "and has not switched on yet. A bill"
    } ]
  }, {
    "tStartMs": 563760,
    "dDurationMs": 2160,
    "segs": [ {
      "utf8": "was introduced in August to stop it\npermanently."
    } ]
  }, {
    "tStartMs": 566420,
    "dDurationMs": 1200,
    "segs": [ {
      "utf8": "It has not passed."
    } ]
  }, {
    "tStartMs": 568140,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "So the position tonight is that it is\npaused, not cancelled, and nobody is"
    } ]
  }, {
    "tStartMs": 572640,
    "dDurationMs": 2440,
    "segs": [ {
      "utf8": "going to write and warn you the week\nbefore it changes."
    } ]
  }, {
    "tStartMs": 575920,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "One payment sits fully outside all of it."
    } ]
  }, {
    "tStartMs": 578640,
    "dDurationMs": 4600,
    "segs": [ {
      "utf8": "The payment called, the payment known as\nSSI cannot be touched for this."
    } ]
  }, {
    "tStartMs": 583240,
    "dDurationMs": 2720,
    "segs": [ {
      "utf8": "Not at any amount, not by anybody."
    } ]
  }, {
    "tStartMs": 586380,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "And there are three ways out that exist\nright now, while it is still paused."
    } ]
  }, {
    "tStartMs": 591880,
    "dDurationMs": 3860,
    "segs": [ {
      "utf8": "Nine payments on time over ten months\ntakes a loan out of default."
    } ]
  }, {
    "tStartMs": 596380,
    "dDurationMs": 3580,
    "segs": [ {
      "utf8": "A person too ill to work can apply to have\nthe debt wiped out entirely."
    } ]
  }, {
    "tStartMs": 600400,
    "dDurationMs": 3980,
    "segs": [ {
      "utf8": "And anybody can file a hardship objection\nbefore an offset begins."
    } ]
  }, {
    "tStartMs": 605100,
    "dDurationMs": 3040,
    "segs": [ {
      "utf8": "Every one of those has to be started\nbefore the money moves."
    } ]
  }, {
    "tStartMs": 608840,
    "dDurationMs": 3080,
    "segs": [ {
      "utf8": "Afterwards is a different talk, and a much\nworse one."
    } ]
  }, {
    "tStartMs": 611920,
    "dDurationMs": 5240,
    "segs": [ {
      "utf8": "So, seven things, and which side of the\nline each one sits on."
    } ]
  }, {
    "tStartMs": 617700,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "The plan you got through work is closed to\nprivate creditors with no dollar"
    } ]
  }, {
    "tStartMs": 621380,
    "dDurationMs": 4820,
    "segs": [ {
      "utf8": "limit. The one you opened yourself is\ncapped, and only inside a bankruptcy."
    } ]
  }, {
    "tStartMs": 626680,
    "dDurationMs": 2480,
    "segs": [ {
      "utf8": "Outside a bankruptcy, your state decides\nit."
    } ]
  }, {
    "tStartMs": 629740,
    "dDurationMs": 3360,
    "segs": [ {
      "utf8": "Money that leaves the account loses\neverything the account gave it."
    } ]
  }, {
    "tStartMs": 633540,
    "dDurationMs": 3620,
    "segs": [ {
      "utf8": "Three doors open in a work plan, and the\ntax authority is the widest."
    } ]
  }, {
    "tStartMs": 637160,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "When one of a couple goes into care, the\nother keeps a share, a house and an"
    } ]
  }, {
    "tStartMs": 642360,
    "dDurationMs": 4620,
    "segs": [ {
      "utf8": "income. And a defaulted student loan\nreaches a Social Security check without"
    } ]
  }, {
    "tStartMs": 646980,
    "dDurationMs": 4705,
    "segs": [ {
      "utf8": "a judge, up to fifteen per cent, above a\nfloor that was set in nineteen ninety"
    } ]
  }, {
    "tStartMs": 651685,
    "dDurationMs": 1135,
    "segs": [ {
      "utf8": "eight."
    } ]
  }, {
    "tStartMs": 652860,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "Six of those protect you. One of them does\nnot."
    } ]
  }, {
    "tStartMs": 655880,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "And the one that does not is the only one\nmoving this month."
    } ]
  }, {
    "tStartMs": 659760,
    "dDurationMs": 2120,
    "segs": [ {
      "utf8": "Nothing here is advice about you in\nparticular."
    } ]
  }, {
    "tStartMs": 662600,
    "dDurationMs": 3820,
    "segs": [ {
      "utf8": "States write their own figures, and yours\nwill not be the ones spoken tonight."
    } ]
  }, {
    "tStartMs": 666420,
    "dDurationMs": 4420,
    "segs": [ {
      "utf8": "One last thing. Nobody legitimate\ntelephones about any of this."
    } ]
  }, {
    "tStartMs": 671420,
    "dDurationMs": 3680,
    "segs": [ {
      "utf8": "If a call says your retirement account is\nat risk and there is a fee to protect"
    } ]
  }, {
    "tStartMs": 675100,
    "dDurationMs": 2380,
    "segs": [ {
      "utf8": "it, that is a fraud, every time."
    } ]
  }, {
    "tStartMs": 678040,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "The protection is already yours and it\ncosts nothing."
    } ]
  }, {
    "tStartMs": 681520,
    "dDurationMs": 4180,
    "segs": [ {
      "utf8": "And if you are helping somebody with a\nloan they signed for a grandchild, do"
    } ]
  }, {
    "tStartMs": 685700,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "not ask them how much it is. Ask them one\nthing."
    } ]
  }, {
    "tStartMs": 689060,
    "dDurationMs": 1940,
    "segs": [ {
      "utf8": "Is it in default right now."
    } ]
  } ]
}
