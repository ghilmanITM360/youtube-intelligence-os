  }, {
    "tStartMs": 359242,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "you the entire house."
    } ]
  }, {
    "tStartMs": 361222,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "If you fall behind on your property taxes,"
    } ]
  }, {
    "tStartMs": 364083,
    "dDurationMs": 2061,
    "segs": [ {
      "utf8": "your county can place a lien on your home,"
    } ]
  }, {
    "tStartMs": 366144,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "and if the taxes stay unpaid,"
    } ]
  }, {
    "tStartMs": 368625,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "the county can eventually foreclose and sell your paid-off"
    } ]
  }, {
    "tStartMs": 371606,
    "dDurationMs": 1480,
    "segs": [ {
      "utf8": "house at a tax sale,"
    } ]
  }, {
    "tStartMs": 373086,
    "dDurationMs": 2421,
    "segs": [ {
      "utf8": "over a debt that may be only a few"
    } ]
  }, {
    "tStartMs": 375507,
    "dDurationMs": 880,
    "segs": [ {
      "utf8": "thousand dollars."
    } ]
  }, {
    "tStartMs": 377148,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "For years, in many states,"
    } ]
  }, {
    "tStartMs": 379008,
    "dDurationMs": 1581,
    "segs": [ {
      "utf8": "it was even crueler than that."
    } ]
  }, {
    "tStartMs": 381049,
    "dDurationMs": 1561,
    "segs": [ {
      "utf8": "The county would sell the home,"
    } ]
  }, {
    "tStartMs": 382970,
    "dDurationMs": 2140,
    "segs": [ {
      "utf8": "take the few thousand dollars it was owed,"
    } ]
  }, {
    "tStartMs": 385110,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "and keep all the rest of your equity,"
    } ]
  }, {
    "tStartMs": 388191,
    "dDurationMs": 3102,
    "segs": [ {
      "utf8": "tens or even hundreds of thousands of dollars that"
    } ]
  }, {
    "tStartMs": 391293,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "belonged to you and your family."
    } ]
  }, {
    "tStartMs": 393393,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "In twenty twenty three, the Supreme Court of the"
    } ]
  }, {
    "tStartMs": 396294,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "United States finally ruled that this practice,"
    } ]
  }, {
    "tStartMs": 399595,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "keeping the surplus, is unconstitutional,"
    } ]
  }, {
    "tStartMs": 402936,
    "dDurationMs": 2561,
    "segs": [ {
      "utf8": "so today the county must return the extra money"
    } ]
  }, {
    "tStartMs": 405497,
    "dDurationMs": 501,
    "segs": [ {
      "utf8": "to you."
    } ]
  }, {
    "tStartMs": 406798,
    "dDurationMs": 3161,
    "segs": [ {
      "utf8": "But hear me clearly, you still lose the house."
    } ]
  }, {
    "tStartMs": 410599,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "Getting a check for the leftover after they have"
    } ]
  }, {
    "tStartMs": 413120,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "sold your home out from under you is not"
    } ]
  }, {
    "tStartMs": 415721,
    "dDurationMs": 560,
    "segs": [ {
      "utf8": "protection."
    } ]
  }, {
    "tStartMs": 417221,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "So here is the part almost no senior knows."
    } ]
  }, {
    "tStartMs": 420382,
    "dDurationMs": 2821,
    "segs": [ {
      "utf8": "In most states, once you reach a certain age,"
    } ]
  }, {
    "tStartMs": 423603,
    "dDurationMs": 2781,
    "segs": [ {
      "utf8": "you can apply to have your property taxes reduced,"
    } ]
  }, {
    "tStartMs": 426805,
    "dDurationMs": 3341,
    "segs": [ {
      "utf8": "frozen, or in many places deferred entirely,"
    } ]
  }, {
    "tStartMs": 430426,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "which means you do not pay them now at"
    } ]
  }, {
    "tStartMs": 432647,
    "dDurationMs": 280,
    "segs": [ {
      "utf8": "all."
    } ]
  }, {
    "tStartMs": 433327,
    "dDurationMs": 3501,
    "segs": [ {
      "utf8": "The state quietly carries the bill and settles it"
    } ]
  }, {
    "tStartMs": 436828,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "much later, out of the home,"
    } ]
  }, {
    "tStartMs": 438789,
    "dDurationMs": 1820,
    "segs": [ {
      "utf8": "usually at a low rate of interest."
    } ]
  }, {
    "tStartMs": 441129,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "For a senior on a fixed income who lies"
    } ]
  }, {
    "tStartMs": 443590,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "awake afraid of losing the house over a tax"
    } ]
  }, {
    "tStartMs": 445951,
    "dDurationMs": 3241,
    "segs": [ {
      "utf8": "bill, that one application changes everything."
    } ]
  }, {
    "tStartMs": 449952,
    "dDurationMs": 1541,
    "segs": [ {
      "utf8": "But it is never automatic."
    } ]
  }, {
    "tStartMs": 452033,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "You have to call your county and ask for"
    } ]
  }, {
    "tStartMs": 454174,
    "dDurationMs": 680,
    "segs": [ {
      "utf8": "it by name."
    } ]
  }, {
    "tStartMs": 455434,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "The fourth threat does not come from the government"
    } ]
  }, {
    "tStartMs": 458135,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "at all."
    } ]
  }, {
    "tStartMs": 459196,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "It comes from criminals, and they hunt on purpose"
    } ]
  }, {
    "tStartMs": 462177,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "for people exactly like you,"
    } ]
  }, {
    "tStartMs": 464998,
    "dDurationMs": 2280,
    "segs": [ {
      "utf8": "seniors who own their homes free and clear."
    } ]
  }, {
    "tStartMs": 467778,
    "dDurationMs": 1701,
    "segs": [ {
      "utf8": "It is called deed fraud,"
    } ]
  }, {
    "tStartMs": 469479,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "or home title theft."
    } ]
  }, {
    "tStartMs": 471860,
    "dDurationMs": 1140,
    "segs": [ {
      "utf8": "Here is how it works."
    } ]
  }, {
    "tStartMs": 473600,
    "dDurationMs": 2221,
    "segs": [ {
      "utf8": "A thief uses your personal information,"
    } ]
  }, {
    "tStartMs": 475821,
    "dDurationMs": 2601,
    "segs": [ {
      "utf8": "much of which is already sitting online,"
    } ]
  }, {
    "tStartMs": 478802,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "to forge your signature on a deed,"
    } ]
  }, {
    "tStartMs": 480723,
    "dDurationMs": 3501,
    "segs": [ {
      "utf8": "and then files that deed at the county recorder's"
    } ]
  }, {
    "tStartMs": 484224,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "office to make it look as though you sold"
    } ]
  }, {
    "tStartMs": 486505,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "or transferred your home to them."
    } ]
  }, {
    "tStartMs": 489586,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "Then they try to borrow against it,"
    } ]
  }, {
    "tStartMs": 491947,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "or sell it out from under you."
    } ]
  }, {
    "tStartMs": 493847,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "And the people they target most are older homeowners"
    } ]
  }, {
    "tStartMs": 497308,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "with a lot of equity and no mortgage,"
    } ]
  }, {
    "tStartMs": 500830,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "because those owners often are not checking their property"
    } ]
  }, {
    "tStartMs": 503731,
    "dDurationMs": 1280,
    "segs": [ {
      "utf8": "records week to week."
    } ]
  }, {
    "tStartMs": 505831,
    "dDurationMs": 2441,
    "segs": [ {
      "utf8": "Picture a widow who has lived alone in her"
    } ]
  }, {
    "tStartMs": 508272,
    "dDurationMs": 1461,
    "segs": [ {
      "utf8": "paid-off home for years."
    } ]
  }, {
    "tStartMs": 510613,
    "dDurationMs": 1921,
    "segs": [ {
      "utf8": "She has no reason to look at the county"
    } ]
  }, {
    "tStartMs": 512534,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "records, so she has no idea that a stranger"
    } ]
  }, {
    "tStartMs": 515495,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "has filed a forged deed and taken out a"
    } ]
  }, {
    "tStartMs": 518336,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "loan against her house, until the day a foreclosure"
    } ]
  }, {
    "tStartMs": 521717,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "notice arrives for a mortgage she never signed."
    } ]
  }, {
    "tStartMs": 524998,
    "dDurationMs": 3381,
    "segs": [ {
      "utf8": "By then she is fighting to prove she still"
    } ]
  }, {
    "tStartMs": 528379,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "owns the home she has slept in every night"
    } ]
  }, {
    "tStartMs": 531220,
    "dDurationMs": 1160,
    "segs": [ {
      "utf8": "for thirty years."
    } ]
  }, {
    "tStartMs": 532921,
    "dDurationMs": 1640,
    "segs": [ {
      "utf8": "This is not a rare story."
    } ]
  }, {
    "tStartMs": 534561,
    "dDurationMs": 3621,
    "segs": [ {
      "utf8": "The Federal Bureau of Investigation has reported that in"
    } ]
  }, {
    "tStartMs": 538182,
    "dDurationMs": 4082,
    "segs": [ {
      "utf8": "a single year, victims aged sixty and older lost"
    } ]
  }, {
    "tStartMs": 542264,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "more than seventy six million dollars to real estate"
    } ]
  }, {
    "tStartMs": 545345,
    "dDurationMs": 460,
    "segs": [ {
      "utf8": "fraud."
    } ]
  }, {
    "tStartMs": 546845,
    "dDurationMs": 3061,
    "segs": [ {
      "utf8": "The good news is that protecting yourself is free"
    } ]
  }, {
    "tStartMs": 549906,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "and takes only a few minutes."
    } ]
  }, {
    "tStartMs": 552247,
    "dDurationMs": 3321,
    "segs": [ {
      "utf8": "Most counties in this country now offer a property"
    } ]
  }, {
    "tStartMs": 555568,
    "dDurationMs": 3581,
    "segs": [ {
      "utf8": "alert service, sometimes called a fraud alert or a"
    } ]
  }, {
    "tStartMs": 559149,
    "dDurationMs": 3542,
    "segs": [ {
      "utf8": "recorder notification, and it costs nothing to sign up."
    } ]
  }, {
    "tStartMs": 562691,
    "dDurationMs": 3081,
    "segs": [ {
      "utf8": "Once you are enrolled, the county sends you an"
    } ]
  }, {
    "tStartMs": 565772,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "email or a letter the moment any document is"
    } ]
  }, {
    "tStartMs": 568693,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "recorded against your home, so if someone ever tries"
    } ]
  }, {
    "tStartMs": 571654,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "to file a fake deed,"
    } ]
  }, {
    "tStartMs": 573334,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "you find out right away,"
    } ]
  }, {
    "tStartMs": 574635,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "while there is still time to stop it."
    } ]
  }, {
    "tStartMs": 577496,
    "dDurationMs": 1860,
    "segs": [ {
      "utf8": "Call your county recorder's office,"
    } ]
  }, {
    "tStartMs": 579356,
    "dDurationMs": 1281,
    "segs": [ {
      "utf8": "or look at their website,"
    } ]
  }, {
    "tStartMs": 580637,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "and ask if they have a property fraud alert"
    } ]
  }, {
    "tStartMs": 583158,
    "dDurationMs": 2560,
    "segs": [ {
      "utf8": "program, and put your name on it today."
    } ]
  }, {
    "tStartMs": 586399,
    "dDurationMs": 2701,
    "segs": [ {
      "utf8": "And if you already have owner's title insurance from"
    } ]
  }, {
    "tStartMs": 589100,
    "dDurationMs": 1080,
    "segs": [ {
      "utf8": "when you bought the home,"
    } ]
  }, {
    "tStartMs": 590180,
    "dDurationMs": 2761,
    "segs": [ {
      "utf8": "hold on to it, because it can help defend"
    } ]
  }, {
    "tStartMs": 592941,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "you if your title is ever attacked."
    } ]
  }, {
    "tStartMs": 595902,
    "dDurationMs": 2241,
    "segs": [ {
      "utf8": "And the fifth threat is the one that arrives"
    } ]
  }, {
    "tStartMs": 598143,
    "dDurationMs": 2801,
    "segs": [ {
      "utf8": "dressed as a gift, in a friendly commercial,"
    } ]
  }, {
    "tStartMs": 601524,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "promising you tax-free cash out of the very home"
    } ]
  }, {
    "tStartMs": 604405,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "you worked so hard to pay off."
    } ]
  }, {
    "tStartMs": 606946,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "It is the reverse mortgage."
    } ]
  }, {
    "tStartMs": 609106,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "Now, I am not going to tell you a"
    } ]
  }, {
    "tStartMs": 611307,
    "dDurationMs": 1601,
    "segs": [ {
      "utf8": "reverse mortgage is always wrong,"
    } ]
  }, {
    "tStartMs": 612908,
    "dDurationMs": 1560,
    "segs": [ {
      "utf8": "because for a few people,"
    } ]
  }, {
    "tStartMs": 614468,
    "dDurationMs": 2921,
    "segs": [ {
      "utf8": "in the right situation, it can be a reasonable"
    } ]
  }, {
    "tStartMs": 617389,
    "dDurationMs": 540,
    "segs": [ {
      "utf8": "choice."
    } ]
  }, {
    "tStartMs": 618750,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "But you must understand what it truly is before"
    } ]
  }, {
    "tStartMs": 621731,
    "dDurationMs": 3281,
    "segs": [ {
      "utf8": "you ever sign, because the marketing hides the sharp"
    } ]
  }, {
    "tStartMs": 625012,
    "dDurationMs": 380,
    "segs": [ {
      "utf8": "edges."
    } ]
  }, {
    "tStartMs": 626572,
    "dDurationMs": 2041,
    "segs": [ {
      "utf8": "A reverse mortgage is not free money."
    } ]
  }, {
    "tStartMs": 629133,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "It is a loan against your home,"
    } ]
  }, {
    "tStartMs": 631174,
    "dDurationMs": 1320,
    "segs": [ {
      "utf8": "and unlike a normal loan,"
    } ]
  }, {
    "tStartMs": 632914,
    "dDurationMs": 2521,
    "segs": [ {
      "utf8": "the balance grows larger every single year,"
    } ]
  }, {
    "tStartMs": 635435,
    "dDurationMs": 3121,
    "segs": [ {
      "utf8": "because the interest is piled on top instead of"
    } ]
  }, {
    "tStartMs": 638556,
    "dDurationMs": 941,
    "segs": [ {
      "utf8": "being paid down."
    } ]
  }, {
    "tStartMs": 639657,
    "dDurationMs": 4041,
    "segs": [ {
      "utf8": "Slowly, quietly, the home you owned free and clear"
    } ]
  }, {
    "tStartMs": 643698,
    "dDurationMs": 1821,
    "segs": [ {
      "utf8": "fills back up with debt,"
    } ]
  }, {
    "tStartMs": 645519,
    "dDurationMs": 2981,
    "segs": [ {
      "utf8": "and the inheritance you meant to leave your family"
    } ]
  }, {
    "tStartMs": 648500,
    "dDurationMs": 2040,
    "segs": [ {
      "utf8": "can shrink to almost nothing."
    } ]
  }, {
    "tStartMs": 651301,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "And here is the part that surprises people the"
    } ]
  }, {
    "tStartMs": 653501,
    "dDurationMs": 360,
    "segs": [ {
      "utf8": "most."
    } ]
  }, {
    "tStartMs": 654382,
    "dDurationMs": 2881,
    "segs": [ {
      "utf8": "You can still lose the home to foreclosure."
    } ]
  }, {
    "tStartMs": 657683,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "Even with a reverse mortgage,"
    } ]
  }, {
    "tStartMs": 659523,
    "dDurationMs": 2741,
    "segs": [ {
      "utf8": "you are still required to pay your property taxes,"
    } ]
  }, {
    "tStartMs": 662825,
    "dDurationMs": 1580,
    "segs": [ {
      "utf8": "keep up your homeowners insurance,"
    } ]
  }, {
    "tStartMs": 664825,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "and maintain the house."
    } ]
  }, {
    "tStartMs": 666466,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "If you fall behind on any of those,"
    } ]
  }, {
    "tStartMs": 669707,
    "dDurationMs": 3741,
    "segs": [ {
      "utf8": "the lender can foreclose, and seniors have lost their"
    } ]
  }, {
    "tStartMs": 673448,
    "dDurationMs": 1941,
    "segs": [ {
      "utf8": "homes in exactly this way."
    } ]
  }, {
    "tStartMs": 676329,
    "dDurationMs": 2821,
    "segs": [ {
      "utf8": "There is one real protection I want you to"
    } ]
  }, {
    "tStartMs": 679150,
    "dDurationMs": 3021,
    "segs": [ {
      "utf8": "know about, so you are not needlessly frightened."
    } ]
  }, {
    "tStartMs": 683091,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "A reverse mortgage is what is called a nonrecourse"
    } ]
  }, {
    "tStartMs": 686593,
    "dDurationMs": 3041,
    "segs": [ {
      "utf8": "loan, which means that when you pass away,"
    } ]
  }, {
    "tStartMs": 690254,
    "dDurationMs": 2641,
    "segs": [ {
      "utf8": "your family can never be forced to pay more"
    } ]
  }, {
    "tStartMs": 692895,
    "dDurationMs": 1260,
    "segs": [ {
      "utf8": "than the home is worth."
    } ]
  }, {
    "tStartMs": 694655,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "If the loan grew larger than the house,"
    } ]
  }, {
    "tStartMs": 697716,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "that is the lender's loss,"
    } ]
  }, {
    "tStartMs": 699497,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": "not your children's."
    } ]
  }, {
    "tStartMs": 700997,
    "dDurationMs": 3101,
    "segs": [ {
      "utf8": "But the home itself, the thing you wanted to"
    } ]
  }, {
    "tStartMs": 704098,
    "dDurationMs": 3122,
    "segs": [ {
      "utf8": "hand down, is very often simply gone."
    } ]
  }, {
    "tStartMs": 708020,
    "dDurationMs": 2301,
    "segs": [ {
      "utf8": "So before anyone talks you into one,"
    } ]
  }, {
    "tStartMs": 710781,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "sit down with a family member you trust,"
    } ]
  }, {
    "tStartMs": 712961,
    "dDurationMs": 1661,
    "segs": [ {
      "utf8": "and with a housing counselor,"
    } ]
  }, {
    "tStartMs": 715062,
    "dDurationMs": 3161,
    "segs": [ {
      "utf8": "and make sure you understand every single trigger that"
    } ]
  }, {
    "tStartMs": 718223,
    "dDurationMs": 1241,
    "segs": [ {
      "utf8": "could cost you the house."
    } ]
  }, {
    "tStartMs": 719784,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Now step back and look at all five of"
    } ]
  }, {
    "tStartMs": 722745,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "these together, because they share one quiet thread."
    } ]
  }, {
    "tStartMs": 726606,
    "dDurationMs": 2501,
    "segs": [ {
      "utf8": "A paid-off home feels like the finish line,"
    } ]
  }, {
    "tStartMs": 729107,
    "dDurationMs": 2681,
    "segs": [ {
      "utf8": "the one thing in your whole life that is"
    } ]
  }, {
    "tStartMs": 731788,
    "dDurationMs": 1540,
    "segs": [ {
      "utf8": "finally, completely yours."
    } ]
  }, {
    "tStartMs": 734209,
    "dDurationMs": 2180,
    "segs": [ {
      "utf8": "But not one of these threats cares that the"
    } ]
  }, {
    "tStartMs": 736389,
    "dDurationMs": 881,
    "segs": [ {
      "utf8": "mortgage is gone."
    } ]
  }, {
    "tStartMs": 738090,
    "dDurationMs": 2141,
    "segs": [ {
      "utf8": "Medicaid can claim it after you are gone."
    } ]
  }, {
    "tStartMs": 740891,
    "dDurationMs": 3001,
    "segs": [ {
      "utf8": "The Internal Revenue Service can tax it heavily if"
    } ]
  }, {
    "tStartMs": 743892,
    "dDurationMs": 1621,
    "segs": [ {
      "utf8": "you give it away the wrong way."
    } ]
  }, {
    "tStartMs": 746113,
    "dDurationMs": 2661,
    "segs": [ {
      "utf8": "The county can sell it over a tax bill."
    } ]
  }, {
    "tStartMs": 749474,
    "dDurationMs": 2401,
    "segs": [ {
      "utf8": "A criminal can forge your name right off of"
    } ]
  }, {
    "tStartMs": 751875,
    "dDurationMs": 260,
    "segs": [ {
      "utf8": "it."
    } ]
  }, {
    "tStartMs": 752395,
    "dDurationMs": 2581,
    "segs": [ {
      "utf8": "And a lender can slowly fill it back up"
    } ]
  }, {
    "tStartMs": 754976,
    "dDurationMs": 620,
    "segs": [ {
      "utf8": "with debt."
    } ]
  }, {
    "tStartMs": 756176,
    "dDurationMs": 3221,
    "segs": [ {
      "utf8": "Every single one of them works best in silence,"
    } ]
  }, {
    "tStartMs": 759917,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "counting on you never to ask the one question"
    } ]
  }, {
    "tStartMs": 762758,
    "dDurationMs": 1421,
    "segs": [ {
      "utf8": "that would shut it down."
    } ]
  }, {
    "tStartMs": 764899,
    "dDurationMs": 2861,
    "segs": [ {
      "utf8": "The house did not stop needing your protection the"
    } ]
  }, {
    "tStartMs": 767760,
    "dDurationMs": 1180,
    "segs": [ {
      "utf8": "day you paid it off."
    } ]
  }, {
    "tStartMs": 769561,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "In some ways, that is the very day it"
    } ]
  }, {
    "tStartMs": 772502,
    "dDurationMs": 1220,
    "segs": [ {
      "utf8": "started needing it most."
    } ]
  }, {
    "tStartMs": 774402,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "So here is what I want you to do"
    } ]
  }, {
    "tStartMs": 776083,
    "dDurationMs": 2321,
    "segs": [ {
      "utf8": "this week, and you do not have to do"
    } ]
  }, {
    "tStartMs": 778404,
    "dDurationMs": 1060,
    "segs": [ {
      "utf8": "all of it at once."
    } ]
  }, {
    "tStartMs": 779984,
    "dDurationMs": 1741,
    "segs": [ {
      "utf8": "Pick the one that fits your life,"
    } ]
  }, {
    "tStartMs": 781725,
    "dDurationMs": 1660,
    "segs": [ {
      "utf8": "and take a single step."
    } ]
  }, {
    "tStartMs": 784006,
    "dDurationMs": 2200,
    "segs": [ {
      "utf8": "If you are worried about a nursing home one"
    } ]
  }, {
    "tStartMs": 786206,
    "dDurationMs": 2901,
    "segs": [ {
      "utf8": "day, book a sit-down with an elder law attorney"
    } ]
  }, {
    "tStartMs": 789107,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "before you ever need it."
    } ]
  }, {
    "tStartMs": 791188,
    "dDurationMs": 1721,
    "segs": [ {
      "utf8": "If your property taxes are heavy,"
    } ]
  }, {
    "tStartMs": 793329,
    "dDurationMs": 2841,
    "segs": [ {
      "utf8": "call your county and ask about a senior deferral."
    } ]
  }, {
    "tStartMs": 796690,
    "dDurationMs": 1740,
    "segs": [ {
      "utf8": "If you were about to add a child to"
    } ]
  }, {
    "tStartMs": 798430,
    "dDurationMs": 3562,
    "segs": [ {
      "utf8": "your deed, stop, and ask about a trust instead."
    } ]
  }, {
    "tStartMs": 802632,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "And no matter what else,"
    } ]
  }, {
    "tStartMs": 804673,
    "dDurationMs": 2660,
    "segs": [ {
      "utf8": "look up your county recorder today and sign up"
    } ]
  }, {
    "tStartMs": 807333,
    "dDurationMs": 1861,
    "segs": [ {
      "utf8": "for their free property fraud alert,"
    } ]
  }, {
    "tStartMs": 809194,
    "dDurationMs": 3141,
    "segs": [ {
      "utf8": "because that one takes about ten minutes and it"
    } ]
  }, {
    "tStartMs": 812335,
    "dDurationMs": 2261,
    "segs": [ {
      "utf8": "guards the very thing you spent your whole life"
    } ]
  }, {
    "tStartMs": 814596,
    "dDurationMs": 820,
    "segs": [ {
      "utf8": "paying for."
    } ]
  }, {
    "tStartMs": 816056,
    "dDurationMs": 841,
    "segs": [ {
      "utf8": "You built this."
    } ]
  }, {
    "tStartMs": 817357,
    "dDurationMs": 2201,
    "segs": [ {
      "utf8": "You earned it, payment by payment,"
    } ]
  }, {
    "tStartMs": 819978,
    "dDurationMs": 780,
    "segs": [ {
      "utf8": "year by year."
    } ]
  }, {
    "tStartMs": 821318,
    "dDurationMs": 2281,
    "segs": [ {
      "utf8": "The least the world owes you is that it"
    } ]
  }, {
    "tStartMs": 823599,
    "dDurationMs": 3261,
    "segs": [ {
      "utf8": "actually stays yours, and passes to the people you"
    } ]
  }, {
    "tStartMs": 826860,
    "dDurationMs": 2361,
    "segs": [ {
      "utf8": "love, exactly the way you intended."
    } ]
  }, {
    "tStartMs": 830081,
    "dDurationMs": 1681,
    "segs": [ {
      "utf8": "So take one step this week,"
    } ]
  }, {
    "tStartMs": 831762,
    "dDurationMs": 2941,
    "segs": [ {
      "utf8": "and then let yourself feel what it is to"
    } ]
  }, {
    "tStartMs": 834703,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "know that the home is truly protected,"
    } ]
  }, {
    "tStartMs": 836663,
    "dDurationMs": 1801,
    "segs": [ {
      "utf8": "and not just paid off."
    } ]
  } ]
}
