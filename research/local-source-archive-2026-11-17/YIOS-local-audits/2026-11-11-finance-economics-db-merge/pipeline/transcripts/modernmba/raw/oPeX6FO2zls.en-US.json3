{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 100,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "The quality and value of what"
    } ]
  }, {
    "tStartMs": 1234,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "customers get for their dollar\nthese days has regressed across the board."
    } ]
  }, {
    "tStartMs": 4437,
    "dDurationMs": 4038,
    "segs": [ {
      "utf8": "Yet it's customer experience that has\nsuffered most as the basic core services"
    } ]
  }, {
    "tStartMs": 8475,
    "dDurationMs": 2235,
    "segs": [ {
      "utf8": "like support and checkout\nhave all been ripped up"
    } ]
  }, {
    "tStartMs": 10710,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "so companies can try to make \nmore money with less."
    } ]
  }, {
    "tStartMs": 13179,
    "dDurationMs": 2303,
    "segs": [ {
      "utf8": "When you shop at any retailer\nor supermarket"
    } ]
  }, {
    "tStartMs": 15482,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "these days, you'll find yourself\ngenerally funneled to self-checkout,"
    } ]
  }, {
    "tStartMs": 18218,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "where you're stuck\nwatching people in front of you"
    } ]
  }, {
    "tStartMs": 20120,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "awkwardly fumble finding barcodes,\nbagging their own groceries,"
    } ]
  }, {
    "tStartMs": 23390,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "and panicking whenever the machine shouts\nat them or the screen freezes."
    } ]
  }, {
    "tStartMs": 26793,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "There's usually only one worker"
    } ]
  }, {
    "tStartMs": 28328,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "who's overseeing everything,\nand whenever a problem occurs,"
    } ]
  }, {
    "tStartMs": 31031,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "everyone has to wait on them\nfor a resolution -"
    } ]
  }, {
    "tStartMs": 33233,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "all of which translates to a longer\nwait time, higher margin for error,"
    } ]
  }, {
    "tStartMs": 36603,
    "dDurationMs": 967,
    "segs": [ {
      "utf8": "and frustration."
    } ]
  }, {
    "tStartMs": 37570,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": "To add insult to injury, you had no choice\nin any of this as a consumer."
    } ]
  }, {
    "tStartMs": 41107,
    "dDurationMs": 1268,
    "segs": [ {
      "utf8": "Even if you wanted to go back"
    } ]
  }, {
    "tStartMs": 42375,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "to the normal checkout aisles\nwhere cashier scans and bags for you."
    } ]
  }, {
    "tStartMs": 45578,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "You can't because those aisles are either\nclosed or they're so short staffed that"
    } ]
  }, {
    "tStartMs": 49382,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "the lines there are even longer than those\nat self-checkout."
    } ]
  }, {
    "tStartMs": 52352,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "All of this tech suddenly appeared\nnationwide in the mid-2010s."
    } ]
  }, {
    "tStartMs": 55789,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Since the debut of self-checkout,\nretailers from Kroger and Walmart"
    } ]
  }, {
    "tStartMs": 59459,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "to Target and Home Depot have all publicly\ngaslighted that self-checkout is faster"
    } ]
  }, {
    "tStartMs": 63630,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "and that these machines\nare not there to replace workers,"
    } ]
  }, {
    "tStartMs": 65832,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "but to instead\nfree them to be more productive."
    } ]
  }, {
    "tStartMs": 68134,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "They stuck to this script year after year,\ndespite the continuous backlash"
    } ]
  }, {
    "tStartMs": 71504,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "and disapproval,\nand their stocks collectively grew"
    } ]
  }, {
    "tStartMs": 74007,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "as Wall Street applauded these investments, believing"
    } ]
  }, {
    "tStartMs": 76509,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "that tech innovation would unlock\nunprecedented efficiencies"
    } ]
  }, {
    "tStartMs": 79512,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "and profits for these age-old, overhead\nintensive businesses."
    } ]
  }, {
    "tStartMs": 83016,
    "dDurationMs": 3637,
    "segs": [ {
      "utf8": "Fast forward just 5 years\nand self-checkout has largely been a flop."
    } ]
  }, {
    "tStartMs": 86853,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "Most retailers have backtracked,"
    } ]
  }, {
    "tStartMs": 88354,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "ripping out their machines\nand going back to human cashiers."
    } ]
  }, {
    "tStartMs": 91391,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "While a few chains have continued\nto gaslight"
    } ]
  }, {
    "tStartMs": 93426,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "that self-checkout is still the future."
    } ]
  }, {
    "tStartMs": 95128,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "The reality is that even they are scaling"
    } ]
  }, {
    "tStartMs": 97230,
    "dDurationMs": 3637,
    "segs": [ {
      "utf8": "back, restricting the conditions\nin which consumers can use these machines."
    } ]
  }, {
    "tStartMs": 101034,
    "dDurationMs": 1468,
    "segs": [ {
      "utf8": "Self-checkout has been a flop"
    } ]
  }, {
    "tStartMs": 102502,
    "dDurationMs": 3236,
    "segs": [ {
      "utf8": "not just in the U.S, but also overseas\nand all of these retailers"
    } ]
  }, {
    "tStartMs": 105738,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "are hoping to sweep things under the rug\nwhile the market obsesses over AI."
    } ]
  }, {
    "tStartMs": 109576,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "Ultimately, the retail industry is \njust as confused"
    } ]
  }, {
    "tStartMs": 112045,
    "dDurationMs": 2636,
    "segs": [ {
      "utf8": "as everyone else,\nas there's been no clarity in the data."
    } ]
  }, {
    "tStartMs": 114681,
    "dDurationMs": 4137,
    "segs": [ {
      "utf8": "Is getting rid of a few part-time cashiers \nmaking $10 to $15 an hour"
    } ]
  }, {
    "tStartMs": 118818,
    "dDurationMs": 3437,
    "segs": [ {
      "utf8": "actually even meaningful business-wise,\nif you're spending millions of dollars"
    } ]
  }, {
    "tStartMs": 122255,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "on loss prevention, security,\nand self-checkout technology."
    } ]
  }, {
    "tStartMs": 125492,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "Did retailers who installed self-checkout\nmachines end up saving more money"
    } ]
  }, {
    "tStartMs": 129062,
    "dDurationMs": 2969,
    "segs": [ {
      "utf8": "or improving their profits?\nAnd how did such a conservative,"
    } ]
  }, {
    "tStartMs": 132031,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "disciplined industry\nget caught up in this hype?"
    } ]
  }, {
    "tStartMs": 135168,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "What does the future hold in business?"
    } ]
  }, {
    "tStartMs": 137003,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "Asked 9 experts, and you'll get 10 answers."
    } ]
  }, {
    "tStartMs": 139239,
    "dDurationMs": 3403,
    "segs": [ {
      "utf8": "Analysts will say inflation is down\none month and then up the next."
    } ]
  }, {
    "tStartMs": 142642,
    "dDurationMs": 3403,
    "segs": [ {
      "utf8": "It's the same constant whiplash\nwith unemployment, jobs reports,"
    } ]
  }, {
    "tStartMs": 146045,
    "dDurationMs": 1135,
    "segs": [ {
      "utf8": "and the health of the economy."
    } ]
  }, {
    "tStartMs": 147180,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "Could someone please\ninvent a crystal ball?"
    } ]
  }, {
    "tStartMs": 149315,
    "dDurationMs": 868,
    "segs": [ {
      "utf8": "Until then, over"
    } ]
  }, {
    "tStartMs": 150183,
    "dDurationMs": 4037,
    "segs": [ {
      "utf8": "41,000 businesses have future proofed\ntheir business with NetSuite by Oracle,"
    } ]
  }, {
    "tStartMs": 154220,
    "dDurationMs": 3604,
    "segs": [ {
      "utf8": "the number one cloud ERP\nbring accounting, finance, inventory"
    } ]
  }, {
    "tStartMs": 157824,
    "dDurationMs": 4104,
    "segs": [ {
      "utf8": "and HR into one fluid platform with one\nunified business management suite."
    } ]
  }, {
    "tStartMs": 161961,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "There's one source of truth"
    } ]
  }, {
    "tStartMs": 163062,
    "dDurationMs": 3237,
    "segs": [ {
      "utf8": "giving you the visibility and control\nyou need to make quick decisions."
    } ]
  }, {
    "tStartMs": 166299,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "With real-time insights and forecasting,\nyou're peering into the future"
    } ]
  }, {
    "tStartMs": 169435,
    "dDurationMs": 1202,
    "segs": [ {
      "utf8": "with actionable data."
    } ]
  }, {
    "tStartMs": 170637,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "When you're closing the books in days,\nnot weeks, you're spending less time"
    } ]
  }, {
    "tStartMs": 173740,
    "dDurationMs": 2402,
    "segs": [ {
      "utf8": "looking backwards\nand more time on what's next."
    } ]
  }, {
    "tStartMs": 176142,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "Modern MBA is small at the moment, but\nas soon as we scale, we'll need and use"
    } ]
  }, {
    "tStartMs": 179846,
    "dDurationMs": 567,
    "segs": [ {
      "utf8": "NetSuite."
    } ]
  }, {
    "tStartMs": 180413,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "Today we're stitching things manually"
    } ]
  }, {
    "tStartMs": 181981,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "and it's gotten harder\nto assess our business health."
    } ]
  }, {
    "tStartMs": 184083,
    "dDurationMs": 3571,
    "segs": [ {
      "utf8": "We need to track production costs to run\npayroll compliant with multiple states,"
    } ]
  }, {
    "tStartMs": 187654,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "and to evaluate profit\nand loss by team and project."
    } ]
  }, {
    "tStartMs": 190390,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "As a corporation,\nwe pay tax throughout the year"
    } ]
  }, {
    "tStartMs": 192659,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "and it's a nightmare jumping from system\nto system just to get one answer."
    } ]
  }, {
    "tStartMs": 196062,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "These are capabilities\nthat only NetSuite provides,"
    } ]
  }, {
    "tStartMs": 198398,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "and it's a platform\nthat we intend to take every advantage of."
    } ]
  }, {
    "tStartMs": 201334,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "Whether your company is earning millions\nor even hundreds of millions,"
    } ]
  }, {
    "tStartMs": 204470,
    "dDurationMs": 701,
    "segs": [ {
      "utf8": "NetSuite helps"
    } ]
  }, {
    "tStartMs": 205171,
    "dDurationMs": 3404,
    "segs": [ {
      "utf8": "you respond to immediate challenges\nand seize your biggest opportunities."
    } ]
  }, {
    "tStartMs": 208575,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "Speaking of opportunity, download the CFO's\nguide to AI"
    } ]
  }, {
    "tStartMs": 211678,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "and Machine Learning at netsuite.com/modern MBA."
    } ]
  }, {
    "tStartMs": 215715,
    "dDurationMs": 4204,
    "segs": [ {
      "utf8": "The guide is free to you\nat NetSuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 219919,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "NetSuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 222855,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "Retail is a tough industry."
    } ]
  }, {
    "tStartMs": 224457,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "It's a capital-intensive,\nhigh overhead business"
    } ]
  }, {
    "tStartMs": 226726,
    "dDurationMs": 3604,
    "segs": [ {
      "utf8": "where even the giants squeeze out\n4-8% operating margins a year."
    } ]
  }, {
    "tStartMs": 230330,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "Whether it's peddling fresh produce,\ndaily essentials or cheap toys, retail"
    } ]
  }, {
    "tStartMs": 234300,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "generates incredible cash flow"
    } ]
  }, {
    "tStartMs": 235802,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "as the industry leaders\ngross more in a single year"
    } ]
  }, {
    "tStartMs": 238304,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "than even some Big Tech companies."
    } ]
  }, {
    "tStartMs": 239939,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "But gross earnings are not the \nsame as net 60-70%"
    } ]
  }, {
    "tStartMs": 243309,
    "dDurationMs": 3237,
    "segs": [ {
      "utf8": "of every dollar that a retailer earns\ngoes to buying products,"
    } ]
  }, {
    "tStartMs": 246546,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "even with economies of scale."
    } ]
  }, {
    "tStartMs": 248114,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "The product costs"
    } ]
  }, {
    "tStartMs": 248881,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "for the leaders with the best volume\nand the greatest wholesale discounts"
    } ]
  }, {
    "tStartMs": 252051,
    "dDurationMs": 4071,
    "segs": [ {
      "utf8": "like Walmart and Costco\nstill end up in the 60 to 70% range."
    } ]
  }, {
    "tStartMs": 256189,
    "dDurationMs": 3437,
    "segs": [ {
      "utf8": "If anything, their product\ncosts are generally higher as these giants"
    } ]
  }, {
    "tStartMs": 259626,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "have to spread themselves thin to carry\nsomething for everyone."
    } ]
  }, {
    "tStartMs": 262795,
    "dDurationMs": 3571,
    "segs": [ {
      "utf8": "On the flip side, the more specialized\na retailer is like in home improvement"
    } ]
  }, {
    "tStartMs": 266366,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "or in organic produce,\nthe lower their product costs will be."
    } ]
  }, {
    "tStartMs": 269402,
    "dDurationMs": 4404,
    "segs": [ {
      "utf8": "But once again, they're still in that\n60-70% range, with only 20% gross"
    } ]
  }, {
    "tStartMs": 273806,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "profit left after paying for the goods\nand getting them delivered to the stores."
    } ]
  }, {
    "tStartMs": 277343,
    "dDurationMs": 3304,
    "segs": [ {
      "utf8": "Retailers have to clamp down\non everything else to squeeze out profit."
    } ]
  }, {
    "tStartMs": 280680,
    "dDurationMs": 4204,
    "segs": [ {
      "utf8": "They generally hire low-skill workers\nat minimum wages, pay below-market rents"
    } ]
  }, {
    "tStartMs": 284884,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "as anchor tenants, control hours,\nand rely on part time seasonal staff"
    } ]
  }, {
    "tStartMs": 288721,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "to stock shelves, handle sales,\nand maintain space around the clock."
    } ]
  }, {
    "tStartMs": 292625,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "For every dollar that retailers earn,"
    } ]
  }, {
    "tStartMs": 294460,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "They generally spend another 15-30% on labor,"
    } ]
  }, {
    "tStartMs": 297563,
    "dDurationMs": 3204,
    "segs": [ {
      "utf8": "which leaves an operating margin\nof just a few single digits."
    } ]
  }, {
    "tStartMs": 300800,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "There's little profits\nin this line of work"
    } ]
  }, {
    "tStartMs": 302702,
    "dDurationMs": 3770,
    "segs": [ {
      "utf8": "and it's been this way for decades,\nwith tiny margins and high overhead."
    } ]
  }, {
    "tStartMs": 306472,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "Retailers, by nature, are conservative,\ncareful, and frugal."
    } ]
  }, {
    "tStartMs": 309876,
    "dDurationMs": 2602,
    "segs": [ {
      "utf8": "There's no such thing\nas fast growth in this industry."
    } ]
  }, {
    "tStartMs": 312478,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "They don't have the margins\nto make moonshot bets every quarter,"
    } ]
  }, {
    "tStartMs": 315348,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "and they have to be"
    } ]
  }, {
    "tStartMs": 316015,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "financially disciplined with their asset\nheavy, people-intensive volume model."
    } ]
  }, {
    "tStartMs": 320086,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "As a result, retailers excel as\ndefensive, reliable investments."
    } ]
  }, {
    "tStartMs": 323790,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "But in the zero"
    } ]
  }, {
    "tStartMs": 324557,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "interest environment of the 2010s,\ninvestors want an upside, not security."
    } ]
  }, {
    "tStartMs": 328661,
    "dDurationMs": 4071,
    "segs": [ {
      "utf8": "It was in this period when tech companies\nskyrocketed, as their stocks consistently"
    } ]
  }, {
    "tStartMs": 332732,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "outperformed those of any other \nindustry year after year."
    } ]
  }, {
    "tStartMs": 335735,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "Even though most tech startups lost money,\ntheir fundamentals compared to"
    } ]
  }, {
    "tStartMs": 339038,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "retailers were incredible,\nwith massive 70+% operating margins."
    } ]
  }, {
    "tStartMs": 343242,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Tech was the exact opposite of retail."
    } ]
  }, {
    "tStartMs": 345411,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": "In the early 2010s, every retailer\nfocused on the same strategies."
    } ]
  }, {
    "tStartMs": 348948,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "Their goal was to open up more stores,\nto add loyalty programs,"
    } ]
  }, {
    "tStartMs": 352218,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "to expand product variety\nand to drive more in-store traffic."
    } ]
  }, {
    "tStartMs": 355588,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Consumer confidence was fragile\nexiting the Great Recession"
    } ]
  }, {
    "tStartMs": 358558,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "and retailers were focused on getting them\nback in the door and spending."
    } ]
  }, {
    "tStartMs": 361861,
    "dDurationMs": 3871,
    "segs": [ {
      "utf8": "There were no grand speeches of innovation\nor radical ideas about the future,"
    } ]
  }, {
    "tStartMs": 365998,
    "dDurationMs": 1969,
    "segs": [ {
      "utf8": "but everything changed in 2016."
    } ]
  }, {
    "tStartMs": 367967,
    "dDurationMs": 4538,
    "segs": [ {
      "utf8": "Suddenly, every retailer overnight began\ntalking about automation and technology."
    } ]
  }, {
    "tStartMs": 372572,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Despite having zero issues with it\nbefore, the checkout aisle"
    } ]
  }, {
    "tStartMs": 375575,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "became the industry's public enemy\nnumber one. This was the Amazon effect."
    } ]
  }, {
    "tStartMs": 379612,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "It was in 2016 when Amazon launched \nits futuristic store"
    } ]
  }, {
    "tStartMs": 382682,
    "dDurationMs": 1068,
    "segs": [ {
      "utf8": "where customers could walk"
    } ]
  }, {
    "tStartMs": 383750,
    "dDurationMs": 3069,
    "segs": [ {
      "utf8": "in, take the items they want\nright off the shelves, and walk right out."
    } ]
  }, {
    "tStartMs": 386853,
    "dDurationMs": 600,
    "segs": [ {
      "utf8": "With computer"
    } ]
  }, {
    "tStartMs": 387453,
    "dDurationMs": 3871,
    "segs": [ {
      "utf8": "vision, deep learning, smart sensors,\nand the same autonomous technology"
    } ]
  }, {
    "tStartMs": 391324,
    "dDurationMs": 4037,
    "segs": [ {
      "utf8": "that was fueling the self-driving\nand IoT hype at the time, Amazon boasted"
    } ]
  }, {
    "tStartMs": 395361,
    "dDurationMs": 3437,
    "segs": [ {
      "utf8": "that it had revolutionized retail\nby opening the first store in history."
    } ]
  }, {
    "tStartMs": 398798,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "Without checkout, customers\nwould never need to wait in line again."
    } ]
  }, {
    "tStartMs": 401968,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "Labor costs would be dramatically lower,"
    } ]
  }, {
    "tStartMs": 403803,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "as this technology would directly replace\ncashiers and checkout aisles."
    } ]
  }, {
    "tStartMs": 407306,
    "dDurationMs": 3904,
    "segs": [ {
      "utf8": "Everything was automated and these stores\nonly needed 1 or 2 workers on hand"
    } ]
  }, {
    "tStartMs": 411210,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "to restock shelves as needed."
    } ]
  }, {
    "tStartMs": 412845,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "In this fast growing era of in-Demand\ndigital everything like Uber and DoorDash,"
    } ]
  }, {
    "tStartMs": 417216,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "it wasn't a stretch to imagine\nthat customers would be willing to pay"
    } ]
  }, {
    "tStartMs": 420186,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": "a greater premium and spend even more\nthan before with such extreme convenience."
    } ]
  }, {
    "tStartMs": 423790,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "And from the business side,\nwhat had once been an unavoidable, error"
    } ]
  }, {
    "tStartMs": 427093,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "prone, variable cost could now be eliminated\npermanently"
    } ]
  }, {
    "tStartMs": 430129,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "with this one-time investment\nin hardware and software."
    } ]
  }, {
    "tStartMs": 433132,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "Given Amazon's track record, the media\nhype and the all-time-high positive"
    } ]
  }, {
    "tStartMs": 436936,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "sentiment towards tech,\nthe public believed every word out of Jeff"
    } ]
  }, {
    "tStartMs": 440206,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "Bezos's mouth,"
    } ]
  }, {
    "tStartMs": 441140,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "even though the first store was really\nnothing more than a proof-of-concept."
    } ]
  }, {
    "tStartMs": 444544,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "Retailers overnight got spooked."
    } ]
  }, {
    "tStartMs": 446579,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "If Amazon opened up more of these stores,\nit would be hard for their customers"
    } ]
  }, {
    "tStartMs": 449849,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "to go back to waiting in line at their stores,"
    } ]
  }, {
    "tStartMs": 451851,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "and they would look like dinosaurs\nin comparison."
    } ]
  }, {
    "tStartMs": 454020,
    "dDurationMs": 2302,
    "segs": [ {
      "utf8": "At the same time,\nthere was no way that a retailer"
    } ]
  }, {
    "tStartMs": 456322,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "could ever catch up to Amazon's\nengineering talent."
    } ]
  }, {
    "tStartMs": 458791,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "There was some initial speculation\nin the industry"
    } ]
  }, {
    "tStartMs": 460960,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "that Amazon Go was just a testing ground,\nand that Amazon's actual goal"
    } ]
  }, {
    "tStartMs": 464630,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "was just to eventually license out\nthis tech to these retailers for a fee."
    } ]
  }, {
    "tStartMs": 468468,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "But those hopes were dashed\nwhen Amazon suddenly acquired Whole Foods"
    } ]
  }, {
    "tStartMs": 471637,
    "dDurationMs": 1135,
    "segs": [ {
      "utf8": "a year later."
    } ]
  }, {
    "tStartMs": 472772,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "Whole Foods provided a huge customer base,\nsupply chain, perishable expertise,"
    } ]
  }, {
    "tStartMs": 477276,
    "dDurationMs": 3404,
    "segs": [ {
      "utf8": "and a nationwide presence -\nand Amazon could embed its technology"
    } ]
  }, {
    "tStartMs": 480680,
    "dDurationMs": 4037,
    "segs": [ {
      "utf8": "and aggressive Silicon Valley data\ndriven approach into retail directly."
    } ]
  }, {
    "tStartMs": 484717,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "With a purchase price of $14 billion,"
    } ]
  }, {
    "tStartMs": 487253,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "the biggest acquisition\nto date in company history,"
    } ]
  }, {
    "tStartMs": 489789,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "it was clear that Amazon wasn't\ngoing to settle for being a back"
    } ]
  }, {
    "tStartMs": 492792,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "end software vendor."
    } ]
  }, {
    "tStartMs": 493960,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "Jeff Bezos had killed off\nbookstores before"
    } ]
  }, {
    "tStartMs": 496162,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "and he was now taking on supermarkets\nhead on."
    } ]
  }, {
    "tStartMs": 498664,
    "dDurationMs": 1368,
    "segs": [ {
      "utf8": "There was no one else in the world"
    } ]
  }, {
    "tStartMs": 500032,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "more qualified and more committed\nto disrupting the remaining retail giants."
    } ]
  }, {
    "tStartMs": 504303,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "Eight years later,\nwe know now that the supposed"
    } ]
  }, {
    "tStartMs": 506439,
    "dDurationMs": 3470,
    "segs": [ {
      "utf8": "groundbreaking technology behind\nAmazon Go was not actually real."
    } ]
  }, {
    "tStartMs": 509976,
    "dDurationMs": 3737,
    "segs": [ {
      "utf8": "All Amazon had done was to replace\nlocal human cashiers with a thousand"
    } ]
  }, {
    "tStartMs": 513713,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "remote workers in India,\nwho had to manually review the footage"
    } ]
  }, {
    "tStartMs": 516749,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "to see what items customers\nactually picked up and walked out."
    } ]
  }, {
    "tStartMs": 519452,
    "dDurationMs": 3537,
    "segs": [ {
      "utf8": "With seven out of every ten transactions\nneeding to be manually verified"
    } ]
  }, {
    "tStartMs": 522989,
    "dDurationMs": 3737,
    "segs": [ {
      "utf8": "by this remote team, this meant only 30% of\nthe sales were actually automated."
    } ]
  }, {
    "tStartMs": 526759,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "Beyond the issues of accuracy,"
    } ]
  }, {
    "tStartMs": 528327,
    "dDurationMs": 3904,
    "segs": [ {
      "utf8": "the technology from the lens of hardware\nand software was not actually scalable."
    } ]
  }, {
    "tStartMs": 532231,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "A single Amazon Go store required\nthousands of state-of-the-art"
    } ]
  }, {
    "tStartMs": 535301,
    "dDurationMs": 1602,
    "segs": [ {
      "utf8": "cameras and fiber internet."
    } ]
  }, {
    "tStartMs": 536903,
    "dDurationMs": 3236,
    "segs": [ {
      "utf8": "Amazon has since quietly retreated back\nto conventional checkout"
    } ]
  }, {
    "tStartMs": 540139,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "and local human cashiers for Whole Foods\nand for its own stores."
    } ]
  }, {
    "tStartMs": 543643,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "And in the past year, they've laid off\nhundreds of employees from its Amazon"
    } ]
  }, {
    "tStartMs": 547246,
    "dDurationMs": 3871,
    "segs": [ {
      "utf8": "Go teams, closed down the vast majority\nof its stores across the US and Europe,"
    } ]
  }, {
    "tStartMs": 551117,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "and ripped out the cashierless\njust-walk-out turnstiles and Whole Foods."
    } ]
  }, {
    "tStartMs": 554820,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "But back in 2016,"
    } ]
  }, {
    "tStartMs": 556222,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "no one had any idea at the time that Jeff\nBezos was just blowing smoke."
    } ]
  }, {
    "tStartMs": 560059,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "It wasn't just retailers who were spooked,\nbut also Wall Street,"
    } ]
  }, {
    "tStartMs": 562828,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "who began demanding answers."
    } ]
  }, {
    "tStartMs": 564330,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "For better or worse,\nAmazon had become a forcing function."
    } ]
  }, {
    "tStartMs": 567366,
    "dDurationMs": 3204,
    "segs": [ {
      "utf8": "They had established a standard\nand identified a specific area"
    } ]
  }, {
    "tStartMs": 570570,
    "dDurationMs": 3436,
    "segs": [ {
      "utf8": "for automation that everyone else\nin retail suddenly needed to live up to."
    } ]
  }, {
    "tStartMs": 574040,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "How would the industry leaders\nlike Kroger, Costco, and Home Depot"
    } ]
  }, {
    "tStartMs": 577243,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "compete with Amazon's new people-light,\nhigh-automation stores?"
    } ]
  }, {
    "tStartMs": 581047,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "Could they ever transition"
    } ]
  }, {
    "tStartMs": 582381,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "to make their checkout self-service,\njust like Amazon Go?"
    } ]
  }, {
    "tStartMs": 585418,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "And within a year, self-checkout\nbecame priority number one"
    } ]
  }, {
    "tStartMs": 588454,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "for the entire industry."
    } ]
  }, {
    "tStartMs": 589889,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "It was a gold rush without the gold for\nleaders like Walmart, Kroger, and target."
    } ]
  }, {
    "tStartMs": 593926,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "They were eager to demonstrate\nthat they weren't"
    } ]
  }, {
    "tStartMs": 595828,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "actually dinosaurs\nwaiting to be disrupted,"
    } ]
  }, {
    "tStartMs": 597964,
    "dDurationMs": 2969,
    "segs": [ {
      "utf8": "but instead equally capable\nof adapting to the latest trends"
    } ]
  }, {
    "tStartMs": 600933,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "and creating their own\nproprietary technology."
    } ]
  }, {
    "tStartMs": 603469,
    "dDurationMs": 2136,
    "segs": [ {
      "utf8": "In return, they could maintain their valuations"
    } ]
  }, {
    "tStartMs": 605605,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "and grow the appeal of their stock in\nwhat was a tech-dominant market."
    } ]
  }, {
    "tStartMs": 608741,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "Yet, retailers of all sizes\nwere under pressure to show progress"
    } ]
  }, {
    "tStartMs": 612044,
    "dDurationMs": 1235,
    "segs": [ {
      "utf8": "toward self-checkout."
    } ]
  }, {
    "tStartMs": 613279,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "Smaller chains like Dollar"
    } ]
  }, {
    "tStartMs": 614580,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "General and Sprouts\ndidn't have the war chest of a Walmart"
    } ]
  }, {
    "tStartMs": 617583,
    "dDurationMs": 4038,
    "segs": [ {
      "utf8": "or Kroger to throw millions of dollars\nhiring engineers and building machines."
    } ]
  }, {
    "tStartMs": 621654,
    "dDurationMs": 3437,
    "segs": [ {
      "utf8": "They also didn't have the incentive\nor the urgency to reinvent themselves"
    } ]
  }, {
    "tStartMs": 625091,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "in the eyes of Wall Street"
    } ]
  }, {
    "tStartMs": 626092,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "as some progressive, modernized corporation."
    } ]
  }, {
    "tStartMs": 628561,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "They only needed to reach this bar,\nnot exceed it."
    } ]
  }, {
    "tStartMs": 630896,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "Ultimately, the clock was ticking,\nand the industry as a whole needed"
    } ]
  }, {
    "tStartMs": 633866,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "to get self-checkout up\nand running ASAP to remain competitive."
    } ]
  }, {
    "tStartMs": 637403,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "They would never be fully automated\nand entirely cashierless like Amazon,"
    } ]
  }, {
    "tStartMs": 641073,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "but if they could get customers to scan\nand bag their own groceries,"
    } ]
  }, {
    "tStartMs": 644043,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "if they could start removing the existing\ncheckout aisles and start hiring"
    } ]
  }, {
    "tStartMs": 647313,
    "dDurationMs": 801,
    "segs": [ {
      "utf8": "less cashiers,"
    } ]
  }, {
    "tStartMs": 648114,
    "dDurationMs": 3737,
    "segs": [ {
      "utf8": "then everyone would, in theory,\nbe closer towards realizing this future."
    } ]
  }, {
    "tStartMs": 651884,
    "dDurationMs": 3737,
    "segs": [ {
      "utf8": "The fastest option was to outsource and\nthere were two companies who were eager"
    } ]
  }, {
    "tStartMs": 655621,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "to provide the hardware and software\nshovels for this faux gold rush."
    } ]
  }, {
    "tStartMs": 659558,
    "dDurationMs": 3871,
    "segs": [ {
      "utf8": "ATMs were the earliest and most successful\nexample of retail automation,"
    } ]
  }, {
    "tStartMs": 663429,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "where customers\ncould self-service themselves"
    } ]
  }, {
    "tStartMs": 665331,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "on machines,\nand banks in turn could hire less tellers."
    } ]
  }, {
    "tStartMs": 668601,
    "dDurationMs": 3603,
    "segs": [ {
      "utf8": "In the US, there was NCR and in Europe\nthere was Diebold next door."
    } ]
  }, {
    "tStartMs": 672238,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Both companies made their fortunes\nbuilding and selling ATMs"
    } ]
  }, {
    "tStartMs": 675241,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "to banks, but there's only so many banks\nin the world who need ATMs"
    } ]
  }, {
    "tStartMs": 678544,
    "dDurationMs": 3904,
    "segs": [ {
      "utf8": "and so much innovation to be had with cash\nwithdrawals and check deposits."
    } ]
  }, {
    "tStartMs": 682615,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "By the late 90s, the ATM\nmarket had been completely saturated."
    } ]
  }, {
    "tStartMs": 685951,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "As a result, growth\nwas slow through the 2000s"
    } ]
  }, {
    "tStartMs": 688454,
    "dDurationMs": 3870,
    "segs": [ {
      "utf8": "and both companies desired to introduce\nself-service to other industries."
    } ]
  }, {
    "tStartMs": 692324,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Places like airports, car\nrentals, concerts, and hospitals"
    } ]
  }, {
    "tStartMs": 695661,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "were all opportunities where staff\ncould be easily replaced with a machine."
    } ]
  }, {
    "tStartMs": 699198,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "But NCR and Diebold\nwere only vendors and suppliers."
    } ]
  }, {
    "tStartMs": 702468,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "They could only follow the wind,\nand most retailers were not willing"
    } ]
  }, {
    "tStartMs": 705838,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "to risk the resources necessary\nto undertake a project of the scale."
    } ]
  }, {
    "tStartMs": 709642,
    "dDurationMs": 3904,
    "segs": [ {
      "utf8": "NCR settled for DVD kiosks, believing\nthat they could fill the hole in movie"
    } ]
  }, {
    "tStartMs": 713546,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "rental with Blockbuster's bankruptcy."
    } ]
  }, {
    "tStartMs": 715381,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "But all of that went up in the air"
    } ]
  }, {
    "tStartMs": 716782,
    "dDurationMs": 3237,
    "segs": [ {
      "utf8": "with Netflix and streaming\nearnings fluctuated for both companies"
    } ]
  }, {
    "tStartMs": 720019,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "through the 2000s as the company struggled\nto find growth beyond banking."
    } ]
  }, {
    "tStartMs": 723756,
    "dDurationMs": 1635,
    "segs": [ {
      "utf8": "Despite grossing billions of dollars"
    } ]
  }, {
    "tStartMs": 725391,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "a year, there still isn't a lot of profit\nin this line of work."
    } ]
  }, {
    "tStartMs": 728427,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "After designing the machines,\noutsourcing the manufacturing,"
    } ]
  }, {
    "tStartMs": 731497,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "writing software, and maintaining\nthe hardware at scale after deployment,"
    } ]
  }, {
    "tStartMs": 735067,
    "dDurationMs": 4772,
    "segs": [ {
      "utf8": "operating margins for both NCR and Diebold\nwere as low as the retailers themselves."
    } ]
  }, {
    "tStartMs": 740072,
    "dDurationMs": 4872,
    "segs": [ {
      "utf8": "The first real win came in 2012,\nfour years before Amazon Go, when NCR won"
    } ]
  }, {
    "tStartMs": 744977,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "an initial deal with Walmart,"
    } ]
  }, {
    "tStartMs": 746479,
    "dDurationMs": 3637,
    "segs": [ {
      "utf8": "who had the capital, incentive,\nand interest to pursue self-checkout."
    } ]
  }, {
    "tStartMs": 750316,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Walmart, through history,\nhas been aggressively anti-union,"
    } ]
  }, {
    "tStartMs": 753319,
    "dDurationMs": 3904,
    "segs": [ {
      "utf8": "and its executives were always upfront\nabout exploring ways to cut hours,"
    } ]
  }, {
    "tStartMs": 757223,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "eliminate workers, and to reduce overhead."
    } ]
  }, {
    "tStartMs": 759592,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "But as mentioned before, the rest\nof the retail industry wasn't convinced"
    } ]
  }, {
    "tStartMs": 762895,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "that these investments were worthwhile\nor repeatable at a smaller scale."
    } ]
  }, {
    "tStartMs": 766732,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "And all of that changed in 2016\nwith Amazon Go."
    } ]
  }, {
    "tStartMs": 769902,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Suddenly, everyone wanted self-checkout,\nand it became NCR and Diebold's"
    } ]
  }, {
    "tStartMs": 773739,
    "dDurationMs": 1301,
    "segs": [ {
      "utf8": "fastest growing division."
    } ]
  }, {
    "tStartMs": 775040,
    "dDurationMs": 3404,
    "segs": [ {
      "utf8": "Diebold retail business\ndoubled in a single year, and for NCR,"
    } ]
  }, {
    "tStartMs": 778444,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "that growth was channeled\nacross multiple years"
    } ]
  }, {
    "tStartMs": 780613,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "as it took longer for the deals\nand deployments to materialize."
    } ]
  }, {
    "tStartMs": 784016,
    "dDurationMs": 1435,
    "segs": [ {
      "utf8": "Like any good shovel seller,"
    } ]
  }, {
    "tStartMs": 785451,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "both companies openly\nfanned the flames to drive urgency."
    } ]
  }, {
    "tStartMs": 788354,
    "dDurationMs": 1968,
    "segs": [ {
      "utf8": "They proclaimed that their machines\nwere necessary"
    } ]
  }, {
    "tStartMs": 790322,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "to winning the next generation of shoppers,\nthat millennials loved"
    } ]
  }, {
    "tStartMs": 793425,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "self-checkout, and that stores would be\nradically transformed in their layout."
    } ]
  }, {
    "tStartMs": 796996,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "And the best part was that these\nself-checkout machines could be productive"
    } ]
  }, {
    "tStartMs": 800166,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "24 hours a day, whereas a human\ncould only work eight hours at most."
    } ]
  }, {
    "tStartMs": 803869,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "Everyone knew that NCR and Diebold\nwould never match Amazon"
    } ]
  }, {
    "tStartMs": 806906,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "Go, but at the very least,\nthey were the cheapest and fastest option."
    } ]
  }, {
    "tStartMs": 810242,
    "dDurationMs": 3737,
    "segs": [ {
      "utf8": "But even though demand and sales\ngrew rapidly, not even the shovel sellers"
    } ]
  }, {
    "tStartMs": 813979,
    "dDurationMs": 901,
    "segs": [ {
      "utf8": "were profitable."
    } ]
  }, {
    "tStartMs": 814880,
    "dDurationMs": 3871,
    "segs": [ {
      "utf8": "It was a fake gold rush, and both NCR\nand Diebold actually lost money"
    } ]
  }, {
    "tStartMs": 818751,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "every year as they burned\nmillions of dollars into R\u0026D and sales,"
    } ]
  }, {
    "tStartMs": 822121,
    "dDurationMs": 3403,
    "segs": [ {
      "utf8": "believing that this short term investment\nwould have long term returns."
    } ]
  }, {
    "tStartMs": 825524,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "They never imagined that Amazon\nand the industry"
    } ]
  }, {
    "tStartMs": 827760,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "would do such a massive U-turn,\nand that retailers would now"
    } ]
  }, {
    "tStartMs": 830329,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "go so far as to rip out their deployments\nwith the sunk costs."
    } ]
  }, {
    "tStartMs": 833365,
    "dDurationMs": 2236,
    "segs": [ {
      "utf8": "The other issue is that NCR and Diebold"
    } ]
  }, {
    "tStartMs": 835601,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "machines were always designed\nas a one-size-fits-all solution."
    } ]
  }, {
    "tStartMs": 838671,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "They were ultimately chasing a future\nthat had not been proven."
    } ]
  }, {
    "tStartMs": 841740,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "Thus, while their machines excelled\nat replacing simple sequential workflows"
    } ]
  }, {
    "tStartMs": 845544,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "like checking into a flight\nor printing a boarding pass"
    } ]
  }, {
    "tStartMs": 848013,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "at the airport,\nself-checkout was a beast of its own."
    } ]
  }, {
    "tStartMs": 850716,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "Every retailer has hundreds,\nif not thousands of different SKUs"
    } ]
  }, {
    "tStartMs": 853752,
    "dDurationMs": 3137,
    "segs": [ {
      "utf8": "that change regularly,\nalong with their own systems, programs,"
    } ]
  }, {
    "tStartMs": 856889,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "catalogs, and policies."
    } ]
  }, {
    "tStartMs": 858123,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "These machines needed to be able\nto follow all of these things"
    } ]
  }, {
    "tStartMs": 860526,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "and to be updated\nwhenever these items changed."
    } ]
  }, {
    "tStartMs": 862962,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "But given the rapid speed"
    } ]
  }, {
    "tStartMs": 864129,
    "dDurationMs": 3137,
    "segs": [ {
      "utf8": "at which retailers adopted, purchased,\nand rolled out these machines,"
    } ]
  }, {
    "tStartMs": 867266,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "it was all trial by fire,"
    } ]
  }, {
    "tStartMs": 868667,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "and NCR and Diebold needed to provide\neven greater support,"
    } ]
  }, {
    "tStartMs": 871704,
    "dDurationMs": 3737,
    "segs": [ {
      "utf8": "maintenance, and services post-sale,\nall of which chewed into their profits."
    } ]
  }, {
    "tStartMs": 875541,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Revenue has regressed\nas their customers have generally churned"
    } ]
  }, {
    "tStartMs": 878544,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "or opted to maintain their installations\ninstead of expanding,"
    } ]
  }, {
    "tStartMs": 881447,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "and their stocks have fallen\nas both companies"
    } ]
  }, {
    "tStartMs": 883582,
    "dDurationMs": 3637,
    "segs": [ {
      "utf8": "find themselves in the same situation\ntoday that they were in ten years ago"
    } ]
  }, {
    "tStartMs": 887219,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "and 20 years ago,"
    } ]
  }, {
    "tStartMs": 888153,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "looking for growth beyond ATMs."
    } ]
  }, {
    "tStartMs": 890489,
    "dDurationMs": 2102,
    "segs": [ {
      "utf8": "Walmart was the earliest\nand the most aggressive,"
    } ]
  }, {
    "tStartMs": 892591,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "having invested in self-checkout\ntechnology long before Amazon."
    } ]
  }, {
    "tStartMs": 896228,
    "dDurationMs": 3704,
    "segs": [ {
      "utf8": "Without any unions to slow them down,\nthey were the most capable and ruthless"
    } ]
  }, {
    "tStartMs": 899932,
    "dDurationMs": 1034,
    "segs": [ {
      "utf8": "of all retailers."
    } ]
  }, {
    "tStartMs": 900966,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "In 2017, the same year in which Amazon\npurchased Whole Foods,"
    } ]
  }, {
    "tStartMs": 904303,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "Walmart had completed rolling out\nself-checkout in every store."
    } ]
  }, {
    "tStartMs": 907473,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "Their goal was to eliminate\nworkers entirely,"
    } ]
  }, {
    "tStartMs": 909608,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "and there was no gaslighting\nabout a better customer experience."
    } ]
  }, {
    "tStartMs": 913078,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "Self-checkout at the front changes\nthe labor model dramatically inside"
    } ]
  }, {
    "tStartMs": 916582,
    "dDurationMs": 534,
    "segs": [ {
      "utf8": "the store."
    } ]
  }, {
    "tStartMs": 917116,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "\"Our focus is really on changing the work\nwhen you change the work,"
    } ]
  }, {
    "tStartMs": 920252,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "you can create leverage\ninside the profit and loss"
    } ]
  }, {
    "tStartMs": 922454,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "versus us just cutting hours\nbecause that's a short term play.\""
    } ]
  }, {
    "tStartMs": 925591,
    "dDurationMs": 1101,
    "segs": [ {
      "utf8": "But when we look at the hard"
    } ]
  }, {
    "tStartMs": 926692,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "numbers, it's not clear at all\nthat the removal of human cashiers"
    } ]
  }, {
    "tStartMs": 929862,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "has netted any meaningful benefits\nto Walmart's fundamentals."
    } ]
  }, {
    "tStartMs": 933032,
    "dDurationMs": 2869,
    "segs": [ {
      "utf8": "When you look at the average number\nof hourly employees per store,"
    } ]
  }, {
    "tStartMs": 935901,
    "dDurationMs": 1068,
    "segs": [ {
      "utf8": "there was a brief period"
    } ]
  }, {
    "tStartMs": 936969,
    "dDurationMs": 3971,
    "segs": [ {
      "utf8": "after the standardization of self-checkout\nwhere the company did hire less workers."
    } ]
  }, {
    "tStartMs": 940940,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "But these days, Walmart is actually hiring\njust as many people per store as it was"
    } ]
  }, {
    "tStartMs": 944944,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "before self-checkout."
    } ]
  }, {
    "tStartMs": 946178,
    "dDurationMs": 2035,
    "segs": [ {
      "utf8": "And that's strange,\nbecause there's actually fewer"
    } ]
  }, {
    "tStartMs": 948213,
    "dDurationMs": 2770,
    "segs": [ {
      "utf8": "Walmart stores\nthese days than there were a decade ago."
    } ]
  }, {
    "tStartMs": 950983,
    "dDurationMs": 2069,
    "segs": [ {
      "utf8": "If you're only keeping\nyour highest-performing,"
    } ]
  }, {
    "tStartMs": 953052,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "most productive stores on paper,\nyou should be hiring"
    } ]
  }, {
    "tStartMs": 955888,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "less people to operate these assets\nthat you know very well."
    } ]
  }, {
    "tStartMs": 959091,
    "dDurationMs": 2569,
    "segs": [ {
      "utf8": "When we isolate labor costs\nand we look at SG\u0026A"
    } ]
  }, {
    "tStartMs": 961660,
    "dDurationMs": 2936,
    "segs": [ {
      "utf8": "as a percentage of revenue,\nwe actually find that Walmart is spending"
    } ]
  }, {
    "tStartMs": 964596,
    "dDurationMs": 2870,
    "segs": [ {
      "utf8": "even more than before\non labor and administration,"
    } ]
  }, {
    "tStartMs": 967466,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "even if they're not hiring\nmore hourly workers than before."
    } ]
  }, {
    "tStartMs": 970269,
    "dDurationMs": 3970,
    "segs": [ {
      "utf8": "They're spending more dollars\non support services and machines from NCR"
    } ]
  }, {
    "tStartMs": 974239,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "and greater corporate headcount."
    } ]
  }, {
    "tStartMs": 975741,
    "dDurationMs": 3971,
    "segs": [ {
      "utf8": "And since we know that NCR itself as\na company, is not in a healthy position,"
    } ]
  }, {
    "tStartMs": 979712,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "the idea that the cost of self-checkout\nwas simply flattening out"
    } ]
  }, {
    "tStartMs": 982381,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "over time in the near future\nseems foolish."
    } ]
  }, {
    "tStartMs": 984717,
    "dDurationMs": 2435,
    "segs": [ {
      "utf8": "NCR has to make its own money\njust like Walmart,"
    } ]
  }, {
    "tStartMs": 987152,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "and if they remain stagnant too long\ncommercially,"
    } ]
  }, {
    "tStartMs": 989588,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "they'll eventually come to demand\nhigher prices."
    } ]
  }, {
    "tStartMs": 992124,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "Profit margins for Walmart\nhave actually decreased"
    } ]
  }, {
    "tStartMs": 994493,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "after the standardization\nof self-checkout in 2017."
    } ]
  }, {
    "tStartMs": 997563,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "While inflation is one potential\nexplanation for the lower profits,"
    } ]
  }, {
    "tStartMs": 1000899,
    "dDurationMs": 1402,
    "segs": [ {
      "utf8": "the numbers don't really suggest"
    } ]
  }, {
    "tStartMs": 1002301,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "that as the cost of sales\nas a percentage of revenue"
    } ]
  }, {
    "tStartMs": 1005004,
    "dDurationMs": 2969,
    "segs": [ {
      "utf8": "has grown slower\nthan the cost of labor and administration."
    } ]
  }, {
    "tStartMs": 1008007,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "Even if Walmart is not hiring\nmore cashiers specifically,"
    } ]
  }, {
    "tStartMs": 1011043,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "the point remains\nand that the overhead is higher than ever,"
    } ]
  }, {
    "tStartMs": 1013812,
    "dDurationMs": 2703,
    "segs": [ {
      "utf8": "despite running fewer stores\nand without unions."
    } ]
  }, {
    "tStartMs": 1016515,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "Just in the past year,\nWalmart has ripped out self-checkout"
    } ]
  }, {
    "tStartMs": 1019284,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "in select stores,\nreturned to the conventional aisles,"
    } ]
  }, {
    "tStartMs": 1021954,
    "dDurationMs": 2702,
    "segs": [ {
      "utf8": "and human cashiers, divested\nmany of the tech ventures"
    } ]
  }, {
    "tStartMs": 1024656,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "that had started to better compete\nwith Amazon on the side, and cited"
    } ]
  }, {
    "tStartMs": 1027826,
    "dDurationMs": 4038,
    "segs": [ {
      "utf8": "the need to return to basic,\nhuman-friendly service to grow profits."
    } ]
  }, {
    "tStartMs": 1032164,
    "dDurationMs": 2803,
    "segs": [ {
      "utf8": "Besides Walmart, we can also look at other\nbig grocery chains"
    } ]
  }, {
    "tStartMs": 1034967,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "like Kroger and Albertsons."
    } ]
  }, {
    "tStartMs": 1036502,
    "dDurationMs": 2135,
    "segs": [ {
      "utf8": "The difference is that Kroger\nand Albertsons"
    } ]
  }, {
    "tStartMs": 1038637,
    "dDurationMs": 3237,
    "segs": [ {
      "utf8": "workers are unionized and thus enjoy\nstronger protections, better"
    } ]
  }, {
    "tStartMs": 1041874,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "benefits, and higher wages\nthan those working at Walmart."
    } ]
  }, {
    "tStartMs": 1044910,
    "dDurationMs": 1401,
    "segs": [ {
      "utf8": "While Walmart publicly talked"
    } ]
  }, {
    "tStartMs": 1046311,
    "dDurationMs": 3070,
    "segs": [ {
      "utf8": "about their desires to cut workers\noutright, Kroger and Albertsons"
    } ]
  }, {
    "tStartMs": 1049381,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "could not because they had to maintain\na positive relationship with their unions."
    } ]
  }, {
    "tStartMs": 1052851,
    "dDurationMs": 3804,
    "segs": [ {
      "utf8": "Instead, they talked about self-checkout\nas a way to improve customer experience."
    } ]
  }, {
    "tStartMs": 1056822,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "And Kroger, like Walmart, wanted to show\nto Wall Street that they too were"
    } ]
  }, {
    "tStartMs": 1060125,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "capable of innovation, and they pushed\nthe notion of self-checkout"
    } ]
  }, {
    "tStartMs": 1063128,
    "dDurationMs": 3771,
    "segs": [ {
      "utf8": "to even greater heights as a direct\nresponse to Amazon's technology."
    } ]
  }, {
    "tStartMs": 1066932,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "Kroger rolled out Scan Bag and Go,\nwhere customers could use their phone"
    } ]
  }, {
    "tStartMs": 1070302,
    "dDurationMs": 3604,
    "segs": [ {
      "utf8": "to scan products, put them in their bag\nright afterwards, and then walk right out."
    } ]
  }, {
    "tStartMs": 1073939,
    "dDurationMs": 3437,
    "segs": [ {
      "utf8": "By 2018, self-checkout\nhad been installed in every Kroger store."
    } ]
  }, {
    "tStartMs": 1077543,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "Scan, Bag and Go was available,\nand the company boasted that they had"
    } ]
  }, {
    "tStartMs": 1080879,
    "dDurationMs": 3771,
    "segs": [ {
      "utf8": "unlocked massive double digit productivity\nincreases in all of their stores."
    } ]
  }, {
    "tStartMs": 1084716,
    "dDurationMs": 1702,
    "segs": [ {
      "utf8": "Hilariously, Scan, Bag and Go"
    } ]
  }, {
    "tStartMs": 1086418,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "was quietly killed off in 2022, lasting\njust four years after its launch."
    } ]
  }, {
    "tStartMs": 1090689,
    "dDurationMs": 2903,
    "segs": [ {
      "utf8": "Like Walmart, there's been no change\nin the number of hourly workers"
    } ]
  }, {
    "tStartMs": 1093592,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "per store before or\nafter the implementation of self-checkout."
    } ]
  }, {
    "tStartMs": 1096829,
    "dDurationMs": 2435,
    "segs": [ {
      "utf8": "There may be less cashiers,\nbut not less staff,"
    } ]
  }, {
    "tStartMs": 1099264,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and the lower operating margins\nhave nothing to do with inflation."
    } ]
  }, {
    "tStartMs": 1102267,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "Kroger's product costs as a percentage of revenue"
    } ]
  }, {
    "tStartMs": 1104603,
    "dDurationMs": 2436,
    "segs": [ {
      "utf8": "are actually lower\nthan what they were a decade ago."
    } ]
  }, {
    "tStartMs": 1107039,
    "dDurationMs": 2269,
    "segs": [ {
      "utf8": "Labor and administrative costs,\non the other hand,"
    } ]
  }, {
    "tStartMs": 1109308,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "are actually higher than ever\nand have been for the past six years,"
    } ]
  }, {
    "tStartMs": 1112411,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "despite the company\nforcing self-checkout on customers."
    } ]
  }, {
    "tStartMs": 1115247,
    "dDurationMs": 1902,
    "segs": [ {
      "utf8": "Kroger to this day continues to gaslight"
    } ]
  }, {
    "tStartMs": 1117149,
    "dDurationMs": 1535,
    "segs": [ {
      "utf8": "that self-checkout is the future"
    } ]
  }, {
    "tStartMs": 1118684,
    "dDurationMs": 3370,
    "segs": [ {
      "utf8": "and that it provides a better\ncustomer experience, despite the reality"
    } ]
  }, {
    "tStartMs": 1122054,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "that the company's operating margins\nremain at their lowest."
    } ]
  }, {
    "tStartMs": 1125124,
    "dDurationMs": 3303,
    "segs": [ {
      "utf8": "Albertsons has also hired, on average,\nabout the same amount of workers"
    } ]
  }, {
    "tStartMs": 1128427,
    "dDurationMs": 3236,
    "segs": [ {
      "utf8": "per store before and after\ntheir implementation of self-checkout."
    } ]
  }, {
    "tStartMs": 1131763,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Labor and administrative"
    } ]
  }, {
    "tStartMs": 1132931,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "costs have certainly improved after,\nbut that can also be attributed"
    } ]
  }, {
    "tStartMs": 1135968,
    "dDurationMs": 3403,
    "segs": [ {
      "utf8": "more to the continuous layoffs\nat headquarters and store closures."
    } ]
  }, {
    "tStartMs": 1139671,
    "dDurationMs": 3604,
    "segs": [ {
      "utf8": "Sprouts has opened up more stores year\nafter year, and the numbers demonstrate"
    } ]
  }, {
    "tStartMs": 1143275,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "that they've hired"
    } ]
  }, {
    "tStartMs": 1143942,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "fewer workers since their implementation\nof self-checkout in 2020."
    } ]
  }, {
    "tStartMs": 1147646,
    "dDurationMs": 2536,
    "segs": [ {
      "utf8": "Yet at the same time,\ndespite hiring less people,"
    } ]
  }, {
    "tStartMs": 1150182,
    "dDurationMs": 2736,
    "segs": [ {
      "utf8": "labor and administrative costs\nhave actually increased."
    } ]
  }, {
    "tStartMs": 1152918,
    "dDurationMs": 3136,
    "segs": [ {
      "utf8": "Overall, operating margins\nfor sprouts are lower these days than what"
    } ]
  }, {
    "tStartMs": 1156054,
    "dDurationMs": 2369,
    "segs": [ {
      "utf8": "they were five years ago\nbefore self-checkout."
    } ]
  }, {
    "tStartMs": 1158423,
    "dDurationMs": 3304,
    "segs": [ {
      "utf8": "And once again, it has nothing to do\nwith inflation or product costs."
    } ]
  }, {
    "tStartMs": 1161793,
    "dDurationMs": 1035,
    "segs": [ {
      "utf8": "It's been the same case"
    } ]
  }, {
    "tStartMs": 1162828,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "for even the discount stores\nlike Dollar General and Dollar Tree."
    } ]
  }, {
    "tStartMs": 1165898,
    "dDurationMs": 4104,
    "segs": [ {
      "utf8": "Dollar General did not implement\nself-checkout until 2019, and their labor"
    } ]
  }, {
    "tStartMs": 1170002,
    "dDurationMs": 2969,
    "segs": [ {
      "utf8": "and administrative costs\nhave remained the same in the years after."
    } ]
  }, {
    "tStartMs": 1172971,
    "dDurationMs": 3571,
    "segs": [ {
      "utf8": "The company spent millions of dollars\ninstalling self-checkout machines, only"
    } ]
  }, {
    "tStartMs": 1176542,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "to discover that removing human cashiers\nonly dramatically increased shoplifting."
    } ]
  }, {
    "tStartMs": 1180379,
    "dDurationMs": 2769,
    "segs": [ {
      "utf8": "Dollar General had always run its stores\nwith a skeleton crew"
    } ]
  }, {
    "tStartMs": 1183148,
    "dDurationMs": 2403,
    "segs": [ {
      "utf8": "to cut on labor costs,\nbut now with self-checkout,"
    } ]
  }, {
    "tStartMs": 1185551,
    "dDurationMs": 3036,
    "segs": [ {
      "utf8": "they had removed the human at the front\nand without a staff member"
    } ]
  }, {
    "tStartMs": 1188587,
    "dDurationMs": 1568,
    "segs": [ {
      "utf8": "at the front to deter stealing,"
    } ]
  }, {
    "tStartMs": 1190155,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "opportunistic thieves were walking through self-checkout"
    } ]
  }, {
    "tStartMs": 1192624,
    "dDurationMs": 2970,
    "segs": [ {
      "utf8": "with bags of stolen merchandise\nwithout consequences."
    } ]
  }, {
    "tStartMs": 1195594,
    "dDurationMs": 4137,
    "segs": [ {
      "utf8": "Everything came to a head in 2024,\nwhen profits plummeted to a 16 year"
    } ]
  }, {
    "tStartMs": 1199731,
    "dDurationMs": 1068,
    "segs": [ {
      "utf8": "low over the rampant"
    } ]
  }, {
    "tStartMs": 1200799,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "shoplifting, and Dollar General responded\nby killing off self-checkout entirely."
    } ]
  }, {
    "tStartMs": 1204937,
    "dDurationMs": 2802,
    "segs": [ {
      "utf8": "They ripped out the machines\nat most stores, restored the checkout"
    } ]
  }, {
    "tStartMs": 1207739,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "aisles, and invest\nmore into human cashiers and staff."
    } ]
  }, {
    "tStartMs": 1210742,
    "dDurationMs": 3971,
    "segs": [ {
      "utf8": "With SG\u0026A at an all time high\nand on a per store basis, Dollar"
    } ]
  }, {
    "tStartMs": 1214713,
    "dDurationMs": 3971,
    "segs": [ {
      "utf8": "General is now hiring more people\nthan ever per store in company history."
    } ]
  }, {
    "tStartMs": 1218717,
    "dDurationMs": 3604,
    "segs": [ {
      "utf8": "It's the same situation with Dollar Tree,\nwho is now spending more than ever"
    } ]
  }, {
    "tStartMs": 1222321,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "in labor and administration in history\nto deter the theft that self-checkout."
    } ]
  }, {
    "tStartMs": 1226758,
    "dDurationMs": 3103,
    "segs": [ {
      "utf8": "Despite rolling out\nself-checkout in 2017, Target"
    } ]
  }, {
    "tStartMs": 1229861,
    "dDurationMs": 3904,
    "segs": [ {
      "utf8": "these days has more hourly workers\nper store than it did a decade ago."
    } ]
  }, {
    "tStartMs": 1233932,
    "dDurationMs": 2469,
    "segs": [ {
      "utf8": "Labor costs as a percentage of revenue\nhas remained"
    } ]
  }, {
    "tStartMs": 1236401,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "virtually unchanged for the past ten\nplus years, and annual profit"
    } ]
  }, {
    "tStartMs": 1239738,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "margins are not any better today\nthan they were back in the early 2010s."
    } ]
  }, {
    "tStartMs": 1243875,
    "dDurationMs": 2737,
    "segs": [ {
      "utf8": "The only exception to date\nhas been in home improvement,"
    } ]
  }, {
    "tStartMs": 1246612,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "where Home Depot and Lowe's\nhave both reported a decrease"
    } ]
  }, {
    "tStartMs": 1249448,
    "dDurationMs": 3570,
    "segs": [ {
      "utf8": "in labor costs since their respective\nimplementation of self-checkout."
    } ]
  }, {
    "tStartMs": 1253185,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Their annual operating margins\nhave also materially improved."
    } ]
  }, {
    "tStartMs": 1256288,
    "dDurationMs": 2202,
    "segs": [ {
      "utf8": "There's a couple of factors\nas to how this could be."
    } ]
  }, {
    "tStartMs": 1258490,
    "dDurationMs": 3437,
    "segs": [ {
      "utf8": "One is that theft at self-checkout\nis generally a crime of opportunity,"
    } ]
  }, {
    "tStartMs": 1261927,
    "dDurationMs": 3904,
    "segs": [ {
      "utf8": "meaning that people either intentionally\nor accidentally forget to scan something."
    } ]
  }, {
    "tStartMs": 1265831,
    "dDurationMs": 2969,
    "segs": [ {
      "utf8": "With home improvement,\nthe high value items are generally so big"
    } ]
  }, {
    "tStartMs": 1268800,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and so bulky that that kind of theft\nwould be impossible to hide,"
    } ]
  }, {
    "tStartMs": 1271803,
    "dDurationMs": 3304,
    "segs": [ {
      "utf8": "and the higher value, smaller\nproducts are already under lock and key"
    } ]
  }, {
    "tStartMs": 1275107,
    "dDurationMs": 1234,
    "segs": [ {
      "utf8": "and are already under added"
    } ]
  }, {
    "tStartMs": 1276341,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "surveillance, meaning the opportunity\nfor theft is just that much lower."
    } ]
  }, {
    "tStartMs": 1280078,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "The product value and order sizes at home\nimprovement stores are also"
    } ]
  }, {
    "tStartMs": 1283348,
    "dDurationMs": 3037,
    "segs": [ {
      "utf8": "substantially greater than that\nof supermarkets, and chains like Home"
    } ]
  }, {
    "tStartMs": 1286385,
    "dDurationMs": 3203,
    "segs": [ {
      "utf8": "Depot and Lowe's have already sunk\nmillions of dollars over the decades"
    } ]
  }, {
    "tStartMs": 1289588,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "into loss prevention,"
    } ]
  }, {
    "tStartMs": 1290722,
    "dDurationMs": 3237,
    "segs": [ {
      "utf8": "whereas the grocery chains are just now\nstarting their own investments."
    } ]
  }, {
    "tStartMs": 1294126,
    "dDurationMs": 1134,
    "segs": [ {
      "utf8": "While there are some who assert"
    } ]
  }, {
    "tStartMs": 1295260,
    "dDurationMs": 3270,
    "segs": [ {
      "utf8": "that the failures of self-checkout\nare cultural and psychological,"
    } ]
  }, {
    "tStartMs": 1298530,
    "dDurationMs": 1869,
    "segs": [ {
      "utf8": "it seems obvious that technology"
    } ]
  }, {
    "tStartMs": 1300399,
    "dDurationMs": 3403,
    "segs": [ {
      "utf8": "and machines have a long way to go\nbefore they can replace humans,"
    } ]
  }, {
    "tStartMs": 1303802,
    "dDurationMs": 3871,
    "segs": [ {
      "utf8": "even the ones that corporate America deems\nto be the most useless and replaceable -"
    } ]
  }, {
    "tStartMs": 1307673,
    "dDurationMs": 5372,
    "segs": [ {
      "utf8": "scanning groceries, packing orders, and talking to customers for $10-$15 an hour."
    } ]
  } ]
}
