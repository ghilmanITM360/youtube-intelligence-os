  "events": [ {
    "tStartMs": 41,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "War is a battle over information"
    } ]
  }, {
    "tStartMs": 1876,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "and technology as much as it is about logistics,"
    } ]
  }, {
    "tStartMs": 4421,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "territory, and"
    } ]
  }, {
    "tStartMs": 5213,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "bodies."
    } ]
  }, {
    "tStartMs": 5755,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "Much has been said"
    } ]
  }, {
    "tStartMs": 6506,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "of the potential mineral deal\nbetween the United States and Ukraine."
    } ]
  }, {
    "tStartMs": 9592,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "The Trump Administration\nhas made it clear that Ukraine must"
    } ]
  }, {
    "tStartMs": 12137,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "sign this deal in order"
    } ]
  }, {
    "tStartMs": 13179,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "to secure continued support from\nthe United States."
    } ]
  }, {
    "tStartMs": 15724,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "They've asserted that this deal is\nhow Ukraine will pay back"
    } ]
  }, {
    "tStartMs": 18226,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "all the hundreds of billions\nof dollars in aid"
    } ]
  }, {
    "tStartMs": 20228,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "that's been sent their way."
    } ]
  }, {
    "tStartMs": 21354,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "With the speed of the news cycle,\nit's impossible"
    } ]
  }, {
    "tStartMs": 23356,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "to separate the propaganda\nfrom the substance."
    } ]
  }, {
    "tStartMs": 25483,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "All the reporting is big on headlines\nand light on nuance."
    } ]
  }, {
    "tStartMs": 28319,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "Numbers are thrown"
    } ]
  }, {
    "tStartMs": 29195,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "around like candy and technical names\nlike manganese and"
    } ]
  }, {
    "tStartMs": 32032,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "bismuth are tossed in paragraphs\nlike buzzwords."
    } ]
  }, {
    "tStartMs": 34492,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "The Ukrainians proclaim that they have $13\nto $15 trillion worth of these minerals,"
    } ]
  }, {
    "tStartMs": 38621,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "so paying back the billions of dollars\nto the US that it wants will be easy."
    } ]
  }, {
    "tStartMs": 42292,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "It's just that they need\nsecurity guarantees."
    } ]
  }, {
    "tStartMs": 44377,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Putin, on the other hand, asserts that\nUkraine's minerals aren't worth as much"
    } ]
  }, {
    "tStartMs": 47630,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "and if the U.S. really wants them,"
    } ]
  }, {
    "tStartMs": 49174,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "it'll be easier to just buy them straight\nfrom Russia."
    } ]
  }, {
    "tStartMs": 51259,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Ultimately, history repeats itself."
    } ]
  }, {
    "tStartMs": 53178,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "This is not"
    } ]
  }, {
    "tStartMs": 53678,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "the first modern conflict to spiral\ninto a struggle over natural resources."
    } ]
  }, {
    "tStartMs": 57766,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "In this Modern MBA episode,\nwe're diving into the economics of the"
    } ]
  }, {
    "tStartMs": 60852,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "U.S.-Ukraine mineral deal, evaluating\nwhat parts of it actually have value, and"
    } ]
  }, {
    "tStartMs": 64606,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "drawing parallels"
    } ]
  }, {
    "tStartMs": 65565,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "between what's happening today to\nwhat happened decades ago in Afghanistan,"
    } ]
  }, {
    "tStartMs": 69152,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Iraq, and the Persian Gulf."
    } ]
  }, {
    "tStartMs": 71071,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "What does the future hold in business?"
    } ]
  }, {
    "tStartMs": 72906,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "Ask nine experts\nand you'll get ten answers."
    } ]
  }, {
    "tStartMs": 75241,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "Analysts will say that inflation\nis down in one month and then up the next."
    } ]
  }, {
    "tStartMs": 78787,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "It's the same constant whiplash\nwith unemployment,"
    } ]
  }, {
    "tStartMs": 81372,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "jobs reports,\nand the health of the economy."
    } ]
  }, {
    "tStartMs": 83374,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Could someone please\ninvent a crystal ball?"
    } ]
  }, {
    "tStartMs": 85376,
    "dDurationMs": 835,
    "segs": [ {
      "utf8": "Until then, over"
    } ]
  }, {
    "tStartMs": 86211,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "41,000 businesses have future-proofed\ntheir business with NetSuite by Oracle -"
    } ]
  }, {
    "tStartMs": 90173,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "the number one cloud ERP,\nbringing accounting, finance, inventory,"
    } ]
  }, {
    "tStartMs": 93968,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "and HR into one fluid platform with one\nunified business management suite."
    } ]
  }, {
    "tStartMs": 98306,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "There's one source of truth"
    } ]
  }, {
    "tStartMs": 99474,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "giving you the visibility and control\nyou need to make quick decisions."
    } ]
  }, {
    "tStartMs": 102852,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "With real-time insights and forecasting,\nyou're peering into the future"
    } ]
  }, {
    "tStartMs": 106106,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "with actionable data."
    } ]
  }, {
    "tStartMs": 107273,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "When you're closing the books in days,\nnot weeks, you're spending"
    } ]
  }, {
    "tStartMs": 109859,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "less time looking backwards\nand more time on what's next."
    } ]
  }, {
    "tStartMs": 112862,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Modern MBA is small at the moment,"
    } ]
  }, {
    "tStartMs": 114572,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "but as soon as we scale,\nwe will need and use NetSuite."
    } ]
  }, {
    "tStartMs": 117408,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "Today we're stitching things manually"
    } ]
  }, {
    "tStartMs": 119035,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "and it's gotten harder\nto assess our business health."
    } ]
  }, {
    "tStartMs": 121162,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "We need to track production costs to run\npayroll compliant with multiple states,"
    } ]
  }, {
    "tStartMs": 124916,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "and to evaluate profit\nand loss by team and project."
    } ]
  }, {
    "tStartMs": 127627,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "As a corporation, we pay tax\nthroughout the year and it's a nightmare"
    } ]
  }, {
    "tStartMs": 130630,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "jumping from system to system\njust to get one clear answer."
    } ]
  }, {
    "tStartMs": 133633,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "These are capabilities\nthat only NetSuite provides,"
    } ]
  }, {
    "tStartMs": 135885,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "and it's a platform\nthat we intend to take every advantage of."
    } ]
  }, {
    "tStartMs": 138847,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "Whether your company is earning millions\nor even hundreds of millions, NetSuite"
    } ]
  }, {
    "tStartMs": 142350,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "helps you respond to immediate challenges\nand seize your biggest opportunities."
    } ]
  }, {
    "tStartMs": 146271,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Speaking of opportunity, download the CFO's\nguide to AI and Machine"
    } ]
  }, {
    "tStartMs": 149691,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "Learning at netsuite.com/MODERNMBA."
    } ]
  }, {
    "tStartMs": 152902,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "The guide is free to you at"
    } ]
  }, {
    "tStartMs": 154195,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "netsuite.com/MODERN MBA."
    } ]
  }, {
    "tStartMs": 157115,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "That's netsuite.com/modernMBA."
    } ]
  }, {
    "tStartMs": 160201,
    "dDurationMs": 793,
    "segs": [ {
      "utf8": "Ukraine claims"
    } ]
  }, {
    "tStartMs": 160994,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that they have $15 trillion worth of"
    } ]
  }, {
    "tStartMs": 162704,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "minerals. A natural question to start is"
    } ]
  }, {
    "tStartMs": 164747,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "if Ukraine knew it had so much wealth"
    } ]
  }, {
    "tStartMs": 166457,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "under its feet, then why didn't the"
    } ]
  }, {
    "tStartMs": 167834,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "country exploit these resources before?"
    } ]
  }, {
    "tStartMs": 170003,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "The answer is in Ukraine's history."
    } ]
  }, {
    "tStartMs": 171838,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "The country rushed to"
    } ]
  }, {
    "tStartMs": 172797,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "separate from the Soviet Union in \n1991, but never planned"
    } ]
  }, {
    "tStartMs": 175884,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "for what life would look like on their own."
    } ]
  }, {
    "tStartMs": 177677,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "In this regard, their independence was"
    } ]
  }, {
    "tStartMs": 179429,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "More of a symbolic victory as\nthe country was completely."
    } ]
  }, {
    "tStartMs": 181890,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "unprepared to govern."
    } ]
  }, {
    "tStartMs": 183183,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Without basic policies or systems\nlike taxation, real estate, and housing,"
    } ]
  }, {
    "tStartMs": 187228,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Ukraine struggled through the 1990s."
    } ]
  }, {
    "tStartMs": 189230,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Business was mostly done"
    } ]
  }, {
    "tStartMs": 190231,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "through barter,"
    } ]
  }, {
    "tStartMs": 190857,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "meaning that people paid their taxes\nthrough services rather than cash."
    } ]
  }, {
    "tStartMs": 194444,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The country was ruled by oligarchs"
    } ]
  }, {
    "tStartMs": 196154,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "who used their newfound political power\nto enrich their own pockets."
    } ]
  }, {
    "tStartMs": 199532,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "They wielded the rule of law to stifle"
    } ]
  }, {
    "tStartMs": 201409,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "entrepreneurship, encourage corruption,\nand to extract maximum rents from common"
    } ]
  }, {
    "tStartMs": 205163,
    "dDurationMs": 459,
    "segs": [ {
      "utf8": "people."
    } ]
  }, {
    "tStartMs": 205622,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "All of this came to a head in 1999,\nwhen Ukraine found itself"
    } ]
  }, {
    "tStartMs": 208917,
    "dDurationMs": 417,
    "segs": [ {
      "utf8": "on the brink"
    } ]
  }, {
    "tStartMs": 209334,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "of default as the only post-communist\ncountry with negative economic"
    } ]
  }, {
    "tStartMs": 212962,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "growth in ten years,\nperforming even worse than Russia."
    } ]
  }, {
    "tStartMs": 215924,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "The poor state of Ukraine, whether"
    } ]
  }, {
    "tStartMs": 217383,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "qualitative or quantitative,\npainted a clear picture"
    } ]
  }, {
    "tStartMs": 219719,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "to the UN, the EU, the IMF, and banks"
    } ]
  }, {
    "tStartMs": 222764,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "that Ukraine could not be trusted\nto repay"
    } ]
  }, {
    "tStartMs": 224724,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "the billions of dollars it had borrowed."
    } ]
  }, {
    "tStartMs": 226517,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "Faced with the possibility\nof total economic collapse, the"
    } ]
  }, {
    "tStartMs": 229312,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "oligarchs quickly stepped aside\nnot for the good of"
    } ]
  }, {
    "tStartMs": 231773,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Ukraine, but rather as the only"
    } ]
  }, {
    "tStartMs": 233316,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "means of preserving their own wealth."
    } ]
  }, {
    "tStartMs": 235193,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "With the country now in the \nhands of truly democratically"
    } ]
  }, {
    "tStartMs": 237570,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "elected representatives,\nUkraine pushed intense"
    } ]
  }, {
    "tStartMs": 239906,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "reforms through the country,\neliminating bureaucracy,"
    } ]
  }, {
    "tStartMs": 242533,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "lifting regulations, establishing decision\nmaking processes, and creating"
    } ]
  }, {
    "tStartMs": 246454,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "government programs,\nall in the pursuit of energizing"
    } ]
  }, {
    "tStartMs": 249040,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "the economy."
    } ]
  }, {
    "tStartMs": 249749,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Iron and steel made up\nthe majority of Ukraine's exports,"
    } ]
  }, {
    "tStartMs": 252502,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "but these minerals had proven in the past\ndecade to be insufficient to feed the"
    } ]
  }, {
    "tStartMs": 256172,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "country, both literally and figuratively."
    } ]
  }, {
    "tStartMs": 258383,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "During the Soviet Union, land\nwas seen as a public good."
    } ]
  }, {
    "tStartMs": 261177,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "Ukraine's land was fertile."
    } ]
  }, {
    "tStartMs": 262512,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "It just needed better operators\nand stronger incentives."
    } ]
  }, {
    "tStartMs": 265181,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "Its new democratic leaders\nintroduced property rights,"
    } ]
  }, {
    "tStartMs": 267809,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "disbanded state run-farming,\nand transferred"
    } ]
  }, {
    "tStartMs": 269852,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "public land back in the hands \nof private farmers."
    } ]
  }, {
    "tStartMs": 272272,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "This privatization opened up\nunprecedented"
    } ]
  }, {
    "tStartMs": 274524,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "opportunities for large"
    } ]
  }, {
    "tStartMs": 275692,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "scale production, and investors\nflocked into agriculture, fueled"
    } ]
  }, {
    "tStartMs": 278903,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "by the low-interest commercial loans\nand the promise of minimal taxation."
    } ]
  }, {
    "tStartMs": 282699,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "This was all by design."
    } ]
  }, {
    "tStartMs": 284033,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Compared to mining, farming was faster \nand less risky. Because"
    } ]
  }, {
    "tStartMs": 287328,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "the priority was on growing GDP,"
    } ]
  }, {
    "tStartMs": 289163,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Ukraine did not allow any sale of farmland\nfor the next 20 years."
    } ]
  }, {
    "tStartMs": 292917,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "That way, the private sector would focus\nexclusively on production rather than land"
    } ]
  }, {
    "tStartMs": 296838,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "appreciation."
    } ]
  }, {
    "tStartMs": 297755,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "By 2019,"
    } ]
  }, {
    "tStartMs": 298798,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "agriculture in the form of mostly corn,\nwheat, fruit, and"
    } ]
  }, {
    "tStartMs": 301801,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "seed oils"
    } ]
  }, {
    "tStartMs": 302427,
    "dDurationMs": 4462,
    "segs": [ {
      "utf8": "had grown from less than 2% to over\n25% of Ukraine's exports, surpassing"
    } ]
  }, {
    "tStartMs": 306889,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "the once-leading iron and steel."
    } ]
  }, {
    "tStartMs": 308558,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "This focus on"
    } ]
  }, {
    "tStartMs": 309267,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "agriculture brought Ukraine to better economic"
    } ]
  }, {
    "tStartMs": 311436,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "health, established the country \nas Europe's breadbasket and"
    } ]
  }, {
    "tStartMs": 314188,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "cemented their value as one of the world's\nlargest suppliers of corn and"
    } ]
  }, {
    "tStartMs": 317608,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "wheat."
    } ]
  }, {
    "tStartMs": 318192,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "But despite these rapid improvements,\nUkraine still remains the poorest country"
    } ]
  }, {
    "tStartMs": 321821,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "per capita in Europe,"
    } ]
  }, {
    "tStartMs": 322947,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "even before the Russian"
    } ]
  }, {
    "tStartMs": 324115,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "invasion. There's two things\nthat economists point to to explain the"
    } ]
  }, {
    "tStartMs": 327577,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "country's continued struggles."
    } ]
  }, {
    "tStartMs": 329037,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "Ukraine consistently ranks\nas one of the most corrupt countries"
    } ]
  }, {
    "tStartMs": 331789,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "in Europe on the corruption\nindex and scores below"
    } ]
  }, {
    "tStartMs": 334208,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "even the countries of sub-Saharan Africa"
    } ]
  }, {
    "tStartMs": 336252,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "and this is a problem\nthat has plagued the"
    } ]
  }, {
    "tStartMs": 337712,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "country long before the \ncurrent administration."
    } ]
  }, {
    "tStartMs": 340048,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "The oligarchs never left Ukraine\nand simply"
    } ]
  }, {
    "tStartMs": 342216,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "found new ways to enrich themselves\nunder democracy,"
    } ]
  }, {
    "tStartMs": 344802,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "just as they had done under communism."
    } ]
  }, {
    "tStartMs": 346888,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "The politicians who ran the country happily"
    } ]
  }, {
    "tStartMs": 348890,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "participated in their schemes,\nsince lawmakers had explicit."
    } ]
  }, {
    "tStartMs": 352018,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "immunity to prosecution -"
    } ]
  }, {
    "tStartMs": 353561,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "a law that Zelensky repealed\nwhen he became president."
    } ]
  }, {
    "tStartMs": 356356,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "The other factor is foreign investment."
    } ]
  }, {
    "tStartMs": 358191,
    "dDurationMs": 4337,
    "segs": [ {
      "utf8": "Foreign investment through the 2010s\nfor Ukraine was as low as 1% of GDP."
    } ]
  }, {
    "tStartMs": 362570,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "There was no room for \neven local entrepreneurship."
    } ]
  }, {
    "tStartMs": 365073,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "The oligarchs were now"
    } ]
  }, {
    "tStartMs": 366324,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "agricultural tycoons and had secretly\nextended their reach"
    } ]
  }, {
    "tStartMs": 369285,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "into banking, instead of helping"
    } ]
  }, {
    "tStartMs": 370787,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "their own people secure their savings."
    } ]
  }, {
    "tStartMs": 372497,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "These oligarchs started\nprivate banks to launder"
    } ]
  }, {
    "tStartMs": 374749,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "money and siphoned cash\nfrom the state treasury"
    } ]
  }, {
    "tStartMs": 377168,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "by issuing themselves\ngenerous loans that they never repaid."
    } ]
  }, {
    "tStartMs": 380004,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Thus, when their banks went"
    } ]
  }, {
    "tStartMs": 381214,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "belly up, so did the savings of tens\nof thousands of its citizens. Plagued"
    } ]
  }, {
    "tStartMs": 384801,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "with corruption and underinvestment,"
    } ]
  }, {
    "tStartMs": 386427,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Ukraine was simply incapable of\nfollowing through on the"
    } ]
  }, {
    "tStartMs": 389013,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "capital-intensive, risky\nmining of minerals,"
    } ]
  }, {
    "tStartMs": 391516,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "even before the war."
    } ]
  }, {
    "tStartMs": 392725,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "The deal with the United States in essence"
    } ]
  }, {
    "tStartMs": 394727,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "is a forcing function for Ukraine\nto finally tap into these"
    } ]
  }, {
    "tStartMs": 397522,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "natural resources."
    } ]
  }, {
    "tStartMs": 398648,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "The prevailing theory in the media"
    } ]
  }, {
    "tStartMs": 400274,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "is that the mineral deal with \nUkraine is the first of"
    } ]
  }, {
    "tStartMs": 402610,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "many steps that the United States\nis taking"
    } ]
  }, {
    "tStartMs": 404570,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "to reduce its reliance on adversaries\nlike China for these rare minerals."
    } ]
  }, {
    "tStartMs": 408366,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "We can see how plausible this is\nwhen we poke at its specifics."
    } ]
  }, {
    "tStartMs": 411536,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "Every country and entity"
    } ]
  }, {
    "tStartMs": 412870,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "defines its own list of critical minerals."
    } ]
  }, {
    "tStartMs": 415081,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "The EU has a list of 32."
    } ]
  }, {
    "tStartMs": 416874,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "The Department of Interior"
    } ]
  }, {
    "tStartMs": 418167,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "has a list of 50 that it deems essential\nfor the US economy,"
    } ]
  }, {
    "tStartMs": 421170,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "and the Department of Defense outlines\n58 different minerals specifically"
    } ]
  }, {
    "tStartMs": 424799,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "for maintaining American military power."
    } ]
  }, {
    "tStartMs": 427009,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "There's no master list or"
    } ]
  }, {
    "tStartMs": 428052,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "even consensus on what minerals are most valuable."
    } ]
  }, {
    "tStartMs": 430763,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "If we take the intersection\nof all these different lists,"
    } ]
  }, {
    "tStartMs": 432932,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "we end up with 22 minerals."
    } ]
  }, {
    "tStartMs": 434517,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "The United States Geological"
    } ]
  }, {
    "tStartMs": 435935,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "Survey is a"
    } ]
  }, {
    "tStartMs": 436644,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "federal agency that assesses\nthe availability and consumption"
    } ]
  }, {
    "tStartMs": 439730,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "of these rare minerals every year."
    } ]
  }, {
    "tStartMs": 441482,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "The key metric they track"
    } ]
  }, {
    "tStartMs": 442733,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "is net import reliance,\nwhere they calculate how much of a"
    } ]
  }, {
    "tStartMs": 445486,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "specific mineral is imported into"
    } ]
  }, {
    "tStartMs": 447155,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "the U.S., how much of that same"
    } ]
  }, {
    "tStartMs": 448781,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "resources exported, and then report\nthe net amount imported as a"
    } ]
  }, {
    "tStartMs": 452118,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "percentage of consumption that same year."
    } ]
  }, {
    "tStartMs": 454370,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "By factoring in real usage,\nnet import reliance"
    } ]
  }, {
    "tStartMs": 457331,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "distinguishes if a mineral is\njust being imported in to be stockpiled"
    } ]
  }, {
    "tStartMs": 460877,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "vs being imported in and consumed in production."
    } ]
  }, {
    "tStartMs": 463546,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Thus, the higher the net import\nreliance, the more"
    } ]
  }, {
    "tStartMs": 465923,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "dependent the United States is on"
    } ]
  }, {
    "tStartMs": 467633,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "on importing from other countries to"
    } ]
  }, {
    "tStartMs": 469510,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "meet domestic demand."
    } ]
  }, {
    "tStartMs": 471053,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "When we chart the five year\naverage of net import"
    } ]
  }, {
    "tStartMs": 473347,
    "dDurationMs": 793,
    "segs": [ {
      "utf8": "reliance of"
    } ]
  }, {
    "tStartMs": 474140,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "every mineral"
    } ]
  }, {
    "tStartMs": 474807,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "on our intersecting list,\nwe can see that the U.S."
    } ]
  }, {
    "tStartMs": 477268,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "is dependent"
    } ]
  }, {
    "tStartMs": 477852,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "on foreign imports"
    } ]
  }, {
    "tStartMs": 478811,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "for 19 out of the 22 minerals."
    } ]
  }, {
    "tStartMs": 480897,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "The only three minerals that the US\nis not relying on"
    } ]
  }, {
    "tStartMs": 483649,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "other countries for are"
    } ]
  }, {
    "tStartMs": 484817,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "beryllium, hafnium, and lithium."
    } ]
  }, {
    "tStartMs": 486777,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "Relying on imports\nby default is not a bad thing."
    } ]
  }, {
    "tStartMs": 489405,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "No country could have all"
    } ]
  }, {
    "tStartMs": 490656,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "the resources and minerals that it needs."
    } ]
  }, {
    "tStartMs": 492533,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The purpose of globalization is to trade\nwhat you have more of"
    } ]
  }, {
    "tStartMs": 495536,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "in exchange for what you have less of."
    } ]
  }, {
    "tStartMs": 497079,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "But the point of contention\nfor the United States"
    } ]
  }, {
    "tStartMs": 499081,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "is that when you want to be the world\npolice,"
    } ]
  }, {
    "tStartMs": 500958,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "when you want to hold the biggest stick,\nand you want to dictate"
    } ]
  }, {
    "tStartMs": 503211,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "to other countries how they should govern\nor who should be in charge, you"
    } ]
  }, {
    "tStartMs": 506088,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "make enemies."
    } ]
  }, {
    "tStartMs": 506839,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "And when you depend on your adversaries\nrather than your"
    } ]
  }, {
    "tStartMs": 509091,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "allies to supply critical minerals,"
    } ]
  }, {
    "tStartMs": 511010,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "this perpetual reliance"
    } ]
  }, {
    "tStartMs": 512303,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "becomes not just a risk, but\nan unacceptable Achilles heel for the U.S."
    } ]
  }, {
    "tStartMs": 516057,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "military-industrial complex."
    } ]
  }, {
    "tStartMs": 518100,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "Of the 22 critical minerals on our list,"
    } ]
  }, {
    "tStartMs": 520311,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "the US relies heavily on China\nto supply 8 of them"
    } ]
  }, {
    "tStartMs": 523314,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "to compensate for the domestic deficit."
    } ]
  }, {
    "tStartMs": 525358,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "When relationships between the U.S. and"
    } ]
  }, {
    "tStartMs": 527068,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "China were positive in the early"
    } ]
  }, {
    "tStartMs": 528444,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "2010s, that dependency was as high as up\nto 10 minerals on this list."
    } ]
  }, {
    "tStartMs": 532198,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "As the relationship"
    } ]
  }, {
    "tStartMs": 533074,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "between these two countries"
    } ]
  }, {
    "tStartMs": 534116,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "have deteriorated over the past decade,"
    } ]
  }, {
    "tStartMs": 536244,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "the U.S. has made a concerted effort\nto import what it needs from"
    } ]
  }, {
    "tStartMs": 539038,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "allies rather than from China,\nbut that has only"
    } ]
  }, {
    "tStartMs": 541165,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "worked in a few cases."
    } ]
  }, {
    "tStartMs": 542458,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "For instance, cobalt is used for jet"
    } ]
  }, {
    "tStartMs": 544335,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "engines, batteries, and munitions, and\nthe US has been able to successfully swap"
    } ]
  }, {
    "tStartMs": 548422,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "out China for Norway\nas their primary supplier."
    } ]
  }, {
    "tStartMs": 551133,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "Germanium, which is used in infrared, NVGS, \nsemiconductors, and satellites."
    } ]
  }, {
    "tStartMs": 555596,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "is another case where the US was able\nto drop China for Belgium."
    } ]
  }, {
    "tStartMs": 558724,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "as its primary source."
    } ]
  }, {
    "tStartMs": 560101,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "But for the remainder of these\nminerals, the"
    } ]
  }, {
    "tStartMs": 561894,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "US is simply unable\nto wean itself off of China."
    } ]
  }, {
    "tStartMs": 564647,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "China is by and large\nthe only game in town for minerals."
    } ]
  }, {
    "tStartMs": 567858,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "Antimony is used in night vision\ngoggles, nuclear weapons, explosives,"
    } ]
  }, {
    "tStartMs": 571737,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "and infrared sensors.\nRare earth metals and"
    } ]
  }, {
    "tStartMs": 574073,
    "dDurationMs": 501,
    "segs": [ {
      "utf8": "elements"
    } ]
  }, {
    "tStartMs": 574574,
    "dDurationMs": 875,
    "segs": [ {
      "utf8": "like yttrium are"
    } ]
  }, {
    "tStartMs": 575449,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "used not just in civilian \nessentials like GPS,"
    } ]
  }, {
    "tStartMs": 578035,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "smartphones, computers,"
    } ]
  }, {
    "tStartMs": 579537,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "and X-ray machines, but also in\nmilitary necessities"
    } ]
  }, {
    "tStartMs": 582164,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "like missiles, aircraft,\nweapons, and submarines."
    } ]
  }, {
    "tStartMs": 584834,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "In all of these examples,\nChina is the largest"
    } ]
  }, {
    "tStartMs": 586877,
    "dDurationMs": 1711,
    "segs": [ {
      "utf8": "producer and exporter and has"
    } ]
  }, {
    "tStartMs": 588588,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "been since the 1990s, as the US"
    } ]
  }, {
    "tStartMs": 590965,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "has levied more tariffs and"
    } ]
  }, {
    "tStartMs": 592383,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "restrictions onto China."
    } ]
  }, {
    "tStartMs": 593426,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "In recent years,\nChina has responded tit for tat,"
    } ]
  }, {
    "tStartMs": 596053,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "by stopping their supply\nof these critical minerals to the US."
    } ]
  }, {
    "tStartMs": 599307,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "China has built"
    } ]
  }, {
    "tStartMs": 600141,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "their monopoly in minerals over many"
    } ]
  }, {
    "tStartMs": 601809,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "decades. While the US has established"
    } ]
  }, {
    "tStartMs": 603769,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "its superpower through military might and currency,"
    } ]
  }, {
    "tStartMs": 606147,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "China has cultivated its influence\nover the decade."
    } ]
  }, {
    "tStartMs": 608774,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "primarily through economics."
    } ]
  }, {
    "tStartMs": 610610,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "It's not that the Chinese somehow lucked\nout on having all the minerals in their"
    } ]
  }, {
    "tStartMs": 613529,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "border, and everyone else in the world\njust missed the jackpot."
    } ]
  }, {
    "tStartMs": 616490,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "Despite the advancements in technology,\nmining is"
    } ]
  }, {
    "tStartMs": 619035,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "a dirty business with far reaching"
    } ]
  }, {
    "tStartMs": 620661,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "environmental and social consequences."
    } ]
  }, {
    "tStartMs": 622830,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Mines in the U.S. rarely\nget off the ground."
    } ]
  }, {
    "tStartMs": 625124,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "Due to the heavy"
    } ]
  }, {
    "tStartMs": 625750,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "regulations, intense public backlash,\nhigh risk, and low political."
    } ]
  }, {
    "tStartMs": 629670,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "popularity,"
    } ]
  }, {
    "tStartMs": 630504,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "the only thing worse than a cemetery\nin someone's backyard is a mine."
    } ]
  }, {
    "tStartMs": 633716,
    "dDurationMs": 292,
    "segs": [ {
      "utf8": "All of"
    } ]
  }, {
    "tStartMs": 634008,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "these factors are why it's been cheaper for thes"
    } ]
  }, {
    "tStartMs": 635885,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "U.S. to simply outsource these"
    } ]
  }, {
    "tStartMs": 637428,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "minerals from other countries, who"
    } ]
  }, {
    "tStartMs": 638929,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "take on all the risk and damage."
    } ]
  }, {
    "tStartMs": 640514,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "China's ambition to win the global\nmineral trade started in the 1990s,"
    } ]
  }, {
    "tStartMs": 644060,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "as they opted to mine first"
    } ]
  }, {
    "tStartMs": 645478,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "and deal with the consequences\nsecond. To get ahead,"
    } ]
  }, {
    "tStartMs": 648147,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "they kept regulations lax,"
    } ]
  }, {
    "tStartMs": 649732,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "prioritized output over the environment,\nand turned a blind"
    } ]
  }, {
    "tStartMs": 652610,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "eye as private operators"
    } ]
  }, {
    "tStartMs": 654028,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "dumped toxic waste into local waterways\nand communities.  To China,"
    } ]
  }, {
    "tStartMs": 657782,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "these externalities were the price\nthat they were willing to pay for growth."
    } ]
  }, {
    "tStartMs": 661118,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "The U.S. themselves paid"
    } ]
  }, {
    "tStartMs": 662536,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "a similar price for rapid"
    } ]
  }, {
    "tStartMs": 663954,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "industrialization in the 1900s. For China,"
    } ]
  }, {
    "tStartMs": 667041,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "giving up water ands oil cleanliness in"
    } ]
  }, {
    "tStartMs": 668417,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "exchange for mining superiority in the"
    } ]
  }, {
    "tStartMs": 670252,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "Southeast was ultimately not any different\nfrom what they did in the Northeast,"
    } ]
  }, {
    "tStartMs": 673673,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "where they allowed air pollution\nin exchange for manufacturing dominance."
    } ]
  }, {
    "tStartMs": 677259,
    "dDurationMs": 3838,
    "segs": [ {
      "utf8": "Over the decades, China has transitioned\nits mineral business away from private"
    } ]
  }, {
    "tStartMs": 681097,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "ventures and towards state-owned enterprises, \nwhere output"
    } ]
  }, {
    "tStartMs": 683891,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "comes before profits,"
    } ]
  }, {
    "tStartMs": 685101,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "regulations are absorbed,\noversight is internalized,"
    } ]
  }, {
    "tStartMs": 688104,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "projects can be financed overnight by"
    } ]
  }, {
    "tStartMs": 690022,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "the public banks, and policy can"
    } ]
  }, {
    "tStartMs": 691941,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "align with production."
    } ]
  }, {
    "tStartMs": 693317,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Minerals are core to China's\ngeopolitical ambitions"
    } ]
  }, {
    "tStartMs": 695903,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "and a key bargaining chip in Xi\nJinping's foreign policy."
    } ]
  }, {
    "tStartMs": 699031,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "As China has developed,\nthey've been able to"
    } ]
  }, {
    "tStartMs": 700825,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "slowly prioritize their own people\nand land with their new riches."
    } ]
  }, {
    "tStartMs": 703953,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Instead of mining more at home,"
    } ]
  }, {
    "tStartMs": 705413,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "they've shifted more production to other\ncountries who are rich in these resources"
    } ]
  }, {
    "tStartMs": 708916,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "but like Ukraine,"
    } ]
  }, {
    "tStartMs": 709875,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "lack the infrastructure, capital,\nor systems"
    } ]
  }, {
    "tStartMs": 712128,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "to capitalize. China\nregularly makes billion dollar deals in"
    } ]
  }, {
    "tStartMs": 715464,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Africa, where those emerging governments are happy"
    } ]
  }, {
    "tStartMs": 717925,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "to trade their resources in \nexchange for infrastructure and cash as"
    } ]
  }, {
    "tStartMs": 721095,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "they're unable to capitalize\non these minerals themselves."
    } ]
  }, {
    "tStartMs": 723597,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "In the Congo,"
    } ]
  }, {
    "tStartMs": 724306,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "the Chinese have built roads, hospitals,\nand the mines themselves in exchange"
    } ]
  }, {
    "tStartMs": 728018,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "for a 60% share in their lithium \nand cobalt."
    } ]
  }, {
    "tStartMs": 730896,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "In Kenya, China is building a data center,"
    } ]
  }, {
    "tStartMs": 732982,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "a smart city, and fiber internet\nin exchange for exclusive"
    } ]
  }, {
    "tStartMs": 735985,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "mining licenses."
    } ]
  }, {
    "tStartMs": 737069,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "And when these same"
    } ]
  }, {
    "tStartMs": 737820,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "African countries need money,\nChina also provides loans as a"
    } ]
  }, {
    "tStartMs": 740781,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "creditor and is a faster\nalternative to the World Bank"
    } ]
  }, {
    "tStartMs": 743367,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "and IMF."
    } ]
  }, {
    "tStartMs": 744326,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Foreign investment from China to"
    } ]
  }, {
    "tStartMs": 745786,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Africa alone"
    } ]
  }, {
    "tStartMs": 746620,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "stands at 4%"
    } ]
  }, {
    "tStartMs": 747747,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "of their GDP, and that's \nsomething that Ukraine"
    } ]
  }, {
    "tStartMs": 749790,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "has lacked throughout its own history."
    } ]
  }, {
    "tStartMs": 751333,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "China can make these deals\nand take on these projects"
    } ]
  }, {
    "tStartMs": 753753,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "because the mining, banking,\nand construction are all state-owned,"
    } ]
  }, {
    "tStartMs": 756756,
    "dDurationMs": 2293,
    "segs": [ {
      "utf8": "so the speed at which the Chinese\ncan build and the"
    } ]
  }, {
    "tStartMs": 759049,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "timelines that they're willing to wait\nfor returns is"
    } ]
  }, {
    "tStartMs": 761260,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "unmatched. Infrastructure, rather"
    } ]
  }, {
    "tStartMs": 763262,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "than cash, is ultimately more valuable\nto these developing countries,"
    } ]
  }, {
    "tStartMs": 766474,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "who suffer from corruption like Ukraine."
    } ]
  }, {
    "tStartMs": 768476,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "The United States has donated"
    } ]
  }, {
    "tStartMs": 769894,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "comparable billions in foreign\naid to Africa year after year, but"
    } ]
  }, {
    "tStartMs": 773230,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "do so without that\ntransactional capitalist mindset"
    } ]
  }, {
    "tStartMs": 775900,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "and it's ultimately China who has\nsomething to show for what they've put in."
    } ]
  }, {
    "tStartMs": 779153,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "China has maintained\ncontrol of the global mineral trade"
    } ]
  }, {
    "tStartMs": 781739,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "by importing the raw inputs from Africa,"
    } ]
  }, {
    "tStartMs": 783991,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "refining them at home, and then \nselling the finished outputs to"
    } ]
  }, {
    "tStartMs": 786827,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "the rest of the world."
    } ]
  }, {
    "tStartMs": 787912,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "Africa performs the"
    } ]
  }, {
    "tStartMs": 788829,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "extraction, supplies the bodies,"
    } ]
  }, {
    "tStartMs": 790790,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "and bears all the externalities\nwhile trying to build the"
    } ]
  }, {
    "tStartMs": 793250,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "infrastructure, and creates the long-term"
    } ]
  }, {
    "tStartMs": 795169,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "edge.  They control supply\nand by extension, control price."
    } ]
  }, {
    "tStartMs": 799215,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "What Ukraine won't admit is that"
    } ]
  }, {
    "tStartMs": 800800,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "even if their minerals are truly worth\nthe $12"
    } ]
  }, {
    "tStartMs": 802927,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "to $15 trillion that their government\nclaims, the specific minerals that they do"
    } ]
  }, {
    "tStartMs": 806806,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "possess will not"
    } ]
  }, {
    "tStartMs": 807598,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "actually help reduce American"
    } ]
  }, {
    "tStartMs": 808933,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "dependance on Chinese minerals."
    } ]
  }, {
    "tStartMs": 810684,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "In the world of mining, there's a\ndifference between deposits and reserves."
    } ]
  }, {
    "tStartMs": 814230,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "A deposit means that\nthere's an above average concentration of"
    } ]
  }, {
    "tStartMs": 817024,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "a mineral at this location,\nbut more studies have to be"
    } ]
  }, {
    "tStartMs": 819944,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "performed, samples have to be taken,\nand the site has to"
    } ]
  }, {
    "tStartMs": 822530,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "be further surveyed in order to\nassess feasibility."
    } ]
  }, {
    "tStartMs": 825199,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "Beyond regulations, a deposit could\nlook very promising"
    } ]
  }, {
    "tStartMs": 828035,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "but could be unviable\nif the location is too remote,"
    } ]
  }, {
    "tStartMs": 830579,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "if the market price of that"
    } ]
  }, {
    "tStartMs": 831539,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "mineral falls, if the mineral\nconcentration turns out to be too"
    } ]
  }, {
    "tStartMs": 834583,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "low, or if the size"
    } ]
  }, {
    "tStartMs": 835543,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "of the deposit is too small\nto sustain the next"
    } ]
  }, {
    "tStartMs": 837920,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "10-30 years"
    } ]
  }, {
    "tStartMs": 839046,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "that a mine is expected to run for"
    } ]
  }, {
    "tStartMs": 841006,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "A deposit can only be called a"
    } ]
  }, {
    "tStartMs": 842383,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "reserve after it's been verified"
    } ]
  }, {
    "tStartMs": 844218,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "to be economically and technologically viable, but"
    } ]
  }, {
    "tStartMs": 846971,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "even reserves are not guaranteed."
    } ]
  }, {
    "tStartMs": 848556,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "More studies have to be conducted,\nand everything in the mining"
    } ]
  }, {
    "tStartMs": 851684,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "world is an estimate."
    } ]
  }, {
    "tStartMs": 852726,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Nothing is certain\nuntil the drilling starts."
    } ]
  }, {
    "tStartMs": 854895,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Despite this nuance,\nUkraine has continued to hype"
    } ]
  }, {
    "tStartMs": 857314,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "up the value of its minerals\nthrough the media, who can't be"
    } ]
  }, {
    "tStartMs": 859650,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "bothered to research the difference\nbetween deposits and reserves."
    } ]
  }, {
    "tStartMs": 862653,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "The only way to perform\nobjective analysis is to go"
    } ]
  }, {
    "tStartMs": 865281,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "through their claims at face value."
    } ]
  }, {
    "tStartMs": 866907,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "Ukraine says they have about 14,000\nreserves of beryllium."
    } ]
  }, {
    "tStartMs": 870035,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Beryllium is stronger than"
    } ]
  }, {
    "tStartMs": 871203,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "steel and lighter than aluminum, making"
    } ]
  }, {
    "tStartMs": 873247,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "it the material of choice\nfor fighter planes, targeting"
    } ]
  }, {
    "tStartMs": 875791,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "systems, and communications."
    } ]
  }, {
    "tStartMs": 877293,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "But 60% of the world's beryllium"
    } ]
  }, {
    "tStartMs": 879253,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "is located in the United States."
    } ]
  }, {
    "tStartMs": 881213,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "The number of reserves"
    } ]
  }, {
    "tStartMs": 882256,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "in the state of Utah alone exceeds\nthat of Ukraine."
    } ]
  }, {
    "tStartMs": 885050,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "The U.S."
    } ]
  }, {
    "tStartMs": 885634,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "is the leading producer\nand exporter of beryllium at 190"
    } ]
  }, {
    "tStartMs": 888721,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "tons per year, which is over double"
    } ]
  }, {
    "tStartMs": 890764,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "the production of the second biggest player."
    } ]
  }, {
    "tStartMs": 892808,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Because of America's domestic production,"
    } ]
  }, {
    "tStartMs": 894768,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "Ukraine's beryllium is not strategic to the US."
    } ]
  }, {
    "tStartMs": 897730,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Ukraine alleges that they have 140 million\ntons of manganese"
    } ]
  }, {
    "tStartMs": 901025,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "reserves, but that's also not strategic."
    } ]
  }, {
    "tStartMs": 903485,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "The US gets its manganese from Gabon,\nits ally in central Africa."
    } ]
  }, {
