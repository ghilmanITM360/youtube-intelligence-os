      "utf8": "enjoys a privilege\nnot just in reach and purchasing"
    } ]
  }, {
    "tStartMs": 1463545,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "power, but also in influence."
    } ]
  }, {
    "tStartMs": 1465338,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "If you want to be a part of this"
    } ]
  }, {
    "tStartMs": 1466548,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "global economy, you need access to dollars."
    } ]
  }, {
    "tStartMs": 1468925,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "And when you use dollars,\nyou involve American banks."
    } ]
  }, {
    "tStartMs": 1471720,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "This gives the US a centralized power,\nand they"
    } ]
  }, {
    "tStartMs": 1474097,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "get to decide who does and who does not\nget to take part in international"
    } ]
  }, {
    "tStartMs": 1477434,
    "dDurationMs": 459,
    "segs": [ {
      "utf8": "trade."
    } ]
  }, {
    "tStartMs": 1477893,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "In this modern era, the U.S."
    } ]
  }, {
    "tStartMs": 1479436,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "has progressively relied\nmore on economic coercion"
    } ]
  }, {
    "tStartMs": 1482022,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "rather than military strength to"
    } ]
  }, {
    "tStartMs": 1483523,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "advance its geopolitical interests."
    } ]
  }, {
    "tStartMs": 1485400,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Sanctions are cheaper than military action."
    } ]
  }, {
    "tStartMs": 1487569,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "The number of sanctions\nimposed on foreign"
    } ]
  }, {
    "tStartMs": 1489362,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "countries and entities\nhave increased by 900% in the past"
    } ]
  }, {
    "tStartMs": 1492324,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "20 years, and countries like Iran,"
    } ]
  }, {
    "tStartMs": 1494493,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "Cuba, Venezuela,"
    } ]
  }, {
    "tStartMs": 1495869,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Syria, North Korea, and Russia"
    } ]
  }, {
    "tStartMs": 1497829,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "have all been excluded\nfrom the global economy."
    } ]
  }, {
    "tStartMs": 1499998,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "They serve as a warning\nfor smaller countries"
    } ]
  }, {
    "tStartMs": 1501875,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "to follow what the US wants,"
    } ]
  }, {
    "tStartMs": 1503460,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "For better or worse.\nTo preserve the power of the dollar"
    } ]
  }, {
    "tStartMs": 1506171,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "and to maintain leadership in"
    } ]
  }, {
    "tStartMs": 1507464,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the international financial system,"
    } ]
  }, {
    "tStartMs": 1509174,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "The U.S."
    } ]
  }, {
    "tStartMs": 1509758,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "has a vested interest"
    } ]
  }, {
    "tStartMs": 1510884,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "in keeping the global economy humming,\nand that was put to a test in the 1990s."
    } ]
  }, {
    "tStartMs": 1515263,
    "dDurationMs": 501,
    "segs": [ {
      "utf8": "The world"
    } ]
  }, {
    "tStartMs": 1515764,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "economy then, was almost run\nexclusively on oil."
    } ]
  }, {
    "tStartMs": 1518391,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "Everyone needed it, used it,\nand the U.S. was."
    } ]
  }, {
    "tStartMs": 1520894,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "The largest consumer of petroleum."
    } ]
  }, {
    "tStartMs": 1522729,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "The United States got most of its oil\nfrom its neighbors in Canada"
    } ]
  }, {
    "tStartMs": 1525607,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and Mexico - and only a small slice\nfrom the Middle East."
    } ]
  }, {
    "tStartMs": 1528527,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "The vast"
    } ]
  }, {
    "tStartMs": 1529027,
    "dDurationMs": 375,
    "segs": [ {
      "utf8": "majority"
    } ]
  }, {
    "tStartMs": 1529402,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "of oil that's produced in the Middle"
    } ]
  }, {
    "tStartMs": 1530862,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "East is not exported west,\nbut instead flows east,"
    } ]
  }, {
    "tStartMs": 1533907,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "traveling through the waters"
    } ]
  }, {
    "tStartMs": 1534991,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "of the Persian Gulf\nand the Strait of Hormuz"
    } ]
  }, {
    "tStartMs": 1536910,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "to supply Europe and Asia."
    } ]
  }, {
    "tStartMs": 1538578,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Saddam Hussein was an expansionist."
    } ]
  }, {
    "tStartMs": 1540580,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "Surrounded by fellow petrol states,"
    } ]
  }, {
    "tStartMs": 1542374,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "he viewed his"
    } ]
  }, {
    "tStartMs": 1542916,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "neighbors as his competitors,\nas their production levels"
    } ]
  }, {
    "tStartMs": 1545502,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "directly impacted Iraq's oil revenues."
    } ]
  }, {
    "tStartMs": 1548004,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "He attacked Iran and"
    } ]
  }, {
    "tStartMs": 1549256,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "invaded Kuwait with the aim\nof seizing their oil fields and"
    } ]
  }, {
    "tStartMs": 1552008,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "establishing Iraq\nas the dominant power in the region."
    } ]
  }, {
    "tStartMs": 1554970,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Just like what China does today\nwith minerals, Saddam"
    } ]
  }, {
    "tStartMs": 1557472,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "knew that if he could control supply,\nhe could control price."
    } ]
  }, {
    "tStartMs": 1560642,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "His attacks destabilize the entire region"
    } ]
  }, {
    "tStartMs": 1562936,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "and Saudi Arabia, a"
    } ]
  }, {
    "tStartMs": 1564145,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "long-standing American ally, feared\nthat they would be next to be invaded."
    } ]
  }, {
    "tStartMs": 1567440,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "There was mounting global concern that"
    } ]
  }, {
    "tStartMs": 1569109,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "oil production in the Middle East\nwould fall into the hands of someone"
    } ]
  }, {
    "tStartMs": 1572112,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "as hostile, unstable, and unpredictable\nas Saddam Hussein."
    } ]
  }, {
    "tStartMs": 1575407,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "And in this situation, sanctions\nwould be useless."
    } ]
  }, {
    "tStartMs": 1577826,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "The Middle East alone produces"
    } ]
  }, {
    "tStartMs": 1579327,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "over a third of the world's oil"
    } ]
  }, {
    "tStartMs": 1580829,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "and holds nearly 50% of \nthe world's reserves,"
    } ]
  }, {
    "tStartMs": 1583164,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "so even if the petroleum\nfrom the Middle East"
    } ]
  }, {
    "tStartMs": 1585250,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "doesn't flow to the U.S.,\nit feeds the other countries"
    } ]
  }, {
    "tStartMs": 1587711,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "that the US depends on, like \nChina, India, Germany, and Japan."
    } ]
  }, {
    "tStartMs": 1591631,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "By this point in the 1990s,"
    } ]
  }, {
    "tStartMs": 1593216,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "the world had already experienced"
    } ]
  }, {
    "tStartMs": 1594551,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "multiple oil shocks through the"
    } ]
  }, {
    "tStartMs": 1595927,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "1970s, where Middle East"
    } ]
  }, {
    "tStartMs": 1597304,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "oil shortages directly caused recessions\nacross the West. Everyone, not"
    } ]
  }, {
    "tStartMs": 1601266,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "just the United States, was acutely aware of"
    } ]
  }, {
    "tStartMs": 1603435,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "what was at stake if Saddam Hussein\nwas to take control of the entire"
    } ]
  }, {
    "tStartMs": 1606521,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "region. If you were to limit or pause"
    } ]
  }, {
    "tStartMs": 1608523,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "oil exports entirely, it could mean \na collapse of the entire"
    } ]
  }, {
    "tStartMs": 1611484,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "world economy."
    } ]
  }, {
    "tStartMs": 1612485,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "The stakes were so high"
    } ]
  }, {
    "tStartMs": 1613528,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "that over 40 countries\nrallied together with"
    } ]
  }, {
    "tStartMs": 1615488,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "the United States, to fight back against\nSaddam Hussein, and that even included"
    } ]
  }, {
    "tStartMs": 1618992,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "the neutral Swedes and Norwegians.\nFar-off nations like Japan, Spain, and"
    } ]
  }, {
    "tStartMs": 1622954,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "South Korea even contributed\nmen and money to the war effort, as"
    } ]
  }, {
    "tStartMs": 1625915,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "even they had something to lose.\nThe oil had to keep flowing."
    } ]
  }, {
    "tStartMs": 1629377,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "This, in effect, was why\nthe Persian Gulf War was"
    } ]
  }, {
    "tStartMs": 1631504,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "so effective and so short. In 6"
    } ]
  }, {
    "tStartMs": 1633340,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "months, this 42"
    } ]
  }, {
    "tStartMs": 1634341,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "country coalition had liberated\nKuwait, kicked Saddam back"
    } ]
  }, {
    "tStartMs": 1637510,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "to Iraq, restored the Middle East\nto its prior"
    } ]
  }, {
    "tStartMs": 1639888,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "state, and maintained the flow of"
    } ]
  }, {
    "tStartMs": 1641264,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "oil, thereby ensuring the"
    } ]
  }, {
    "tStartMs": 1642724,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "stability of the world economy."
    } ]
  }, {
    "tStartMs": 1644601,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "But things took a turn in the early"
    } ]
  }, {
    "tStartMs": 1646061,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "2000s. With 9/11,"
    } ]
  }, {
    "tStartMs": 1647479,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "the focus spiraled from oil\nand economics"
    } ]
  }, {
    "tStartMs": 1649898,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "into terrorism and democracy"
    } ]
  }, {
    "tStartMs": 1651524,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "with the U.S. invasion of Afghanistan."
    } ]
  }, {
    "tStartMs": 1653568,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "While Iraq, Kuwait, and Saudi Arabia are"
    } ]
  }, {
    "tStartMs": 1655862,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "oil states, Afghanistan is landlocked\nand their economy is mostly driven"
    } ]
  }, {
    "tStartMs": 1659407,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "by agriculture and opium."
    } ]
  }, {
    "tStartMs": 1661117,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "After overthrowing the"
    } ]
  }, {
    "tStartMs": 1662160,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Taliban, the U.S. soon discovered that"
    } ]
  }, {
    "tStartMs": 1664162,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "winning and ruling\nare not the same thing."
    } ]
  }, {
    "tStartMs": 1666414,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "The invasion had turned Afghanistan\ninto a zombie"
    } ]
  }, {
    "tStartMs": 1668917,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "state, where the economy was in worse\nshape than before."
    } ]
  }, {
    "tStartMs": 1671419,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "The conflict had devolved\ninto guerrilla warfare"
    } ]
  }, {
    "tStartMs": 1673963,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "and the new government\nhad little influence amongst its people."
    } ]
  }, {
    "tStartMs": 1676800,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "The US committed to help rebuild\nAfghanistan, sending"
    } ]
  }, {
    "tStartMs": 1679761,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "progressively more troops,\nequipment, supplies, and"
    } ]
  }, {
    "tStartMs": 1682222,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "foreign aid over the decades."
    } ]
  }, {
    "tStartMs": 1683890,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "But after years of efforts,"
    } ]
  }, {
    "tStartMs": 1685350,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "Afghanistan was no better off than it was\nbefore, and the country constantly"
    } ]
  }, {
    "tStartMs": 1688895,
    "dDurationMs": 334,
    "segs": [ {
      "utf8": "relied"
    } ]
  }, {
    "tStartMs": 1689229,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "on cash infusions from the U.S., IMF,\nand the World Bank, along"
    } ]
  }, {
    "tStartMs": 1692774,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "with other countries\nto fund its domestic projects."
    } ]
  }, {
    "tStartMs": 1695527,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "There was also growing"
    } ]
  }, {
    "tStartMs": 1696444,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "suspicion from the U.S.\nthat most of the money was disappearing"
    } ]
  }, {
    "tStartMs": 1699489,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "into the pockets of corrupt"
    } ]
  }, {
    "tStartMs": 1700490,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "officials, and even into the pockets\nof Hamid Karzai -"
    } ]
  }, {
    "tStartMs": 1703410,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "the same president that the US had \nhandpicked to lead this"
    } ]
  }, {
    "tStartMs": 1706162,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "new democracy."
    } ]
  }, {
    "tStartMs": 1707163,
    "dDurationMs": 501,
    "segs": [ {
      "utf8": "It became"
    } ]
  }, {
    "tStartMs": 1707664,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "clear that continued handouts\nwere not actually helping Afghanistan."
    } ]
  }, {
    "tStartMs": 1710667,
    "dDurationMs": 459,
    "segs": [ {
      "utf8": "But there was"
    } ]
  }, {
    "tStartMs": 1711126,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "little else the country had to"
    } ]
  }, {
    "tStartMs": 1712293,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "offer beyond poppy and grapes."
    } ]
  }, {
    "tStartMs": 1714295,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "It was in 2007\nwhen the U.S. discovered that"
    } ]
  }, {
    "tStartMs": 1716548,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Afghanistan had potentially a"
    } ]
  }, {
    "tStartMs": 1718091,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "trillion dollars worth of rare mineral\ndeposits."
    } ]
  }, {
    "tStartMs": 1720677,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "These huge deposits of iron, copper, cobalt,"
    } ]
  }, {
    "tStartMs": 1723430,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "gold, and lithium, if"
    } ]
  }, {
    "tStartMs": 1724556,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "extracted and exported,\ncould turn Afghanistan"
    } ]
  }, {
    "tStartMs": 1727016,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "into a mineral powerhouse\nand supercharge their"
    } ]
  }, {
    "tStartMs": 1729185,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "economy into sustainability."
    } ]
  }, {
    "tStartMs": 1730979,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The problem that Afghanistan ran into,\njust like what the U.S."
    } ]
  }, {
    "tStartMs": 1733982,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "and Ukraine are facing today, is who's\nactually going to extract these minerals"
    } ]
  }, {
    "tStartMs": 1737318,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "out of the ground and turn them into real dollars."
    } ]
  }, {
    "tStartMs": 1739779,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "Hamid Karzai traveled around the world,"
    } ]
  }, {
    "tStartMs": 1741614,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "selling this mineral project\nto anyone who would listen."
    } ]
  }, {
    "tStartMs": 1744200,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "He flew as far as Japan, proclaiming\nto the Japanese that Afghanistan"
    } ]
  }, {
    "tStartMs": 1747829,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "was ready to award them priority mining\nrights ahead of the Americans"
    } ]
  }, {
    "tStartMs": 1750999,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "if Mitsubishi would take on this work."
    } ]
  }, {
    "tStartMs": 1752917,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "The Japanese expectedly declined this offer."
    } ]
  }, {
    "tStartMs": 1755545,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "While the U.S. valued Afghanistan's\nmineral deposits at 1 trillion"
    } ]
  }, {
    "tStartMs": 1758798,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "dollars, Karzai continually insisted"
    } ]
  }, {
    "tStartMs": 1760925,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "that the more accurate number was 3"
    } ]
  }, {
    "tStartMs": 1762510,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "trillion,"
    } ]
  }, {
    "tStartMs": 1763052,
    "dDurationMs": 1419,
    "segs": [ {
      "utf8": "no different from the funny math"
    } ]
  }, {
    "tStartMs": 1764471,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "that Ukraine is doing today\nto attract investment."
    } ]
  }, {
    "tStartMs": 1767015,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "But given that the"
    } ]
  }, {
    "tStartMs": 1767724,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "U.S. government was too preoccupied\nwith Iraq"
    } ]
  }, {
    "tStartMs": 1770143,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "and ISIS to care, the Afghans\nhad no mining expertise beyond coal,"
    } ]
  }, {
    "tStartMs": 1774063,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "the country was still reliant\non electricity"
    } ]
  }, {
    "tStartMs": 1776316,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "imports for power,"
    } ]
  }, {
    "tStartMs": 1777484,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "foreigners were regularly\nbeing taken hostage, and"
    } ]
  }, {
    "tStartMs": 1780069,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "Taliban insurgents were attacking"
    } ]
  }, {
    "tStartMs": 1781571,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "civilians and military alike,"
    } ]
  }, {
    "tStartMs": 1783156,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "the opportunity was simply a tough sell."
    } ]
  }, {
    "tStartMs": 1785408,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "At the end, it was only China\nwho was willing to take on this project."
    } ]
  }, {
    "tStartMs": 1788578,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "They committed"
    } ]
  }, {
    "tStartMs": 1789120,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "$3.4 billion."
    } ]
  }, {
    "tStartMs": 1790121,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "in 2008 to develop Afghanistan's largest"
    } ]
  }, {
    "tStartMs": 1793166,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "copper deposit at Mes Anyak."
    } ]
  }, {
    "tStartMs": 1795043,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "There was also interest in the site\nfrom Russia and"
    } ]
  }, {
    "tStartMs": 1797212,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "two mining companies from North America."
    } ]
  }, {
    "tStartMs": 1799047,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "But in the end,"
    } ]
  }, {
    "tStartMs": 1799756,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Karzai"
    } ]
  }, {
    "tStartMs": 1800256,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "went with China, who promised\nthe most money and least contingencies."
    } ]
  }, {
    "tStartMs": 1803760,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "China not only outbid the competition\nby $1 billion,"
    } ]
  }, {
    "tStartMs": 1806846,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "but also committed to building"
    } ]
  }, {
    "tStartMs": 1808097,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "coal generators, railways, and towns"
    } ]
  }, {
    "tStartMs": 1810099,
    "dDurationMs": 1711,
    "segs": [ {
      "utf8": "to power the future copper mine"
    } ]
  }, {
    "tStartMs": 1811810,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "on its own dime,\nwhich the privatized Canadians,"
    } ]
  }, {
    "tStartMs": 1814437,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Americans, and Russians were unable to match."
    } ]
  }, {
    "tStartMs": 1816731,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "But in the 18 years since"
    } ]
  }, {
    "tStartMs": 1818107,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "this deal was signed, not a single bit\nof copper has been mined from Mes Anyak."
    } ]
  }, {
    "tStartMs": 1822028,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "The project has been continued\nand delayed over safety and security."
    } ]
  }, {
    "tStartMs": 1825281,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "The only progress to date\nhas been the paving of a single small"
    } ]
  }, {
    "tStartMs": 1828159,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "access road that"
    } ]
  }, {
    "tStartMs": 1829077,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "leads into the site,\nwhich was only done last year."
    } ]
  }, {
    "tStartMs": 1831871,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The Taliban, who are now back in charge of Afghanistan,"
    } ]
  }, {
    "tStartMs": 1834541,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "are desperate to resume this project\nfor funds under American"
    } ]
  }, {
    "tStartMs": 1837460,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "sanctions and have provided guarantees\nto the Chinese that"
    } ]
  }, {
    "tStartMs": 1840213,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "they will protect their workers\nat the mine."
    } ]
  }, {
    "tStartMs": 1842423,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "Ultimately, the same story has \nplayed out in Iraq."
    } ]
  }, {
    "tStartMs": 1844968,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "It's China, not the U.S., who \nhave capitalized."
    } ]
  }, {
    "tStartMs": 1847470,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "China has continually won bids to develop\nIraq's oil fields and as of today,"
    } ]
  }, {
    "tStartMs": 1851724,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "has 7 times the"
    } ]
  }, {
    "tStartMs": 1852600,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "market share of the U.S.\nfor petroleum projects in the country."
    } ]
  }, {
    "tStartMs": 1855812,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "Despite the best efforts\nof the Iraqi government to appeal to"
    } ]
  }, {
    "tStartMs": 1858731,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "American investors,"
    } ]
  }, {
    "tStartMs": 1859983,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "it's only the Chinese who are willing"
    } ]
  }, {
    "tStartMs": 1861484,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "to overlook all the risks\nand to bring more than cash to the table."
    } ]
  }, {
    "tStartMs": 1864362,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "While American"
    } ]
  }, {
    "tStartMs": 1865029,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "companies sit on the sidelines\nconcerned with safety, corruption,"
    } ]
  }, {
    "tStartMs": 1868116,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "and profit timelines,\njust like Afghanistan"
    } ]
  }, {
    "tStartMs": 1870535,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "before and Ukraine today."
    } ]
  }, {
    "tStartMs": 1871911,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "The U.S. can't"
    } ]
  }, {
    "tStartMs": 1872829,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "force American companies\nto do what it wants."
    } ]
  }, {
    "tStartMs": 1875039,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "At the same time, the value of the Middle\nEast to the U.S. has diminished over time."
    } ]
  }, {
    "tStartMs": 1879085,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "Hydraulic fracturing \nhas not only allowed the"
    } ]
  }, {
    "tStartMs": 1881170,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "U.S. to extract oil"
    } ]
  }, {
    "tStartMs": 1882255,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "at home, but it has also cemented the nation"
    } ]
  }, {
    "tStartMs": 1884340,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "as the world's largest producer of crude"
    } ]
  }, {
    "tStartMs": 1886134,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "oil for the past 6 years."
    } ]
  }, {
    "tStartMs": 1887886,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "With strong domestic"
    } ]
  }, {
    "tStartMs": 1888928,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "oil production,\nthe US has had increasingly less reason"
    } ]
  }, {
    "tStartMs": 1891890,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "to remain"
    } ]
  }, {
    "tStartMs": 1892390,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "involved in the Middle East,\nand this has provided"
    } ]
  }, {
    "tStartMs": 1894559,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "past presidents with the rationale\nfor swift exits from Afghanistan"
    } ]
  }, {
    "tStartMs": 1898354,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "and Iraq."
    } ]
  }, {
    "tStartMs": 1899230,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "All of these past conflicts\nhave shaped the"
    } ]
  }, {
    "tStartMs": 1901274,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "American government's thinking process\nas it relates to present day Ukraine,"
    } ]
  }, {
    "tStartMs": 1904944,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "American lawmakers\nare significantly more sensitive."
    } ]
  }, {
    "tStartMs": 1907488,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "about making sure that they get something\nback for what they're"
    } ]
  }, {
    "tStartMs": 1909824,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "putting in, rather than walking away\nwith total losses like they"
    } ]
  }, {
    "tStartMs": 1912785,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "did with Iraq and Afghanistan."
    } ]
  }, {
    "tStartMs": 1914621,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "The notion of investing in"
    } ]
  }, {
    "tStartMs": 1915872,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "another armed conflict and getting\nnothing in return"
    } ]
  }, {
    "tStartMs": 1918458,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "for what's put in stings,\nespecially when China"
    } ]
  }, {
    "tStartMs": 1920793,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "is always there in the aftermath,"
    } ]
  }, {
    "tStartMs": 1922211,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "signing deals and growing its influence."
    } ]
  }, {
    "tStartMs": 1924380,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "Whether it's fair for"
    } ]
  }, {
    "tStartMs": 1925298,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "private companies to be bidding \nagainst state-owned"
    } ]
  }, {
    "tStartMs": 1927300,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "enterprises and whether or not American"
    } ]
  }, {
    "tStartMs": 1929260,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "hegemony is truly still necessary\nin this modern age"
    } ]
  }, {
    "tStartMs": 1932430,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "are all debates that\nare best left to others."
    } ]
  }, {
    "tStartMs": 1934682,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "Ultimately, history repeats itself.\nAnd the Ukraine"
    } ]
  }, {
    "tStartMs": 1937060,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "U.S. mineral deal is not any different\nfrom the Afghan mineral"
    } ]
  }, {
    "tStartMs": 1939979,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "deal from 18 years ago and the Iraqi oil\nprojects from 12 years ago."
    } ]
  }, {
    "tStartMs": 1943775,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "Unless the U.S. nationalizes mining,\nthe same issue will always remain."
    } ]
  }, {
    "tStartMs": 1947612,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "Deals are meaningless without execution,\nand the real winners will always be"
    } ]
  }, {
    "tStartMs": 1951240,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "the ones who can do the work."
    } ]
  } ]
}
