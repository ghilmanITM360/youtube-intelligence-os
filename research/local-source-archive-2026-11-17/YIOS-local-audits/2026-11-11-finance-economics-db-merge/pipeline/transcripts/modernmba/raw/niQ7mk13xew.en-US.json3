    "segs": [ {
      "utf8": "still making money. These owners are the ones with \nreal business acumen in this industry - resilient,  "
    } ]
  }, {
    "tStartMs": 80160,
    "dDurationMs": 4960,
    "segs": [ {
      "utf8": "savvy, and shrewd - they turn a profit year \nafter year, outlasting the VC back giants,  "
    } ]
  }, {
    "tStartMs": 85120,
    "dDurationMs": 6480,
    "segs": [ {
      "utf8": "regulatory hurdles, commoditization, and the black \nmarket. In this Modern MBA Original, we go from  "
    } ]
