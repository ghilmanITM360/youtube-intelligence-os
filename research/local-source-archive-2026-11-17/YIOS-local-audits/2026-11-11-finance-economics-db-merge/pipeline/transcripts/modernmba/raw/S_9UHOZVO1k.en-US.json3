{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 1668,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "We begin at 6PM with breaking news."
    } ]
  }, {
    "tStartMs": 3378,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "Start with that breaking news this morning."
    } ]
  }, {
    "tStartMs": 4963,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "Let's start this morning with breaking news."
    } ]
  }, {
    "tStartMs": 7132,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "With social media and the Internet,"
    } ]
  }, {
    "tStartMs": 8758,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "it's easier than ever to stay informed\nof what's happening around the world."
    } ]
  }, {
    "tStartMs": 12429,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "But local news is a beast of its own."
    } ]
  }, {
    "tStartMs": 14723,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Only local stations with their daily boots\non the ground coverage"
    } ]
  }, {
    "tStartMs": 17684,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "can provide the facts\non what's happening in your neighborhood"
    } ]
  }, {
    "tStartMs": 20228,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "beyond the national headlines\nand weather forecasts."
    } ]
  }, {
    "tStartMs": 22856,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "That's why millions of people around the world"
    } ]
  }, {
    "tStartMs": 24816,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "still tune in every day\nto the morning news."
    } ]
  }, {
    "tStartMs": 27485,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "The LAPD is looking for a suspect\nwho threw a rock at a restaurant window"
    } ]
  }, {
    "tStartMs": 30905,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "in the San Fernando Valley."
    } ]
  }, {
    "tStartMs": 32824,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "Chaos in a Mission Hills neighborhood\nearly this morning as a truck crashes"
    } ]
  }, {
    "tStartMs": 36745,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "through the wall of a home\nand winds up in the backyard."
    } ]
  }, {
    "tStartMs": 38997,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "Four people are in the hospital this morning"
    } ]
  }, {
    "tStartMs": 41124,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "after being ejected from a vehicle\nduring a pursuit overnight."
    } ]
  }, {
    "tStartMs": 44377,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Firefighters battle an overnight fire in \nBurlington County."
    } ]
  }, {
    "tStartMs": 46796,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Flames broke out just before 2:30 this morning."
    } ]
  }, {
    "tStartMs": 49549,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Yet viewership has declined"
    } ]
  }, {
    "tStartMs": 51092,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "for traditional news media, and in turn,\nso have profits, with local news stations"
    } ]
  }, {
    "tStartMs": 55138,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "having been hit the hardest."
    } ]
  }, {
    "tStartMs": 56389,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Whatever budget left\nis invested in the daytime news cycle."
    } ]
  }, {
    "tStartMs": 59601,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "But newsworthy incidents\nalso happen at night,"
    } ]
  }, {
    "tStartMs": 62062,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "and since the usual anchors, reporters,\nand cameramen all need to sleep"
    } ]
  }, {
    "tStartMs": 65607,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "and the stations have no budget\nfor a nighttime crew,"
    } ]
  }, {
    "tStartMs": 67859,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "Who's covering these breaking stories at night?"
    } ]
  }, {
    "tStartMs": 70111,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "The answer is nightcrawlers."
    } ]
  }, {
    "tStartMs": 72197,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "While news stations\ncapture the stories of the day,"
    } ]
  }, {
    "tStartMs": 74491,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "nightcrawlers hunt for the stories of the night."
    } ]
  }, {
    "tStartMs": 77160,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "You see their footage on broadcast\nand across social media,"
    } ]
  }, {
    "tStartMs": 79788,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "but never their faces, voices\nor names. Beyond a tiny watermark,"
    } ]
  }, {
    "tStartMs": 83374,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "they get no public credit or recognition."
    } ]
  }, {
    "tStartMs": 85418,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "They show up, film, and disappear"
    } ]
  }, {
    "tStartMs": 87545,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and the best nightcrawlers\nmake 6 to 8 figures a year."
    } ]
  }, {
    "tStartMs": 91007,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Every city has its nightcrawlers,\nand Los Angeles"
    } ]
  }, {
    "tStartMs": 93551,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "is the second biggest media market\nin the country."
    } ]
  }, {
    "tStartMs": 96638,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "In this Modern NBA Original,"
    } ]
  }, {
    "tStartMs": 98515,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "we're diving into the secret world\nand writing alongside LA's"
    } ]
  }, {
    "tStartMs": 101684,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "leading nightcrawlers"
    } ]
  }, {
    "tStartMs": 102602,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "to understand firsthand what it takes\nto succeed in this invisible profession."
    } ]
  }, {
    "tStartMs": 111528,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "What does the future hold in business?"
    } ]
  }, {
    "tStartMs": 114823,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Asked nine experts and you'll get ten answers."
    } ]
  }, {
    "tStartMs": 117200,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Analysts will say"
    } ]
  }, {
    "tStartMs": 118034,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "that we're in a bull market this month\nand then a bear market the next."
    } ]
  }, {
    "tStartMs": 121121,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "Could someone please invent a crystal ball?"
    } ]
  }, {
    "tStartMs": 123248,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "Until then, over 40,000 businesses have\nfutureproofed their business with NetSuite"
    } ]
  }, {
    "tStartMs": 127418,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "by Oracle, the number one cloud ERP,\nbringing accounting, finance, inventory,"
    } ]
  }, {
    "tStartMs": 132006,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "and HR into one fluid platform. With one\nunified business management suite,"
    } ]
  }, {
    "tStartMs": 136261,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "there's one source of truth"
    } ]
  }, {
    "tStartMs": 137428,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "giving you the visibility and control\nyou need to make quick decisions."
    } ]
  }, {
    "tStartMs": 140682,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "With real-time insights and forecasting,"
    } ]
  }, {
    "tStartMs": 142600,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "you're peering into the future\nwith actionable data."
    } ]
  }, {
    "tStartMs": 144853,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "When you're closing the books in days,\nnot weeks, you're spending"
    } ]
  }, {
    "tStartMs": 147313,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "less time looking backwards\nand more time on what's next."
    } ]
  }, {
    "tStartMs": 150441,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Modern MBA is small at the moment,\nbut as soon as we scale,"
    } ]
  }, {
    "tStartMs": 153319,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "we will need and use NetSuite."
    } ]
  }, {
    "tStartMs": 154988,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Today we're stitching things together manually"
    } ]
  }, {
    "tStartMs": 156990,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "and it's gotten harder\nto assess our business health"
    } ]
  }, {
    "tStartMs": 159033,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "as we've expanded."
    } ]
  }, {
    "tStartMs": 159993,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "We need to track production costs\nto run payroll compliant with states"
    } ]
  }, {
    "tStartMs": 163246,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "and countries and to evaluate profit\nand loss by team and project."
    } ]
  }, {
    "tStartMs": 166499,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "As a corporation,\nwe pay tax throughout the year"
    } ]
  }, {
    "tStartMs": 168835,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and it's a nightmare jumping from system\nto system just to get one answer."
    } ]
  }, {
    "tStartMs": 172297,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "These are capabilities\nthat only NetSuite provides"
    } ]
  }, {
    "tStartMs": 174549,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "and it's a platform\nthat we intend to take every advantage of."
    } ]
  }, {
    "tStartMs": 177594,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Whether your company is earning millions\nor even hundreds of millions, NetSuite"
    } ]
  }, {
    "tStartMs": 181181,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "helps you respond to immediate challenges\nand seize your biggest opportunities."
    } ]
  }, {
    "tStartMs": 185059,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "Speaking of opportunity, download the CFO‘s"
    } ]
  }, {
    "tStartMs": 187270,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "guide to AI and Machine\nLearning at netsuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 191357,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "The guide is free to you at"
    } ]
  }, {
    "tStartMs": 192609,
    "dDurationMs": 4629,
    "segs": [ {
      "utf8": "NetSuite.com/ModernMBA.  That's \nnetsuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 203620,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "It's 9PM"
    } ]
  }, {
    "tStartMs": 204537,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "on Wednesday in Los Angeles\nand while the rest of the city"
    } ]
  }, {
    "tStartMs": 206998,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "is getting ready to sleep, the team\nat Key News Networks is getting ready"
    } ]
  }, {
    "tStartMs": 210460,
    "dDurationMs": 625,
    "segs": [ {
      "utf8": "to work."
    } ]
  }, {
    "tStartMs": 218301,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "Of the hundreds of 911 calls\nthat are phoned in across LA every night,"
    } ]
  }, {
    "tStartMs": 221846,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "only a few of them are real."
    } ]
  }, {
    "tStartMs": 223556,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Being a nightcrawler is a game of patience\nand skill."
    } ]
  }, {
    "tStartMs": 226309,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Zak and his team\nare not mindlessly cruising around,"
    } ]
  }, {
    "tStartMs": 228853,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "but instead they wait\nunder highway bridges"
    } ]
  }, {
    "tStartMs": 230730,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "to conserve their strength as they work\nuntil 4AM."
    } ]
  }, {
    "tStartMs": 233441,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "All night long,"
    } ]
  }, {
    "tStartMs": 234359,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "they're listening for specific codes\nacross 4 dedicated radios - police,"
    } ]
  }, {
    "tStartMs": 238279,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "fire, medical, and highway patrol\nto catch the latest"
    } ]
  }, {
    "tStartMs": 241282,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "breaking story."
    } ]
  }, {
    "tStartMs": 273898,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "It's feast or famine."
    } ]
  }, {
    "tStartMs": 275400,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "Nightcrawlers live and die by the calls."
    } ]
  }, {
    "tStartMs": 277318,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Some nights are dead and some are nonstop."
    } ]
  }, {
    "tStartMs": 286494,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": " \n97\n00:04:49,497 --\u003e 00:04:53,918"
    } ]
  }, {
    "tStartMs": 474682,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "When you've been in this line of work\nas long as Zak and his team,"
    } ]
  }, {
    "tStartMs": 477226,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "you can assess problems faster\nthan even the first responders."
    } ]
  }, {
    "tStartMs": 480354,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "And when a promising call comes\nin, things go from 0 to 100 in an instant."
    } ]
  }, {
    "tStartMs": 620661,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Hollywood and Netflix in recent years\nhave brought the profession"
    } ]
  }, {
    "tStartMs": 623539,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "into the spotlight, but for entertainment\npurposes, they portray nightcrawlers"
    } ]
  }, {
    "tStartMs": 627335,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "as unskilled, immoral opportunists \nwho prey on tragedy."
    } ]
  }, {
    "tStartMs": 630963,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "They push a stereotype\nthat it's all about doing"
    } ]
  }, {
    "tStartMs": 632840,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "whatever it takes to be first on scene,"
    } ]
  }, {
    "tStartMs": 634675,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "and that the more disturbing and gory\nthe footage, the higher the payout."
    } ]
  }, {
    "tStartMs": 706497,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Two people have been hospitalized after a crash\nin the Angeles National Forest."
    } ]
  }, {
    "tStartMs": 710543,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "One of the victims had to be airlifted\nto a trauma center."
    } ]
  }, {
    "tStartMs": 713504,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "Authorities say a car plunged\n40ft down the side of"
    } ]
  }, {
    "tStartMs": 716632,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "North San Gabriel Canyon Road\njust before midnight last night."
    } ]
  }, {
    "tStartMs": 789580,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "And developing right now in Irwindale, \na bicyclist is dead."
    } ]
  }, {
    "tStartMs": 792625,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "You can see the bike right here"
    } ]
  }, {
    "tStartMs": 794126,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "and a driver is in custody\nafter a late night police pursuit."
    } ]
  }, {
    "tStartMs": 798214,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "While the public are the end"
    } ]
  }, {
    "tStartMs": 799298,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "consumers, it's the news stations\nwho are actually Zak's customers."
    } ]
  }, {
    "tStartMs": 803135,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "They're the ones who pay nightcrawlers\nfor their work and decide what is a story"
    } ]
  }, {
    "tStartMs": 806472,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "and what isn't. It's pay per use."
    } ]
  }, {
    "tStartMs": 808766,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "The media buy these stories from nightcrawlers"
    } ]
  }, {
    "tStartMs": 810976,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "and pay them every time\nthey use their footage in a broadcast."
    } ]
  }, {
    "tStartMs": 813938,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "While the footage is\nthe primary deliverable, nightcrawlers"
    } ]
  }, {
    "tStartMs": 816607,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "are really selling information, Newsrooms\nthese days are shrinking, not growing,"
    } ]
  }, {
    "tStartMs": 820903,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "and there's a greater reliance\non freelancers like these nightcrawlers."
    } ]
  }, {
    "tStartMs": 824156,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "Long Beach police and fire were called here\nafter a woman called 911 to report that a man"
    } ]
  }, {
    "tStartMs": 828828,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "had walked out of a home on the street\nand opened fire in her direction."
    } ]
  }, {
    "tStartMs": 832915,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "There are only 1,500 TV stations\nin the country."
    } ]
  }, {
    "tStartMs": 835751,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "111 of which do regular business\nwith Zak's company [Key News Network]"
    } ]
  }, {
    "tStartMs": 838796,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "and word travels fast in the old school\nindustry of mainstream media."
    } ]
  }, {
    "tStartMs": 917541,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "A man shot and left fighting for his life\nin an attempted carjacking"
    } ]
  }, {
    "tStartMs": 921545,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "has this Highland Park neighborhood\nvery concerned."
    } ]
  }, {
    "tStartMs": 924131,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "The LAPD says a 69 year-old man was shot\nwhen he refused"
    } ]
  }, {
    "tStartMs": 927718,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "to give up his Chevy pickup truck\njust after midnight."
    } ]
  }, {
    "tStartMs": 931931,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "With so much investment in daytime news,\nnew stations don't have the resources"
    } ]
  }, {
    "tStartMs": 935643,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "in-house to chase these stories overnight,\nespecially given that every night is"
    } ]
  }, {
    "tStartMs": 939355,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "a gamble."
    } ]
  }, {
    "tStartMs": 940272,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "It's a specialized trade that requires\nnot just knowledge of law enforcement,"
    } ]
  }, {
    "tStartMs": 943901,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "fire, medical, signal codes,"
    } ]
  }, {
    "tStartMs": 946195,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "dispatch tendencies, but also of the city,\nneighborhood, and cross streets."
    } ]
  }, {
    "tStartMs": 950199,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "You need to know the fastest route"
    } ]
  }, {
    "tStartMs": 951533,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "to get in and out of a scene\nwithout getting trapped,"
    } ]
  }, {
    "tStartMs": 953661,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "how to work it without \ndisrupting first responders,"
    } ]
  }, {
    "tStartMs": 956080,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "and how to get the best shots\nwith what you have."
    } ]
  }, {
    "tStartMs": 958499,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "It's all run-and-gun\nand there's no time for Google Maps."
    } ]
  }, {
    "tStartMs": 961502,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "In short, it's cheaper for new stations\nto outsource and buy stories from"
    } ]
  }, {
    "tStartMs": 965297,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "freelance nightcrawlers every morning,\nall packaged up and ready for broadcast."
    } ]
  }, {
    "tStartMs": 969385,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "But it's not a market\nwhere the lowest bidder wins."
    } ]
  }, {
    "tStartMs": 972012,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "New stations won't risk their production\nstandards and reputation"
    } ]
  }, {
    "tStartMs": 974974,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "just to save a few bucks."
    } ]
  }, {
    "tStartMs": 976392,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "They can't use"
    } ]
  }, {
    "tStartMs": 977184,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "vertical videos filmed on smartphones\nor random submissions from strangers."
    } ]
  }, {
    "tStartMs": 981188,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "Like any B2B relationship, news\ndirectors want long"
    } ]
  }, {
    "tStartMs": 983983,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "term partners, and Zak and his team are not lone wolves."
    } ]
  }, {
    "tStartMs": 987194,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Key News Network is an established company\nthat competes in not just speed,"
    } ]
  }, {
    "tStartMs": 990447,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "but also reliability and accountability."
    } ]
  }, {
    "tStartMs": 993696,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Nightcrawlers are at the whims \nof the news stations."
    } ]
  }, {
    "tStartMs": 995990,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "Routine incidents like DUIs, car crashes,\nand hidden runs are not considered"
    } ]
  }, {
    "tStartMs": 1000161,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "stories unless there's fatalities\nor catastrophic damage."
    } ]
  }, {
    "tStartMs": 1003623,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "The bigger the incident, the stronger\nthe story, and the greater the payout."
    } ]
  }, {
    "tStartMs": 1007126,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "The more stations that pick up the stories,\nthe more customers"
    } ]
  }, {
    "tStartMs": 1009921,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "there are buying the same piece of \nfootage for broadcast,"
    } ]
  }, {
    "tStartMs": 1012298,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "the more money in the bank\nfor Zak and his team."
    } ]
  }, {
    "tStartMs": 1014801,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "But it's all luck of the draw."
    } ]
  }, {
    "tStartMs": 1016219,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "There's no fixed rates."
    } ]
  }, {
    "tStartMs": 1017678,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "A DUI, fire, home invasion, or shooting\nmay be worth something today,"
    } ]
  }, {
    "tStartMs": 1021849,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "more tomorrow, and then nothing the day after."
    } ]
  }, {
    "tStartMs": 1024644,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "The dollar value of a story is dynamic\nand it goes up and down every day"
    } ]
  }, {
    "tStartMs": 1028314,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "all based on the news cycles"
    } ]
  }, {
    "tStartMs": 1029607,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "and the newsroom priorities\nat the local, regional, and national level."
    } ]
  }, {
    "tStartMs": 1033403,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "That terrifying standoff\nin the heart of downtown LA is now over."
    } ]
  }, {
    "tStartMs": 1037657,
    "dDurationMs": 5756,
    "segs": [ {
      "utf8": "The LAPD is saying one passenger was reportedly\nshot multiple times, died at an area hospital."
    } ]
  }, {
    "tStartMs": 1043621,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "The suspected hijacker has been arrested,"
    } ]
  }, {
    "tStartMs": 1046165,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and the driver and another passenger \nhave been rescued."
    } ]
  }, {
    "tStartMs": 1049085,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "You can see them being pulled out of that\nbus here in the middle of the night."
    } ]
  }, {
    "tStartMs": 1159862,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "It was a party just outside Dodger \nStadium last night."
    } ]
  }, {
    "tStartMs": 1162990,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "After that last out, fans cheering, waving\nflags, blocking the streets, and lighting"
    } ]
  }, {
    "tStartMs": 1167411,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "fireworks, celebrating\nafter the boys in blue captured"
    } ]
  }, {
    "tStartMs": 1170456,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "their 8th World Series\ntitle in franchise history."
    } ]
  }, {
    "tStartMs": 1174085,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Several cars were seen doing donuts\nnear the intersection of Sunset Boulevard"
    } ]
  }, {
    "tStartMs": 1177922,
    "dDurationMs": 5672,
    "segs": [ {
      "utf8": "and Vin Scully Avenue, kicking up\nheavy smoke as crowds of onlookers cheered."
    } ]
  }, {
    "tStartMs": 1183594,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "The LAPD ruling the gathering unlawful\nand ordering the crowd to disperse"
    } ]
  }, {
    "tStartMs": 1188349,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "just before 10 PM."
    } ]
  }, {
    "tStartMs": 1190935,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Even though it's all luck of the draw,"
    } ]
  }, {
    "tStartMs": 1192395,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "there are some factors"
    } ]
  }, {
    "tStartMs": 1193312,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "that Zak and his team can control\nto make their stories more enticing."
    } ]
  }, {
    "tStartMs": 1197108,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "If they get footage of an incident\nand sound, meaning an interview"
    } ]
  }, {
    "tStartMs": 1200194,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "with an eyewitness or family,\nthat can bring up the value of the story."
    } ]
  }, {
    "tStartMs": 1203614,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "If they get an exclusive, meaning that"
    } ]
  }, {
    "tStartMs": 1205199,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "no one else has footage of this incident\nthen that gives them pricing power."
    } ]
  }, {
    "tStartMs": 1208661,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "This is where speed and scale matters,\nand Key News Network isn't the only game"
    } ]
  }, {
    "tStartMs": 1212373,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "in town."
    } ]
  }, {
    "tStartMs": 1213249,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "There's competition everywhere, from \nsocial media amateurs"
    } ]
  }, {
    "tStartMs": 1216002,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "to other nightcrawler companies."
    } ]
  }, {
    "tStartMs": 1217670,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "99% of the value lies in the visuals,\nand Zak has pushed KNN"
    } ]
  }, {
    "tStartMs": 1221882,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "to compete on framing, clarity, \ncinematography and composition."
    } ]
  }, {
    "tStartMs": 1226053,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Every nightcrawler on his team\nuses custom shoulder-mounted rigs"
    } ]
  }, {
    "tStartMs": 1229473,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "that can grab shots in low-light\nand at a distance"
    } ]
  }, {
    "tStartMs": 1231809,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "that would be impossible to pull off\nwith handheld Sonys and smartphones."
    } ]
  }, {
    "tStartMs": 1235479,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "By Zak's own estimation,\n85% of the job is just sitting,"
    } ]
  }, {
    "tStartMs": 1239525,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "waiting, and listening."
    } ]
  }, {
    "tStartMs": 1240610,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "10% is chasing calls that go nowhere and just 5%"
    } ]
  }, {
    "tStartMs": 1243821,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "is actually filming, editing,\nand packaging something deliverable."
    } ]
  }, {
    "tStartMs": 1247241,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "When the big calls do come\nin, all of these elements come to life."
    } ]
  }, {
    "tStartMs": 1534236,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Because Gabe and Zak\nhad coordinated before arrival,"
    } ]
  }, {
    "tStartMs": 1536655,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "they're able to film the same crime scene\nfrom two angles and it turns out"
    } ]
  }, {
    "tStartMs": 1539867,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "all the action is happening\non Gabe's side of the hill. "
    } ]
  }, {
    "tStartMs": 1582701,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "First we do have other breaking news."
    } ]
  }, {
    "tStartMs": 1584495,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Two men found shot to death overnight."
    } ]
  }, {
    "tStartMs": 1587289,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "The LAPD says their bodies were found\nin the 1400 block of Cliff"
    } ]
  }, {
    "tStartMs": 1590918,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Drive in Mount Washington."
    } ]
  }, {
    "tStartMs": 1592878,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Police gave no information on arrests."
    } ]
  }, {
    "tStartMs": 1596215,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "As the police extend the perimeter of the crime scene,\nGabe's car actually gets trapped inside"
    } ]
  }, {
    "tStartMs": 1600469,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "and now it's up to Zak alone\nto chase the next story."
    } ]
  }, {
    "tStartMs": 1813557,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "By Zak's measures, tonight was a solid six out of ten."
    } ]
  }, {
    "tStartMs": 1816768,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "There were only three stories:\nthe big residential fire, the hit-and-run,"
    } ]
  }, {
    "tStartMs": 1820355,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "and the shootings at the overlook.\nIn his 17 years behind the wheel,"
    } ]
  }, {
    "tStartMs": 1824026,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "the average story gets between 2 to 20 hits."
    } ]
  }, {
    "tStartMs": 1827029,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "Every station that picks up\nthe story needs footage,"
    } ]
  }, {
    "tStartMs": 1829281,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "and every use of the footage \ncounts as one hit."
    } ]
  }, {
    "tStartMs": 1831408,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "So naturally, the bigger the story,\nthe more hits, the greater the payout."
    } ]
  }, {
    "tStartMs": 1834912,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "A \"hit\" can range between $100 to $1000,"
    } ]
  }, {
    "tStartMs": 1838832,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "depending on the nature of the incident,\nthe scope of damage, the exclusivity,"
    } ]
  }, {
    "tStartMs": 1842586,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "the newsroom demand,\nand the news cycle."
    } ]
  }, {
    "tStartMs": 1844880,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Of the 3 stories\ntonight, 2 were flops."
    } ]
  }, {
    "tStartMs": 1847174,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "The fire had zero hits. Because it was\na vacant home and there was no one inside,"
    } ]
  }, {
    "tStartMs": 1851428,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "it wasn't considered worthy for broadcast."
    } ]
  }, {
    "tStartMs": 1853972,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "The same was true of the hit-and-run."
    } ]
  }, {
    "tStartMs": 1855515,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "Some publication"
    } ]
  }, {
    "tStartMs": 1856433,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "may buy these pieces in the future\nas part of a broad investigative piece,"
    } ]
  }, {
    "tStartMs": 1859895,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "but there's not much in archival footage.\nTo date, both incidents have earned $0."
    } ]
  }, {
    "tStartMs": 1865192,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "The shootings at the overlook\nturn out to be even more brutal."
    } ]
  }, {
    "tStartMs": 1867903,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Yet that story has only had 3 hits to date."
    } ]
  }, {
    "tStartMs": 1870364,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "The incident had occurred the day\nright after the presidential elections,"
    } ]
  }, {
    "tStartMs": 1873700,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "and the newsrooms were too preoccupied\nto pay attention to anything else."
    } ]
  }, {
    "tStartMs": 1877663,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "If the shootings had somehow taken place before"
    } ]
  }, {
    "tStartMs": 1879706,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Election Day, Zak's hunch is that\nthe story would not have gotten buried."
    } ]
  }, {
    "tStartMs": 1883627,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "There is a tiny chance for some stories\nto reach five figures per hit."
    } ]
  }, {
    "tStartMs": 1887589,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Zach calls these once-in-a-lifetime\nstories mega-hits where the incidents"
    } ]
  }, {
    "tStartMs": 1890842,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "come out of nowhere but are so crazy\nthey go international overnight."
    } ]
  }, {
    "tStartMs": 1894304,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "There was a serial arsonist in LA,\nHarry Burkhart, back in 2011."
    } ]
  }, {
    "tStartMs": 1898183,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Then there was Christopher Dorner in 2013\nwho went around shooting police."
    } ]
  }, {
    "tStartMs": 1902020,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "Then there was the Da Vinci fire in 2014"
    } ]
  }, {
    "tStartMs": 1904398,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "that was so intense that it melted freeway"
    } ]
  }, {
    "tStartMs": 1906275,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "signs, shattered windows, and caused over\n$100 million worth of damages."
    } ]
  }, {
    "tStartMs": 1910487,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "And the latest one was in 2023,\nwhen he and his team"
    } ]
  }, {
    "tStartMs": 1913782,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "got an exclusive of a cop killer\nwho was taken into custody"
    } ]
  }, {
    "tStartMs": 1916743,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "after a high-profile overnight\nmanhunt. In Zak's 17 year career,"
    } ]
  }, {
    "tStartMs": 1920872,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "he's only had these 5 mega-hits."
    } ]
  }, {
    "tStartMs": 1922541,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Despite pushing the boundary in hardware, software,"
    } ]
  }, {
    "tStartMs": 1925043,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and operations, Zak's still can't change\nthe reality of his profession."
    } ]
  }, {
    "tStartMs": 1928880,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Being a nightcrawler is boom or bust."
    } ]
  }, {
    "tStartMs": 1930882,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "In this line of work,\nthere are no minimums and no averages."
    } ]
  }, {
    "tStartMs": 1934094,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "You don't get anything for showing up and\nyou only get paid when something sells"
    } ]
  }, {
    "tStartMs": 1937514,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "in a fickle world that demands\nnot only the latest,"
    } ]
  }, {
    "tStartMs": 1939808,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "but is also changing its own interests,\nvaluations, and priorities"
    } ]
  }, {
    "tStartMs": 1942978,
    "dDurationMs": 5422,
    "segs": [ {
      "utf8": "for Stories Daily. Zak's guys make\nanywhere from $0 to $15,000 every month,"
    } ]
  }, {
    "tStartMs": 1948734,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "and even the most successful ones\nknow that it's all luck of the draw,"
    } ]
  }, {
    "tStartMs": 1951486,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and the coin generally\nwon't be landing on their side."
    } ]
  }, {
    "tStartMs": 1954156,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "Being a nightcrawler\nis about being the right person"
    } ]
  }, {
    "tStartMs": 1956491,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "in the right place at the right time,\nand it takes patience, expertise, and grit"
    } ]
  }, {
    "tStartMs": 1960203,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "to live at night, to keep faith, \nto keep chasing leads,"
    } ]
  }, {
    "tStartMs": 1963040,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and to not flinch from the chance\nto shoot lightning in a bottle."
    } ]
  }, {
    "tStartMs": 1966168,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "While the rest of the world is sleeping \nfrom 9PM"
    } ]
  }, {
    "tStartMs": 1968420,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "to 4AM"
    } ]
  }, {
    "tStartMs": 1969212,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "Monday to Sunday, Zak, Gabe,\nand the rest of the team at KNN"
    } ]
  }, {
    "tStartMs": 1972591,
    "dDurationMs": 3295,
    "segs": [ {
