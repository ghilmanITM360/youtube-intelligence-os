{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 41,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "It was in the late 2010s\nwhen plant-based foods went mainstream."
    } ]
  }, {
    "tStartMs": 3294,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The hype was concentrated\nin a few startups that had miraculously"
    } ]
  }, {
    "tStartMs": 6297,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "bridged the gap between real and fake.\nImpossible Foods and Beyond Meat"
    } ]
  }, {
    "tStartMs": 9843,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "captivated consumers"
    } ]
  }, {
    "tStartMs": 11094,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "with meatless products that now looked\nand tasted like actual animal proteins,"
    } ]
  }, {
    "tStartMs": 14806,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "and Oatly led the way with creaminess\nthat was comparable to cow milk."
    } ]
  }, {
    "tStartMs": 18268,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "They represented a paradigm shift\nin the world of consumer packaged goods."
    } ]
  }, {
    "tStartMs": 21813,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Vegan products historically were made\nby and sold to vegans who had already made"
    } ]
  }, {
    "tStartMs": 25483,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "the lifestyle switch, but vegans account\nfor less than 1% of the global population,"
    } ]
  }, {
    "tStartMs": 29654,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "and few companies were willing\nto stake millions of dollars in R\u0026D"
    } ]
  }, {
    "tStartMs": 32866,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "for such a tiny market."
    } ]
  }, {
    "tStartMs": 34117,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "But these new innovations\nwere designed to be mainstream, not niche."
    } ]
  }, {
    "tStartMs": 37454,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "They were, for omnivores first and vegan\nsecond rather than vice versa."
    } ]
  }, {
    "tStartMs": 41166,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "With seemingly minimal differences\nin taste, texture or appearance,"
    } ]
  }, {
    "tStartMs": 44544,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "customers could easily substitute\ntheir beloved meat and dairy"
    } ]
  }, {
    "tStartMs": 47380,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "for these modern plant-based substitutes.\nWhether it was out of curiosity"
    } ]
  }, {
    "tStartMs": 51009,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "or novelty,"
    } ]
  }, {
    "tStartMs": 51676,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "these startups exploded in virality,\nand when customers demonstrated"
    } ]
  }, {
    "tStartMs": 55096,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "their willingness"
    } ]
  }, {
    "tStartMs": 55680,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "to pay a premium for these supposedly\nhealthier, sustainable, plant"
    } ]
  }, {
    "tStartMs": 59142,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "based substitutes, the market\njumped headfirst onto the bandwagon."
    } ]
  }, {
    "tStartMs": 62437,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Restaurant chains joined the hype,\naggressively rolling out plant-based menu"
    } ]
  }, {
    "tStartMs": 66107,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "items and dairy-free drinks."
    } ]
  }, {
    "tStartMs": 67650,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "Retailers couldn't stock their shelves fast enough,"
    } ]
  }, {
    "tStartMs": 69778,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "as Oatly, Beyond Meat, and Impossible Foods\nall ran into shortages."
    } ]
  }, {
    "tStartMs": 73531,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "CPG giants like Unilever and Coca-Cola\nfast followed with plant-based"
    } ]
  }, {
    "tStartMs": 77202,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "snacks and drinks of their own,"
    } ]
  }, {
    "tStartMs": 78787,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "eager not to miss out on this next gold rush."
    } ]
  }, {
    "tStartMs": 81039,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "It didn't seem crazy to imagine a world\nwhere these vegan startups would one day"
    } ]
  }, {
    "tStartMs": 84417,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "become as big"
    } ]
  }, {
    "tStartMs": 85043,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "as the massive billion-dollar\nmeat and dairy giants like Tyson, Nestle,"
    } ]
  }, {
    "tStartMs": 88630,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "and Danone."
    } ]
  }, {
    "tStartMs": 89172,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Disruption seemed certain, one burger\npatty and one glass of milk at a time."
    } ]
  }, {
    "tStartMs": 92842,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "Beyond Meat"
    } ]
  }, {
    "tStartMs": 93468,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "and Oatly quickly IPO'd to channel the hype\ninto billions of dollars to its fans."
    } ]
  }, {
    "tStartMs": 97680,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "Oatly was the poster child\nof sustainability and ethical consumption."
    } ]
  }, {
    "tStartMs": 101142,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "On paper, it was also a stronger business\ngiven that milk is an easier,"
    } ]
  }, {
    "tStartMs": 104813,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "stickier, and more accessible product\ncompared to ground meat."
    } ]
  }, {
    "tStartMs": 107816,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "Oatly tasted good, was good for the body,\ngood for the environment,"
    } ]
  }, {
    "tStartMs": 110902,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "and now would be good for shareholders."
    } ]
  }, {
    "tStartMs": 112779,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Yet this plant-based revolution lasted\njust five years."
    } ]
  }, {
    "tStartMs": 115865,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "The once high-flying Beyond Meat\nand Oatly have crashed"
    } ]
  }, {
    "tStartMs": 118451,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and are just penny stocks these days."
    } ]
  }, {
    "tStartMs": 120161,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Both brands have shown zero\nsigns of turning things around."
    } ]
  }, {
    "tStartMs": 122831,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "They lose millions of dollars\nevery year as their products"
    } ]
  }, {
    "tStartMs": 125416,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "seem to have lost their luster\nwith retailers and consumers alike."
    } ]
  }, {
    "tStartMs": 128711,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "The numbers seem conclusive."
    } ]
  }, {
    "tStartMs": 130296,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "Veganism doesn't work."
    } ]
  }, {
    "tStartMs": 131714,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "If these brands, with their virality,\ncan't survive or be sustainable"
    } ]
  }, {
    "tStartMs": 135176,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "independent businesses, then"
    } ]
  }, {
    "tStartMs": 136427,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "how can anyone else ever make it work?"
    } ]
  }, {
    "tStartMs": 138429,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Vegans and environmentalists, in response,\nall claim that this game is rigged."
    } ]
  }, {
    "tStartMs": 142016,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Meat and dairy are subsidized,\nbut their plant-based substitutes are not."
    } ]
  }, {
    "tStartMs": 145395,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "If these vegan startups were given\nthe same massive subsidies"
    } ]
  }, {
    "tStartMs": 148273,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "that governments give to the meat and\ndairy industry, then profits would flow."
    } ]
  }, {
    "tStartMs": 151776,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "But instead, these vegan \nstartups are unfairly crushed"
    } ]
  }, {
    "tStartMs": 154362,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "under the weight of not just generating\nsupply and demand for these new products,"
    } ]
  }, {
    "tStartMs": 157699,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "but also shouldering the impossible task"
    } ]
  }, {
    "tStartMs": 159659,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "of matching the artificially affordable\nprices of meat and dairy today."
    } ]
  }, {
    "tStartMs": 162996,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "All of this trickles"
    } ]
  }, {
    "tStartMs": 163872,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "down into the vegan tax,\nwhere customers consistently pay more,"
    } ]
  }, {
    "tStartMs": 166875,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "whether it's oat milk over cow\nmilk or Impossible Meat over regular beef/"
    } ]
  }, {
    "tStartMs": 170920,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Thus, the whole argument\nis that until governments provide the same"
    } ]
  }, {
    "tStartMs": 173923,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "benefits to vegan companies, plant-based \nproducts will forever"
    } ]
  }, {
    "tStartMs": 176926,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "be too expensive for regular consumption\nand companies like Oatly and Beyond Meat"
    } ]
  }, {
    "tStartMs": 180972,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "will always fail."
    } ]
  }, {
    "tStartMs": 181931,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "In this episode,\nwe're assessing to see if this is true."
    } ]
  }, {
    "tStartMs": 184350,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "We'll look at Oatly and the broader"
    } ]
  }, {
    "tStartMs": 185768,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "dairy industry to see if Oatly struggles\nare due to mismanagement,"
    } ]
  }, {
    "tStartMs": 188855,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "if the cards are actually as stacked\nagainst vegan companies as they say"
    } ]
  }, {
    "tStartMs": 192150,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "they are, and what a plant based future\nwould really look like if vegan products"
    } ]
  }, {
    "tStartMs": 195612,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "were treated like the essential commodity\nthat meat and dairy are today."
    } ]
  }, {
    "tStartMs": 199490,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "The dairy industry is highly mature,\nwith an annual growth"
    } ]
  }, {
    "tStartMs": 202327,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "rate forecasted at just 1% over\nthe next ten years."
    } ]
  }, {
    "tStartMs": 205747,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Milk is an essential commodity,\nbut for most households,"
    } ]
  }, {
    "tStartMs": 208416,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "having some milk in the fridge is enough."
    } ]
  }, {
    "tStartMs": 210210,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The brand doesn't matter as much."
    } ]
  }, {
    "tStartMs": 211920,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "This maturity means that, like\nhow people are indifferent about milk,"
    } ]
  }, {
    "tStartMs": 214923,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "they also have the same attitudes\nabout the razors"
    } ]
  }, {
    "tStartMs": 217091,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "they use. Under the traditional razor\nrazor blade business model,"
    } ]
  }, {
    "tStartMs": 220303,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "companies make money by selling\ncheap handles but expensive blades."
    } ]
  }, {
    "tStartMs": 223640,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "All the profits come from getting people\nto keep buying blade refills,"
    } ]
  }, {
    "tStartMs": 226643,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "and consumers have become indifferent\nto it over generations."
    } ]
  }, {
    "tStartMs": 229687,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "Two out of three men still expect\nirritation when they shave, and that's why"
    } ]
  }, {
    "tStartMs": 233233,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "80% of men still use dull razors.\nBecause we'd rather not pay for blades,"
    } ]
  }, {
    "tStartMs": 237654,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "we knowingly shave with dull blades\nand end up with irritation."
    } ]
  }, {
    "tStartMs": 240823,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "See the cycle here?"
    } ]
  }, {
    "tStartMs": 241950,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "What if there is a company\nthat did the opposite,"
    } ]
  }, {
    "tStartMs": 243993,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "one that doesn't rip off consumers"
    } ]
  }, {
    "tStartMs": 245578,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "with overpriced blades\nand annoying subscriptions?"
    } ]
  }, {
    "tStartMs": 247956,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "Enter Henson Shaving,"
    } ]
  }, {
    "tStartMs": 249165,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "today's sponsor. The Henson Razor, is made\nentirely of aluminum,"
    } ]
  }, {
    "tStartMs": 252543,
    "dDurationMs": 3713,
    "segs": [ {
      "utf8": "has zero plastic even in packaging,\nand is made in Canada, not China."
    } ]
  }, {
    "tStartMs": 256297,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Every razor is manufactured\nin the same aerospace factory"
    } ]
  }, {
    "tStartMs": 259467,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "that produced parts for the International\nSpace Station and Mars Rover."
    } ]
  }, {
    "tStartMs": 262720,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "The Henson Razor is engineered\nwith a unique 30 degree design."
    } ]
  }, {
    "tStartMs": 266015,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "The blade extends only 0.0013 inches past\nthe shave plane,"
    } ]
  }, {
    "tStartMs": 270061,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "less than the thickness of human hair,\nwhich means zero to little skin"
    } ]
  }, {
    "tStartMs": 273106,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "irritation, and uses industry-standard\ndouble edged blades"
    } ]
  }, {
    "tStartMs": 276109,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "that cost just $0.10 each, leading\nto dramatically lower cost of ownership."
    } ]
  }, {
    "tStartMs": 280029,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "When you go to Henson Shaving dot com\nslash mba and check out using code"
    } ]
  }, {
    "tStartMs": 284158,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "MBA, you'll get 100 free blades\nwith the purchase of a Henson razor."
    } ]
  }, {
    "tStartMs": 287954,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "That's www.hensonshaving.com/MBA\nfor 100 free blades"
    } ]
  }, {
    "tStartMs": 291874,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "with your purchase of a Henson razor."
    } ]
  }, {
    "tStartMs": 294210,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "Oatly IPO'd in 2021 with creative accounting\nand a brash narrative."
    } ]
  }, {
    "tStartMs": 298214,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "But even though demand exceeded supply\nin the following years, the company's"
    } ]
  }, {
    "tStartMs": 301342,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "operating losses have only deepened,\nand these red flags have become fuel"
    } ]
  }, {
    "tStartMs": 304721,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "for its critics."
    } ]
  }, {
    "tStartMs": 305638,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Oatly's pitch is in its brand and tenure."
    } ]
  }, {
    "tStartMs": 307932,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "They're the world's"
    } ]
  }, {
    "tStartMs": 308599,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "first and largest oat milk producer\nand have specialized in it for 25 years,"
    } ]
  }, {
    "tStartMs": 312603,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "long before the hype of the 2010s,\nwhich on paper gave them a leg"
    } ]
  }, {
    "tStartMs": 315982,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "up over the competition. People\ndidn't want any regular oat milk."
    } ]
  }, {
    "tStartMs": 319193,
    "dDurationMs": 835,
    "segs": [ {
      "utf8": "They wanted Oatly."
    } ]
  }, {
    "tStartMs": 320028,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Whether it was the quirky marketing"
    } ]
  }, {
    "tStartMs": 321571,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "or hipster frenzy, that brand excitement\nhad translated into real dollars."
    } ]
  }, {
    "tStartMs": 325325,
    "dDurationMs": 3878,
    "segs": [ {
      "utf8": "Revenue tripled in 3 years and demand\noutpaced supply as both Starbucks"
    } ]
  }, {
    "tStartMs": 329203,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and retailers ran into shortages\nwell into 2021."
    } ]
  }, {
    "tStartMs": 332290,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Contrary to traditional dairy,\nthe majority of sales for Oatly"
    } ]
  }, {
    "tStartMs": 335376,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "came from customers buying a single box\nat a time off shelves, rather than through"
    } ]
  }, {
    "tStartMs": 339005,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "a splash at a time at coffee shops\nor other foodservice establishments."
    } ]
  }, {
    "tStartMs": 342592,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "Since people were asking \nfor Oatly by name,"
    } ]
  }, {
    "tStartMs": 344844,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "it was a no-brainer to extend \ntheir brand into new product"
    } ]
  }, {
    "tStartMs": 347430,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "lines like yogurt, ice cream,\nwhipped cream, and grab and go drinks."
    } ]
  }, {
    "tStartMs": 351184,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "But despite"
    } ]
  }, {
    "tStartMs": 351768,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "selling out of every drop of oat milk,\nthe company was still unprofitable."
    } ]
  }, {
    "tStartMs": 355063,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "Creaminess and foaminess"
    } ]
  }, {
    "tStartMs": 356481,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "was Oatly's claim to fame,\nand they were dead set on"
    } ]
  }, {
    "tStartMs": 358691,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "keeping their manufacturing secrets\nclose to the chest."
    } ]
  }, {
    "tStartMs": 361194,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "In their early years,\nthey had relied on third party co-packers"
    } ]
  }, {
    "tStartMs": 364238,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "out of necessity to create their finished\noatmilk - a common, cost"
    } ]
  }, {
    "tStartMs": 367408,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "efficient practice\nin any manufacturer-intensive industry."
    } ]
  }, {
    "tStartMs": 370495,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "But Oatly wanted to internalize\nas much of their supply chain as possible"
    } ]
  }, {
    "tStartMs": 373790,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "so they could fully capture the profits"
    } ]
  }, {
    "tStartMs": 375333,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "for themselves over time\nand to protect their trade secrets."
    } ]
  }, {
    "tStartMs": 378044,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Relying on third party co-packers\nwould always mean giving up margins,"
    } ]
  }, {
    "tStartMs": 381214,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "and Oatly didn't want to be seen as just\nanother commoditized dairy business."
    } ]
  }, {
    "tStartMs": 385134,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "Oatly committed half a billion dollars\na year to building and scaling"
    } ]
  }, {
    "tStartMs": 388262,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "their own factories around the world"
    } ]
  }, {
    "tStartMs": 389847,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "to ramp up production capacity\nfor the next decade."
    } ]
  }, {
    "tStartMs": 392475,
    "dDurationMs": 4546,
    "segs": [ {
      "utf8": "The company broke ground in Texas,\nthe U.K., Sweden, China and Singapore"
    } ]
  }, {
    "tStartMs": 397021,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "under the conviction that the growth rates\nwould hold at 20 to 30% every year."
    } ]
  }, {
    "tStartMs": 401025,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Having self-owned production hubs\nin every major continent"
    } ]
  }, {
    "tStartMs": 403986,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "would mean not only greater production,\nbut also faster distribution"
    } ]
  }, {
    "tStartMs": 407115,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "into the heart of Big Dairy's\nbiggest markets."
    } ]
  }, {
    "tStartMs": 409409,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "This would permanently also address"
    } ]
  }, {
    "tStartMs": 410952,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "the company's long-running issues around\nsupply, contamination and congestion."
    } ]
  }, {
    "tStartMs": 414997,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "After all, the demand was clearly there,\nall Oatly needed to do was to meet it."
    } ]
  }, {
    "tStartMs": 419043,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "But whether it comes from cows or oats,\nthere are economic realities"
    } ]
  }, {
    "tStartMs": 422422,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "to milk as a business that not"
    } ]
  }, {
    "tStartMs": 423840,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "even marketing can fix milk. Whether it \ncomes from soy, oats or cow,"
    } ]
  }, {
    "tStartMs": 427760,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "milk is highly perishable\nand requires refrigeration."
    } ]
  }, {
    "tStartMs": 430388,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "With short expiration dates\nand refrigeration requirements,"
    } ]
  }, {
    "tStartMs": 433307,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "what's produced must be sold quickly,"
    } ]
  }, {
    "tStartMs": 435059,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "whereas other beverages like alcohol,\nsoda, energy drinks and flavored fizzy"
    } ]
  }, {
    "tStartMs": 439272,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "water are shelf stable non-essentials\nwith significantly longer shelf life."
    } ]
  }, {
    "tStartMs": 443234,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "When we segment the beverage industry\ninto two separate rosters"
    } ]
  }, {
    "tStartMs": 446154,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "of milk versus non milk, we can see\nthese differences in fundamentals."
    } ]
  }, {
    "tStartMs": 449615,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "Dairy companies, on average,\nsuffer from dramatically lower gross"
    } ]
  }, {
    "tStartMs": 452743,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "and operating margins\nthan non-dairy companies -"
    } ]
  }, {
    "tStartMs": 454996,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "and this is factoring\nin all the dairy companies"
    } ]
  }, {
    "tStartMs": 456956,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "around the world"
    } ]
  }, {
    "tStartMs": 457582,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "from the U.S. and New Zealand,\nall the way to Saudi Arabia and China."
    } ]
  }, {
    "tStartMs": 461335,
    "dDurationMs": 3838,
    "segs": [ {
      "utf8": "Oatly makes its oat milk from oats,\nvegetable oil, water and enzymes."
    } ]
  }, {
    "tStartMs": 465173,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "But despite dealing in"
    } ]
  }, {
    "tStartMs": 466090,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "significantly simpler raw materials\nand not having to raise cows,"
    } ]
  }, {
    "tStartMs": 469469,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "their gross margins\nwere surprisingly lower"
    } ]
  }, {
    "tStartMs": 471637,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "than even the dairy companies\nthat it was looking to disrupt."
    } ]
  }, {
    "tStartMs": 474390,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "In an attempt to disguise itself\nlike a radically different business,"
    } ]
  }, {
    "tStartMs": 477393,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "Oatly cooked its books."
    } ]
  }, {
    "tStartMs": 478686,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "Costs of sales, by convention,"
    } ]
  }, {
    "tStartMs": 480188,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "should factor in every dollar that it took\nto not only produce the product, but also"
    } ]
  }, {
    "tStartMs": 483357,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "to deliver that item to its final place,\nwhere it's actually sold to a customer."
    } ]
  }, {
    "tStartMs": 487153,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "In the beverage industry,\nthe cost of distribution is factored"
    } ]
  }, {
    "tStartMs": 490072,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "into cost of sales."
    } ]
  }, {
    "tStartMs": 491240,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "Oatly broke from this\nwell-established convention by excluding"
    } ]
  }, {
    "tStartMs": 494202,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "the cost of distribution, which in turn\nnaturally inflated their gross margins."
    } ]
  }, {
    "tStartMs": 497997,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "Despite this artificial inflation, Oatly's\ngross margins are still lower than that"
    } ]
  }, {
    "tStartMs": 501792,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "of traditional dairy companies."
    } ]
  }, {
    "tStartMs": 503252,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "And when we manually add back\nin the cost of distribution ourselves,"
    } ]
  }, {
    "tStartMs": 506380,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "the real gross margins are depressing."
    } ]
  }, {
    "tStartMs": 508257,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "It wasn't just the attempt to run\ntwo major hubs on every continent"
    } ]
  }, {
    "tStartMs": 511302,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "that was killing their margins, but\nalso the high marketing and sales spend."
    } ]
  }, {
    "tStartMs": 514514,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Oatly had first-mover advantage\nthrough the 2010s, but as the plant"
    } ]
  }, {
    "tStartMs": 517767,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "based hype progressed\ninto the 2020s, competition increased."
    } ]
  }, {
    "tStartMs": 520895,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "PepsiCo, Coca-Cola and Nestlé\nall released oat milks of their own,"
    } ]
  }, {
    "tStartMs": 524607,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "eager to capture some share in this fast\ngrowing market."
    } ]
  }, {
    "tStartMs": 527485,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "When Oatly was the only game in town,"
    } ]
  }, {
    "tStartMs": 529111,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "they had to market to generate interest\nin oat milk as a product."
    } ]
  }, {
    "tStartMs": 532156,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "But now consumers"
    } ]
  }, {
    "tStartMs": 533032,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "no longer need to be educated on\nwhy drink oat milk, but instead, why"
    } ]
  }, {
    "tStartMs": 536452,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "drink Oatly specifically, as they remain\nthe most expensive brand on the market."
    } ]
  }, {
    "tStartMs": 540456,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "They had to continue their aggressive\nmarketing"
    } ]
  }, {
    "tStartMs": 542416,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "to maintain appeal and to justify\npricing as the premium choice in a now"
    } ]
  }, {
    "tStartMs": 546212,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "fully commoditized category - "
    } ]
  }, {
    "tStartMs": 547755,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "and this would theoretically,"
    } ]
  }, {
    "tStartMs": 548756,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "also help keep sales up as they waited\nfor their new factories to get online."
    } ]
  }, {
    "tStartMs": 552510,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "As a result, Oatly's spend on sales\nand marketing leads the industry and"
    } ]
  }, {
    "tStartMs": 556264,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "outpaces the spend of traditional dairy\nand even the alcohol and soda giants."
    } ]
  }, {
    "tStartMs": 560560,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "By 2023, oat milk was everywhere and "
    } ]
  }, {
    "tStartMs": 563104,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Oatly's over-expansion\nproved to be disastrous."
    } ]
  }, {
    "tStartMs": 565690,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "It wasn't that Oatly was a fad,"
    } ]
  }, {
    "tStartMs": 567233,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "or that people suddenly stopped\ndrinking oat milk overnight."
    } ]
  }, {
    "tStartMs": 569694,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "Whether it was the novelty wearing off\nor consumers adjusting to inflation, Oatly"
    } ]
  }, {
    "tStartMs": 573698,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "as a premium concept had hit its ceiling"
    } ]
  }, {
    "tStartMs": 575658,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "as growth slowed to just low single digits\nin two years with weakening demand."
    } ]
  }, {
    "tStartMs": 579829,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "Oatly no longer needed so many factories,\nor needed so many product lines,"
    } ]
  }, {
    "tStartMs": 583332,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "and the ambition to have two production\nhubs in every region was overkill."
    } ]
  }, {
    "tStartMs": 586836,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The cost of these new facilities, both"
    } ]
  }, {
    "tStartMs": 588546,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "in their initial construction\nand the day to day operation,"
    } ]
  }, {
    "tStartMs": 591132,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "was killing margins and trying to scale\neverything themselves was not worth it,"
    } ]
  }, {
    "tStartMs": 594427,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "when the demand had already peaked.\nCrushed by the declining popularity"
    } ]
  }, {
    "tStartMs": 597847,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "and the overhead of the factories\nthat it couldn't run efficiently,"
    } ]
  }, {
    "tStartMs": 600391,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "losses have only deepened."
    } ]
  }, {
    "tStartMs": 601809,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "They've since given up their dreams\nof vertical integration,"
    } ]
  }, {
    "tStartMs": 604228,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "sold off the factories, brought back\nthe third party co-packers,"
    } ]
  }, {
    "tStartMs": 607189,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "and cut back on the new products\nto restore margins."
    } ]
  }, {
    "tStartMs": 609692,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "But since the massive growth\nand untapped potential"
    } ]
  }, {
    "tStartMs": 611902,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "that Oatly had preached to fuel its IPO\nis nowhere to be found,"
    } ]
  }, {
    "tStartMs": 615031,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "the company has naturally cratered"
    } ]
  }, {
    "tStartMs": 616449,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "to penny stock territory.\nWith its equity value now worth so little,"
    } ]
  }, {
    "tStartMs": 619952,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "they don't have the means to fundraise\nanother war chest unless it's through debt."
    } ]
  }, {
    "tStartMs": 623122,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Hence, their only option now is to batten down"
    } ]
  }, {
    "tStartMs": 625082,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "the hatches and to cut costs,\nwhile hoping that demand will persist"
    } ]
  }, {
    "tStartMs": 628085,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "in the coming years."
    } ]
  }, {
    "tStartMs": 629253,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "Oatly's greatest failure\nwas stubbornly believing"
    } ]
  }, {
    "tStartMs": 631505,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "that oat milk was some new product"
    } ]
  }, {
    "tStartMs": 633132,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "that would have radically stronger\nbusiness fundamentals than cow milk,"
    } ]
  }, {
    "tStartMs": 636010,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "the very product it was trying to replace."
    } ]
  }, {
    "tStartMs": 638220,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "If consumers don't see Oatly at their store,"
    } ]
  }, {
    "tStartMs": 640222,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "they can just buy a different brand,"
    } ]
  }, {
    "tStartMs": 641557,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "because having some oat\nmilk is better than none at all."
    } ]
  }, {
    "tStartMs": 644143,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "The competition may be inferior,\nbut is ultimately not substantially worse."
    } ]
  }, {
    "tStartMs": 648064,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "Oat milk, in effect, has become\njust as saturated as regular milk,"
    } ]
  }, {
    "tStartMs": 651150,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and Oatly's struggles come from trying\nto survive as a standalone branded"
    } ]
  }, {
    "tStartMs": 654570,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "premium for what is an essential commodity.\nTo replace cow milk,"
    } ]
  }, {
    "tStartMs": 658366,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "Oatly must tether itself to a price range\nthat's familiar to consumers."
    } ]
  }, {
    "tStartMs": 661827,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "But because the dairy industry\nin every country"
    } ]
  }, {
    "tStartMs": 663913,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "relies on government subsidies to survive,\nOatly can only really be a premium,"
    } ]
  }, {
    "tStartMs": 667917,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "not a floor."
    } ]
  }, {
    "tStartMs": 668668,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "They can't price-match the cow milk\nthey're trying to replace,"
    } ]
  }, {
    "tStartMs": 671295,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "and they also can't get any lower\nbecause they don't"
    } ]
  }, {
    "tStartMs": 673172,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "have the same economic safety net."
    } ]
  }, {
    "tStartMs": 675091,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "The barrier to entry to produce oat\nmilk is much lower than cow milk."
    } ]
  }, {
    "tStartMs": 678552,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "Oatmeal can be made at home in minutes,"
    } ]
  }, {
    "tStartMs": 680346,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "whereas raising a cow\nis a drastically greater undertaking."
    } ]
  }, {
    "tStartMs": 683224,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "The company has tried to reinforce\nits brandpower in other ways,"
    } ]
  }, {
    "tStartMs": 686268,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "like suing competitors\nwith remotely similar"
    } ]
  }, {
    "tStartMs": 688479,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "packaging or advertising dubious\nnutritional and environmental claims."
    } ]
  }, {
    "tStartMs": 692233,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "What Oatly is doing is not any different\nfrom what existing dairy companies"
    } ]
  }, {
    "tStartMs": 695695,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "do to find an edge in a saturated,\ncommoditized category."
    } ]
  }, {
    "tStartMs": 698739,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "A2, for example, grosses over"
    } ]
  }, {
    "tStartMs": 700491,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "$1 billion a year selling branded cow milk\nfree of A1 proteins,"
    } ]
  }, {
    "tStartMs": 704370,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "despite the fact that there is zero\nscientific evidence"
    } ]
  }, {
    "tStartMs": 706747,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "that the naturally occurring A1 protein\nin milk is even bad for you."
    } ]
  }, {
    "tStartMs": 710292,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "Their message for years has been\nthat if you drink their milk regularly,"
    } ]
  }, {
    "tStartMs": 713379,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "you'll be associated with less"
    } ]
  }, {
    "tStartMs": 714547,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "risk of diabetes, heart disease,\nand even schizophrenia."
    } ]
  }, {
    "tStartMs": 717591,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "And then on the other end,\nyou have European brands"
    } ]
  }, {
    "tStartMs": 719844,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "who market their milk as grass fed\nand paint visuals of happy, free-roaming,"
    } ]
  }, {
    "tStartMs": 723723,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "ethically raised cows and meadows\nproducing \"healthier milk\""
    } ]
  }, {
    "tStartMs": 726934,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "despite near-identical nutrition."
    } ]
  }, {
    "tStartMs": 729103,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Oatly's missteps amplified\ntheir struggles,"
    } ]
  }, {
    "tStartMs": 731105,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "but it's not like the cow milk and dairy"
    } ]
  }, {
    "tStartMs": 732732,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "industry is doing great in the first place."
    } ]
  }, {
    "tStartMs": 734984,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "Milk is a terrible business."
    } ]
  }, {
    "tStartMs": 736485,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "And even if cow milk is one day replaced \nwith oat, soy"
    } ]
  }, {
    "tStartMs": 739405,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "or nut milk, these\nsame poor fundamentals will still exist."
    } ]
  }, {
    "tStartMs": 742575,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "Milk is not an ordinary product."
    } ]
  }, {
    "tStartMs": 744368,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "It's a political symbol\nthat transcends nutrition."
    } ]
  }, {
    "tStartMs": 746787,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Ordinary people gauge the health\nof the economy every day, not through"
    } ]
  }, {
    "tStartMs": 749832,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "job reports or unemployment figures,\nbut instead through milk."
    } ]
  }, {
    "tStartMs": 752877,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "When the price of milk\ngoes up at the store,"
    } ]
  }, {
    "tStartMs": 754754,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "everyone squawks,\nand that public disapproval lands"
    } ]
  }, {
    "tStartMs": 757214,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "on the government for not keeping things\naffordable for everyday people."
    } ]
  }, {
    "tStartMs": 760426,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Consumers pay attention to the price of milk"
    } ]
  }, {
    "tStartMs": 762428,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "more than any other essential,\nlike bread, eggs and meat."
    } ]
  }, {
    "tStartMs": 765723,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "As a result, supermarkets for generations\nhave positioned milk as loss leaders."
    } ]
  }, {
    "tStartMs": 769894,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "They always place\nmilk in the back of the store,"
    } ]
  }, {
    "tStartMs": 771854,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "so customers are forced to traverse\nthrough the aisles of other tempting,"
    } ]
  }, {
    "tStartMs": 774940,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "higher-margin products."
    } ]
  }, {
    "tStartMs": 776317,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "The supermarket will generally"
    } ]
  }, {
    "tStartMs": 777693,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "make only a few cents,\nor even lose money on selling the milk,"
    } ]
  }, {
    "tStartMs": 780696,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "but will make profits so long as customers\nadd other items to their cart"
    } ]
  }, {
    "tStartMs": 783991,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "on their way out."
    } ]
  }, {
    "tStartMs": 784825,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "This is why the milk section of any store\nis always so well stocked."
    } ]
  }, {
    "tStartMs": 787995,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "It's the only universally guaranteed"
    } ]
  }, {
    "tStartMs": 789747,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "product around the world that can get the customer\nin through the door multiple times a week."
    } ]
  }, {
    "tStartMs": 793626,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "In short, consumers want cheap milk."
    } ]
  }, {
    "tStartMs": 795669,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Retailers want to carry cheap milk."
    } ]
  }, {
    "tStartMs": 797379,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "Politicians want to keep milk cheap,\nand all of these pressures end up on the"
    } ]
  }, {
    "tStartMs": 800591,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "heads of the people who produce milk\nin the dairy farmers and dairy processors."
    } ]
  }, {
    "tStartMs": 804595,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "So to solve for everyone, governments\nthrough history, from Canada"
    } ]
  }, {
    "tStartMs": 807681,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "to the U.S. all the way to China, have provided"
    } ]
  }, {
    "tStartMs": 809892,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "enormous subsidies to keep farmers\nemployed,"
    } ]
  }, {
    "tStartMs": 812144,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "prices low, and milk flowing."
    } ]
  }, {
    "tStartMs": 814063,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "In the First World War,"
    } ]
  }, {
    "tStartMs": 815105,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "the U.S. kept their troops fed with powdered\nmilk, cheese, and other processed dairy."
    } ]
  }, {
    "tStartMs": 819401,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "After the war ended, demand disappeared."
    } ]
  }, {
    "tStartMs": 821529,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "Production continued at the same levels."
    } ]
  }, {
    "tStartMs": 823614,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "This led to a massive surplus\nand the price of milk cratered,"
    } ]
  }, {
    "tStartMs": 826200,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "leading farmers to unionize\nand to lobby for market protection."
    } ]
  }, {
    "tStartMs": 829453,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "In response, the U.S. government\ncreated federal programs to force demand."
    } ]
  }, {
    "tStartMs": 833290,
    "dDurationMs": 4797,
    "segs": [ {
      "utf8": "The 1940 Federal Milk Program and the 1946\nNational School Lunch Act mandated"
    } ]
  }, {
    "tStartMs": 838087,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "that every school start\nserving lunch with cow milk,"
    } ]
  }, {
    "tStartMs": 840548,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "which gave the dairy industry an infinite\nsupply of mouths and first dibs on"
    } ]
  }, {
    "tStartMs": 844260,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "priming the next generation of Americans\nto drink cow milk under FDA's New Deal."
    } ]
  }, {
    "tStartMs": 848806,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "The US government also started \nself-funding advertisements"
    } ]
  }, {
    "tStartMs": 851475,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "that positioned milk to the masses\nas part of the Healthy American diet."
    } ]
  }, {
    "tStartMs": 855020,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "This was all nearly a century ago."
    } ]
  }, {
    "tStartMs": 856981,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "By the 1950s, Americans were drinking\nmore milk than soda or juice."
    } ]
  }, {
    "tStartMs": 860860,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "But despite the forced\nconditioning, milk consumption per capita"
    } ]
  }, {
    "tStartMs": 863946,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "in the U.S. has declined decade after decade\nsince."
    } ]
  }, {
    "tStartMs": 866949,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "The average"
    } ]
  }, {
    "tStartMs": 867491,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "American drinks about one third\nthe amount of milk today than they did"
    } ]
  }, {
    "tStartMs": 870578,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "70 years ago."
    } ]
  }, {
    "tStartMs": 871662,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "But while demand has declined,"
    } ]
  }, {
    "tStartMs": 872997,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "milk production continues\nto reach record levels year after year."
    } ]
  }, {
    "tStartMs": 876041,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "Even though everyone knows\nthis is wasteful overproduction."
    } ]
  }, {
    "tStartMs": 878878,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "There just doesn't exist enough demand\nfor all this milk."
    } ]
  }, {
    "tStartMs": 881380,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "And yet government\nsubsidies have only intensified."
    } ]
  }, {
    "tStartMs": 884174,
    "dDurationMs": 543,
    "segs": [ {
      "utf8": "At first,"
    } ]
  }, {
    "tStartMs": 884717,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "they tried paying farmers to produce \nless, but when that failed,"
    } ]
  }, {
    "tStartMs": 887595,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "the American government\nmade themselves a customer."
    } ]
  }, {
    "tStartMs": 889722,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "Starting in the 1970s,"
    } ]
  }, {
    "tStartMs": 890848,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "they bought up all the excess milk"
    } ]
  }, {
    "tStartMs": 892266,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "that the dairy farmers couldn't\nsell, converted it into cheese"
    } ]
  }, {
    "tStartMs": 895269,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "for longer shelf-life,\nand then began amassing"
    } ]
  }, {
    "tStartMs": 897396,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "these stockpiles in vaults\naround the country."
    } ]
  }, {
    "tStartMs": 899398,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Since overproduction was now rewarded\ninstead of punished, dairy farmers continue"
    } ]
  }, {
    "tStartMs": 903402,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "to overproduce and the vaults\noverflowed with millions of pounds"
    } ]
  }, {
    "tStartMs": 906614,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "of this government cheese."
    } ]
  }, {
    "tStartMs": 907781,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "And since no one was actually eating\nthis cheese, it was still going bad."
    } ]
  }, {
    "tStartMs": 911285,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Yet the government couldn't\njust sell their cheese off for cheap,"
    } ]
  }, {
    "tStartMs": 913871,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "since that would only undercut\nthe actual commercial for-sale cheese"
    } ]
  }, {
    "tStartMs": 916999,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "that the dairy industry\nwas peddling to the public."
    } ]
  }, {
    "tStartMs": 919460,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "The only solution left was to simply give\naway the government cheese for free"
    } ]
  }, {
    "tStartMs": 922838,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "to low-income households\non welfare and food stamps,"
    } ]
  }, {
    "tStartMs": 925424,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "but milk consumption still continued\nto decline into the mid 90s."
    } ]
  }, {
    "tStartMs": 928636,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "Leaving everything in the hands of farmers"
    } ]
  }, {
    "tStartMs": 930429,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "was clearly not working\nand the only option left was brute force."
    } ]
  }, {
    "tStartMs": 933766,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "The government decided"
    } ]
  }, {
    "tStartMs": 934683,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "to throw more bodies at the problem\nby creating Dairy Management Incorporated"
    } ]
  }, {
    "tStartMs": 938312,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "a taxpayer-funded nonprofit supervised\nby the Department of Agriculture."
    } ]
  }, {
    "tStartMs": 942566,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "The organization would employ hundreds\nof people full time, all dedicated"
    } ]
  }, {
    "tStartMs": 946195,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "every day, to finding ways to incorporate\nmore dairy into the American diet."
    } ]
  }, {
    "tStartMs": 950324,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "DMI rolled out the famous Got Milk?\ncampaign and messaged cow"
    } ]
  }, {
    "tStartMs": 953285,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "milk as the key ingredient to strong bones\nand healthy joints."
    } ]
  }, {
    "tStartMs": 956497,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Yet their strongest strategy"
    } ]
  }, {
    "tStartMs": 957665,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "has been their hidden partnership\nwith American fast food."
    } ]
  }, {
    "tStartMs": 960459,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "Crowd favorites like Pizza Hut Stuffed\nCrust and Domino's Cheesy Bread"
    } ]
  }, {
    "tStartMs": 963879,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "were not the creations\nof some visionary chef,"
    } ]
  }, {
    "tStartMs": 966048,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "but instead the result of long\nrunning partnerships from DMI."
    } ]
  }, {
    "tStartMs": 969259,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "DMI is why there's more milk-based drinks\nat Starbucks, more cheese on Taco Bell's"
    } ]
  }, {
    "tStartMs": 973472,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "menu, and larger slices of cheese\non McDonald's hamburgers these days."
    } ]
  }, {
    "tStartMs": 976934,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "But ultimately, a sprinkle of cheese here,"
    } ]
  }, {
    "tStartMs": 979103,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "a flashy ad over there, and a mandated\ncarton per student still has never been"
    } ]
  }, {
    "tStartMs": 982982,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "enough collectively to stop the decline\nin cow milk consumption."
    } ]
  }, {
    "tStartMs": 986360,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "When we exclude government subsidies,\nthe average dairy"
    } ]
  }, {
    "tStartMs": 989029,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "farm has only been profitable\nthree times in the past 23 years."
    } ]
  }, {
    "tStartMs": 992992,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Milk is sold by the hundredweight and farmers, broadly"
    } ]
  }, {
    "tStartMs": 995494,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "speaking, have lost anywhere\nfrom $1 to $5 per hundredweight."
    } ]
  }, {
    "tStartMs": 999373,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "Since 2000, the only three years\nin which dairy farms were profitable"
    } ]
  }, {
    "tStartMs": 1003168,
    "dDurationMs": 4505,
    "segs": [ {
      "utf8": "without subsidies were in 2007, 2014\nand 2022"
    } ]
  }, {
    "tStartMs": 1007715,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "as it was those years in which \nthe price of milk spiked"
    } ]
  }, {
    "tStartMs": 1010426,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "but then plummeted down\nthe following year,"
    } ]
  }, {
    "tStartMs": 1012177,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "once supply exceeded demand. \nCompared to corn, wheat or oats,"
    } ]
  }, {
    "tStartMs": 1015597,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "milk is perishable and harder\nto store and transport."
    } ]
  }, {
    "tStartMs": 1018517,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Once cow milk is harvested,\nit has to get on shelves"
    } ]
  }, {
    "tStartMs": 1020936,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "and to be sold as quickly as possible."
    } ]
  }, {
    "tStartMs": 1022771,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "Like every other agricultural commodity,\nthere's fluctuations in demand, cost"
    } ]
  }, {
    "tStartMs": 1026650,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "of feed, the health of cattle,\nweather, and exports."
    } ]
  }, {
    "tStartMs": 1029945,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "China and Mexico and Canada\nare the biggest international buyers"
    } ]
  }, {
    "tStartMs": 1032948,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "of American milk."
    } ]
  }, {
    "tStartMs": 1033824,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "But even their demand"
    } ]
  }, {
    "tStartMs": 1034783,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "is susceptible to changes in trade\nrelations and economic policy."
    } ]
  }, {
    "tStartMs": 1038328,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "While crops have defined harvesting seasons,"
    } ]
  }, {
    "tStartMs": 1040414,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "dairy is uniquely continuous as cows\nproduce milk all year round."
    } ]
  }, {
    "tStartMs": 1044126,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "All these factors are\nwhy the price of milk is volatile"
    } ]
  }, {
    "tStartMs": 1046712,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "and the dairy industry suffers\nfrom boom-and-bust year after year."
    } ]
  }, {
    "tStartMs": 1050132,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "When the prices up, farmers milk more cows\nso they can make more money."
    } ]
  }, {
    "tStartMs": 1053260,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "But when the price is down,\nthey still milk more anyways"
    } ]
  }, {
    "tStartMs": 1055679,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "to try to minimize their losses\nthrough greater volume,"
    } ]
  }, {
    "tStartMs": 1058015,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "leading to the same net net of excess\noverproduction."
    } ]
  }, {
    "tStartMs": 1061143,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "The point is not that dairy\nfarmers are uniquely unprofitable."
    } ]
  }, {
    "tStartMs": 1064021,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Wheat and cotton farmers"
    } ]
  }, {
    "tStartMs": 1065189,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "also for the most part, lose money\nwithout subsidies."
    } ]
  }, {
    "tStartMs": 1067816,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "Rice and soybean"
    } ]
  }, {
    "tStartMs": 1068692,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "farms, on the other hand,\nare the exception with consistent returns."
    } ]
  }, {
    "tStartMs": 1071695,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "But the question to ask\nis that if most dairy farmers lose money,"
    } ]
  }, {
    "tStartMs": 1074907,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "then why would they stay\nin this line of work?"
    } ]
  }, {
    "tStartMs": 1076742,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And the answer is that most don't."
    } ]
  }, {
    "tStartMs": 1078452,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "In the past decade,"
    } ]
  }, {
    "tStartMs": 1079453,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "the number of dairy farms in\nthe U.S. has shrunk by nearly half."
    } ]
  }, {
    "tStartMs": 1082748,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "Even with fewer farms, milk production\nstill remains at an all time high."
    } ]
  }, {
    "tStartMs": 1086543,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "What's happening"
    } ]
  }, {
    "tStartMs": 1087294,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "is that the small multi-generation\nfamily farm is being replaced"
    } ]
  }, {
    "tStartMs": 1090672,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "by the corporation, who's running\nfewer farms but with greater herds"
    } ]
  }, {
    "tStartMs": 1093884,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "and the dairy processors\nlove it for their bottom line,"
    } ]
  }, {
    "tStartMs": 1096345,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "because they only need to make one pickup\nfor their milk"
    } ]
  }, {
    "tStartMs": 1098555,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "instead of making multiple stops\nat many small farms."
    } ]
  }, {
    "tStartMs": 1101391,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "On paper, farmers are made whole, as in theory,"
    } ]
  }, {
    "tStartMs": 1103894,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "whatever money they lose\noperating is reimbursed by the government."
    } ]
  }, {
    "tStartMs": 1107231,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "But agricultural subsidies are not evenly\ndistributed across the US and the EU."
    } ]
  }, {
    "tStartMs": 1111819,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "Farmers are actually awarded subsidies\nbased on production and acreage -"
    } ]
  }, {
    "tStartMs": 1115614,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "another case of where the rich get richer\nthe biggest, wealthiest farms and co-ops"
    } ]
  }, {
    "tStartMs": 1119618,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "rake in the most handouts"
    } ]
  }, {
    "tStartMs": 1120786,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "while small, independent farms\nget the least. Milk is the fifth"
    } ]
  }, {
    "tStartMs": 1124081,
    "dDurationMs": 5881,
    "segs": [ {
      "utf8": "most subsidized agriculture commodity\nin the U.S..  From 1995 to 2023, only corn,"
    } ]
  }, {
    "tStartMs": 1130170,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "soybean, wheat, and cotton farmers\nreceive greater subsidies."
    } ]
  }, {
    "tStartMs": 1134007,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "The dairy industry gets its money\nthrough four main subsidies."
    } ]
  }, {
    "tStartMs": 1137052,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "There's the Dairy Support Program\nwhere the U.S."
    } ]
  }, {
    "tStartMs": 1139096,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "government guarantees\nprofits for dairy farmers"
    } ]
  }, {
    "tStartMs": 1141390,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "by setting a minimum price on milk,\neven when the market crashes."
    } ]
  }, {
    "tStartMs": 1144643,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Then there's the Milk Income Loss\nContract program, where when milk prices"
    } ]
  }, {
    "tStartMs": 1147980,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "drop below a specific threshold,"
    } ]
  }, {
    "tStartMs": 1149606,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "the federal government will make it direct\npayments to dairy farmers."
    } ]
  }, {
    "tStartMs": 1152526,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "And that same payout is also given\nif the cost of feed increases"
    } ]
  }, {
    "tStartMs": 1155737,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "beyond a certain price."
    } ]
  }, {
    "tStartMs": 1156989,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "If their milk is deemed unfit to sell,\nthen dairy farmers also get a payout."
    } ]
  }, {
    "tStartMs": 1160826,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "The multi-billion dollar contribution\nof all these various subsidies are"
    } ]
  }, {
    "tStartMs": 1164288,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "what's propping up the dying\ndairy industry."
    } ]
  }, {
    "tStartMs": 1166707,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Ironically, the most capitalist\nand democratic solution to all of this"
    } ]
  }, {
    "tStartMs": 1170127,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "would be to let the dairy industry shrink\nand to adjust to the free market."
    } ]
  }, {
    "tStartMs": 1173755,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "But there's no politician in the US"
    } ]
  }, {
    "tStartMs": 1175340,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "or the EU that would take this position\nof letting farmers lose their livelihood."
    } ]
  }, {
    "tStartMs": 1179178,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "Even the mere suggestion"
    } ]
  }, {
    "tStartMs": 1180387,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "of letting farmers go\nbroke would be a political death sentence."
    } ]
  }, {
    "tStartMs": 1183432,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "And because of optics and politics,"
    } ]
  }, {
    "tStartMs": 1185225,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "the dairy industry continues to chug\nalong, propped up by taxpayer money,"
    } ]
  }, {
    "tStartMs": 1189104,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "for-sale politicians, and the cultural\nsignificance of cow milk as a product."
    } ]
  }, {
    "tStartMs": 1193317,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "But how does the fate of dairy farmers\nrelate to Oatly?"
    } ]
  }, {
    "tStartMs": 1196069,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "Vegans have argued that if Oatly was\ngetting half the same government support"
    } ]
  }, {
    "tStartMs": 1199531,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "that the dairy farmers get, the company\nwould be in a much better spot."
    } ]
  }, {
    "tStartMs": 1202618,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "There's truth in this if the U.S. government\nmandated oat milk or plant based milk"
    } ]
  }, {
    "tStartMs": 1206622,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "instead of cow milk for school lunches,\nthat would be a guaranteed customer base"
    } ]
  }, {
    "tStartMs": 1209875,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "and a huge volume that Oatly wouldn't\neven need to lift a finger for."
    } ]
  }, {
    "tStartMs": 1213128,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "If the government subsidized advertising\nfor these vegan startups"
    } ]
  }, {
    "tStartMs": 1216215,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "and formed these taxpayer\nfunded non-profits to help market"
    } ]
  }, {
    "tStartMs": 1219343,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "these plant-based milks,\nthen Oatly naturally wouldn't"
    } ]
  }, {
    "tStartMs": 1221678,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "need to invest so much\ninto their own sales and marketing."
    } ]
  }, {
    "tStartMs": 1224389,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "But the idea"
    } ]
  }, {
    "tStartMs": 1224973,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "that Oatly would magically prosper\nif the world replaced cow milk with oat"
    } ]
  }, {
    "tStartMs": 1228268,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "milk, and all the dairy subsidies\nflow to the oat farmers is just not true."
    } ]
  }, {
    "tStartMs": 1231855,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "In the world of dairy,\nthe biggest players are the processors"
    } ]
  }, {
    "tStartMs": 1234608,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Like Land O'Lakes, Nestlé, Danone, and Coca-Cola."
    } ]
  }, {
    "tStartMs": 1237903,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "Even though these companies own\nsome of the most popular, recognizable"
    } ]
  }, {
    "tStartMs": 1241114,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "brands like Fairlife and Horizon,\nthey don't own any farms."
    } ]
  }, {
    "tStartMs": 1244326,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "They simply buy the raw milk\nfrom the dairy farmers"
    } ]
  }, {
    "tStartMs": 1246662,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "and then they do their own"
    } ]
  }, {
    "tStartMs": 1247496,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "processing and enhancements\nbefore packaging and distributing it"
    } ]
  }, {
    "tStartMs": 1250666,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "to customers in the form of branded milk,\nbutter, ice cream and yogurt."
    } ]
  }, {
    "tStartMs": 1254378,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "By definition, Oatly is a processor\nrather than a producer."
    } ]
  }, {
    "tStartMs": 1257756,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "They source the raw oats, they buy the\nvegetable oil and enzymes from suppliers,"
    } ]
  }, {
    "tStartMs": 1261718,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "and they process everything together\nbefore"
    } ]
  }, {
    "tStartMs": 1263512,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "packaging, branding and distributing\nthe finished product to customers."
    } ]
  }, {
    "tStartMs": 1267057,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "Dean Foods, until its bankruptcy in 2019,\nwas the largest dairy processor"
    } ]
  }, {
    "tStartMs": 1271144,
    "dDurationMs": 835,
    "segs": [ {
      "utf8": "in the U.S.."
    } ]
  }, {
    "tStartMs": 1271979,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "They owned the biggest cow"
    } ]
  }, {
    "tStartMs": 1273313,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "milk brands like Horizon,\nTru Moo, Land O'Lakes and Dairy Pure."
    } ]
  }, {
    "tStartMs": 1277109,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "But even they couldn't"
    } ]
  }, {
    "tStartMs": 1277985,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "make it work in spite of the subsidies\nand government support."
    } ]
  }, {
    "tStartMs": 1281154,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "The business idea\nbehind Dean Foods was simple."
    } ]
  }, {
    "tStartMs": 1283615,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Given the consolidation in dairy farms,\nit wasn't crazy"
    } ]
  }, {
    "tStartMs": 1286159,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "to imagine that same kind of consolidation\nwith dairy processors."
    } ]
  }, {
    "tStartMs": 1289413,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "If a single company could scale to be\nthe largest processor in the nation,"
    } ]
  }, {
    "tStartMs": 1292874,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "they could unlock economies of scale\nand cost advantages that no competitor"
    } ]
  }, {
    "tStartMs": 1296628,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "could ever match."
    } ]
  }, {
    "tStartMs": 1297546,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "They, in theory, had the supply chain\nto produce the cheapest milk possible, but"
    } ]
  }, {
    "tStartMs": 1301008,
    "dDurationMs": 3878,
    "segs": [ {
      "utf8": "also the brandpower to generate greater\nprofits from their premium portfolio."
    } ]
  }, {
    "tStartMs": 1304970,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "This plan worked through the 2000, as Dean\nFoods boasted industry leading margins"
    } ]
  }, {
    "tStartMs": 1309182,
    "dDurationMs": 835,
    "segs": [ {
      "utf8": "year after year."
    } ]
  }, {
    "tStartMs": 1310017,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "But after the Great Recession,\nthe value of milk changed."
    } ]
  }, {
    "tStartMs": 1312769,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "With the economic downturn, retailers\nwere desperate to restore foot traffic,"
    } ]
  }, {
    "tStartMs": 1316523,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "and they found their silver bullet\nin private label milk and dairy"
    } ]
  }, {
    "tStartMs": 1319985,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "as the only product that's guaranteed\nto get customers in the door"
    } ]
  }, {
    "tStartMs": 1322904,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "multiple times a week."
    } ]
  }, {
    "tStartMs": 1323905,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "And if you have the cheapest milk, you're\ngoing to get people in and spending."
    } ]
  }, {
    "tStartMs": 1326867,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "The issue wasn't the existence of cheap\nprivate label milk brands,"
    } ]
  }, {
    "tStartMs": 1329995,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "but rather the desperation that retailers\nnow had to strengthen their business."
    } ]
  }, {
    "tStartMs": 1333540,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "They were suddenly willing\nto aggressively lose money"
    } ]
  }, {
    "tStartMs": 1335876,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "on their own milk and dairy products\njust to get customers in the door"
    } ]
  }, {
    "tStartMs": 1339046,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "and so the price gap between branded milk\nlike TruMoo and Horizon versus private"
    } ]
  }, {
    "tStartMs": 1343133,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "label milk became greater.\nThe floor got lower year after year"
    } ]
  }, {
    "tStartMs": 1346470,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "and branded milk by association\nappeared far more expensive,"
    } ]
  }, {
    "tStartMs": 1349639,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "even though their prices never changed."
    } ]
  }, {
    "tStartMs": 1351725,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "There was nothing Dean Foods could do"
    } ]
  }, {
    "tStartMs": 1353352,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "since they couldn't\nlive off the school lunches alone,"
    } ]
  }, {
    "tStartMs": 1355562,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "and they needed the retailers\nfor the volume"
    } ]
  }, {
    "tStartMs": 1357481,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "as much as the retailers\nneeded them to supply milk."
    } ]
  }, {
    "tStartMs": 1360150,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Dean Foods struggled. On one hand,\nthey were constantly adjusting"
    } ]
  }, {
    "tStartMs": 1363153,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "to the price of cow milk\nand the price of fuel every quarter."
    } ]
  }, {
    "tStartMs": 1366156,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "On the other hand,\nthey were under direct pressure"
    } ]
  }, {
    "tStartMs": 1367908,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "from retailers who were bidding\nDean Foods against other processors"
    } ]
  }, {
    "tStartMs": 1370952,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "in a race to the bottom to see\nwho could provide them the cheapest milk."
    } ]
  }, {
    "tStartMs": 1374122,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "The consolidation that was occurring in\ndairy was also happening now in retail."
    } ]
  }, {
    "tStartMs": 1378126,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "There were fewer retailers exiting\nthe Great Recession, and the ones left"
    } ]
  }, {
    "tStartMs": 1381546,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "like Target, Walmart, Costco,\nand Albertsons had all the leverage."
    } ]
  }, {
    "tStartMs": 1385384,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "Cost could not be passed\ndirectly on customers like before."
    } ]
  }, {
    "tStartMs": 1388261,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "This is why Dean Foods' operating margins\ndeclined rapidly after 2009, as they,"
    } ]
  }, {
    "tStartMs": 1392557,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "like all processors, were squeezed\nbetween a rock and a hard place."
    } ]
  }, {
    "tStartMs": 1395769,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Dairy farmers thrive"
    } ]
  }, {
    "tStartMs": 1396937,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "whenever the price of milk goes up,\nbut they're also insulated"
    } ]
  }, {
    "tStartMs": 1399564,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "by the government subsidies\nwhenever it goes down."
    } ]
  }, {
    "tStartMs": 1401733,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "But Dean Foods\ndidn't get that same protection."
    } ]
  }, {
    "tStartMs": 1404152,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "When milk prices went down,\nthey still had to pay farmers"
    } ]
  }, {
    "tStartMs": 1406696,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "the floor price\nthat was set by the government."
    } ]
  }, {
    "tStartMs": 1408657,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "Dean tried to stem the top line"
    } ]
  }, {
    "tStartMs": 1410158,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "bleeding through product\ninnovation and cost cutting."
    } ]
  }, {
    "tStartMs": 1412411,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "They leaned into flavored\nmilk, value-added protein"
    } ]
  }, {
    "tStartMs": 1414955,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "brands, shut down their factories\nand cut back on SGA."
    } ]
  }, {
    "tStartMs": 1417958,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "But none of that ever helped\nthe company recover its margins."
    } ]
  }, {
    "tStartMs": 1420752,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "All of the consumer, political,\nand retailer pressure for cheap cow"
    } ]
  }, {
    "tStartMs": 1424089,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "milk was placed solely on the dairy\nprocessors, and Dean Foods, in effect,"
    } ]
  }, {
    "tStartMs": 1428009,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "became the very commodity\nthat was selling"
    } ]
  }, {
    "tStartMs": 1430095,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "with shrinking operating margins, stagnant\ngrowth, declining sales and forever"
    } ]
  }, {
    "tStartMs": 1434141,
    "dDurationMs": 4963,
    "segs": [ {
      "utf8": "pressure to deliver cheaper and faster.\nThe premium brands like Horizon, TrueMoo"
    } ]
  }, {
    "tStartMs": 1439104,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "and Dairy Pure were the only way\nthe company could become, in its own"
    } ]
  }, {
    "tStartMs": 1442315,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "\"commodity resistant\""
    } ]
  }, {
    "tStartMs": 1444443,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "but none of those measures ever succeeded."
    } ]
  }, {
    "tStartMs": 1446403,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Customers got used to trading down\nfrom premium brands to private label,"
    } ]
  }, {
    "tStartMs": 1450240,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "cow milk consumption continued to decline\noverall, and Dean Foods went bankrupt."
    } ]
  }, {
    "tStartMs": 1454536,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "If the world one day replaces cow\nmilk with oat"
    } ]
  }, {
    "tStartMs": 1456705,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "milk, where people will go into\nsupermarkets multiple times a week"
    } ]
  }, {
    "tStartMs": 1459708,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "to buy what they perceive\nto be a dietary essential, then the same"
    } ]
  }, {
    "tStartMs": 1462836,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "political, consumer and retailer pressures\nwill then fall on Oatly.  Retailers"
    } ]
  }, {
    "tStartMs": 1466798,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "these days have already come out\nwith their own private"
    } ]
  }, {
    "tStartMs": 1468675,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "label oat milk or nut milk\nto undercut the premium brands."
    } ]
  }, {
    "tStartMs": 1471887,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Oatly is already clinging onto its brand\nas its only moat,"
    } ]
  }, {
    "tStartMs": 1474598,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "just like Dean foods desperately\ndid on its deathbed."
    } ]
  }, {
    "tStartMs": 1477309,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Before Dean Foods went bankrupt,\nit had invested in silk,"
    } ]
  }, {
    "tStartMs": 1480103,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "who is the pioneer of plant\nbased milks before Oatly."
    } ]
  }, {
    "tStartMs": 1483273,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "Silk's revenue surged in the early 2010s"
    } ]
  }, {
    "tStartMs": 1485025,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "as the only nationwide player\nfor soy milk, almond milk, and cashew milk."
    } ]
  }, {
    "tStartMs": 1488862,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "But Silk ultimately lacked pricing power."
    } ]
  }, {
    "tStartMs": 1490947,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "Silk dominated shelves,"
    } ]
  }, {
    "tStartMs": 1492324,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "but they still could not\ndemand higher margins,"
    } ]
  }, {
    "tStartMs": 1494284,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "even though retailers at the time\nwere too focused on private"
    } ]
  }, {
    "tStartMs": 1496745,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "label cow milk to really care\nabout private label soy or not milk."
    } ]
  }, {
    "tStartMs": 1500040,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "As a result, Silk's operating margins"
    } ]
  }, {
    "tStartMs": 1501917,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "were still lower than that of its dairy\nrivals, even at its peak."
    } ]
  }, {
    "tStartMs": 1505086,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "Once Silk got acquired by Danone in 2016,\nthey stopped reporting their financials."
    } ]
  }, {
    "tStartMs": 1509299,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "And based on Danone's results"
    } ]
  }, {
    "tStartMs": 1510717,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "and what we see in the grocery store,\nSilk has only gotten cheaper, especially"
    } ]
  }, {
    "tStartMs": 1514179,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "now that demand has plateaued\nand the competition has increased."
    } ]
  }, {
    "tStartMs": 1517516,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "There are only two roads"
    } ]
  }, {
    "tStartMs": 1518558,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "in which an Oatly, Silk or vegan food\nbrand can survive as a business."
    } ]
  }, {
    "tStartMs": 1522312,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "They don't have any future\nas a standalone independent company,"
    } ]
  }, {
    "tStartMs": 1525232,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "with or without government subsidies."
    } ]
  }, {
    "tStartMs": 1527150,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "They can only thrive in two ways - one,"
    } ]
  }, {
    "tStartMs": 1528693,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "as a supplemental portfolio piece"
    } ]
  }, {
    "tStartMs": 1530403,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "in a larger processed food conglomerate\nlike Dannon, Nestle or PepsiCo,"
    } ]
  }, {
    "tStartMs": 1534658,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "who's only relying on this brand\nfor sales coverage rather than profits."
    } ]
  }, {
    "tStartMs": 1538245,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "The only other alternative"
    } ]
  }, {
    "tStartMs": 1539704,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "is for these vegan brands to be owned\nand operated by the farmers themselves."
    } ]
  }, {
    "tStartMs": 1543458,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "Farmers are the only entity\nin this landscape that's economically"
    } ]
  }, {
    "tStartMs": 1546586,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "insulated from the fundamental realities\nof supply and demand."
    } ]
  }, {
    "tStartMs": 1549881,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "The largest dairy companies in the world\nthese days are not the giant food"
    } ]
  }, {
    "tStartMs": 1553051,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "conglomerates, but rather co-ops run\nby thousands of dairy farmers"
    } ]
  }, {
    "tStartMs": 1556680,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "who are able to collectively leverage\ntheir subsidies to take on the overhead"
    } ]
  }, {
    "tStartMs": 1560141,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "and to endure the low profits\nof processing, marketing and branding"
    } ]
  }, {
    "tStartMs": 1563436,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "and their profits."
    } ]
  }, {
    "tStartMs": 1564145,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "Farmers are ultimately dependent\non not selling another gallon of milk"
    } ]
  }, {
    "tStartMs": 1567524,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "as much as it is securing\nthat next government paycheck."
    } ]
  }, {
    "tStartMs": 1570777,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "If vegan milk does one day supplant cow\nmilk, it will be the oat farmers,"
    } ]
  }, {
    "tStartMs": 1574322,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "the cashew farmers, the almond farmers,\nand the soy farmers"
    } ]
  }, {
    "tStartMs": 1577367,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "that survive and thrive -"
    } ]
  }, {
    "tStartMs": 1578702,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "not an independent brand [and processor] like Oatly."
    } ]
  } ]
}
