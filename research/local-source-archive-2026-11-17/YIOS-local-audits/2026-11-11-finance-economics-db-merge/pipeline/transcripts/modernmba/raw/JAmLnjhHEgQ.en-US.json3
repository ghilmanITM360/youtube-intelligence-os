{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 166,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Nowhere in the West has sushi"
    } ]
  }, {
    "tStartMs": 1626,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "been pushed harder, priced higher,\nor copied faster than in New York City."
    } ]
  }, {
    "tStartMs": 5630,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "While Los Angeles is the \nbirthplace of sushi in the US,"
    } ]
  }, {
    "tStartMs": 8633,
    "dDurationMs": 4505,
    "segs": [ {
      "utf8": "NYC is by far the largest, most lucrative, \nand most competitive market."
    } ]
  }, {
    "tStartMs": 13346,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "There are more sushi restaurants"
    } ]
  }, {
    "tStartMs": 14806,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "and Michelin-starred counters in Manhattan\nthan anywhere else in the West."
    } ]
  }, {
    "tStartMs": 18727,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "While in most American cities,\nsushi is defined by takeout rolls or"
    } ]
  }, {
    "tStartMs": 22397,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "all you can eat,"
    } ]
  }, {
    "tStartMs": 23148,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "sushi in New York these \ndays means omakase -"
    } ]
  }, {
    "tStartMs": 26109,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "fixed price, counter seating,\nreservations, and chef's choice."
    } ]
  }, {
    "tStartMs": 30530,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "What was once fine-dining luxury has\nevolved into a new mass market standard."
    } ]
  }, {
    "tStartMs": 34993,
    "dDurationMs": 4838,
    "segs": [ {
      "utf8": "Omakase here is no longer a $300, \n$400, $500+ experience."
    } ]
  }, {
    "tStartMs": 40123,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "It's now $100, $80, even $60,"
    } ]
  }, {
    "tStartMs": 43251,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "available at hundreds of spots\nacross the city."
    } ]
  }, {
    "tStartMs": 46379,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "These low-priced counters\nnot only outnumber"
    } ]
  }, {
    "tStartMs": 48590,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "the traditional Michelin \nincumbents, but also compete"
    } ]
  }, {
    "tStartMs": 51176,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "head to head in the same \nprestigious neighborhoods."
    } ]
  }, {
    "tStartMs": 53845,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Today, there are about 2 omakases"
    } ]
  }, {
    "tStartMs": 55805,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "for every 3 sushi restaurants\nin New York City."
    } ]
  }, {
    "tStartMs": 58516,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "It's one of the fastest-growing \ncategories of the past five years,"
    } ]
  }, {
    "tStartMs": 61728,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "and every month, a new spot emerges,\npushing the price down even further."
    } ]
  }, {
    "tStartMs": 66149,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "Omakase, which means chef's choice\nin Japanese, is nothing new."
    } ]
  }, {
    "tStartMs": 70070,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "Sushi restaurants in the U.S."
    } ]
  }, {
    "tStartMs": 71654,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "have offered it for generations\nas a line item buried in a wide menu."
    } ]
  }, {
    "tStartMs": 75450,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "But what's new is omakase\nas the entire business and"
    } ]
  }, {
    "tStartMs": 78328,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "and as a standalone restaurant \nbuilt for nothing else."
    } ]
  }, {
    "tStartMs": 81289,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "Their menus are rigid\nand their prices are fixed."
    } ]
  }, {
    "tStartMs": 83792,
    "dDurationMs": 4462,
    "segs": [ {
      "utf8": "Everyone gets the same 12 to 20 courses,\nwhere the only real choice is how many."
    } ]
  }, {
    "tStartMs": 88421,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Al a carte ordering is rare, and if \nit exists, it's always tacked on"
    } ]
  }, {
    "tStartMs": 92050,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "at the very end."
    } ]
  }, {
    "tStartMs": 93218,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "There are no walk-ins, no \ntakeout, and no delivery."
    } ]
  }, {
    "tStartMs": 96054,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Most courses are raw or served warm."
    } ]
  }, {
    "tStartMs": 98473,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "Seating is by reservation, with \nstrict start times and durations."
    } ]
  }, {
    "tStartMs": 102268,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "And every one of these shops runs\njust a handful of fixed seatings"
    } ]
  }, {
    "tStartMs": 105438,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "for dinner and rarely bother \nwith a lunch service."
    } ]
  }, {
    "tStartMs": 108316,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Unlike traditional restaurants\nwhich live or die based on location"
    } ]
  }, {
    "tStartMs": 111569,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "and foot traffic, these omakases are true\ndigital destinations."
    } ]
  }, {
    "tStartMs": 115490,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "They run out of cheap,"
    } ]
  }, {
    "tStartMs": 116491,
    "dDurationMs": 4546,
    "segs": [ {
      "utf8": "tiny, hidden spaces in backstreets,\nbasements, second floors, or alleyways."
    } ]
  }, {
    "tStartMs": 121287,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "Their kitchens have no fryers or stoves,"
    } ]
  }, {
    "tStartMs": 123331,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "and they can only seat maybe 10 to \n20 people at most at a time."
    } ]
  }, {
    "tStartMs": 127001,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "And there are only ever 1 or 2 \nservers as the chef preps,"
    } ]
  }, {
    "tStartMs": 130380,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "serves, and clears every \ncourse for each guest."
    } ]
  }, {
    "tStartMs": 133424,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "What omakases lack in"
    } ]
  }, {
    "tStartMs": 134676,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "capacity and visibility, they make \nup for in ruthless efficiency."
    } ]
  }, {
    "tStartMs": 138596,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Throw in an inherently aesthetic,\nsocial media friendly product"
    } ]
  }, {
    "tStartMs": 141766,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "and you get a future-proof"
    } ]
  }, {
    "tStartMs": 142809,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "business built for the modern age\nwith an answer for every pressure"
    } ]
  }, {
    "tStartMs": 146229,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "that breaks a normal restaurant\nlike rent, labor, marketing and margin."
    } ]
  }, {
    "tStartMs": 150441,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "In New York City, these costs \nare at their most extreme"
    } ]
  }, {
    "tStartMs": 153403,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "In a time where every category \nis stagnating,"
    } ]
  }, {
    "tStartMs": 155864,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "omakases here are booming"
    } ]
  }, {
    "tStartMs": 157490,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "with their modern, unorthodox\ndigital-first business model."
    } ]
  }, {
    "tStartMs": 161286,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Ultimately, NYC is an accelerated market,\nand what emerges here shapes the future"
    } ]
  }, {
    "tStartMs": 166166,
    "dDurationMs": 5046,
    "segs": [ {
      "utf8": "of sushi in urban America, where omakase\nmay very well become the dominant format."
    } ]
  }, {
    "tStartMs": 171462,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "To understand this market change at \na macro level, we scraped over 400,000"
    } ]
  }, {
    "tStartMs": 175508,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "sushi restaurants across six cities\nand verified each by hand"
    } ]
  }, {
    "tStartMs": 178970,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "when they opened their price \npoint, how many shut down"
    } ]
  }, {
    "tStartMs": 182432,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "and their business model to \nbuild the first accurate snapshot"
    } ]
  }, {
    "tStartMs": 185602,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "of the American sushi industry\nand to capture the micro."
    } ]
  }, {
    "tStartMs": 188855,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "We go boots on the ground \nacross New York City"
    } ]
  }, {
    "tStartMs": 191149,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "and go behind the counter\nwith three owners"
    } ]
  }, {
    "tStartMs": 193193,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "who each bet on completely different\nstrategies and price points -"
    } ]
  }, {
    "tStartMs": 196571,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "$80 for the Greenwich Village\nand Midtown millennials,"
    } ]
  }, {
    "tStartMs": 199574,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "$125 for working professionals in Soho,"
    } ]
  }, {
    "tStartMs": 202911,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and $250 for the celebrities in Tribeca,"
    } ]
  }, {
    "tStartMs": 206080,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "to discover what it really takes\nto win in the omakase business."
    } ]
  }, {
    "tStartMs": 213546,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "Mori is just 1 out of 24"
    } ]
  }, {
    "tStartMs": 215423,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "omakases in Soho, and 1 out of \n10 in a three block radius."
    } ]
  }, {
    "tStartMs": 219469,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "Upstairs, Shawn puts"
    } ]
  }, {
    "tStartMs": 220845,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "the final touches on tonight's"
    } ]
  }, {
    "tStartMs": 222055,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "service while Solomon breaks\nthe fish down in the basement."
    } ]
  }, {
    "tStartMs": 225141,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "The two owners are a clean"
    } ]
  }, {
    "tStartMs": 226434,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "example of the independent restaurateurs\nfueling the city's omakase boom."
    } ]
  }, {
    "tStartMs": 230688,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "Shawn runs the front,"
    } ]
  }, {
    "tStartMs": 232023,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Solomon commands the back, and \ntogether they divide and conquer."
    } ]
  }, {
    "tStartMs": 235610,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "With just 11 seats and a single counter,"
    } ]
  }, {
    "tStartMs": 237987,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "Mori is the quintessential modern\nNew York omakase, invisible"
    } ]
  }, {
    "tStartMs": 241866,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "from the outside - but lean, high margin\nand exceptionally efficient"
    } ]
  }, {
    "tStartMs": 245536,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "on the inside. And at $125 a head,"
    } ]
  }, {
    "tStartMs": 248748,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "they sit at the perfect midpoint\nfor the neighborhood."
    } ]
  }, {
    "tStartMs": 251376,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "This current market shift\nhas been decades in the making."
    } ]
  }, {
    "tStartMs": 254170,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "While Los Angeles was the \nbirthplace of sushi in the US,"
    } ]
  }, {
    "tStartMs": 257131,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "New York became the flashier\nand more visible proving ground"
    } ]
  }, {
    "tStartMs": 260301,
    "dDurationMs": 4922,
    "segs": [ {
      "utf8": "where the category evolved the furthest.\nFrom the 1980s to early 2000s,"
    } ]
  }, {
    "tStartMs": 265223,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "sushi in Manhattan was rarely a \nstandalone business."
    } ]
  }, {
    "tStartMs": 268518,
    "dDurationMs": 4629,
    "segs": [ {
      "utf8": "90% of the restaurants serving it were\nbroad Japanese or Asian fusion spots."
    } ]
  }, {
    "tStartMs": 273147,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Americans came for noodles, \nteriyaki or tempura,"
    } ]
  }, {
    "tStartMs": 276192,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "and sushi was just one line\nitem on the menu. For even New Yorkers,"
    } ]
  }, {
    "tStartMs": 280029,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "raw fish back then was still a hurdle."
    } ]
  }, {
    "tStartMs": 282448,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "As a result, most Japanese restaurants\nstayed generalists out of necessity,"
    } ]
  }, {
    "tStartMs": 286160,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "with sushi as a side item\nrather than as the main event."
    } ]
  }, {
    "tStartMs": 289372,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "The few that did specialize \nwere all clustered in Midtown,"
    } ]
  }, {
    "tStartMs": 292292,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "around the very skyscrapers\nwhere Japanese banks, automakers,"
    } ]
  }, {
    "tStartMs": 295753,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and conglomerates had opened \noffices in the 80s."
    } ]
  }, {
    "tStartMs": 298840,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "These early counters lowered\nthe barrier further by offering sushi"
    } ]
  }, {
    "tStartMs": 302218,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "in flexible combinations and ala carte,\nwhich in turn made them ideal venues"
    } ]
  }, {
    "tStartMs": 306472,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "for corporate dinners between \nAmerican and Japanese businessmen."
    } ]
  }, {
    "tStartMs": 310226,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "So while omakase"
    } ]
  }, {
    "tStartMs": 311394,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "remained a foreign concept, these places\npopularized sushi as a standalone meal"
    } ]
  }, {
    "tStartMs": 316024,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "and established a cultural standard\nthat still holds today."
    } ]
  }, {
    "tStartMs": 320194,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "Then, from 2004 to 2014, New York\nelevated sushi"
    } ]
  }, {
    "tStartMs": 324157,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "to unprecedented levels\nof recognition, luxury, and prestige."
    } ]
  }, {
    "tStartMs": 327994,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "The traditionally low profile, minimalist \nJapanese omakase was thrust"
    } ]
  }, {
    "tStartMs": 331914,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "into the global spotlight and rebranded\nas a glitzy, critically-acclaimed,"
    } ]
  }, {
    "tStartMs": 336127,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "fine-dining experience with record\nbreaking prices that surpassed even Japan."
    } ]
  }, {
    "tStartMs": 340923,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Over this decade, the sushi category \nwould be permanently"
    } ]
  }, {
    "tStartMs": 343843,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "fractured into extremes in pricing and format."
    } ]
  }, {
    "tStartMs": 346888,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "In 2004, Masa opened in \nMidtown and singularly"
    } ]
  }, {
    "tStartMs": 350308,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "legitimized omakase as a high-end\nformat and viable business model."
    } ]
  }, {
    "tStartMs": 354479,
    "dDurationMs": 4754,
    "segs": [ {
      "utf8": "Masa imposed standards never before seen in\nthe US with fish are shipped from Japan,"
    } ]
  }, {
    "tStartMs": 359233,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "a six-figure wood counter\nthat needed to be sanded"
    } ]
  }, {
    "tStartMs": 361527,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "daily, and no menu, no choices,\nand no a la carte."
    } ]
  }, {
    "tStartMs": 365281,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Omakase was the only option and you ate\nwhatever was set in front of you."
    } ]
  }, {
    "tStartMs": 369160,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "With just 26 chairs,"
    } ]
  }, {
    "tStartMs": 370787,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "seats needed to be booked weeks"
    } ]
  }, {
    "tStartMs": 372455,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "in advance. And at $300 per person\nbefore drinks, tax, and tip,"
    } ]
  }, {
    "tStartMs": 376834,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Masa became the single \nmost expensive restaurant,"
    } ]
  }, {
    "tStartMs": 379504,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "not just in New York,\nbut in the entire world."
    } ]
  }, {
    "tStartMs": 382048,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "It reframed omakase from a niche menu\nitem to an exclusive,"
    } ]
  }, {
    "tStartMs": 385885,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "exacting craft and pushed that this was\nthe way that sushi was meant to be eaten."
    } ]
  }, {
    "tStartMs": 390431,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "In 2009, Masa became the first sushi\nrestaurant in America to earn three"
    } ]
  }, {
    "tStartMs": 394560,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Michelin stars and would remain\nthe only one for the next decade."
    } ]
  }, {
    "tStartMs": 398523,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Today, Masa still remains\nthe single most expensive restaurant"
    } ]
  }, {
    "tStartMs": 401943,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "in the world at $950 per person."
    } ]
  }, {
    "tStartMs": 405154,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "While the rest of the country"
    } ]
  }, {
    "tStartMs": 406322,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "pushed towards accessibility, repackaging \nsushi into rolls and boxes"
    } ]
  }, {
    "tStartMs": 410201,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "at grocery stores, food courts, \nmalls and neighborhood takeout."
    } ]
  }, {
    "tStartMs": 413913,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "Masa had run in the opposite direction,\nand its success inspired others."
    } ]
  }, {
    "tStartMs": 418334,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Morimoto brought his starpower from Nobu and\nIron Chef to open a 200-seat"
    } ]
  }, {
    "tStartMs": 422338,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "restaurant in Manhattan, further\ncementing New York City"
    } ]
  }, {
    "tStartMs": 425425,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "as a destination for top tier sushi,\nwhether traditional or fusion."
    } ]
  }, {
    "tStartMs": 429679,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "Then, in 2011, the acclaimed \"Jiro\nDreams of Sushi\" captivated Americans,"
    } ]
  }, {
    "tStartMs": 433850,
    "dDurationMs": 4337,
    "segs": [ {
      "utf8": "further chronicling the life of an 85-year\nold three Michelin star Tokyo"
    } ]
  }, {
    "tStartMs": 438187,
    "dDurationMs": 4838,
    "segs": [ {
      "utf8": "sushi master and established omakase in\nthe public eye as a fine-dining experience"
    } ]
  }, {
    "tStartMs": 443025,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "defined by the chef behind the counter.\nRiding the documentary's momentum,"
    } ]
  }, {
    "tStartMs": 447113,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "Sushi Nakazawa opened in 2013 and where\nMasa had broken the sushi market upward,"
    } ]
  }, {
    "tStartMs": 452285,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "Nakazawa broke it downward \nwith a 21 course omakase"
    } ]
  }, {
    "tStartMs": 455746,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "from Jiro's own apprentice at \njust $150 per person."
    } ]
  }, {
    "tStartMs": 459292,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "Nakazawa disrupted the high-end market\nby proving that world-class"
    } ]
  }, {
    "tStartMs": 463087,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "sushi could be delivered at scale\nand at a fraction of the cost."
    } ]
  }, {
    "tStartMs": 466883,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "It legitimized omakase\nas a mass market business,"
    } ]
  }, {
    "tStartMs": 469802,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "where meals could be quarterly rather\nthan a once in a lifetime experience."
    } ]
  }, {
    "tStartMs": 473598,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "With 35 seats and multiple turns, Nakazawa\nserved close to 100 people every night,"
    } ]
  }, {
    "tStartMs": 478561,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "achieving volume and margin\nat a far lower price. With Masa"
    } ]
  }, {
    "tStartMs": 482356,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "as the ceiling and Nakazawa as the floor,"
    } ]
  }, {
    "tStartMs": 484609,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "high-end omakases began opening"
    } ]
  }, {
    "tStartMs": 486486,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "across the city and pricing themselves\nin between these two giants."
    } ]
  }, {
    "tStartMs": 490364,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "By 2015, New York City"
    } ]
  }, {
    "tStartMs": 492200,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "had nearly twice as many sushi restaurants\nas it had two decades earlier."
    } ]
  }, {
    "tStartMs": 496162,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "There were now 12 of these omakase\nonly spots in NYC, but they were still"
    } ]
  }, {
    "tStartMs": 500208,
    "dDurationMs": 4462,
    "segs": [ {
      "utf8": "a market minority, accounting for less\nthan 10% of the city's sushi restaurants."
    } ]
  }, {
    "tStartMs": 504712,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "The imitators tried to replicate Masa's\nplaybook, but without his Michelin stars,"
    } ]
  }, {
    "tStartMs": 508925,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "brandpower,"
    } ]
  }, {
    "tStartMs": 509759,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "or backing, there wasn't enough wealth\nat the top to keep everyone alive."
    } ]
  }, {
    "tStartMs": 513554,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "50% of all omakase that opened in\nthis era would shut down."
    } ]
  }, {
    "tStartMs": 517850,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Meanwhile, only 8% of the \nnon-omakase sushi restaurants"
    } ]
  }, {
    "tStartMs": 521103,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "closed as they survived on volume,\naccessibility, and value -"
    } ]
  }, {
    "tStartMs": 524982,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "just as a very different wave\nwas about to hit."
    } ]
  }, {
    "tStartMs": 527860,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "It was in this era when Shawn \nand Solomon entered the market."
    } ]
  }, {
    "tStartMs": 531197,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "Shawn worked his way up at Morimoto,\nTao, Momofuku, and Catch,"
    } ]
  }, {
    "tStartMs": 535451,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "which were all local powerhouses\nriding the same raw fish boom."
    } ]
  }, {
    "tStartMs": 539163,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Tao made sushi the centerpiece \nof a nightclub"
    } ]
  }, {
    "tStartMs": 541707,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "and Catch priced it like steak."
    } ]
  }, {
    "tStartMs": 543668,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "It was at Catch that Shawn met Solomon,\nand over the next ten years, the two"
    } ]
  }, {
    "tStartMs": 547588,
    "dDurationMs": 4964,
    "segs": [ {
      "utf8": "friends pooled funds and honed ideas\nuntil they finally opened Mori in 2024."
    } ]
  }, {
    "tStartMs": 552760,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "But the market today looks nothing \nlike the one they entered."
    } ]
  }, {
    "tStartMs": 555555,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "There are now six times as many \nomakase as there were in 2014."
    } ]
  }, {
    "tStartMs": 559308,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "And it's not just the density\nthat's changed, but also the price."
    } ]
  }, {
    "tStartMs": 562478,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Nakazawa at $150 was a \nhuge shock back in 2013."
    } ]
  }, {
    "tStartMs": 566649,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "The average cost of an omakase \nin New York City has drifted"
    } ]
  }, {
    "tStartMs": 569944,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "below that floor, despite over a \ndecade of inflation."
    } ]
  }, {
    "tStartMs": 619118,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Mori's product-market fit \ncomes from breaking away"
    } ]
  }, {
    "tStartMs": 621579,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "from the tradition that everyone else\nstill clings to in this saturated market."
    } ]
  }, {
    "tStartMs": 625291,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "When every omakase claims\nthat they use the freshest fish"
    } ]
  }, {
    "tStartMs": 628252,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and the most traditional methods,\nnone of it means anything."
    } ]
  }, {
    "tStartMs": 631464,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "Even though Solomon has been a sushi chef\nfor 12 years and Shawn in the business"
    } ]
  }, {
    "tStartMs": 635426,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "for 10,"
    } ]
  }, {
    "tStartMs": 636052,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "neither carries the pedigree and ethnicity\nrequired for the top of the market."
    } ]
  }, {
    "tStartMs": 640348,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "Solomon is Indonesian-Chinese\nand Sean is Taiwanese."
    } ]
  }, {
    "tStartMs": 643976,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Neither trained in Japan or apprenticed \nunder a famous shokunin."
    } ]
  }, {
    "tStartMs": 647396,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Rather than competing on frontiers\nthat they would never win,"
    } ]
  }, {
    "tStartMs": 649857,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "the pair have chosen to trade away"
    } ]
  }, {
    "tStartMs": 651317,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "the lineage and luxury arms race\nfor return to basics."
    } ]
  }, {
    "tStartMs": 654695,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "They've turned their lack of pedigree\ninto a creative license to do things"
    } ]
  }, {
    "tStartMs": 657990,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "with product and space that no \ntraditional omakase ever could."
    } ]
  }, {
    "tStartMs": 740573,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "That's why no one's name is on Mori -"
    } ]
  }, {
    "tStartMs": 742491,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "not Shawn's, not Solomon's, not anyone's.\nFreed from the authenticity contest,"
    } ]
  }, {
    "tStartMs": 747079,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "they treat tradition as a guide,\nbut not an obligation."
    } ]
  }, {
    "tStartMs": 749915,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "By stripping away"
    } ]
  }, {
    "tStartMs": 750791,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "everything that makes high-end omakase\nintimidating, Mori widens the door."
    } ]
  }, {
    "tStartMs": 755212,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "The format stays intact."
    } ]
  }, {
    "tStartMs": 756964,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Every course is still served by \nhand to every guest,"
    } ]
  }, {
    "tStartMs": 759842,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "but the chef is not meant to be revered."
    } ]
  }, {
    "tStartMs": 761927,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Their assembly is not the entire show,\nand the meal is not a mandatory"
    } ]
  }, {
    "tStartMs": 765514,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "performance to sit through in \nsilence. The show is the food"
    } ]
  }, {
    "tStartMs": 769018,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "and the guests, rather than who\nor what is behind the counter."
    } ]
  }, {
    "tStartMs": 772480,
    "dDurationMs": 5338,
    "segs": [ {
      "utf8": "Mori's space is tiny, with just 400ft²\nupstairs and another 400 in the basement."
    } ]
  }, {
    "tStartMs": 777818,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "Their entire operation\nis smaller than a Subway."
    } ]
  }, {
    "tStartMs": 780654,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "A footprint this small is \nunusable for most businesses"
    } ]
  }, {
    "tStartMs": 783532,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "as a normal restaurant would have to\nchoose between seats or working kitchen."
    } ]
  }, {
    "tStartMs": 787536,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "There's just no room for both.\nWithout seats and dine-in traffic,"
    } ]
  }, {
    "tStartMs": 791165,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "a space like this is really only \nusable by high turnover,"
    } ]
  }, {
    "tStartMs": 794376,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "grab-and-go concepts,"
    } ]
  }, {
    "tStartMs": 795544,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "like ice cream shops, bakeries, coffee\nwindows or pizza counters."
    } ]
  }, {
    "tStartMs": 799632,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "Yet omakase erases this tradeoff entirely\nbecause all the food is prepped"
    } ]
  }, {
    "tStartMs": 803677,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "and portioned downstairs."
    } ]
  }, {
    "tStartMs": 804970,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "The upstairs"
    } ]
  }, {
    "tStartMs": 805679,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "doesn't need a working kitchen.  Just\na few under-counter fridges, some warmers,"
    } ]
  }, {
    "tStartMs": 809558,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "standing space for each chef,\nand the restaurant is set for service."
    } ]
  }, {
    "tStartMs": 813646,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "The ability to maximize sales \nin spaces that almost"
    } ]
  }, {
    "tStartMs": 816857,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "no other tenant can is\nhow omakase is fundamentally thrive."
    } ]
  }, {
    "tStartMs": 820820,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "Mori pays just $7,500 a month \nfor rent and at $112"
    } ]
  }, {
    "tStartMs": 825533,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "a square foot, that's 75% cheaper \nthan the Soho average."
    } ]
  }, {
    "tStartMs": 829537,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "They're in a prime neighborhood\nat a quarter of the going rate. With"
    } ]
  }, {
    "tStartMs": 833207,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "advance bookings, omakase get to control\nfood and labor costs in ways"
    } ]
  }, {
    "tStartMs": 837586,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "that most restaurants can without having\nto sacrifice product or service."
    } ]
  }, {
    "tStartMs": 841715,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "Because the room is sold by \nreservation, Mori knows its revenue"
    } ]
  }, {
    "tStartMs": 845094,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "before the night begins and before the \nfirst guest ever sits down."
    } ]
  }, {
    "tStartMs": 848556,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "In contrast, traditional \nrestaurants fly blind."
    } ]
  }, {
    "tStartMs": 851350,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "They don't know how many people \nwill come, what they'll order,"
    } ]
  }, {
    "tStartMs": 853978,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "or how much they'll spend\nuntil the night is over"
    } ]
  }, {
    "tStartMs": 856272,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "so they must staff and prep for \na crowd that may never show."
    } ]
  }, {
    "tStartMs": 859400,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Omakases like Mori are the opposite."
    } ]
  }, {
    "tStartMs": 861694,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "They scale their teams\nand prep work up or down"
    } ]
  }, {
    "tStartMs": 864196,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "to match the guests that are on the books."
    } ]
  }, {
    "tStartMs": 866490,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "If the 5:30 is fully booked like it is\ntoday, it's all hands on deck."
    } ]
  }, {
    "tStartMs": 870119,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "If the 7:30 comes in light,\nthe staff thins out,"
    } ]
  }, {
    "tStartMs": 872830,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and if the 9:30 is empty,\neveryone goes home early."
    } ]
  }, {
    "tStartMs": 876417,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "In contrast, a traditional restaurant\nhas a stock, a full pantry"
    } ]
  }, {
    "tStartMs": 879003,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "and take the loss on whatever \nthey don't sell in time."
    } ]
  }, {
    "tStartMs": 881881,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "An omakase flips this conundrum\nas the menu bends to the inventory,"
    } ]
  }, {
    "tStartMs": 885634,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "rather than the other way around."
    } ]
  }, {
    "tStartMs": 887386,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "If Mori has too much of one \ningredient, too little of another,"
    } ]
  }, {
    "tStartMs": 890973,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "or gets a special deal from its suppliers\non something else, it can rework"
    } ]
  }, {
    "tStartMs": 894727,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "its courses up to the day off\nto maximize inventory and margins"
    } ]
  }, {
    "tStartMs": 898355,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "without the guest ever knowing."
    } ]
  }, {
    "tStartMs": 899773,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "Predictability enables precision,"
    } ]
  }, {
    "tStartMs": 901817,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "precision enables efficiency, and \nefficiency enables profit"
    } ]
  }, {
    "tStartMs": 956830,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "Yet the greatest advantage \nbehind the omakase"
    } ]
  }, {
    "tStartMs": 959041,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "business model is not labor or \nproduct, but instead build out."
    } ]
  }, {
    "tStartMs": 962670,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "Starting an omakase"
    } ]
  }, {
    "tStartMs": 964046,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "is orders of magnitude cheaper\nthan virtually any other restaurant,"
    } ]
  }, {
    "tStartMs": 967508,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "and this low bar is the real engine\nbehind the rapid saturation across"
    } ]
  }, {
    "tStartMs": 971470,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "New York City."
    } ]
  }, {
    "tStartMs": 972471,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "Any restaurant that uses a gas range \nfryer or an open flame"
    } ]
  }, {
    "tStartMs": 976183,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "legally needs a Type I hood \nbefore it can open in Manhattan."
    } ]
  }, {
    "tStartMs": 979812,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "The single requirement cost\nsix figures alone."
    } ]
  }, {
    "tStartMs": 982564,
    "dDurationMs": 543,
    "segs": [ {
      "utf8": "It involves"
    } ]
  }, {
    "tStartMs": 983107,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "steel ductwork"
    } ]
  }, {
    "tStartMs": 983857,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "punched through multiple stories\nof century old brick, fire sprinkler"
    } ]
  }, {
    "tStartMs": 987069,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "systems, and months of permitting omakase\nget to bypass all this regulation."
    } ]
  }, {
    "tStartMs": 991782,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "They have no fryers, no stoves, \nno flames and no gas lines."
    } ]
  }, {
    "tStartMs": 995285,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Everything is steamed."
    } ]
  }, {
    "tStartMs": 996495,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "The blowtorches count as handheld \ntools, not appliances."
    } ]
  }, {
    "tStartMs": 999665,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "And with under a dozen seats, Morris\nstays below the occupancy thresholds"
    } ]
  }, {
    "tStartMs": 1003669,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "that would otherwise"
    } ]
  }, {
    "tStartMs": 1004420,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "require them to have multiple fire exits\nand separate ADA bathrooms."
    } ]
  }, {
    "tStartMs": 1008757,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Under this lens, omakases \nare regulatory arbitrage."
    } ]
  }, {
    "tStartMs": 1012302,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "They don't just make better use\nof small spaces,"
    } ]
  }, {
    "tStartMs": 1014638,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "they get to operate in spaces\nthat no other restaurant can."
    } ]
  }, {
    "tStartMs": 1018183,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "The rules that cost everyone else"
    } ]
  }, {
    "tStartMs": 1019768,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "hundreds of thousands of dollars\nand months of buildout don't apply."
    } ]
  }, {
    "tStartMs": 1023522,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "Mori pushes efficiency even further\nby slicing the fish down stairs"
    } ]
  }, {
    "tStartMs": 1027276,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "before service, so courses can \ncome out on time with fewer hands."
    } ]
  }, {
    "tStartMs": 1031196,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "Mori's success in two years and 400ft²\ncomes from being what the market isn't."
    } ]
  }, {
    "tStartMs": 1035909,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "They're not bound to authenticity,\nbut they're also not trying to escape it"
    } ]
  }, {
    "tStartMs": 1039121,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "either."
    } ]
  }, {
    "tStartMs": 1039621,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "The concept is loose enough\nto feel like a night out,"
    } ]
  }, {
    "tStartMs": 1042124,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "yet rigorous enough to still deliver\nthe fixed price, multi-course experience"
    } ]
  }, {
    "tStartMs": 1046253,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "that people expect from the word omakase."
    } ]
  }, {
    "tStartMs": 1095594,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Mori grosses on average $84,000"
    } ]
  }, {
    "tStartMs": 1098138,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "a month for an annual run rate \nof $1.01 million."
    } ]
  }, {
    "tStartMs": 1102226,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "They're operating margin sits at 22%.\nWith the ownership split,"
    } ]
  }, {
    "tStartMs": 1106271,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "Solomon and Shawn are likely taking home\nno more than five figures each every year."
    } ]
  }, {
    "tStartMs": 1111068,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "But being in the black so early on \nis an achievement in itself,"
    } ]
  }, {
    "tStartMs": 1114613,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "especially for first time restaurateurs."
    } ]
  }, {
    "tStartMs": 1117783,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Shawn and Solomon are ultimately\nnot the only ones with this perspective."
    } ]
  }, {
    "tStartMs": 1121286,
    "dDurationMs": 5381,
    "segs": [ {
      "utf8": "1 in 3 omakases in the city today\nfall in this 100 to $200 price range."
    } ]
  }, {
    "tStartMs": 1126875,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Yet the market looks very \ndifferent for those"
    } ]
  }, {
    "tStartMs": 1128877,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "at the top where the \npressure is the greatest."
    } ]
  }, {
    "tStartMs": 1131296,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "A Masa or Morimoto can charge whatever it wants"
    } ]
  }, {
    "tStartMs": 1134216,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "and still fill every seat by name alone."
    } ]
  }, {
    "tStartMs": 1136552,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "Yet those without that acclaim and fame can't."
    } ]
  }, {
    "tStartMs": 1139179,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "It's increasingly harder for premium\nomakase to justify their higher prices"
    } ]
  }, {
    "tStartMs": 1143559,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "and to prove what they actually do\nbetter than the flood of cheaper,"
    } ]
  }, {
    "tStartMs": 1146603,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "less rigorous, and less sophisticated \noptions below them."
    } ]
  }, {
    "tStartMs": 1149857,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "For owners who have committed years\nof their lives to this craft,"
    } ]
  }, {
    "tStartMs": 1152860,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "their outlook is far less optimistic."
    } ]
  }, {
    "tStartMs": 1155195,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "This is the world that Jay sees\nas the owner and taisho of Tsubame,"
    } ]
  }, {
    "tStartMs": 1158490,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "a $250 omakase in Tribeca\nthat has served"
    } ]
  }, {
    "tStartMs": 1162578,
    "dDurationMs": 4337,
    "segs": [ {
      "utf8": "world-class athletes, celebrities\nand movie stars for the past three years."
    } ]
  }, {
    "tStartMs": 1169585,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Every case study on Modern MBA\nstarts from the same place - "
    } ]
  }, {
    "tStartMs": 1173172,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "hard data and fact"
    } ]
  }, {
    "tStartMs": 1174423,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "finding across dozens of spreadsheets,\nfinancials, and transcripts."
    } ]
  }, {
    "tStartMs": 1178177,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "We've been openly skeptical of \nAI and refuse"
    } ]
  }, {
    "tStartMs": 1180679,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "to let it do any of our analysis, \nwriting, and thinking."
    } ]
  }, {
    "tStartMs": 1183891,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "We let our own crunching and instinct"
    } ]
  }, {
    "tStartMs": 1185601,
    "dDurationMs": 3878,
    "segs": [ {
      "utf8": "to develop original, grounded,\nand intellectually rigorous thesis."
    } ]
  }, {
    "tStartMs": 1189646,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "That's why we've kept every AI tool\nat arm's length until now."
    } ]
  }, {
    "tStartMs": 1192983,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Where we struggle is ingesting \nmountains of data"
    } ]
  }, {
    "tStartMs": 1195652,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "and synthesizing the insight\nand complexity to a broad audience."
    } ]
  }, {
    "tStartMs": 1199489,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "It takes hours to find what matters \nbefore we've written a line."
    } ]
  }, {
    "tStartMs": 1202910,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "That's where today's sponsor,\nSuperhuman, comes in."
    } ]
  }, {
    "tStartMs": 1205621,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Superhuman, from the makers of Grammarly,\nis more than just an AI chat bot."
    } ]
  }, {
    "tStartMs": 1209750,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "It's your AI partner that works \ninside the apps and websites"
    } ]
  }, {
    "tStartMs": 1212711,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "you already use, proactively\nmaking suggestions to improve your work."
    } ]
  }, {
    "tStartMs": 1216798,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "Let us show you."
    } ]
  }, {
    "tStartMs": 1217674,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "First, we turn on Superhuman\nwithin our Grammarly browser extension."
    } ]
  }, {
    "tStartMs": 1221220,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Once it's on, it reads\nwhatever page we're working on."
    } ]
  }, {
    "tStartMs": 1223764,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "With a 10-K open,"
    } ]
  }, {
    "tStartMs": 1225015,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "we can ask it to summarize the page\nor pull the takeaways and get oriented"
    } ]
  }, {
    "tStartMs": 1228894,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "in these hundreds of pages in seconds."
    } ]
  }, {
    "tStartMs": 1230687,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Instead of skimming for 20 minutes,\nwe can ask what it says about something"
    } ]
  }, {
    "tStartMs": 1234274,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "specific, like CEO remarks,\nand it surfaces exactly that"
    } ]
  }, {
    "tStartMs": 1237903,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "and we still get to dive in\nand verify every detail ourselves."
    } ]
  }, {
    "tStartMs": 1241406,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "What won us over is that it's \nright there inside the page,"
    } ]
  }, {
    "tStartMs": 1244451,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "not in a separate chatbot that we have to\ncopy, prompt, and paste back from."
    } ]
  }, {
    "tStartMs": 1249081,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Superhuman shows up\nwhere the work already is."
    } ]
  }, {
    "tStartMs": 1251750,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "Another agent that blew us away \nis Reader Reactions."
    } ]
  }, {
    "tStartMs": 1254878,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "It predicts the takeaways, questions,\nand points of confusion that"
    } ]
  }, {
    "tStartMs": 1258131,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "a reader may have with what we've written,\nand suggest revisions to make it land."
    } ]
  }, {
    "tStartMs": 1262261,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "It shows where a reader might get \nlost or push back,"
    } ]
  }, {
    "tStartMs": 1264888,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "and it's all suggestive and advisory\nwhere nothing gets pasted in blind."
    } ]
  }, {
    "tStartMs": 1268767,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Try Superhuman, from the makers of Grammarly"
    } ]
  }, {
    "tStartMs": 1271144,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "using our link in the description\nor by scanning the QR code above."
    } ]
  }, {
    "tStartMs": 1274773,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Thank you to Superhuman for supporting Modern MBA \nand making this episode possible."
    } ]
  }, {
    "tStartMs": 1304386,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "Like the omakases in Japan, \nTsubame is a one man show."
    } ]
  }, {
    "tStartMs": 1308473,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "Jay designs the menu, picks the \ningredients, preps"
    } ]
  }, {
    "tStartMs": 1311601,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "every course, slices every fish,\nand serves every guest by hand."
    } ]
  }, {
    "tStartMs": 1315897,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "He's worked in restaurants for 30 years,\nhas run 3 omakases in New York City"
    } ]
  }, {
    "tStartMs": 1319818,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "for the last 10, and has seen this\nmarket change dramatically in the past"
    } ]
  }, {
    "tStartMs": 1323488,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "five. Tsubame's menu runs deep in \nseasonality and luxury, with starter courses"
    } ]
  }, {
    "tStartMs": 1328160,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "made from red king crab and \nHokkaido Uni to soup made"
    } ]
  }, {
    "tStartMs": 1331288,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "from matsusake, one of the world's\nmost expensive mushrooms"
    } ]
  }, {
    "tStartMs": 1334374,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "only available in the fall."
    } ]
  }, {
    "tStartMs": 1336084,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "Yet for Jay, luxury doesn't make an omakase."
    } ]
  }, {
    "tStartMs": 1338879,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Anyone can buy expensive ingredients."
    } ]
  }, {
    "tStartMs": 1341048,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "What matters is what the chef does"
    } ]
  }, {
    "tStartMs": 1342924,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "with them to make them more\nthan just expensive fish on rice."
    } ]
  }, {
    "tStartMs": 1346345,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "At Tsubame, he pushes new ideas \nand fuses history"
    } ]
  }, {
    "tStartMs": 1349431,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "with cuisine, but never strays far from tradition."
    } ]
  }, {
    "tStartMs": 1473054,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Tsubame is Jay's third omakase, and while it's"
    } ]
  }, {
    "tStartMs": 1475765,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "serious, traditional and high-end,\nhe didn't start out that way."
    } ]
  }, {
    "tStartMs": 1479352,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "From 2015 to 2019,\na cohort of American-led concepts"
    } ]
  }, {
    "tStartMs": 1483398,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "took the Nakazawa formula and pushed\nit even further, bringing down price,"
    } ]
  }, {
    "tStartMs": 1487652,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "catering to the mass market directly,\nand disrupting the high-end omakases"
    } ]
  }, {
    "tStartMs": 1491823,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "above them."
    } ]
  }, {
    "tStartMs": 1492532,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Jay's restaurant was one of \nthese at the time."
    } ]
  }, {
    "tStartMs": 1495202,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "Sushi in New York was effectively split\nbetween the $300 plus Michelin starred"
    } ]
  }, {
    "tStartMs": 1499289,
    "dDurationMs": 5297,
    "segs": [ {
      "utf8": "omakase and the $15 neighborhood takeout\nwith Nakazawa as the medium in between."
    } ]
  }, {
    "tStartMs": 1504586,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "The two biggest names in this new era\nattacked the market from an even lower"
    } ]
  }, {
    "tStartMs": 1508381,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "price point."
    } ]
  }, {
    "tStartMs": 1509257,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "Sugarfish was born out of \nthe legendary LA"
    } ]
  }, {
    "tStartMs": 1511635,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "sushi bar, Sushi Nozawa where\nJapan-born"
    } ]
  }, {
    "tStartMs": 1514012,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "and Japan-trained Kazunori \nNozawa imposed strict"
    } ]
  }, {
    "tStartMs": 1517057,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "rules on a Hollywood elites\nlike no phones and no loud talking."
    } ]
  }, {
    "tStartMs": 1520936,
    "dDurationMs": 4337,
    "segs": [ {
      "utf8": "Sugar fish was his fast-casual spinoff\nwhere he repackaged the same precision"
    } ]
  }, {
    "tStartMs": 1525273,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "of his acclaimed sushi into $40\nand $60 set menus for dine in and takeout."
    } ]
  }, {
    "tStartMs": 1529986,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "Sugarfish reached Manhattan in 2016"
    } ]
  }, {
    "tStartMs": 1532822,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "and while it wasn't an omakase,\nit proved you could scale the philosophy"
    } ]
  }, {
    "tStartMs": 1536493,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "and rigor of one for the masses\nat a fraction of the cost of Nakazawa."
    } ]
  }, {
    "tStartMs": 1540705,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "Then there was Sushi on Jones,\nDavid Bouhadana's tiny stand in the Bowery."
    } ]
  }, {
    "tStartMs": 1544793,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "As a self-taught American chef,"
    } ]
  }, {
    "tStartMs": 1546586,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "he served a 30 minute, 12-piece\nomakase with uni and wagyu"
    } ]
  }, {
    "tStartMs": 1550298,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "for just $50 per person.\nWith only four seats"
    } ]
  }, {
    "tStartMs": 1553426,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "and a strict 30 minute seating,\nSushi on Jones cranked through guests."
    } ]
  }, {
    "tStartMs": 1557180,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "Between them, they redefined what omakase\ncould cost and how fast it could move."
    } ]
  }, {
    "tStartMs": 1561851,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "But most importantly, they \nproved that great sushi didn't"
    } ]
  }, {
    "tStartMs": 1564646,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "have to be expensive or be prepared\nby classically trained Japanese master."
    } ]
  }, {
    "tStartMs": 1568858,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "It could come from an outsider."
    } ]
  }, {
    "tStartMs": 1570610,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "Jay opened his first omakase\nin 2015, a year before Sugarfish"
    } ]
  }, {
    "tStartMs": 1574489,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "and Sushi on Jones."
    } ]
  }, {
    "tStartMs": 1576283,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "He leaned into his status\nas an outsider, naming it Gaijin"
    } ]
  }, {
    "tStartMs": 1579452,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "as neither he nor his sushi partner\nwere classically trained."
    } ]
  }, {
    "tStartMs": 1582914,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "Queens was a safe proving ground\nas a borough with no other omakase."
    } ]
  }, {
    "tStartMs": 1587294,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "They could hone their craft without \ngoing head to head with the Japanese"
    } ]
  }, {
    "tStartMs": 1590380,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "in Manhattan."
    } ]
  }, {
    "tStartMs": 1591381,
    "dDurationMs": 5464,
    "segs": [ {
      "utf8": "Jay priced his omakase at the tiers\na $45, $65, and $125"
    } ]
  }, {
    "tStartMs": 1596845,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "to make up for the location and leaned\ninto fusion to sidestep authenticity."
    } ]
  }, {
    "tStartMs": 1601224,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "The two of them served creative pieces\nlike hamachi with banana pepper or smoked"
    } ]
  }, {
    "tStartMs": 1605186,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "almonds on tuna to compete \non value and vibes."
    } ]
  }, {
    "tStartMs": 1608189,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "Under this lens, Jay in 2015 was \nessentially running Mori's"
    } ]
  }, {
    "tStartMs": 1611901,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "playbook before Mori existed\nand at the exact same price point."
    } ]
  }, {
    "tStartMs": 1615780,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "He was one of the pioneers\nwho proved the model and helped spark"
    } ]
  }, {
    "tStartMs": 1618742,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "the wave of affordable omakase\nthat saturate the city today."
    } ]
  }, {
    "tStartMs": 1622245,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "But Gaijin's success\ndidn't last as a partnership."
    } ]
  }, {
    "tStartMs": 1625123,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "When his friend left to pursue\nhis own ventures,"
    } ]
  }, {
    "tStartMs": 1627459,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "Jay refocused on his fine dining roots, \nmaturing away from toppings"
    } ]
  }, {
    "tStartMs": 1631421,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and gimmicks and towards\nquality, technique, and tradition."
    } ]
  }, {
    "tStartMs": 1634591,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "He rebranded Gaijin"
    } ]
  }, {
    "tStartMs": 1635800,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "as Koyo in 2019, but months later,\nthe pandemic had shut everything down."
    } ]
  }, {
    "tStartMs": 1640347,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "The success of Sugarfish,\nSushi on Jones, Gaijin,"
    } ]
  }, {
    "tStartMs": 1643516,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "and other cheap local landmarks\npaved the way for the present day boom."
    } ]
  }, {
    "tStartMs": 1647437,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "The investors and sushi chefs\nworking inside all these concepts"
    } ]
  }, {
    "tStartMs": 1650565,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "all arrived at the same conclusion.\nA lower-end omakase wasn't just a safer"
    } ]
  }, {
    "tStartMs": 1654694,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "bet than a higher-end"
    } ]
  }, {
    "tStartMs": 1655612,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "one, but also far more lucrative\nthan a conventional sushi restaurant."
    } ]
  }, {
    "tStartMs": 1659282,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "In just five years, Manhattan has \nadded around 120"
    } ]
  }, {
    "tStartMs": 1662619,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "new omakases, nearly five times\nthe number of the era before."
    } ]
  }, {
    "tStartMs": 1666665,
    "dDurationMs": 4295,
    "segs": [ {
      "utf8": "Omakases today make up nearly\nhalf of all sushi restaurants in the city."
    } ]
  }, {
    "tStartMs": 1671294,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "This rapid saturation"
    } ]
  }, {
    "tStartMs": 1672712,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "has led to commoditization,\nas the median price of omakase have fallen"
    } ]
  }, {
    "tStartMs": 1676758,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "even further to $100 as cheap omakases\nflooded the market during COVID."
    } ]
  }, {
    "tStartMs": 1681763,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "Jay chose to spend the next five years\nstudying, developing and training,"
    } ]
  }, {
    "tStartMs": 1685517,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "and he watched as the affordable format"
    } ]
  }, {
    "tStartMs": 1687519,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "that he had helped pioneer get \ncheapened into unrecognizable lows."
    } ]
  }, {
    "tStartMs": 1691314,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Many of these new low-end spots\nhave jumped the shark with offerings"
    } ]
  }, {
    "tStartMs": 1694567,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "like all you can eat, bottomless\nsake, buy one get one free,"
    } ]
  }, {
    "tStartMs": 1698530,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "unlimited wagyu or salmon nigiri - \nall still billed and sold as omakase"
    } ]
  }, {
    "tStartMs": 1703076,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "for $50, $60, $70 and where \nthe draw is eating"
    } ]
  }, {
    "tStartMs": 1706871,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "as much as you can in one \nsitting.  In form and volume,"
    } ]
  }, {
    "tStartMs": 1709958,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "they have nothing to do with what"
    } ]
  }, {
    "tStartMs": 1711126,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "omakase means in word and tradition, \nyet still sell themselves as one"
    } ]
  }, {
    "tStartMs": 1715130,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "under the guise of approachability -\nand the market laps it up."
    } ]
  }, {
    "tStartMs": 1718967,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "Today, 4 out of every 5\nomakases cost under $200,"
    } ]
  }, {
    "tStartMs": 1723012,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "and they outnumber the high-end \ncohort by over 3 to 1."
    } ]
  }, {
    "tStartMs": 1726307,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "Jay had built his career at the low-end,"
    } ]
  }, {
    "tStartMs": 1728184,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "but never expected it to become \nthe default in Manhattan."
    } ]
  }, {
    "tStartMs": 1731271,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "If we look at the failure rates of all\nomakases ever opened in New York City,"
    } ]
  }, {
    "tStartMs": 1735108,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "less than 5% of the spots under $100\nhave shut down."
    } ]
  }, {
    "tStartMs": 1738528,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "The next tier up hovers at 10%,\nbut if we keep going up, the closure"
    } ]
  }, {
    "tStartMs": 1742449,
    "dDurationMs": 5588,
    "segs": [ {
      "utf8": "rates climb until we reach the $200 to $300\nrange, where more than 1 in 5 shut down."
    } ]
  }, {
    "tStartMs": 1748163,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "These omakases carry the intensive labor\nand premium ingredients of the elite,"
    } ]
  }, {
    "tStartMs": 1752333,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "but without the critical acclaim,\nthey're easily undercut"
    } ]
  }, {
    "tStartMs": 1755044,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "by new competition, who claim to \noffer the same for much less."
    } ]
  }, {
    "tStartMs": 1758256,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "And they're also not famous enough\nto win over the connoisseurs."
    } ]
  }, {
    "tStartMs": 1761426,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "This is the price range of where\nTsubame lives. At $250, ten seats,"
    } ]
  }, {
    "tStartMs": 1766431,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "and no Michelin star,\nJay operates at the single most"
    } ]
  }, {
    "tStartMs": 1769392,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "dangerous price point in the city,\nand he feels it every day."
    } ]
  }, {
    "tStartMs": 1849889,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "As a result, while everyone else rates\ndown, Jay grew up."
    } ]
  }, {
    "tStartMs": 1853309,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "Today, now 40 years old,\nhe's traded gimmicks for restraint,"
    } ]
  }, {
    "tStartMs": 1856813,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "novelty for technique, and shortcuts\nfor mastery - "
    } ]
  }, {
    "tStartMs": 1859983,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "going deep into the history and discipline"
    } ]
  }, {
    "tStartMs": 1862193,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "that he had once skipped over\nas an improvisational outsider."
    } ]
  }, {
    "tStartMs": 1865655,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "He had also learned something\nabout partners. From Chicago to Gaijin,"
    } ]
  }, {
    "tStartMs": 1869576,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "every shared venture he had was \na negotiation split two ways."
    } ]
  }, {
    "tStartMs": 1873288,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "Tsubame is the opposite"
    } ]
  }, {
    "tStartMs": 1874873,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "as Jay's first fully-owned\nand operated restaurant"
    } ]
  }, {
    "tStartMs": 1877834,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "where every decision, investment,\nstandard, and detail runs through him -"
    } ]
  }, {
    "tStartMs": 1881796,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "not out of ego, but as a full expression\nof his skill and vision."
    } ]
  }, {
    "tStartMs": 1885508,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "He chose to build it in Tribeca, the most\nexpensive neighborhood in New York."
    } ]
  }, {
    "tStartMs": 1889512,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "He converted this abandoned"
    } ]
  }, {
    "tStartMs": 1890680,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "jewelry store across the Four Seasons\ninto this 10-seat counter, and Tribeca"
    } ]
  }, {
    "tStartMs": 1894976,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "is one of the last corners of the city\nthat he believes still values omakase"
    } ]
  }, {
    "tStartMs": 1899188,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "as a craft, rather than a routine\nto be rushed and diluted."
    } ]
  }, {
    "tStartMs": 1936893,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "Tsubame grosses on average"
    } ]
  }, {
    "tStartMs": 1938561,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "$90,000 a month for an \nannual run rate of $1.1"
    } ]
  }, {
    "tStartMs": 1942398,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "million, while Mori runs\nthree seatings a night at two hours each."
    } ]
  }, {
    "tStartMs": 1946569,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Jay only runs two seatings at \n2.5 hours apiece."
    } ]
  }, {
    "tStartMs": 1949948,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "His courses aren't entirely\npre-plated and assembled like Mori's,"
    } ]
  }, {
    "tStartMs": 1953493,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "but instead cooked to order. \nAt $250 a head,"
    } ]
  }, {
    "tStartMs": 1957121,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "no guest wants to feel rushed,\nand Jay physically can't add a third"
    } ]
  }, {
    "tStartMs": 1960583,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "seating without the fatigue\nshowing in his staff and food."
    } ]
  }, {
    "tStartMs": 1963670,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Tsubame's operating margin sits at 15%,"
    } ]
  }, {
    "tStartMs": 1966464,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "and would likely be even lower\nif Jay ever paid himself an hourly wage."
    } ]
  }, {
    "tStartMs": 1970635,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "His ingredient and payroll \ncosts are higher simply"
    } ]
  }, {
    "tStartMs": 1973179,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "because the staff are all season\nfine-dining professionals."
    } ]
  }, {
    "tStartMs": 1976391,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Under this lens,"
    } ]
  }, {
    "tStartMs": 1977225,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "omakase taishos are like the Texas\nbarbecue pitmasters we've covered before."
    } ]
  }, {
    "tStartMs": 1980979,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "They're all owner operators"
    } ]
  }, {
    "tStartMs": 1982355,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "who pour their lives into their \ncraft, and the real cost of that"
    } ]
  }, {
    "tStartMs": 1985608,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "the time, the focus and dedication\nto show up every single day"
    } ]
  }, {
    "tStartMs": 1989445,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "far exceeds the hard costs\nthat show up in the numbers."
    } ]
  }, {
    "tStartMs": 1992740,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Jay feels the burnout."
    } ]
  }, {
    "tStartMs": 1994200,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "He has a wife and kids,\nand he's begun to wonder"
    } ]
  }, {
    "tStartMs": 1996369,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "if he should step away into consulting\nor move somewhere less saturated."
    } ]
  }, {
    "tStartMs": 2000123,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Spending his days off testing \ningredients instead of being with"
    } ]
  }, {
    "tStartMs": 2003126,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "his family is an imbalance\nthat he knows can't last forever."
    } ]
  }, {
    "tStartMs": 2006629,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "He funded every penny of Tsubame himself\nwithout a single outside investor,"
    } ]
  }, {
    "tStartMs": 2010717,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "and he's worked his way up from Queens\nto Tribeca.  Tsubame"
    } ]
  }, {
    "tStartMs": 2014387,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "is the inverse of Mori."
    } ]
  }, {
    "tStartMs": 2015930,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Mori is omakase as a format \nand opportunity - "
    } ]
  }, {
    "tStartMs": 2019017,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "faceless, efficient, accessible,\ndecentralized, and serviceable."
    } ]
  }, {
    "tStartMs": 2023354,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "Tsubame is omakase as a craft\nwhere everything is by tradition,"
    } ]
  }, {
    "tStartMs": 2027400,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "concentrated on a single person,\nwhere labor never lets up,"
    } ]
  }, {
    "tStartMs": 2030570,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "and where everything has to be the best\nevery time, all the time."
    } ]
  }, {
    "tStartMs": 2034532,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Omakase is Jay's career,\nbut it's also a cage"
    } ]
  }, {
    "tStartMs": 2037702,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "no different than how it is for \nJiro and his sons in Tokyo"
    } ]
  }, {
    "tStartMs": 2040872,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "as the price of insisting\nevery single day on the very best."
    } ]
  }, {
    "tStartMs": 2101974,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "The reality is that the omakases\nthat are thriving today"
    } ]
  }, {
    "tStartMs": 2104769,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "are the ones at the low-end with \ngreater audiences, replicable"
    } ]
  }, {
    "tStartMs": 2108064,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "playbooks, simpler menus, \nand prices under $100."
    } ]
  }, {
    "tStartMs": 2111442,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "They scale and expand faster\nthan the Moris and Tsubames"
    } ]
  }, {
    "tStartMs": 2114529,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "of the world, with more chairs,\nmore seatings, and shorter meals."
    } ]
  }, {
    "tStartMs": 2117907,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "These spots push volume\nunlike anyone else."
    } ]
  }, {
    "tStartMs": 2120618,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "They take walk-ins on top of \nreservations and offer delivery"
    } ]
  }, {
    "tStartMs": 2123913,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "and takeout to capture the mass market, \nbudget-conscious, casual diner."
    } ]
  }, {
    "tStartMs": 2128167,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The labor is never concentrated on 1"
    } ]
  }, {
    "tStartMs": 2129877,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "or 2 people, but spread across\nmultiple chefs and chefs."
    } ]
  }, {
    "tStartMs": 2133131,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "The product is simpler,"
    } ]
  }, {
    "tStartMs": 2134298,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "the service is barebones, and the demands\non staff and ingredients are much lower -"
    } ]
  }, {
    "tStartMs": 2138594,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "all of which only strengthens the \nefficiencies of the omakase model."
    } ]
  }, {
    "tStartMs": 2142598,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "This is the world of Yousi, who runs Sushi\nKai in the West Village in East Village."
    } ]
  }, {
    "tStartMs": 2146853,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "He's just opened a third \nlocation in Midtown"
    } ]
  }, {
    "tStartMs": 2149105,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "under a different name,\nbut with the same menu playbook,"
    } ]
  }, {
    "tStartMs": 2152150,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "and at a slightly lower price\nat just $85 per person for 16 courses."
    } ]
  }, {
    "tStartMs": 2157280,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "Sushi Kai is one of the city's biggest\nand most popular entry level omakase."
    } ]
  }, {
    "tStartMs": 2162243,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "It's here where product has been boiled\ndown to its most scalable, fast-casual,"
    } ]
  }, {
    "tStartMs": 2165955,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "and essential form as fish on rice\nin the form of nigiri or handrolls."
    } ]
  }, {
    "tStartMs": 2170710,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "There's no soup, no appetizer,\nand no dessert."
    } ]
  }, {
    "tStartMs": 2174046,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "Guests are reminded of their 75 minute\nmeal limit before they even sit down,"
    } ]
  }, {
    "tStartMs": 2178134,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "and they get served a new course\nroughly every five minutes."
    } ]
  }, {
    "tStartMs": 2180803,
    "dDurationMs": 4546,
    "segs": [ {
      "utf8": "The chefs move straight from one piece\nto the next Before all this, Yousi"
    } ]
  }, {
    "tStartMs": 2185349,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "worked at Nakazawa for eight years,\nlong enough to see firsthand how effective"
    } ]
  }, {
    "tStartMs": 2189395,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the model could be and how much room\nthere was left for new entrants."
    } ]
  }, {
    "tStartMs": 2292581,
    "dDurationMs": 793,
    "segs": [ {
      "utf8": "For Yousi,"
    } ]
  }, {
    "tStartMs": 2293374,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "$85 was never about undercutting anyone."
    } ]
  }, {
    "tStartMs": 2296460,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Instead, it was the price point where they felt"
    } ]
  }, {
    "tStartMs": 2298462,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "that they could consistently fill seats\nwithout deviating away from the ingredient"
    } ]
  }, {
    "tStartMs": 2302216,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "quality, prep, and standards that they had\nabsorbed directly from Nakazawa."
    } ]
  }, {
    "tStartMs": 2306220,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "And with just six seats in their \nfirst shop in the East Village,"
    } ]
  }, {
    "tStartMs": 2309265,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "they didn't have the runway to risk on\nultra premium ingredients."
    } ]
  }, {
    "tStartMs": 2312560,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "experiment freely, or chase stars at \nthe top of the market."
    } ]
  }, {
    "tStartMs": 2315938,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "Thus, like any fast casual concept,\nSushi Kai's menu is optimized"
    } ]
  }, {
    "tStartMs": 2320234,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "for customers as a fixed lineup\nwhere only 1 or 2 pieces change a quarter."
    } ]
  }, {
    "tStartMs": 2324822,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "The menu is basically a greatest \nhits of all the viral,"
    } ]
  }, {
    "tStartMs": 2327867,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "crowd-pleasing fatty fish\nand rich meats that Americans"
    } ]
  }, {
    "tStartMs": 2330995,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "recognize and crave like \nA5 Wagyu, Hokkaido uni,"
    } ]
  }, {
    "tStartMs": 2334915,
    "dDurationMs": 4964,
    "segs": [ {
      "utf8": "caviar, fatty tuna, and foie gras\nserved the same way every single night."
    } ]
  }, {
    "tStartMs": 2340171,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "And so while a true omakase\nis about letting the chef decide"
    } ]
  }, {
    "tStartMs": 2343174,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "what's freshest, Sushi Kai, \nin contrast, can't - "
    } ]
  }, {
    "tStartMs": 2346302,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "not if it wants to fill every seat \nand hold its price point."
    } ]
  }, {
    "tStartMs": 2462751,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Under this lens, Sushi Kai thrives\nin serving the specific pieces"
    } ]
  }, {
    "tStartMs": 2465921,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "that Americans want most, rather\nthan reinventing the menu every month."
    } ]
  }, {
    "tStartMs": 2469675,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "They strip out everything else - "
    } ]
  }, {
    "tStartMs": 2471093,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "the meticulous plating, the laborious\nprep, the complicated techniques,"
    } ]
  }, {
    "tStartMs": 2475139,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "the strict ambiance,\nthe overbearing etiquette,"
    } ]
  }, {
    "tStartMs": 2477725,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "the rigid reservations,\nand the long meal times."
    } ]
  }, {
    "tStartMs": 2480478,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "These are all the things\nthat make traditional omakase"
    } ]
  }, {
    "tStartMs": 2482813,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "expensive in the first place,\nThe result is a casual space where people"
    } ]
  }, {
    "tStartMs": 2486775,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "can walk in, talk, drink, eat and leave\nwith all their bucket-list pieces"
    } ]
  }, {
    "tStartMs": 2490946,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "for a fraction of the price and time\nthat it would cost them anywhere else."
    } ]
  }, {
    "tStartMs": 2495242,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "at the sub $100 price point,\nhe faces the greatest saturation."
    } ]
  }, {
    "tStartMs": 2498871,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "Sushi Kai's volume of competition is twice\nthat of Mori's and seven times"
    } ]
  }, {
    "tStartMs": 2503167,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "that of Tsubame."
    } ]
  }, {
    "tStartMs": 2504418,
    "dDurationMs": 5214,
    "segs": [ {
      "utf8": "Today, 1 in every 2 new omakases courses\nin the city price themselves below $100."
    } ]
  }, {
    "tStartMs": 2509965,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "Yousi's is the first to admit that he's\nfrustrated."
    } ]
  }, {
    "tStartMs": 2512343,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Sushi Kai has been caught \nin a race to the bottom"
    } ]
  }, {
    "tStartMs": 2514720,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "and one that he ironically \nhelped popularize."
    } ]
  }, {
    "tStartMs": 2517348,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "They've raised prices themselves"
    } ]
  }, {
    "tStartMs": 2518724,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "every year, even as new entrants\ndragged down the broader market."
    } ]
  }, {
    "tStartMs": 2521936,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "And like Jay, he's\nno fan of what's happening."
    } ]
  }, {
    "tStartMs": 2607271,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "Ultimately, Sushi"
    } ]
  }, {
    "tStartMs": 2608397,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "Kai's greatest obstacle is talent\nrather than product or competition."
    } ]
  }, {
    "tStartMs": 2612401,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "Reliable, consistent sushi chefs\nare the one thing he can't systematize,"
    } ]
  }, {
    "tStartMs": 2616488,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and in this booming market,\nthey can leave for anywhere."
    } ]
  }, {
    "tStartMs": 2619617,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "A decent sushi chef in New York City\ncost $300 a day."
    } ]
  }, {
    "tStartMs": 2623120,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "Yoshi's turned down investors because\nscaling only makes quality harder to hold."
    } ]
  }, {
    "tStartMs": 2627291,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "And as he's already found across\nthree locations, upholding"
    } ]
  }, {
    "tStartMs": 2630252,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "standards only gets more and more difficult"
    } ]
  }, {
    "tStartMs": 2632379,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "with every additional seat\nand every new pair of hands."
    } ]
  }, {
    "tStartMs": 2635758,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Sushi Kai today grosses $85,000 \na month per location,"
    } ]
  }, {
    "tStartMs": 2639762,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "for an annual run rate of $1.02 \nmillion at three locations."
    } ]
  }, {
    "tStartMs": 2644433,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "At capacity, that's $3 million grossed\nacross Yoshi and his three brothers."
    } ]
  }, {
    "tStartMs": 2649104,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "And unlike Jay, the scalability of this\nmodel has kept his burnout manageable."
    } ]
  }, {
    "tStartMs": 2653609,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "Things have only gotten bigger."
    } ]
  }, {
    "tStartMs": 2655110,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "The original Sushi Kai six years ago\nin the East Village had only eight seats."
    } ]
  }, {
    "tStartMs": 2659657,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "The second in West Village grew to 16\nand the third in Midtown now seats 20"
    } ]
  }, {
    "tStartMs": 2664244,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "as a fast-casual operation."
    } ]
  }, {
    "tStartMs": 2665996,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "They lean hard into modern marketing\nwith social media and influencers,"
    } ]
  }, {
    "tStartMs": 2669958,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "which is a lane that Mori only dabbles\nin and Tsubame rarely touches."
    } ]
  }, {
    "tStartMs": 2674421,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Sushi Kai's average\noperating margin sits at 20%."
    } ]
  }, {
    "tStartMs": 2678175,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "In the end, all three spots are running\nfrom the same thing."
    } ]
  }, {
    "tStartMs": 2681136,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Mori, Tsubame, and Sushi Kai look nothing alike - "
    } ]
  }, {
    "tStartMs": 2684139,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "a faceless counter in Soho, a one man"
    } ]
  }, {
    "tStartMs": 2686475,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "army in Tribeca, and a fast casual \nchain spreading across Manhattan."
    } ]
  }, {
    "tStartMs": 2690646,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "But the pressures they face in a saturated\nmarket are identical."
    } ]
  }, {
    "tStartMs": 2693857,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "When there's an omakase on every block,"
    } ]
  }, {
    "tStartMs": 2696068,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "when everyone's fish comes from \nthe same market in Tokyo,"
    } ]
  }, {
    "tStartMs": 2698904,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and when the price keeps on dropping,\nyou have to decide what you're"
    } ]
  }, {
    "tStartMs": 2701907,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "really selling."
    } ]
  }, {
    "tStartMs": 2702991,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Shawn and Solomon sell an experience."
    } ]
  }, {
    "tStartMs": 2705160,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Yousi sells the hits,\nand Jay sells himself."
    } ]
  }, {
    "tStartMs": 2708163,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "The paradox is that everything\nthat makes omakase such a good business"
    } ]
  }, {
    "tStartMs": 2711792,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "is exactly the same thing\nthat makes it so easy to replicate."
    } ]
  }, {
    "tStartMs": 2715212,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "The low bar that enabled Shawn, Solomon, Jay,"
    } ]
  }, {
    "tStartMs": 2718132,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "and Yousi to grow from employees to owners\nis the same low bar"
    } ]
  }, {
    "tStartMs": 2722177,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "that lets thousands of others\nin with far less skill and experience."
    } ]
  }, {
    "tStartMs": 2725973,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "It took sushi 40 years to climb\nfrom a cheap add on to a $950"
    } ]
  }, {
    "tStartMs": 2730394,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "seat at Masa, and it's only \ntaken 5 years for omakase"
    } ]
  }, {
    "tStartMs": 2733814,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "to become the new default\nand the normal way to eat sushi"
    } ]
  }, {
    "tStartMs": 2736942,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "in the world's most expensive city."
    } ]
  }, {
    "tStartMs": 2738777,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "Whether it's labeled as \ndemocratization or saturation,"
    } ]
  }, {
    "tStartMs": 2741739,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "it ultimately doesn't matter."
    } ]
  }, {
    "tStartMs": 2743115,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "It's not slowing down,\nand it's not staying in New York."
    } ]
  }, {
    "tStartMs": 2746034,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "The only thing left to find out"
    } ]
  }, {
    "tStartMs": 2747619,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "is how cheap it gets before the word\ndoesn't mean much of anything."
    } ]
  } ]
}
