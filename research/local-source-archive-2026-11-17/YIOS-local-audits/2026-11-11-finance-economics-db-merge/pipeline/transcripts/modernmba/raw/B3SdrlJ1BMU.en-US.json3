    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "generally not only wealthy, but also responsible."
    } ]
  }, {
    "tStartMs": 1421389,
    "dDurationMs": 583,
    "segs": [ {
      "utf8": "Thus, while"
    } ]
  }, {
    "tStartMs": 1421972,
