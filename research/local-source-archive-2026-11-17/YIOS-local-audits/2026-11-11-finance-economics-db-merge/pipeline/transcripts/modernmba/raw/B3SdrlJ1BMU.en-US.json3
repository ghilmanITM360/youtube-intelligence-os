  "events": [ {
    "tStartMs": 0,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Modern credit cards have become a game\nwhere even casual"
    } ]
  }, {
    "tStartMs": 2502,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "consumers obsess over"
    } ]
  }, {
    "tStartMs": 3670,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "earning points, spend"
    } ]
  }, {
    "tStartMs": 4838,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "hours researching their next card, and."
    } ]
  }, {
    "tStartMs": 6756,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "fixate on getting the\nbest rewards possible."
    } ]
  }, {
    "tStartMs": 9134,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "There's more options\nnow than ever in history."
    } ]
  }, {
    "tStartMs": 11386,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "In the past decade, an ecosystem\nof publications and influencers"
    } ]
  }, {
    "tStartMs": 14681,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "have emerged promising\nto help people navigate this"
    } ]
  }, {
    "tStartMs": 17142,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "ever-growing"
    } ]
  }, {
    "tStartMs": 17684,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "complexity into digestible recommendations\nand banks have paid the"
    } ]
  }, {
    "tStartMs": 21062,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "millions of dollars to push their products\nand to keep up this consumer frenzy"
    } ]
  }, {
    "tStartMs": 24816,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "on top of all their usual TV,\ndirect-mail and online advertising."
    } ]
  }, {
    "tStartMs": 28570,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "All this gamification"
    } ]
  }, {
    "tStartMs": 29821,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "exists for a reason - credit\ncards are a highly"
    } ]
  }, {
    "tStartMs": 32115,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "profitable business. Getting people\nto project their vacations, lifestyle,"
    } ]
  }, {
    "tStartMs": 35618,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "and social status"
    } ]
  }, {
    "tStartMs": 36494,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "on these tiny pieces of plastic\nand metal is all part of the plan."
    } ]
  }, {
    "tStartMs": 39706,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "If people care so much that they'll even\nspend their free time thinking about"
    } ]
  }, {
    "tStartMs": 42751,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "their next card, the money will keep flowing."
    } ]
  }, {
    "tStartMs": 44753,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "Even though the industry has been around"
    } ]
  }, {
    "tStartMs": 46337,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "since the 1950s, power has rested\nin the same hands."
    } ]
  }, {
    "tStartMs": 49215,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "On the network side, it's"
    } ]
  }, {
    "tStartMs": 50300,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "a duopoly with Visa and Mastercard."
    } ]
  }, {
    "tStartMs": 52385,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "Their closest challenger\nis American Express,"
    } ]
  }, {
    "tStartMs": 54512,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "but even they are still too small to"
    } ]
  }, {
    "tStartMs": 56222,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "pose a real threat,\ndespite the fact that they had a"
    } ]
  }, {
    "tStartMs": 58308,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "100-year head start before Visa and Mastercard."
    } ]
  }, {
    "tStartMs": 61227,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "There's more competition"
    } ]
  }, {
    "tStartMs": 62270,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "when we look at the companies\nthat actually issue credit cards, but"
    } ]
  }, {
    "tStartMs": 64814,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "the lion's share of those profits\nstill go to the same"
    } ]
  }, {
    "tStartMs": 67192,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "Big 4 American banks."
    } ]
  }, {
    "tStartMs": 68526,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "No one has been able to break this power structure."
    } ]
  }, {
    "tStartMs": 70987,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "Even fintech startups,\nfor all their talk of disruption, have"
    } ]
  }, {
    "tStartMs": 73782,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "never been able to crack this dynamic\nas even their credit"
    } ]
  }, {
    "tStartMs": 76367,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "cards still go through\nvisa and Mastercard."
    } ]
  }, {
    "tStartMs": 78578,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Even with growing political pressure\nand the intense regulation"
    } ]
  }, {
    "tStartMs": 81372,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "through the past decade,\nit's the same tight-knit circle"
    } ]
  }, {
    "tStartMs": 83917,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "of market makers that are\ncolluding and happy to"
    } ]
  }, {
    "tStartMs": 86169,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "keep the other in business."
    } ]
  }, {
    "tStartMs": 87504,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "In this episode,\nwe're diving into the business"
    } ]
  }, {
    "tStartMs": 89255,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "conspiracy and"
    } ]
  }, {
    "tStartMs": 90256,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "the economics of credit cards"
    } ]
  }, {
    "tStartMs": 91716,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "through the biggest players in Visa,"
    } ]
  }, {
    "tStartMs": 93384,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Mastercard, American Express, Discover, Chase,"
    } ]
  }, {
    "tStartMs": 97858,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "a credit card, whether tap or swipe\nor insert, it's the merchant"
    } ]
  }, {
    "tStartMs": 100861,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "who takes your payment and bears the costs."
    } ]
  }, {
    "tStartMs": 102988,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "They're the ones who have to pay the swipe fees"
    } ]
  }, {
    "tStartMs": 104907,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "and they've tried for"
    } ]
  }, {
    "tStartMs": 105657,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "decades ways to push the cost back\nonto consumers, whether through"
    } ]
  }, {
    "tStartMs": 108577,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "markups or surcharges."
    } ]
  }, {
    "tStartMs": 109995,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "When you take 2-3% of every"
    } ]
  }, {
    "tStartMs": 111789,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "transaction, that money adds up very quickly."
    } ]
  }, {
    "tStartMs": 114291,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "But contrary to popular belief."
    } ]
  }, {
    "tStartMs": 115959,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "those swipe fees are not going\nin the pockets of Visa"
    } ]
  }, {
    "tStartMs": 118545,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "or Mastercard."
    } ]
  }, {
    "tStartMs": 119379,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "That 2-3% actually goes to the bank\nthat issued"
    } ]
  }, {
    "tStartMs": 121965,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "that person's credit card\nas compensation"
    } ]
  }, {
    "tStartMs": 124009,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "to them for taking on the credit"
    } ]
  }, {
    "tStartMs": 125385,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "risk and guaranteeing payment to\nthe business on behalf of the individual."
    } ]
  }, {
    "tStartMs": 129014,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "Mastercard and Visa then"
    } ]
  }, {
    "tStartMs": 130349,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "charge their own separate fee as software middlemen who"
    } ]
  }, {
    "tStartMs": 132976,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "shepherd the transfer of money\nfrom the cardholder's"
    } ]
  }, {
    "tStartMs": 135020,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "bank to the merchant's bank account,"
    } ]
  }, {
    "tStartMs": 136480,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "almost like a digital mini-escrow."
    } ]
  }, {
    "tStartMs": 138482,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "The merchant or the business keeps the rest"
    } ]
  }, {
    "tStartMs": 140526,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "after all these fees are deducted"
    } ]
  }, {
    "tStartMs": 142027,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "and this happens on every transaction."
    } ]
  }, {
    "tStartMs": 144321,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "There are a minimum of three parties."
    } ]
  }, {
    "tStartMs": 145739,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "involved and"
    } ]
  }, {
    "tStartMs": 146281,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "often a fourth or fifth\nif the payment is handled on a"
    } ]
  }, {
    "tStartMs": 148826,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "physical terminal like Square or Verifone,"
    } ]
  }, {
    "tStartMs": 151328,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "keyed in an online gateway like Stripe or PayPal, or through"
    } ]
  }, {
    "tStartMs": 154289,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "NFC like Apple Pay or Google Pay.\nEvery middleman takes its own cut."
    } ]
  }, {
    "tStartMs": 158544,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "Despite an increasing number of hands in the"
    } ]
  }, {
    "tStartMs": 160379,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "pot, credit cards have remained a lucrative business."
    } ]
  }, {
    "tStartMs": 162965,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "They're the crown jewels,"
    } ]
  }, {
    "tStartMs": 163966,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "even for the big banks, as their business\ndivisions boast the highest"
    } ]
  }, {
    "tStartMs": 167052,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "growth and strongest margins greater than"
    } ]
  }, {
    "tStartMs": 169054,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "that of investment banking, auto loans, commercial loans,"
    } ]
  }, {
    "tStartMs": 171932,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "and mortgages. Even though every party in this"
    } ]
  }, {
    "tStartMs": 174268,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "transaction is playing their part, the"
    } ]
  }, {
    "tStartMs": 175978,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "elephant in the room still exists."
    } ]
  }, {
    "tStartMs": 177896,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "Why are the banks so happy to keep Visa and"
    } ]
  }, {
    "tStartMs": 179857,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "Mastercard around as middlemen?"
    } ]
  }, {
    "tStartMs": 181441,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "Why aren't the big banks\nmore ruthless in pushing"
    } ]
  }, {
    "tStartMs": 183569,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "their own networks, when they're already so aggressive"
    } ]
  }, {
    "tStartMs": 185737,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "about extracting every dollar of profit\nfor every other product?"
    } ]
  }, {
    "tStartMs": 189074,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "And why are Visa and Mastercard so willing"
    } ]
  }, {
    "tStartMs": 191034,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "To be the public whipping boy for politicians,"
    } ]
  }, {
    "tStartMs": 193162,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "when they could easily point the finger"
    } ]
  }, {
    "tStartMs": 194580,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "at their banking partners\nas the ones who are"
    } ]
  }, {
    "tStartMs": 196456,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "taking the swipe fees?"
    } ]
  }, {
    "tStartMs": 197708,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "The reality is that Visa and Mastercard are"
    } ]
  }, {
    "tStartMs": 200002,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "not tech companies born in Silicon Valley."
    } ]
  }, {
    "tStartMs": 202296,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "Instead, they were born out of the big banks."
    } ]
  }, {
    "tStartMs": 204631,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "Visa was founded by Bank"
    } ]
  }, {
    "tStartMs": 205924,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "of America, turned into a"
    } ]
  }, {
    "tStartMs": 207384,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "co-op with other banks,"
    } ]
  }, {
    "tStartMs": 208594,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "and then eventually spun out into its own\nindependent entity."
    } ]
  }, {
    "tStartMs": 211680,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "And Mastercard was formed in"
    } ]
  }, {
    "tStartMs": 213056,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "response by the smaller banks who allied"
    } ]
  }, {
    "tStartMs": 215100,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "together under the concern"
    } ]
  }, {
    "tStartMs": 216518,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "that they would get muscled out\nby the bigger banks, and in time"
    } ]
  }, {
    "tStartMs": 218937,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "Mastercard"
    } ]
  }, {
    "tStartMs": 219479,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "also became a standalone,\npublicly-traded company."
    } ]
  }, {
    "tStartMs": 222107,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "This means that"
    } ]
  }, {
    "tStartMs": 222774,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "Visa and Mastercard are not"
    } ]
  }, {
    "tStartMs": 224067,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "some new-age futuristic tech company."
    } ]
  }, {
    "tStartMs": 226111,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "They're product of the system themselves,"
    } ]
  }, {
    "tStartMs": 227988,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "and they enable the banks\njust as much as the banks enable them."
    } ]
  }, {
    "tStartMs": 231116,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "Every single CEO in the history of Visa\nand Mastercard has come from a big bank."
    } ]
  }, {
    "tStartMs": 235621,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "They all exist in this unspoken harmony,\nwhere the banks won't encroach onto the"
    } ]
  }, {
    "tStartMs": 239082,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "networks and vice-versa."
    } ]
  }, {
    "tStartMs": 240542,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "Thus, Visa and Mastercard can"
    } ]
  }, {
    "tStartMs": 242044,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "focus on getting ahead of potential challengers"
    } ]
  }, {
    "tStartMs": 244213,
    "dDurationMs": 2293,
    "segs": [ {
      "utf8": "that are emerging from the front\nand never have to worry"
    } ]
  }, {
    "tStartMs": 246506,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "about getting squeezed out from the rear."
    } ]
  }, {
    "tStartMs": 248342,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Their only competition is new technology,\nand Visa"
    } ]
  }, {
    "tStartMs": 250886,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "eagerly partners with just about anyone and"
    } ]
  }, {
    "tStartMs": 253055,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "everyone to ensure that they're seen\nas a partner rather than a target."
    } ]
  }, {
    "tStartMs": 256350,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "Like Mastercard, they have"
    } ]
  }, {
    "tStartMs": 257517,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "no opinions on the future,"
    } ]
  }, {
    "tStartMs": 258727,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "just that they need to be a part of it,\nas both companies have"
    } ]
  }, {
    "tStartMs": 261438,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "programs dedicated to helping crypto and fintech"
    } ]
  }, {
    "tStartMs": 263941,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "startups get to market faster."
    } ]
  }, {
    "tStartMs": 265817,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "And if a startup"
    } ]
  }, {
    "tStartMs": 266568,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "did want to go head-on against these legacy networks,"
    } ]
  }, {
    "tStartMs": 269029,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "they wouldn't make any progress\nbecause no big bank, whether"
    } ]
  }, {
    "tStartMs": 271573,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "it's from the merchant side or the\ncardholder side, would ever join a network"
    } ]
  }, {
    "tStartMs": 275035,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "at the expense of Visa and Mastercard."
    } ]
  }, {
    "tStartMs": 277621,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "It was in the mid-1980s when"
    } ]
  }, {
    "tStartMs": 279206,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "credit cards became popular."
    } ]
  }, {
    "tStartMs": 280832,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "The only real lines of credit\navailable to"
    } ]
  }, {
    "tStartMs": 282626,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "the average American back then were either\npayday lenders or loan sharks."
    } ]
  }, {
    "tStartMs": 286171,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "The banks were the issuers of credit\ncards, and the networks who made"
    } ]
  }, {
    "tStartMs": 289216,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "such payments possible both made"
    } ]
  }, {
    "tStartMs": 290759,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "a fortune in this emerging market."
    } ]
  }, {
    "tStartMs": 292594,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "It was like a perfect division of labor,\nas the"
    } ]
  }, {
    "tStartMs": 294721,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "system collectively"
    } ]
  }, {
    "tStartMs": 295681,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "worked to push credit card"
    } ]
  }, {
    "tStartMs": 296974,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "adoption to both consumers and businesses."
    } ]
  }, {
    "tStartMs": 299518,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "The networks like Visa,"
    } ]
  }, {
    "tStartMs": 300811,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Mastercard, and American Express were in\nan arms race to sign as many merchants as"
    } ]
  }, {
    "tStartMs": 304648,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "possible."
    } ]
  }, {
    "tStartMs": 305524,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Meanwhile, the banks issuing"
    } ]
  }, {
    "tStartMs": 306692,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "credit cards were in their own arms\nrace to sign up as many"
    } ]
  }, {
    "tStartMs": 309278,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "consumers for their specific card product\nas possible."
    } ]
  }, {
    "tStartMs": 312155,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "The networks"
    } ]
  }, {
    "tStartMs": 312781,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "make money off volume, so they care about\ngetting in as many swipes as possible."
    } ]
  }, {
    "tStartMs": 316702,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "The banks, however, make money."
    } ]
  }, {
    "tStartMs": 318120,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "off of interest, and credit cards are like rocket"
    } ]
  }, {
    "tStartMs": 320372,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "fuel to conventional banking."
    } ]
  }, {
    "tStartMs": 322165,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "In the simplest abstraction, banks take\nmoney from people who don't need it and."
    } ]
  }, {
    "tStartMs": 325794,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "they charge the borrowers a higher\ninterest rate than whatever they paid to"
    } ]
  }, {
    "tStartMs": 328714,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "the depositors."
    } ]
  }, {
    "tStartMs": 329798,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "The spread is where banks\nmake money, yet the"
    } ]
  }, {
    "tStartMs": 332175,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "average person"
    } ]
  }, {
    "tStartMs": 332926,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "typically only really borrows money\nfor big purchases like cars, home"
    } ]
  }, {
    "tStartMs": 336847,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "or business assets."
    } ]
  }, {
    "tStartMs": 338223,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "As a result, there are three constraints."
    } ]
  }, {
    "tStartMs": 340058,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "First, most people aren't buying"
    } ]
  }, {
    "tStartMs": 341810,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "a car or house every year, so"
    } ]
  }, {
    "tStartMs": 343395,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "opportunities to lend are limited."
    } ]
  }, {
    "tStartMs": 345230,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "The second is that these\npurchases are expensive"
    } ]
  }, {
    "tStartMs": 347566,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "so you as a bank have to make"
    } ]
  }, {
    "tStartMs": 348817,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "sure that you're lending to the right\npeople, to enforce collection"
    } ]
  }, {
    "tStartMs": 351403,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "of payments and to protect yourself\nin case they run off."
    } ]
  }, {
    "tStartMs": 354114,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "And all of this overhead eats into margins."
    } ]
  }, {
    "tStartMs": 356408,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "The third is competition."
    } ]
  }, {
    "tStartMs": 357868,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "People are generally diligent about\ntaking loans out, and they'll optimize"
    } ]
  }, {
    "tStartMs": 361288,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "for whoever gives them the lowest interest rate."
    } ]
  }, {
    "tStartMs": 363415,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "So you as a bank, are always competing\nfor your loans with everyone else."
    } ]
  }, {
    "tStartMs": 367085,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "And lastly, it's the Federal Reserve who sets"
    } ]
  }, {
    "tStartMs": 368712,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "the interest rate as a baseline"
    } ]
  }, {
    "tStartMs": 370255,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "so you can't collude"
    } ]
  }, {
    "tStartMs": 371173,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "with other banks and you're tethered\nby forces beyond your control."
    } ]
  }, {
    "tStartMs": 374217,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Credit cards break all of these restraints as micro-loans."
    } ]
  }, {
    "tStartMs": 377220,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "The average American credit line is tiny"
    } ]
  }, {
    "tStartMs": 379264,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "compared to that of a mortgage, but"
    } ]
  }, {
    "tStartMs": 380849,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "what is lost in deal size is made up for in interest."
    } ]
  }, {
    "tStartMs": 383727,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Banks who issue credit cards can charge any interest rate"
    } ]
  }, {
    "tStartMs": 386229,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "they want with no legal limit\nor relation to the Fed."
    } ]
  }, {
    "tStartMs": 389066,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "It's a dream come"
    } ]
  }, {
    "tStartMs": 389816,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "true for these lenders,\nas they get to charge"
    } ]
  }, {
    "tStartMs": 391651,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "radically high interest rates\nfor low amounts of money."
    } ]
  }, {
    "tStartMs": 394404,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "With such tiny loan sizes,\nthe risk is lower and the due"
    } ]
  }, {
