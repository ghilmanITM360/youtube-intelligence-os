    "tStartMs": 574000,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "as Americans lost"
    } ]
  }, {
    "tStartMs": 574918,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "their homes and jobs."
    } ]
  }, {
    "tStartMs": 576211,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "And since credit cards are unsecured debt\nwith no collateral,"
    } ]
  }, {
    "tStartMs": 579089,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "they were the lowest on the totem pole\nin priorities."
    } ]
  }, {
    "tStartMs": 581758,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "With widespread delinquencies,\nthe banks suffered massive losses, and"
    } ]
  }, {
    "tStartMs": 584970,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "whatever revenue they had generated\nfrom interest that year went"
    } ]
  }, {
    "tStartMs": 588014,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "to funding the write-offs.\nFor the first time ever,"
    } ]
  }, {
    "tStartMs": 590433,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "profit margins plummeted"
    } ]
  }, {
    "tStartMs": 591601,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "to low single digits"
    } ]
  }, {
    "tStartMs": 592561,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "across the industry,\nwith some banks even ending up in the red."
    } ]
  }, {
    "tStartMs": 595981,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "In response, the Obama administration"
    } ]
  }, {
    "tStartMs": 598024,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "pushed the Card Act of 2009,"
    } ]
  }, {
    "tStartMs": 599401,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "which curtailed these industry-wide predatory"
    } ]
  }, {
    "tStartMs": 601861,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "practices by mandating disclosures,\nproviding notice on rate increases, fixing"
    } ]
  }, {
    "tStartMs": 606241,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "payment deadlines, setting age limits,\nand banning marketing to college students."
    } ]
  }, {
    "tStartMs": 610495,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "Yet the damage from the downturn was\nultimately limited to just the banks, as"
    } ]
  }, {
    "tStartMs": 614040,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "the card issuers in"
    } ]
  }, {
    "tStartMs": 615500,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Visa and Mastercard continue\nto make their fortunes during"
    } ]
  }, {
    "tStartMs": 617919,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "and through the Great Recession as\nsoftware middleman with zero exposure"
    } ]
  }, {
    "tStartMs": 621214,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "to the end consumer and cardholder."
    } ]
  }, {
    "tStartMs": 622299,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "The only reason they each declared a loss"
    } ]
  }, {
    "tStartMs": 623967,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "in 2007 was because of the one-time\nantitrust litigation payments."
    } ]
  }, {
    "tStartMs": 627846,
    "dDurationMs": 625,
    "segs": [ {
      "utf8": "Both Visa"
    } ]
  }, {
    "tStartMs": 628471,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "and Mastercard coughed up\nbillions of dollars in settlement"
    } ]
  }, {
    "tStartMs": 631057,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "that year with their rivals."
    } ]
  }, {
    "tStartMs": 632517,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "The U.S. Government had discovered\nthe collusion"
    } ]
  }, {
    "tStartMs": 634644,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "between Visa, Mastercard\nand the big banks."
    } ]
  }, {
    "tStartMs": 637063,
    "dDurationMs": 376,
    "segs": [ {
      "utf8": "The Big 4"
    } ]
  }, {
    "tStartMs": 637439,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "had conspired to build and fortify"
    } ]
  }, {
    "tStartMs": 639566,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "Visa and Mastercard's duopoly."
    } ]
  }, {
    "tStartMs": 641192,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "by not allowing all the banks\nbelow them to issue"
    } ]
  }, {
    "tStartMs": 643445,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "credit cards for competing networks\nlike American Express and Discover."
    } ]
  }, {
    "tStartMs": 646948,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "And if you're a smaller"
    } ]
  }, {
    "tStartMs": 647866,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "regional bank that does regular business\nwith Chase, Citibank, BofA,"
    } ]
  }, {
    "tStartMs": 651786,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "or Wells Fargo, you really have no choice\nbut to follow what they tell you to do."
    } ]
  }, {
    "tStartMs": 655498,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "Despite the hard evidence from the DOJ,"
    } ]
  }, {
    "tStartMs": 657542,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "the government took no action\nbeyond the civil monetary penalties."
    } ]
  }, {
    "tStartMs": 661379,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "Hilariously, Visa"
    } ]
  }, {
    "tStartMs": 662464,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "and Mastercard knew that these"
    } ]
  }, {
    "tStartMs": 663548,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "fines were coming and quickly went public\nleading up to the settlement,"
    } ]
  }, {
    "tStartMs": 666635,
    "dDurationMs": 583,
    "segs": [ {
      "utf8": "and they used the"
    } ]
  }, {
    "tStartMs": 667218,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "funds directly raised from the public markets from their"
    } ]
  }, {
    "tStartMs": 669721,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "IPOs to pay off these penalties."
    } ]
  }, {
    "tStartMs": 671973,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "Despite having the upper hand in the bank bailout,"
    } ]
  }, {
    "tStartMs": 674100,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "the government opted"
    } ]
  }, {
    "tStartMs": 675060,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "to continue its crusade of industry"
    } ]
  }, {
    "tStartMs": 676811,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "wide regulation on all networks\nrather than the obvious duopoly."
    } ]
  }, {
    "tStartMs": 681024,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Visa and Mastercard at this point\nwere light years ahead in network"
    } ]
  }, {
    "tStartMs": 683485,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "volume compared to American Express, who had"
    } ]
  }, {
    "tStartMs": 685487,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "been the true first mover and pioneer of credit cards."
    } ]
  }, {
    "tStartMs": 688573,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Even Discover, the nimble, lean upstart had"
    } ]
  }, {
    "tStartMs": 691034,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "no chance of closing this gap as neither"
    } ]
  }, {
    "tStartMs": 692952,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "network could ever replicate"
    } ]
  }, {
    "tStartMs": 694120,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "the relationships, access, incentives, and shared"
    } ]
  }, {
    "tStartMs": 696873,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "agenda with the big banks that only Visa and Mastercard enjoyed."
    } ]
  }, {
    "tStartMs": 700502,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "The Great Recession\nultimately did nothing to stop the"
    } ]
  }, {
    "tStartMs": 702837,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "trajectories of this duopoly."
    } ]
  }, {
    "tStartMs": 704422,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Even when Americans switched\nto debit cards to avoid"
    } ]
  }, {
    "tStartMs": 707133,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "the interest risk and to develop better spending habits,"
    } ]
  }, {
    "tStartMs": 709803,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Visa, Mastercard, and the big banks still profited by"
    } ]
  }, {
    "tStartMs": 712389,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "charging the same swipe fees and splitting\nthe proceeds amongst themselves."
    } ]
  }, {
    "tStartMs": 715934,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "It was in 2011 when"
    } ]
  }, {
    "tStartMs": 717060,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "the U.S. government capped the swipe"
    } ]
  }, {
    "tStartMs": 718478,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "fees for debit cards"
    } ]
  }, {
    "tStartMs": 719562,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "to $0.21 and 0.05%,\nwhich is substantially"
    } ]
  }, {
    "tStartMs": 723233,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "lower than that of credit cards."
    } ]
  }, {
    "tStartMs": 725068,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "This piece of regulation"
    } ]
  }, {
    "tStartMs": 726277,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "was pushed once again\nwith an industry-wide holistic view"
    } ]
  }, {
    "tStartMs": 729114,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "under the rationale"
    } ]
  }, {
    "tStartMs": 730115,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "that some electronic payment\nwas better than none at all."
    } ]
  }, {
    "tStartMs": 732992,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "This was a rare case\nwhere the government prioritized"
    } ]
  }, {
    "tStartMs": 735286,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "its interests ahead of the financial system."
    } ]
  }, {
    "tStartMs": 737664,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Low swipe fees"
    } ]
  }, {
    "tStartMs": 738498,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "on debit cards would mean more businesses\naccepting plastic"
    } ]
  }, {
    "tStartMs": 741292,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "over cash. And less cash in the long\nrun would mean less"
    } ]
  }, {
    "tStartMs": 744087,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "opportunity for"
    } ]
  }, {
    "tStartMs": 744921,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "tax evasion, laundering, and corruption,\nwhich was a win"
    } ]
  }, {
    "tStartMs": 747924,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "even if it came at the expense of bank\nprofits."
    } ]
  }, {
    "tStartMs": 750510,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "As the economy recovered,"
    } ]
  }, {
    "tStartMs": 751886,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Visa and Mastercard\nearnings continued to surge"
    } ]
  }, {
    "tStartMs": 754472,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "with the full backing of the big banks.\nSince the government showed"
    } ]
  }, {
    "tStartMs": 757475,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "no concern with the duopoly, the\ntwo networks were able"
    } ]
  }, {
    "tStartMs": 760145,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "to focus on getting ahead of their"
    } ]
  }, {
    "tStartMs": 761521,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "only remaining threat in technology."
    } ]
  }, {
    "tStartMs": 763648,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "They created new"
    } ]
  }, {
    "tStartMs": 764399,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "security standards like EMV chip cards"
    } ]
  }, {
    "tStartMs": 766609,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "and provided Day 1 support\nfor any emerging"
    } ]
  }, {
    "tStartMs": 768903,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "potential technology, like optical."
    } ]
  }, {
    "tStartMs": 770780,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "readers and smart speakers."
    } ]
  }, {
    "tStartMs": 772365,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "Visa and Mastercard have no opinions on the future."
    } ]
  }, {
    "tStartMs": 774743,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "Instead, their goal\nas middlemen is to be present"
    } ]
  }, {
    "tStartMs": 776995,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "anywhere and everywhere with Day 1 support for everything."
    } ]
  }, {
    "tStartMs": 779956,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "They can wait and see to see what technologies"
    } ]
  }, {
    "tStartMs": 782000,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "will take off like NFC, contactless, and tap-to-pay and then"
    } ]
  }, {
    "tStartMs": 785503,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "ramp up their investment accordingly."
    } ]
  }, {
    "tStartMs": 787255,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "There's a clear division of ambitions."
    } ]
  }, {
    "tStartMs": 789090,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "Visa and Mastercard focus on consumer-to-business transactions."
    } ]
  }, {
    "tStartMs": 792469,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "The majority of money that flows"
    } ]
  }, {
    "tStartMs": 794012,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "through both networks every year is on\nconsumer credit, and very"
    } ]
  }, {
    "tStartMs": 797015,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "little of it is on commercial credit."
    } ]
  }, {
    "tStartMs": 798808,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "The big banks on the other hand, focus\non business-to-business and business-"
    } ]
  }, {
    "tStartMs": 802020,
    "dDurationMs": 625,
    "segs": [ {
      "utf8": "to-consumer transactions."
    } ]
  }, {
    "tStartMs": 802645,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "While C2B, B2B, and B2C"
    } ]
  }, {
    "tStartMs": 806065,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "are covered so thoroughly,\nthere's a lot less coverage for C2C."
    } ]
  }, {
    "tStartMs": 809277,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "This is why the biggest fintech services"
    } ]
  }, {
    "tStartMs": 811237,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "of the modern age like PayPal,\nVenmo, Wise, and Cash App are all"
    } ]
  }, {
    "tStartMs": 815033,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "built on consumer-to-consumer"
    } ]
  }, {
    "tStartMs": 816326,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "transactions because the legacy financial system"
    } ]
  }, {
    "tStartMs": 818745,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "historically regarded"
    } ]
  }, {
    "tStartMs": 819746,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "these payments as too low value to be worth their time."
    } ]
  }, {
    "tStartMs": 822582,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "These days, however,\nthe big banks are fighting back to"
    } ]
  }, {
    "tStartMs": 825084,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "make up ground on consumer-to-consumer transactions"
    } ]
  }, {
    "tStartMs": 827462,
    "dDurationMs": 625,
    "segs": [ {
      "utf8": "through Zelle"
    } ]
  }, {
    "tStartMs": 828087,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "and the networks have set their eyes on"
    } ]
  }, {
    "tStartMs": 830006,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "unlocking greater consumer-to-business\npayment volume by"
    } ]
  }, {
    "tStartMs": 832717,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "encouraging cardholders to now put bigger\nexpenses on their credit cards like rent."
    } ]
  }, {
    "tStartMs": 836763,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "Visa and Mastercard"
    } ]
  }, {
    "tStartMs": 837806,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "have also set their sights on government-to-consumer transactions."
    } ]
  }, {
    "tStartMs": 840934,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Their pitch is that they're software vendors"
    } ]
  }, {
    "tStartMs": 842644,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "as much as they are payment networks. With their tools,"
    } ]
  }, {
    "tStartMs": 845355,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "they pitch that they can help countries\nreach their unbanked"
    } ]
  }, {
    "tStartMs": 847649,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "populations, modernize benefits\ndistribution to citizens,"
    } ]
  }, {
    "tStartMs": 851236,
    "dDurationMs": 875,
    "segs": [ {
      "utf8": "and better inform"
    } ]
  }, {
    "tStartMs": 852111,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "politicians on monetary policy."
    } ]
  }, {
    "tStartMs": 854322,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "And because just about every country in"
    } ]
  }, {
    "tStartMs": 856115,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "the world has some asset"
    } ]
  }, {
    "tStartMs": 857367,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "parked in a big American\nbank, it's a piece of cake for Visa and"
    } ]
  }, {
    "tStartMs": 860453,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Mastercard to get face time\nin front of political decision"
    } ]
  }, {
    "tStartMs": 863122,
    "dDurationMs": 1711,
    "segs": [ {
      "utf8": "makers off of warm introductions"
    } ]
  }, {
    "tStartMs": 864833,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "from the banks themselves."
    } ]
  }, {
    "tStartMs": 866167,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "As a result, the revenue from selling software"
    } ]
  }, {
    "tStartMs": 868294,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "services has increased year after year and will"
    } ]
  }, {
    "tStartMs": 870547,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "continue that way as anyone doing business with the Big"
    } ]
  }, {
    "tStartMs": 873091,
    "dDurationMs": 625,
    "segs": [ {
      "utf8": "4 American banks will"
    } ]
  }, {
    "tStartMs": 873716,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "inevitably do business\nwith Visa or Mastercard."
    } ]
  }, {
    "tStartMs": 876386,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "This is why China and Russia,\nwith their nationalized"
    } ]
  }, {
    "tStartMs": 878638,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "networks,"
    } ]
  }, {
    "tStartMs": 879222,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "banks, and technology, remain\nthe only big markets"
    } ]
  }, {
    "tStartMs": 881850,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "that Visa and Mastercard"
    } ]
  }, {
    "tStartMs": 883017,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "publicly admit that they have no shot of winning."
    } ]
  }, {
    "tStartMs": 885353,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "While they regularly argue"
    } ]
  }, {
    "tStartMs": 886646,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "in public that they have to be able\nto charge the."
    } ]
  }, {
    "tStartMs": 888606,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "swipe fees in order to maintain \nthe security, safety,"
    } ]
  }, {
    "tStartMs": 891526,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "uptime, and reliability of their network,"
    } ]
  }, {
    "tStartMs": 893486,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "the numbers tell a very different story."
    } ]
  }, {
    "tStartMs": 895530,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Visa and Mastercard\nhave only lost money once in the past"
    } ]
  }, {
    "tStartMs": 898408,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "20 years, and that was only due\nto the antitrust settlement."
    } ]
  }, {
    "tStartMs": 901703,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Credit lending at its core, is so profitable for"
    } ]
  }, {
    "tStartMs": 904080,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "both the big issuers and the big networks\nthat profits"
    } ]
  }, {
    "tStartMs": 906749,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "rebounded the year after to"
    } ]
  }, {
    "tStartMs": 908126,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "double digits. In spite of the Great"
    } ]
  }, {
    "tStartMs": 909752,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Recession, margins have remained"
    } ]
  }, {
    "tStartMs": 911671,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "at 30 to 50% across the board every year\nfor the big card issuers and the networks."
    } ]
  }, {
    "tStartMs": 916593,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "While Visa,"
    } ]
  }, {
    "tStartMs": 917343,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "Mastercard, and the Big 4 found the right lanes"
    } ]
  }, {
    "tStartMs": 919679,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "to chase without stepping on each other's\ntoes, they all face the same conundrum"
    } ]
  }, {
    "tStartMs": 923182,
    "dDurationMs": 1419,
    "segs": [ {
      "utf8": "exiting the Great Recession."
    } ]
  }, {
    "tStartMs": 924601,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "It's one thing to maintain"
    } ]
  }, {
    "tStartMs": 925727,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "margins and another to grow the pie."
    } ]
  }, {
    "tStartMs": 927687,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "While the networks focused on technology,\nthe banks needed to evolve"
    } ]
  }, {
    "tStartMs": 931149,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "as card issuers."
    } ]
  }, {
    "tStartMs": 932150,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "They could no longer aggressively prey\non anyone and"
    } ]
  }, {
    "tStartMs": 934277,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "everyone like before,\nwith trick offers and hidden fees."
    } ]
  }, {
    "tStartMs": 937280,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "And they needed to get Americans\noff of debit cards as a swipe"
    } ]
  }, {
    "tStartMs": 940199,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "fees were now capped"
    } ]
  }, {
    "tStartMs": 941075,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "and there was no"
    } ]
  }, {
    "tStartMs": 941659,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "interest to be made, so the big banks\ncollectively changed up their game."
    } ]
  }, {
    "tStartMs": 945204,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "Instead of the stick like before,\nthey opted for carrots."
    } ]
  }, {
    "tStartMs": 948166,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "With rewards, cardholders would be encouraged and"
    } ]
  }, {
    "tStartMs": 950585,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "incentivized to keep spending,\nand every bank invested millions"
    } ]
  }, {
    "tStartMs": 953796,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "into new products to attract prime borrowers"
    } ]
  }, {
    "tStartMs": 956090,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "and to keep their specific cards at the top of wallets."
    } ]
  }, {
    "tStartMs": 958885,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "But to get customers to spend,\nthere needed to be"
    } ]
  }, {
    "tStartMs": 961054,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "flashier, sexier,"
    } ]
  }, {
    "tStartMs": 962138,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "incentives instead of the boring"
    } ]
  }, {
    "tStartMs": 963932,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "conventional 2% cash back"
    } ]
  }, {
    "tStartMs": 965683,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "and 0% Balance transfer.  The banks turned"
    } ]
  }, {
    "tStartMs": 968061,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "credit into a game of points."
    } ]
  }, {
    "tStartMs": 969687,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Americans were hit with dazzling \nnew card products,"
    } ]
  }, {
    "tStartMs": 972148,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "promising tens or hundreds of thousands of"
    } ]
  }, {
    "tStartMs": 974150,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "these virtual made-up points on signup\nthat cost nothing to"
    } ]
  }, {
    "tStartMs": 977070,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "generate and category-based multipliers."
    } ]
  }, {
    "tStartMs": 979656,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "There's no direct dollar"
    } ]
  }, {
    "tStartMs": 980615,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "value, no book liability,\nand the onus is on the cardholder"
    } ]
  }, {
    "tStartMs": 983701,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "to get value out of these points."
    } ]
  }, {
    "tStartMs": 985203,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And since the banks are the creators and"
    } ]
  }, {
    "tStartMs": 986913,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "dispensers of this virtual currency,"
    } ]
  }, {
    "tStartMs": 988790,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "they can freely inflate or devalue\nthese points any time."
    } ]
  }, {
    "tStartMs": 992043,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "And when it comes to marketing,\n10,000 points sounds"
    } ]
  }, {
    "tStartMs": 994587,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "a lot more enticing than $100."
    } ]
  }, {
    "tStartMs": 996839,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "The banking business is all about arbitrage"
    } ]
  }, {
    "tStartMs": 999050,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "and taking something that's"
    } ]
  }, {
    "tStartMs": 1000134,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "worth less in one market\nand selling it in a different"
    } ]
  }, {
    "tStartMs": 1002512,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "market for more."
    } ]
  }, {
    "tStartMs": 1003513,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "They applied that science"
    } ]
  }, {
    "tStartMs": 1004555,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "to credit cards to get consumers to see"
    } ]
  }, {
    "tStartMs": 1006557,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "value in these fake points,\nand to care about accumulating"
    } ]
  }, {
    "tStartMs": 1009143,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "them in the first place."
    } ]
  }, {
    "tStartMs": 1010061,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "They needed to be redeemable\nfor something more meaningful beyond cash."
    } ]
  }, {
    "tStartMs": 1013523,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "The banks"
    } ]
  }, {
    "tStartMs": 1014023,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "found their silver bullet\nin travel partners"
    } ]
  }, {
    "tStartMs": 1016150,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "who were already running loyalty\nprograms of their own and"
    } ]
  }, {
    "tStartMs": 1018653,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "needed ways to"
    } ]
  }, {
    "tStartMs": 1019487,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "reward business travelers\nand to encourage loyalty."
    } ]
  }, {
    "tStartMs": 1022156,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "While co-branded airline credit\ncards and mileage exchange"
    } ]
  }, {
    "tStartMs": 1025034,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "programs first started\nin the 1990s, it was only until"
    } ]
  }, {
    "tStartMs": 1027620,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "after the Great Recession"
    } ]
  }, {
    "tStartMs": 1028788,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "when all the banks began\nto go all-in on this direction."
    } ]
  }, {
    "tStartMs": 1031666,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "They started purchasing\nloyalty points in bulk at a discount"
    } ]
  }, {
    "tStartMs": 1034794,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "directly from the airlines and"
    } ]
  }, {
    "tStartMs": 1035962,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "hotels, to the tune of hundreds\nof millions of dollars"
    } ]
  }, {
    "tStartMs": 1038715,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "for the leading brands."
    } ]
  }, {
    "tStartMs": 1039924,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "The banks then dangled these points in"
    } ]
  }, {
    "tStartMs": 1041509,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "front of cardholders\nto incentivize spending."
    } ]
  }, {
    "tStartMs": 1043761,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "As long as cardholders\nspend, the banks as card"
    } ]
  }, {
    "tStartMs": 1045888,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "issuers will always make their"
    } ]
  }, {
    "tStartMs": 1047098,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "money back on the swipe fees or interest."
    } ]
  }, {
    "tStartMs": 1049225,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "On the other side of the table,\nthe airlines and hotels"
    } ]
  }, {
    "tStartMs": 1051686,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "love these partnerships"
    } ]
  }, {
    "tStartMs": 1052603,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "because they get a huge lump\nsum of cash out of nothing, and they too"
    } ]
  }, {
    "tStartMs": 1055940,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "also have full control\nover the value of these loyalty points."
    } ]
  }, {
    "tStartMs": 1059152,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "They don't incur any costs until"
    } ]
  }, {
    "tStartMs": 1060653,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "a cardholder"
    } ]
  }, {
    "tStartMs": 1061279,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "actually redeems these points\ninto a real reservation."
    } ]
  }, {
    "tStartMs": 1063948,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "And even then, these airlines and hotels,\njust like the banks, can always adjust"
    } ]
  }, {
    "tStartMs": 1067827,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "what, how much, and where these points\ncan be used to minimize losses."
    } ]
  }, {
    "tStartMs": 1071664,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "But there's only so many airlines"
    } ]
  }, {
    "tStartMs": 1073041,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "and hotels in the world,\nand only a few of them are truly valuable"
    } ]
  }, {
    "tStartMs": 1076127,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "enough for their loyalty"
    } ]
  }, {
    "tStartMs": 1077253,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "points to be worth chasing"
    } ]
  }, {
    "tStartMs": 1078629,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "in the eyes of consumers."
    } ]
  }, {
    "tStartMs": 1080339,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "It's a case of where the rich get richer,"
    } ]
  }, {
    "tStartMs": 1082216,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "leading airlines and hotels get to demand\ngreater payouts and higher valuations"
    } ]
  }, {
    "tStartMs": 1086095,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "for their points and the money they make"
    } ]
  }, {
    "tStartMs": 1087680,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "selling these points to the big banks\nsurpass what"
    } ]
  }, {
    "tStartMs": 1090058,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "their smaller rivals make by orders of magnitude."
    } ]
  }, {
    "tStartMs": 1092852,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "The banks in this angle have"
    } ]
  }, {
    "tStartMs": 1094020,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "progressively less negotiating power."
    } ]
  }, {
    "tStartMs": 1095855,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "The appeal of their"
    } ]
  }, {
    "tStartMs": 1096606,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "cards lie"
    } ]
  }, {
    "tStartMs": 1097106,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "in these virtual points,\nwhich are ultimately only valuable"
    } ]
  }, {
    "tStartMs": 1099859,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "if they're redeemable at leading brands."
    } ]
  }, {
    "tStartMs": 1101986,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "If they want to keep their cardholders, their"
    } ]
  }, {
    "tStartMs": 1103821,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "spending, and their balances,\nthey really have no choice"
    } ]
  }, {
    "tStartMs": 1106324,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "but to pay for these carrots,\nno matter how expensive they get."
    } ]
  }, {
    "tStartMs": 1109035,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "The Big 4 through the 2010s \nfound themselves in a"
    } ]
  }, {
    "tStartMs": 1111454,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "new arms race to partner with brands outside"
    } ]
  }, {
    "tStartMs": 1113623,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "of travel and leisure."
    } ]
  }, {
    "tStartMs": 1114749,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "Leading brands like Kroger, Amazon,"
    } ]
  }, {
    "tStartMs": 1116793,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Ikea, and Costco have all partnered"
    } ]
  }, {
    "tStartMs": 1118503,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "with banks to launch co-branded credit cards."
    } ]
  }, {
    "tStartMs": 1120755,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Since these retailers\ndon't have loyalty programs,"
    } ]
  }, {
    "tStartMs": 1123257,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "the only reward they can offer\ncardholders"
    } ]
  }, {
    "tStartMs": 1125301,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "is cash back. But the banks are happy\nto offer these products"
    } ]
  }, {
    "tStartMs": 1128513,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "because these brands bring their established,\nmature customer base who are already"
    } ]
  }, {
    "tStartMs": 1132141,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "paying and spending money\ntoday, albeit with a bunch"
    } ]
  }, {
    "tStartMs": 1134602,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "of random cards."
    } ]
  }, {
    "tStartMs": 1135812,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "Co-branded credit cards are"
    } ]
  }, {
    "tStartMs": 1137021,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "meant to consolidate and to funnel\nthe spending into one specific card,"
    } ]
  }, {
    "tStartMs": 1140566,
    "dDurationMs": 543,
    "segs": [ {
      "utf8": "and it's a no"
    } ]
  }, {
    "tStartMs": 1141109,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "brainer, as taking 2% on\nevery Amazon order is no small fortune."
    } ]
  }, {
    "tStartMs": 1144946,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "But these retailers\nwant their share of the pie, too."
    } ]
  }, {
    "tStartMs": 1147406,
    "dDurationMs": 543,
    "segs": [ {
      "utf8": "Whenever they"
    } ]
  }, {
    "tStartMs": 1147949,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "successfully sign up a customer to \ntheir credit card, the"
    } ]
  }, {
    "tStartMs": 1150409,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "issuing bank that they've partnered\nwith pays them a cash bounty."
    } ]
  }, {
    "tStartMs": 1153454,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "This is why flight attendants will pitch"
    } ]
  }, {
    "tStartMs": 1154956,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "passengers before landing about the credit\ncard, and cashiers will also"
    } ]
  }, {
    "tStartMs": 1158209,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "pitch shoppers at checkout."
    } ]
  }, {
    "tStartMs": 1159627,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "The issuing bank will also provide\nrebates and revenue sharing"
    } ]
  }, {
    "tStartMs": 1162588,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "so whenever these cardholders use these"
    } ]
  }, {
    "tStartMs": 1164507,
