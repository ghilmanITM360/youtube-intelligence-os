    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "or hotel, which was the norm in the 1990s."
    } ]
  }, {
    "tStartMs": 1444662,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "American Express was also the first to build premium"
    } ]
  }, {
    "tStartMs": 1446956,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "airline lounges for its cardholders, a perk"
    } ]
  }, {
    "tStartMs": 1449333,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "that Chase and Citibank\nare now emulating a decade later."
    } ]
  }, {
    "tStartMs": 1452294,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "Without the high interest income,"
    } ]
  }, {
    "tStartMs": 1453838,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Amex's credit card"
    } ]
  }, {
    "tStartMs": 1454839,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "business is much lower margin\nthan any of its rivals."
    } ]
  }, {
    "tStartMs": 1457758,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "The highest margin business\nfor American Express"
    } ]
  }, {
    "tStartMs": 1459844,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "instead is in the payments network"
    } ]
  }, {
    "tStartMs": 1461512,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "in the authorization,\nclearing, and settlement of transactions."
    } ]
  }, {
    "tStartMs": 1465266,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Credit lending is a highly resilient and\nlucrative business, whether at the top,"
    } ]
  }, {
    "tStartMs": 1468936,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "middle or bottom of the market."
    } ]
  }, {
    "tStartMs": 1470521,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "It's why Goldman Sachs jumped"
    } ]
  }, {
    "tStartMs": 1471939,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "headfirst to launch a card with Apple."
    } ]
  }, {
    "tStartMs": 1474024,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "Like the Starbucks,"
    } ]
  }, {
    "tStartMs": 1474942,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "General Motors, and the Uber card before it,"
    } ]
  }, {
    "tStartMs": 1477111,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "It's not a slam dunk\nunless you're in the Big 4."
    } ]
  }, {
    "tStartMs": 1479405,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "The money is really in the interest,\nwhich only comes from getting people"
    } ]
  }, {
    "tStartMs": 1482366,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "to carry balances\nand all the gamification that people."
    } ]
  }, {
    "tStartMs": 1484994,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "do with credit cards"
    } ]
  }, {
    "tStartMs": 1485828,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "these days and hoarding points, timing redemptions,"
    } ]
  }, {
    "tStartMs": 1488622,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "researching tier lists,\nand projecting their future"
    } ]
  }, {
    "tStartMs": 1490833,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "lifestyle on these pieces of plastic and metal"
    } ]
  }, {
    "tStartMs": 1493085,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "are all carrots planted by the banks\nto get people addicted to spending."
    } ]
  }, {
    "tStartMs": 1496672,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "American Express and Discover are"
    } ]
  }, {
    "tStartMs": 1498257,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "ultimately too small as networks\nto have any real influence in"
    } ]
  }, {
    "tStartMs": 1501469,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "anything they do in terms of."
    } ]
  }, {
    "tStartMs": 1502720,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "Innovation is easily\ncopied by the Big 4, who have the"
    } ]
  }, {
    "tStartMs": 1505556,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "pockets, inside connections, and influence\nto make a bigger splash."
    } ]
  }, {
    "tStartMs": 1509226,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "When Amex acquired Resy"
    } ]
  }, {
    "tStartMs": 1510394,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "to get more into the high-end restaurant space,"
    } ]
  }, {
    "tStartMs": 1512354,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "Chase responded just two years later\nby buying out The Infatuation and Zagat."
    } ]
  }, {
    "tStartMs": 1516859,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "It's much easier for banks to cross-sell\ncredit cards"
    } ]
  }, {
    "tStartMs": 1519236,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "to individuals that they have an existing\nbanking relationship with,"
    } ]
  }, {
    "tStartMs": 1522239,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "and the average American\nis not going to be"
    } ]
  }, {
    "tStartMs": 1524033,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "as technical as a Redditor\nwhen it comes to signing up for"
    } ]
  }, {
    "tStartMs": 1526285,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "cards and redeeming rewards. Both"
    } ]
  }, {
    "tStartMs": 1528412,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "Amex and Discover\nhave tried to move more downstream"
    } ]
  }, {
    "tStartMs": 1530748,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "with checking and savings products,\nbut their personal"
    } ]
  }, {
    "tStartMs": 1533209,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "banking products will always be \ninferior to the Big 4."
    } ]
  }, {
    "tStartMs": 1536086,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Ultimately, the biggest"
    } ]
  }, {
    "tStartMs": 1537046,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "profiteers from credit cards are not"
    } ]
  }, {
    "tStartMs": 1538756,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "the networks, but rather the big banks - and Visa"
    } ]
  }, {
    "tStartMs": 1541342,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "and Mastercard, at their core, only"
    } ]
  }, {
    "tStartMs": 1543177,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "exist as a duopoly"
    } ]
  }, {
    "tStartMs": 1544470,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "to enrich and to protect their creators."
    } ]
  }, {
    "tStartMs": 1546639,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "The only thing"
    } ]
  }, {
    "tStartMs": 1547223,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "that has ever poked a hole in this power structure"
    } ]
  }, {
    "tStartMs": 1549350,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "were the buy now, pay later startups in Klarna, Afterpay,"
    } ]
  }, {
    "tStartMs": 1552394,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "and Affirm."
    } ]
  }, {
    "tStartMs": 1552978,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "Buy now, Pay Later"
    } ]
  }, {
    "tStartMs": 1553687,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "was a direct alternative\nto credit cards."
    } ]
  }, {
    "tStartMs": 1556065,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "If consumers started\nto prefer these pay-in-four plans,"
    } ]
  }, {
    "tStartMs": 1558734,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "then they would stop carrying balances\non their credit cards."
    } ]
  }, {
    "tStartMs": 1561237,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "Then these new Silicon Valley middlemen\nwould rake in the billions of dollars"
    } ]
  }, {
    "tStartMs": 1564865,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "of interest that normally flowed\ninto the pockets of the big banks."
    } ]
  }, {
    "tStartMs": 1568160,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "And because Affirm, Klarna, and Afterpay"
    } ]
  }, {
    "tStartMs": 1570496,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "had inserted themselves."
    } ]
  }, {
    "tStartMs": 1571497,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "ahead of the credit card"
    } ]
  }, {
    "tStartMs": 1572581,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "statement, then the banks would lose out\non their most"
    } ]
  }, {
    "tStartMs": 1574625,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "valuable and highest margin revenue stream."
    } ]
  }, {
    "tStartMs": 1576835,
    "dDurationMs": 2712,
    "segs": [ {
      "utf8": "This is why the Big 4 reacted\nso quickly and aggressively."
    } ]
  }, {
    "tStartMs": 1579547,
    "dDurationMs": 458,
    "segs": [ {
      "utf8": "They rolled out"
    } ]
  }, {
    "tStartMs": 1580005,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "Buy now, Pay"
    } ]
  }, {
    "tStartMs": 1580589,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "Later programs of their own\nand they banned cardholders"
    } ]
  }, {
    "tStartMs": 1582967,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "from using their credit cards\nto pay for these services"
    } ]
  }, {
    "tStartMs": 1585344,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "in an effort to squeeze these \nstartups out of"
    } ]
  }, {
    "tStartMs": 1587596,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "the financial system entirely. It's hard\nto believe that the recent congressional"
    } ]
  }, {
    "tStartMs": 1591183,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "hearings are nothing more than populist\npolitical theater"
    } ]
  }, {
    "tStartMs": 1593811,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "as the real puppet\nmasters are nowhere in the room"
    } ]
  }, {
    "tStartMs": 1596063,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "and no politician\nis going to go after them."
    } ]
  }, {
    "tStartMs": 1598566,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "This network duopoly of Visa and"
    } ]
  }, {
    "tStartMs": 1600442,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Mastercard is no accident, but"
    } ]
  }, {
    "tStartMs": 1602152,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "rather the result of"
    } ]
  }, {
    "tStartMs": 1603112,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "a multi-decade-long"
    } ]
  }, {
    "tStartMs": 1604071,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "conspiracy to protect the old guard and"
    } ]
  }, {
    "tStartMs": 1606115,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "to keep power in the hands of America's"
    } ]
  }, {
    "tStartMs": 1607866,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "biggest banks - that are too big to fail\nand now too cunning to be singled out."
    } ]
  } ]
}
