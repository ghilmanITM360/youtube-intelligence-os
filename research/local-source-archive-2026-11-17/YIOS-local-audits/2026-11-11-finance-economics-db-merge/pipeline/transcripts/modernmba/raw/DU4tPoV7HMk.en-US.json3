  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 13763,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Every weekend in towns across the US,"
    } ]
  }, {
    "tStartMs": 16224,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "Americans of all ages flood\ninto shopping malls, convention centers,"
    } ]
  }, {
    "tStartMs": 20186,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "and stores with binders full of Pokémon\ncards and sling bags full of cash."
    } ]
  }, {
    "tStartMs": 24983,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "These local card shows are flourishing\nas real-world spaces"
    } ]
  }, {
    "tStartMs": 28236,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "for the Pokémon community\nto meet, trade, and connect."
    } ]
  }, {
    "tStartMs": 31906,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "The modern Pokémon card\nmarket is a mass market phenomenon"
    } ]
  }, {
    "tStartMs": 35160,
    "dDurationMs": 4671,
    "segs": [ {
      "utf8": "unlike any other part hobby, part\ninvestment, and part cultural revival."
    } ]
  }, {
    "tStartMs": 40248,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "While sneakers and Labubu dolls\nturned into cold transactional"
    } ]
  }, {
    "tStartMs": 43251,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "secondary markets driven by \nexclusion and exploitation,"
    } ]
  }, {
    "tStartMs": 46713,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "the Pokémon card scene\nhas thrived on community spirit."
    } ]
  }, {
    "tStartMs": 50216,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "This culture of inclusion\nand transparency has remarkably persisted"
    } ]
  }, {
    "tStartMs": 54179,
    "dDurationMs": 4754,
    "segs": [ {
      "utf8": "even under this current boom, as money\nscalpers and scammers have all flowed in."
    } ]
  }, {
    "tStartMs": 59559,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "Pokémon cards have reached \nrecord value across the board"
    } ]
  }, {
    "tStartMs": 62395,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "as the ones that were worth tens\nor hundreds of dollars"
    } ]
  }, {
    "tStartMs": 65023,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "just 2 to 3 years ago\nhave reached thousands this year."
    } ]
  }, {
    "tStartMs": 68860,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Even though personal profit\nis the primary motive,"
    } ]
  }, {
    "tStartMs": 71654,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "information and insights circulate openly."
    } ]
  }, {
    "tStartMs": 74657,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Personal wins and losses get documented\npublicly."
    } ]
  }, {
    "tStartMs": 77535,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "Veterans act as teachers and historians\nas much as traders, broadcasting"
    } ]
  }, {
    "tStartMs": 81790,
    "dDurationMs": 4921,
    "segs": [ {
      "utf8": "their experiences, tips, and philosophies\nonline before they even have audiences."
    } ]
  }, {
    "tStartMs": 87045,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "Vendors operate like long-term enterprises\nrather than short term flippers,"
    } ]
  }, {
    "tStartMs": 90840,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "leaning into relationships,"
    } ]
  }, {
    "tStartMs": 92342,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "personality, and education\nrather than product to drive sales."
    } ]
  }, {
    "tStartMs": 96638,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "All of these help blunt the learning curve\nfor newcomers and reinforce"
    } ]
  }, {
    "tStartMs": 99849,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "a culture of camaraderie\nrarely seen in secondary markets."
    } ]
  }, {
    "tStartMs": 104104,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "The commercial resurgence of Pokémon\ncards has not gone unnoticed."
    } ]
  }, {
    "tStartMs": 108024,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Entertainment franchises\nwith comparable universes like One Piece"
    } ]
  }, {
    "tStartMs": 111653,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and Disney all have launched\ntrading cards of their own."
    } ]
  }, {
    "tStartMs": 114948,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "But what's happening today is not unique."
    } ]
  }, {
    "tStartMs": 117283,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "Humans through centuries have pursued\na variety of collectibles motivated"
    } ]
  }, {
    "tStartMs": 121037,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "by the universal psychology of completion\nism, the desire of ownership,"
    } ]
  }, {
    "tStartMs": 125083,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "the impulse to chase rarity,\nand the speculation of future profit."
    } ]
  }, {
    "tStartMs": 129462,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "What has driven all these markets in\nevery generation is the promise of money,"
    } ]
  }, {
    "tStartMs": 133216,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "not just for the producers, but\nalso for consumers, where their purchase"
    } ]
  }, {
    "tStartMs": 136761,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "holds the potential to turn into a life\nchanging fortune."
    } ]
  }, {
    "tStartMs": 139806,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "Yet collectibles are more emotional\nthan economic as markets where herd"
    } ]
  }, {
    "tStartMs": 143685,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "mentality drives value as much as rarity."
    } ]
  }, {
    "tStartMs": 146729,
    "dDurationMs": 835,
    "segs": [ {
      "utf8": "From this lens,"
    } ]
  }, {
    "tStartMs": 147564,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "Pokémon cards are just the latest\nin a long history of tradable assets."
    } ]
  }, {
    "tStartMs": 152402,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "To get beyond headlines and conjecture,\nwe've scraped every valuable Pokémon"
    } ]
  }, {
    "tStartMs": 156322,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "card from every set and era to quantify\nthe rationale behind the irrational"
    } ]
  }, {
    "tStartMs": 160535,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "and to form a comprehensive, objective\nlook inside this crazy world"
    } ]
  }, {
    "tStartMs": 165039,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "with record prices,\nappreciation, and sales volume."
    } ]
  }, {
    "tStartMs": 168084,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "The line between hobby and business\nhas rapidly disappeared."
    } ]
  }, {
    "tStartMs": 171504,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "In this Modern MBA Original, we go boots on the \nground across the U.S. and Japan to understand"
    } ]
  }, {
    "tStartMs": 175258,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "what it takes to succeed beyond blind luck\nin this unpredictable, volatile market"
    } ]
  }, {
    "tStartMs": 179596,
    "dDurationMs": 5672,
    "segs": [ {
      "utf8": "through the eyes of Riki, a savvy part-timer \nwho earns just under $250,000 a year"
    } ]
  }, {
    "tStartMs": 185310,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "dealing cards on the side, and Jason,\nan elite globetrotter who pulls in nearly"
    } ]
  }, {
    "tStartMs": 189564,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "$1 million as one of the leading sellers\nof Japanese exclusives."
    } ]
  }, {
    "tStartMs": 195403,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "Every business is"
    } ]
  }, {
    "tStartMs": 196321,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "asking the same question -\nhow do we make AI work for us?"
    } ]
  }, {
    "tStartMs": 199657,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "The possibilities are endless"
    } ]
  }, {
    "tStartMs": 201326,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "and guessing is too risky."
    } ]
  }, {
    "tStartMs": 203077,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "But sitting on the sidelines"
    } ]
  }, {
    "tStartMs": 204370,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "is not an option because \none thing is almost certain."
    } ]
  }, {
    "tStartMs": 207332,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Your competitors are already\nmaking their move."
    } ]
  }, {
    "tStartMs": 209876,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "No more waiting. With NetSuite by Oracle,\nyou can put AI to work today."
    } ]
  }, {
    "tStartMs": 214088,
    "dDurationMs": 5381,
    "segs": [ {
      "utf8": "NetSuite is the number one AI cloud ERP\ntrusted by over 43,000 businesses."
    } ]
  }, {
    "tStartMs": 219510,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "NetSuite is a unified suite\nthat brings your financials,"
    } ]
  }, {
    "tStartMs": 222555,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "inventory, commerce, HR, and CRM\ninto a single source of truth."
    } ]
  }, {
    "tStartMs": 227060,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Every business produces data,\nbut whether you have the time"
    } ]
  }, {
    "tStartMs": 230063,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "to make sense of it is the difference\nbetween stagnation and success."
    } ]
  }, {
    "tStartMs": 233650,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Even great instincts\nonly get better with data."
    } ]
  }, {
    "tStartMs": 236236,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "By connecting all of your data\nin NetSuite, your AI gets smarter."
    } ]
  }, {
    "tStartMs": 239948,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "It doesn't guess."
    } ]
  }, {
    "tStartMs": 241658,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "NetSuite intelligently automates\nroutine tasks"
    } ]
  }, {
    "tStartMs": 244202,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "so your staff can focus on real value,\ndeliver actionable insights, help"
    } ]
  }, {
    "tStartMs": 248373,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "you cut costs, and make fast,\nAI powered decisions with confidence."
    } ]
  }, {
    "tStartMs": 252168,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "NetSuite isn't another bolted-on tool."
    } ]
  }, {
    "tStartMs": 254295,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "It's AI built into the system\nthat runs your business."
    } ]
  }, {
    "tStartMs": 257423,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "As we scale Modern MBA, we'll\nbe using NetSuite and you should too."
    } ]
  }, {
    "tStartMs": 261344,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "We sit on a mountain of data"
    } ]
  }, {
    "tStartMs": 262804,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "across viewership, engagement,\ndemographics, revenue, and cost."
    } ]
  }, {
    "tStartMs": 266557,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "But production is so intense that no one\nhas the bandwidth to analyze the business."
    } ]
  }, {
    "tStartMs": 270770,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "It's only gotten tougher as we've expanded\nproduction across multiple countries,"
    } ]
  }, {
    "tStartMs": 274399,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "increased budgets by double, and tripled\nthe research per video."
    } ]
  }, {
    "tStartMs": 277568,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "We're constantly balancing\ncreativity with economics, but insight is"
    } ]
  }, {
    "tStartMs": 281114,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "hard to get without pulling ourselves away\nfrom what we do best."
    } ]
  }, {
    "tStartMs": 284200,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "And we can't trust a random AI tool\nthat doesn't have the full picture"
    } ]
  }, {
    "tStartMs": 287704,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "and pretends to be right\nwhen it's actually wrong."
    } ]
  }, {
    "tStartMs": 290039,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "Whether your company earns millions\nor even hundreds of millions,"
    } ]
  }, {
    "tStartMs": 293251,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "NetSuite helps\nyou stay ahead of the pack right now."
    } ]
  }, {
    "tStartMs": 296004,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "Get the business guide:"
    } ]
  }, {
    "tStartMs": 296963,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Demystifying AI free at NetSuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 302343,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "The guide is free to you\nat netsuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 307056,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "netsuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 319652,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Like many millennials who grew \nup on the franchise,"
    } ]
  }, {
    "tStartMs": 322196,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "Riki didn't get back into the scene\nuntil this recent boom."
    } ]
  }, {
    "tStartMs": 325616,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "Today, he's one of the fastest\ngrowing content creators and vendors"
    } ]
  }, {
    "tStartMs": 329120,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "recognized at card shows nationwide."
    } ]
  }, {
    "tStartMs": 342717,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "There are three ways to make money\nin Pokemon cards."
    } ]
  }, {
    "tStartMs": 345678,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "The most popular method is trading\nsingles, where you buy specific cards with"
    } ]
  }, {
    "tStartMs": 349974,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "the goal of reselling them for a profit\nonce their market value increases."
    } ]
  }, {
    "tStartMs": 354228,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "With tens of thousands of cards\nin circulation, You need to be able"
    } ]
  }, {
    "tStartMs": 357523,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "to identify the few that are valuable,\nrecognize all their possible variants,"
    } ]
  }, {
    "tStartMs": 361569,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "and then form a thesis as to why\nit will be worth more in the future."
    } ]
  }, {
    "tStartMs": 365323,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Appreciation can range from tens\nto thousands of dollars,"
    } ]
  }, {
    "tStartMs": 368368,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "and in this bull market,\nthere's opportunity at every level."
    } ]
  }, {
    "tStartMs": 372538,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "After selling $10,000 worth of \ninventory last weekend,"
    } ]
  }, {
    "tStartMs": 375792,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Riki today is sourcing cards\nto restock for his next show."
    } ]
  }, {
    "tStartMs": 398940,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Pokemon cards operate on"
    } ]
  }, {
    "tStartMs": 400483,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "engineered scarcity, randomized\ndistribution, and pack-based sales."
    } ]
  }, {
    "tStartMs": 404987,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "This playbook is the foundation\nof the entire trading card game genre."
    } ]
  }, {
    "tStartMs": 408991,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "Cardmakers purposely"
    } ]
  }, {
    "tStartMs": 410118,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "design certain cards in a set\nas rare and desirable chase cards."
    } ]
  }, {
    "tStartMs": 414163,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "They print them in small quantities"
    } ]
  }, {
    "tStartMs": 415706,
    "dDurationMs": 3713,
    "segs": [ {
      "utf8": "and generate demand through aesthetic\nand/or competitive differentiation."
    } ]
  }, {
    "tStartMs": 419502,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "But not all chase cards are created equal."
    } ]
  }, {
    "tStartMs": 422463,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "In 1999, the probability\nof pulling a chase card out of a Pokemon"
    } ]
  }, {
    "tStartMs": 426217,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "pack varied, as there was a hierarchy\nto rarity for holographic rares."
    } ]
  }, {
    "tStartMs": 430555,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "The odds hovered between 1% and 3%,\nBut to get the rarest,"
    } ]
  }, {
    "tStartMs": 434392,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "the odds were below 1%, meaning\nunlucky customers would need to buy"
    } ]
  }, {
    "tStartMs": 437812,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "hundreds or thousands of packs for a chance."
    } ]
  }, {
    "tStartMs": 441941,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Back then, collectors were \nencouraged to buy packs"
    } ]
  }, {
    "tStartMs": 444527,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "to assemble the most powerful \nPokemon deck for competition."
    } ]
  }, {
    "tStartMs": 447947,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "The market chased cards\nthat gave the strongest competitive edge."
    } ]
  }, {
    "tStartMs": 451367,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Today, scarcity\nis still the main ingredient,"
    } ]
  }, {
    "tStartMs": 453828,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "but the boom is all about nostalgia\nand aesthetics."
    } ]
  }, {
    "tStartMs": 456747,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "This is why the secondary market is\nso heavily concentrated in singles."
    } ]
  }, {
    "tStartMs": 461002,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "Consumers can make efficient, targeted\npurchases for the exact Pokemon cards"
    } ]
  }, {
    "tStartMs": 465298,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "they want and bypass the randomized\nlottery pack model entirely."
    } ]
  }, {
    "tStartMs": 469802,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The ROI for pulling chase\ncards is at a record high,"
    } ]
  }, {
    "tStartMs": 472805,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "even for the latest sets that are only\na few weeks old, as the lucky few"
    } ]
  }, {
    "tStartMs": 476601,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "can instantly flip their hauls\nat massive premiums."
    } ]
  }, {
    "tStartMs": 479896,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "Riki represents the demographic that's\ndriven most of this present day boom"
    } ]
  }, {
    "tStartMs": 483816,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "educated, economical, sociable millennials\nthat have brought their professional"
    } ]
  }, {
    "tStartMs": 487695,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "backgrounds, career mindset, and childhood\nnostalgia into the hobby."
    } ]
  }, {
    "tStartMs": 491949,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "His stable tech job gives him freedom\nto run the business on his own terms."
    } ]
  }, {
    "tStartMs": 495870,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "Riki deals in singles\nwhere he can control spend and exposure"
    } ]
  }, {
    "tStartMs": 499373,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "to the exact cards he believes in."
    } ]
  }, {
    "tStartMs": 501501,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "There are more than 23,000 English\nlanguage Pokemon cards in circulation,"
    } ]
  }, {
    "tStartMs": 505588,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "spanning over 1000 species\nand 400 human characters every year."
    } ]
  }, {
    "tStartMs": 510092,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "New characters are introduced\ninto the franchise roster and card game."
    } ]
  }, {
    "tStartMs": 514055,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "Ultimately, every card in\nevery pack is exclusive to a set,"
    } ]
  }, {
    "tStartMs": 517808,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "and every set is part of a larger series\nthat typically runs for 2 to 3 years,"
    } ]
  }, {
    "tStartMs": 522021,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "comprising a total of 1,000\nto 3,000 distinct cards."
    } ]
  }, {
    "tStartMs": 525983,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Like most collectibles, age drives\nthe greatest value."
    } ]
  }, {
    "tStartMs": 529445,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "It's why the chase cards of 1999\nand the early 2000s"
    } ]
  }, {
    "tStartMs": 532823,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "are worth exponentially more today\nthan their modern counterparts."
    } ]
  }, {
    "tStartMs": 536911,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "But even the dedicated fans,\nlet alone part-timers like Ricky,"
    } ]
  }, {
    "tStartMs": 540248,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "must rely on an even higher level\nabstraction of "
    } ]
  }, {
    "tStartMs": 543334,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "eras to make sense\nof the ever expanding supply."
    } ]
  }, {
    "tStartMs": 603019,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "Like most grassroots terminology,"
    } ]
  }, {
    "tStartMs": 604854,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "there's no official consensus\non when each era begins or ends."
    } ]
  }, {
    "tStartMs": 608733,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Ultimately, Riki's\nframing is reflected in the data"
    } ]
  }, {
    "tStartMs": 611736,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "At a macro level,\nthe Pokémon Company is cashing in"
    } ]
  }, {
    "tStartMs": 614530,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "as they're printing more cards\nin this modern era than ever before,"
    } ]
  }, {
    "tStartMs": 617950,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "and they've refreshed\nchase cards as mainstream collectibles"
    } ]
  }, {
    "tStartMs": 620494,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "that can appeal to outsiders\nas much as fans."
    } ]
  }, {
    "tStartMs": 623664,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "Modern chase cards, in lieu of nostalgia,\nboast layered textures, edge to edge"
    } ]
  }, {
    "tStartMs": 627877,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "artwork, dynamic poses,\nfull illustrations, and vivid"
    } ]
  }, {
    "tStartMs": 631505,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "color palettes that surpass\nthe simplicity of their predecessors."
    } ]
  }, {
    "tStartMs": 635468,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "Art has become the primary justification\nfor modern cards soaring to hundreds"
    } ]
  }, {
    "tStartMs": 639513,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "or thousands of dollars\njust weeks after their release."
    } ]
  }, {
    "tStartMs": 642850,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "There are effectively two different\nmarkets within English Pokemon cards."
    } ]
  }, {
    "tStartMs": 646937,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "The vintage era is a low volume,\nhigh value, high cost niche market where"
    } ]
  }, {
    "tStartMs": 651192,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "profitably trading singles requires\nspecialized knowledge and deep pockets."
    } ]
  }, {
    "tStartMs": 655655,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "Prices here are generally more stable\nand the appreciation is more consistent."
    } ]
  }, {
    "tStartMs": 660159,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "The modern era, by contrast,\nis high volume,"
    } ]
  }, {
    "tStartMs": 662912,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "high liquidity, broadly accessible, and low cost."
    } ]
  }, {
    "tStartMs": 666499,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "Under conventional logic,\nthe high supply should push prices down."
    } ]
  }, {
    "tStartMs": 669960,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "But what's out there is still not enough\nto meet today's unprecedented demand."
    } ]
  }, {
    "tStartMs": 674215,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "The downside to dealing in modern\nsingles is volatility."
    } ]
  }, {
    "tStartMs": 677551,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "The abundance of public data means"
    } ]
  }, {
    "tStartMs": 679261,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "less risk, and success is more timing than expertise."
    } ]
  }, {
    "tStartMs": 683015,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Like most in the hobby,\nRiki's inventory has grown to encompass"
    } ]
  }, {
    "tStartMs": 686644,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "a little bit of everything, but modern\nEnglish remains his bread-and-butter"
    } ]
  }, {
    "tStartMs": 690940,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "and like every buyer and seller, \nRiki doesn't trade without checking the numbers."
    } ]
  }, {
    "tStartMs": 749498,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "The demand for individual cards"
    } ]
  }, {
    "tStartMs": 751167,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "is also fueled by the widening cost gap\nbetween singles and packs."
    } ]
  }, {
    "tStartMs": 755004,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Modern singles are hitting record prices\nat record speed, but it's still cheaper"
    } ]
  }, {
    "tStartMs": 759008,
    "dDurationMs": 459,
    "segs": [ {
      "utf8": "and faster"
    } ]
  }, {
    "tStartMs": 759467,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "to buy one of these singles outright\nthan it is to gamble on sealed packs."
    } ]
  }, {
    "tStartMs": 763304,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "For packs, the odds have never been worse."
    } ]
  }, {
    "tStartMs": 765848,
    "dDurationMs": 5631,
    "segs": [ {
      "utf8": "In 1999, the average series wide\npull rate for top chase cards was 1.4%."
    } ]
  }, {
    "tStartMs": 771729,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Today, it's 0.3%."
    } ]
  }, {
    "tStartMs": 774315,
    "dDurationMs": 4796,
    "segs": [ {
      "utf8": "Over time, The Pokémon Company has stuffed\nsets with more cards to maximize sales."
    } ]
  }, {
    "tStartMs": 779445,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "The 1999 set had 113 cards,"
    } ]
  }, {
    "tStartMs": 782281,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "for a total of 1129 cards in the series."
    } ]
  }, {
    "tStartMs": 786202,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Today, there are over twice\nas many cards in a set and three times"
    } ]
  }, {
    "tStartMs": 790039,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "as many in a series,"
    } ]
  }, {
    "tStartMs": 791290,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "dramatically diluting the chances\nof pulling the most valuable chase card."
    } ]
  }, {
    "tStartMs": 795795,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Like lottery tickets or slot spins,\nPokemon"
    } ]
  }, {
    "tStartMs": 798339,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "packs are deliberately priced\nto feel harmless."
    } ]
  }, {
    "tStartMs": 801425,
    "dDurationMs": 4838,
    "segs": [ {
      "utf8": "The MSRP is $5 for a single pack\nof ten cards, $14 for three"
    } ]
  }, {
    "tStartMs": 806263,
    "dDurationMs": 5673,
    "segs": [ {
      "utf8": "packs, $27 for six packs, and $162\nfor a box of 36 packs."
    } ]
  }, {
    "tStartMs": 812353,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "But scalpers snap up pallets\nas soon as they hit the sales floor,"
    } ]
  }, {
    "tStartMs": 815564,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "while scammers weigh packs to identify\nthe ones containing chase cards"
    } ]
  }, {
    "tStartMs": 819151,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "as the special foils, textures\nand extra ink allegedly make them heavier."
    } ]
  }, {
    "tStartMs": 824114,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Some open packs replace valuable cards\nwith worthless commons"
    } ]
  }, {
    "tStartMs": 827743,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and then reseal them\nbefore flipping it to the unaware."
    } ]
  }, {
    "tStartMs": 830830,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "As a result, consumers have shifted\ntowards factory sealed bundles, boxes"
    } ]
  }, {
    "tStartMs": 835042,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "and tins. They've become collectibles\nthemselves, where a single unopened"
    } ]
  }, {
    "tStartMs": 838838,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "box can sell for thousands\nor even tens of thousands of dollars."
    } ]
  }, {
    "tStartMs": 842633,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "This dynamic has created the second way\nto make money in Pokemon cards,"
    } ]
  }, {
    "tStartMs": 846804,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "holding sealed product."
    } ]
  }, {
    "tStartMs": 848931,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "The appreciation of a sealed booster\nbox is directly correlated with the market"
    } ]
  }, {
    "tStartMs": 853310,
    "dDurationMs": 4797,
    "segs": [ {
      "utf8": "value of the top chase cards available\nin that set, and in today's environment,"
    } ]
  }, {
    "tStartMs": 858107,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "where even new releases\nare still impossible to find,"
    } ]
  }, {
    "tStartMs": 861193,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "sealed products from sets\nthat are still in active print appreciate"
    } ]
  }, {
    "tStartMs": 864488,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "rapidly selling double or triple their MSRP."
    } ]
  }, {
    "tStartMs": 868117,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Everything we've covered so far,"
    } ]
  }, {
    "tStartMs": 869660,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "chase cards"
    } ]
  }, {
    "tStartMs": 870494,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "and sealed product all fundamentally\nderive their value from supply rarity."
    } ]
  }, {
    "tStartMs": 874832,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The fewer copies that exist, the higher\nthe price."
    } ]
  }, {
    "tStartMs": 878002,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "As time passes, their greater\nscarcity leads to appreciation."
    } ]
  }, {
    "tStartMs": 882047,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "But rarity isn't just about how many cards\nexist,"
    } ]
  }, {
    "tStartMs": 884967,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "it's also about how many survived\nin perfect condition."
    } ]
  }, {
    "tStartMs": 888345,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "Print quality is a longstanding issue\namong English language Pokémon cards,"
    } ]
  }, {
    "tStartMs": 892391,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "where the rush mass production results\nin constant visual manufacturing errors"
    } ]
  }, {
    "tStartMs": 896520,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "like off centering,\nmiss cut edges, smudges, or scratches."
    } ]
  }, {
    "tStartMs": 900858,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "This means that condition rarity\nactually starts at the factory."
    } ]
  }, {
    "tStartMs": 904486,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "But because condition is subjective,\ncompanies like PSA, CGC, and BGS"
    } ]
  }, {
    "tStartMs": 909366,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "have emerged as third-party authorities\nthat grade cards on a 10 point scale."
    } ]
  }, {
    "tStartMs": 914288,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "A PSA 10 is a virtually perfect card\nwith no perceptible defects or damage."
    } ]
  }, {
    "tStartMs": 919460,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "But if there's one minor flaw\na single white spot on an edge,"
    } ]
  }, {
    "tStartMs": 922630,
    "dDurationMs": 3586,
    "segs": [ {
      "utf8": "a corner that isn't perfectly sharp,\nor the faintest of scratches,"
    } ]
  }, {
    "tStartMs": 926216,
    "dDurationMs": 4797,
    "segs": [ {
      "utf8": "the grade drops to a 9. Two or more flaws,\nand the grade drops to an 8 or lower."
    } ]
  }, {
    "tStartMs": 931055,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "And all of these translate\nto massive price differences."
    } ]
  }, {
    "tStartMs": 934350,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "The percentage of a Pokemon card\nthat gets submitted"
    } ]
  }, {
    "tStartMs": 936894,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "to a grading company and achieves\nthat perfect ten is called the gem rate."
    } ]
  }, {
    "tStartMs": 940731,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "The lower the gem rate, the higher\nthe condition rarity, and the greater"
    } ]
  }, {
    "tStartMs": 944234,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "the premium a PSA 10 commands."
    } ]
  }, {
    "tStartMs": 946862,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "For most series,"
    } ]
  }, {
    "tStartMs": 947821,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "there's an inverse relationship\nbetween gem rate and price premium."
    } ]
  }, {
    "tStartMs": 951825,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "Ultimately, supply rarity and condition\nrarity are both fundamentally tied to age."
    } ]
  }, {
    "tStartMs": 956830,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "This is why the most expensive English\nPokemon cards are the vintage, first"
    } ]
  }, {
    "tStartMs": 960834,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "ever printed PSA 10 singles.\nBut elite collectors"
    } ]
  }, {
    "tStartMs": 964171,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "don't just want the rarest,\nthey want the pinnacle."
    } ]
  }, {
    "tStartMs": 966924,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Their willingness\nto splurge for the best of the rarest"
    } ]
  }, {
    "tStartMs": 969718,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "is precisely what drives\nthese five and six figure prices."
    } ]
  }, {
    "tStartMs": 974974,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "But grading"
    } ]
  }, {
    "tStartMs": 975474,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "itself remains unpredictable\nand inconsistent."
    } ]
  }, {
    "tStartMs": 978644,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "At PSA, cards are inspected\nmanually by humans."
    } ]
  }, {
    "tStartMs": 982147,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "People mail in their card and wait weeks,\nsometimes months,"
    } ]
  }, {
    "tStartMs": 985067,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "for the card to be returned \nin a slab with its grade."
    } ]
  }, {
    "tStartMs": 988112,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "Because the jump in value\nbetween a 10 and a 9,"
    } ]
  }, {
    "tStartMs": 990739,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "and even between a 9\nand an 8 is so large,"
    } ]
  }, {
    "tStartMs": 993617,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "collectors will crack open their slabs\nto resubmit the same cards, hoping"
    } ]
  }, {
    "tStartMs": 997621,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "they'll land with a more lenient creator\nand secure a grade bump."
    } ]
  }, {
    "tStartMs": 1001041,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "While all of this boils down to"
    } ]
  }, {
    "tStartMs": 1002668,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "is that if you want to hit the jackpot,\nyou need to win three lotteries."
    } ]
  }, {
    "tStartMs": 1006463,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "One, the card"
    } ]
  }, {
    "tStartMs": 1007172,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "had to be printed perfectly at the factory\nbefore it even made it into the pack."
    } ]
  }, {
    "tStartMs": 1011218,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Then you need luck to be"
    } ]
  }, {
    "tStartMs": 1012428,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "the one to pull it out of the pack\nat those 1% or lower odds."
    } ]
  }, {
    "tStartMs": 1016265,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "And lastly, you need some degree of luck\nthat PSA will grade it as a 10."
    } ]
  }, {
    "tStartMs": 1020936,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "Over the decades, The Pokémon Company\nhas invested in quality control."
    } ]
  }, {
    "tStartMs": 1024940,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Consumers have been conditioned to sleeve\nor slap their cards"
    } ]
  }, {
    "tStartMs": 1027901,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "right out of the pack, and more collectors\nare grading to secure their investments."
    } ]
  }, {
    "tStartMs": 1032448,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "But while the average series-wide\ngem rate for chase cards"
    } ]
  }, {
    "tStartMs": 1035159,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "in the vintage and mid eras is 5% or less,"
    } ]
  }, {
    "tStartMs": 1038203,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "gem rates for leading singles\nin the modern era are as high as 70%."
    } ]
  }, {
    "tStartMs": 1043292,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "Nearly half of modern cards that get\nsubmitted to PSA for grading get a 10."
    } ]
  }, {
    "tStartMs": 1048172,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "The value of vintage and mid-era\nsingles are fundamentally driven"
    } ]
  }, {
    "tStartMs": 1051508,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "by their genuine scarcity,\nbut The modern era defies both"
    } ]
  }, {
    "tStartMs": 1054720,
    "dDurationMs": 4546,
    "segs": [ {
      "utf8": "collectible convention and historic\nPokémon fundamentals, with valuations"
    } ]
  }, {
    "tStartMs": 1059266,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "that are forgiving\nof both supply and condition."
    } ]
  }, {
    "tStartMs": 1062269,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Every vintage and mid-era\nsingle loses between 85%"
    } ]
  }, {
    "tStartMs": 1065272,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "to 95% of its value\nwhen it's graded below a 10."
    } ]
  }, {
    "tStartMs": 1068650,
    "dDurationMs": 3838,
    "segs": [ {
      "utf8": "A modern single that gets graded\nas an 8 or 9 strangely retains"
    } ]
  }, {
    "tStartMs": 1072488,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "far more of its value\ndespite the abundant population of tens,"
    } ]
  }, {
    "tStartMs": 1075699,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "with only a 69% to 70% reduction."
    } ]
  }, {
    "tStartMs": 1078786,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "One explanation is that supply\nhad simply scaled with demand, as modern"
    } ]
  }, {
    "tStartMs": 1082623,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "singles have artwork\nthat has drawn millions of new mass market"
    } ]
  }, {
    "tStartMs": 1085959,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "buyers who might never have engaged\nwith vintage cards."
    } ]
  }, {
    "tStartMs": 1089254,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "But it's unlikely that the present day\nhype will last long enough to sustain"
    } ]
  }, {
    "tStartMs": 1092841,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "such supply."
    } ]
  }, {
    "tStartMs": 1094134,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "This makes the modern era\ninherently more fragile"
    } ]
  }, {
    "tStartMs": 1096720,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "and speculative\nthan any other era of Pokemon cards."
    } ]
  }, {
    "tStartMs": 1100557,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "Still, that hasn't stopped Riki\nor most of the community"
    } ]
  }, {
    "tStartMs": 1103769,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "from making modern singles\n80% to 100% of their business."
    } ]
  }, {
    "tStartMs": 1108690,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "A natural question would be, then\nwhy doesn't everyone grade their cards?"
    } ]
  }, {
    "tStartMs": 1112319,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "Grading fees range between $30 to $300 per\ncard, depending on value."
    } ]
  }, {
    "tStartMs": 1117533,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "Because of this risk and cost, the market\nfor singles splits between ungraded"
    } ]
  }, {
    "tStartMs": 1122037,
    "dDurationMs": 5005,
    "segs": [ {
      "utf8": "and graded cards. Graded cards, often\nreferred to as slabs, command a premium"
    } ]
  }, {
    "tStartMs": 1127042,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "because the seller has paid upfront\nto certify authenticity and condition."
    } ]
  }, {
    "tStartMs": 1131421,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "Raw cards, on the other hand, are cheaper\nbecause the buyer takes on all the risk."
    } ]
  }, {
    "tStartMs": 1136051,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "If you can spot an ungraded card,\nnegotiate the right price"
    } ]
  }, {
    "tStartMs": 1139096,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "and secure that high grade."
    } ]
  }, {
    "tStartMs": 1140472,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "You can capture all that upside as profit."
    } ]
  }, {
    "tStartMs": 1258715,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Riki's 10 years in tech sales\ngives him a professional edge over"
    } ]
  }, {
    "tStartMs": 1262135,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "other vendors and collectors\nby focusing on near mint modern raws."
    } ]
  }, {
    "tStartMs": 1266390,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "He isn't trying to predict\nwhere the market is going as much as he is"
    } ]
  }, {
    "tStartMs": 1269476,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "looking to maximize where it is now\nand in today's frothy environment,"
    } ]
  }, {
    "tStartMs": 1273605,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "eking out $5 or $10 in a deal\nmakes all the difference."
    } ]
  }, {
    "tStartMs": 1320610,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "While trading singles"
    } ]
  }, {
    "tStartMs": 1321695,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "and sealed product are the two \nmain income streams in Pokemon"
    } ]
  }, {
    "tStartMs": 1324990,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "cards, Riki has harnessed\na third in creating content."
    } ]
  }, {
    "tStartMs": 1328744,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "In just one year, he's\nbecome one of the fastest growing creators"
    } ]
  }, {
    "tStartMs": 1331705,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "in the space, catering to low knowledge\nbeginners and nostalgic fans,"
    } ]
  }, {
    "tStartMs": 1335542,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "rediscovering the hobby just as he did."
    } ]
  }, {
    "tStartMs": 1414746,
    "dDurationMs": 668,
    "segs": [ {
      "utf8": "These days,"
    } ]
  }, {
    "tStartMs": 1415414,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "every vendor understands\nthe upside of content creation."
    } ]
  }, {
    "tStartMs": 1419167,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "Despite the friendly demeanor and communal\nspirit of the Pokemon card community,"
    } ]
  }, {
    "tStartMs": 1423380,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "they're all direct competitors \nin a zero-sum game."
    } ]
  }, {
    "tStartMs": 1426216,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "The odds that there are multiple copies\nof the same card in the same condition"
    } ]
  }, {
    "tStartMs": 1429761,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "are higher than ever,\nand getting a lower price"
    } ]
  }, {
    "tStartMs": 1431972,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "just a few tables away\ncan instantly kill a deal at this one."
    } ]
  }, {
    "tStartMs": 1435600,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Content is more than just a third income\nstream."
    } ]
  }, {
    "tStartMs": 1438186,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "It's the ultimate differentiator."
    } ]
  }, {
    "tStartMs": 1487235,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Pokemon cards are"
    } ]
  }, {
    "tStartMs": 1488236,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "like an iceberg and Ricky operates at the surface,"
    } ]
  }, {
    "tStartMs": 1491364,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "where demand is most visible."
    } ]
  }, {
    "tStartMs": 1492824,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "Supply's greatest profits are quickest,\nand knowledge requirements are lowest."
    } ]
  }, {
    "tStartMs": 1497787,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "In the limited hours\nthat he can dedicate to the hobby,"
    } ]
  }, {
    "tStartMs": 1500624,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "he excels by following the data,"
    } ]
  }, {
    "tStartMs": 1502626,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "flipping what sells,\nand catering to the mainstream population."
    } ]
  }, {
    "tStartMs": 1506463,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "He doesn't have the bandwidth\nto go any deeper or to expand"
    } ]
  }, {
    "tStartMs": 1509299,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "towards high-end vintage\nor Japanese cards."
    } ]
  }, {
    "tStartMs": 1512511,
    "dDurationMs": 4963,
    "segs": [ {
      "utf8": "Ricky averages $10,500 a month in Pokemon\ncards sales, for an annual run"
    } ]
  }, {
    "tStartMs": 1517474,
    "dDurationMs": 5547,
    "segs": [ {
      "utf8": "rate of $126,000, while he sells 10 times\nas many raws as slabs and volume,"
    } ]
  }, {
    "tStartMs": 1523188,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "slabs and raws each contribute 50-50."
    } ]
  }, {
    "tStartMs": 1526024,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "70% of his sales are in-person,"
    } ]
  }, {
    "tStartMs": 1528151,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "even though he typically works\njust one card show a month."
    } ]
  }, {
    "tStartMs": 1531571,
    "dDurationMs": 5714,
    "segs": [ {
      "utf8": "On the content side, Ricky grosses on\naverage $5,500 per month across AdSense"
    } ]
  }, {
    "tStartMs": 1537285,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "and sponsors for an annual run\nrate of $66,000 combined."
    } ]
  }, {
    "tStartMs": 1541957,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Ricky, under Oyama Trading, \ngrosses $191,000"
    } ]
  }, {
    "tStartMs": 1545961,
    "dDurationMs": 3878,
    "segs": [ {
      "utf8": "a year, and flashy numbers\nlike these are what attract newcomers."
    } ]
  }, {
    "tStartMs": 1550048,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "But this is a business\nabout value capture, not value creation."
    } ]
  }, {
    "tStartMs": 1553885,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "Ricky's gross margin on cards,\nafter deducting the cost of inventory"
    } ]
  }, {
    "tStartMs": 1557556,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "and grading, has surged from 29% to 41%"
    } ]
  }, {
    "tStartMs": 1561101,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "this year - a jump\nhe admits feels too good to last."
    } ]
  }, {
    "tStartMs": 1564688,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "His overall operating margin after travel\ntable fees and production costs"
    } ]
  }, {
    "tStartMs": 1568692,
    "dDurationMs": 4546,
    "segs": [ {
      "utf8": "sits at 54%, but that doesn't factor\nthe thousands of unpaid hours"
    } ]
  }, {
    "tStartMs": 1573238,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "he spent sourcing, selling, filming,\nand studying the market."
    } ]
  }, {
    "tStartMs": 1576825,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "These profit margins are \nbased on capital alone."
    } ]
  }, {
    "tStartMs": 1580078,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Riki has one foot in and one foot out\nand wants to keep it"
    } ]
  }, {
    "tStartMs": 1583415,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "that way."
    } ]
  }, {
    "tStartMs": 1628501,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "In this world,"
    } ]
  }, {
    "tStartMs": 1629210,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "supply and demand are like clockwork."
    } ]
  }, {
    "tStartMs": 1631212,
    "dDurationMs": 4130,
    "segs": [ {
      "utf8": "Chase cards drive pack prices, supply\nshapes, liquidity, and the best sellers"
    } ]
  }, {
    "tStartMs": 1635342,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "are the ones who identify opportunity\nbefore the rest of the market."
    } ]
  }, {
    "tStartMs": 1638720,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Timing is everything, and the faster\nyou can find what you're looking for,"
    } ]
  }, {
    "tStartMs": 1642057,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "the stronger your edge."
    } ]
  }, {
    "tStartMs": 1643391,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "While you may never find that life-changing card,"
    } ]
  }, {
    "tStartMs": 1645810,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "this principle extends beyond Pokemon.\nBusiness is like collecting."
    } ]
  }, {
    "tStartMs": 1649439,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "Success is finding the right opportunities\nbefore everyone else."
    } ]
  }, {
    "tStartMs": 1653109,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "If you're hiring, you can find qualified\ncandidates right away, time and time again"
    } ]
  }, {
    "tStartMs": 1656946,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "with ZipRecruiter."
    } ]
  }, {
    "tStartMs": 1657989,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "And today you can try it for free\nat ziprecruiter.com/MBA."
    } ]
  }, {
    "tStartMs": 1661284,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "If hiring to you means\nposting a listing"
    } ]
  }, {
    "tStartMs": 1665163,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "and waiting for applications to trickle\nin, you're already falling behind."
    } ]
  }, {
    "tStartMs": 1668458,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "ZipRecruiter\nturns hiring from passive to active."
    } ]
  }, {
    "tStartMs": 1671336,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "ZipRecruiter's powerful"
    } ]
  }, {
    "tStartMs": 1672545,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "matching technology works fast to find top talent."
    } ]
  }, {
    "tStartMs": 1675465,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "You're steering the process,\nnot leaving things up to chance."
    } ]
  }, {
    "tStartMs": 1678510,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "In this day and age, good\ncandidates will not walk through the door"
    } ]
  }, {
    "tStartMs": 1681388,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "and the best talent will always be\nrecruited, not waiting around to be found."
    } ]
  }, {
    "tStartMs": 1685225,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "With ZipRecruiter's advanced\nresume database,"
    } ]
  }, {
    "tStartMs": 1687686,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "you can unlock top candidate's\ncontact information instantly,"
    } ]
  }, {
    "tStartMs": 1690897,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "giving you that leg up on \nbringing in the staff"
    } ]
  }, {
    "tStartMs": 1693149,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "who will take your business\nto the next level."
    } ]
  }, {
    "tStartMs": 1695568,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "It's no wonder that ZipRecruiter is\nthe number one rated hiring site"
    } ]
  }, {
    "tStartMs": 1699239,
    "dDurationMs": 4337,
    "segs": [ {
      "utf8": "based on G2, an accolade that\nfew companies in the world ever receive."
    } ]
  }, {
    "tStartMs": 1703618,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Want to know right away how many qualified\ncandidates are in your area?"
    } ]
  }, {
    "tStartMs": 1706955,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "Look no further than ZipRecruiter."
    } ]
  }, {
    "tStartMs": 1708790,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Four out of five employers\nwho post on ZipRecruiter"
    } ]
  }, {
    "tStartMs": 1711543,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "get a quality candidate\nwithin the first day,"
    } ]
  }, {
    "tStartMs": 1713670,
    "dDurationMs": 5172,
    "segs": [ {
      "utf8": "and right now you can try it for free\nat ziprecruiter.com/mba."
    } ]
  }, {
    "tStartMs": 1718842,
    "dDurationMs": 6047,
    "segs": [ {
      "utf8": "Again, that's ziprecruiter.com/mba.\nZipRecruiter - the smartest way to hire."
    } ]
  }, {
    "tStartMs": 1727016,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "While this card show in LA is Riki's\nbiggest of the year,"
    } ]
  }, {
    "tStartMs": 1730145,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "for Jason, it's\njust another stop on a weekend circuit"
    } ]
  }, {
    "tStartMs": 1733106,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "that has taken him from San Diego\nto Atlanta."
    } ]
  }, {
    "tStartMs": 1736025,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "As soon as this show wraps, he's\ncatching a red eye to Tokyo."
    } ]
  }, {
    "tStartMs": 1739195,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "Between card shows,"
    } ]
  }, {
    "tStartMs": 1740155,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "he fulfills eBay orders from home\nor scours Japanese shops for inventory."
    } ]
  }, {
    "tStartMs": 1744659,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "For three years,\nJason has lived this trans-pacific"
    } ]
  }, {
    "tStartMs": 1747579,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "grind, splitting his life\nbetween San Francisco and Tokyo."
    } ]
  }, {
    "tStartMs": 1751458,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "Jason deals exclusively in Japanese Pokemon cards."
    } ]
  }, {
    "tStartMs": 1754753,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "He admits he can't even name\nthe latest English releases,"
    } ]
  }, {
    "tStartMs": 1758131,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "even though both markets share the same\nparent company and fundamentals of rarity."
    } ]
  }, {
    "tStartMs": 1762343,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "What drives value in Japan\nis not what drives value in the West."
    } ]
  }, {
    "tStartMs": 1766181,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "If the English Pokemon card\nmarket is the 100ft tip of the iceberg,"
    } ]
  }, {
    "tStartMs": 1770268,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "then Jason operates\n1000ft deep below the surface."
    } ]
  }, {
    "tStartMs": 1774272,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "He's part of the top 1% of the hobby\nthat's developed the knowledge,"
    } ]
  }, {
    "tStartMs": 1777734,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "specialization and skills"
    } ]
  }, {
    "tStartMs": 1779444,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "to build a high stakes, full-time\nbusiness on top of a children's card game."
    } ]
  }, {
    "tStartMs": 1783448,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "His eBay store is anonymous."
    } ]
  }, {
    "tStartMs": 1785033,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "His business logo is a stock image."
    } ]
  }, {
    "tStartMs": 1787243,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "His YouTube videos are just raw thoughts"
    } ]
  }, {
    "tStartMs": 1789162,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "for close friends, and his table at card\nshows are as humble as his person."
    } ]
  }, {
    "tStartMs": 1871327,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "The differences go beyond print quality."
    } ]
  }, {
    "tStartMs": 1873705,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "Every Pokemon card is designed\nand released in Japan"
    } ]
  }, {
    "tStartMs": 1876457,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "first before anywhere else."
    } ]
  }, {
    "tStartMs": 1878293,
    "dDurationMs": 3878,
    "segs": [ {
      "utf8": "Japan gets a new set every month,\nwhile the English market combines 2"
    } ]
  }, {
    "tStartMs": 1882171,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "to 3 into one larger\nrelease every quarter."
    } ]
  }, {
    "tStartMs": 1885174,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "Because of this, Japanese sets contain\nsignificantly fewer cards than English"
    } ]
  }, {
    "tStartMs": 1889262,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "sets."
    } ]
  }, {
    "tStartMs": 1889762,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "The cards themselves\ndon't match 1 to 1 across languages,"
    } ]
  }, {
    "tStartMs": 1892849,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and not every Japanese card gets\nan English version."
    } ]
  }, {
    "tStartMs": 1895935,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "The other difference is pull rates\nunder Japan's consumer protection law."
    } ]
  }, {
    "tStartMs": 1900440,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "Japanese booster boxes guarantee at least\n4 chase cards in every 30 packs,"
    } ]
  }, {
    "tStartMs": 1904903,
    "dDurationMs": 5046,
    "segs": [ {
      "utf8": "whereas English distribution is completely\nrandom with fewer cards in more sets."
    } ]
  }, {
    "tStartMs": 1909991,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "Poll rates are generally higher and\nJapanese chase cards possess less supply"
    } ]
  }, {
    "tStartMs": 1914495,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "rarity."
    } ]
  }, {
    "tStartMs": 1915455,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "If we look at our data"
    } ]
  }, {
    "tStartMs": 1916456,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "starting from the 2010 Black \u0026 White\nseries, fewer than 10% of English cards"
    } ]
  }, {
    "tStartMs": 1920835,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "earned a PSA ten, compared to roughly half\nof their Japanese counterparts"
    } ]
  }, {
    "tStartMs": 1925089,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "in the X\u0026Y series."
    } ]
  }, {
    "tStartMs": 1926424,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "About 7 in 10 Japanese\nchase cards were graded in perfect"
    } ]
  }, {
    "tStartMs": 1929677,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "condition compared to just 1 in 10\nof their English equivalents."
    } ]
  }, {
    "tStartMs": 1933681,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "And even today, in the modern era,\nwhere English cards enjoy a record high"
    } ]
  }, {
    "tStartMs": 1937769,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "rate of 40%, this pales next to the 90%\nof their Japanese equivalents."
    } ]
  }, {
    "tStartMs": 1943191,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "It's a trend that extends even to the vintage era."
    } ]
  }, {
    "tStartMs": 1945944,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "In short, supply rarity and \ncondition rarity"
    } ]
  }, {
    "tStartMs": 1948696,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "are non-factors for main set\nJapanese chase cards."
    } ]
  }, {
    "tStartMs": 1952575,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "Yet because the American market is driven\nby nostalgia, their Japanese equivalents"
    } ]
  }, {
    "tStartMs": 1956871,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "can't be substitutes despite their higher\nsupply and superior quality side by side."
    } ]
  }, {
    "tStartMs": 1961793,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "English chase cards from main sets\nconsistently sell"
    } ]
  }, {
    "tStartMs": 1964754,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "for more due to the greater market\nsize, demand, and buying power."
    } ]
  }, {
    "tStartMs": 1968967,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Yet the world's most expensive\nPokémon cards are predominantly Japanese."
    } ]
  }, {
    "tStartMs": 1973346,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "These record breaking singles are limited-run \nexclusives that were produced"
    } ]
  }, {
    "tStartMs": 1976975,
    "dDurationMs": 3878,
    "segs": [ {
      "utf8": "outside of the main sets as one time\ncollaborations with local brands,"
    } ]
  }, {
    "tStartMs": 1980979,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "publications, tournaments, or contests."
    } ]
  }, {
    "tStartMs": 1984148,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Because they're so culturally specific."
    } ]
  }, {
    "tStartMs": 1986067,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "They have no relevance in any other market\nand thus never make it"
    } ]
  }, {
    "tStartMs": 1989278,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "into an English release."
    } ]
  }, {
    "tStartMs": 1991114,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "These are the true chase cards\nfor the Japanese market,"
    } ]
  }, {
    "tStartMs": 1993700,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "with genuine supply and condition rarity."
    } ]
  }, {
    "tStartMs": 1996244,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "Their scarcity attracts"
    } ]
  }, {
    "tStartMs": 1997495,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "high-end collectors and public figures\nat the tip of the market."
    } ]
  }, {
    "tStartMs": 2000790,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Ultimately, both Japanese\nand American markets define value"
    } ]
  }, {
    "tStartMs": 2004085,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "by supply and condition rarity,\nbut their application is inverted."
    } ]
  }, {
    "tStartMs": 2007880,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "In Japan, rarity lives in promos\nbecause their main sets have none."
    } ]
  }, {
    "tStartMs": 2012135,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "Conversely, the U.S."
    } ]
  }, {
    "tStartMs": 2013302,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "values mean set cards because the low pull\nrates and print quality create rarity."
    } ]
  }, {
    "tStartMs": 2017932,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "And on the flip side,"
    } ]
  }, {
    "tStartMs": 2018891,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "certain Japanese cards are desirable\nonly in Japan, like waifu full art"
    } ]
  }, {
    "tStartMs": 2023229,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "female trainer cards which enjoy\nfar greater appreciation, demand,"
    } ]
  }, {
    "tStartMs": 2027275,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "and market value\nthan their English equivalents."
    } ]
  }, {
    "tStartMs": 2030319,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Ultimately,\nthis broad niche of Japanese exclusives"
    } ]
  }, {
    "tStartMs": 2033072,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "is where Jason has built his business\nfor the past five years."
    } ]
  }, {
    "tStartMs": 2036743,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "But they're less of a novelty\nthese days."
    } ]
  }, {
    "tStartMs": 2039245,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "Below the seven figure trophy cards,"
    } ]
  }, {
    "tStartMs": 2041080,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "Japanese exclusives have begun to catch\nmid-market momentum in the US."
    } ]
  }, {
    "tStartMs": 2045334,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "Many vendors and collectors\ntoday are following Jason's playbook,"
    } ]
  }, {
    "tStartMs": 2048671,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "diversifying their inventory\nwith Japanese exclusives."
    } ]
  }, {
    "tStartMs": 2051966,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Instead, the elephant in the room\nis the entry of corporations."
    } ]
  }, {
    "tStartMs": 2055178,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "Multi-billion dollar players\nlike PSA and fanatics are now aggressively"
    } ]
  }, {
    "tStartMs": 2059223,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "looking to consolidate\nthis atomized secondary market"
    } ]
  }, {
    "tStartMs": 2062018,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "into their own walled gardens\nby offering cash for cards"
    } ]
  }, {
    "tStartMs": 2065271,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "as soon as they're graded or pack-ripping\nlive streams on their platforms."
    } ]
  }, {
    "tStartMs": 2068649,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "These companies have the capital\nto intercept supply and control demand,"
    } ]
  }, {
    "tStartMs": 2072737,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "but in the short term,"
    } ]
  }, {
    "tStartMs": 2073571,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "the influx of competition from individual\nsellers doesn't faze Jason."
    } ]
  }, {
    "tStartMs": 2121828,
    "dDurationMs": 292,
    "segs": [ {
      "utf8": "Getting"
    } ]
  }, {
    "tStartMs": 2122120,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Japanese cards isn't as simple\nas ordering them online."
    } ]
  }, {
    "tStartMs": 2125498,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Only a fraction of the country's inventory\nreaches market places like Mercari"
    } ]
  }, {
    "tStartMs": 2129127,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Japan and Yahoo! Japan auctions."
    } ]
  }, {
    "tStartMs": 2131921,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "The English market follows\na similar dynamic."
    } ]
  }, {
    "tStartMs": 2134423,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "The cards that make it onto eBay\nare generally the high value graded slabs."
    } ]
  }, {
    "tStartMs": 2138678,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "This makes Japanese card shops\nidentical to American card shows,"
    } ]
  }, {
    "tStartMs": 2142306,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "where the high-volume and low-information\ncash-heavy environments allow"
    } ]
  }, {
    "tStartMs": 2146102,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "skilled buyers to snap up hidden gems,\nbargains, and overlooked opportunities."
    } ]
  }, {
    "tStartMs": 2150982,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "But the barriers to entry in the online\nJapanese market"
    } ]
  }, {
    "tStartMs": 2153985,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "go well beyond inventory and language."
    } ]
  }, {
    "tStartMs": 2175006,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Many platforms don't support\ninternational shipping, only accept"
    } ]
  }, {
    "tStartMs": 2178593,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "Japanese payment methods, or require\na local phone number and address."
    } ]
  }, {
    "tStartMs": 2183139,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Private middlemen"
    } ]
  }, {
    "tStartMs": 2184140,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "have tried to bridge this gap,\nbut the difference in time zones, culture,"
    } ]
  }, {
    "tStartMs": 2187894,
    "dDurationMs": 4587,
    "segs": [ {
      "utf8": "and communication make each transaction\nslower, riskier, and more expensive"
    } ]
  }, {
    "tStartMs": 2192481,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "in a market where timing and trust is everything."
    } ]
  }, {
    "tStartMs": 2195568,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Even data is a barrier."
    } ]
  }, {
    "tStartMs": 2197278,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "The pricing tools and trackers\nthat Americans rely on only work"
    } ]
  }, {
    "tStartMs": 2200823,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "for English cards."
    } ]
  }, {
    "tStartMs": 2202241,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "These structural and cultural obstacles\nkeep the Japanese market"
    } ]
  }, {
    "tStartMs": 2205828,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "essentially closed off to outsiders,"
    } ]
  }, {
    "tStartMs": 2207872,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "beyond the few singles that get traction\nand are already trading at premiums"
    } ]
  }, {
    "tStartMs": 2211876,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "in the U.S. market.\nThe true selection, depth and opportunity"
    } ]
  }, {
    "tStartMs": 2215922,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "remain accessible only to those who have\ncommitted themselves as deeply as Jason."
    } ]
  }, {
    "tStartMs": 2283447,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Jason's constant transpacific grind is his moat."
    } ]
  }, {
    "tStartMs": 2286784,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "Today in Tokyo, he's heading 45\nshops across six districts,"
    } ]
  }, {
    "tStartMs": 2290788,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "he'll do it again in Osaka,\nthen Kyoto, then Nagoya"
    } ]
  }, {
    "tStartMs": 2294166,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "all over the next 2 days."
    } ]
  }, {
    "tStartMs": 2297795,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "He'll cycle through this circuit week"
    } ]
  }, {
    "tStartMs": 2299505,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "after week until his next flight back\nto San Francisco."
    } ]
  }, {
    "tStartMs": 2302883,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "It's as exhausting as it is unglamorous."
    } ]
  }, {
    "tStartMs": 2305761,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "Jason's edge is curation\ngrounded in his near encyclopedic"
    } ]
  }, {
    "tStartMs": 2309640,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "knowledge of Japanese exclusives\ntheir price history, their supply on a per"
    } ]
  }, {
    "tStartMs": 2314061,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "city basis along with their potential value"
    } ]
  }, {
    "tStartMs": 2316605,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "when assessed\nthrough the lens of American buyers."
    } ]
  }, {
    "tStartMs": 2319358,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "His ongoing efforts to master Japanese\nonly deepens this."
    } ]
  }, {
    "tStartMs": 2323154,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "And while most in the US constantly\nrun numbers, Jason barely touches"
    } ]
  }, {
    "tStartMs": 2327033,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "his phone when sourcing. In America,\nprofit comes first."
    } ]
  }, {
    "tStartMs": 2331203,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "There are almost no raw vintage cards\nin good condition left as anyone holding"
    } ]
  }, {
    "tStartMs": 2335499,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "some has likely created them to maximize\nresale value."
    } ]
  }, {
    "tStartMs": 2339045,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Those few slabs are what circulate\nin the US today."
    } ]
  }, {
    "tStartMs": 2342631,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "Americans, with their focus on investment\nand profit, go"
    } ]
  }, {
    "tStartMs": 2345885,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "the distance to maximize returns,"
    } ]
  }, {
    "tStartMs": 2347803,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "as even the part-timers sell their own\ncards directly, pay for grading,"
    } ]
  }, {
    "tStartMs": 2351891,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "and will travel to weekend\nshows just to extract every dollar."
    } ]
  }, {
    "tStartMs": 2355770,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "Japan, in contrast, is oriented\nmore on play and passion."
    } ]
  }, {
    "tStartMs": 2359857,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "Most cards never get created."
    } ]
  }, {
    "tStartMs": 2361734,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "Anyone can walk into a card shop in Japan,\nbut the real skill is in knowing"
    } ]
  }, {
    "tStartMs": 2365946,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "which cards are truly valuable, whether\nthey're fairly priced by local standards,"
    } ]
  }, {
    "tStartMs": 2370284,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "and how likely you are"
    } ]
  }, {
    "tStartMs": 2371452,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "to find copies that are cheaper\nor in better condition elsewhere."
    } ]
  }, {
    "tStartMs": 2375247,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "And none of that information is online."
    } ]
  }, {
    "tStartMs": 2377917,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "As a result, Jason's profit margins are\ndriven by multiple layers of arbitrage."
    } ]
  }, {
    "tStartMs": 2382797,
    "dDurationMs": 4546,
    "segs": [ {
      "utf8": "He capitalizes on geographic price\ndifferences, leverages cultural fluency to"
    } ]
  }, {
    "tStartMs": 2387343,
    "dDurationMs": 4546,
    "segs": [ {
      "utf8": "act on real-time information, and remains\nphysically immersed across both worlds"
    } ]
  }, {
    "tStartMs": 2391889,
    "dDurationMs": 4505,
    "segs": [ {
      "utf8": "to find locally undervalued Japanese cards\nthat would be in demand in the U.S."
    } ]
  }, {
    "tStartMs": 2396394,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "market."
    } ]
  }, {
    "tStartMs": 2397478,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "There are two schools of thought\nin a collectible market."
    } ]
  }, {
    "tStartMs": 2399939,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "One says it's all irrational.\nDon't overthink it."
    } ]
  }, {
    "tStartMs": 2402608,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "Just ride the wave."
    } ]
  }, {
    "tStartMs": 2403776,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Manage risk, and take profits\nwherever you can."
    } ]
  }, {
    "tStartMs": 2407071,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "But when you're all-in like Jason,\nyou can't simply chalk"
    } ]
  }, {
    "tStartMs": 2409865,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "everything up to your rationality and\nlet the market drag you wherever it goes."
    } ]
  }, {
    "tStartMs": 2414120,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "You need structure and logic\nfor inventory and longevity."
    } ]
  }, {
    "tStartMs": 2417706,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "Jason sees the U.S. market's obsession\nwith sales data as not just lazy,"
    } ]
  }, {
    "tStartMs": 2421669,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "but fundamentally flawed."
    } ]
  }, {
    "tStartMs": 2492990,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Over time, Jason"
    } ]
  }, {
    "tStartMs": 2493991,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "has built his own internal framework\nto evaluate a card's potential."
    } ]
  }, {
    "tStartMs": 2497828,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "His apartment in San Francisco is filled\nwith countless examples"
    } ]
  }, {
    "tStartMs": 2501415,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "of inventory curated this way,"
    } ]
  }, {
    "tStartMs": 2543415,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "But Jason is not married to his framework."
    } ]
  }, {
    "tStartMs": 2545709,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "For every rule, there's an exception."
    } ]
  }, {
    "tStartMs": 2547878,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "Ironically, the American mass market has\nstepped into his niche in recent months"
    } ]
  }, {
    "tStartMs": 2552216,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "with the Japanese exclusive"
    } ]
  }, {
    "tStartMs": 2553676,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "McDonald's Pikachu card\nas the latest target of speculation."
    } ]
  }, {
    "tStartMs": 2557429,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "The card went viral before its release,\nand Americans saw it"
    } ]
  }, {
    "tStartMs": 2560516,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "as a rare opportunity to source\na very specific, low-cost,"
    } ]
  }, {
    "tStartMs": 2564353,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "low-risk, high-potential asset\nfrom Japan's normally closed off market."
    } ]
  }, {
    "tStartMs": 2568941,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Scalpers swarmed McDonald's\nstores across Japan, dumping"
    } ]
  }, {
    "tStartMs": 2572319,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "tons of Happy Meals\njust to hoard copies of the card."
    } ]
  }, {
    "tStartMs": 2575447,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The public outcry over food waste\nforced McDonald's"
    } ]
  }, {
    "tStartMs": 2578450,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "Japan to cancel the entire promotion\nwithin 24 hours."
    } ]
  }, {
    "tStartMs": 2582621,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "Two months later, and the McDonald's\nPikachu card has become"
    } ]
  }, {
    "tStartMs": 2585416,
    "dDurationMs": 5213,
    "segs": [ {
      "utf8": "the most graded card in existence,\nwith an extraordinary 91% gem rate."
    } ]
  }, {
    "tStartMs": 2590671,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "The market has become flooded with PSA,\ntens and raw copies of this specific card,"
    } ]
  }, {
    "tStartMs": 2595426,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "factors that should drastically depress\nvalue in a rational market."
    } ]
  }, {
    "tStartMs": 2599430,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "But despite this, speculation has driven\nthe card's value to hundreds of dollars,"
    } ]
  }, {
    "tStartMs": 2604226,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "Sellers, who rush to be the first\nto market paid over"
    } ]
  }, {
    "tStartMs": 2606854,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "$100 per card for the expedited grading."
    } ]
  }, {
    "tStartMs": 2610190,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Those holding dozens or hundreds of these\nslabs are forced to anchor their price"
    } ]
  }, {
    "tStartMs": 2613819,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "today at $150 just to simply recoup"
    } ]
  }, {
    "tStartMs": 2616864,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "those fees, irrespective of saturation."
    } ]
  }, {
    "tStartMs": 2619867,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "This dynamic is also evident\nwith other exclusives"
    } ]
  }, {
    "tStartMs": 2622703,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "such as Van Gogh Pikachu,\nwhere popularity breaks rationality"
    } ]
  }, {
    "tStartMs": 2626749,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "and mass-market hype can override\nconventional supply and condition"
    } ]
  }, {
    "tStartMs": 2630878,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "rarity."
    } ]
  }, {
    "tStartMs": 2694233,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "Jason has done this long"
    } ]
  }, {
    "tStartMs": 2695442,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "enough to know\nthat there's no prize for ideology."
    } ]
  }, {
    "tStartMs": 2698487,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "If it sells, it sells."
    } ]
  }, {
    "tStartMs": 2700364,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Although he thinks McDonald's\nPikachus are pure hype,"
    } ]
  }, {
    "tStartMs": 2702825,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "he still maintains a tiny position\nin though,"
    } ]
  }, {
    "tStartMs": 2704827,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "and the $15 he paid is a cheap\nhedge against his own skepticism."
    } ]
  }, {
    "tStartMs": 2709039,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Yet more and more cards\nthis year are breaking Jason's framework."
    } ]
  }, {
    "tStartMs": 2713001,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "He sees instability\nnot just in the valuations of cards,"
    } ]
  }, {
    "tStartMs": 2716171,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "but also in the new wave of vendors\nthat have flooded weekend card"
    } ]
  }, {
    "tStartMs": 2719383,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "shows."
    } ]
  }, {
    "tStartMs": 2781361,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "The frothyness of the current\nAmerican market,"
    } ]
  }, {
    "tStartMs": 2783697,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "with its unprecedented appreciation\nand prices that far exceed"
    } ]
  }, {
    "tStartMs": 2787242,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "their intrinsic worth, has made Jason\ncautious."
    } ]
  }, {
    "tStartMs": 2790204,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "His perspective\nand by extension, business,"
    } ]
  }, {
    "tStartMs": 2792456,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "are in a state of constant evolution."
    } ]
  }, {
    "tStartMs": 2794750,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "He didn't develop his framework, choose\nto specialize in Japanese"
    } ]
  }, {
    "tStartMs": 2797961,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "cards, or decide\nto live between continents overnight."
    } ]
  }, {
    "tStartMs": 2801381,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "He snowballed his investment\ninventory and business"
    } ]
  }, {
    "tStartMs": 2804551,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "from hundreds of dollars\nto millions, one card at a time."
    } ]
  }, {
    "tStartMs": 2808430,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "In his first year full time, Jason\ngot his first big break when he spent"
    } ]
  }, {
    "tStartMs": 2811850,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "$15,000 on two raw, full art Japanese\ntrainer cards, sight unseen."
    } ]
  }, {
    "tStartMs": 2816939,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "This risk paid off\nwhen the waifu boom hit Japan."
    } ]
  }, {
    "tStartMs": 2819983,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "He flew to Tokyo, sold\nboth cards in person, and walked away"
    } ]
  }, {
    "tStartMs": 2823195,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "with over $120,000."
    } ]
  }, {
    "tStartMs": 2825781,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "In his early Japan trips, he would buy\nonly graded cards, but soon found flipping"
    } ]
  }, {
    "tStartMs": 2829993,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Japanese slabs to Americans for a meager\n5% profit margin was unsustainable."
    } ]
  }, {
    "tStartMs": 2835374,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "These realizations\nled him to focus exclusively on raws,"
    } ]
  }, {
    "tStartMs": 2839002,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "and to evaluate singles based on intrinsic\ncollectibility, where he's able"
    } ]
  }, {
    "tStartMs": 2843006,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "to enter the life cycle of a card\nbefore it arrives at its final state."
    } ]
  }, {
    "tStartMs": 2846552,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "As a graded, optimized asset."
    } ]
  }, {
    "tStartMs": 2848679,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "But Jason's current strategy\nis as contrarian as his operating model."
    } ]
  }, {
    "tStartMs": 2852975,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "He's shifted down\nmarket to more affordable inventory"
    } ]
  }, {
    "tStartMs": 2856019,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "rather than chasing the speculative peak"
    } ]
  }, {
    "tStartMs": 2858188,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "where more and more people\nare getting priced out."
    } ]
  }, {
    "tStartMs": 2861108,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "Jason grosses on average $43,000\na month at card"
    } ]
  }, {
    "tStartMs": 2864653,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "shows for an annual run rate of $516,000."
    } ]
  }, {
    "tStartMs": 2868740,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "His eBay business adds another $32,000"
    } ]
  }, {
    "tStartMs": 2871535,
    "dDurationMs": 4838,
    "segs": [ {
      "utf8": "a month, for an annual run\nrate of $384,000 combined."
    } ]
  }, {
    "tStartMs": 2876415,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "His entire business hovers at $900,000\na year."
    } ]
  }, {
    "tStartMs": 2879960,
    "dDurationMs": 5047,
    "segs": [ {
      "utf8": "25% of his inventory gets graded,\nwhile the other 75% remain as Raw's"
    } ]
  }, {
    "tStartMs": 2885382,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "slobs make up 95% of online sales,"
    } ]
  }, {
    "tStartMs": 2888093,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "but only 30% in person to Jason."
    } ]
  }, {
    "tStartMs": 2891179,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Both sales channels are essential."
    } ]
  }, {
    "tStartMs": 2893098,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Card shows provide rapid liquidity,\nwhile online sales provide"
    } ]
  }, {
    "tStartMs": 2896518,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "passive income and all the proceeds\ncycle back to Japan for sourcing."
    } ]
  }, {
    "tStartMs": 2900814,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "Historically, Jason's operating"
    } ]
  }, {
    "tStartMs": 2902399,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "margin has hovered at 20%,\nbut this year has surged to 40%."
    } ]
  }, {
    "tStartMs": 2906778,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "Ultimately, Jason doesn't see himself\nas a visionary, just someone who's refined"
    } ]
  }, {
    "tStartMs": 2910574,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "a single viable strategy\nin a market full of possibilities."
    } ]
  }, {
    "tStartMs": 2914536,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "He never expected Pokemon cards\nto be his full time profession."
    } ]
  }, {
    "tStartMs": 2918165,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "It grew out of necessity\nduring a series of tech layoffs"
    } ]
  }, {
    "tStartMs": 2921335,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "But despite grossing nearly $1 million\na year and mastering a market that few"
    } ]
  }, {
    "tStartMs": 2925714,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "truly understand, he still considers\nPokemon cards a temporary venture."
    } ]
  }, {
    "tStartMs": 2993824,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Jason success is rooted in his dedication."
    } ]
  }, {
    "tStartMs": 2996952,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "He's uprooted his life to optimize\na business that can't be scaled,"
    } ]
  }, {
    "tStartMs": 3000414,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and to sweep through every card\nshop around Japan week after week."
    } ]
  }, {
    "tStartMs": 3004126,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "There's no such thing as a day off."
    } ]
  }, {
    "tStartMs": 3005711,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "If he's not sourcing\ncards, his supply runs out."
    } ]
  }, {
    "tStartMs": 3008171,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "If he's not fulfilling orders"
    } ]
  }, {
    "tStartMs": 3009464,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "as soon as they come\nin, his eBay seller rating drops."
    } ]
  }, {
    "tStartMs": 3012551,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "If he's not, a card shows\nhe doesn't have cash flow for sourcing,"
    } ]
  }, {
    "tStartMs": 3015721,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Jason could certainly streamline things,\nperhaps develop relationships with card"
    } ]
  }, {
    "tStartMs": 3019391,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "shop owners, or hire locals to source\nfor him in Japan when he's not there."
    } ]
  }, {
    "tStartMs": 3023478,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "But Jason doesn't buy what he has\nand personally inspected,"
    } ]
  }, {
    "tStartMs": 3026565,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "Each trip is a chance for him\nto sharpen his knowledge,"
    } ]
  }, {
    "tStartMs": 3029484,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "He knows he could hit seven figures\nif he worked every weekend at a card show."
    } ]
  }, {
    "tStartMs": 3033655,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "But he's increasingly conscious\nof how much of his day to day"
    } ]
  }, {
    "tStartMs": 3036616,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "has turned into a reclusive life\non the road"
    } ]
  }, {
    "tStartMs": 3039036,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "away from friends, family\nand personal pursuits."
    } ]
  }, {
    "tStartMs": 3042706,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "In a bull market, everyone is a winner."
    } ]
  }, {
    "tStartMs": 3045042,
    "dDurationMs": 3294,
    "segs": [ {
      "utf8": "The challenge with Pokemon\ncards is the same as every collectible."
    } ]
  }, {
    "tStartMs": 3048462,
    "dDurationMs": 4796,
    "segs": [ {
      "utf8": "With time, they eventually cool and demand\nrarely last beyond two generations."
    } ]
  }, {
    "tStartMs": 3053675,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "The Silent Generation\npoured money into stamps, coins, and books."
    } ]
  }, {
    "tStartMs": 3057345,
    "dDurationMs": 4964,
    "segs": [ {
      "utf8": "Baby Boomers speculated in furniture,\nbaseball cards, comics, and vinyl records."
    } ]
  }, {
    "tStartMs": 3062350,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "Gen X collected watches, photography,\nand Persian rugs."
    } ]
  }, {
    "tStartMs": 3065979,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Millennials and Gen Z have chased\nsneakers,"
    } ]
  }, {
    "tStartMs": 3068565,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "cryptocurrency, NFTs,\nand now Pokemon cards."
    } ]
  }, {
    "tStartMs": 3072069,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "The long term survival of this\nspecific market all depends on whether"
    } ]
  }, {
    "tStartMs": 3075697,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "the next generation greets it\nwith the same nostalgic reverence."
    } ]
  }, {
    "tStartMs": 3079493,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Jason and Ricky represent opposite\nevolutions of the same phenomenon."
    } ]
  }, {
    "tStartMs": 3083497,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "One deals in intuition and inventory,\nthe other in numbers and personality."
    } ]
  }, {
    "tStartMs": 3088043,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "One treats it as a side hustle\nand the other a full time job."
    } ]
  }, {
    "tStartMs": 3091671,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Both embody the best of the Pokemon card world."
    } ]
  }, {
    "tStartMs": 3094257,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "Ambitious but genuine, profit-minded yet\ncommunity-driven, competitive yet"
    } ]
  }, {
    "tStartMs": 3099137,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "transparent, and united by an unspoken\noptimism that everything they do"
    } ]
  }, {
    "tStartMs": 3103517,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "in this market today is just one chapter\nin a larger journey"
    } ]
  }, {
    "tStartMs": 3107479,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "of professional and personal growth."
    } ]
  }, {
    "tStartMs": 3113568,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "Want to know right away how many qualified\ncandidates are in your area."
    } ]
  }, {
    "tStartMs": 3116822,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "Look no further than ZipRecruiter."
    } ]
  }, {
    "tStartMs": 3118657,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "Four out of five employers\nwho post on ZipRecruiter"
    } ]
  }, {
    "tStartMs": 3121409,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "get a quality candidate\nwithin the first day,"
    } ]
  }, {
    "tStartMs": 3123537,
    "dDurationMs": 5130,
    "segs": [ {
      "utf8": "and right now you can try it\nfor free at ziprecruiter.com/MBA."
    } ]
  }, {
    "tStartMs": 3128708,
    "dDurationMs": 6006,
    "segs": [ {
      "utf8": "Again, that's ziprecruiter.com/MBA.\nZipRecruiter the smartest way to hire."
    } ]
  } ]
}
