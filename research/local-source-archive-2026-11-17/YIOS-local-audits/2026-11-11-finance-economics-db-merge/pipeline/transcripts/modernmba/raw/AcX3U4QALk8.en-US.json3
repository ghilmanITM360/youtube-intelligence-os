  }, {
    "tStartMs": 2404151,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "is built on exclusivity."
    } ]
  }, {
    "tStartMs": 2410825,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "Based in Austin,"
    } ]
  }, {
    "tStartMs": 2411992,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "owner Zi has carved out a high-end niche\nby curating and sourcing"
    } ]
  }, {
    "tStartMs": 2415579,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "rare and premium firearms."
    } ]
  }, {
    "tStartMs": 2429885,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "Even though Mister Guns"
    } ]
  }, {
    "tStartMs": 2430636,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "and Zero Whiskey Tactical"
    } ]
  }, {
    "tStartMs": 2431929,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "are opposites in positioning,\nthe entry points of both"
    } ]
  }, {
    "tStartMs": 2435641,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "owners are near-identical."
    } ]
  }, {
    "tStartMs": 2437393,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Like Ro, he got into the gun world\nduring an industry inflection point."
    } ]
  }, {
    "tStartMs": 2441605,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "Just as the Sandy Hook shooting led"
    } ]
  }, {
    "tStartMs": 2443190,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "to an unprecedented demand\nfor guns in 2013,"
    } ]
  }, {
    "tStartMs": 2445985,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "COVID did the same in 2020."
    } ]
  }, {
    "tStartMs": 2448279,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "The political uncertainty,\nstay at home lockdowns, and civil"
    } ]
  }, {
    "tStartMs": 2451824,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "unrest led to record retail"
    } ]
  }, {
    "tStartMs": 2453617,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "demands and volumes never before seen."
    } ]
  }, {
    "tStartMs": 2456245,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "But while the frenzy from Sandy Hook was"
    } ]
  }, {
    "tStartMs": 2458289,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "largely concentrated in"
    } ]
  }, {
    "tStartMs": 2459498,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "rifles, COVID brought in millions of."
    } ]
  }, {
    "tStartMs": 2461792,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "new first-time gun owners\nlooking for personal protection"
    } ]
  }, {
    "tStartMs": 2464920,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "and home defense."
    } ]
  }, {
    "tStartMs": 2466338,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "Americans collectively cleared out \ntheir local gun stores,"
    } ]
  }, {
    "tStartMs": 2469133,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "and whatever inventory still around"
    } ]
  }, {
    "tStartMs": 2471093,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "was snapped up at record premiums."
    } ]
  }, {
    "tStartMs": 2473304,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "Zi was one of the newcomers\nwho saw an opportunity."
    } ]
  }, {
    "tStartMs": 2579660,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "COVID was the best time to be in the \nUS gun business."
    } ]
  }, {
    "tStartMs": 2583539,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "The market value for every model went up."
    } ]
  }, {
    "tStartMs": 2586750,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Whether it was stimulus checks or greater\npurchase urgency or both,"
    } ]
  }, {
    "tStartMs": 2589503,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "Americans that were in the market for a"
    } ]
  }, {
    "tStartMs": 2591255,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "gun were willing to"
    } ]
  }, {
    "tStartMs": 2592214,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "pay record premiums across the board."
    } ]
  }, {
    "tStartMs": 2594550,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "The average retail price"
    } ]
  }, {
    "tStartMs": 2596010,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "of an MP5 exploded 50%"
    } ]
  }, {
    "tStartMs": 2597845,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "overnight, from $2,700 to $4,000."
    } ]
  }, {
    "tStartMs": 2602016,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "The SCAR rifle went up $4,000"
    } ]
  }, {
    "tStartMs": 2604226,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "in the span of a month."
    } ]
  }, {
    "tStartMs": 2605853,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "The Israeli Tavor\nhad been dropping in value for years"
    } ]
  }, {
    "tStartMs": 2608772,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "before the pandemic due to overproduction,\nweak aftermarket support, and dying"
    } ]
  }, {
    "tStartMs": 2613152,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "retail interest in bullpup rifles\nyet exploded during the pandemic."
    } ]
  }, {
    "tStartMs": 2617489,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "And if you could get your hands on a Gold"
    } ]
  }, {
    "tStartMs": 2619116,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Tiger Striped Desert Eagle,"
    } ]
  }, {
    "tStartMs": 2620576,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "you could flip it overnight for twice\nits usual cost."
    } ]
  }, {
    "tStartMs": 2623704,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Even starter AR-15s"
    } ]
  }, {
    "tStartMs": 2625414,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "sold hundreds of dollars above"
    } ]
  }, {
    "tStartMs": 2627625,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "their usual rates."
    } ]
  }, {
    "tStartMs": 2629043,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Zi's early success\ncame with the realization that"
    } ]
  }, {
    "tStartMs": 2631754,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "chasing quick profits can cost"
    } ]
  }, {
    "tStartMs": 2633839,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "more than it earns."
    } ]
  }, {
    "tStartMs": 2704076,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "Yet 5 years after COVID,"
    } ]
  }, {
    "tStartMs": 2705160,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "the market has cooled dramatically."
    } ]
  }, {
    "tStartMs": 2707621,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "The economy is struggling,"
    } ]
  }, {
    "tStartMs": 2708956,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "retail prices for most models"
    } ]
  }, {
    "tStartMs": 2710290,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "have plummeted from their peaks,\nand even all the high-end movie"
    } ]
  }, {
    "tStartMs": 2714336,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "famous guns are not holding their value."
    } ]
  }, {
    "tStartMs": 2715671,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "With most of his inventory costing"
    } ]
  }, {
    "tStartMs": 2717548,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "thousands of dollars each,"
    } ]
  }, {
    "tStartMs": 2718924,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Zi has to be ultra-precise in his bets."
    } ]
  }, {
    "tStartMs": 2721593,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "He treats buying guns\nlike investing in stocks."
    } ]
  }, {
    "tStartMs": 2724596,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "With enough information,\nyou can develop an intuition"
    } ]
  }, {
    "tStartMs": 2727224,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "for patterns,"
    } ]
  }, {
    "tStartMs": 2728016,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "anticipate trends, and gauge future\npotential per model,"
    } ]
  }, {
    "tStartMs": 2731395,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "even without insider information."
    } ]
  }, {
    "tStartMs": 2733564,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "Zi is neutral on the classics"
    } ]
  }, {
    "tStartMs": 2735065,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "like Beretta 92FS And Walther PPKs."
    } ]
  }, {
    "tStartMs": 2738026,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "While they enjoy mainstream recognition,\nthey're also"
    } ]
  }, {
    "tStartMs": 2740487,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "too outdated to pull the Tactical Timmies"
    } ]
  }, {
    "tStartMs": 2742573,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "Away from modern military staples"
    } ]
  }, {
    "tStartMs": 2744658,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and it's only a matter of time\nbefore Timmies become the largest"
    } ]
  }, {
    "tStartMs": 2747578,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "bloc of gun owners."
    } ]
  }, {
    "tStartMs": 2749246,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "While he built his business on Desert"
    } ]
  }, {
    "tStartMs": 2750748,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "Eagles during Covid, he's bearish"
    } ]
  }, {
    "tStartMs": 2752791,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "on these meme guns and status pieces,\nespecially as the"
    } ]
  }, {
    "tStartMs": 2755711,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "economy worsens."
    } ]
  }, {
    "tStartMs": 2757087,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "Even though the CZ Shadow 2 has"
    } ]
  }, {
    "tStartMs": 2758881,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "been a strong seller,\nthe manufacturer's recent decision"
    } ]
  }, {
    "tStartMs": 2761884,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "to raise prices by 15%"
    } ]
  }, {
    "tStartMs": 2763761,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "has made him bearish."
    } ]
  }, {
    "tStartMs": 2765137,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "In his eyes, the gun success was rooted\nin value as much as competition pedigree."
    } ]
  }, {
    "tStartMs": 2770017,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "He anticipates demand to fall"
    } ]
  }, {
    "tStartMs": 2771602,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "as customers will start to question\nwhy they're paying more now for"
    } ]
  }, {
    "tStartMs": 2774730,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "the same exact gun."
    } ]
  }, {
    "tStartMs": 2776440,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Zi's skeptical of the FN SCAR."
    } ]
  }, {
    "tStartMs": 2778817,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "He sees this continuous drop as"
    } ]
  }, {
    "tStartMs": 2780569,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "not just a market correction,\nbut instead a free fall in demand."
    } ]
  }, {
    "tStartMs": 2783113,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "The stock is prone to breaking,"
    } ]
  }, {
    "tStartMs": 2785783,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "he gets regular complaints from"
    } ]
  }, {
    "tStartMs": 2787701,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "existing owners, and the rifle never truly achieved"
    } ]
  }, {
    "tStartMs": 2790037,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "lasting military pedigree."
    } ]
  }, {
    "tStartMs": 2791371,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "The SCAR has only seen niche adoption"
    } ]
  }, {
    "tStartMs": 2793457,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "by U.S. Army Rangers,"
    } ]
  }, {
    "tStartMs": 2794666,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "Navy SEALs and the UK,"
    } ]
  }, {
    "tStartMs": 2796794,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "French, and German special forces."
    } ]
  }, {
    "tStartMs": 2798837,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "The only thing propping up demand\ntoday is video game hype,"
    } ]
  }, {
    "tStartMs": 2801632,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and that's a flimsy hook,\nespecially when most modern titles"
    } ]
  }, {
    "tStartMs": 2804635,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "are dodging the licensing fees\nwith fake gun names. And asking"
    } ]
  }, {
    "tStartMs": 2808263,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "customers to shell out $3,000 for a \nmostly plastic"
    } ]
  }, {
    "tStartMs": 2811391,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "rifle is hard to justify\nin this current era"
    } ]
  }, {
    "tStartMs": 2814186,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "of quality metal-based AR-15s."
    } ]
  }, {
    "tStartMs": 2817272,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "In Zi's view, the SCAR suffers\nfrom the same problems that plague"
    } ]
  }, {
    "tStartMs": 2820984,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "FN's other firearms."
    } ]
  }, {
    "tStartMs": 2823862,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "For him, FN has coasted far too \nlong on its past glories"
    } ]
  }, {
    "tStartMs": 2826031,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and these aging models have made the"
    } ]
  }, {
    "tStartMs": 2827741,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "manufacturer an afterthought in the race\nfor modern military contracts."
    } ]
  }, {
    "tStartMs": 2831995,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "It's the same case with Colt."
    } ]
  }, {
    "tStartMs": 2833580,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "The M4 and M16 are iconic"
    } ]
  }, {
    "tStartMs": 2836041,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "in history, cinema, and video games"
    } ]
  }, {
    "tStartMs": 2838794,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "as a standard issue, rifles\nfor the American military since"
    } ]
  }, {
    "tStartMs": 2841588,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "the Vietnam War. Yet the Colt AR-15"
    } ]
  }, {
    "tStartMs": 2844383,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "has been overshadowed in price and popularity"
    } ]
  }, {
    "tStartMs": 2846885,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "by AR-15s from newer\nsmaller manufacturers like"
    } ]
  }, {
    "tStartMs": 2849972,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Daniel Defense and BCM, which"
    } ]
  }, {
    "tStartMs": 2852266,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "demonstrate that even strong"
    } ]
  }, {
    "tStartMs": 2853600,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "recognition, entrenched"
    } ]
  }, {
    "tStartMs": 2855102,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "military pedigree, and"
    } ]
  }, {
    "tStartMs": 2856478,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "legacy is not necessarily enough\nfor pricing power."
    } ]
  }, {
    "tStartMs": 2859940,
    "dDurationMs": 5339,
    "segs": [ {
      "utf8": "But Zi is bullish on the discontinued\nFN2000 because permanent scarcity"
    } ]
  }, {
    "tStartMs": 2865279,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "means guaranteed depreciation\neven if the rifle is mostly plastic and"
    } ]
  }, {
    "tStartMs": 2869449,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "just as fragile as the SCAR."
    } ]
  }, {
    "tStartMs": 2871451,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "And he stays far away from the FN P90\ndespite its military pedigree, pop"
    } ]
  }, {
    "tStartMs": 2876081,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "culture relevance, and futuristic design.\nThe ammo is expensive,"
    } ]
  }, {
    "tStartMs": 2880127,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "it's outclassed in the range\nby even the cheapest AR-15,"
    } ]
  }, {
    "tStartMs": 2883463,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "and the constant overproduction\nmakes appreciation impossible."
    } ]
  }, {
    "tStartMs": 2887342,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "But at the same time,"
    } ]
  }, {
    "tStartMs": 2888343,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "pop culture hype is fleeting."
    } ]
  }, {
    "tStartMs": 2890095,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Bushmaster marketed\nthe ACR as a revolutionary rifle in"
    } ]
  }, {
    "tStartMs": 2893515,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "the late 2000s, building up\nmainstream retail"
    } ]
  }, {
    "tStartMs": 2896018,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "hype by having the gun\nfeatured as an intentionally."
    } ]
  }, {
    "tStartMs": 2898520,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "overpowered multiplayer \npick in Call of Duty."
    } ]
  }, {
    "tStartMs": 2901148,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "Yet the in-game popularity\nnever translated to retail"
    } ]
  }, {
    "tStartMs": 2904026,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "success as gun owners\nbalked at the high price tag in a sea"
    } ]
  }, {
    "tStartMs": 2907446,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Of affordable AR-15s. Without"
    } ]
  }, {
    "tStartMs": 2909740,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "military contracts,"
    } ]
  }, {
    "tStartMs": 2910866,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "ACR prices fell year after year"
    } ]
  }, {
    "tStartMs": 2912993,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "until its discontinuation in 2016."
    } ]
  }, {
    "tStartMs": 2916163,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "But strangely enough, the model is \nnow appreciating as a"
    } ]
  }, {
    "tStartMs": 2919333,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "collector's item simply due to scarcity."
    } ]
  }, {
    "tStartMs": 2922085,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "But demand can also collapse"
    } ]
  }, {
    "tStartMs": 2923545,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "overnight based on real world events."
    } ]
  }, {
    "tStartMs": 2925923,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "The Sig P320 had been\none of the decade's most popular handguns,"
    } ]
  }, {
    "tStartMs": 2929718,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "enjoying unparalleled pedigree."
    } ]
  }, {
    "tStartMs": 2932220,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "as a standard issue sidearm\nfor the U.S. military and law enforcement"
    } ]
  }, {
    "tStartMs": 2935474,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "agencies across the nation."
    } ]
  }, {
    "tStartMs": 2937434,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "Yet retail demand this"
    } ]
  }, {
    "tStartMs": 2938477,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "year has cratered after widespread safety"
    } ]
  }, {
    "tStartMs": 2940604,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "concerns. Hundreds of civilians and"
    } ]
  }, {
    "tStartMs": 2942940,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "officers reported that their P320\ndischarged without a trigger"
    } ]
  }, {
    "tStartMs": 2946944,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "pull, even while holstered."
    } ]
  }, {
    "tStartMs": 2948528,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "The issue reached a breaking point\nthis year, when the"
    } ]
  }, {
    "tStartMs": 2950864,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "malfunction killed an on-base"
    } ]
  }, {
    "tStartMs": 2952115,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "American soldier and led to the Air Force"
    } ]
  }, {
    "tStartMs": 2954576,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "issuing a suspension for all P320s."
    } ]
  }, {
    "tStartMs": 2957621,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "SIG has responded with rapid categorical"
    } ]
  }, {
    "tStartMs": 2960248,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "denials, insisting that the \nhandgun meets all safety"
    } ]
  }, {
    "tStartMs": 2964127,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "standards and no mechanical defect exists.\nBut this wall of denial has only deepened"
    } ]
  }, {
    "tStartMs": 2968090,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "public skepticism about the gun and its manufacturer."
    } ]
  }, {
    "tStartMs": 2971593,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Zi has witnessed customers\navoiding the SIG brand entirely."
    } ]
  }, {
    "tStartMs": 2974763,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "New P320s"
    } ]
  }, {
    "tStartMs": 2975889,
    "dDurationMs": 4379,
    "segs": [ {
      "utf8": "have dropped as low as $200, over\nhalf off their average retail price, and"
    } ]
  }, {
    "tStartMs": 2980268,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "still, no one's buying."
    } ]
  }, {
    "tStartMs": 2982187,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "Zi fears this negativity will start\nto spread to SIG's other models"
    } ]
  }, {
    "tStartMs": 2985732,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "and he isn't stocking any new SIG"
    } ]
  }, {
    "tStartMs": 2987526,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "products for the immediate future."
    } ]
  }, {
    "tStartMs": 2989945,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "In his eyes, Taran Tactical fills\na valuable niche in high-end"
    } ]
  }, {
    "tStartMs": 2993532,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "handguns and can"
    } ]
  }, {
    "tStartMs": 2994574,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "catch buyers who might walk \ninto a store seeking"
    } ]
  }, {
    "tStartMs": 2997119,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "a Nighthawk, but would still \nbe open to a Pit Viper."
    } ]
  }, {
    "tStartMs": 2999871,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "Still, he wonders how much mileage is left\nin the John Wick halo, especially"
    } ]
  }, {
    "tStartMs": 3004126,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "as the franchise drifts into spin offs."
    } ]
  }, {
    "tStartMs": 3006795,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "The guns that he is bullish on\nare the ones that nail aesthetics,"
    } ]
  }, {
    "tStartMs": 3009923,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "performance, and, strong modern\nmilitary pedigree"
    } ]
  }, {
    "tStartMs": 3012718,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "like the Knights Armament"
    } ]
  }, {
    "tStartMs": 3013385,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "SR-25, "
    } ]
  }, {
    "tStartMs": 3015804,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "the HK 556A4,"
    } ]
  }, {
    "tStartMs": 3017973,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "the LMT MARS-H, and the SIG MCX spear."
    } ]
  }, {
    "tStartMs": 3021435,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "These rifles are firmly entrenched\nin the modern Western military arsenal"
    } ]
  }, {
    "tStartMs": 3025522,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "and all it could take to drive up\ndemand and market value is"
    } ]
  }, {
    "tStartMs": 3028692,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "footage from"
    } ]
  }, {
    "tStartMs": 3029401,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "Ukraine of any of these guns"
    } ]
  }, {
    "tStartMs": 3030986,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "tearing through Russian armor."
    } ]
  }, {
    "tStartMs": 3032779,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "LMT, Knights Armament, and HK are also"
    } ]
  }, {
    "tStartMs": 3035949,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "all military-first manufacturers\nthat prioritize"
    } ]
  }, {
    "tStartMs": 3038994,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "the civilian market last,\nwhich also means"
    } ]
  }, {
    "tStartMs": 3041455,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "that overproduction"
    } ]
  }, {
    "tStartMs": 3042497,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "is unlikely."
    } ]
  }, {
    "tStartMs": 3043665,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Yet some manufacturers never make it\nonto Zi's shelves."
    } ]
  }, {
    "tStartMs": 3046918,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "Brands like Palmetto State Armory,\nChristiansen Arms, Springfield,"
    } ]
  }, {
    "tStartMs": 3051339,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "and Bear Creek to him\nare all hype over substance"
    } ]
  }, {
    "tStartMs": 3054468,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "who peddle unreliable, shoddy, and\noverpriced products."
    } ]
  }, {
    "tStartMs": 3057804,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "For Zee, it's not a matter of opinion,\nbut his way of protecting his customers."
    } ]
  }, {
    "tStartMs": 3108313,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "He sticks to the models and markets\nhe knows best."
    } ]
  }, {
    "tStartMs": 3111191,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "He doesn't pretend to have any insight on"
    } ]
  }, {
    "tStartMs": 3113151,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "Fudd firearms like break barrel"
    } ]
  }, {
    "tStartMs": 3114820,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "shotguns, bolt-action rifles,"
    } ]
  }, {
    "tStartMs": 3116822,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "and lever actions. Just like the average\nJoe investing in stocks,"
    } ]
  }, {
    "tStartMs": 3120826,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "most dealers and gun store owners"
    } ]
  }, {
    "tStartMs": 3122911,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "generally stick to what they know.\nIn this low-information environment,"
    } ]
  }, {
    "tStartMs": 3126873,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "the difference from fact, informed opinion,\nand educated guess."
    } ]
  }, {
    "tStartMs": 3130710,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "is impossible to separate."
    } ]
  }, {
    "tStartMs": 3132712,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "Every gun store\nowner has strong opinions"
    } ]
  }, {
    "tStartMs": 3135090,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "Bbcause that's their job."
    } ]
  }, {
    "tStartMs": 3136591,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "They have to have conviction\nin the models and brands"
    } ]
  }, {
    "tStartMs": 3139010,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "they invest in, and no one stays afloat\nbuying one of everything."
    } ]
  }, {
    "tStartMs": 3142597,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "And because they've put their own money\nbehind every gun in their store"
    } ]
  }, {
    "tStartMs": 3145767,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "or have developed relationships\nwith certain brands over"
    } ]
  }, {
    "tStartMs": 3148645,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "others, they naturally take losses\nand wins personally."
    } ]
  }, {
    "tStartMs": 3152190,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "But in the end, the most \nsuccessful dealers and stores"
    } ]
  }, {
    "tStartMs": 3154943,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "are the ones with the best information."
    } ]
  }, {
    "tStartMs": 3157195,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "If you know in advance that \na model is being discontinued"
    } ]
  }, {
    "tStartMs": 3160365,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "or that production is ramping up \non a gun that's typically scarce"
    } ]
  }, {
    "tStartMs": 3163869,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "you can stock up."
    } ]
  }, {
    "tStartMs": 3164786,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "before the boom or liquidate\nbefore the crash."
    } ]
  }, {
    "tStartMs": 3168165,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "That's why relationships are foundational"
    } ]
  }, {
    "tStartMs": 3170125,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "in the gun world."
    } ]
  }, {
    "tStartMs": 3171209,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "They don't just build trust \nwith locals, set you apart"
    } ]
  }, {
    "tStartMs": 3173336,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "from other gun stores and dealers,\nand extend customer lifetime"
    } ]
  }, {
    "tStartMs": 3176923,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "value - they also maximize information flow."
    } ]
  }, {
    "tStartMs": 3179926,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "Zero Whiskey Tactical is small \nenough, where Zi"
    } ]
  }, {
    "tStartMs": 3182554,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "can meet, shake hands, and build connections"
    } ]
  }, {
    "tStartMs": 3184973,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "with every single customer who walks in"
    } ]
  }, {
    "tStartMs": 3187225,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "and you never know who's who."
    } ]
  }, {
    "tStartMs": 3188727,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "Someone's experience with a"
    } ]
  }, {
    "tStartMs": 3189936,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "specific model, good or bad, could be a one-off"
    } ]
  }, {
    "tStartMs": 3192606,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "or the first sign"
    } ]
  }, {
    "tStartMs": 3193607,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "of a trend that alters supply and demand"
    } ]
  }, {
    "tStartMs": 3196026,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "over time."
    } ]
  }, {
    "tStartMs": 3197152,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "In this regard,"
    } ]
  }, {
    "tStartMs": 3198069,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Zi's evolution is fascinating"
    } ]
  }, {
    "tStartMs": 3200071,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "from a profit-driven,\nruthless scalper to"
    } ]
  }, {
    "tStartMs": 3202741,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "conscientious, humble, and personable owner."
    } ]
  }, {
    "tStartMs": 3271768,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Zero Whiskey Tactical grosses \non average $200,000 a month"
    } ]
  }, {
    "tStartMs": 3275855,
    "dDurationMs": 4422,
    "segs": [ {
      "utf8": "for an annual run rate of $2.4 million a year."
    } ]
  }, {
    "tStartMs": 3280277,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "95% of sales are new guns.\nWith only one store,"
    } ]
  }, {
    "tStartMs": 3282946,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Zi works the shop himself every day."
    } ]
  }, {
    "tStartMs": 3285949,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "And since he's not paying himself, the"
    } ]
  }, {
    "tStartMs": 3287867,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "low payroll means higher operating margins"
    } ]
  }, {
    "tStartMs": 3290370,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "at an average of 15%."
    } ]
  }, {
    "tStartMs": 3292580,
    "dDurationMs": 2420,
    "segs": [ {
      "utf8": "The gun industry is a paradox, at once"
    } ]
  }, {
    "tStartMs": 3295000,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "enormous and fragmented,\nnational yet local,"
    } ]
  }, {
    "tStartMs": 3298128,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "political yet human to its core.\nLow information is"
    } ]
  }, {
    "tStartMs": 3301631,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "both its greatest challenge\nand its greatest moat,"
    } ]
  }, {
    "tStartMs": 3304050,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "where small, independent\nshops are insulated from the corporate"
    } ]
  }, {
    "tStartMs": 3307262,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "consolidation that has taken"
    } ]
  }, {
    "tStartMs": 3308888,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "over every other retail sector."
    } ]
  }, {
    "tStartMs": 3310849,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "Mister Guns and Zero Whiskey Tactical"
    } ]
  }, {
    "tStartMs": 3312976,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "are two gun stores chasing\nafter different markets in different"
    } ]
  }, {
    "tStartMs": 3316021,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "cities in Texas"
    } ]
  }, {
    "tStartMs": 3317105,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "and yet they have made the same bet"
    } ]
  }, {
    "tStartMs": 3318773,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "as every other gun store in the nation."
    } ]
  }, {
    "tStartMs": 3321151,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "The only reliable tools to navigating\nconsumer irrationality,"
    } ]
  }, {
    "tStartMs": 3324904,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "supply chain uncertainty, commoditization,\nand non-existent data"
    } ]
  }, {
    "tStartMs": 3329326,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "is constant observation and \nreal human relationships."
    } ]
  }, {
    "tStartMs": 3342964,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "Ditch the other"
    } ]
  }, {
    "tStartMs": 3343590,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "hiring sites and let ZipRecruiter\nfind what you're looking for -"
    } ]
  }, {
    "tStartMs": 3346676,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "the needle in the haystack."
    } ]
  }, {
    "tStartMs": 3348053,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "4 out of 5 employers\nwho post on ZipRecruiter"
    } ]
  }, {
    "tStartMs": 3350638,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "get a quality candidate\nwithin the first day."
    } ]
  }, {
    "tStartMs": 3352891,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Try it for free at this \nexclusive web address."
    } ]
  }, {
    "tStartMs": 3355560,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "ziprecruiter.com/MBA."
    } ]
  }, {
    "tStartMs": 3358146,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "Again, that's ZipRecruiter.com/MBA."
    } ]
  }, {
    "tStartMs": 3359397,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "ZipRecruiter. "
    } ]
  }, {
    "tStartMs": 3363151,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The smartest way to hire."
    } ]
  } ]
}
