  "events": [ {
    "tStartMs": 11928,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "The Second Amendment has made the United"
    } ]
  }, {
    "tStartMs": 13972,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "States the world's largest firearms\nmarket."
    } ]
  }, {
    "tStartMs": 18435,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "While gun ownership in"
    } ]
  }, {
    "tStartMs": 19561,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "every other country"
    } ]
  }, {
    "tStartMs": 20520,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "is a licensed privilege, in America\nit's a constitutional right."
    } ]
  }, {
    "tStartMs": 24357,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "That distinction makes the U.S. the only."
    } ]
  }, {
    "tStartMs": 26526,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "nation in the world with"
    } ]
  }, {
    "tStartMs": 27694,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "more guns than people and the undisputed\nleader in civilian gun ownership."
    } ]
  }, {
    "tStartMs": 32032,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Americans don't just buy \none firearm for life."
    } ]
  }, {
    "tStartMs": 34701,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "They collect millions every year."
    } ]
  }, {
    "tStartMs": 36661,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "Civilian spending on guns surpasses\neven what the U.S."
    } ]
  }, {
    "tStartMs": 39873,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "military spends on its troops,"
    } ]
  }, {
    "tStartMs": 41624,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "an astonishing benchmark"
    } ]
  }, {
    "tStartMs": 42959,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "for the most heavily funded,\nglobally deployed army on the planet."
    } ]
  }, {
    "tStartMs": 46713,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "In the simplest terms, the American\ncivilian market is the most coveted"
    } ]
  }, {
    "tStartMs": 50467,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "and lucrative prize for gun"
    } ]
  }, {
    "tStartMs": 52010,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "manufacturers and dealers anywhere."
    } ]
  }, {
    "tStartMs": 54471,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Even as state and federal regulations\ntighten, the U.S."
    } ]
  }, {
    "tStartMs": 57766,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "remains by global standards\nthe most accessible consumer"
    } ]
  }, {
    "tStartMs": 60810,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "firearms market, where purchases\nare the most frequent, markups"
    } ]
  }, {
    "tStartMs": 64814,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "are the highest, and \nmargins are the richest."
    } ]
  }, {
    "tStartMs": 67442,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "Any gun maker"
    } ]
  }, {
    "tStartMs": 68318,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "that captures a fraction of this market\nearns more than they would from any"
    } ]
  }, {
    "tStartMs": 71696,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "government,"
    } ]
  }, {
    "tStartMs": 72322,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "military, or law enforcement contract."
    } ]
  }, {
    "tStartMs": 74991,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "But the gun business is unlike any other."
    } ]
  }, {
    "tStartMs": 77118,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "The retail side is ruled"
    } ]
  }, {
    "tStartMs": 78578,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "by old school relationships and word\nof mouth."
    } ]
  }, {
    "tStartMs": 81164,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "There's no data, standardized"
    } ]
  }, {
    "tStartMs": 82832,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "benchmark, rating aggregators, price\ntrackers, and little literature from"
    } ]
  }, {
    "tStartMs": 87170,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "even the manufacturers themselves."
    } ]
  }, {
    "tStartMs": 89255,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "The information that does\nexist is anecdotal and scattered"
    } ]
  }, {
    "tStartMs": 92383,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "across niche forums,"
    } ]
  }, {
    "tStartMs": 93760,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "publications and YouTube videos\nwith tens of thousands of"
    } ]
  }, {
    "tStartMs": 97138,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "different models offered in various\nconfigurations, trims, and calibers."
    } ]
  }, {
    "tStartMs": 101142,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Pricing is opaque\nand knowledge is fragmented."
    } ]
  }, {
    "tStartMs": 104145,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "Buying guns is a lot like buying"
    } ]
  }, {
    "tStartMs": 105772,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "sneakers, watches, or Pokemon cards."
    } ]
  }, {
    "tStartMs": 108191,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Purchases are driven\nmore by perception than performance"
    } ]
  }, {
    "tStartMs": 111236,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "and the business is fueled by information"
    } ]
  }, {
    "tStartMs": 113363,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "arbitrage over hard data."
    } ]
  }, {
    "tStartMs": 115490,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Every firearm is like a stock\nwhich goes up or down based"
    } ]
  }, {
    "tStartMs": 118785,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "on supply and demand\nfor that specific model."
    } ]
  }, {
    "tStartMs": 122038,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "In this low information\nindustry, successful"
    } ]
  }, {
    "tStartMs": 124582,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "dealers and stores must wield their"
    } ]
  }, {
    "tStartMs": 126417,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "intuition, knowledge, and"
    } ]
  }, {
    "tStartMs": 128002,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "relationships to predict and stock\nwhat customers will want to buy."
    } ]
  }, {
    "tStartMs": 131714,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "The reality is that the information\ngap begins upstream."
    } ]
  }, {
    "tStartMs": 134634,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Retail is just where it shows up."
    } ]
  }, {
    "tStartMs": 136553,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "Manufacturing is globally fragmented\nand shaped more by politics than logic."
    } ]
  }, {
    "tStartMs": 141099,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "There are popular guns,"
    } ]
  }, {
    "tStartMs": 142350,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "but no single design,"
    } ]
  }, {
    "tStartMs": 143977,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "standard, spec, or manufacturer \nrules the world."
    } ]
  }, {
    "tStartMs": 147564,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "Even though most of the money\nis in retail,"
    } ]
  }, {
    "tStartMs": 149691,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "innovation is driven by the military,"
    } ]
  }, {
    "tStartMs": 151818,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "the main application \nfor guns around the world."
    } ]
  }, {
    "tStartMs": 154696,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "Every major power develops\nan arsenal for its armed forces."
    } ]
  }, {
    "tStartMs": 158324,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "It's not just the U.S. as longstanding \nallies like Israel, the UK and"
    } ]
  }, {
    "tStartMs": 162704,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "South Korea build their own firearms."
    } ]
  }, {
    "tStartMs": 165165,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "Neutral nations such as Switzerland,"
    } ]
  }, {
    "tStartMs": 167208,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "island powers like"
    } ]
  }, {
    "tStartMs": 168168,
    "dDurationMs": 4921,
    "segs": [ {
      "utf8": "Japan and even struggling economies\nlike Italy or Mexico maintain domestic"
    } ]
  }, {
    "tStartMs": 173089,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "firearms production."
    } ]
  }, {
    "tStartMs": 174757,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "And with NATO,"
    } ]
  }, {
    "tStartMs": 175758,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "the world's largest military"
    } ]
  }, {
    "tStartMs": 177260,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "alliance, most"
    } ]
  }, {
    "tStartMs": 178344,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "members prefer their own designs."
    } ]
  }, {
    "tStartMs": 180555,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "For any country, domestic gun\nproduction eliminates dependance on"
    } ]
  }, {
    "tStartMs": 184017,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "foreign suppliers,"
    } ]
  }, {
    "tStartMs": 185143,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "optimizes weapons for local combat, keeps"
    } ]
  }, {
    "tStartMs": 187729,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "sensitive information inside borders,\nand provides leverage in foreign"
    } ]
  }, {
    "tStartMs": 191399,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "policy."
    } ]
  }, {
    "tStartMs": 192400,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "As a result,"
    } ]
  }, {
    "tStartMs": 193067,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "the industry is tightly bound to politics."
    } ]
  }, {
    "tStartMs": 195403,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Manufacturers can't pursue profit over"
    } ]
  }, {
    "tStartMs": 197780,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "state as exports require government\napproval from both sides."
    } ]
  }, {
    "tStartMs": 201492,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "In some countries,"
    } ]
  }, {
    "tStartMs": 202452,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "that makes firearms a low margin \nand low volume business."
    } ]
  }, {
    "tStartMs": 205830,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "In Singapore, gun making"
    } ]
  }, {
    "tStartMs": 207582,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "only survives as an arm of the state."
    } ]
  }, {
    "tStartMs": 209751,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "The island's military is its"
    } ]
  }, {
    "tStartMs": 211336,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "only customer and the government \nhas only allowed"
    } ]
  }, {
    "tStartMs": 213922,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "exports to remote, non-aligned \ncountries like Botswana or Peru"
    } ]
  }, {
    "tStartMs": 218176,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "far removed from any major"
    } ]
  }, {
    "tStartMs": 219761,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "West/East flashpoints"
    } ]
  }, {
    "tStartMs": 221095,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "or war zones."
    } ]
  }, {
    "tStartMs": 222180,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "In contrast, the gun business is surging"
    } ]
  }, {
    "tStartMs": 224599,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "in Japan."
    } ]
  }, {
    "tStartMs": 225475,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Lawmakers have invested\nlarger sums into the"
    } ]
  }, {
    "tStartMs": 227852,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "military, despite"
    } ]
  }, {
    "tStartMs": 228937,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "the sluggish economy and the"
    } ]
  }, {
    "tStartMs": 230313,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "country's postwar pacifism."
    } ]
  }, {
    "tStartMs": 232232,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "Howa's business has grown\nwith new rifle contracts"
    } ]
  }, {
    "tStartMs": 234984,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "for the Japanese"
    } ]
  }, {
    "tStartMs": 235818,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Armed Forces and yet their growth is capped."
    } ]
  }, {
    "tStartMs": 238571,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "Japan permits Howa to"
    } ]
  }, {
    "tStartMs": 240198,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "export sporting rifles to the"
    } ]
  }, {
    "tStartMs": 241741,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "U.S. but bans"
    } ]
  }, {
    "tStartMs": 242867,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "foreign sales of their military-grade firearms."
    } ]
  }, {
    "tStartMs": 245995,
    "dDurationMs": 4630,
    "segs": [ {
      "utf8": "Meanwhile, in South Korea, the industry is\nbooming thanks to a president intent on"
    } ]
  }, {
    "tStartMs": 250625,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "making the country a top four global exporter."
    } ]
  }, {
    "tStartMs": 253503,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "Korean gunmakers are encouraged to sell to"
    } ]
  }, {
    "tStartMs": 255922,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "governments and U.S. civilians."
    } ]
  }, {
    "tStartMs": 258341,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "In short, politics determines what"
    } ]
  }, {
    "tStartMs": 260260,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "gets made, how much goes"
    } ]
  }, {
    "tStartMs": 261678,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "out the door, and where it ends"
    } ]
  }, {
    "tStartMs": 263179,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "up - and the same dynamic plays out\nin the American civilian market."
    } ]
  }, {
    "tStartMs": 267016,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "The U.S. government decides\nwhich foreign manufacturers"
    } ]
  }, {
    "tStartMs": 269936,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "get to sell here and the logic is"
    } ]
  }, {
    "tStartMs": 271729,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "more political than economic."
    } ]
  }, {
    "tStartMs": 273523,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "The major"
    } ]
  }, {
    "tStartMs": 274023,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "players today are gunmakers\nbased in NATO member nations or major U.S."
    } ]
  }, {
    "tStartMs": 278278,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "allies, while"
    } ]
  }, {
    "tStartMs": 279112,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "those from adversaries like China \nand Russia have been shut out."
    } ]
  }, {
    "tStartMs": 282573,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "Yet before their respective"
    } ]
  }, {
    "tStartMs": 283866,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "bans in the 1990s and 2010s, Chinese\nand Russian manufacturers dominated"
    } ]
  }, {
    "tStartMs": 288788,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "as leading suppliers"
    } ]
  }, {
    "tStartMs": 290039,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "of AK rifles to American civilians."
    } ]
  }, {
    "tStartMs": 292667,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "In short, U.S."
    } ]
  }, {
    "tStartMs": 293751,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "policy determines who gets to \nparticipate in this market."
    } ]
  }, {
    "tStartMs": 297588,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Ultimately, companies\nwho do get to sell to American"
    } ]
  }, {
    "tStartMs": 300258,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "civilians grow significantly \nmore than those who don't."
    } ]
  }, {
    "tStartMs": 303594,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "The highest grossing manufacturers in the\nworld, Italy's Beretta, Austria's Glock."
    } ]
  }, {
    "tStartMs": 308599,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "And Germany's HK, each"
    } ]
  }, {
    "tStartMs": 310393,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "reap 30-90% of their sales\nevery year from American"
    } ]
  }, {
    "tStartMs": 313980,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "civilians."
    } ]
  }, {
    "tStartMs": 314981,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "So even though governments are"
    } ]
  }, {
    "tStartMs": 316357,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "the main driver and customer for firearms,"
    } ]
  }, {
    "tStartMs": 318901,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "the money"
    } ]
  }, {
    "tStartMs": 319485,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "is really in the American public\nfor gunmakers."
    } ]
  }, {
    "tStartMs": 322822,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Government contracts deliver nominally\nlarge payouts -"
    } ]
  }, {
    "tStartMs": 325950,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "deals worth hundreds of millions,\nsometimes billions"
    } ]
  }, {
    "tStartMs": 328536,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "spread over multiple years\nget awarded with the stroke of"
    } ]
  }, {
    "tStartMs": 331539,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "a pen. They provide steady cash\nflow and prestige."
    } ]
  }, {
    "tStartMs": 334500,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "But competition is fierce.\nWith so few armies"
    } ]
  }, {
    "tStartMs": 337587,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "and law enforcement agencies,"
    } ]
  }, {
    "tStartMs": 339047,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "procurement is slow and complex."
    } ]
  }, {
    "tStartMs": 341341,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "Gunmakers compete with each other not"
    } ]
  }, {
    "tStartMs": 343134,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "just on performance, but"
    } ]
  }, {
    "tStartMs": 344385,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "also on price, production, and support."
    } ]
  }, {
    "tStartMs": 347096,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "With field tests and bureaucracy,"
    } ]
  }, {
    "tStartMs": 349015,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "it can be years \nbefore a bid is selected."
    } ]
  }, {
    "tStartMs": 351476,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "But while government contracts\nare winner-take-all"
    } ]
  }, {
    "tStartMs": 353603,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "contests decided on function\nand value,"
    } ]
  }, {
    "tStartMs": 356397,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "the civilian market is the opposite."
    } ]
  }, {
    "tStartMs": 358649,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "Accuracy and utility\nultimately take a backseat"
    } ]
  }, {
    "tStartMs": 361444,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "to brand,"
    } ]
  }, {
    "tStartMs": 362487,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "aesthetics, perception,"
    } ]
  }, {
    "tStartMs": 364405,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "and the feeling of how a gun shoots."
    } ]
  }, {
    "tStartMs": 366824,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "The market value of every gun rises"
    } ]
  }, {
    "tStartMs": 369035,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "and falls based on changes in supply\nand demand for that specific model."
    } ]
  }, {
    "tStartMs": 373373,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Pre-ban Chinese and Russian\nAK rifles have"
    } ]
  }, {
    "tStartMs": 376167,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "tripled in value over the past decade\nfor their craftsmanship,"
    } ]
  }, {
    "tStartMs": 379379,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "authenticity, and"
    } ]
  }, {
    "tStartMs": 380421,
    "dDurationMs": 793,
    "segs": [ {
      "utf8": "scarcity."
    } ]
  }, {
    "tStartMs": 381214,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "Civilians willingly pay"
    } ]
  }, {
    "tStartMs": 382799,
    "dDurationMs": 1459,
    "segs": [ {
      "utf8": "a premium for Polytech,"
    } ]
  }, {
    "tStartMs": 384258,
    "dDurationMs": 668,
    "segs": [ {
      "utf8": "Norinco,"
    } ]
  }, {
    "tStartMs": 384926,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "and Molet rifles, as it's unlikely \ntheir manufacturers"
    } ]
  }, {
    "tStartMs": 388012,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "will ever get to re-enter the U.S. market."
    } ]
  }, {
    "tStartMs": 390556,
    "dDurationMs": 668,
    "segs": [ {
      "utf8": "But if you don't want"
    } ]
  }, {
    "tStartMs": 391224,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "to splurge, a better option\nwill be the cheaper Serbian"
    } ]
  }, {
    "tStartMs": 394268,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "ZPAP M7 or Romanian WASR10."
    } ]
  }, {
    "tStartMs": 397522,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "Since these countries\ncan import in these models"
    } ]
  }, {
    "tStartMs": 399774,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "every year with no restrictions,"
    } ]
  }, {
    "tStartMs": 401609,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "high supply means less appreciation,\neven though they're all fundamentally"
    } ]
  }, {
    "tStartMs": 405571,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "the same rifle."
    } ]
  }, {
    "tStartMs": 406697,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "The AK is just one example of"
    } ]
  }, {
    "tStartMs": 408825,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "how every type of"
    } ]
  }, {
    "tStartMs": 409742,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "gun is a market in itself, vulnerable to"
    } ]
  }, {
    "tStartMs": 412161,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "booms or crazy crashes."
    } ]
  }, {
    "tStartMs": 413788,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Based on changes in supply and demand,"
    } ]
  }, {
    "tStartMs": 416249,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "guns are like any other consumer commodity."
    } ]
  }, {
    "tStartMs": 418793,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "There's one group of budget-conscious\ncustomers, another that spares no expense"
    } ]
  }, {
    "tStartMs": 422922,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "collecting rare or luxury models,"
    } ]
  }, {
    "tStartMs": 425007,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "and the rest of the market\nthat settles in between these"
    } ]
  }, {
    "tStartMs": 427343,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "two extremes -"
    } ]
  }, {
    "tStartMs": 428302,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "and manufacturers exist"
    } ]
  }, {
    "tStartMs": 429929,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "along the spectrum."
    } ]
  }, {
    "tStartMs": 431889,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "While gun ownership is a right in"
    } ]
  }, {
    "tStartMs": 433057,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "the United States, gun promotion is not."
    } ]
  }, {
    "tStartMs": 435768,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Every major publication, cable network,"
    } ]
  }, {
    "tStartMs": 438479,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "social media platform, and search\nengine bans gun ads and"
    } ]
  }, {
    "tStartMs": 442066,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "restricts gun content."
    } ]
  }, {
    "tStartMs": 443609,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Gun manufacturers and stores\ncan't advertise"
    } ]
  }, {
    "tStartMs": 446279,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "On TV, Facebook, or in the newspaper."
    } ]
  }, {
    "tStartMs": 449031,
    "dDurationMs": 4964,
    "segs": [ {
      "utf8": "Unlike sneakers or Pokemon, where sales\ntrackers, aggregators, and marketplaces"
    } ]
  }, {
    "tStartMs": 453995,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "help narrow down the information"
    } ]
  }, {
    "tStartMs": 455580,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "gap for sellers and buyers,"
    } ]
  }, {
    "tStartMs": 457457,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "no comparable infrastructure exists\nfor firearms."
    } ]
  }, {
    "tStartMs": 460751,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "GunBroker, the industry's"
    } ]
  }, {
    "tStartMs": 462128,
    "dDurationMs": 4338,
    "segs": [ {
      "utf8": "equivalent of an eBay and Craigslist,\noffers no data even in its paid"
    } ]
  }, {
    "tStartMs": 466466,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "reports. Credit card\nprocessors and point of"
    } ]
  }, {
    "tStartMs": 469051,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "sale systems refuse to release \ntransaction data."
    } ]
  }, {
    "tStartMs": 471721,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "out of fear of"
    } ]
  }, {
    "tStartMs": 472388,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "lawsuits and optics. With high liability,"
    } ]
  }, {
    "tStartMs": 475516,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "de-platforming risk, and little reward,"
    } ]
  }, {
    "tStartMs": 477685,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "there's no incentive for anyone\nto close this information gap."
    } ]
  }, {
    "tStartMs": 481606,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "That leaves the average American\nwith one option -"
    } ]
  }, {
    "tStartMs": 484317,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "their local gun store."
    } ]
  }, {
    "tStartMs": 485902,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "For generations,\nbrick-and-mortar dealers have"
    } ]
  }, {
    "tStartMs": 488154,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "filled the knowledge gap"
    } ]
  }, {
    "tStartMs": 489113,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "between manufacturers and consumers.\nInsulated from the internet,"
    } ]
  }, {
    "tStartMs": 493034,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "gun stores uniquely"
    } ]
  }, {
    "tStartMs": 494243,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "possess the knowledge and inventory\nacross brands"
    } ]
  }, {
    "tStartMs": 497038,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and provide education\nto civilians that no single gunmaker"
    } ]
  }, {
    "tStartMs": 500041,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "ever would."
    } ]
  }, {
    "tStartMs": 501375,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "It's a market unlike any other"
    } ]
  }, {
    "tStartMs": 503044,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "in the world, where a VC-backed \nstartup or corporate"
    } ]
  }, {
    "tStartMs": 505671,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "entity can't muscle"
    } ]
  }, {
    "tStartMs": 507089,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "in and carve up competitors with cash"
    } ]
  }, {
    "tStartMs": 509217,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "the way they can in other industries."
    } ]
  }, {
    "tStartMs": 511469,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "With the blanket ban on marketing\nand the generational"
    } ]
  }, {
    "tStartMs": 514013,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "suppression of information,"
    } ]
  }, {
    "tStartMs": 515473,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "word of mouth and"
    } ]
  }, {
    "tStartMs": 516390,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "relationships are the only path\nto success"
    } ]
  }, {
    "tStartMs": 518851,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "for gun stores."
    } ]
  }, {
    "tStartMs": 520102,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "In this Modern MBA Original,\nwe go boots on the ground"
    } ]
  }, {
    "tStartMs": 523105,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "with one of the largest gun dealers\nin the nation, Mister Guns,"
    } ]
  }, {
    "tStartMs": 525858,
    "dDurationMs": 5089,
    "segs": [ {
      "utf8": "who owns four stores across Dallas,\nand Zero Whiskey Tactical Arms in Austin,"
    } ]
  }, {
    "tStartMs": 530947,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "an emerging high-end gun shop\nthat was once the second-highest"
    } ]
  }, {
    "tStartMs": 534242,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "seller of Barrett .50 caliber \nrifles in the state."
    } ]
  }, {
    "tStartMs": 540915,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "What does the future hold in business?"
    } ]
  }, {
    "tStartMs": 542875,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Asked nine experts,\nand you'll get ten answers."
    } ]
  }, {
    "tStartMs": 545628,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "Turn on any news channel and you'll see\ntalking heads pounding the table,"
    } ]
  }, {
    "tStartMs": 549090,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "proclaiming it's a bull market today,\nonly to call it bearish"
    } ]
  }, {
    "tStartMs": 552260,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "the next. One week,\nthey'll explain why stocks are rising,"
    } ]
  }, {
    "tStartMs": 555388,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "then the next they'll argue just\nas confidently that they're heading down."
    } ]
  }, {
    "tStartMs": 558683,
    "dDurationMs": 2460,
    "segs": [ {
      "utf8": "Could someone please\ninvent a crystal ball?"
    } ]
  }, {
    "tStartMs": 561143,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "Until then, over 43,000 businesses\nhave futureproofed their business"
    } ]
  }, {
    "tStartMs": 565022,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "with NetSuite by Oracle -"
    } ]
  }, {
    "tStartMs": 566482,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "the number one AI, cloud ERP\nbring accounting, finance, inventory,"
    } ]
  }, {
    "tStartMs": 571070,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "and HR into one fluid platform with one\nunified business management suite."
    } ]
  }, {
    "tStartMs": 575783,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "There's one source of truth\ngiving you the visibility and control"
    } ]
  }, {
    "tStartMs": 578869,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "you need to make quick decisions."
    } ]
  }, {
    "tStartMs": 580705,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "With real-time insights and forecasting,\nyou're peering into the future"
    } ]
  }, {
    "tStartMs": 584000,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "with actionable data."
    } ]
  }, {
    "tStartMs": 585293,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "When you're closing the books in days,\nnot weeks, you're spending"
    } ]
  }, {
    "tStartMs": 588045,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "less time looking backwards\nand more time on what's next."
    } ]
  }, {
    "tStartMs": 591382,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Modern MBA is small at the moment,"
    } ]
  }, {
    "tStartMs": 593384,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "but as soon as we scale,\nwe will need and use NetSuite."
    } ]
  }, {
    "tStartMs": 596387,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "Today we're switching things manually"
    } ]
  }, {
    "tStartMs": 598139,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "and it's gotten harder\nto assess our business health."
    } ]
  }, {
    "tStartMs": 600474,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "We need to track our production costs\nto run payroll compliant with"
    } ]
  }, {
    "tStartMs": 603686,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "multiple states, and to evaluate profit\nand loss by team and project."
    } ]
  }, {
    "tStartMs": 607565,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "As a corporation, we pay tax\nthroughout the year and it's a nightmare"
    } ]
  }, {
    "tStartMs": 611068,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "jumping from system to system\njust to get one answer."
    } ]
  }, {
    "tStartMs": 614322,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "These are capabilities\nthat only NetSuite provides,"
    } ]
  }, {
    "tStartMs": 616949,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "and it's a platform\nthat we intend to take every advantage of."
    } ]
  }, {
    "tStartMs": 620536,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "Whether your company is earning millions\nor even hundreds of millions, NetSuite"
    } ]
  }, {
    "tStartMs": 624248,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "helps you respond to immediate challenges\nand seize your biggest opportunities."
    } ]
  }, {
    "tStartMs": 628377,
    "dDurationMs": 4505,
    "segs": [ {
      "utf8": "Speaking of opportunity, download the CFO's\nGuide to AI and Machine Learning"
    } ]
  }, {
    "tStartMs": 632882,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "at NetSuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 636260,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The guide is free to you\nat NetSuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 639722,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "NetSuite.com/ModernMBA"
    } ]
  }, {
    "tStartMs": 642808,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "NetSuite.com/ModernMBA"
    } ]
  }, {
    "tStartMs": 647146,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "The modern American civilian gun\nmarket has been shaped"
    } ]
  }, {
    "tStartMs": 649857,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "by four paradigm shifts that permanently"
    } ]
  }, {
    "tStartMs": 652068,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "altered supply, demand, and gun culture."
    } ]
  }, {
    "tStartMs": 655071,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "The first was the 1986. Firearms Owners."
    } ]
  }, {
    "tStartMs": 657865,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "Protection Act, which divided civilian\nsemi-automatics and"
    } ]
  }, {
    "tStartMs": 661243,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "military automatics for the first time."
    } ]
  }, {
    "tStartMs": 664705,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Before, civilians could legally buy\nand shoot fully automatic machine"
    } ]
  }, {
    "tStartMs": 668292,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "guns that fired continuously with"
    } ]
  }, {
    "tStartMs": 670252,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "one trigger pull."
    } ]
  }, {
    "tStartMs": 671504,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "After the bill passed, any new civilian"
    } ]
  }, {
    "tStartMs": 673756,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "firearms manufactured or imported into"
    } ]
  }, {
    "tStartMs": 676217,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "the U.S. had to be a semi-automatic,"
    } ]
  }, {
    "tStartMs": 678678,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "requiring a trigger pull for every round."
    } ]
  }, {
    "tStartMs": 681305,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "But the government could not\nretroactively"
    } ]
  }, {
    "tStartMs": 683057,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "confiscate the 180,000 machine"
    } ]
  }, {
    "tStartMs": 685393,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "guns already registered."
    } ]
  }, {
    "tStartMs": 686894,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Those grandfathered firearms,\ndecades later, remain"
    } ]
  }, {
    "tStartMs": 689605,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "the only machine guns\nan American can legally own,"
    } ]
  }, {
    "tStartMs": 692525,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and in turn have become\na hyper-inflated market."
    } ]
  }, {
    "tStartMs": 695569,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "A single one of these guns"
    } ]
  }, {
    "tStartMs": 696862,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "today retails\nfor five to six figures and"
    } ]
  }, {
    "tStartMs": 699365,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "since no replacements will ever exist,"
    } ]
  }, {
    "tStartMs": 701450,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "they enjoy incredible appreciation."
    } ]
  }, {
    "tStartMs": 703994,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "The second paradigm shift was the 1989"
    } ]
  }, {
    "tStartMs": 706122,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "import ban"
    } ]
  }, {
    "tStartMs": 707123,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "on assault weapons, prompted by a mass\nshooting that involved a Chinese AK-47."
    } ]
  }, {
    "tStartMs": 712086,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "The American gun market at\nthis point was flooded with AKs, FALs, and"
    } ]
  }, {
    "tStartMs": 716048,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "G3s from Europe, China, and Russia\nthat were much cheaper"
    } ]
  }, {
    "tStartMs": 719927,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "than any American-made rifle.\nUnder President George H.W. Bush,"
    } ]
  }, {
    "tStartMs": 724348,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "imports of these military styled\nrifles were banned as inappropriate"
    } ]
  }, {
    "tStartMs": 728144,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "for civilian use."
    } ]
  }, {
    "tStartMs": 729437,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Americans simply turned back to Colt\nand other domestic"
    } ]
  }, {
    "tStartMs": 732398,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "manufacturers to fill their demand,"
    } ]
  }, {
    "tStartMs": 734358,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "turning the AR-15 into the"
    } ]
  }, {
    "tStartMs": 736152,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "default rifle - a standard that endures to"
    } ]
  }, {
    "tStartMs": 738738,
    "dDurationMs": 750,
    "segs": [ {
      "utf8": "this day."
    } ]
  }, {
    "tStartMs": 739488,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "The third was the 1994 Assault Weapon\nBan under President Bill Clinton,"
    } ]
  }, {
    "tStartMs": 743951,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "a 10 year ban on new imports and domestic\nproduction for certain semi-automatic firearms"
    } ]
  }, {
    "tStartMs": 749331,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "and magazines holding more than ten rounds."
    } ]
  }, {
    "tStartMs": 752168,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "Just like with pre-1986"
    } ]
  }, {
    "tStartMs": 753377,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "machine guns, any pre-1994"
    } ]
  }, {
    "tStartMs": 755796,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "firearms and 30 round magazines"
    } ]
  }, {
    "tStartMs": 758090,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "exploded in value."
    } ]
  }, {
    "tStartMs": 759592,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "Yet this legislation ultimately backfired.\nAfter the ban was lifted in 2004,"
    } ]
  }, {
    "tStartMs": 764680,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Americans channeled their \npent-up demand into mass"
    } ]
  }, {
    "tStartMs": 767433,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "AR-15 adoption."
    } ]
  }, {
    "tStartMs": 769185,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "It also conditioned gun manufacturers"
    } ]
  }, {
    "tStartMs": 771103,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "and gun owners to associate politics"
    } ]
  }, {
    "tStartMs": 773272,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "with scarcity, where any hint of gun control"
    } ]
  }, {
    "tStartMs": 775858,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "triggers panic buying and stockpiling."
    } ]
  }, {
    "tStartMs": 778527,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "The fourth paradigm shift"
    } ]
  }, {
    "tStartMs": 779779,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "was in 2012, with the Sandy Hook \nshooting, which involved"
    } ]
  }, {
    "tStartMs": 782740,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "an AR-15."
    } ]
  }, {
    "tStartMs": 783866,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "The tragedy"
    } ]
  }, {
    "tStartMs": 784575,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "sparked the strongest legislative\npush for gun control"
    } ]
  }, {
    "tStartMs": 787369,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "since the 1994 ban."
    } ]
  }, {
    "tStartMs": 789288,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "But within the industry, it set off"
    } ]
  }, {
    "tStartMs": 790915,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "mass panic buying and an unprecedented\nrush to gun ownership."
    } ]
  }, {
    "tStartMs": 794794,
    "dDurationMs": 4838,
    "segs": [ {
      "utf8": "Demand soared and prices skyrocketed\novernight for every firearm, with AR-15s"
    } ]
  }, {
    "tStartMs": 799757,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "seeing the greatest appreciation."
    } ]
  }, {
    "tStartMs": 802051,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "It was right before"
    } ]
  }, {
    "tStartMs": 802843,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "this moment when Mister Guns launched."
    } ]
  }, {
    "tStartMs": 805012,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Ro grew up around firearms"
    } ]
  }, {
    "tStartMs": 806722,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "in Louisiana, worked a day job in"
    } ]
  }, {
    "tStartMs": 808516,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "electronics, and sold guns out of his"
    } ]
  }, {
    "tStartMs": 810559,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "House part-time to make ends meet."
    } ]
  }, {
    "tStartMs": 812728,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "His online business exploded after Sandy\nhook, as Americans bought his AR-15s"
    } ]
  }, {
    "tStartMs": 816982,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "by the truckload, bidding three times\ntheir usual price"
    } ]
  }, {
    "tStartMs": 819944,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "at auction."
    } ]
  }, {
    "tStartMs": 821237,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "By 2013, his house was so full\nof inventory that he opened a storefront."
    } ]
  }, {
    "tStartMs": 825491,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "13 years later, Mister"
    } ]
  }, {
    "tStartMs": 826951,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Guns is Dallas's leading gun store with four"
    } ]
  }, {
    "tStartMs": 829453,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "locations and is one of the largest\nonline dealers in the nation."
    } ]
  }, {
    "tStartMs": 833415,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "Even as he's scaled,"
    } ]
  }, {
    "tStartMs": 834542,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Ro has never lost sight of the core value\nprop for a successful"
    } ]
  }, {
    "tStartMs": 838379,
    "dDurationMs": 625,
    "segs": [ {
      "utf8": "gun store."
    } ]
  }, {
    "tStartMs": 885134,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Firearms fall into three basic categories."
    } ]
  }, {
    "tStartMs": 887136,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "Handguns, rifles, and shotguns."
    } ]
  }, {
    "tStartMs": 890556,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "Americans tend to buy"
    } ]
  }, {
    "tStartMs": 891640,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "handguns first, followed by rifles,"
    } ]
  }, {
    "tStartMs": 893726,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "then shotguns."
    } ]
  }, {
    "tStartMs": 894768,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "Handguns are cheaper, easier\nto store, lighter to carry,"
    } ]
  }, {
    "tStartMs": 898147,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "and most often used for \nself-defense, which is the"
    } ]
  }, {
    "tStartMs": 900691,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "primary self-cited driver of gun ownership."
    } ]
  }, {
    "tStartMs": 903444,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "When you start shopping,\nthe options are overwhelming."
    } ]
  }, {
    "tStartMs": 906363,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "When we look at the biggest brands,\nSIG Sauer lists 25"
    } ]
  }, {
    "tStartMs": 909241,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "models across 12 series,"
    } ]
  }, {
    "tStartMs": 910910,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "Glock - 21 models across"
    } ]
  }, {
    "tStartMs": 912786,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "7 series, Smith \u0026 Wesson -\n29 models across 17"
    } ]
  }, {
    "tStartMs": 916665,
    "dDurationMs": 2378,
    "segs": [ {
      "utf8": "series, Ruger - 29 models across"
    } ]
  }, {
    "tStartMs": 919043,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "16 series, and Taurus - 20"
    } ]
  }, {
    "tStartMs": 921211,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "models across 11 series."
    } ]
  }, {
    "tStartMs": 923380,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "If we pivot"
    } ]
  }, {
    "tStartMs": 923964,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "to revolvers, the choices are just as broad."
    } ]
  }, {
    "tStartMs": 926634,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "Smith \u0026 Wesson sells"
    } ]
  }, {
    "tStartMs": 927885,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "46 different revolvers across 9 series."
    } ]
  }, {
    "tStartMs": 930804,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "Ruger sells 30 across"
    } ]
  }, {
    "tStartMs": 932222,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "13, and Taurus -"
    } ]
  }, {
    "tStartMs": 933599,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "25 across 6 series."
    } ]
  }, {
    "tStartMs": 935976,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Navigating this landscape of brands and"
    } ]
  }, {
    "tStartMs": 938145,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "models is where the gun stores\nprove their value."
    } ]
  }, {
    "tStartMs": 940814,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "They help buyers\nnarrow down their choices"
    } ]
  }, {
    "tStartMs": 942858,
    "dDurationMs": 5506,
    "segs": [ {
      "utf8": "based on budget, use-case, ergonomics,\ngoals, and shooting experience."
    } ]
  }, {
    "tStartMs": 948530,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "In some ways, the gun store is \nlike a mattress store."
    } ]
  }, {
    "tStartMs": 951325,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "You get to try before you buy"
    } ]
  }, {
    "tStartMs": 953077,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "and you rely on the staff\nto help narrow the field."
    } ]
  }, {
    "tStartMs": 1032156,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "Because the American civilian \nmarket is so lucrative,"
    } ]
  }, {
    "tStartMs": 1034992,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "gunmakers pursue nearly \nevery price point."
    } ]
  }, {
    "tStartMs": 1037828,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "Brazil's Taurus grosses hundreds\nof millions of dollars every year,"
    } ]
  }, {
    "tStartMs": 1041290,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "selling budget revolvers"
    } ]
  }, {
    "tStartMs": 1042750,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "and handguns at the sub-$500 mark."
    } ]
  }, {
    "tStartMs": 1045544,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "These guns are cheap and"
    } ]
  }, {
    "tStartMs": 1046754,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "have zero chance of"
    } ]
  }, {
    "tStartMs": 1047880,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "appreciation."
    } ]
  }, {
    "tStartMs": 1049048,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "In the middle are Glock and SIG, who sell\nthe most ubiquitous handguns today."
    } ]
  }, {
    "tStartMs": 1053010,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "Both manufacturers"
    } ]
  }, {
    "tStartMs": 1054136,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "optimize for volume over margins,\nwith base prices that have persisted"
    } ]
  }, {
    "tStartMs": 1058057,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "at the $500 price point for decades."
    } ]
  }, {
    "tStartMs": 1060934,
    "dDurationMs": 668,
    "segs": [ {
      "utf8": "Like a Honda"
    } ]
  }, {
    "tStartMs": 1061602,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Accord or Toyota Prius,\ntheir widespread availability,"
    } ]
  }, {
    "tStartMs": 1064897,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "abundant supply, and mass demand\nmean no appreciation."
    } ]
  }, {
    "tStartMs": 1068734,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "But in retail, perception drives \ndemand, which in"
    } ]
  }, {
    "tStartMs": 1071487,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "turn drives prices."
    } ]
  }, {
    "tStartMs": 1073113,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "Gunmakers with models ingrained in \npop culture generally enjoy"
    } ]
  }, {
    "tStartMs": 1076492,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "greater pricing power, as customers\nare willing to pay more for the"
    } ]
  }, {
    "tStartMs": 1079787,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "prestige and cool factor."
    } ]
  }, {
    "tStartMs": 1081705,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "While guns can't be advertised online\nor on TV, gunmakers"
    } ]
  }, {
    "tStartMs": 1085292,
    "dDurationMs": 375,
    "segs": [ {
      "utf8": "have still"
    } ]
  }, {
    "tStartMs": 1085667,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "found ways to engage\nin indirect mass marketing through"
    } ]
  }, {
    "tStartMs": 1088629,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "placement in movies, video games, shows, and"
    } ]
  }, {
    "tStartMs": 1091632,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "now progressively"
    } ]
  }, {
    "tStartMs": 1092508,
    "dDurationMs": 4713,
    "segs": [ {
      "utf8": "through YouTube gun influencers who walk\nthe line between education and promotion."
    } ]
  }, {
    "tStartMs": 1097513,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "This analysis focuses on estimated"
    } ]
  }, {
    "tStartMs": 1099681,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "average retail prices per year for standard base"
    } ]
  }, {
    "tStartMs": 1102643,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "models, unless noted otherwise."
    } ]
  }, {
    "tStartMs": 1105062,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "Even our own numbers are anchor\nestimates derived from the limited data"
    } ]
  }, {
    "tStartMs": 1109149,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "that is available."
    } ]
  }, {
    "tStartMs": 1110317,
    "dDurationMs": 417,
    "segs": [ {
      "utf8": "Smith \u0026 Wesson"
    } ]
  }, {
    "tStartMs": 1110734,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "revolvers were standard issue for"
    } ]
  }, {
    "tStartMs": 1112778,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "American police in the"
    } ]
  }, {
    "tStartMs": 1113904,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "last century, and"
    } ]
  }, {
    "tStartMs": 1114905,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "made famous by the"
    } ]
  }, {
    "tStartMs": 1115864,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "film Dirty Harry"
    } ]
  }, {
    "tStartMs": 1117032,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "and old-school Hong Kong cinema."
    } ]
  }, {
    "tStartMs": 1118992,
    "dDurationMs": 835,
    "segs": [ {
      "utf8": "This real world"
    } ]
  }, {
    "tStartMs": 1119827,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "prestige has enabled the brand continuous"
    } ]
  }, {
    "tStartMs": 1122204,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "pricing power for its"
    } ]
  }, {
    "tStartMs": 1123372,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "flagship models in the upper middle \nsegment of the market."
    } ]
  }, {
    "tStartMs": 1126625,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "The Colt Python"
    } ]
  }, {
    "tStartMs": 1127709,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "commands high prices, immortalized over \ngenerations"
    } ]
  }, {
    "tStartMs": 1131171,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "through movies, video games,\nand iconic shows like The Walking Dead."
    } ]
  }, {
    "tStartMs": 1135134,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "Yet The Python is a prime example"
    } ]
  }, {
    "tStartMs": 1137052,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "of how market values can diverge"
    } ]
  }, {
    "tStartMs": 1138762,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "sharply by model, where"
    } ]
  }, {
    "tStartMs": 1140097,
    "dDurationMs": 3670,
    "segs": [ {
