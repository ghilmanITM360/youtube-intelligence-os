    "segs": [ {
      "utf8": "There's no sense in stocking $5,000\nNighthawks in a working class"
    } ]
  }, {
    "tStartMs": 1486651,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "neighborhood, or exclusively\ncarrying Glocks or Taurus in"
    } ]
  }, {
    "tStartMs": 1490071,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "an affluent neighborhood."
    } ]
  }, {
    "tStartMs": 1491531,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Mister Guns, in design and inventory,"
    } ]
  }, {
    "tStartMs": 1493992,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "is a reflection of what \npeople in Dallas want."
    } ]
  }, {
    "tStartMs": 1627876,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "The guns"
    } ]
  }, {
    "tStartMs": 1628460,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "and brands that interest one individual\nhave a lot to do with the"
    } ]
  }, {
    "tStartMs": 1631504,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "generation they were born\nin, the part of the country they"
    } ]
  }, {
    "tStartMs": 1634090,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "live in, and or the video games and movies\nthey enjoyed most."
    } ]
  }, {
    "tStartMs": 1638553,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Maybe you grew up playing Counter-Strike or \nRainbow Six, so you have a soft"
    } ]
  }, {
    "tStartMs": 1641556,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "spot for AK-47s,"
    } ]
  }, {
    "tStartMs": 1643350,
    "dDurationMs": 4170,
    "segs": [ {
      "utf8": "Desert Eagles, USPs, MP5s, and SPAS-12s."
    } ]
  }, {
    "tStartMs": 1647771,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "Maybe you're a military history\nbuff and you"
    } ]
  }, {
    "tStartMs": 1649856,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "place greater value on manufacturers\nwho have battle-tested"
    } ]
  }, {
    "tStartMs": 1652984,
    "dDurationMs": 5798,
    "segs": [ {
      "utf8": "models like HK, Colt or FN over\nthose who build solely for civilian use."
    } ]
  }, {
    "tStartMs": 1659240,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "Maybe you grew up hunting,"
    } ]
  }, {
    "tStartMs": 1660533,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "so your tastes lean more towards\npractical"
    } ]
  }, {
    "tStartMs": 1662452,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "shotguns, bolt-action rifles,"
    } ]
  }, {
    "tStartMs": 1664454,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "and sporting rifles."
    } ]
  }, {
    "tStartMs": 1665914,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Or maybe you just don't care\nabout any of these things"
    } ]
  }, {
    "tStartMs": 1668083,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "and just want a one-and-done\nthat's reliable and cost efficient"
    } ]
  }, {
    "tStartMs": 1671461,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "with so many different entry points\nand possibilities."
    } ]
  }, {
    "tStartMs": 1674255,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "The industry abstracts\ncustomers into three types."
    } ]
  }, {
    "tStartMs": 1677425,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "The first are Tactical"
    } ]
  }, {
    "tStartMs": 1678635,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "Timmies, whose tastes are driven\nby law enforcement"
    } ]
  }, {
    "tStartMs": 1681179,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "and the modern military."
    } ]
  }, {
    "tStartMs": 1682639,
    "dDurationMs": 459,
    "segs": [ {
      "utf8": "This is the"
    } ]
  }, {
    "tStartMs": 1683098,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "younger generation in their 20s\nto 30s, raised on Call of Duty,"
    } ]
  }, {
    "tStartMs": 1686226,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "Battlefield, Black Hawk Down, \nSicario, and other"
    } ]
  }, {
    "tStartMs": 1690230,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "titles that popularized\nthe tactical special forces operator."
    } ]
  }, {
    "tStartMs": 1693817,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "They chase after"
    } ]
  }, {
    "tStartMs": 1694609,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "the same rifles and handguns\nused by Navy SEALs,"
    } ]
  }, {
    "tStartMs": 1697320,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "deck out their collection"
    } ]
  }, {
    "tStartMs": 1698405,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "with all the optics,"
    } ]
  }, {
    "tStartMs": 1699447,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "lasers, suppressors, and wear ballistic"
    } ]
  }, {
    "tStartMs": 1701700,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "helmets, plate carriers, and night vision."
    } ]
  }, {
    "tStartMs": 1704202,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "The second is Elmer Fudds."
    } ]
  }, {
    "tStartMs": 1706204,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "They're an older, traditional generation\nwho believe guns"
    } ]
  }, {
    "tStartMs": 1708873,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "are for hunting and have little interest \nin Glocks, SIGs,"
    } ]
  }, {
    "tStartMs": 1712627,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "AR-15s, and modern firearms."
    } ]
  }, {
    "tStartMs": 1715088,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "They favor old school bolt-action."
    } ]
  }, {
    "tStartMs": 1716798,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "rifles, revolvers, and shotguns."
    } ]
  }, {
    "tStartMs": 1719050,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "While the Fudds may not have as strong of"
    } ]
  }, {
    "tStartMs": 1720844,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "an online presence as the Timmies, they're still big."
    } ]
  }, {
    "tStartMs": 1723346,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "There are many old-world"
    } ]
  }, {
    "tStartMs": 1724472,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "manufacturers who have thrived exclusively"
    } ]
  }, {
    "tStartMs": 1726891,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "catering to this market,"
    } ]
  }, {
    "tStartMs": 1728184,
    "dDurationMs": 3963,
    "segs": [ {
      "utf8": "like the $100,000 H\u0026H Royal Double \nRifle that's engraved by"
    } ]
  }, {
    "tStartMs": 1732147,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "hand, produced in dozens per year, and"
    } ]
  }, {
    "tStartMs": 1734399,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "boast waiting lists"
    } ]
  }, {
    "tStartMs": 1735358,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "that stretch up to 3 years."
    } ]
  }, {
    "tStartMs": 1737068,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "The last group are the boomers."
    } ]
  }, {
    "tStartMs": 1739070,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Shaped by World War 2 lore and Westerns,"
    } ]
  }, {
    "tStartMs": 1741531,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "their tastes lean more towards 1911s,"
    } ]
  }, {
    "tStartMs": 1743324,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "M1 Garands,"
    } ]
  }, {
    "tStartMs": 1745201,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "lever-action rifles, and revolvers."
    } ]
  }, {
    "tStartMs": 1747537,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "And they have less enthusiasm for"
    } ]
  }, {
    "tStartMs": 1749247,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "modern plastic-based firearms."
    } ]
  }, {
    "tStartMs": 1751416,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "Understanding these archetypes and how"
    } ]
  }, {
    "tStartMs": 1753334,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "they desire certain models or trims"
    } ]
  }, {
    "tStartMs": 1755295,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "helps us understand\ndemand in the abstract."
    } ]
  }, {
    "tStartMs": 1757881,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "Ro has come a long way from the days\nwhere he handled every deal"
    } ]
  }, {
    "tStartMs": 1760925,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "and spoke to every customer."
    } ]
  }, {
    "tStartMs": 1762469,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "His breakthrough"
    } ]
  }, {
    "tStartMs": 1763178,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "came from building a strong team.\nBy surrounding himself with talent,"
    } ]
  }, {
    "tStartMs": 1766389,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "he's freed himself to focus on \nstrategy and scale."
    } ]
  }, {
    "tStartMs": 1769142,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "But finding great people isn't easy."
    } ]
  }, {
    "tStartMs": 1771227,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "That's why ZipRecruiter, the sponsor of\ntoday's episode, makes such a difference."
    } ]
  }, {
    "tStartMs": 1775398,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Hiring is the most important decision\nany leader makes,"
    } ]
  }, {
    "tStartMs": 1778610,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "but finding a qualified candidate\nis like finding a needle in a haystack."
    } ]
  }, {
    "tStartMs": 1782030,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "You'll get hundreds of resumes,\nbut most will lack the relevant skills"
    } ]
  }, {
    "tStartMs": 1785283,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "or experience."
    } ]
  }, {
    "tStartMs": 1786284,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "At Modern MBA, we've learned this the hard way."
    } ]
  }, {
    "tStartMs": 1788620,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Hiring has been painful, taken months,\nnot weeks,"
    } ]
  }, {
    "tStartMs": 1791414,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "and we've historically settled\nfor the best of the worst."
    } ]
  }, {
    "tStartMs": 1793958,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "Every wrong hire has burned invaluable\ncash, time, and momentum,"
    } ]
  }, {
    "tStartMs": 1797712,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "but no longer with ZipRecruiter."
    } ]
  }, {
    "tStartMs": 1799464,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "ZipRecruiter finds amazing candidates"
    } ]
  }, {
    "tStartMs": 1801257,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "fast, and right now you can try it for free\nat ziprecruiter.com/MBA."
    } ]
  }, {
    "tStartMs": 1805303,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "ZipRecruiter's powerful"
    } ]
  }, {
    "tStartMs": 1807722,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "matching algorithms identify"
    } ]
  }, {
    "tStartMs": 1809224,
    "dDurationMs": 3169,
    "segs": [ {
      "utf8": "the top talent for your role \nimmediately after you post."
    } ]
  }, {
    "tStartMs": 1812393,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "It's no longer all on your shoulders."
    } ]
  }, {
    "tStartMs": 1814187,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "ZipRecruiter puts you in\nthe driver's seat for results."
    } ]
  }, {
    "tStartMs": 1816731,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "You can connect with top candidates"
    } ]
  }, {
    "tStartMs": 1818316,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "instantly and recruit your favorites\nby adding a personal touch."
    } ]
  }, {
    "tStartMs": 1821778,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "With these game-changing features,"
    } ]
  }, {
    "tStartMs": 1823488,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "hiring is no longer\na random roll of the dice."
    } ]
  }, {
    "tStartMs": 1826658,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "You wouldn't leave the fate of your business to chance,\nso why do the same with hiring?"
    } ]
  }, {
    "tStartMs": 1830453,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "Ditch the other hiring sites and let\nZipRecruiter find what you're looking for -"
    } ]
  }, {
    "tStartMs": 1834249,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "the needle in the haystack."
    } ]
  }, {
    "tStartMs": 1835625,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "4 out of 5 employers\nwho post on ZipRecruiter"
    } ]
  }, {
    "tStartMs": 1838253,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "get a quality candidate\nwithin the first day."
    } ]
  }, {
    "tStartMs": 1840421,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Try it for free at this exclusive web\naddress:"
    } ]
  }, {
    "tStartMs": 1843091,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "ziprecruiter.com/mba."
    } ]
  }, {
    "tStartMs": 1845718,
    "dDurationMs": 1252,
    "segs": [ {
      "utf8": "Again, that's ZipRecruiter.com/MBA."
    } ]
  }, {
    "tStartMs": 1846970,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "ZipRecruiter."
    } ]
  }, {
    "tStartMs": 1849806,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "The smartest way to hire."
    } ]
  }, {
    "tStartMs": 1851558,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "The more practical but harder question to answer for"
    } ]
  }, {
    "tStartMs": 1854143,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "dealers is which guns to stock?"
    } ]
  }, {
    "tStartMs": 1856437,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "With tens of thousands of options"
    } ]
  }, {
    "tStartMs": 1858064,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "Across every category,"
    } ]
  }, {
    "tStartMs": 1859482,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "mo one has the budget or space to carry\na little bit of everything."
    } ]
  }, {
    "tStartMs": 1863361,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "Manufacturers only care about moving their products."
    } ]
  }, {
    "tStartMs": 1866197,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "They lean into pop culture, competition"
    } ]
  }, {
    "tStartMs": 1868366,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "pedigree or military"
    } ]
  }, {
    "tStartMs": 1869826,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "adoption whenever possible, just to stand"
    } ]
  }, {
    "tStartMs": 1872161,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "out to retail customers."
    } ]
  }, {
    "tStartMs": 1873830,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "But gun stores carry all the risk."
    } ]
  }, {
    "tStartMs": 1876082,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "Their success and ultimately survival\nrelies not just on sharing knowledge with"
    } ]
  }, {
    "tStartMs": 1880211,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "customers, but on choosing the right"
    } ]
  }, {
    "tStartMs": 1882088,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "inventory and moving all"
    } ]
  }, {
    "tStartMs": 1883673,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "of it across multiple brands and models."
    } ]
  }, {
    "tStartMs": 2062852,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "With historical data, it's easy\nto look back and rationalize"
    } ]
  }, {
    "tStartMs": 2066230,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "why certain model rose or fell in value."
    } ]
  }, {
    "tStartMs": 2068775,
    "dDurationMs": 625,
    "segs": [ {
      "utf8": "But owners"
    } ]
  }, {
    "tStartMs": 2069400,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "Like Ro are in the business of"
    } ]
  }, {
    "tStartMs": 2070818,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "skating to where the puck is going."
    } ]
  }, {
    "tStartMs": 2072695,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "In retail, cash flow is king."
    } ]
  }, {
    "tStartMs": 2074781,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Appreciation is never guaranteed."
    } ]
  }, {
    "tStartMs": 2077283,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "While manufacturers\nmay watch the secondary market,"
    } ]
  }, {
    "tStartMs": 2079869,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "their main priority\nis in the primary market"
    } ]
  }, {
    "tStartMs": 2082288,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "with bulk sales"
    } ]
  }, {
    "tStartMs": 2083247,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "to governments, distributors, and gun"
    } ]
  }, {
    "tStartMs": 2085291,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "stores. Like Nike with"
    } ]
  }, {
    "tStartMs": 2087001,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "sneakers or automakers with dealerships,"
    } ]
  }, {
    "tStartMs": 2089587,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "gunmakers aren't interested in secondary"
    } ]
  }, {
    "tStartMs": 2091964,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "appreciation as they don't benefit from it."
    } ]
  }, {
    "tStartMs": 2094258,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Their priority is"
    } ]
  }, {
    "tStartMs": 2095259,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "wholesale volume at the highest"
    } ]
  }, {
    "tStartMs": 2096761,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "markups, while providing guidance\non retail prices with"
    } ]
  }, {
    "tStartMs": 2099931,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "MSRP and MAPP, which gun"
    } ]
  }, {
    "tStartMs": 2101766,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "stores can choose to follow or not\nbased on real demand."
    } ]
  }, {
    "tStartMs": 2105311,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "In this way, the gun industry's low information"
    } ]
  }, {
    "tStartMs": 2107730,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "environment affects sellers like Mister"
    } ]
  }, {
    "tStartMs": 2109857,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Guns just as much as buyers, and Ro"
    } ]
  }, {
    "tStartMs": 2112568,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "reads every possible signal to predict demand."
    } ]
  }, {
    "tStartMs": 2149230,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "The rationale and timing behind a gunmaker's \ndecision to discontinue,"
    } ]
  }, {
    "tStartMs": 2152316,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "refresh, ramp up, or upgrade\na model is never public."
    } ]
  }, {
    "tStartMs": 2156154,
    "dDurationMs": 4504,
    "segs": [ {
      "utf8": "Yet upstream supply changes dramatically\naffect downstream demand and market value."
    } ]
  }, {
    "tStartMs": 2161200,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "Stores and dealers rely"
    } ]
  }, {
    "tStartMs": 2162451,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "on intuition, relationships, and past"
    } ]
  }, {
    "tStartMs": 2165955,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "experience to decide what and how much to stock."
    } ]
  }, {
    "tStartMs": 2168416,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Any gun that sits for months\nmust usually be discounted,"
    } ]
  }, {
    "tStartMs": 2171377,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "unless the owner is willing to wait it"
    } ]
  }, {
    "tStartMs": 2173087,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "out for the right buyer to \nmagically walk through the door."
    } ]
  }, {
    "tStartMs": 2176048,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "Titanium Gold Desert Eagles\nor Bob Hawks might look like safe pets"
    } ]
  }, {
    "tStartMs": 2179719,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "as models with limited supply,\nloyal followings, and a"
    } ]
  }, {
    "tStartMs": 2182972,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "history of proven appreciation."
    } ]
  }, {
    "tStartMs": 2185558,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "But if Magnum or Nighthawk suddenly \nramps up production or introduces"
    } ]
  }, {
    "tStartMs": 2189228,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "an even flashier, rarer model,"
    } ]
  }, {
    "tStartMs": 2191063,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "demand will fall along\nwith the tens of thousands of dollars"
    } ]
  }, {
    "tStartMs": 2194066,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "sunk into this inventory."
    } ]
  }, {
    "tStartMs": 2195735,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "Guns are ultimately zero-sum."
    } ]
  }, {
    "tStartMs": 2197361,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "Some customers rarely"
    } ]
  }, {
    "tStartMs": 2198905,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "stockpile identical models."
    } ]
  }, {
    "tStartMs": 2200823,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "If a customer comes in for"
    } ]
  }, {
    "tStartMs": 2202158,
    "dDurationMs": 3211,
    "segs": [ {
      "utf8": "a Colt Python and you don't have one,\nthat seal is gone and"
    } ]
  }, {
    "tStartMs": 2205369,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "probably that customer."
    } ]
  }, {
    "tStartMs": 2206746,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "For Ro, customer service\nisn't just lip service"
    } ]
  }, {
    "tStartMs": 2210249,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "and something that applies\nonly to new models."
    } ]
  }, {
    "tStartMs": 2212919,
    "dDurationMs": 2585,
    "segs": [ {
      "utf8": "Mister Guns offers\nthe highest payouts for used"
    } ]
  }, {
    "tStartMs": 2215504,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "guns in all of Dallas. Upfront quotes\nand transparent, consistent pricing"
    } ]
  }, {
    "tStartMs": 2219926,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "is something that most other gun\nshops in town don't offer."
    } ]
  }, {
    "tStartMs": 2223304,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "But the industry's opacity\nand high liability has"
    } ]
  }, {
    "tStartMs": 2226098,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "fostered a culture where relationships\nmatter more than transactions."
    } ]
  }, {
    "tStartMs": 2229977,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Reputation opens doors. With criminals,"
    } ]
  }, {
    "tStartMs": 2232730,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "eager to buy in bulk and intense"
    } ]
  }, {
    "tStartMs": 2234565,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "regulatory scrutiny,"
    } ]
  }, {
    "tStartMs": 2235983,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "the industry collectively prioritizes"
    } ]
  }, {
    "tStartMs": 2238110,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "social capital"
    } ]
  }, {
    "tStartMs": 2239028,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "and personal endorsements over \nhard cash or rapid"
    } ]
  }, {
    "tStartMs": 2242114,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "expansion. Gun store"
    } ]
  }, {
    "tStartMs": 2243616,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "owners must provide references, sales\nreports, and compliance records"
    } ]
  }, {
    "tStartMs": 2247703,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to get wholesale inventory."
    } ]
  }, {
    "tStartMs": 2249413,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Beyond that, endorsements from \nrespected peers"
    } ]
  }, {
    "tStartMs": 2252124,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "unlock exclusive allocations\nand privileged information that"
    } ]
  }, {
    "tStartMs": 2255670,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "would otherwise remain off-limits."
    } ]
  }, {
    "tStartMs": 2336083,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "Despite a strong retail footprint, Mister"
    } ]
  }, {
    "tStartMs": 2338169,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Guns ranks among the top 100 U.S."
    } ]
  }, {
    "tStartMs": 2340546,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "dealers by online volume."
    } ]
  }, {
    "tStartMs": 2342381,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "30% of Ro's business comes"
    } ]
  }, {
    "tStartMs": 2344091,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "from used guns sourced"
    } ]
  }, {
    "tStartMs": 2345801,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "from walk-ins looking for quick cash."
    } ]
  }, {
    "tStartMs": 2348054,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "This steady pipeline of inventory is inspected,"
    } ]
  }, {
    "tStartMs": 2350848,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "photographed, priced, and shipped at all\nhours, which keeps staff productive"
    } ]
  }, {
    "tStartMs": 2355061,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "even when foot traffic slows."
    } ]
  }, {
    "tStartMs": 2357104,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "Mister Guns grosses $80,000"
    } ]
  }, {
    "tStartMs": 2359106,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "on average a month for each of its"
    } ]
  }, {
    "tStartMs": 2360900,
    "dDurationMs": 4629,
    "segs": [ {
      "utf8": "two retail locations and $150,000\na month for each of its two gun"
    } ]
  }, {
    "tStartMs": 2365529,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "range stores for combined"
    } ]
  }, {
    "tStartMs": 2368908,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "annual run rate of $7.4M a year."
    } ]
  }, {
    "tStartMs": 2371077,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "The used gun business\nis as much about efficiency as profit."
    } ]
  }, {
    "tStartMs": 2374622,
    "dDurationMs": 4421,
    "segs": [ {
      "utf8": "Like sneakers, used guns deliver stronger\nmargins and operate in their own market."
    } ]
  }, {
    "tStartMs": 2379043,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Insulated from the irrational\nunpredictable swings,"
    } ]
  }, {
    "tStartMs": 2381545,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "in supply and demand that plague new models,"
    } ]
  }, {
    "tStartMs": 2384548,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "used guns are low floor, high"
    } ]
  }, {
    "tStartMs": 2386258,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "ceiling, while used guns are high floor,"
    } ]
  }, {
    "tStartMs": 2388511,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "no ceiling."
    } ]
  }, {
    "tStartMs": 2389470,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "They don't appreciate"
    } ]
  }, {
    "tStartMs": 2390513,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "but their values are far more stable."
    } ]
  }, {
    "tStartMs": 2392598,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Ro's operating margin sits at 8%"
    } ]
  }, {
    "tStartMs": 2394975,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "and he believes he can get."
    } ]
  }, {
    "tStartMs": 2396310,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "to 10% through better"
    } ]
  }, {
    "tStartMs": 2397686,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "product mix and new services."
    } ]
  }, {
    "tStartMs": 2401899,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "If Mister Guns is built on scale,"
    } ]
  }, {
    "tStartMs": 2403317,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "Zero Whiskey Tactical Arms"
