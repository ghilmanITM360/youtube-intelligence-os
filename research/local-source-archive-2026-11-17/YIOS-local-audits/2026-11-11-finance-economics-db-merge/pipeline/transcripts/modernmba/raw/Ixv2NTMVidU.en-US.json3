{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 6131,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "Thin, crispy, and seared to order with minimal toppings"
    } ]
  }, {
    "tStartMs": 9050,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "smashburgers are more than just a food trend."
    } ]
  }, {
    "tStartMs": 11678,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "They're a blueprint for the future of fast\nfood."
    } ]
  }, {
    "tStartMs": 14264,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Built on low overhead\nand small menus, these independent"
    } ]
  }, {
    "tStartMs": 17267,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "spots are outperforming the burger\nchains on speed, consistency, and value."
    } ]
  }, {
    "tStartMs": 21229,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "Even though consumers are eating out\nless and these fast food"
    } ]
  }, {
    "tStartMs": 24315,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "giants are stumbling,"
    } ]
  }, {
    "tStartMs": 25316,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "it's these tiny smashburger concepts\nthat are thriving."
    } ]
  }, {
    "tStartMs": 28319,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "For only a few extra dollars,"
    } ]
  }, {
    "tStartMs": 29821,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "more Americans are ditching Big Macs"
    } ]
  }, {
    "tStartMs": 31614,
    "dDurationMs": 3421,
    "segs": [ {
      "utf8": "and Whoppers in favor of these fresher,\nsmashed local alternatives."
    } ]
  }, {
    "tStartMs": 35118,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "Customer retention at McDonald's,"
    } ]
  }, {
    "tStartMs": 37328,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "Burger King, and Wendy's have plummeted,\nand their executives are panicking."
    } ]
  }, {
    "tStartMs": 41332,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "The only tactic they had was launching\nlimited-time"
    } ]
  }, {
    "tStartMs": 43668,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "gimmicks,\nbut even that has lost its effectiveness."
    } ]
  }, {
    "tStartMs": 46713,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "The burger giants don't"
    } ]
  }, {
    "tStartMs": 47672,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "have the means to make smashburgers\nunless they change their business models."
    } ]
  }, {
    "tStartMs": 51551,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "Smashburgers are not a new invention."
    } ]
  }, {
    "tStartMs": 53470,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "Shake Shack, Five Guys, and Culver's have\nbuilt their empires on it since the 2000s."
    } ]
  }, {
    "tStartMs": 58141,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Los Angeles has been the birthplace\nfor food trends of the last decade,"
    } ]
  }, {
    "tStartMs": 61561,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "like frozen yogurt,\nbubble tea, and hot chicken."
    } ]
  }, {
    "tStartMs": 64230,
    "dDurationMs": 4255,
    "segs": [ {
      "utf8": "It was here in 2018 when smashburgers\ngained popularity as a fresher, tastier,"
    } ]
  }, {
    "tStartMs": 68485,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "variation sold exclusively by a few\nindividuals out of their driveways."
    } ]
  }, {
    "tStartMs": 72947,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "The business gained legitimacy\nas the first movers grew their viral pop"
    } ]
  }, {
    "tStartMs": 76493,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "ups into lean, multi-million"
    } ]
  }, {
    "tStartMs": 78036,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "dollar, brick and mortar concepts\nover the past seven years."
    } ]
  }, {
    "tStartMs": 81331,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "It's only in LA where the smashburger\nmarket is most mature,"
    } ]
  }, {
    "tStartMs": 84501,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "quality is highest,\nand competition is fiercest."
    } ]
  }, {
    "tStartMs": 87295,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "With low barriers to entry, owners\nrush into neighborhoods to stake market"
    } ]
  }, {
    "tStartMs": 91216,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "share. In this Modern MBA"
    } ]
  }, {
    "tStartMs": 93093,
    "dDurationMs": 500,
    "segs": [ {
      "utf8": "Original,"
    } ]
  }, {
    "tStartMs": 93593,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "we're going boots on the ground\nto understand what it takes to win"
    } ]
  }, {
    "tStartMs": 96596,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "from the small first-time restaurateur"
    } ]
  }, {
    "tStartMs": 98431,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "to the market leader who's built\nthe city's largest independent chain,"
    } ]
  }, {
    "tStartMs": 101559,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "growing to 11 stores in 5 years,\none patty at a time. All right."
    } ]
  }, {
    "tStartMs": 105438,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "Alright, a PS Burger, extra patty, in the window."
    } ]
  }, {
    "tStartMs": 115365,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "What does the future hold in business?"
    } ]
  }, {
    "tStartMs": 116991,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "As nine experts\nand you'll get ten answers."
    } ]
  }, {
    "tStartMs": 119285,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Tune in to any news program\nand you'll see talking heads every day"
    } ]
  }, {
    "tStartMs": 122205,
    "dDurationMs": 2210,
    "segs": [ {
      "utf8": "proclaiming that a recession is just months away,"
    } ]
  }, {
    "tStartMs": 124415,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "that tariffs will be eventually repealed,\nand that now is a good time"
    } ]
  }, {
    "tStartMs": 127585,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "to buy the dip in American stocks."
    } ]
  }, {
    "tStartMs": 129295,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "Could someone please\ninvent a crystal ball?"
    } ]
  }, {
    "tStartMs": 131381,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Until then, over 41,000 businesses\nhave future proofed their business"
    } ]
  }, {
    "tStartMs": 135051,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "with NetSuite by Oracle."
    } ]
  }, {
    "tStartMs": 136386,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "The number one cloud ERP\nbring accounting, finance, inventory"
    } ]
  }, {
    "tStartMs": 140223,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "and HR into one fluid platform with one\nunified business management suite."
    } ]
  }, {
    "tStartMs": 144519,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "There's one source of truth\ngiving you the visibility"
    } ]
  }, {
    "tStartMs": 146771,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "and control\nyou need to make quick decisions."
    } ]
  }, {
    "tStartMs": 148898,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "With real-time insights and forecasting,\nyou're peering into the future"
    } ]
  }, {
    "tStartMs": 152110,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "with actionable data."
    } ]
  }, {
    "tStartMs": 153278,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "When you're closing the books in days,\nnot weeks, you're spending less time"
    } ]
  }, {
    "tStartMs": 156281,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "looking backwards\nand more time on what's next."
    } ]
  }, {
    "tStartMs": 158783,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "Modern MBA is small at the moment,"
    } ]
  }, {
    "tStartMs": 160535,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "but as soon as we scale,\nwe will need and use NetSuite."
    } ]
  }, {
    "tStartMs": 163329,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "Today, we're stitching things manually"
    } ]
  }, {
    "tStartMs": 164914,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "and it's gotten harder\nto assess our business health."
    } ]
  }, {
    "tStartMs": 167125,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "We need to track production costs to run\npayroll compliant with multiple states,"
    } ]
  }, {
    "tStartMs": 170920,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "and to evaluate profit\nand loss by team and project."
    } ]
  }, {
    "tStartMs": 173756,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "As a corporation,\nwe pay tax throughout the year"
    } ]
  }, {
    "tStartMs": 175967,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "and it's a nightmare jumping from system\nto system just to get one answer."
    } ]
  }, {
    "tStartMs": 179470,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "These are capabilities\nthat only NetSuite provides,"
    } ]
  }, {
    "tStartMs": 181806,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "and it's a platform\nthat we intend to take every advantage of."
    } ]
  }, {
    "tStartMs": 184767,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Whether your company is earning millions\nor even hundreds of millions, NetSuite"
    } ]
  }, {
    "tStartMs": 188104,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "helps you respond to immediate challenges\nand seize your biggest opportunities."
    } ]
  }, {
    "tStartMs": 191858,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "Speaking of opportunity, download the CFO's\nGuide to AI and Machine"
    } ]
  }, {
    "tStartMs": 195278,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Learning at www.netsuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 198573,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "The guide is free to you\nat www.netsuite.com/ModernMBA"
    } ]
  }, {
    "tStartMs": 201743,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "netsuke dot com slash"
    } ]
  }, {
    "tStartMs": 204787,
    "dDurationMs": 1127,
    "segs": [ {
      "utf8": "Modern MBA."
    } ]
  }, {
    "tStartMs": 209417,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "The regression in fast food\nis what's enabled smashburgers to thrive."
    } ]
  }, {
    "tStartMs": 212712,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "McDonald's business is not designed\nto compete on product."
    } ]
  }, {
    "tStartMs": 216299,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "The only lasting improvements\nmade to the menu over the past 20 years"
    } ]
  }, {
    "tStartMs": 219761,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "have been adding more sauce to Big Macs,\nincreasing warming temperatures"
    } ]
  }, {
    "tStartMs": 223264,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "so that the cheese can melt better,\nand removing artificial ingredients."
    } ]
  }, {
    "tStartMs": 226935,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "McDonald's core business isn't burgers,\nit's real estate."
    } ]
  }, {
    "tStartMs": 230313,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Rent is the strongest, highest-margin\nrevenue stream for the Golden Arches,"
    } ]
  }, {
    "tStartMs": 233983,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "accounting for nearly double\nof royalties on food and beverage sales"
    } ]
  }, {
    "tStartMs": 237445,
    "dDurationMs": 4505,
    "segs": [ {
      "utf8": "and it's been like that for generations.\nBecause their profits are rooted in rent,"
    } ]
  }, {
    "tStartMs": 241991,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "the business is all about opening\nand leasing as many stores as possible."
    } ]
  }, {
    "tStartMs": 246246,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "Real estate is more timing than capital."
    } ]
  }, {
    "tStartMs": 248873,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "Since McDonald's started buying\nland in the 1950s before anyone else,"
    } ]
  }, {
    "tStartMs": 252794,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "it's no surprise that decades later,\nthey make the most off franchisees."
    } ]
  }, {
    "tStartMs": 257173,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "The average Mickey D's\nfranchisee pays up about $400,000"
    } ]
  }, {
    "tStartMs": 260760,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "per store every year,\nfour times that of Burger King,"
    } ]
  }, {
    "tStartMs": 263638,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "Wendy's, and Five Guys."
    } ]
  }, {
    "tStartMs": 265556,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "The tradeoff for scale is control."
    } ]
  }, {
    "tStartMs": 267725,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "Franchisees handle execution, set"
    } ]
  }, {
    "tStartMs": 269978,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "their own prices, and run\n95% of the world's McDonald's."
    } ]
  }, {
    "tStartMs": 273773,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "They're mercenaries who sell burgers\nfor the money, just like how McDonald's"
    } ]
  }, {
    "tStartMs": 276943,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "only supplies them with ingredients\nin order to collect rent."
    } ]
  }, {
    "tStartMs": 280238,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "When American franchisees started jacking up\nprices under the excuse of inflation,"
    } ]
  }, {
    "tStartMs": 284242,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "the company had no choice\nbut to go along with it."
    } ]
  }, {
    "tStartMs": 286995,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "They tried to elevate customer experience\nto match the higher prices with store"
    } ]
  }, {
    "tStartMs": 290623,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "remodels and new gourmet products,\nbut these efforts all failed."
    } ]
  }, {
    "tStartMs": 294168,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "Franchisees collapse under complexity."
    } ]
  }, {
    "tStartMs": 296504,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "They revolt against anything\nthat slows them down."
    } ]
  }, {
    "tStartMs": 299132,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "Rolling tortillas was considered\nso tedious that McDonald's was forced"
    } ]
  }, {
    "tStartMs": 302635,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "to discontinue Snack Wraps\nafter franchisees refused to make them."
    } ]
  }, {
    "tStartMs": 306389,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "While the average franchise is grossing\nmore with the price hikes,"
    } ]
  }, {
    "tStartMs": 309267,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "the reality is less\nand less of that is profit."
    } ]
  }, {
    "tStartMs": 311978,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "The Golden Arches are stuck."
    } ]
  }, {
    "tStartMs": 313354,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "They want to invent the next hit product,\nbut they can't"
    } ]
  }, {
    "tStartMs": 315648,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "when franchisees won't execute.\nThey want to lead with value"
    } ]
  }, {
    "tStartMs": 318818,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "but don't get set prices."
    } ]
  }, {
    "tStartMs": 320570,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "The only place they can influence\nprice is on the mobile app,"
    } ]
  }, {
    "tStartMs": 323281,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "but franchisees can still opt out,"
    } ]
  }, {
    "tStartMs": 325074,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "hence the disclaimer of participating\nlocations only."
    } ]
  }, {
    "tStartMs": 328953,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "Store-level operating margins today\nare as low as they were 20 years ago."
    } ]
  }, {
    "tStartMs": 334167,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "McDonald's is now pursuing\nbeverages over burgers"
    } ]
  }, {
    "tStartMs": 337003,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "because drinks can be mass-produced\nfar more efficiently,"
    } ]
  }, {
    "tStartMs": 339839,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "and the only complexity is operating\na blender."
    } ]
  }, {
    "tStartMs": 342633,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Wendy's and Burger\nKing are in the same predicament"
    } ]
  }, {
    "tStartMs": 345219,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "but because their businesses run\nmore on royalties rather than rent,"
    } ]
  }, {
    "tStartMs": 348222,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "they're forced to invest in product."
    } ]
  }, {
    "tStartMs": 350558,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "Since they face the same issues of third\nparty pricing and execution,"
    } ]
  }, {
    "tStartMs": 354020,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "both brands lean into limited-time"
    } ]
  }, {
    "tStartMs": 355730,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "riffs to mitigate inventory\nrisk and operational complexity."
    } ]
  }, {
    "tStartMs": 359525,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "They'll partner with any brand,"
    } ]
  }, {
    "tStartMs": 360735,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "from The Addams Family to SpongeBob,\njust to entice the bottom of the market."
    } ]
  }, {
    "tStartMs": 364739,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "They tried to lead on value by\nblasting discounts and their franchisees"
    } ]
  }, {
    "tStartMs": 367825,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "go along with it, as they know there's not\nmuch left in the tank like McDonald's."
    } ]
  }, {
    "tStartMs": 372121,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "The store-level operating margins of both\nbrands are also declining now, as they"
    } ]
  }, {
    "tStartMs": 376501,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "all race to the bottom with the collapse\nof their international ventures."
    } ]
  }, {
    "tStartMs": 380880,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "Wendy's and Burger King's only\nstrategy is to continually slash product"
    } ]
  }, {
    "tStartMs": 384842,
    "dDurationMs": 960,
    "segs": [ {
      "utf8": "to improve profits"
    } ]
  }, {
    "tStartMs": 385802,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "for their remaining franchisees and\nto secure the flow of domestic royalties."
    } ]
  }, {
    "tStartMs": 390139,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "Yet all the burger giants historically\ncompeted on product - Wendy's with fresh,"
    } ]
  }, {
    "tStartMs": 394310,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "never frozen beef, Burger\nKing with big portions and flame-grilled"
    } ]
  }, {
    "tStartMs": 397605,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "patties, and McDonald's with special sauce\nand thin tallow fries."
    } ]
  }, {
    "tStartMs": 401567,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "But these things that used to set\nthese chains apart are now the baseline"
    } ]
  }, {
    "tStartMs": 404862,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "for any modern LA smashburger concept."
    } ]
  }, {
    "tStartMs": 408032,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Competition is fiercest in Central LA,\nbut the biggest opportunities"
    } ]
  }, {
    "tStartMs": 411661,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "are in the suburbs of South Bay, where\nthere are only a handful of these spots."
    } ]
  }, {
    "tStartMs": 427051,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Matt, a former restaurant\nmarketer, started smashing burger"
    } ]
  }, {
    "tStartMs": 430054,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "patties in his driveway\nduring the pandemic when business crashed."
    } ]
  }, {
    "tStartMs": 433349,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "That's where the idea for Proudly\nServing was born."
    } ]
  }, {
    "tStartMs": 477018,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "Every detail at Proudly Serving's two South Bay"
    } ]
  }, {
    "tStartMs": 479520,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "locations, from the pickles to the pinball\nmachines, is deliberate."
    } ]
  }, {
    "tStartMs": 575908,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "In poker, the table you sit at is\nthe most important decision you can make."
    } ]
  }, {
    "tStartMs": 579203,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "And the same is true in business."
    } ]
  }, {
    "tStartMs": 580997,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "With multiple burgers, beer on tap,\nwine, and duck fat fries,"
    } ]
  }, {
    "tStartMs": 585001,
    "dDurationMs": 4212,
    "segs": [ {
      "utf8": "he's built Proudly Serving on the older\nsuburban demographic who are higher income"
    } ]
  }, {
    "tStartMs": 589213,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "but also wary of hype\nand resistant to trends."
    } ]
  }, {
    "tStartMs": 592258,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Proudly Serving is a destination,\nnot a pit stop"
    } ]
  }, {
    "tStartMs": 594719,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "and merit, rather than marketing, has played"
    } ]
  }, {
    "tStartMs": 596762,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "the biggest role\nin its five years of growth."
    } ]
  }, {
    "tStartMs": 628252,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "Consistency was easy\nwhen Matt made every burger himself,"
    } ]
  }, {
    "tStartMs": 631547,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "but scaling that across shifts, teams,"
    } ]
  }, {
    "tStartMs": 633716,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "and two restaurants\nis a different kind of challenge."
    } ]
  }, {
    "tStartMs": 793959,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "The suburban market is tough to crack."
    } ]
  }, {
    "tStartMs": 795961,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "That's why fast-casual concepts like Shake\nShack and Chipotle launched in cities"
    } ]
  }, {
    "tStartMs": 799840,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "where customers are easier to acquire\nand momentum builds fast."
    } ]
  }, {
    "tStartMs": 803135,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "But if you can win the suburbs,\nit pays off."
    } ]
  }, {
    "tStartMs": 805805,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "Proudly Serving grosses, on average $190,000"
    } ]
  }, {
    "tStartMs": 809433,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "a month for an annual run rate of $2.3\nmillion per store,"
    } ]
  }, {
    "tStartMs": 813479,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "more than the average\nFive Guys, Burger King, and Wendy's."
    } ]
  }, {
    "tStartMs": 817149,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "The average order is $28,\nwith 70% of transactions"
    } ]
  }, {
    "tStartMs": 820778,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "taking place in house and 30%\nbeing delivery."
    } ]
  }, {
    "tStartMs": 824323,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Alcohol is a core offering,\nbut it only makes up 13% of sales."
    } ]
  }, {
    "tStartMs": 828494,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "His average operating margin hovers\nwell above the burger giants at 23%."
    } ]
  }, {
    "tStartMs": 866866,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Inside LA, the smashburger landscape\nlooks different."
    } ]
  }, {
    "tStartMs": 870035,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "Seasoned restaurateurs"
    } ]
  }, {
    "tStartMs": 871245,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "are jumping in not just to do it better,\nbut to do it differently."
    } ]
  }, {
    "tStartMs": 874999,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "Katy and her sister Amanda\nhave run Thai restaurants since 1999."
    } ]
  }, {
    "tStartMs": 879128,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "When a space open next door to their full\nservice flagship in West LA,"
    } ]
  }, {
    "tStartMs": 882798,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "they jumped at the chance to open\nsomething lean, fast, and casual. In just"
    } ]
  }, {
    "tStartMs": 886969,
    "dDurationMs": 4588,
    "segs": [ {
      "utf8": "3 months, Ban Ban was born, serving\nthe city's first ever Thai smashburgers."
    } ]
  }, {
    "tStartMs": 954787,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "The menu balances the classics"
    } ]
  }, {
    "tStartMs": 956330,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "with more adventurous offerings\nlike pandan milkshakes and papaya fries."
    } ]
  }, {
    "tStartMs": 960376,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "Fusion smashburgers are uncharted\nterritory, and Katie is the first to admit"
    } ]
  }, {
    "tStartMs": 964129,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "that they're still learning."
    } ]
  }, {
    "tStartMs": 965547,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "Ban Ban is only one year\nold, and grosses on average $71,000"
    } ]
  }, {
    "tStartMs": 969718,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "a month for an annual run\nrate of $852,000."
    } ]
  }, {
    "tStartMs": 974139,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "It's a lean operation"
    } ]
  }, {
    "tStartMs": 975349,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "with a tight menu and simple decor\nbuilt to test product-market fit."
    } ]
  }, {
    "tStartMs": 998831,
    "dDurationMs": 917,
    "segs": [ {
      "utf8": "Ban Ban runs at"
    } ]
  }, {
    "tStartMs": 999748,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "6% operating margin, and being next door\nto their flagship takes off the pressure"
    } ]
  }, {
    "tStartMs": 1003836,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "for profits and allows the 2 kitchens\nto share staff and ingredients."
    } ]
  }, {
    "tStartMs": 1007715,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The average order size sits at $26."
    } ]
  }, {
    "tStartMs": 1043542,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "At Bungraze in downtown LA,"
    } ]
  }, {
    "tStartMs": 1045335,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Raj and his son"
    } ]
  }, {
    "tStartMs": 1046336,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "Neil have reimagined the smashburger\nwith something older and fresher."
    } ]
  }, {
    "tStartMs": 1095427,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "Before Bungraze, Raj and his family ran\na full service restaurant in the suburbs"
    } ]
  }, {
    "tStartMs": 1099598,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "that specializes in conventional flame\ngrilled burgers for ten years."
    } ]
  }, {
    "tStartMs": 1103685,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "But thick patties were slow to cook\nand easy to undercook"
    } ]
  }, {
    "tStartMs": 1106730,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "smash burgers have made service faster\nand more consistent."
    } ]
  }, {
    "tStartMs": 1189646,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "Neil and Raj are"
    } ]
  }, {
    "tStartMs": 1190564,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "adapting to operating in the city\nwhere customers are less forgiving,"
    } ]
  }, {
    "tStartMs": 1193942,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "word of mouth is slower,"
    } ]
  }, {
    "tStartMs": 1195485,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "space is tight, and elements\nlike marketing, branding and social media"
    } ]
  }, {
    "tStartMs": 1199406,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "play a bigger role."
    } ]
  }, {
    "tStartMs": 1200949,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "Bungraze is much smaller, leaner,\nand focused in menu"
    } ]
  }, {
    "tStartMs": 1203911,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "than their past concepts, and the family\nsplit shifts from open to close."
    } ]
  }, {
    "tStartMs": 1208165,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "Like Ban Ban, Bungraze is just one year old."
    } ]
  }, {
    "tStartMs": 1211001,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "They gross on average $33,000\na month for an annual run"
    } ]
  }, {
    "tStartMs": 1214838,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "rate of $396,000 a year."
    } ]
  }, {
    "tStartMs": 1220010,
    "dDurationMs": 4046,
    "segs": [ {
      "utf8": "They turned a profit in month 10,\na rarity for any restaurant's first year."
    } ]
  }, {
    "tStartMs": 1227893,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Their operating margins set at 18%\nabove the average"
    } ]
  }, {
    "tStartMs": 1230896,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "Burger King, Wendy's,"
    } ]
  }, {
    "tStartMs": 1232105,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "and Five Guys, and the average Bungraze \ncustomer spends $18 per order."
    } ]
  }, {
    "tStartMs": 1256213,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Most smashburger shops in LA\nare like Bungraze and Proudly Serving,"
    } ]
  }, {
    "tStartMs": 1259800,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "where owners touch as many burgers\ngoing out the door as possible."
    } ]
  }, {
    "tStartMs": 1273939,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "You can afford to be in the trenches\nwhen you have 1 or 2 locations,"
    } ]
  }, {
    "tStartMs": 1277025,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "but when you're one of the first movers\nand can imagine a future that others"
    } ]
  }, {
    "tStartMs": 1280279,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "haven't seen, that day to day\nlooks very different. "
    } ]
  }, {
    "tStartMs": 1292416,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "Six years ago, Santos"
    } ]
  }, {
    "tStartMs": 1293834,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "was the owner of a Michelin-rated\nFrench bistro in Hollywood."
    } ]
  }, {
    "tStartMs": 1297421,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "While its focus was in wine\nand haute cuisine,"
    } ]
  }, {
    "tStartMs": 1299673,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "he had long kept an eye on the burger\nscene."
    } ]
  }, {
    "tStartMs": 1347512,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "When the pandemic shut down his bistro,\nSantos pivoted to save his restaurant."
    } ]
  }, {
    "tStartMs": 1355312,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "Today For the Win is \nLA's largest independent smashburger"
    } ]
  }, {
    "tStartMs": 1358565,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "chain with 11 stores\nall fully owned and operated."
    } ]
  }, {
    "tStartMs": 1361943,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "They've been voted"
    } ]
  }, {
    "tStartMs": 1362652,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "the best smashburger in the city by Yelp,\nThe Infatuation, and other publications."
    } ]
  }, {
    "tStartMs": 1440188,
    "dDurationMs": 5297,
    "segs": [ {
      "utf8": "While most owners these days are trying to carve out a niche,\nSantos is focused on execution at scale."
    } ]
  }, {
    "tStartMs": 1446069,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "For The Win is the leader and frontrunner\nthat's set the product standard"
    } ]
  }, {
    "tStartMs": 1449531,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "and helped build the LA"
    } ]
  }, {
    "tStartMs": 1450740,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "smashburger market to where it is today."
    } ]
  }, {
    "tStartMs": 1453368,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "He's not worried about protecting\nsome secret ingredient or proprietary"
    } ]
  }, {
    "tStartMs": 1456955,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "technique, but he's not any less product-minded \nor meticulous."
    } ]
  }, {
    "tStartMs": 1460667,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "When you're selling hundreds of burgers\nevery hour, every day across 11 stores,"
    } ]
  }, {
    "tStartMs": 1464546,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Santos can no longer jump into the kitchen\nevery time something goes wrong."
    } ]
  }, {
    "tStartMs": 1556137,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Santos isn't chasing clout or social media\naccolades."
    } ]
  }, {
    "tStartMs": 1559349,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "To him, the real metric is consistency."
    } ]
  }, {
    "tStartMs": 1583915,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "While Santos thinks of the big picture\nand ideas, Peter handles implementation."
    } ]
  }, {
    "tStartMs": 1729018,
    "dDurationMs": 2712,
    "segs": [ {
      "utf8": "Peter isn't the corporate bean counter\nor spreadsheet guy."
    } ]
  }, {
    "tStartMs": 1731730,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "He started out as a dishwasher\nat the French Bistro six years ago,"
    } ]
  }, {
    "tStartMs": 1735275,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "and when Santos pivoted, Peter\njumped in to help when no one else would."
    } ]
  }, {
    "tStartMs": 1738778,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "He runs operations today and\nevery week he checks in on all 11 stores."
    } ]
  }, {
    "tStartMs": 1861776,
    "dDurationMs": 3504,
    "segs": [ {
      "utf8": "Even though For the Win is big,\nthere's no franchisees, licensees,"
    } ]
  }, {
    "tStartMs": 1865280,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "or venture capitalists, and Santos\nhas little appetite for such arrangements."
    } ]
  }, {
    "tStartMs": 1869659,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "He's not interested\nin securing a quick payout,"
    } ]
  }, {
    "tStartMs": 1871953,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "looking good on a slide deck,"
    } ]
  }, {
    "tStartMs": 1873329,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "or compromising on the values\nthat got him to where he is today."
    } ]
  }, {
    "tStartMs": 1972887,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "For The Win’s established plaza stores,\nlike in Hollywood"
    } ]
  }, {
    "tStartMs": 1975390,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "Gross on average $3.5 million a year."
    } ]
  }, {
    "tStartMs": 1978768,
    "dDurationMs": 4755,
    "segs": [ {
      "utf8": "Their 100-square-foot food stall in Grand Central Market\ngrosses nearly $2 million a year."
    } ]
  }, {
    "tStartMs": 1983856,
    "dDurationMs": 4922,
    "segs": [ {
      "utf8": "And their 500-square-foot strip mall restaurants,\nlike in Glendale, gross $1.2 million a year"
    } ]
  }, {
    "tStartMs": 1989070,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "The chain's annual run rate,"
    } ]
  }, {
    "tStartMs": 1990530,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "combining all 11 stores,\ncomes to $20 million a year."
    } ]
  }, {
    "tStartMs": 1994659,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Their average order size\nsits at $30 across all stores,"
    } ]
  }, {
    "tStartMs": 1998329,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "while their best locations\nenjoy 30% operating margins."
    } ]
  }, {
    "tStartMs": 2001374,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "The portfolio-wide operating margin\nof the average For The Win"
    } ]
  }, {
    "tStartMs": 2004502,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "restaurant sits a 25%,\nhigher than that of Shake Shack."
    } ]
  }, {
    "tStartMs": 2008423,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "Shake Shack's sustained success shows that\nthere is an opportunity for new chains,"
    } ]
  }, {
    "tStartMs": 2012385,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "like For The Win"
    } ]
  }, {
    "tStartMs": 2013136,
    "dDurationMs": 3628,
    "segs": [ {
      "utf8": "to thrive without franchising\nor being pulled into a race to the bottom."
    } ]
  }, {
    "tStartMs": 2017432,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "It's exceptionally rare to get such\nan unfiltered look inside a big business."
    } ]
  }, {
    "tStartMs": 2021519,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "No conversation or footage\nwe ever recorded was off limits."
    } ]
  }, {
    "tStartMs": 2025273,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "In an era where people are obsessed\nwith fast exits, builders like Santos"
    } ]
  }, {
    "tStartMs": 2029110,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "feel like 1 in a million."
    } ]
  }, {
    "tStartMs": 2030778,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "He's bootstrapped his own journey,\nbrings people"
    } ]
  }, {
    "tStartMs": 2032905,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "along as he climbs, and stands\nexclusively behind his product."
    } ]
  }, {
    "tStartMs": 2036659,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "You won't find his name\nor face on their website or social media."
    } ]
  }, {
    "tStartMs": 2039996,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "He has no interest in personal branding\nor selling you a book or course."
    } ]
  }, {
    "tStartMs": 2042957,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "It's just Santos, his wife, and Peter."
    } ]
  }, {
    "tStartMs": 2046377,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "This small team of three are still"
    } ]
  }, {
    "tStartMs": 2047962,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "learning, still hands on,\nand still obsessed with getting it right."
    } ]
  }, {
    "tStartMs": 2051716,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "And even as restaurateurs and consumers\nin LA wonder"
    } ]
  }, {
    "tStartMs": 2054677,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "about fatigue and saturation,\nSantos sees a world beyond."
    } ]
  }, {
    "tStartMs": 2128084,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Some say smashburgers are destined"
    } ]
  }, {
    "tStartMs": 2129794,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "to settle in next to Big Macs and Whoppers."
    } ]
  }, {
    "tStartMs": 2132130,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "But it's no accident\nthat For the Win, Bungraze, Ban Ban,"
    } ]
  }, {
    "tStartMs": 2135883,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "and Proudly Serving are all pricing themselves"
    } ]
  }, {
    "tStartMs": 2137927,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "just above their local McDonald's\nand thriving."
    } ]
  }, {
    "tStartMs": 2140847,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "Smashburgers are a fast growing market\nthat's just in its first innings."
    } ]
  }, {
    "tStartMs": 2144684,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "The fundamentals are sound and the\nopportunities for product are credible."
    } ]
  }, {
    "tStartMs": 2148479,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "The collapse of the legacy fast\nfood burger has cleared the way"
    } ]
  }, {
    "tStartMs": 2151315,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "for something better,\nand that future is being shaped"
    } ]
  }, {
    "tStartMs": 2153568,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "by this next generation\nof small restaurateurs."
    } ]
  } ]
}
