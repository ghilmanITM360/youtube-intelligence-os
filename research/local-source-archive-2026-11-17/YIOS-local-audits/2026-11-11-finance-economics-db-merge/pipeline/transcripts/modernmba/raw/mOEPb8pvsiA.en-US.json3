  }, {
    "tStartMs": 2184265,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "extra to feature this snack brand,"
    } ]
  }, {
    "tStartMs": 2186517,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "even if frozen grapes and hot burgers\nmake for an unusual pairing."
    } ]
  }, {
    "tStartMs": 2301465,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "From the outside, mukbangs\nmight seem like an easy side hustle."
    } ]
  }, {
