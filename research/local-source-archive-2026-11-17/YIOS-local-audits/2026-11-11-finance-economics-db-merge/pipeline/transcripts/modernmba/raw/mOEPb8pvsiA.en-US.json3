  "events": [ {
    "tStartMs": 25525,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "Food content dominates every online\nplatform."
    } ]
  }, {
    "tStartMs": 28486,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "It's algorithm friendly, advertiser-safe\nand universally relatable."
    } ]
  }, {
    "tStartMs": 32741,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "Because everyone eats\nand the potential for virality is high,"
    } ]
  }, {
    "tStartMs": 35994,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "food content is one of the easiest ways\nto build an audience, but also one of the"
    } ]
  }, {
    "tStartMs": 39914,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "hardest to stand out in. These days, it's"
    } ]
  }, {
    "tStartMs": 42375,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "no longer the celebrity chefs,"
    } ]
  }, {
    "tStartMs": 43960,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "high production cooking\ncompetitions, and exotic food"
    } ]
  }, {
    "tStartMs": 46546,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "travel shows that get the most views,\nbut instead mukbangs,"
    } ]
  }, {
    "tStartMs": 49549,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "which roughly translate\nto eating broadcasts in Korean."
    } ]
  }, {
    "tStartMs": 52802,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "What started as a small"
    } ]
  }, {
    "tStartMs": 54095,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "niche years ago, where people"
    } ]
  }, {
    "tStartMs": 55555,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "posted videos of themselves\nbinging extreme"
    } ]
  }, {
    "tStartMs": 57724,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "portions, now serves as an umbrella term\nfor any form of eating"
    } ]
  }, {
    "tStartMs": 60977,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "content."
    } ]
  }, {
    "tStartMs": 62145,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "The appeal of mukbangs lies\nin the consumption, not the"
    } ]
  }, {
    "tStartMs": 64689,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "cooking or critique. Mukbangers speak\ndirectly to the camera or not at all,"
    } ]
  }, {
    "tStartMs": 69152,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "reacting in real time and chowing \ndown in their cars or homes."
    } ]
  }, {
    "tStartMs": 72697,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Like influencers, they invite viewers\ninto a casual parasocial relationship."
    } ]
  }, {
    "tStartMs": 76743,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "Some take just a few bites,"
    } ]
  }, {
    "tStartMs": 78495,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "others eat everything, but most feature\nabnormally large portions."
    } ]
  }, {
    "tStartMs": 82582,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "With huge bites,"
    } ]
  }, {
    "tStartMs": 83833,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "loud chewing, and messy eating, mukbangs"
    } ]
  }, {
    "tStartMs": 86377,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "are part ASMR, part shock value."
    } ]
  }, {
    "tStartMs": 89380,
    "dDurationMs": 418,
    "segs": [ {
      "utf8": "They allow"
    } ]
  }, {
    "tStartMs": 89798,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "viewers a sort of escapism\nwhere they can indulge"
    } ]
  }, {
    "tStartMs": 92467,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "without the guilt of gluttony."
    } ]
  }, {
    "tStartMs": 94094,
    "dDurationMs": 959,
    "segs": [ {
      "utf8": "Top mukbangers"
    } ]
  }, {
    "tStartMs": 95053,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "have carved out millions of followers\nand earned thousands of dollars feasting"
    } ]
  }, {
    "tStartMs": 98431,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "on fast food, snacks,"
    } ]
  }, {
    "tStartMs": 99891,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and local restaurant fare."
    } ]
  }, {
    "tStartMs": 101601,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "From the outside, it looks like a cushy\ngig, but on the inside, it's a"
    } ]
  }, {
    "tStartMs": 105063,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "saturated market with fierce competition\nwhere creators must set themselves apart"
    } ]
  }, {
    "tStartMs": 109359,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "even as new entrants stand by ready"
    } ]
  }, {
    "tStartMs": 111277,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "to copy them."
    } ]
  }, {
    "tStartMs": 112445,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "In this episode,\nwe dive into the economics"
    } ]
  }, {
    "tStartMs": 114572,
    "dDurationMs": 4463,
    "segs": [ {
      "utf8": "and grind of mukbang through the eyes\nand appetites of three content creators"
    } ]
  }, {
    "tStartMs": 119119,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "a breakout star,"
    } ]
  }, {
    "tStartMs": 127210,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "a rising newcomer,"
    } ]
  }, {
    "tStartMs": 133591,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and a scrappy growth hacker."
    } ]
  }, {
    "tStartMs": 145436,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "Today is chaos for every business owner."
    } ]
  }, {
    "tStartMs": 147564,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "Commerce has turned volatile as tariffs\nget slapped on and then removed, trade"
    } ]
  }, {
    "tStartMs": 151317,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "policies shift, and geopolitical tensions\nflare up week to week."
    } ]
  }, {
    "tStartMs": 155155,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "While economists continue to deny\nthat we're in a recession"
    } ]
  }, {
    "tStartMs": 157824,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "and that the stock market is booming,\ninflation is still up,"
    } ]
  }, {
    "tStartMs": 160577,
    "dDurationMs": 4045,
    "segs": [ {
      "utf8": "consumer spending is slowing, unemployment\nis increasing, and layoffs persist"
    } ]
  }, {
    "tStartMs": 164622,
    "dDurationMs": 3546,
    "segs": [ {
      "utf8": "in every industry. With labor shortages\nand supply chains under pressure,"
    } ]
  }, {
    "tStartMs": 168209,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "cash flow is tighter than ever."
    } ]
  }, {
    "tStartMs": 169919,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "Business has always been about evolution"
    } ]
  }, {
    "tStartMs": 171963,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "but if you can't adapt in real time,\nespecially in these moments,"
    } ]
  }, {
    "tStartMs": 175133,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "you're in for a world of hurt."
    } ]
  }, {
    "tStartMs": 176426,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "What every business needs now\nmore than ever is total visibility."
    } ]
  }, {
    "tStartMs": 179470,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "From global shipments\nto tariff impacts to real time cash flow."
    } ]
  }, {
    "tStartMs": 182891,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "That's NetSuite by Oracle, your"
    } ]
  }, {
    "tStartMs": 184642,
    "dDurationMs": 4380,
    "segs": [ {
      "utf8": "AI-powered business management\nsuite trusted by over 41,000 companies."
    } ]
  }, {
    "tStartMs": 189063,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "NetSuite is the number one cloud ERP\nfor many reasons."
    } ]
  }, {
    "tStartMs": 192150,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "It brings accounting, financial\nmanagement, inventory, and HR into one suite."
    } ]
  }, {
    "tStartMs": 196404,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "You have one source of truth,"
    } ]
  }, {
    "tStartMs": 197697,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "giving you the visibility and control\nyou need to make quick decisions."
    } ]
  }, {
    "tStartMs": 200909,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "With real-time forecasting,\nyou're peering into the future"
    } ]
  }, {
    "tStartMs": 203411,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "with actionable data and with AI embedded\nthroughout, you can automate"
    } ]
  }, {
    "tStartMs": 207165,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "those everyday tasks,\nletting your team stay strategic."
    } ]
  }, {
    "tStartMs": 210418,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "NetSuite helps you know what's stuck,"
    } ]
  }, {
    "tStartMs": 212045,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "what's it's costing you,\nand how to pivot fast."
    } ]
  }, {
    "tStartMs": 214589,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Modern MBA is small at the moment,\nbut as soon as we scale,"
    } ]
  }, {
    "tStartMs": 217675,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "we will need and use NetSuite today."
    } ]
  }, {
    "tStartMs": 219719,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "We're stitching things manually\nand it's hard to assess business health."
    } ]
  }, {
    "tStartMs": 222597,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "As a corporation,\nwe pay tax throughout the year"
    } ]
  }, {
    "tStartMs": 224849,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "and it's a nightmare jumping from system\nto system just to get one answer."
    } ]
  }, {
    "tStartMs": 228311,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "These are capabilities\nthat only NetSuite provides,"
    } ]
  }, {
    "tStartMs": 230730,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "and it's a platform that we intend\nto take every advantage of."
    } ]
  }, {
    "tStartMs": 233942,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "It's one system with full control\nthat can help you tame the chaos"
    } ]
  }, {
    "tStartMs": 237278,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "If your revenues are at least in the seven\nfigures,"
    } ]
  }, {
    "tStartMs": 239781,
    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "download the free ebook Navigating Global\nTrade Three Insights for Leaders"
    } ]
  }, {
    "tStartMs": 243743,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "at netsuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 246871,
    "dDurationMs": 4213,
    "segs": [ {
      "utf8": "The guide is free to you\nat netsuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 251125,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "That's netsuite.com/ModernMBA."
    } ]
  }, {
    "tStartMs": 282407,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "Natelo, who goes by"
    } ]
  }, {
    "tStartMs": 283533,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "Nate, ranks among the leading mukbangers\nthanks to his impressive"
    } ]
  }, {
    "tStartMs": 286661,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "700,000 TikTok followers and 100,000 Instagram fans."
    } ]
  }, {
    "tStartMs": 291416,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "For him, it's not necessarily what he eats\nor how he eats it."
    } ]
  }, {
    "tStartMs": 295128,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "Food is just the hook and"
    } ]
  }, {
    "tStartMs": 296421,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "his real edge is personality."
    } ]
  }, {
    "tStartMs": 298756,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "He isn't chasing every trend."
    } ]
  }, {
    "tStartMs": 300258,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "Instead, he's focused on delivering \nhis own stream of"
    } ]
  }, {
    "tStartMs": 302593,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "consciousness while he eats."
    } ]
  }, {
    "tStartMs": 531322,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "At the end of the day,\nNate's at the mercy of the algorithm."
    } ]
  }, {
    "tStartMs": 534367,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "The mukbang subgenre that he settled on\nis ultimately what's produced"
    } ]
  }, {
    "tStartMs": 538037,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "the best results."
    } ]
  }, {
    "tStartMs": 603561,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "Nate's locked into his style."
    } ]
  }, {
    "tStartMs": 605062,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "He always wears a blue hat and a\nwhite shirt so the food can pop on camera."
    } ]
  }, {
    "tStartMs": 608983,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "He plans content a month\nahead, rotating between fast food,"
    } ]
  }, {
    "tStartMs": 612778,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "ethnic spots, chains, and mom-and-pops,\nso his feed"
    } ]
  }, {
    "tStartMs": 616157,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "is never predictable."
    } ]
  }, {
    "tStartMs": 617491,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Even though fast food drives\nthe most views and he never films"
    } ]
  }, {
    "tStartMs": 621078,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "for more than 20 minutes,"
    } ]
  }, {
    "tStartMs": 712420,
    "dDurationMs": 2877,
    "segs": [ {
      "utf8": "Nate's journey is one borne of trial\nand error."
    } ]
  }, {
    "tStartMs": 715297,
    "dDurationMs": 2503,
    "segs": [ {
      "utf8": "For eight years,\nhe chased the YouTube dream."
    } ]
  }, {
    "tStartMs": 717800,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "Comedy, skits, group bits,\ngaming content - "
    } ]
  }, {
    "tStartMs": 720636,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "none of it landed."
    } ]
  }, {
    "tStartMs": 733482,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "Then came a video he"
    } ]
  }, {
    "tStartMs": 734608,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "filmed of himself trying Mexican \nsnacks for a friend,"
    } ]
  }, {
    "tStartMs": 737611,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "not an audience."
    } ]
  }, {
    "tStartMs": 795669,
    "dDurationMs": 2670,
    "segs": [ {
      "utf8": "Nate doesn't even see himself as a mukbanger."
    } ]
  }, {
    "tStartMs": 798339,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "And with the way business is developing,\nit's less advantageous to identify"
    } ]
  }, {
    "tStartMs": 802218,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "as one."
    } ]
  }, {
    "tStartMs": 832081,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Nate's growth has been rapid."
    } ]
  }, {
    "tStartMs": 833791,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "He first started posting on TikTok in 2022."
    } ]
  }, {
    "tStartMs": 837002,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "The following year,\nhe broke 500,000 followers and got"
    } ]
  }, {
    "tStartMs": 840256,
    "dDurationMs": 1751,
    "segs": [ {
      "utf8": "signed to a talent agency."
    } ]
  }, {
    "tStartMs": 842007,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "Even though his"
    } ]
  }, {
    "tStartMs": 842716,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "initial virality was"
    } ]
  }, {
    "tStartMs": 843801,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "serendipitous, Nate has studied\nthe landscape."
    } ]
  }, {
    "tStartMs": 846554,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "There's a distinction between"
    } ]
  }, {
    "tStartMs": 847888,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "short-form and long-form and performance\non one platform doesn't guarantee"
    } ]
  }, {
    "tStartMs": 851976,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "success on another."
    } ]
  }, {
    "tStartMs": 897104,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "TikTok's payouts fluctuate,"
    } ]
  }, {
    "tStartMs": 898689,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "but Nate publishes 10 to 14 videos\na month and grosses a $1,000"
    } ]
  }, {
    "tStartMs": 902776,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "for every million views."
    } ]
  }, {
    "tStartMs": 904987,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "In a good month, he can make up to $8,000"
    } ]
  }, {
    "tStartMs": 907489,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "but when views are down as low as $3,000."
    } ]
  }, {
    "tStartMs": 910951,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "His average gross annual earnings\nthrough ad revenue"
    } ]
  }, {
    "tStartMs": 913412,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "alone is $78,000,"
    } ]
  }, {
    "tStartMs": 914538,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "with food costs\ntopping out at $40 per video."
    } ]
  }, {
    "tStartMs": 919126,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Brand deals are an emerging\nbut unpredictable revenue"
    } ]
  }, {
    "tStartMs": 921712,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "stream that pay between 3 to 5 figures."
    } ]
  }, {
    "tStartMs": 924506,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "Since the commercial market\nfor mukbangers is so immature relative"
    } ]
  }, {
    "tStartMs": 928093,
    "dDurationMs": 3921,
    "segs": [ {
      "utf8": "to other types of influencers, rates\nvary wildly, and creators"
    } ]
  }, {
    "tStartMs": 932014,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "are bound by non-disclosure agreements."
    } ]
  }, {
    "tStartMs": 933766,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "at both the brand and agency level."
    } ]
  }, {
    "tStartMs": 936477,
    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "As a result, earnings from brand deals\nhave been omitted from these figures."
    } ]
  }, {
    "tStartMs": 940481,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Nate enjoys content creation\nfar more than his old"
    } ]
  }, {
    "tStartMs": 943150,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "job as a bank teller."
    } ]
  }, {
    "tStartMs": 944610,
