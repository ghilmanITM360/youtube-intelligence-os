  }, {
    "tStartMs": 1816606,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "and iterate to find the winning formula."
    } ]
  }, {
    "tStartMs": 1819275,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "Good lighting, strong audio, and clear\nangles are just the baseline."
    } ]
  }, {
    "tStartMs": 1823446,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "He builds every video on pattern\nrecognition,"
