    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "offers were rare."
    } ]
  }, {
    "tStartMs": 1568358,
    "dDurationMs": 5464,
    "segs": [ {
      "utf8": "It's not a sustainable income, but for \nElise, every video is still a labor of love."
    } ]
  }, {
    "tStartMs": 1634716,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "Yosef dabbled in content as a teenager,\nuploading Minecraft"
