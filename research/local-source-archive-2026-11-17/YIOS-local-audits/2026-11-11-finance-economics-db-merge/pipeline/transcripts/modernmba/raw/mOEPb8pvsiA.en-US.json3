  }, {
    "tStartMs": 2023104,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "and is clear on how far it's too far."
    } ]
  }, {
    "tStartMs": 2127875,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "While most creators"
