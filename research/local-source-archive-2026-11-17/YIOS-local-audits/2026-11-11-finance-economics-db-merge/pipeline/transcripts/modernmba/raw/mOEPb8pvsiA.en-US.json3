  }, {
    "tStartMs": 1070569,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "Compared to Nate,"
    } ]
  }, {
    "tStartMs": 1071445,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "her approach is quieter,\nmore deliberate, and rooted in compassion."
