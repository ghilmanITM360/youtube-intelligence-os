  }, {
    "tStartMs": 2166956,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "He hasn't cracked the top 1% just yet,\nbut he's shrewdly"
    } ]
  }, {
    "tStartMs": 2170251,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "maximized every opportunity,\nearning around $5,000 a"
    } ]
  }, {
    "tStartMs": 2173629,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "month in TikTok ads and"
