    "dDurationMs": 3962,
    "segs": [ {
      "utf8": "company than a pizza chain. In the 1980s,\nPizza Hut"
    } ]
  }, {
    "tStartMs": 446821,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "emerged, offering a unique product"
    } ]
  }, {
    "tStartMs": 448781,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "and dining experience."
    } ]
  }, {
    "tStartMs": 450366,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "They built comfy sit-down restaurants\nand turned pan pizza into the centerpiece"
    } ]
  }, {
    "tStartMs": 454203,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "for family dinners, parties, and buffets."
    } ]
  }, {
    "tStartMs": 457331,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "But 40 years later,"
    } ]
  }, {
    "tStartMs": 458541,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "that dining model is a liability."
    } ]
  }, {
    "tStartMs": 460710,
    "dDurationMs": 3044,
    "segs": [ {
      "utf8": "Pizza Hut doesn't have the customer base\nto compete on quality,"
    } ]
  }, {
    "tStartMs": 463754,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "as past attempts to upscale have all flopped."
    } ]
  }, {
    "tStartMs": 466841,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "They lack the network to compete on"
    } ]
  }, {
    "tStartMs": 468426,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "speed or price as their rivals\nsell for less"
    } ]
  }, {
    "tStartMs": 471220,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "and still make money with"
    } ]
  }, {
    "tStartMs": 472430,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "smaller, cheaper storefronts."
    } ]
  }, {
    "tStartMs": 474390,
    "dDurationMs": 4004,
    "segs": [ {
      "utf8": "This has pushed Pizza Hut into endless\ncost-cutting: sacrificing quality,"
    } ]
  }, {
    "tStartMs": 478394,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "skimping"
    } ]
  }, {
    "tStartMs": 478936,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "on ingredients and using frozen dough\nto help franchisees"
    } ]
  }, {
    "tStartMs": 482023,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "turn a profit in these oversize, underused"
    } ]
  }, {
    "tStartMs": 484609,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "spaces."
    } ]
  }, {
    "tStartMs": 485776,
    "dDurationMs": 1377,
    "segs": [ {
      "utf8": "Because Pizza Hut corporate"
    } ]
  }, {
    "tStartMs": 487153,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "only makes money from royalties, they've"
    } ]
  }, {
    "tStartMs": 489071,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "prioritized"
    } ]
  }, {
    "tStartMs": 489697,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "international expansion\nand left the US market to languish."
    } ]
  }, {
    "tStartMs": 493326,
    "dDurationMs": 2752,
    "segs": [ {
      "utf8": "Papa John's is forever a distant third."
    } ]
  }, {
    "tStartMs": 496078,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "The chain lacks Pizza Hut's nostalgia\nand Domino's speed,"
    } ]
  }, {
    "tStartMs": 499123,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "and is stuck in a conflicting position\nbetween premium and value."
    } ]
  }, {
    "tStartMs": 502668,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "The company leans on limited-time\ngimmicks to catch attention, but they"
    } ]
  }, {
    "tStartMs": 505880,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "only ever drive short-term results."
    } ]
  }, {
    "tStartMs": 508341,
    "dDurationMs": 4087,
    "segs": [ {
      "utf8": "Like Domino's, Papa John's revenue comes\nfrom ingredients sales and royalties."
    } ]
  }, {
    "tStartMs": 512428,
    "dDurationMs": 667,
    "segs": [ {
      "utf8": "But their growth"
    } ]
  }, {
    "tStartMs": 513095,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "depends on opening new stores\nwith volatile demand"
    } ]
  }, {
    "tStartMs": 516390,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "and franchisees unwilling to invest more."
    } ]
  }, {
    "tStartMs": 518851,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "The company has stagnated at every level.\nWhile the"
    } ]
  }, {
    "tStartMs": 522104,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "Big Three battle for dominance,"
    } ]
  }, {
    "tStartMs": 523689,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "a separate but similar war rages"
    } ]
  }, {
    "tStartMs": 525650,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "beneath them."
    } ]
  }, {
    "tStartMs": 526859,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "Little Caesars has gone\neven further down-market,"
    } ]
  }, {
    "tStartMs": 529320,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "while fast-casual chains\nlike MOD and Pieology move"
    } ]
  }, {
    "tStartMs": 532406,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "up from the flimsy Sbarro slice"
    } ]
  }, {
    "tStartMs": 534659,
    "dDurationMs": 3461,
    "segs": [ {
      "utf8": "at the mall food court to long-standing\nplayers like Round Table"
    } ]
  }, {
    "tStartMs": 538120,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "and newer brands like Blaze."
    } ]
  }, {
    "tStartMs": 539914,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "All of these chains still average\nroughly $1"
    } ]
  }, {
    "tStartMs": 542333,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "million per store in revenue."
    } ]
  }, {
    "tStartMs": 544085,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "Today, pizza is just so"
    } ]
  }, {
    "tStartMs": 545920,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "popular that no chain,\nno matter how outdated"
    } ]
  }, {
    "tStartMs": 548673,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "or obsolete, ever"
    } ]
  }, {
    "tStartMs": 549799,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "truly collapses.\n189\n00:11:11,384 --\u003e 00:09:13,678\nTheir struggles are all relative."
    } ]
  }, {
    "tStartMs": 553678,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "Every concept has its ceiling,\nbut the floor is unusually high.\n191\n00:17,682 --\u003e 00:19:19,809\nUltimately, the longevity and resilience\n192\n00:19:19,809 --\u003e 00:09:20,685\nof corporate chains\n193\n00:19:20,685 --\u003e 00:09:23,020\nin this business extends to independent"
    } ]
  }, {
    "tStartMs": 563020,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "pizzerias.\n195\n00:39:39,078 --\u003e 00:09:39,579\nIn New York"
    } ]
  }, {
    "tStartMs": 600850,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "with the newest\njust steps away from Times Square."
    } ]
  }, {
    "tStartMs": 604145,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "But on the East Coast,\nlegacy is measured in decades, and"
    } ]
  }, {
    "tStartMs": 607440,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "the two brothers are still\nconsidered newcomers."
    } ]
  }, {
    "tStartMs": 610359,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Pops is in Manhattan: the densest,\nwealthiest, and most recognizable"
    } ]
  }, {
    "tStartMs": 614196,
    "dDurationMs": 1961,
    "segs": [ {
      "utf8": "of the five boroughs, where opportunity"
    } ]
  }, {
    "tStartMs": 616157,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "and competition go hand in hand."
    } ]
  }, {
    "tStartMs": 618492,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Manhattan has the most"
    } ]
  }, {
    "tStartMs": 619493,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "pizzerias, with Brooklyn close behind."
    } ]
  }, {
    "tStartMs": 621787,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "Together, they form a fortress for"
    } ]
  }, {
    "tStartMs": 623414,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "independents, hosting\nmore than nine out of"
    } ]
  }, {
    "tStartMs": 625583,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "every ten pizzerias\nopened in the past decade."
    } ]
  }, {
    "tStartMs": 628544,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "Farther out in Queens and the"
    } ]
  }, {
    "tStartMs": 629962,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "Bronx, corporate"
    } ]
  }, {
    "tStartMs": 631005,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "chains have made more inroads\nas their promise"
    } ]
  }, {
    "tStartMs": 633382,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "of cheap, fast food"
    } ]
  }, {
    "tStartMs": 634675,
    "dDurationMs": 4672,
    "segs": [ {
      "utf8": "resonates in these more car-oriented,\nlower-income, and suburban neighborhoods."
    } ]
  }, {
    "tStartMs": 639889,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "Nick and Ricky did things the hardest way."
    } ]
  }, {
    "tStartMs": 642516,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "As former T-Mobile store owners,"
    } ]
  }, {
    "tStartMs": 644435,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "they were outsiders—"
    } ]
  }, {
    "tStartMs": 645269,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "no culinary roots, restaurant experience,"
    } ]
  }, {
    "tStartMs": 648147,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "family playbooks, or industry connections."
    } ]
  }, {
    "tStartMs": 650941,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "Instead of taking over\nan existing pizzeria,"
    } ]
  }, {
    "tStartMs": 653235,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "they converted a vacant jewelry store"
    } ]
  }, {
    "tStartMs": 655237,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "and unknowingly opened their doors\nin the most competitive"
    } ]
  }, {
    "tStartMs": 657990,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "neighborhood during the worst"
    } ]
  }, {
    "tStartMs": 659283,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "possible moment for any business."
    } ]
  }, {
    "tStartMs": 661827,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "But what the two brothers lacked\nin experience,"
    } ]
  }, {
    "tStartMs": 664038,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "they made up for in persistence."
    } ]
  }, {
    "tStartMs": 723139,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "There are more pizzerias"
    } ]
  }, {
    "tStartMs": 724390,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "in Midtown than"
    } ]
  }, {
    "tStartMs": 725224,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "any other neighborhood, and nearly a\nquarter of Manhattan pizzerias are packed"
    } ]
  }, {
    "tStartMs": 729520,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "onto these few blocks."
    } ]
  }, {
    "tStartMs": 731313,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Ricky and Nick are currently turning\ntheir foothold into a stronghold,"
    } ]
  }, {
    "tStartMs": 734650,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "with their second and third stores\njust blocks apart."
    } ]
  }, {
    "tStartMs": 737653,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "Born and raised"
    } ]
  }, {
    "tStartMs": 738404,
    "dDurationMs": 4129,
    "segs": [ {
      "utf8": "in Queens, the brothers had a front-row\nseat to New York's pizza evolution."
    } ]
  }, {
    "tStartMs": 742825,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "Their exposure shaped their vision"
    } ]
  }, {
    "tStartMs": 744577,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "and taught them what all owners\neventually face in this industry."
    } ]
  }, {
    "tStartMs": 822154,
    "dDurationMs": 542,
    "segs": [ {
      "utf8": "Despite the"
    } ]
  }, {
    "tStartMs": 822696,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "saturation, New York\npizzerias are strangely immortal."
    } ]
  }, {
    "tStartMs": 826575,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "In Manhattan, 8% of independent"
    } ]
  }, {
    "tStartMs": 828661,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "pizzerias have shuttered their stores\nin the past decade, and"
    } ]
  }, {
    "tStartMs": 831580,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "the rate is even lower in Brooklyn."
    } ]
  }, {
    "tStartMs": 833707,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "In simple terms, even\nin the most competitive, expensive"
    } ]
  }, {
    "tStartMs": 836502,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "boroughs, over"
    } ]
  }, {
    "tStartMs": 837336,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "90% of independent pizzerias survive."
    } ]
  }, {
    "tStartMs": 840381,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "Statewide,"
    } ]
  }, {
    "tStartMs": 841173,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "the failure rate\nis only marginally higher, at 10.4%."
    } ]
  }, {
    "tStartMs": 845594,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "But pizza isn't a magical business"
    } ]
  }, {
    "tStartMs": 847471,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "that never fails."
    } ]
  }, {
    "tStartMs": 848639,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "Instead, the failures are mostly invisible."
    } ]
  }, {
    "tStartMs": 851559,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "In a city where real estate is scarce,"
    } ]
  }, {
    "tStartMs": 853519,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "a struggling operator is"
    } ]
  }, {
    "tStartMs": 854895,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "often replaced by someone eager\nto step in, who's drawn"
    } ]
  }, {
    "tStartMs": 857940,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "by the low barriers to entry,\nattractive margins,"
    } ]
  }, {
    "tStartMs": 860693,
    "dDurationMs": 1209,
    "segs": [ {
      "utf8": "and the chance to start with a"
    } ]
  }, {
    "tStartMs": 861902,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "fully built and optimized kitchen."
    } ]
  }, {
    "tStartMs": 863946,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "Restaurants change hands all the time."
    } ]
  }, {
    "tStartMs": 865990,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "But in pizza, the new owners generally\nkeep the old name."
    } ]
  }, {
    "tStartMs": 869660,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "To outsiders, nothing changes,\nand the fabric of the neighborhood"
    } ]
  }, {
    "tStartMs": 872788,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "is left undisturbed."
    } ]
  }, {
    "tStartMs": 874331,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "In this sense, pizza shops are timeless\nspaces that outlast their owners,"
    } ]
  }, {
    "tStartMs": 878419,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "and the true failure rate is"
    } ]
  }, {
    "tStartMs": 880004,
    "dDurationMs": 3753,
    "segs": [ {
      "utf8": "hidden behind thousands\nof private backroom deals. Still,"
    } ]
  }, {
    "tStartMs": 883757,
    "dDurationMs": 1210,
    "segs": [ {
      "utf8": "some spots are simply"
    } ]
  }, {
    "tStartMs": 884967,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "too troubled or too specific to take over."
    } ]
  }, {
    "tStartMs": 887511,
    "dDurationMs": 3379,
    "segs": [ {
      "utf8": "Bad locations, poor layouts,\ndamaged reputations,"
    } ]
  }, {
    "tStartMs": 890890,
    "dDurationMs": 1292,
    "segs": [ {
      "utf8": "or unrealistic asking"
    } ]
  }, {
    "tStartMs": 892182,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "prices can deem them unsellable—"
    } ]
  }, {
    "tStartMs": 894101,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "and this is the visible"
    } ]
  }, {
    "tStartMs": 895519,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "failure rate that our data captures."
    } ]
  }, {
    "tStartMs": 897980,
    "dDurationMs": 626,
    "segs": [ {
      "utf8": "In Midtown,"
    } ]
  }, {
    "tStartMs": 898606,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "though, permanent closures are even rarer."
    } ]
  }, {
    "tStartMs": 900983,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "The neighborhood's unparalleled\nfoot traffic and"
    } ]
  }, {
    "tStartMs": 903068,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "opportunity give it"
    } ]
  }, {
    "tStartMs": 904111,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "the third lowest closure rate\nfor independent pizzerias"
    } ]
  }, {
    "tStartMs": 907114,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "in the city."
    } ]
  }, {
    "tStartMs": 908657,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "In a neighborhood saturated with old-"
    } ]
  }, {
    "tStartMs": 910367,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "school joints stuck in their ways,\nPops broke through by"
    } ]
  }, {
    "tStartMs": 913370,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "doing what others wouldn't."
    } ]
  }, {
    "tStartMs": 915039,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "They didn't reinvent New York pizza;"
    } ]
  }, {
    "tStartMs": 916832,
    "dDurationMs": 834,
    "segs": [ {
      "utf8": "they polished it."
    } ]
  }, {
    "tStartMs": 992241,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "Fresh cut vegetables, homemade sauces,"
    } ]
  }, {
    "tStartMs": 994618,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "extra-large 22-inch pies,"
    } ]
  }, {
    "tStartMs": 996537,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "and affordability are"
    } ]
  }, {
    "tStartMs": 997788,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "the pillars of Pops Pizza."
    } ]
  }, {
    "tStartMs": 999707,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Their best sellers—"
    } ]
  }, {
    "tStartMs": 1000708,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "Vodka, Margarita, and"
