  }, {
    "tStartMs": 1530695,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "the density of competition makes\nmaintaining hype a constant"
    } ]
  }, {
    "tStartMs": 1533740,
    "dDurationMs": 793,
    "segs": [ {
      "utf8": "grind."
    } ]
  }, {
    "tStartMs": 1534533,
    "dDurationMs": 3795,
    "segs": [ {
      "utf8": "Yet Motorino has thrived in all these\nneighborhoods for nearly 20 years"
    } ]
  }, {
    "tStartMs": 1538328,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "by maximizing volume across\nchannels with its unique product."
    } ]
  }, {
    "tStartMs": 1542207,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Take-out customers can buy two pies\nand get one free, while dine-in guests"
    } ]
  }, {
    "tStartMs": 1546127,
    "dDurationMs": 3754,
    "segs": [ {
      "utf8": "get a free bottle of wine with two pizzas,\nenabling the concept to win"
    } ]
  }, {
    "tStartMs": 1549881,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "on carryout value and dining experience"
    } ]
  }, {
    "tStartMs": 1552676,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "in ways that no true Neapolitan spot"
    } ]
  }, {
    "tStartMs": 1555011,
    "dDurationMs": 1627,
    "segs": [ {
      "utf8": "or slice shop could replicate."
    } ]
  }, {
    "tStartMs": 1558014,
    "dDurationMs": 543,
    "segs": [ {
      "utf8": "Much like"
    } ]
  }, {
    "tStartMs": 1558557,
    "dDurationMs": 1584,
    "segs": [ {
      "utf8": "Pops, the heart of Motorino"
    } ]
  }, {
    "tStartMs": 1560141,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "lies in a basement."
    } ]
  }, {
    "tStartMs": 1561685,
    "dDurationMs": 2168,
    "segs": [ {
      "utf8": "Every morning, a two-person team completes"
    } ]
  }, {
    "tStartMs": 1563853,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "production for all three New York stores\nin under four"
    } ]
  }, {
    "tStartMs": 1566815,
    "dDurationMs": 1585,
    "segs": [ {
      "utf8": "hours. By hand, they make"
    } ]
  }, {
    "tStartMs": 1568400,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "dough, portion thousands of rounds, grind"
    } ]
  }, {
    "tStartMs": 1570902,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "parmesan, and prep toppings."
    } ]
  }, {
    "tStartMs": 1572946,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Every week, this crew\nwill produce over 4,000"
    } ]
  }, {
    "tStartMs": 1575657,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "dough balls, plus hundreds\nof pounds of cheese,"
    } ]
  }, {
    "tStartMs": 1578118,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "mushrooms, tiramisu, and antipasti."
    } ]
  }, {
    "tStartMs": 1581162,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "By 10:00 a.m., everything gets\nloaded on a truck in"
    } ]
  }, {
    "tStartMs": 1583707,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "Williamsburg and gets"
    } ]
  }, {
    "tStartMs": 1584874,
    "dDurationMs": 2253,
    "segs": [ {
      "utf8": "delivered to the two other stores."
    } ]
  }, {
    "tStartMs": 1587127,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "Mathieu's trusted"
    } ]
  }, {
    "tStartMs": 1588003,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "lieutenant, Alberto, oversees"
    } ]
  }, {
    "tStartMs": 1589796,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "the day-to-day, fitting his Fiat\ninto impossible parking"
    } ]
  }, {
    "tStartMs": 1592674,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "spaces and working out of offices"
    } ]
  }, {
    "tStartMs": 1594509,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "across all three stores."
    } ]
  }, {
    "tStartMs": 1596511,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "For all restaurants, scale means cheaper"
    } ]
  }, {
    "tStartMs": 1598805,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "ingredients,\nbut for most high-volume concepts, like"
    } ]
  }, {
    "tStartMs": 1601683,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "grilling burgers or frying chicken,"
    } ]
  }, {
    "tStartMs": 1603518,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "much of the cooking still needs to happen"
    } ]
  }, {
    "tStartMs": 1605353,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "to order in a high-rent"
    } ]
  }, {
    "tStartMs": 1606688,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "kitchen. And in a busy neighborhood,"
    } ]
  }, {
    "tStartMs": 1608940,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "scale does not change the"
    } ]
  }, {
    "tStartMs": 1610442,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "labor and real estate costs per store."
    } ]
  }, {
    "tStartMs": 1613069,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "Pizza, however, is fundamentally different."
    } ]
  }, {
    "tStartMs": 1615655,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "Once a second store is"
    } ]
  }, {
    "tStartMs": 1616906,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "open, pizzerias can centralize dough"
    } ]
  }, {
    "tStartMs": 1619075,
    "dDurationMs": 1502,
    "segs": [ {
      "utf8": "production and re-engineer their"
    } ]
  }, {
    "tStartMs": 1620577,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "business to another level of efficiency."
    } ]
  }, {
    "tStartMs": 1623455,
    "dDurationMs": 2252,
    "segs": [ {
      "utf8": "As more stores are added, costs fall"
    } ]
  }, {
    "tStartMs": 1625707,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "and margins"
    } ]
  }, {
    "tStartMs": 1626291,
    "dDurationMs": 2919,
    "segs": [ {
      "utf8": "rise, as staff are only needed to assemble\nand bake."
    } ]
  }, {
    "tStartMs": 1629210,
    "dDurationMs": 1752,
    "segs": [ {
      "utf8": "So labor costs and real estate"
    } ]
  }, {
    "tStartMs": 1630962,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "costs go down."
    } ]
  }, {
    "tStartMs": 1632297,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "For pizza, scale is the profit model."
    } ]
  }, {
    "tStartMs": 1634883,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "This is the playbook everyone is chasing."
    } ]
  }, {
    "tStartMs": 1637385,
    "dDurationMs": 3879,
    "segs": [ {
      "utf8": "In New York State, nearly 1 in 4 pizzerias\nrun two or more stores."
    } ]
  }, {
    "tStartMs": 1641348,
    "dDurationMs": 3253,
    "segs": [ {
      "utf8": "In Manhattan and Brooklyn, home\nto some of the most ambitious,"
    } ]
  }, {
    "tStartMs": 1644601,
    "dDurationMs": 1376,
    "segs": [ {
      "utf8": "well-funded restaurateurs,"
    } ]
  }, {
    "tStartMs": 1645977,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "1 in 5 run three or more locations."
    } ]
  }, {
    "tStartMs": 1685850,
    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "Motorino's dough is the foundation\nof its most distinct"
    } ]
  }, {
    "tStartMs": 1688895,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "qualities in flavor, appearance, and performance."
    } ]
  }, {
    "tStartMs": 1690980,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "As a hybrid Neapolitan"
    } ]
  }, {
    "tStartMs": 1692524,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "that's nearly impossible to replicate,"
    } ]
  }, {
    "tStartMs": 1694859,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "tiny variations in hydration, temperature,"
    } ]
  }, {
    "tStartMs": 1697654,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "measurements, and timing\ncan dramatically affect the final product."
    } ]
  }, {
    "tStartMs": 1701491,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "This is why Domino's and Papa John's gross"
    } ]
  }, {
    "tStartMs": 1704119,
    "dDurationMs": 3336,
    "segs": [ {
      "utf8": "billions every year selling\nready-made dough to franchisees,"
    } ]
  }, {
    "tStartMs": 1707455,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "who willingly"
    } ]
  }, {
    "tStartMs": 1708206,
    "dDurationMs": 983,
    "segs": [ {
      "utf8": "pay a premium to avoid\nthe complexity of bread-making."
    } ]
  }, {
    "tStartMs": 1709189,
    "dDurationMs": 2395,
    "segs": [ {
      "utf8": "Even after leaving French fine dining,\nMathieu has never abandoned its standards."
    } ]
  }, {
    "tStartMs": 1712377,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Motorino's dough through\nyears of experimentation"
    } ]
  }, {
    "tStartMs": 1715046,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "and trips to Italy,"
    } ]
  }, {
    "tStartMs": 1716214,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "and has perfected it over nearly"
    } ]
  }, {
    "tStartMs": 1717924,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "two decades of high-volume service."
    } ]
  }, {
    "tStartMs": 1720635,
    "dDurationMs": 2086,
    "segs": [ {
      "utf8": "But most owners are not like Mathieu."
    } ]
  }, {
    "tStartMs": 1722721,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "Many get into the pizza business\nfor simplicity."
    } ]
  }, {
    "tStartMs": 1725348,
    "dDurationMs": 918,
    "segs": [ {
      "utf8": "They want a fast,"
    } ]
  }, {
    "tStartMs": 1726266,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "forgiving, foolproof dough\nthat can be prepared by"
    } ]
  }, {
    "tStartMs": 1728643,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "anyone. To meet this demand,"
    } ]
  }, {
    "tStartMs": 1730645,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "manufacturers have created\nhighly processed flours fortified with"
    } ]
  }, {
    "tStartMs": 1734190,
    "dDurationMs": 2962,
    "segs": [ {
      "utf8": "additives that make pizza dough\nbehave like pancake mix."
    } ]
  }, {
    "tStartMs": 1737152,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "Open the bag,"
    } ]
  }, {
    "tStartMs": 1738236,
    "dDurationMs": 1835,
    "segs": [ {
      "utf8": "add water, and it's done."
    } ]
  }, {
    "tStartMs": 1740071,
    "dDurationMs": 1919,
    "segs": [ {
      "utf8": "These engineered flours are the norm—"
    } ]
  }, {
    "tStartMs": 1741990,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "not just in pizzas, but also\nin donuts and bagels too."
    } ]
  }, {
    "tStartMs": 1745410,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "It's why most slices in New York City\nwill look and taste the same,"
    } ]
  }, {
    "tStartMs": 1748496,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "with the only real difference\nbeing the toppings."
    } ]
  }, {
    "tStartMs": 1751374,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "Mathieu rejects the"
    } ]
  }, {
    "tStartMs": 1752375,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "status quo and holds little respect"
    } ]
  }, {
    "tStartMs": 1754502,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "for the majority who rely on these\nindustrial flours under the guise"
    } ]
  }, {
    "tStartMs": 1758131,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "of tradition."
    } ]
  }, {
    "tStartMs": 1828134,
    "dDurationMs": 2377,
    "segs": [ {
      "utf8": "LA face a 12% failure rate—"
    } ]
  }, {
    "tStartMs": 1830511,
    "dDurationMs": 24008,
    "segs": [ {
      "utf8": "nearly three times that of chains.\nPotassium bromate is banned in the European"
    } ]
  }, {
    "tStartMs": 1854519,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "Union, the UK, Canada, Brazil,"
    } ]
  }, {
    "tStartMs": 1858106,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "China, India, and even most of Africa."
    } ]
  }, {
    "tStartMs": 1861276,
    "dDurationMs": 2627,
    "segs": [ {
      "utf8": "The United States is\none of the only developed nations"
    } ]
  }, {
    "tStartMs": 1863903,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "that still allows this carcinogen\nin its food supply; and General Mills'"
    } ]
  }, {
    "tStartMs": 1868074,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "All Trumps flour,\nwidely regarded as the gold"
    } ]
  }, {
    "tStartMs": 1870618,
    "dDurationMs": 3254,
    "segs": [ {
      "utf8": "standard flour for American pizzerias,\nis still formulated"
    } ]
  }, {
    "tStartMs": 1873872,
    "dDurationMs": 2335,
    "segs": [ {
      "utf8": "with potassium bromate."
    } ]
  }, {
    "tStartMs": 1876207,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "Ultimately, Neapolitan pizzerias"
    } ]
  }, {
    "tStartMs": 1878167,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "can charge more for\ntheir specialty product,"
    } ]
  }, {
    "tStartMs": 1880295,
    "dDurationMs": 5046,
    "segs": [ {
      "utf8": "wider menus, and cozy dining experiences;\nbut those premiums are easily offset"
    } ]
  }, {
    "tStartMs": 1885341,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "by higher labor and real estate costs."
    } ]
  }, {
    "tStartMs": 1887969,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "Mathieu is a master of details. For him,"
    } ]
  }, {
    "tStartMs": 1890763,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "fine dining is defined\nnot just by quality but also by precision."
    } ]
  }, {
    "tStartMs": 1990905,
    "dDurationMs": 1085,
    "segs": [ {
      "utf8": "For Motorino, it's"
    } ]
  }, {
    "tStartMs": 1991990,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "not just how the pizza is made, but\nit's also how it gets to the customers."
    } ]
  }, {
    "tStartMs": 1995743,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "All deliveries are handled\nby a private courier service"
    } ]
  }, {
    "tStartMs": 1998579,
    "dDurationMs": 1544,
    "segs": [ {
      "utf8": "because Mathieu won't gamble his"
    } ]
  }, {
    "tStartMs": 2000123,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "product on gig workers who have"
    } ]
  }, {
    "tStartMs": 2001666,
    "dDurationMs": 2586,
    "segs": [ {
      "utf8": "no stake in the customer experience."
    } ]
  }, {
    "tStartMs": 2004252,
    "dDurationMs": 4254,
    "segs": [ {
      "utf8": "And yet, his exacting standards seem fundamentally\nincompatible with global expansion."
    } ]
  }, {
    "tStartMs": 2008881,
    "dDurationMs": 2837,
    "segs": [ {
      "utf8": "Motorino has organically grown\ninto an international"
    } ]
  }, {
    "tStartMs": 2011718,
    "dDurationMs": 1876,
    "segs": [ {
      "utf8": "chain with more stores in Asia"
    } ]
  }, {
    "tStartMs": 2013594,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "than in New York itself."
    } ]
  }, {
    "tStartMs": 2015430,
    "dDurationMs": 2502,
    "segs": [ {
      "utf8": "While the product put\nthe pizzeria on the map,"
    } ]
  }, {
    "tStartMs": 2017932,
    "dDurationMs": 2628,
    "segs": [ {
      "utf8": "it's the systems that have made it scalable."
    } ]
  }, {
    "tStartMs": 2020560,
    "dDurationMs": 1710,
    "segs": [ {
      "utf8": "Motorino's expansive footprint has"
    } ]
  }, {
    "tStartMs": 2022270,
    "dDurationMs": 3670,
    "segs": [ {
      "utf8": "been achieved not through franchising,\nbut by selective licensing."
    } ]
  }, {
    "tStartMs": 2026649,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "Nearly 20"
    } ]
  }, {
    "tStartMs": 2027400,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "years later, it remains a powerhouse"
    } ]
  }, {
    "tStartMs": 2029360,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "without a single penny of outside investment."
    } ]
  }, {
    "tStartMs": 2032071,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "The average Motorino grosses"
    } ]
  }, {
    "tStartMs": 2033614,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "$176,000 a month,"
    } ]
  }, {
    "tStartMs": 2035783,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "for an annual run rate of $2.1 million."
    } ]
  }, {
    "tStartMs": 2038786,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "Per store across its\nNew York City portfolio,"
    } ]
  }, {
    "tStartMs": 2041539,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "the chain generates $6.3 million annually."
    } ]
  }, {
    "tStartMs": 2044917,
    "dDurationMs": 1293,
    "segs": [ {
      "utf8": "Over half of its sales come"
    } ]
  }, {
    "tStartMs": 2046210,
    "dDurationMs": 1836,
    "segs": [ {
      "utf8": "from carryout and delivery."
    } ]
  }, {
    "tStartMs": 2048046,
    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "With a dedicated production facility\nand finely tuned processes,"
    } ]
  }, {
    "tStartMs": 2051591,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "Motorino's store-level operating margin hovers at 24%."
    } ]
  }, {
    "tStartMs": 2055178,
    "dDurationMs": 1251,
    "segs": [ {
      "utf8": "a feat in the blue-chip"
    } ]
  }, {
    "tStartMs": 2056429,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "neighborhoods of Williamsburg,\nthe Upper West"
    } ]
  }, {
    "tStartMs": 2058431,
    "dDurationMs": 1918,
    "segs": [ {
      "utf8": "Side, and the East Village."
    } ]
  }, {
    "tStartMs": 2060349,
    "dDurationMs": 2795,
    "segs": [ {
      "utf8": "While most restaurants\ntarget food and labor costs at"
    } ]
  }, {
    "tStartMs": 2063144,
    "dDurationMs": 1084,
    "segs": [ {
      "utf8": "roughly 60%"
    } ]
  }, {
    "tStartMs": 2064228,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "of revenue, Motorino holds\nthese costs at"
    } ]
  }, {
    "tStartMs": 2066564,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "52%, despite operating\nin one of the world's most"
    } ]
  }, {
    "tStartMs": 2069692,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "expensive cities."
    } ]
  }, {
    "tStartMs": 2073279,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "When it comes to product,\nMathieu is no traditionalist,"
    } ]
  }, {
    "tStartMs": 2076449,
    "dDurationMs": 3378,
    "segs": [ {
      "utf8": "but it's his old-school values\nthat have singularly driven Motorino's"
    } ]
  }, {
    "tStartMs": 2079827,
    "dDurationMs": 3671,
    "segs": [ {
      "utf8": "success in the single most competitive\npizza market in the country."
    } ]
  }, {
