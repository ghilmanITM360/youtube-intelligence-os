    "segs": [ {
      "utf8": "so did the pizzeria. Richie never once"
    } ]
  }, {
    "tStartMs": 2796502,
    "dDurationMs": 875,
    "segs": [ {
      "utf8": "considered opening a"
    } ]
  }, {
    "tStartMs": 2797377,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "second store or swapping the paper\nplates for porcelain."
    } ]
  }, {
    "tStartMs": 2800839,
    "dDurationMs": 3796,
    "segs": [ {
      "utf8": "For him, running this one store has been\nmore than enough work for a lifetime."
    } ]
  }, {
    "tStartMs": 2805052,
    "dDurationMs": 1042,
    "segs": [ {
      "utf8": "As the first mover, his perspective is naturally simplistic,"
    } ]
  }, {
    "tStartMs": 2808305,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "almost reductive."
    } ]
  }, {
    "tStartMs": 2833580,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "Abbott's grosses"
    } ]
  }, {
    "tStartMs": 2834456,
    "dDurationMs": 3212,
    "segs": [ {
      "utf8": "$107,000 a month, for an\nannual run rate of"
    } ]
  }, {
    "tStartMs": 2837668,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "$1.3 million. 60% of sales are for"
    } ]
  }, {
    "tStartMs": 2841588,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "takeout and delivery, while 40% are dine-in."
    } ]
  }, {
    "tStartMs": 2844842,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "His operating margin sits at 10%."
    } ]
  }, {
    "tStartMs": 2847511,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "These days, Richie is an\nabsentee owner by choice."
    } ]
  }, {
    "tStartMs": 2850764,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "He hasn't been behind the counter\nin years."
    } ]
  }, {
    "tStartMs": 2852724,
    "dDurationMs": 1669,
    "segs": [ {
      "utf8": "His staff run everything, and he"
    } ]
  }, {
    "tStartMs": 2854393,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "no longer keeps the same watchful\neye on portions,"
    } ]
  }, {
    "tStartMs": 2857271,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "waste, efficiency, and prices\nlike he once did."
    } ]
  }, {
    "tStartMs": 2861066,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "It's impossible for even"
    } ]
  }, {
    "tStartMs": 2862192,
    "dDurationMs": 4171,
    "segs": [ {
      "utf8": "Richie to say if Abbott's would be\nas successful had he opened the pizzeria"
    } ]
  }, {
    "tStartMs": 2866363,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "today."
    } ]
  }, {
    "tStartMs": 2867406,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "After 30 years, he's\nfinally hung up his apron."
    } ]
  }, {
    "tStartMs": 2870576,
    "dDurationMs": 1167,
    "segs": [ {
      "utf8": "In December, Richie"
    } ]
  }, {
    "tStartMs": 2871743,
    "dDurationMs": 4088,
    "segs": [ {
      "utf8": "finally sold Abbott's Pizza;\nand the name, recipes, menu,"
    } ]
  }, {
    "tStartMs": 2875831,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "and staff are all expected\nto remain the same under the new owner."
    } ]
  }, {
    "tStartMs": 2920250,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "Without Richie"
    } ]
  }, {
    "tStartMs": 2921001,
    "dDurationMs": 2085,
    "segs": [ {
      "utf8": "and Tommy, there would be no Abbott's,\nand certainly"
    } ]
  }, {
    "tStartMs": 2923086,
    "dDurationMs": 1418,
    "segs": [ {
      "utf8": "no affordable pizzeria"
    } ]
  }, {
    "tStartMs": 2924504,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "on Abbot Kinney Boulevard."
    } ]
  }, {
    "tStartMs": 2926632,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "Yet, even as the founders, he"
    } ]
  }, {
    "tStartMs": 2928258,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "and his brother are simply\nthe first in what"
    } ]
  }, {
    "tStartMs": 2930260,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "will likely be a long line of owners;\nand the legacy of"
    } ]
  }, {
    "tStartMs": 2933180,
    "dDurationMs": 2878,
    "segs": [ {
      "utf8": "these two brothers will be known\nonly to the staff and early"
    } ]
  }, {
    "tStartMs": 2936058,
    "dDurationMs": 2794,
    "segs": [ {
      "utf8": "customers, most of whom\nhave long since left"
    } ]
  }, {
    "tStartMs": 2938852,
    "dDurationMs": 709,
    "segs": [ {
      "utf8": "the neighborhood."
    } ]
  }, {
    "tStartMs": 2940562,
    "dDurationMs": 2711,
    "segs": [ {
      "utf8": "Pizzerias are living reflections\nof their owners:"
    } ]
  }, {
    "tStartMs": 2943273,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "whether it's Mathieu's precision"
    } ]
  }, {
    "tStartMs": 2944733,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "at Motorino, Nick and Ricky's\nrelentless"
    } ]
  }, {
    "tStartMs": 2947152,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "hustle at Pops,"
    } ]
  }, {
    "tStartMs": 2948779,
    "dDurationMs": 3837,
    "segs": [ {
      "utf8": "Courtney and Kyle's scrappy punk-rock\nethos at Little Dynamite, or Richie's"
    } ]
  }, {
    "tStartMs": 2952616,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "steady old-soul wisdom at Abbott's.\nAs we've"
    } ]
  }, {
    "tStartMs": 2955452,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "seen across New York and California,"
    } ]
  }, {
    "tStartMs": 2957496,
    "dDurationMs": 1501,
    "segs": [ {
      "utf8": "the key to success is not the"
    } ]
  }, {
    "tStartMs": 2958997,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "water or some guarded family recipe."
    } ]
  }, {
    "tStartMs": 2961541,
    "dDurationMs": 4296,
    "segs": [ {
      "utf8": "It's in the nature of the craft\nitself: simple enough to welcome novices,"
    } ]
  }, {
    "tStartMs": 2966129,
    "dDurationMs": 3170,
    "segs": [ {
      "utf8": "flexible enough to support any vision,\nand yet still deep"
    } ]
  }, {
    "tStartMs": 2969299,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "enough to reward innovation and"
    } ]
  }, {
    "tStartMs": 2971343,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "enough to fuel even the greatest of ambitions."
    } ]
  } ]
}
