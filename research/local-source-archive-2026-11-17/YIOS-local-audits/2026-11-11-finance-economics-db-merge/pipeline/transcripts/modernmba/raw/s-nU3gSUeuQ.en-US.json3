    "dDurationMs": 6000,
    "segs": [ {
      "utf8": "make fast AI-powered decisions with confidence and \ntotal flexibility. Now with NetSuite AI Connector,  "
    } ]
  }, {
    "tStartMs": 1711760,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "you can use your favorite AI to connect to your \nactual business data and ask every question you’ve  "
    } ]
  }, {
    "tStartMs": 1716800,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "ever dreamed of - from key customers and cash flow \nto inventory trends and accounting projections,  "
    } ]
  }, {
    "tStartMs": 1721920,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "plus it’ll automate all your tiresome manual \nprocesses. Let’s see your competition do THAT.  "
    } ]
  }, {
    "tStartMs": 1726960,
    "dDurationMs": 5440,
    "segs": [ {
      "utf8": "NetSuite isn’t another ChatGPT wrapper, it’s AI \nbuilt into the system that runs your business.   \n "
    } ]
