    "dDurationMs": 6080,
    "segs": [ {
      "utf8": "43,000 businesses. NetSuite is a unified suite \nthat brings your financials, inventory, commerce,  "
    } ]
  }, {
    "tStartMs": 1690400,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "HR, and CRM into a single source of truth. Even \ngreat instincts only get better with data. By  "
    } ]
  }, {
    "tStartMs": 1696000,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "connecting all the data in NetSuite, your AI \ngets smarter. It doesn’t just guess - it knows.  "
    } ]
  }, {
    "tStartMs": 1700880,
    "dDurationMs": 4880,
    "segs": [ {
      "utf8": "NetSuite intelligently automates routine tasks \nso you can deliver real value, cut costs and  "
    } ]
  }, {
