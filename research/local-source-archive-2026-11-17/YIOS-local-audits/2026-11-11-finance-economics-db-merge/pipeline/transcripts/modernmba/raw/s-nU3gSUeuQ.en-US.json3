    "tStartMs": 1732400,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "Our goal is to grow to seven-figures and \nonce Modern MBA reaches that milestone,  "
    } ]
  }, {
    "tStartMs": 1736960,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "we plan to adopt Netsuite. We sit on \na mountain of data but production is  "
    } ]
  }, {
    "tStartMs": 1740880,
    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "so intense that no one has the bandwidth \nto analyze the business. We’re constantly  "
    } ]
  }, {
    "tStartMs": 1744960,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "balancing creativity with economics, but it’s \nhard to derive without pulling ourselves away  "
    } ]
  }, {
