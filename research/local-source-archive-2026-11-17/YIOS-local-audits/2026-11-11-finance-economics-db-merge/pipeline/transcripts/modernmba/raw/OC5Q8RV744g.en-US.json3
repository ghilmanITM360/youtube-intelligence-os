  }, {
    "tStartMs": 1712836,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "Both startups had benefited\nfrom underpaying their workers."
    } ]
  }, {
    "tStartMs": 1715505,
    "dDurationMs": 3337,
    "segs": [ {
      "utf8": "Their leaders never imagined that\nthe creator economy would grow to a point"
    } ]
  }, {
    "tStartMs": 1718842,
    "dDurationMs": 3420,
    "segs": [ {
      "utf8": "where individuals could earn more,\ndoing the same work by themselves,"
