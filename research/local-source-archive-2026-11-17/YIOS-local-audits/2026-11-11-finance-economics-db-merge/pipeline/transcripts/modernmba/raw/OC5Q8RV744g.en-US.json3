  }, {
    "tStartMs": 1725056,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "To get ahead of both attrition\nand expenses,"
    } ]
  }, {
    "tStartMs": 1727100,
    "dDurationMs": 2544,
    "segs": [ {
      "utf8": "BuzzFeed has tried to outsource production\nby operating"
