  }, {
    "tStartMs": 1554219,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "history had branded itself\nas a reporter of"
    } ]
  }, {
    "tStartMs": 1556221,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "trends in fashion, sneaker, food,"
    } ]
  }, {
    "tStartMs": 1558515,
    "dDurationMs": 1626,
    "segs": [ {
      "utf8": "music, sports, and culture."
