  }, {
    "tStartMs": 1601349,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "monetization to keep the lights on."
    } ]
  }, {
    "tStartMs": 1603351,
    "dDurationMs": 2753,
    "segs": [ {
      "utf8": "The only option to maximizing revenue\nunder this business"
