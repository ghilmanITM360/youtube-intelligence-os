    "tStartMs": 1588920,
    "dDurationMs": 2169,
    "segs": [ {
      "utf8": "Yet the reality is that since there's\nno upfront"
    } ]
  }, {
    "tStartMs": 1591089,
    "dDurationMs": 1168,
    "segs": [ {
      "utf8": "charge for access,"
    } ]
  }, {
    "tStartMs": 1592257,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "monetization is still fundamentally limited to"
