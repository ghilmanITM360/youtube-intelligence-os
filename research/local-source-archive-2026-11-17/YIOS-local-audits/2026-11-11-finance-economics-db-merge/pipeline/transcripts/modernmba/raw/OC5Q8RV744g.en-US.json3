  }, {
    "tStartMs": 1633256,
    "dDurationMs": 1668,
    "segs": [ {
      "utf8": "BuzzFeed still posted an operating"
    } ]
  }, {
    "tStartMs": 1634924,
    "dDurationMs": 2211,
    "segs": [ {
      "utf8": "loss in 2021, despite enjoying"
