    "segs": [ {
      "utf8": "brands"
    } ]
  }, {
    "tStartMs": 1669125,
    "dDurationMs": 4547,
    "segs": [ {
      "utf8": "in BuzzFeed, Huffington Post, Tasty\nand Hot Ones to make the most in a weak"
