    "dDurationMs": 3587,
    "segs": [ {
      "utf8": "under the newfound understanding that some\neyeballs were better than none at all."
    } ]
  }, {
    "tStartMs": 1341381,
    "dDurationMs": 3629,
    "segs": [ {
      "utf8": "Legacy publishers began shifting their content\nto YouTube, adapting their shows from the"
