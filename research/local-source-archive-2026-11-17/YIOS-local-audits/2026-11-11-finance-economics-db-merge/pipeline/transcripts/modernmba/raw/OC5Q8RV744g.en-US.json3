    "dDurationMs": 3045,
    "segs": [ {
      "utf8": "His latest strategy is to get BuzzFeed\nout of publishing entirely,"
    } ]
  }, {
    "tStartMs": 1817524,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "and he plans to do that\nby launching a new experimental"
    } ]
  }, {
    "tStartMs": 1820193,
    "dDurationMs": 2836,
    "segs": [ {
      "utf8": "social media platform\nby the name of BuzzFeed Island."
    } ]
  }, {
    "tStartMs": 1823029,
    "dDurationMs": 2961,
    "segs": [ {
      "utf8": "And while nothing has been revealed,\nthis time he's making."
    } ]
  }, {
    "tStartMs": 1825990,
    "dDurationMs": 1794,
    "segs": [ {
      "utf8": "sure to charge a subscription."
    } ]
  }, {
    "tStartMs": 1827784,
    "dDurationMs": 792,
    "segs": [ {
      "utf8": "When we look at the rest"
    } ]
  }, {
    "tStartMs": 1828576,
    "dDurationMs": 3128,
    "segs": [ {
      "utf8": "of the digital media landscape,\nthe best is really Business Insider."
    } ]
  }, {
    "tStartMs": 1831788,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "Business Insider is owned by the German"
    } ]
  }, {
    "tStartMs": 1833665,
    "dDurationMs": 2043,
    "segs": [ {
      "utf8": "media conglomerate, Axel Springer."
    } ]
  }, {
    "tStartMs": 1835708,
    "dDurationMs": 3712,
    "segs": [ {
      "utf8": "Business Insider has interestingly taken\ndifferent measures to combat against many"
    } ]
  }, {
    "tStartMs": 1839420,
    "dDurationMs": 1001,
    "segs": [ {
      "utf8": "of these paradigm shifts."
    } ]
  }, {
    "tStartMs": 1840421,
    "dDurationMs": 3129,
    "segs": [ {
      "utf8": "For one, they appear to no longer\nallow staffers to be in videos."
    } ]
  }, {
    "tStartMs": 1843591,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "The only people that seem to get"
    } ]
  }, {
    "tStartMs": 1844717,
    "dDurationMs": 2545,
    "segs": [ {
      "utf8": "featured in front of the camera\nare the one-off subject matter"
    } ]
  }, {
    "tStartMs": 1847262,
    "dDurationMs": 2419,
    "segs": [ {
      "utf8": "experts, thereby throttling\nthe issues of talent"
    } ]
  }, {
    "tStartMs": 1849681,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "retention and para-social relationships\nthat plagued BuzzFeed."
    } ]
  }, {
    "tStartMs": 1853017,
    "dDurationMs": 2336,
    "segs": [ {
      "utf8": "While it took BuzzFeed\nuntil 2024 to"
    } ]
  }, {
    "tStartMs": 1855353,
    "dDurationMs": 1543,
    "segs": [ {
      "utf8": "recognize that you just have to charge"
    } ]
  }, {
    "tStartMs": 1856896,
    "dDurationMs": 3545,
    "segs": [ {
      "utf8": "subscriptions to survive at scale,\nas a publisher, Insider"
    } ]
  }, {
    "tStartMs": 1860441,
    "dDurationMs": 3295,
    "segs": [ {
      "utf8": "was able to recognize the realities\n5 years earlier by launching their"
    } ]
  }, {
    "tStartMs": 1863736,
    "dDurationMs": 2044,
    "segs": [ {
      "utf8": "own subscriptions in 2017."
    } ]
  }, {
    "tStartMs": 1865780,
    "dDurationMs": 1043,
    "segs": [ {
      "utf8": "But in the brief time"
    } ]
  }, {
    "tStartMs": 1866823,
    "dDurationMs": 584,
    "segs": [ {
      "utf8": "that Axel."
    } ]
  }, {
    "tStartMs": 1867407,
    "dDurationMs": 3920,
    "segs": [ {
      "utf8": "Springer was public, they still reported\noverall declining profits and margins."
    } ]
  }, {
    "tStartMs": 1871327,
    "dDurationMs": 1460,
    "segs": [ {
      "utf8": "And Business Insider before its"
    } ]
  }, {
    "tStartMs": 1872787,
    "dDurationMs": 3087,
    "segs": [ {
      "utf8": "own acquisition in 2015,\nhad a net loss of 11"
    } ]
  }, {
    "tStartMs": 1875874,
    "dDurationMs": 1292,
    "segs": [ {
      "utf8": "million euros."
    } ]
  }, {
    "tStartMs": 1877166,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "Arena Group, which is the publisher behind\nMen's Journal and The Street, has also"
    } ]
  }, {
    "tStartMs": 1880628,
    "dDurationMs": 2002,
    "segs": [ {
      "utf8": "declared significant operating losses."
    } ]
  }, {
    "tStartMs": 1882630,
    "dDurationMs": 3003,
    "segs": [ {
      "utf8": "The company was fast\napproaching bankruptcy in 2024"
    } ]
  }, {
    "tStartMs": 1885633,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "and even had to give up its license\nto publish Sports Illustrated."
    } ]
  }, {
    "tStartMs": 1888553,
    "dDurationMs": 3086,
    "segs": [ {
      "utf8": "As of today, the company is on life\nsupport thanks to a cash infusion"
    } ]
  }, {
    "tStartMs": 1891639,
    "dDurationMs": 2127,
    "segs": [ {
      "utf8": "from the founder of Five Hour Energy."
    } ]
  }, {
    "tStartMs": 1893766,
    "dDurationMs": 1335,
    "segs": [ {
      "utf8": "And then there's Ziff Davis,"
    } ]
  }, {
    "tStartMs": 1895101,
    "dDurationMs": 876,
    "segs": [ {
      "utf8": "the corporation"
    } ]
  }, {
    "tStartMs": 1895977,
    "dDurationMs": 3462,
    "segs": [ {
      "utf8": "That owns PC Mag, IGN, Mashable, and CNET."
    } ]
  }, {
    "tStartMs": 1899480,
    "dDurationMs": 2128,
    "segs": [ {
      "utf8": "They run these publications\nlike private equity,"
    } ]
  }, {
    "tStartMs": 1901608,
    "dDurationMs": 1960,
    "segs": [ {
      "utf8": "where every cost is\ntrimmed down to the bone,"
    } ]
  }, {
    "tStartMs": 1903568,
    "dDurationMs": 1793,
    "segs": [ {
      "utf8": "profit is the only consideration,"
    } ]
  }, {
    "tStartMs": 1905361,
    "dDurationMs": 2294,
    "segs": [ {
      "utf8": "and writers are treated\nas easily replaceable"
    } ]
  }, {
    "tStartMs": 1907655,
    "dDurationMs": 751,
    "segs": [ {
      "utf8": "commodities."
    } ]
  }, {
    "tStartMs": 1908406,
    "dDurationMs": 2669,
    "segs": [ {
      "utf8": "But even with that approach,\nthe operating margins for their"
    } ]
  }, {
    "tStartMs": 1911075,
    "dDurationMs": 1126,
    "segs": [ {
      "utf8": "digital media division."
    } ]
  }, {
    "tStartMs": 1912201,
    "dDurationMs": 1877,
    "segs": [ {
      "utf8": "have regressed year-after-year and remain"
    } ]
  }, {
    "tStartMs": 1914078,
    "dDurationMs": 2920,
    "segs": [ {
      "utf8": "just as volatile as the ad market that they depend on."
    } ]
  } ]
}
