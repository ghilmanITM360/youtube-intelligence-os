    "dDurationMs": 3503,
    "segs": [ {
      "utf8": "Google was more than happy to distribute\nthe content produced by these digital"
    } ]
  }, {
    "tStartMs": 1257714,
    "dDurationMs": 2461,
    "segs": [ {
      "utf8": "media startups, which had dramatically\nless risk of"
