{
  "wireMagic": "pb3",
  "pens": [ {
  
  } ],
  "wsWinStyles": [ {
  
  } ],
  "wpWinPositions": [ {
  
  } ],
  "events": [ {
    "tStartMs": 266,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "This is Norway, the land of fjords,\nlakes and wealth taxes."
    } ]
  }, {
    "tStartMs": 3866,
    "dDurationMs": 1500,
    "segs": [ {
      "utf8": " That's right."
    } ]
  }, {
    "tStartMs": 5366,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Five years ago, Norway's center\nleft government raised the wealth"
    } ]
  }, {
    "tStartMs": 8566,
    "dDurationMs": 4334,
    "segs": [ {
      "utf8": "tax from 0.85% to roughly 1.1%."
    } ]
  }, {
    "tStartMs": 12900,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "And soon after, the world was treated\nto headlines like this,"
    } ]
  }, {
    "tStartMs": 17366,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "more than 30 Norwegian billionaires left\nafter a wealth tax hike."
    } ]
  }, {
    "tStartMs": 22800,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "The failure of Norway's wealth tax hike."
    } ]
  }, {
    "tStartMs": 26400,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "It's a warning."
    } ]
  }, {
    "tStartMs": 27866,
    "dDurationMs": 3434,
    "segs": [ {
      "utf8": "What's behind Norway's wealth tax exodus?"
    } ]
  }, {
    "tStartMs": 31600,
    "dDurationMs": 5600,
    "segs": [ {
      "utf8": "And yeah, something clearly happened\nin 2022 that caused"
    } ]
  }, {
    "tStartMs": 37200,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "especially many wealthy business owners\nto leave"
    } ]
  }, {
    "tStartMs": 40533,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "Norway in three different waves."
    } ]
  }, {
    "tStartMs": 44166,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "But this type of coverage, it often raised\nmore questions for me than it answered."
    } ]
  }, {
    "tStartMs": 48800,
    "dDurationMs": 2700,
    "segs": [ {
      "utf8": "First, 30 billionaires left?"
    } ]
  }, {
    "tStartMs": 51500,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "Okay, Norway isn't a populous country,\nbut how big was that"
    } ]
  }, {
    "tStartMs": 55933,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "exodus really compared to the billionaires\nand millionaires that stayed behind?"
    } ]
  }, {
    "tStartMs": 61233,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "Did so many people leave that\nit made the wealth tax ineffective,"
    } ]
  }, {
    "tStartMs": 65566,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "or that it hurt the Norwegian economy?"
    } ]
  }, {
    "tStartMs": 68366,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "But perhaps more importantly,\nwhy did a tiny tax"
    } ]
  }, {
    "tStartMs": 71833,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "tweak of just one quarter of a percent"
    } ]
  }, {
    "tStartMs": 75033,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "trigger a sudden panic\nwhen Norway has had a wealth tax"
    } ]
  }, {
    "tStartMs": 79200,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "for decades, and Switzerland,\nwhere most of them went,"
    } ]
  }, {
    "tStartMs": 83266,
    "dDurationMs": 3534,
    "segs": [ {
      "utf8": "also had a wealth tax,\nit all just didn't add up."
    } ]
  }, {
    "tStartMs": 86800,
    "dDurationMs": 2000,
    "segs": [ {
      "utf8": "So we had to go beyond the headlines."
    } ]
  }, {
    "tStartMs": 88800,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "We spoke to Norwegian tax experts\nand dug into the data ourselves,"
    } ]
  }, {
    "tStartMs": 93133,
    "dDurationMs": 4767,
    "segs": [ {
      "utf8": "all to answer why are so many millionaires\nleaving Norway?"
    } ]
  }, {
    "tStartMs": 98233,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "That is the main question we discussed\nin our team meeting last week."
    } ]
  }, {
    "tStartMs": 102400,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "Now, normally someone has to take notes,\ntrack action"
    } ]
  }, {
    "tStartMs": 105600,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "items and write a summary afterwards."
    } ]
  }, {
    "tStartMs": 108666,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "A time consuming task\nthat absolutely nobody likes."
    } ]
  }, {
    "tStartMs": 112200,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "Luckily, this is where our advertising\nsponsor PLAUD comes in."
    } ]
  }, {
    "tStartMs": 116600,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "This sleek little device\ndoesn't just record audio."
    } ]
  }, {
    "tStartMs": 120600,
    "dDurationMs": 2566,
    "segs": [ {
      "utf8": "Anyone can do that with a phone."
    } ]
  }, {
    "tStartMs": 123166,
    "dDurationMs": 934,
    "segs": [ {
      "utf8": "With PLAUD,"
    } ]
  }, {
    "tStartMs": 124100,
    "dDurationMs": 4200,
    "segs": [ {
      "utf8": "we were able to snap pictures of our\nwhiteboard drawings during the meeting."
    } ]
  }, {
    "tStartMs": 128600,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "Type out words on the fly\nand instantly mark key moments"
    } ]
  }, {
    "tStartMs": 132366,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "with a quick button press."
    } ]
  }, {
    "tStartMs": 134533,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "It's really an all-in-one, note-taking solution."
    } ]
  }, {
    "tStartMs": 137633,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "What's more, using PLAUD's software,\nwe could completely customize"
    } ]
  }, {
    "tStartMs": 141666,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "the note-taking style\nto our exact preference and use it"
    } ]
  }, {
    "tStartMs": 145733,
    "dDurationMs": 5133,
    "segs": [ {
      "utf8": "to instantly surface actionable items\nand insights from previous meetings."
    } ]
  }, {
    "tStartMs": 151266,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "And later we were able to go back\nand ask it questions"
    } ]
  }, {
    "tStartMs": 154900,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "directly, reducing friction even more."
    } ]
  }, {
    "tStartMs": 158400,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "But of course, since we discuss\nsensitive business information, privacy"
    } ]
  }, {
    "tStartMs": 162133,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "was one of our biggest concerns."
    } ]
  }, {
    "tStartMs": 164100,
    "dDurationMs": 3866,
    "segs": [ {
      "utf8": "And on that PLAUD is fully compliant\nwith the strictest data privacy"
    } ]
  }, {
    "tStartMs": 167966,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "regulations from HIPAA in the US, too."
    } ]
  }, {
    "tStartMs": 172700,
    "dDurationMs": 5300,
    "segs": [ {
      "utf8": "Crucially for us, the famous strict\nEuropean and GDPR regulations."
    } ]
  }, {
    "tStartMs": 178233,
    "dDurationMs": 2900,
    "segs": [ {
      "utf8": "So if you're tired\nof losing track of action items,"
    } ]
  }, {
    "tStartMs": 181133,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "spending hours writing meeting notes\nor trying to remember what was said"
    } ]
  }, {
    "tStartMs": 185466,
    "dDurationMs": 4234,
    "segs": [ {
      "utf8": "three meetings ago, check out PLAUD\nusing the link in the description below,"
    } ]
  }, {
    "tStartMs": 189900,
    "dDurationMs": 2933,
    "segs": [ {
      "utf8": "where you will get an exclusive 15%"
    } ]
  }, {
    "tStartMs": 192833,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "discount using code MM15."
    } ]
  }, {
    "tStartMs": 196333,
    "dDurationMs": 6127,
    "segs": [ {
      "utf8": "That is right after we get back to what really happened in Norway in 2022?"
    } ]
  }, {
    "tStartMs": 202527,
    "dDurationMs": 2899,
    "segs": [ {
      "utf8": "First, let's start with the facts."
    } ]
  }, {
    "tStartMs": 205426,
    "dDurationMs": 4206,
    "segs": [ {
      "utf8": "This graph shows business owner\ntax refugees identified"
    } ]
  }, {
    "tStartMs": 209632,
    "dDurationMs": 4333,
    "segs": [ {
      "utf8": "by independent journalists\nat the Norwegian Broadcasting Corporation."
    } ]
  }, {
    "tStartMs": 213965,
    "dDurationMs": 3743,
    "segs": [ {
      "utf8": "Sure, while this increase in millionaire"
    } ]
  }, {
    "tStartMs": 217708,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "business owners leaving after 2022"
    } ]
  }, {
    "tStartMs": 221008,
    "dDurationMs": 4658,
    "segs": [ {
      "utf8": "and then a renewed spike in\n2025 is not statistically watertight proof"
    } ]
  }, {
    "tStartMs": 225666,
    "dDurationMs": 3181,
    "segs": [ {
      "utf8": "that the wealth tax caused the exodus."
    } ]
  }, {
    "tStartMs": 228847,
    "dDurationMs": 4466,
    "segs": [ {
      "utf8": "But it clearly shows an unusual number\nof wealthy business owners"
    } ]
  }, {
    "tStartMs": 233313,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "left right after this hike."
    } ]
  }, {
    "tStartMs": 236510,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But 50 millionaires leaving in a year?"
    } ]
  }, {
    "tStartMs": 240000,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Is that actually a lot?"
    } ]
  }, {
    "tStartMs": 241006,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "And are these potentially big contributors\nto the wealth tax?"
    } ]
  }, {
    "tStartMs": 245758,
    "dDurationMs": 2733,
    "segs": [ {
      "utf8": "That's exactly\nwhat Norwegian journalist wanted to know."
    } ]
  }, {
    "tStartMs": 248491,
    "dDurationMs": 4067,
    "segs": [ {
      "utf8": "And they found that\nif we look at the total amount of wealth"
    } ]
  }, {
    "tStartMs": 252673,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "that can be taxed and how much belonged\nto the people that left."
    } ]
  }, {
    "tStartMs": 257352,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "We can see that it's just about 2%."
    } ]
  }, {
    "tStartMs": 261588,
    "dDurationMs": 2333,
    "segs": [ {
      "utf8": "That makes for less\ninteresting headlines, doesn't it?"
    } ]
  }, {
    "tStartMs": 264047,
    "dDurationMs": 3867,
    "segs": [ {
      "utf8": "2% of millionaire wealth left after Norway\nhiked its wealth tax"
    } ]
  }, {
    "tStartMs": 267914,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "by 0.25%."
    } ]
  }, {
    "tStartMs": 271039,
    "dDurationMs": 2300,
    "segs": [ {
      "utf8": "As we can see here,\nthat was not enough people"
    } ]
  }, {
    "tStartMs": 273486,
    "dDurationMs": 4933,
    "segs": [ {
      "utf8": "leaving to offset the increased revenue\nfrom the wealth tax."
    } ]
  }, {
    "tStartMs": 278419,
    "dDurationMs": 1305,
    "segs": [ {
      "utf8": "After this hike."
    } ]
  }, {
    "tStartMs": 279724,
    "dDurationMs": 3366,
    "segs": [ {
      "utf8": "So I don't think that this headline\nthat called Norway's"
    } ]
  }, {
    "tStartMs": 283090,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "wealth tax a failure makes much sense."
    } ]
  }, {
    "tStartMs": 287163,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "So instead,\nwe should go with this headline,"
    } ]
  }, {
    "tStartMs": 290163,
    "dDurationMs": 3467,
    "segs": [ {
      "utf8": "Norway's Lessons\nfor Europe on wealth taxes."
    } ]
  }, {
    "tStartMs": 293630,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Just let some millionaires go."
    } ]
  }, {
    "tStartMs": 296630,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "No, I don't think so\neither, because some things"
    } ]
  }, {
    "tStartMs": 299430,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "were still not adding up for me\nin this entire saga."
    } ]
  }, {
    "tStartMs": 304192,
    "dDurationMs": 2734,
    "segs": [ {
      "utf8": "First of all, why were most Norwegian\nmillionaire business"
    } ]
  }, {
    "tStartMs": 307043,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "owners heading to Switzerland,\nwhere they also have a wealth tax"
    } ]
  }, {
    "tStartMs": 310800,
    "dDurationMs": 5500,
    "segs": [ {
      "utf8": "which crucially brings in more revenue\nthan in Norway?"
    } ]
  }, {
    "tStartMs": 316765,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "Second of all, look at this wealth tax"
    } ]
  }, {
    "tStartMs": 319393,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "revenue as a share of total government\nrevenue."
    } ]
  }, {
    "tStartMs": 322619,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "It's almost nothing."
    } ]
  }, {
    "tStartMs": 325787,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And crucially, lower than Switzerland."
    } ]
  }, {
    "tStartMs": 328971,
    "dDurationMs": 3433,
    "segs": [ {
      "utf8": "And sure, of course in Switzerland\nwealth taxes are different per region."
    } ]
  }, {
    "tStartMs": 332404,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "And so perhaps Norwegian millionaires\nwere just moving to regions with"
    } ]
  }, {
    "tStartMs": 336391,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "very low wealth taxes."
    } ]
  }, {
    "tStartMs": 338219,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "But if these tiny wealth\ntaxes are so crucial to the wealthy,"
    } ]
  }, {
    "tStartMs": 342666,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "then why do we not see massive migration\ninside Switzerland itself,"
    } ]
  }, {
    "tStartMs": 347233,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "meaning that there would be no wealth\ntax revenue at all,"
    } ]
  }, {
    "tStartMs": 350857,
    "dDurationMs": 1900,
    "segs": [ {
      "utf8": "but perhaps even more puzzlingly."
    } ]
  }, {
    "tStartMs": 352757,
    "dDurationMs": 3133,
    "segs": [ {
      "utf8": "Why are so many business owners\nleaving Norway?"
    } ]
  }, {
    "tStartMs": 356107,
    "dDurationMs": 3067,
    "segs": [ {
      "utf8": "Because when I looked into how"
    } ]
  }, {
    "tStartMs": 359174,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "Norwegian Wealth taxes\nspecifically worked, I found that"
    } ]
  }, {
    "tStartMs": 363107,
    "dDurationMs": 5467,
    "segs": [ {
      "utf8": "they heavily favored business owners over,\nfor example, landlords."
    } ]
  }, {
    "tStartMs": 368832,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "You see, if in Norway you are a landlord\nor you have a lot of money in the bank,"
    } ]
  }, {
    "tStartMs": 373892,
    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "or you own a lot of stocks\nor even if you own a lot of fancy cars,"
    } ]
  }, {
    "tStartMs": 378292,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "then you will pay a wealth tax\nof about 1% over"
    } ]
  }, {
    "tStartMs": 381292,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "all of your assets,\nminus all of your debts."
    } ]
  }, {
    "tStartMs": 385574,
    "dDurationMs": 1634,
    "segs": [ {
      "utf8": "But there's a catch."
    } ]
  }, {
    "tStartMs": 387327,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Only Norwegian residents\nwith a worth above"
    } ]
  }, {
    "tStartMs": 390562,
    "dDurationMs": 4634,
    "segs": [ {
      "utf8": "€173,000 have to pay a wealth tax,"
    } ]
  }, {
    "tStartMs": 395459,
    "dDurationMs": 5267,
    "segs": [ {
      "utf8": "and there is a huge discount for the home\nthat you actually live in."
    } ]
  }, {
    "tStartMs": 401163,
    "dDurationMs": 6333,
    "segs": [ {
      "utf8": "Only the wealthiest 12% of the population, therefore, in Norway,\nactually pay the wealth tax."
    } ]
  }, {
    "tStartMs": 407717,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "But if you are a small business\nowner like me, you are lucky"
    } ]
  }, {
    "tStartMs": 411755,
    "dDurationMs": 4298,
    "segs": [ {
      "utf8": "because you will pay a far\nlower wealth tax than a landlord"
    } ]
  }, {
    "tStartMs": 416147,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "or someone who just has a lot of money\nsitting in the bank."
    } ]
  }, {
    "tStartMs": 419288,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "You see, because private businesses\nand especially startups are very hard"
    } ]
  }, {
    "tStartMs": 423306,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "to properly value if nobody is buying\nor selling their shares."
    } ]
  }, {
    "tStartMs": 426554,
    "dDurationMs": 4567,
    "segs": [ {
      "utf8": "Norway's government has said that, look,\nwe value private businesses"
    } ]
  }, {
    "tStartMs": 431266,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "simply by looking at hard\nassets like bank accounts"
    } ]
  }, {
    "tStartMs": 436160,
    "dDurationMs": 4467,
    "segs": [ {
      "utf8": "or buildings,\nand then we subtract depths from those."
    } ]
  }, {
    "tStartMs": 440627,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "But we do not look at soft"
    } ]
  }, {
    "tStartMs": 443788,
    "dDurationMs": 4234,
    "segs": [ {
      "utf8": "assets like intellectual property,\nbrand value, customer loyalty"
    } ]
  }, {
    "tStartMs": 448022,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "or proprietary technology,\nor even future potential."
    } ]
  }, {
    "tStartMs": 452544,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "This is absolutely crucial\nbecause some economists have estimated"
    } ]
  }, {
    "tStartMs": 456378,
    "dDurationMs": 3933,
    "segs": [ {
      "utf8": "that soft, intangible assets\nare so important that private firms"
    } ]
  }, {
    "tStartMs": 460311,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "in Norway end up valued at 70 to 90% below\ntheir true market value."
    } ]
  }, {
    "tStartMs": 466265,
    "dDurationMs": 1667,
    "segs": [ {
      "utf8": "For tax purposes."
    } ]
  }, {
    "tStartMs": 468043,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "This could explain why Norway, despite\nhaving a wealth tax"
    } ]
  }, {
    "tStartMs": 472867,
    "dDurationMs": 3654,
    "segs": [ {
      "utf8": "for well over a hundred years,\nactually has a lot of billionaires"
    } ]
  }, {
    "tStartMs": 476521,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "per person, almost as many as the US."
    } ]
  }, {
    "tStartMs": 480302,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But it does\nleave our main question and answered"
    } ]
  }, {
    "tStartMs": 483414,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "why did so many millionaire business\nowners leave Norway after 2022?"
    } ]
  }, {
    "tStartMs": 488081,
    "dDurationMs": 3234,
    "segs": [ {
      "utf8": "People like fishing magnate Kjell Rocha"
    } ]
  }, {
    "tStartMs": 491315,
    "dDurationMs": 4733,
    "segs": [ {
      "utf8": "or crypto entrepreneur Fredrik Hagai,\nwho told the Financial Times"
    } ]
  }, {
    "tStartMs": 496048,
    "dDurationMs": 6167,
    "segs": [ {
      "utf8": "that I had to choose, am I based in Norway\nor do I want this company to succeed?"
    } ]
  }, {
    "tStartMs": 502215,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "It's not about not wanting to pay\ntaxes, it's"
    } ]
  }, {
    "tStartMs": 506063,
    "dDurationMs": 4566,
    "segs": [ {
      "utf8": "about paying taxes on money\nthat I don't actually have."
    } ]
  }, {
    "tStartMs": 511401,
    "dDurationMs": 3700,
    "segs": [ {
      "utf8": "But strangely enough, it looks like\nit was not actually the wealth tax"
    } ]
  }, {
    "tStartMs": 515249,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "hike itself that triggered the exodus, but"
    } ]
  }, {
    "tStartMs": 518416,
    "dDurationMs": 4833,
    "segs": [ {
      "utf8": "rather the exit tax\nthat Norway imposed to ironically try"
    } ]
  }, {
    "tStartMs": 523249,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "to keep entrepreneurs\nfrom fleeing the wealth tax hike."
    } ]
  }, {
    "tStartMs": 527217,
    "dDurationMs": 6100,
    "segs": [ {
      "utf8": "You see, Norway's wealth tax does not tax\nall wealth inside the country,"
    } ]
  }, {
    "tStartMs": 533317,
    "dDurationMs": 5433,
    "segs": [ {
      "utf8": "but rather the wealth of all people\nwho live inside the country."
    } ]
  }, {
    "tStartMs": 538947,
    "dDurationMs": 5700,
    "segs": [ {
      "utf8": "So in theory, you could always dodge\nNorway's wealth tax by simply"
    } ]
  }, {
    "tStartMs": 544647,
    "dDurationMs": 1334,
    "segs": [ {
      "utf8": "moving abroad."
    } ]
  }, {
    "tStartMs": 546076,
    "dDurationMs": 3666,
    "segs": [ {
      "utf8": "And this is why Norway\nhad an exit tax for a long time."
    } ]
  }, {
    "tStartMs": 549742,
    "dDurationMs": 3367,
    "segs": [ {
      "utf8": "If you want to change your tax residency,\nthen you face"
    } ]
  }, {
    "tStartMs": 553109,
    "dDurationMs": 3967,
    "segs": [ {
      "utf8": "an exit tax of about 38%."
    } ]
  }, {
    "tStartMs": 557663,
    "dDurationMs": 4500,
    "segs": [ {
      "utf8": "And this comes in the form of a capital\ngains tax on all of your investments"
    } ]
  }, {
    "tStartMs": 562163,
    "dDurationMs": 3833,
    "segs": [ {
      "utf8": "before you leave,\neven if they have not been profitable yet."
    } ]
  }, {
    "tStartMs": 566387,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "This is crucial for business owners\nbecause their company could be, on paper,"
    } ]
  }, {
    "tStartMs": 572103,
    "dDurationMs": 4033,
    "segs": [ {
      "utf8": "worth billions,\neven if it's not making any profits."
    } ]
  }, {
    "tStartMs": 576136,
    "dDurationMs": 5100,
    "segs": [ {
      "utf8": "And crucially, here, the Norwegian state\ncalculates the value of a private company"
    } ]
  }, {
    "tStartMs": 581354,
    "dDurationMs": 4433,
    "segs": [ {
      "utf8": "differently for the capital gains tax\nthan for the wealth tax."
    } ]
  }, {
    "tStartMs": 586047,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "That is, if you sold any shares, do,\nfor example, venture capital investors,"
    } ]
  }, {
    "tStartMs": 590563,
    "dDurationMs": 4000,
    "segs": [ {
      "utf8": "the government would say,\nnow we know what your company is worth."
    } ]
  }, {
    "tStartMs": 594787,
    "dDurationMs": 4666,
    "segs": [ {
      "utf8": "For example, if you have a startup\nwhere your shares were valued by investors"
    } ]
  }, {
    "tStartMs": 600000,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "at 10 million last year,\nyou immediately owe"
    } ]
  }, {
    "tStartMs": 603900,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "3.7 million just for leaving."
    } ]
  }, {
    "tStartMs": 606900,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "Realizing this is when things\nfinally started falling into place for me."
    } ]
  }, {
    "tStartMs": 610667,
    "dDurationMs": 4133,
    "segs": [ {
      "utf8": "Norway's wealth tax was famously light\non entrepreneurs and startup founders."
    } ]
  }, {
    "tStartMs": 614800,
    "dDurationMs": 2100,
    "segs": [ {
      "utf8": "But the capital gains exit tax?"
    } ]
  }, {
    "tStartMs": 616900,
    "dDurationMs": 2400,
    "segs": [ {
      "utf8": "Oh boy, that could cost people like Mr."
    } ]
  }, {
    "tStartMs": 619300,
    "dDurationMs": 2868,
    "segs": [ {
      "utf8": "Røkke and Haga millions."
    } ]
  }, {
    "tStartMs": 622168,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "But crucially, the exit tax had"
    } ]
  }, {
    "tStartMs": 625320,
    "dDurationMs": 3767,
    "segs": [ {
      "utf8": "before 2022 a massive loophole\nthat everyone knew about."
    } ]
  }, {
    "tStartMs": 629324,
    "dDurationMs": 2666,
    "segs": [ {
      "utf8": "If you left the country\nand did not sell your shares"
    } ]
  }, {
    "tStartMs": 631990,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "within five years, the tax obligations\nsimply vanished."
    } ]
  }, {
    "tStartMs": 636156,
    "dDurationMs": 4534,
    "segs": [ {
      "utf8": "So in anticipation of a millionaire exodus\nafter this small wealth tax hike,"
    } ]
  }, {
    "tStartMs": 640901,
    "dDurationMs": 3834,
    "segs": [ {
      "utf8": "the government\nwanted to close that loophole."
    } ]
  }, {
    "tStartMs": 645250,
    "dDurationMs": 2600,
    "segs": [ {
      "utf8": "And this meant that if people like Mr."
    } ]
  }, {
    "tStartMs": 647850,
    "dDurationMs": 3466,
    "segs": [ {
      "utf8": "Røkke or Haga\nwanted to avoid paying the exit tax,"
    } ]
  }, {
    "tStartMs": 651740,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "they had to move quickly\nand leave the country"
    } ]
  }, {
    "tStartMs": 655373,
    "dDurationMs": 3500,
    "segs": [ {
      "utf8": "in 2022,\navoiding the capital gains exit tax,"
    } ]
  }, {
    "tStartMs": 659038,
    "dDurationMs": 5292,
    "segs": [ {
      "utf8": "not avoiding the wealth\ntax itself saved them millions."
    } ]
  }, {
    "tStartMs": 664514,
    "dDurationMs": 700,
    "segs": [ {
      "utf8": "Indeed, Mr."
    } ]
  }, {
    "tStartMs": 665214,
    "dDurationMs": 3167,
    "segs": [ {
      "utf8": "Hagga himself\nmentioned the capital gains"
    } ]
  }, {
    "tStartMs": 668381,
    "dDurationMs": 3575,
    "segs": [ {
      "utf8": "exit tax rather than the general wealth tax."
    } ]
  }, {
    "tStartMs": 672144,
    "dDurationMs": 2500,
    "segs": [ {
      "utf8": "In his blog on why he left Norway."
    } ]
  }, {
    "tStartMs": 674644,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "The exit tax cat and mouse game\ncan explain two subsequent spikes"
    } ]
  }, {
    "tStartMs": 679644,
    "dDurationMs": 4667,
    "segs": [ {
      "utf8": "in Millionaire migration, even after\nthe loophole was closed in 2022."
    } ]
  }, {
    "tStartMs": 684454,
    "dDurationMs": 5534,
    "segs": [ {
      "utf8": "First, throughout 2023 more entrepreneurs\nleft betting they could defer payment"
    } ]
  }, {
    "tStartMs": 690117,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "indefinitely\nas long as they did not sell their shares."
    } ]
  }, {
    "tStartMs": 693417,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "And then in 2024,\nthe government put a stop to that"
    } ]
  }, {
    "tStartMs": 696548,
    "dDurationMs": 3566,
    "segs": [ {
      "utf8": "through a 12 year payment gap,\neffective immediately."
    } ]
  }, {
    "tStartMs": 700308,
    "dDurationMs": 2533,
    "segs": [ {
      "utf8": "And now it didn't matter\nif you sold or not."
    } ]
  }, {
    "tStartMs": 702979,
    "dDurationMs": 4434,
    "segs": [ {
      "utf8": "Within 12 years of leaving Norway,\nyou had to pay the tax period."
    } ]
  }, {
    "tStartMs": 707530,
    "dDurationMs": 3033,
    "segs": [ {
      "utf8": "No exceptions,\nno extensions, no loopholes."
    } ]
  }, {
    "tStartMs": 710796,
    "dDurationMs": 4367,
    "segs": [ {
      "utf8": "This could have finally helped\nto stop the exodus because as you can see"
    } ]
  }, {
    "tStartMs": 715163,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "here, millionaire departures\ndropped to just 12 in 2024."
    } ]
  }, {
    "tStartMs": 719666,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "However, in 2025, we again\nsee a new spike,"
    } ]
  }, {
    "tStartMs": 723681,
    "dDurationMs": 3533,
    "segs": [ {
      "utf8": "which was apparently because the center\nleft party won the election again"
    } ]
  }, {
    "tStartMs": 727214,
    "dDurationMs": 3200,
    "segs": [ {
      "utf8": "and some entrepreneurs\nfeared further tightening"
    } ]
  }, {
    "tStartMs": 730414,
    "dDurationMs": 4533,
    "segs": [ {
      "utf8": "and especially further uncertainty\nabout increased exit taxes."
    } ]
  }, {
    "tStartMs": 735571,
    "dDurationMs": 3633,
    "segs": [ {
      "utf8": "So, to answer our main question,\nwhy were so many millionaires"
    } ]
  }, {
    "tStartMs": 739204,
    "dDurationMs": 767,
    "segs": [ {
      "utf8": "leaving Norway?"
    } ]
  }, {
    "tStartMs": 739971,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "I think the most plausible explanation\nis that it was not"
    } ]
  }, {
    "tStartMs": 743704,
    "dDurationMs": 3800,
    "segs": [ {
      "utf8": "the minuscule wealth tax\nhike that favors business owners,"
    } ]
  }, {
    "tStartMs": 747762,
    "dDurationMs": 3600,
    "segs": [ {
      "utf8": "but rather a massive 38% potential capital"
    } ]
  }, {
    "tStartMs": 751362,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "gains tax on unrealized shares."
    } ]
  }, {
    "tStartMs": 755523,
    "dDurationMs": 3059,
    "segs": [ {
      "utf8": "But given that we've seen\nthat even in response to that,"
    } ]
  }, {
    "tStartMs": 758582,
    "dDurationMs": 3667,
    "segs": [ {
      "utf8": "the total wealth\nthat left was actually not that much."
    } ]
  }, {
    "tStartMs": 762379,
    "dDurationMs": 2367,
    "segs": [ {
      "utf8": "Research\nso far on the effect of millionaire"
    } ]
  }, {
    "tStartMs": 764746,
    "dDurationMs": 5233,
    "segs": [ {
      "utf8": "migration has revealed that the effects\non Norway's economy have been very minor,"
    } ]
  }, {
    "tStartMs": 770270,
    "dDurationMs": 3333,
    "segs": [ {
      "utf8": "even though the businesses\nthat millionaire refugees left behind"
    } ]
  }, {
    "tStartMs": 773806,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "did suffer, potentially\nbecause they could be managed"
    } ]
  }, {
    "tStartMs": 776806,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "less effectively from Switzerland."
    } ]
  }, {
    "tStartMs": 779806,
    "dDurationMs": 4267,
    "segs": [ {
      "utf8": "Perhaps more interestingly,\nresearch on the wealth tax before 2022,"
    } ]
  }, {
    "tStartMs": 784073,
    "dDurationMs": 4734,
    "segs": [ {
      "utf8": "not the exit tax, has shown that people\nwho faced a higher wealth tax started"
    } ]
  }, {
    "tStartMs": 788807,
    "dDurationMs": 4700,
    "segs": [ {
      "utf8": "investing more in their businesses,\nwhich, as we've seen,"
    } ]
  }, {
    "tStartMs": 793507,
    "dDurationMs": 4366,
    "segs": [ {
      "utf8": "are taxed at a lower rate\nwithin the traditional wealth tax."
    } ]
  }, {
    "tStartMs": 798260,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "However, when it comes to the current exit\ntax that is now very strict,"
    } ]
  }, {
    "tStartMs": 801993,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "there are serious concerns\nthat this is hurting Norway's potential"
    } ]
  }, {
    "tStartMs": 805692,
    "dDurationMs": 5000,
    "segs": [ {
      "utf8": "as a startup hub compared to, for example,\nStockholm in Sweden."
    } ]
  }, {
    "tStartMs": 811026,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "You see, for young, ambitious\nentrepreneurs, it's pretty normal to start"
    } ]
  }, {
    "tStartMs": 814026,
    "dDurationMs": 5367,
    "segs": [ {
      "utf8": "a business in your home country first,\nbut then to scale it to London"
    } ]
  }, {
    "tStartMs": 819393,
    "dDurationMs": 4300,
    "segs": [ {
      "utf8": "or New York or San Francisco,\nwhere there are far more investors."
    } ]
  }, {
    "tStartMs": 823977,
    "dDurationMs": 3733,
    "segs": [ {
      "utf8": "However, with the current exit\ntax startup, founders may need to"
    } ]
  }, {
    "tStartMs": 827710,
    "dDurationMs": 3100,
    "segs": [ {
      "utf8": "then pay a massive tax bill\nto the Norwegian states"
    } ]
  }, {
    "tStartMs": 831139,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "if early investors valued the business\nhighly,"
    } ]
  }, {
    "tStartMs": 834801,
    "dDurationMs": 3567,
    "segs": [ {
      "utf8": "even if that value has not yet\nmaterialized."
    } ]
  }, {
    "tStartMs": 838741,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "Therefore,\nI think that the world can learn"
    } ]
  }, {
    "tStartMs": 840275,
    "dDurationMs": 3066,
    "segs": [ {
      "utf8": "three lessons from Norway\nwealth tax experience."
    } ]
  }, {
    "tStartMs": 843545,
    "dDurationMs": 3634,
    "segs": [ {
      "utf8": "Number one, tiny wealth taxes\nlike the one in Norway and Switzerland,"
    } ]
  }, {
    "tStartMs": 847179,
    "dDurationMs": 3766,
    "segs": [ {
      "utf8": "do not scare away many millionaires,\nbut also don't raise a lot of money"
    } ]
  }, {
    "tStartMs": 850945,
    "dDurationMs": 1534,
    "segs": [ {
      "utf8": "for the state."
    } ]
  }, {
    "tStartMs": 852479,
    "dDurationMs": 4166,
    "segs": [ {
      "utf8": "Lesson number two by taxing\nunproductive wealth like houses and bank"
    } ]
  }, {
    "tStartMs": 856645,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "accounts more than active businesses,\nyou can actually stimulate investments"
    } ]
  }, {
    "tStartMs": 861845,
    "dDurationMs": 2800,
    "segs": [ {
      "utf8": "in these businesses\nand therefore the economy."
    } ]
  }, {
    "tStartMs": 864860,
    "dDurationMs": 900,
    "segs": [ {
      "utf8": "Lesson number three."
    } ]
  }, {
    "tStartMs": 865760,
    "dDurationMs": 3300,
    "segs": [ {
      "utf8": "On the other hand you have to be\nquite careful with exit taxes."
    } ]
  }, {
    "tStartMs": 869060,
    "dDurationMs": 3900,
    "segs": [ {
      "utf8": "If these hit entrepreneurs far harder\nthan anyone else, you can expect"
    } ]
  }, {
    "tStartMs": 872960,
    "dDurationMs": 1967,
    "segs": [ {
      "utf8": "that a lot of them will leave."
    } ]
  }, {
    "tStartMs": 875133,
    "dDurationMs": 1466,
    "segs": [ {
      "utf8": "And perhaps even worse,"
    } ]
  }, {
    "tStartMs": 876599,
    "dDurationMs": 4167,
    "segs": [ {
      "utf8": "you can maybe discourage them\nfrom starting a business in your country."
    } ]
  }, {
    "tStartMs": 880766,
    "dDurationMs": 1400,
    "segs": [ {
      "utf8": "In the first place."
    } ]
  }, {
    "tStartMs": 882166,
    "dDurationMs": 2833,
    "segs": [ {
      "utf8": "But yeah, these are my takes.\nWhat do you think?"
    } ]
  }, {
    "tStartMs": 884999,
    "dDurationMs": 3000,
    "segs": [ {
      "utf8": "Did you find my analysis\nthat Norway's millionaire migration"
    } ]
  }, {
    "tStartMs": 887999,
    "dDurationMs": 3934,
    "segs": [ {
      "utf8": "was more about exit taxes\nthan about wealth taxes convincing?"
    } ]
  }, {
    "tStartMs": 892368,
    "dDurationMs": 3267,
    "segs": [ {
      "utf8": "Do you have high hopes for wealth taxes,\nor do you think that they are"
    } ]
  }, {
    "tStartMs": 895776,
    "dDurationMs": 1600,
    "segs": [ {
      "utf8": "slightly overrated?"
    } ]
  }, {
    "tStartMs": 897686,
    "dDurationMs": 2167,
    "segs": [ {
      "utf8": "Let me know in the comments below."
    } ]
  }, {
    "tStartMs": 900000,
    "dDurationMs": 867,
    "segs": [ {
      "utf8": "And don't"
    } ]
  }, {
    "tStartMs": 900867,
    "dDurationMs": 4066,
    "segs": [ {
      "utf8": "forget to check out our sponsor PLAUD\nusing the link in the description below."
    } ]
  }, {
    "tStartMs": 904955,
    "dDurationMs": 2066,
    "segs": [ {
      "utf8": "It really helps out the channel."
    } ]
  } ]
}
