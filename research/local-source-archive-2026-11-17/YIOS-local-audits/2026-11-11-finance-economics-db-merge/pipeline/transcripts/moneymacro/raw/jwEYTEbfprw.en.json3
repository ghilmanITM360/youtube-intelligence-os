  }, {
    "tStartMs": 544911,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "reef season. Another set of countries that could \nbe in serious serious trouble are those that rely  "
    } ]
  }, {
    "tStartMs": 551151,
    "dDurationMs": 10480,
    "segs": [ {
      "utf8": "heavily on food imports where for example Egypt \nis famously very much reliant on wheat imports and  "
    } ]
  }, {
    "tStartMs": 561631,
    "dDurationMs": 6640,
    "segs": [ {
      "utf8": "already also Sudan which already has a massive \nfood insecurity crisis. Other countries that  "
    } ]
  }, {
    "tStartMs": 568271,
    "dDurationMs": 7520,
    "segs": [ {
      "utf8": "are very vulnerable are fertilizer importers such \nas for example the East African nations and also  "
    } ]
  }, {
    "tStartMs": 575791,
    "dDurationMs": 7280,
    "segs": [ {
