    "dDurationMs": 7360,
    "segs": [ {
      "utf8": "highly reliant on fertilizer imports and if prices \nin Brazil are driven up then the cost of meat,  "
    } ]
  }, {
    "tStartMs": 590431,
    "dDurationMs": 7200,
