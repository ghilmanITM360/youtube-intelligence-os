    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "close to the scale of something like the Lakers \ndeal, the general rule is still the same. Sports  "
    } ]
  }, {
    "tStartMs": 204800,
    "dDurationMs": 6320,
