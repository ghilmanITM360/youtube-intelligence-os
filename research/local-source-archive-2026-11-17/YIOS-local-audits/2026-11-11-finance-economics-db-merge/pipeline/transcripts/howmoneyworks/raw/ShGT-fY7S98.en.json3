    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "don't work hard, and do waste their money. \nBut that part is generally left out. Anyway,  "
    } ]
  }, {
    "tStartMs": 179360,
    "dDurationMs": 5200,
    "segs": [ {
      "utf8": "the point is, if moving up and or down between \neconomic classes is really easy, your country has  "
    } ]
