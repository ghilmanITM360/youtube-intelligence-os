    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "purchases like any other appliance. what has the \nbest features for the given price and financing  "
    } ]
  }, {
    "tStartMs": 903360,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "deal. Hot take alert and feel free to come back to \nthis video in 10 years time to call me an idiot,  "
    } ]
  }, {
    "tStartMs": 908720,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "but there really isn't anything stopping the car \nmarket from going the way of the computer market  "
    } ]
  }, {
    "tStartMs": 913280,
    "dDurationMs": 4320,
    "segs": [ {
      "utf8": "where it becomes a lot harder to flex a particular \nbrand when they are all using roughly the same  "
    } ]
  }, {
