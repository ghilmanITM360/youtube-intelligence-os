    "dDurationMs": 5840,
    "segs": [ {
      "utf8": "level cultural similarity to America. But because \nthey no longer have a local car industry, Chinese  "
    } ]
  }, {
    "tStartMs": 1107680,
    "dDurationMs": 5280,
    "segs": [ {
      "utf8": "manufacturers are treated the same as every other \nmanufacturer and they are dominating because of  "
    } ]
  }, {
    "tStartMs": 1112960,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "their cost competitiveness. Now, of course, there \nis the argument that China has subsidized these  "
    } ]
  }, {
    "tStartMs": 1117680,
    "dDurationMs": 4560,
    "segs": [ {
      "utf8": "auto manufacturers to make them as competitive \nas they are today through co-investment and  "
    } ]
  }, {
    "tStartMs": 1122240,
    "dDurationMs": 5760,
    "segs": [ {
