    "dDurationMs": 4400,
    "segs": [ {
      "utf8": "and eating out isn't getting cheaper. But what \nif every time you filled up, grabbed groceries,  "
    } ]
  }, {
    "tStartMs": 567520,
    "dDurationMs": 5120,
    "segs": [ {
      "utf8": "or went out to eat, you were earning cash back \non all of it? That's what Upside does. It's a  "
    } ]
  }, {
    "tStartMs": 572640,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "free app with over 100,000 locations where you \nearn cash back on gas, groceries, and dining,  "
    } ]
