    "dDurationMs": 4800,
    "segs": [ {
      "utf8": "massive investment into America. So really, there \nisn't much difference here. For them, it could be  "
    } ]
  }, {
    "tStartMs": 1157360,
    "dDurationMs": 4640,
    "segs": [ {
