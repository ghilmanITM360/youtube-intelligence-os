    "tStartMs": 235120,
    "dDurationMs": 6240,
    "segs": [ {
      "utf8": "every country that had industrialized until very \nrecently. Since about the mid 2000s, researchers  "
    } ]
  }, {
    "tStartMs": 241360,
    "dDurationMs": 5040,
    "segs": [ {
      "utf8": "in Norway, Denmark, Finland, the UK, France, \nGermany, and the Netherlands have all reported the  "
    } ]
  }, {
    "tStartMs": 246400,
    "dDurationMs": 5360,
    "segs": [ {
      "utf8": "Flynn effect either stalling or reversing. Here \nin America, the National Assessment of Educational  "
    } ]
  }, {
    "tStartMs": 251760,
    "dDurationMs": 4720,
    "segs": [ {
      "utf8": "Progress has shown the biggest decline in reading \nsince 1990, and the first ever score drops in  "
