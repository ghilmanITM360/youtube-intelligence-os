    "dDurationMs": 4080,
    "segs": [ {
      "utf8": "out how the gaming industry is imploding \nunder the weight of its best years ever.  "
    } ]
  }, {
    "tStartMs": 545480,
    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "This video is sponsored by Monarch. If you have \never tried to track your money across multiple  "
