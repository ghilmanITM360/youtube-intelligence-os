    "dDurationMs": 4120,
    "segs": [ {
      "utf8": "in the history of the industry alongside a bunch \nof smaller studios to build out their Game Pass  "
    } ]
  }, {
    "tStartMs": 237120,
    "dDurationMs": 4680,
    "segs": [ {
      "utf8": "offering. Now, even regular streaming services \noutside of Netflix have struggled with financial  "
    } ]
  }, {
    "tStartMs": 241800,
    "dDurationMs": 5200,
    "segs": [ {
