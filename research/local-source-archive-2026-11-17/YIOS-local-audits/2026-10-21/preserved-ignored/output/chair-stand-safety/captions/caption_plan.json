    "start_sec": 13.58,
    "end_sec": 14.14,
    "text": "sit down.",
    "emphasis_words": [],
    "priority": "NORMAL"
  },
  {
    "caption_id": "C007",
    "start_sec": 14.9,
    "end_sec": 17.78,
