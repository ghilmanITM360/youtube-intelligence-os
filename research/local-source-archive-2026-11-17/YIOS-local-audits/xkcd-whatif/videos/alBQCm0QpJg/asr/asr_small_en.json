 "segments": [
  {
   "start": 0.0,
   "end": 1.86,
   "text": "This question comes from Aaron, who asks,",
   "avg_logprob": -0.21,
   "no_speech_prob": 0.002
  },
  {
   "start": 2.18,
   "end": 4.22,
   "text": "a friend of mine is convinced that there is sound in space.",
   "avg_logprob": -0.21,
   "no_speech_prob": 0.002
  },
  {
   "start": 4.62,
   "end": 5.18,
   "text": "There isn't, right?",
   "avg_logprob": -0.21,
   "no_speech_prob": 0.002
  },
  {
   "start": 5.98,
   "end": 7.4,
   "text": "Aaron, the answer is...",
   "avg_logprob": -0.21,
   "no_speech_prob": 0.002
  },
  {
   "start": 8.92,
   "end": 11.72,
   "text": "Here are some more weird and worrying questions from the What If inbox.",
   "avg_logprob": -0.21,
   "no_speech_prob": 0.002
  },
  {
   "start": 12.6,
   "end": 17.76,
   "text": "Justin asks, what is the total nutritional value, calories, fat, minerals, etc., of the average human body?",
   "avg_logprob": -0.21,
   "no_speech_prob": 0.002
  },
  {
   "start": 18.26,
   "end": 21.38,
   "text": "Justin, you know that question sounds at least a little bit suspicious, right?",
   "avg_logprob": -0.21,
   "no_speech_prob": 0.002
  },
  {
   "start": 22.34,
   "end": 26.04,
   "text": "Kenneth asks, what if every day every human had a 1% chance of being turned into a turkey,",
   "avg_logprob": -0.21,
   "no_speech_prob": 0.002
  },
  {
   "start": 26.28,
   "end": 28.7,
   "text": "and every turkey had a 1% chance of being turned into a human?",
   "avg_logprob": -0.21,
   "no_speech_prob": 0.002
  },
  {
   "start": 28.7,
   "end": 31.84,
   "text": "Kenneth, you don't know someone named Justin, do you?",
   "avg_logprob": -0.074,
   "no_speech_prob": 0.019
  },
  {
   "start": 32.24,
   "end": 33.86,
   "text": "I'm a little concerned about what you two are planning.",
   "avg_logprob": -0.074,
   "no_speech_prob": 0.019
  },
  {
   "start": 34.72,
   "end": 40.34,
   "text": "Devor asks, in Thor, the main character is at one point spinning his hammer so fast that he creates a strong tornado.",
   "avg_logprob": -0.074,
   "no_speech_prob": 0.019
  },
  {
   "start": 40.88,
   "end": 42.16,
   "text": "Would this be possible in real life?",
   "avg_logprob": -0.074,
   "no_speech_prob": 0.019
  },
  {
   "start": 43.02,
   "end": 43.44,
   "text": "No.",
   "avg_logprob": -0.074,
   "no_speech_prob": 0.019
  },
  {
   "start": 44.7,
   "end": 50.12,
   "text": "Jonathan asks, if you saved a whole life's worth of kissing and used all that suction power on one single kiss,",
   "avg_logprob": -0.074,
   "no_speech_prob": 0.019
  },
  {
   "start": 50.36,
   "end": 52.64,
   "text": "how much suction force would that single kiss have?",
   "avg_logprob": -0.074,
   "no_speech_prob": 0.019
  },
  {
   "start": 53.22,
   "end": 55.08,
   "text": "Jonathan, based on your phrasing,",
   "avg_logprob": -0.074,
   "no_speech_prob": 0.019
  },
  {
   "start": 55.08,
   "end": 59.76,
   "text": "I am actually a little concerned about the amount of suction that you think a normal kiss should have.",
   "avg_logprob": -0.033,
   "no_speech_prob": 0.117
  },
  {
   "start": 60.66,
   "end": 64.96,
   "text": "Chris asks, could you survive a tidal wave by submerging yourself in an in-ground pool?",
   "avg_logprob": -0.033,
   "no_speech_prob": 0.117
  },
  {
   "start": 65.86,
   "end": 69.24,
   "text": "Chris, I don't think I'd try that unless I had Thor's hammer with me.",
   "avg_logprob": -0.033,
   "no_speech_prob": 0.117
  }
 ],
