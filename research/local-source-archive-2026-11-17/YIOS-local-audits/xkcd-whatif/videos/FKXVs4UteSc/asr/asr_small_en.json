 "segments": [
  {
   "start": 0.0,
   "end": 2.04,
   "text": "Is there such a thing as a magnitude zero earthquake?",
   "avg_logprob": -0.102,
   "no_speech_prob": 0.0
  },
  {
   "start": 2.62,
   "end": 5.24,
   "text": "Yes! In fact, the scale goes all the way down past zero.",
   "avg_logprob": -0.102,
   "no_speech_prob": 0.0
  },
  {
   "start": 5.7,
   "end": 8.56,
   "text": "Let's take a look at some low-magnitude earthquakes with a description of what",
   "avg_logprob": -0.102,
   "no_speech_prob": 0.0
  },
  {
   "start": 8.56,
   "end": 12.58,
   "text": "they would be like if they hit your house. A magnitude one quake releases the same energy",
   "avg_logprob": -0.102,
   "no_speech_prob": 0.0
  },
  {
   "start": 12.58,
   "end": 16.7,
   "text": "as dropping a partially loaded cement truck from 10 meters onto the street in front of your house.",
   "avg_logprob": -0.102,
   "no_speech_prob": 0.0
  },
  {
   "start": 17.28,
   "end": 20.98,
   "text": "A magnitude zero earthquake is equivalent to the Dallas Cowboys American football team",
   "avg_logprob": -0.102,
   "no_speech_prob": 0.0
  },
  {
   "start": 20.98,
   "end": 23.38,
   "text": "running at full tilt into the side of your neighbor's garage.",
   "avg_logprob": -0.102,
   "no_speech_prob": 0.0
  },
  {
   "start": 23.94,
   "end": 27.58,
   "text": "A magnitude negative one quake is like a single American football player running into",
   "avg_logprob": -0.102,
   "no_speech_prob": 0.0
  },
  {
   "start": 27.58,
   "end": 31.88,
   "text": "a tree in your yard. A cat falling off a dresser would have a magnitude of negative two.",
   "avg_logprob": -0.048,
   "no_speech_prob": 0.034
  },
  {
   "start": 32.36,
   "end": 35.64,
   "text": "A cat knocking your cell phone off your nightstand would have a magnitude negative three.",
   "avg_logprob": -0.048,
   "no_speech_prob": 0.034
  },
  {
   "start": 36.24,
   "end": 38.8,
   "text": "Magnitude negative four is like a penny falling off of a dog.",
   "avg_logprob": -0.048,
   "no_speech_prob": 0.034
  },
  {
   "start": 39.5,
   "end": 43.28,
   "text": "Magnitude negative five is a key press on an IBM Model M mechanical keyboard.",
   "avg_logprob": -0.048,
   "no_speech_prob": 0.034
  },
  {
   "start": 43.8,
   "end": 46.12,
   "text": "Negative six is a key press on a lightweight keyboard.",
   "avg_logprob": -0.048,
   "no_speech_prob": 0.034
  },
  {
   "start": 46.7,
   "end": 49.28,
   "text": "Negative seven is a single feather fluttering to the ground.",
   "avg_logprob": -0.048,
   "no_speech_prob": 0.034
  },
  {
   "start": 49.72,
   "end": 53.18,
   "text": "A fine grain of sand falling onto the pile at the bottom of a tiny hourglass",
   "avg_logprob": -0.048,
   "no_speech_prob": 0.034
  },
  {
   "start": 53.18,
   "end": 55.16,
   "text": "would be a magnitude negative eight quake.",
   "avg_logprob": -0.048,
   "no_speech_prob": 0.034
  },
  {
   "start": 55.16,
   "end": 58.22,
   "text": "And let's jump all the way down to magnitude negative 15,",
   "avg_logprob": -0.108,
   "no_speech_prob": 0.003
  },
  {
   "start": 58.68,
   "end": 61.32,
   "text": "a drifting mode of dust coming to rest gently on a table.",
   "avg_logprob": -0.108,
   "no_speech_prob": 0.003
  },
  {
   "start": 61.84,
   "end": 64.24,
   "text": "Sometimes it's nice not to destroy the world for a change.",
   "avg_logprob": -0.108,
   "no_speech_prob": 0.003
  }
 ],
