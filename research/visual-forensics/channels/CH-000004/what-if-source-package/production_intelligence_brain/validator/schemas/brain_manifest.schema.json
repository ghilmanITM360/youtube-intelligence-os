{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brain_manifest.schema.json",
  "title": "BRAIN_MANIFEST.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "brain_type", "release_version", "created_at", "validated_at",
    "release_frozen_at", "project_root", "project_status", "release_status",
    "source_video_count", "total_words", "total_meaningful_sentences", "total_shots",
    "total_states", "total_motions", "total_assets", "total_audio_events",
    "total_av_sync_events", "motion_start_events", "motion_end_events",
    "validation_failures", "validation_status", "known_limitations", "next_action"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "brain_type": { "type": "string" },
    "release_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "created_at": { "type": "string" },
    "validated_at": { "type": "string" },
    "release_frozen_at": { "type": ["string", "null"] },
    "project_root": { "type": "string" },
    "project_status": { "type": "string", "enum": ["COMPLETE_VALIDATED", "IN_PROGRESS"] },
    "release_status": { "type": "string", "enum": ["PREPARING", "FROZEN"] },
    "source_video_count": { "type": "integer", "minimum": 0 },
    "audio_verified_count": { "type": "integer", "minimum": 0 },
    "transcribed_video_count": { "type": "integer", "minimum": 0 },
    "word_aligned_video_count": { "type": "integer", "minimum": 0 },
    "av_sync_complete_count": { "type": "integer", "minimum": 0 },
    "total_words": { "type": "integer", "minimum": 0 },
    "total_meaningful_sentences": { "type": "integer", "minimum": 0 },
    "total_shots": { "type": "integer", "minimum": 0 },
    "total_states": { "type": "integer", "minimum": 0 },
    "total_motions": { "type": "integer", "minimum": 0 },
    "total_assets": { "type": "integer", "minimum": 0 },
    "total_audio_events": { "type": "integer", "minimum": 0 },
    "total_av_sync_events": { "type": "integer", "minimum": 0 },
    "motion_start_events": { "type": "integer", "minimum": 0 },
    "motion_end_events": { "type": "integer", "minimum": 0 },
    "instantaneous_motions_no_end_event": { "type": "integer", "minimum": 0 },
    "malformed_csv_rows": { "type": "integer", "minimum": 0 },
    "orphan_required_ids": { "type": "integer", "minimum": 0 },
    "sentence_link_failures": { "type": "integer", "minimum": 0 },
    "word_count_mismatches": { "type": "integer", "minimum": 0 },
    "hard_timestamp_errors": { "type": "integer", "minimum": 0 },
    "allowed_small_word_overlaps": { "type": "integer", "minimum": 0 },
    "validation_failures": { "type": "integer", "minimum": 0 },
    "timestamp_overlap_violations": { "type": "integer", "minimum": 0 },
    "state_duration_mismatches": { "type": "integer", "minimum": 0 },
    "shot_duration_mismatches": { "type": "integer", "minimum": 0 },
    "shot_state_count_mismatches": { "type": "integer", "minimum": 0 },
    "shot_motion_count_mismatches": { "type": "integer", "minimum": 0 },
    "motion_orphan_shot_refs": { "type": "integer", "minimum": 0 },
    "motion_orphan_source_state_refs": { "type": "integer", "minimum": 0 },
    "motion_orphan_target_state_refs": { "type": "integer", "minimum": 0 },
    "av_orphan_shot_refs": { "type": "integer", "minimum": 0 },
    "av_orphan_source_state_refs": { "type": "integer", "minimum": 0 },
    "av_orphan_target_state_refs": { "type": "integer", "minimum": 0 },
    "compound_motion_id_sync_rows_resolved": { "type": "integer", "minimum": 0 },
    "cross_shot_motions_with_target_shot_id": { "type": "integer", "minimum": 0 },
    "reveal_subphase_states_remapped": { "type": "integer", "minimum": 0 },
    "validation_status": { "type": "string", "enum": ["PASSED", "FAILED"] },
    "known_limitations": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string" },
    "transcribed_list": { "type": "array", "items": { "type": "string" } },
    "pending_list": { "type": "array", "items": { "type": "string" } },
    "completed_phases": { "type": "array", "items": { "type": "string" } },
    "pending_phases": { "type": "array", "items": { "type": "string" } }
  }
}
