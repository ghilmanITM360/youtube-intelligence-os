 "segments": [
  {
   "start": 0.0,
   "end": 3.28,
   "text": "Solar panels will generally last as long as the electronics are connected to them,",
   "avg_logprob": -0.096,
   "no_speech_prob": 0.0
  },
  {
   "start": 3.42,
   "end": 5.9,
   "text": "and as long as the panels are kept free of dust and debris.",
   "avg_logprob": -0.096,
   "no_speech_prob": 0.0
  },
  {
   "start": 6.42,
   "end": 10.66,
   "text": "The wires and circuits will eventually succumb to corrosion, but solar panels in a dry place",
   "avg_logprob": -0.096,
   "no_speech_prob": 0.0
  },
  {
   "start": 10.66,
   "end": 14.4,
   "text": "with well-built electronics could easily continue providing power for a century if",
   "avg_logprob": -0.096,
   "no_speech_prob": 0.0
  },
  {
   "start": 14.4,
   "end": 18.02,
   "text": "they're kept free of dust by occasional breezes or rain on the exposed panels.",
   "avg_logprob": -0.096,
   "no_speech_prob": 0.0
  },
  {
   "start": 18.56,
   "end": 20.32,
   "text": "If we follow a strict definition of lighting,",
   "avg_logprob": -0.096,
   "no_speech_prob": 0.0
  },
  {
   "start": 20.74,
   "end": 24.96,
   "text": "solar-powered lights in remote locations could conceivably be the last surviving human light source.",
   "avg_logprob": -0.096,
   "no_speech_prob": 0.0
  }
 ],
