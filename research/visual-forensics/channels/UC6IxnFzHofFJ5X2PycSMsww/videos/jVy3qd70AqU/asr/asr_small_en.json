 "label": "PROVISIONAL_ASR_NOT_LISTENING",
 "segments": [
  {
   "start": 0.0,
   "end": 3.08,
   "text": "What would happen if you literally had all the world's money?",
   "avg_logprob": -0.093,
   "no_speech_prob": 0.003
  },
  {
   "start": 3.4,
   "end": 5.46,
   "text": "I don't know how you would actually gather all the world's money,",
   "avg_logprob": -0.093,
   "no_speech_prob": 0.003
  },
  {
   "start": 5.64,
   "end": 8.94,
   "text": "so let's just assume that you invented some kind of a money-summoning magic spell.",
   "avg_logprob": -0.093,
   "no_speech_prob": 0.003
  },
  {
   "start": 9.54,
   "end": 11.6,
   "text": "Most of the world's wealth isn't physical money.",
   "avg_logprob": -0.093,
   "no_speech_prob": 0.003
  },
  {
   "start": 12.02,
   "end": 16.42,
   "text": "It's land and houses, bank accounts, businesses, intellectual property, cryptocurrency, and so on.",
   "avg_logprob": -0.093,
   "no_speech_prob": 0.003
  },
  {
   "start": 16.7,
   "end": 18.88,
   "text": "Getting all the world's cash is much more straightforward.",
   "avg_logprob": -0.093,
   "no_speech_prob": 0.003
  },
  {
   "start": 19.42,
   "end": 21.44,
   "text": "At any given time, there is a certain amount in the world,",
   "avg_logprob": -0.093,
   "no_speech_prob": 0.003
  },
  {
   "start": 21.66,
   "end": 24.7,
   "text": "which right now it's somewhere north of $10 trillion, and you want it all.",
   "avg_logprob": -0.093,
   "no_speech_prob": 0.003
  },
  {
   "start": 25.16,
   "end": 27.84,
   "text": "So you cast your magic spell and summon all the money.",
   "avg_logprob": -0.093,
   "no_speech_prob": 0.003
  },
  {
   "start": 27.84,
   "end": 32.16,
   "text": "The pile of cash is taller than the Statue of Liberty and heavier than the Empire State Building.",
   "avg_logprob": -0.071,
   "no_speech_prob": 0.097
  },
  {
   "start": 32.62,
   "end": 34.1,
   "text": "You probably don't want to be standing under it,",
   "avg_logprob": -0.071,
   "no_speech_prob": 0.097
  },
  {
   "start": 34.2,
   "end": 36.46,
   "text": "so let's assume that you're standing over here, off to the side.",
   "avg_logprob": -0.071,
   "no_speech_prob": 0.097
  },
  {
   "start": 37.0,
   "end": 40.42,
   "text": "In total, US coins and bills are responsible for about 20% of the pile's weight,",
   "avg_logprob": -0.071,
   "no_speech_prob": 0.097
  },
  {
   "start": 40.56,
   "end": 42.88,
   "text": "while the European Union contributes roughly 25%.",
   "avg_logprob": -0.071,
   "no_speech_prob": 0.097
  },
  {
   "start": 43.72,
   "end": 46.54,
   "text": "Unfortunately for you, the pile doesn't stay a pile for long,",
   "avg_logprob": -0.071,
   "no_speech_prob": 0.097
  },
  {
   "start": 46.74,
   "end": 49.02,
   "text": "and what seems like a safe distance isn't so safe.",
   "avg_logprob": -0.071,
   "no_speech_prob": 0.097
  },
  {
   "start": 49.44,
   "end": 51.34,
   "text": "As it collapses, the pile spreads outward,",
   "avg_logprob": -0.071,
   "no_speech_prob": 0.097
  },
  {
   "start": 51.46,
   "end": 53.98,
   "text": "a wave of money carrying a staggering amount of momentum.",
   "avg_logprob": -0.071,
   "no_speech_prob": 0.097
  },
  {
   "start": 53.98,
   "end": 58.0,
   "text": "The pennies, quarters, loonies, and euros scour the landscape in an expanding rain.",
   "avg_logprob": -0.099,
   "no_speech_prob": 0.232
  },
  {
   "start": 58.4,
   "end": 60.66,
   "text": "Within seconds, the wave of coins engulfs you and you die.",
   "avg_logprob": -0.099,
   "no_speech_prob": 0.232
  },
  {
   "start": 61.22,
   "end": 62.52,
   "text": "There are ways to avoid this.",
   "avg_logprob": -0.099,
   "no_speech_prob": 0.232
  },
  {
   "start": 62.9,
   "end": 66.16,
   "text": "You could, say, build a wall to contain the coins, and then summon them.",
   "avg_logprob": -0.099,
   "no_speech_prob": 0.232
  },
  {
   "start": 66.58,
   "end": 69.36,
   "text": "Unfortunately, you might now face a problem worse than death.",
   "avg_logprob": -0.099,
   "no_speech_prob": 0.232
  },
  {
   "start": 69.9,
   "end": 70.92,
   "text": "Building code violations.",
   "avg_logprob": -0.099,
   "no_speech_prob": 0.232
  }
 ],
