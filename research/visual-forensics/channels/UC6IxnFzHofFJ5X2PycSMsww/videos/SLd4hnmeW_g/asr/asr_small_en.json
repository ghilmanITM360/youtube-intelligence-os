 "segments": [
  {
   "start": 0.0,
   "end": 3.8,
   "text": "Shelby asks, would it be possible to get your teeth to such a cold temperature that they",
   "avg_logprob": -0.175,
   "no_speech_prob": 0.005
  },
  {
   "start": 3.8,
   "end": 5.72,
   "text": "would shatter upon drinking a hot cup of coffee?",
   "avg_logprob": -0.175,
   "no_speech_prob": 0.005
  },
  {
   "start": 6.56,
   "end": 8.58,
   "text": "Thank you Shelby for my new recurring nightmare.",
   "avg_logprob": -0.175,
   "no_speech_prob": 0.005
  },
  {
   "start": 9.16,
   "end": 11.86,
   "text": "Here are some more weird and worrying questions from the What If inbox.",
   "avg_logprob": -0.175,
   "no_speech_prob": 0.005
  },
  {
   "start": 12.4,
   "end": 16.12,
   "text": "Jeff asks, given humanity's current knowledge and abilities, is it possible to build a",
   "avg_logprob": -0.175,
   "no_speech_prob": 0.005
  },
  {
   "start": 16.12,
   "end": 16.68,
   "text": "new star?",
   "avg_logprob": -0.175,
   "no_speech_prob": 0.005
  },
  {
   "start": 17.44,
   "end": 19.3,
   "text": "Jeff, is there a reason you need to know this?",
   "avg_logprob": -0.175,
   "no_speech_prob": 0.005
  },
  {
   "start": 19.94,
   "end": 20.66,
   "text": "What are you planning?",
   "avg_logprob": -0.175,
   "no_speech_prob": 0.005
  },
  {
   "start": 21.4,
   "end": 25.8,
   "text": "Tomas asks, would it be possible to stop a volcano eruption by placing a bomb, thermobaric,",
   "avg_logprob": -0.175,
   "no_speech_prob": 0.005
  },
  {
   "start": 25.88,
   "end": 27.12,
   "text": "or nuclear underneath the surface?",
   "avg_logprob": -0.175,
   "no_speech_prob": 0.005
  },
  {
   "start": 28.18,
   "end": 32.98,
   "text": "AJ asks, would dumping antimatter into the Chernobyl reactor when it was melting down stop",
   "avg_logprob": -0.275,
   "no_speech_prob": 0.013
  },
  {
   "start": 32.98,
   "end": 33.44,
   "text": "the meltdown?",
   "avg_logprob": -0.275,
   "no_speech_prob": 0.013
  },
  {
   "start": 34.74,
   "end": 38.46,
   "text": "AJ and Tomas, in recognition for your disaster response efforts, we award you the",
   "avg_logprob": -0.275,
   "no_speech_prob": 0.013
  },
  {
   "start": 38.46,
   "end": 40.42,
   "text": "For God's Sake What Were You Thinking Award.",
   "avg_logprob": -0.275,
   "no_speech_prob": 0.013
  },
  {
   "start": 41.06,
   "end": 44.32,
   "text": "Carl asks, is it possible to cry so much that you'd dehydrate yourself?",
   "avg_logprob": -0.275,
   "no_speech_prob": 0.013
  },
  {
   "start": 45.12,
   "end": 46.74,
   "text": "Carl, is everything okay?",
   "avg_logprob": -0.275,
   "no_speech_prob": 0.013
  }
 ],
