 "segments": [
  {
   "start": 0.0,
   "end": 3.88,
   "text": "What would the world's largest cities be like if the landmasses were rotated by 90 degrees?",
   "avg_logprob": -0.164,
   "no_speech_prob": 0.0
  },
  {
   "start": 4.62,
   "end": 5.38,
   "text": "Some get colder.",
   "avg_logprob": -0.164,
   "no_speech_prob": 0.0
  },
  {
   "start": 5.7,
   "end": 8.72,
   "text": "Mexico City, high in the polar mountains, is buried beneath an ice sheet.",
   "avg_logprob": -0.164,
   "no_speech_prob": 0.0
  },
  {
   "start": 9.28,
   "end": 13.7,
   "text": "Jakarta is the new Svalbard, a desolate coastal rock too far north for even most Norwegians.",
   "avg_logprob": -0.164,
   "no_speech_prob": 0.0
  },
  {
   "start": 14.24,
   "end": 17.82,
   "text": "Kolkata and Delhi are icebound, sealed off from the warmer world by the Himalayas.",
   "avg_logprob": -0.164,
   "no_speech_prob": 0.0
  },
  {
   "start": 18.34,
   "end": 22.72,
   "text": "Hong Kong, Manila, Karachi, and Mumbai are similar to our world's Anchorage or Reykjavik.",
   "avg_logprob": -0.164,
   "no_speech_prob": 0.0
  },
  {
   "start": 23.1,
   "end": 25.38,
   "text": "The ocean isn't frozen solid, but it sure is cold.",
   "avg_logprob": -0.164,
   "no_speech_prob": 0.0
  },
  {
   "start": 25.94,
   "end": 28.66,
   "text": "Many cities remain comfortably habitable, albeit with some changes.",
   "avg_logprob": -0.164,
   "no_speech_prob": 0.0
  },
  {
   "start": 28.66,
   "end": 32.94,
   "text": "Seoul, Osaka, Tokyo, Shanghai, and New York City are among the least affected cities,",
   "avg_logprob": -0.111,
   "no_speech_prob": 0.015
  },
  {
   "start": 33.02,
   "end": 35.02,
   "text": "with climates roughly similar to their previous ones.",
   "avg_logprob": -0.111,
   "no_speech_prob": 0.015
  },
  {
   "start": 35.66,
   "end": 39.2,
   "text": "Shanghai does get colder, but seasonal extremes in all five cities get milder,",
   "avg_logprob": -0.111,
   "no_speech_prob": 0.015
  },
  {
   "start": 39.34,
   "end": 41.64,
   "text": "particularly in Seoul, and substantially wetter.",
   "avg_logprob": -0.111,
   "no_speech_prob": 0.015
  },
  {
   "start": 42.12,
   "end": 43.4,
   "text": "Cairo has moved slightly south.",
   "avg_logprob": -0.111,
   "no_speech_prob": 0.015
  },
  {
   "start": 43.66,
   "end": 47.4,
   "text": "It's now surrounded by coastal savannah with spots of rainforest found around the mouth of the Nile.",
   "avg_logprob": -0.111,
   "no_speech_prob": 0.015
  },
  {
   "start": 48.1,
   "end": 50.08,
   "text": "Sao Paulo and Buenos Aires cool down a little bit.",
   "avg_logprob": -0.111,
   "no_speech_prob": 0.015
  },
  {
   "start": 50.38,
   "end": 54.52,
   "text": "Their climate is somewhere between that of our old New England and that of our old regular England.",
   "avg_logprob": -0.111,
   "no_speech_prob": 0.015
  },
  {
   "start": 55.1,
   "end": 56.46,
   "text": "Los Angeles is cool and mild.",
   "avg_logprob": -0.111,
   "no_speech_prob": 0.015
  },
  {
   "start": 56.46,
   "end": 59.68,
   "text": "The steady sea breeze carrying moisture up into the San Gabriel Mountains",
   "avg_logprob": -0.079,
   "no_speech_prob": 0.021
  },
  {
   "start": 59.68,
   "end": 62.3,
   "text": "makes LA one of the rainiest places in the new US.",
   "avg_logprob": -0.079,
   "no_speech_prob": 0.021
  },
  {
   "start": 62.72,
   "end": 64.86,
   "text": "It closely resembles a wetter version of our Seattle.",
   "avg_logprob": -0.079,
   "no_speech_prob": 0.021
  },
  {
   "start": 65.44,
   "end": 67.08,
   "text": "And a few cities get much hotter.",
   "avg_logprob": -0.079,
   "no_speech_prob": 0.021
  },
  {
   "start": 67.54,
   "end": 69.58,
   "text": "Moscow is extremely hot and very dry,",
   "avg_logprob": -0.079,
   "no_speech_prob": 0.021
  },
  {
   "start": 69.66,
   "end": 72.0,
   "text": "with a climate somewhere between our Phoenix and our Baghdad.",
   "avg_logprob": -0.079,
   "no_speech_prob": 0.021
  },
  {
   "start": 72.54,
   "end": 76.32,
   "text": "And London sits in a steamy jungle, with a climate generally resembling Bangkok's.",
   "avg_logprob": -0.079,
   "no_speech_prob": 0.021
  },
  {
   "start": 76.58,
   "end": 79.92,
   "text": "Spicy curry is now climatically appropriate, the Thames is full of piranha,",
   "avg_logprob": -0.079,
   "no_speech_prob": 0.021
  },
  {
   "start": 80.04,
   "end": 83.06,
   "text": "and it's the only place on earth where tigers apologize as they attack you.",
   "avg_logprob": -0.079,
   "no_speech_prob": 0.021
  }
 ],
