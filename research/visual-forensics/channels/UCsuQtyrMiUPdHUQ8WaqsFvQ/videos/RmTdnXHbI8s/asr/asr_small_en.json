  },
  {
   "start": 91.56,
   "end": 98.42,
   "text": "suffer. Cave wife look at me with thousand yards there. So me have no choice. Me sign many stone",
   "avg_logprob": -0.198,
   "no_speech_prob": 0.039
  },
  {
   "start": 98.42,
   "end": 107.1,
   "text": "slab. Then boom. Me have cave. Me happy. Me decorate. Write down cave sweet cave on bark.",
   "avg_logprob": -0.198,
   "no_speech_prob": 0.039
  },
  {
   "start": 107.1,
   "end": 113.88,
   "text": "Hang up on wall next to disturbed family cave painting from krug jr. Each moon. Me wake up",
   "avg_logprob": -0.171,
   "no_speech_prob": 0.233
  },
  {
