  {
   "start": 0.0,
   "end": 3.0,
   "text": "If ever miss one moon payment, banks say,",
   "avg_logprob": -0.215,
   "no_speech_prob": 0.016
  },
  {
   "start": 3.38,
   "end": 6.42,
   "text": "Ha ha! Me take cave back. Enjoy sleep under tree.",
   "avg_logprob": -0.215,
   "no_speech_prob": 0.016
  },
  {
   "start": 6.7,
   "end": 10.18,
   "text": "Me say no. Crud try hard. So me hunt, me gather,",
   "avg_logprob": -0.215,
   "no_speech_prob": 0.016
  },
  {
   "start": 10.58,
   "end": 13.94,
   "text": "and me deliver food on kangaroo back to lazy caveman.",
   "avg_logprob": -0.215,
   "no_speech_prob": 0.016
  },
  {
   "start": 14.22,
   "end": 16.9,
   "text": "One day, Big Rock Lender show up and he say,",
   "avg_logprob": -0.215,
   "no_speech_prob": 0.016
  },
  {
   "start": 17.36,
   "end": 23.14,
   "text": "You dern. Me falter knees, cry into floor, kiss floor, floor dirty.",
   "avg_logprob": -0.215,
   "no_speech_prob": 0.016
  },
  {
   "start": 23.96,
   "end": 29.52,
   "text": "Me like. Me now own cave. Just in time to grow many wrinkle and die.",
   "avg_logprob": -0.215,
   "no_speech_prob": 0.016
  },
  {
   "start": 29.52,
   "end": 32.26,
   "text": "Me pass cave to old sun. Sun say.",
   "avg_logprob": -0.227,
   "no_speech_prob": 0.001
  },
  {
   "start": 32.7,
   "end": 39.74,
   "text": "Cave outdated. Me sell this dump. Get mortgage on tree. Me haunt tree.",
   "avg_logprob": -0.227,
   "no_speech_prob": 0.001
  }
 ],
