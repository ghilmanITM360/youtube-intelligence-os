 "segments": [
  {
   "start": 0.0,
   "end": 6.38,
   "text": "What would happen to dinosaur in tornado? Would long-neck dinosaur turn into long-neck helicopter?",
   "avg_logprob": -0.285,
   "no_speech_prob": 0.01
  },
  {
   "start": 7.1,
   "end": 11.5,
   "text": "Maybe no, because neck isn't a flaccid, floppy shaft with head.",
   "avg_logprob": -0.285,
   "no_speech_prob": 0.01
  },
  {
   "start": 13.04,
   "end": 13.34,
   "text": "Dear.",
   "avg_logprob": -0.285,
   "no_speech_prob": 0.01
  },
  {
   "start": 13.98,
   "end": 14.32,
   "text": "Me?",
   "avg_logprob": -0.285,
   "no_speech_prob": 0.01
  },
  {
   "start": 15.16,
   "end": 15.2,
   "text": "Explain.",
   "avg_logprob": -0.285,
   "no_speech_prob": 0.01
  },
  {
   "start": 15.98,
   "end": 22.22,
   "text": "A wind push on neck from one side, make head spin one way, and body go other.",
   "avg_logprob": -0.285,
   "no_speech_prob": 0.01
  },
  {
   "start": 22.7,
   "end": 25.08,
   "text": "Cause leg panic or cause neck snap.",
   "avg_logprob": -0.285,
   "no_speech_prob": 0.01
  },
  {
   "start": 25.52,
   "end": 27.08,
   "text": "But what about small dino?",
   "avg_logprob": -0.285,
   "no_speech_prob": 0.01
  },
  {
   "start": 27.46,
   "end": 28.84,
   "text": "Like velociraptor.",
   "avg_logprob": -0.285,
   "no_speech_prob": 0.01
  },
  {
   "start": 28.84,
   "end": 32.24,
   "text": "Tornado mean, they learn to fly.",
   "avg_logprob": -0.271,
   "no_speech_prob": 0.008
  },
  {
   "start": 32.82,
   "end": 34.3,
   "text": "It beautiful.",
   "avg_logprob": -0.271,
   "no_speech_prob": 0.008
  },
  {
   "start": 35.76,
   "end": 36.84,
   "text": "But they know the land.",
   "avg_logprob": -0.271,
   "no_speech_prob": 0.008
  },
  {
   "start": 39.18,
   "end": 41.54,
   "text": "But what about real big dino?",
   "avg_logprob": -0.271,
   "no_speech_prob": 0.008
  },
  {
   "start": 41.88,
   "end": 43.02,
   "text": "That way more than house.",
   "avg_logprob": -0.271,
   "no_speech_prob": 0.008
  },
  {
   "start": 43.54,
   "end": 44.8,
   "text": "Like Patagotitan.",
   "avg_logprob": -0.271,
   "no_speech_prob": 0.008
  },
  {
   "start": 45.46,
   "end": 47.66,
   "text": "Maybe too heavy to see sky time.",
   "avg_logprob": -0.271,
   "no_speech_prob": 0.008
  },
  {
   "start": 47.96,
   "end": 50.6,
   "text": "Sure, but heavy not mean safe.",
   "avg_logprob": -0.271,
   "no_speech_prob": 0.008
  },
  {
   "start": 51.18,
   "end": 53.04,
   "text": "Tornado attack with debris.",
   "avg_logprob": -0.271,
   "no_speech_prob": 0.008
  },
  {
   "start": 53.74,
   "end": 57.56,
   "text": "It throw branch, rock, small dino, not so super grub,",
   "avg_logprob": -0.271,
   "no_speech_prob": 0.008
  },
  {
   "start": 57.56,
   "end": 59.02,
   "text": "and trampoline.",
   "avg_logprob": -0.134,
   "no_speech_prob": 0.006
  },
  {
   "start": 59.76,
   "end": 63.7,
   "text": "It even turn forest into thousand flying spear.",
   "avg_logprob": -0.134,
   "no_speech_prob": 0.006
  },
  {
   "start": 64.34,
   "end": 66.78,
   "text": "So lesson is, small dino get flight,",
   "avg_logprob": -0.134,
   "no_speech_prob": 0.006
  },
  {
   "start": 67.32,
   "end": 71.26,
   "text": "long dino get fold, and big dino get forest.",
   "avg_logprob": -0.134,
   "no_speech_prob": 0.006
  },
  {
   "start": 71.9,
   "end": 74.54,
   "text": "Tornado see all dino same as me.",
   "avg_logprob": -0.134,
   "no_speech_prob": 0.006
  },
  {
   "start": 75.04,
   "end": 77.26,
   "text": "It all just meet with leg.",
   "avg_logprob": -0.134,
   "no_speech_prob": 0.006
  }
 ],
