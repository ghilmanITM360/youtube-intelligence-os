 "segments": [
  {
   "start": 0.0,
   "end": 2.68,
   "text": "Long time ago, tribe do trade like normal.",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 3.04,
   "end": 4.86,
   "text": "Me give you goat, you give me stick.",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 5.16,
   "end": 6.4,
   "text": "We both happy.",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 6.88,
   "end": 9.54,
   "text": "Plus me can now use stick to take goat.",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 10.48,
   "end": 13.22,
   "text": "But one day, clever weasel man say,",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 13.5,
   "end": 14.36,
   "text": "Why carry goat?",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 14.74,
   "end": 16.12,
   "text": "When me can carry coin.",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 16.78,
   "end": 18.94,
   "text": "Soon, whole tribe use coin.",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 19.22,
   "end": 20.96,
   "text": "Then other tribes dark use.",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 21.4,
   "end": 22.58,
   "text": "Then all tribes say,",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 22.74,
   "end": 23.68,
   "text": "Who got most coin?",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 23.96,
   "end": 24.94,
   "text": "Eat tribe chief now.",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 25.28,
   "end": 26.22,
   "text": "This not barter.",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 26.68,
   "end": 27.76,
   "text": "This capitalism.",
   "avg_logprob": -0.181,
   "no_speech_prob": 0.077
  },
  {
   "start": 28.32,
   "end": 31.26,
   "text": "Capitalism mean caveman own stuff.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 31.72,
   "end": 32.6,
   "text": "Not tribe stuff.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 33.02,
   "end": 34.04,
   "text": "Not share stuff.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 34.48,
   "end": 35.22,
   "text": "Stuff mine.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 35.86,
   "end": 36.66,
   "text": "You want water.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 37.2,
   "end": 37.54,
   "text": "Me sell.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 37.94,
   "end": 38.7,
   "text": "You want cave?",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 39.06,
   "end": 39.58,
   "text": "Me rent.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 39.98,
   "end": 40.92,
   "text": "You want air?",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 41.56,
   "end": 42.72,
   "text": "You get free.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 43.1,
   "end": 44.06,
   "text": "But give time.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 44.68,
   "end": 46.32,
   "text": "Me figure out how sell.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 46.8,
   "end": 48.8,
   "text": "System run on three thing.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 49.24,
   "end": 50.06,
   "text": "Coin market.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 50.84,
   "end": 51.06,
   "text": "Greed.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 51.3,
   "end": 52.62,
   "text": "Greed not bad though.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 52.86,
   "end": 53.68,
   "text": "You want more stuff?",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 53.96,
   "end": 54.86,
   "text": "You work harder.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 55.22,
   "end": 57.06,
   "text": "If you big brain, you get rich.",
   "avg_logprob": -0.106,
   "no_speech_prob": 0.046
  },
  {
   "start": 57.06,
   "end": 60.98,
   "text": "If you no big brain, you become employee.",
   "avg_logprob": -0.126,
   "no_speech_prob": 0.002
  },
  {
   "start": 61.74,
   "end": 65.72,
   "text": "Employee just caveman who decole for other caveman coin.",
   "avg_logprob": -0.126,
   "no_speech_prob": 0.002
  },
  {
   "start": 66.3,
   "end": 68.68,
   "text": "But what happen if people make thing together?",
   "avg_logprob": -0.126,
   "no_speech_prob": 0.002
  },
  {
   "start": 69.22,
   "end": 70.68,
   "text": "That called corporation.",
   "avg_logprob": -0.126,
   "no_speech_prob": 0.002
  },
  {
   "start": 71.28,
   "end": 74.9,
   "text": "It big tribe with leader who sit and take all coin.",
   "avg_logprob": -0.126,
   "no_speech_prob": 0.002
  },
  {
   "start": 75.72,
   "end": 78.04,
   "text": "Corporation sometimes buy other corporation.",
   "avg_logprob": -0.126,
   "no_speech_prob": 0.002
  },
  {
   "start": 78.58,
   "end": 82.64,
   "text": "They marry it, eat it, and wear its skin like loincloth.",
   "avg_logprob": -0.126,
   "no_speech_prob": 0.002
  },
  {
   "start": 83.14,
   "end": 85.18,
   "text": "Some say capitalism bring choice.",
   "avg_logprob": -0.126,
   "no_speech_prob": 0.002
  },
  {
   "start": 85.18,
   "end": 85.96,
   "text": "Freedom.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 87.5,
   "end": 89.38,
   "text": "Others say it create poor.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 89.88,
   "end": 90.14,
   "text": "Stress.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 90.74,
   "end": 94.72,
   "text": "And deep spiritual hole where cave soul used to be.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 95.06,
   "end": 96.76,
   "text": "Capitalism not perfect.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 97.2,
   "end": 98.04,
   "text": "It grow fast.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 98.4,
   "end": 99.74,
   "text": "But leave some behind.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 100.2,
   "end": 102.66,
   "text": "Like tribe member who twist ankle on hunt.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 103.16,
   "end": 105.12,
   "text": "But too big for uppy uppy.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 105.44,
   "end": 108.32,
   "text": "So lesson is coin like evil god.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 108.68,
   "end": 109.82,
   "text": "It control all.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 110.2,
   "end": 112.66,
   "text": "But if you worship, you end up empty.",
   "avg_logprob": -0.142,
   "no_speech_prob": 0.007
  },
  {
   "start": 112.66,
   "end": 115.38,
   "text": "With many thing but no peace.",
   "avg_logprob": -0.2,
   "no_speech_prob": 0.427
  },
  {
   "start": 115.88,
   "end": 117.54,
   "text": "Baby get what you need.",
   "avg_logprob": -0.2,
   "no_speech_prob": 0.427
  },
  {
   "start": 117.98,
   "end": 119.26,
   "text": "Give when you can.",
   "avg_logprob": -0.2,
   "no_speech_prob": 0.427
  },
  {
   "start": 119.68,
   "end": 122.84,
   "text": "And remember you no take coin to after life.",
   "avg_logprob": -0.2,
   "no_speech_prob": 0.427
  },
  {
   "start": 123.18,
   "end": 125.52,
   "text": "Only smile and memory.",
   "avg_logprob": -0.2,
   "no_speech_prob": 0.427
  }
 ],
