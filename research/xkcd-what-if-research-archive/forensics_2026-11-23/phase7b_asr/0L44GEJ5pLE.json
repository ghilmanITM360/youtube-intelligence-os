			},
			"offsets": {
				"from": 0,
				"to": 2040
			},
			"text": " This question comes from Nicholas, who asks,"
		},
		{
			"timestamps": {
				"from": "00:00:02,040",
				"to": "00:00:05,280"
			},
			"offsets": {
				"from": 2040,
				"to": 5280
			},
			"text": " \"As a writer, I'm wondering what would be the cumulative energy of the hundreds of"
		},
		{
			"timestamps": {
				"from": "00:00:05,280",
				"to": "00:00:07,680"
			},
			"offsets": {
				"from": 5280,
				"to": 7680
			},
			"text": " thousands of keystrokes required to write a novel?"
		},
		{
			"timestamps": {
				"from": "00:00:07,680",
				"to": "00:00:11,360"
			},
			"offsets": {
				"from": 7680,
				"to": 11360
			},
			"text": " You probably shouldn't invest in a keyboard-based generator any time soon.\""
		},
		{
			"timestamps": {
				"from": "00:00:13,360",
				"to": "00:00:16,720"
			},
			"offsets": {
				"from": 13360,
				"to": 16720
			},
			"text": " People like figuring out places where we can recover seemingly wasted energy."
		},
		{
			"timestamps": {
				"from": "00:00:16,720",
				"to": "00:00:20,280"
			},
			"offsets": {
				"from": 16720,
				"to": 20280
			},
			"text": " It's a great goal, but sometimes it's hard to judge how much energy is actually moving"
		},
		{
			"timestamps": {
				"from": "00:00:20,280",
				"to": "00:00:22,000"
			},
			"offsets": {
				"from": 20280,
				"to": 22000
			},
			"text": " around in a particular system."
		},
		{
			"timestamps": {
				"from": "00:00:22,000",
				"to": "00:00:25,340"
			},
			"offsets": {
				"from": 22000,
				"to": 25340
			},
			"text": " Cool-sounding ideas like solar roads don't always work out when you run the numbers,"
		},
		{
			"timestamps": {
				"from": "00:00:25,340",
				"to": "00:00:29,160"
			},
			"offsets": {
				"from": 25340,
				"to": 29160
			},
			"text": " while other ideas for collecting waste, like recovering the energy from cars breaking, turn"
		},
		{
			"timestamps": {
				"from": "00:00:29,160",
				"to": "00:00:30,160"
			},
			"offsets": {
				"from": 29160,
				"to": 30160
			},
			"text": " out to be totally practical."
		},
		{
			"timestamps": {
				"from": "00:00:30,160",
				"to": "00:00:33,560"
			},
			"offsets": {
				"from": 30160,
				"to": 33560
			},
			"text": " In the case of keyboards, there's a lot of engineering research into the force required"
		},
		{
			"timestamps": {
				"from": "00:00:33,560",
				"to": "00:00:37,640"
			},
			"offsets": {
				"from": 33560,
				"to": 37640
			},
			"text": " to press keys, in part because so many people suffer from repetitive strain injuries."
		},
		{
			"timestamps": {
				"from": "00:00:37,640",
				"to": "00:00:40,840"
			},
			"offsets": {
				"from": 37640,
				"to": 40840
			},
			"text": " Using data from a study of rubber dome keyboards, we can estimate that the energy required to"
		},
		{
			"timestamps": {
				"from": "00:00:40,840",
				"to": "00:00:46,480"
			},
			"offsets": {
				"from": 40840,
				"to": 46480
			},
			"text": " press a key is around 1.5 mJ for a letter key, and 2.5 for a big key like enter or spacebar."
		},
		{
			"timestamps": {
				"from": "00:00:46,480",
				"to": "00:00:47,960"
			},
			"offsets": {
				"from": 46480,
				"to": 47960
			},
			"text": " How much is 1.5 mJ?"
		},
		{
			"timestamps": {
				"from": "00:00:47,960",
				"to": "00:00:51,280"
			},
			"offsets": {
				"from": 47960,
				"to": 51280
			},
			"text": " Well, it's enough to heat a drop of water by 1% of a degree."
		},
		{
			"timestamps": {
				"from": "00:00:51,280",
				"to": "00:00:55,240"
			},
			"offsets": {
				"from": 51280,
				"to": 55240
			},
			"text": " It's also enough to lift a squirrel 300 microns, all the way from the ground to the top of"
		},
		{
			"timestamps": {
				"from": "00:00:55,240",
				"to": "00:00:57,200"
			},
			"offsets": {
				"from": 55240,
				"to": 57200
			},
			"text": " a stack of four sheets of paper."
		},
		{
			"timestamps": {
				"from": "00:00:57,200",
				"to": "00:01:00,280"
			},
			"offsets": {
				"from": 57200,
				"to": 60280
			},
			"text": " Now that we know how much energy a keypress takes, we need to figure out how many keypresses"
		},
		{
			"timestamps": {
				"from": "00:01:00,280",
				"to": "00:01:01,640"
			},
			"offsets": {
				"from": 60280,
				"to": 61640
			},
			"text": " are involved in writing a novel."
		},
		{
			"timestamps": {
				"from": "00:01:01,640",
				"to": "00:01:05,400"
			},
			"offsets": {
				"from": 61640,
				"to": 65400
			},
			"text": " A typical novel might have half a million to a million characters in it, so typing it"
		},
		{
			"timestamps": {
				"from": "00:01:05,400",
				"to": "00:01:07,880"
			},
			"offsets": {
				"from": 65400,
				"to": 67880
			},
			"text": " out would require at least that many keypresses."
		},
		{
			"timestamps": {
				"from": "00:01:07,880",
				"to": "00:01:11,240"
			},
			"offsets": {
				"from": 67880,
				"to": 71240
			},
			"text": " The amount of backspacing and rewriting varies wildly from person to person."
		},
		{
			"timestamps": {
				"from": "00:01:11,240",
				"to": "00:01:14,180"
			},
			"offsets": {
				"from": 71240,
				"to": 74180
			},
			"text": " Some people write straight through without pausing or editing, while others rewrite every"
		},
		{
			"timestamps": {
				"from": "00:01:14,180",
				"to": "00:01:15,580"
			},
			"offsets": {
				"from": 74180,
				"to": 75580
			},
			"text": " sentence endlessly."
		},
		{
			"timestamps": {
				"from": "00:01:15,580",
				"to": "00:01:18,180"
			},
			"offsets": {
				"from": 75580,
				"to": 78180
			},
			"text": " It turns out not to make a big difference which kind of writer you are."
		},
		{
			"timestamps": {
				"from": "00:01:18,180",
				"to": "00:01:21,280"
			},
			"offsets": {
				"from": 78180,
				"to": 81280
			},
			"text": " If you write straight through without editing, you'd expend about a kilojoule."
		},
		{
			"timestamps": {
				"from": "00:01:21,280",
				"to": "00:01:24,760"
			},
			"offsets": {
				"from": 81280,
				"to": 84760
			},
			"text": " With a lot of rewrites, you might expend several kilojoules, but you'd need to rewrite every"
		},
		{
			"timestamps": {
				"from": "00:01:24,760",
				"to": "00:01:29,080"
			},
			"offsets": {
				"from": 84760,
				"to": 89080
			},
			"text": " word ten times to match the energy stored in a single AA battery."
		},
		{
			"timestamps": {
				"from": "00:01:29,080",
				"to": "00:01:32,580"
			},
			"offsets": {
				"from": 89080,
				"to": 92580
			},
			"text": " Writing one full novel would provide enough energy to run a laptop for a total of about"
		},
		{
			"timestamps": {
				"from": "00:01:32,580",
				"to": "00:01:33,900"
			},
			"offsets": {
				"from": 92580,
				"to": 93900
			},
			"text": " 30 seconds."
		},
		{
			"timestamps": {
				"from": "00:01:33,900",
				"to": "00:01:37,400"
			},
			"offsets": {
				"from": 93900,
				"to": 97400
			},
			"text": " If each novel takes you six months, you'd spend two seconds out of every million running"
		},
		{
			"timestamps": {
				"from": "00:01:37,400",
				"to": "00:01:38,400"
			},
			"offsets": {
				"from": 97400,
				"to": 98400
			},
			"text": " off keyboard power."
		},
		{
			"timestamps": {
				"from": "00:01:38,400",
				"to": "00:01:42,580"
			},
			"offsets": {
				"from": 98400,
				"to": 102580
			},
			"text": " A novel every six months seems like a lot of typing, but plenty of people type more."
		},
		{
			"timestamps": {
				"from": "00:01:42,580",
				"to": "00:01:46,360"
			},
			"offsets": {
				"from": 102580,
				"to": 106360
			},
			"text": " The site Whatpulse offers tools to track mouse clicks and keystrokes and hosts a community"
		},
		{
			"timestamps": {
				"from": "00:01:46,360",
				"to": "00:01:49,640"
			},
			"offsets": {
				"from": 106360,
				"to": 109640
			},
			"text": " of users who post their statistics online and compete with each other to accumulate the"
		},
		{
			"timestamps": {
				"from": "00:01:49,640",
				"to": "00:01:50,640"
			},
			"offsets": {
				"from": 109640,
				"to": 110640
			},
			"text": " highest totals."
		},
		{
			"timestamps": {
				"from": "00:01:50,640",
				"to": "00:01:54,920"
			},
			"offsets": {
				"from": 110640,
				"to": 114920
			},
			"text": " Whatpulse has been running for over 20 years, and some users have logged over 400 million"
		},
		{
			"timestamps": {
				"from": "00:01:54,920",
				"to": "00:01:56,120"
			},
			"offsets": {
				"from": 114920,
				"to": 116120
			},
			"text": " cumulative key presses."
		},
		{
			"timestamps": {
				"from": "00:01:56,120",
				"to": "00:01:59,920"
			},
			"offsets": {
				"from": 116120,
				"to": 119920
			},
			"text": " A heavy Whatpulse user types the equivalent of one novel every two months, and some of"
		},
		{
			"timestamps": {
				"from": "00:01:59,920",
				"to": "00:02:02,040"
			},
			"offsets": {
				"from": 119920,
				"to": 122040
			},
			"text": " them manage a novel every few weeks."
		},
		{
			"timestamps": {
				"from": "00:02:02,040",
				"to": "00:02:04,320"
			},
			"offsets": {
				"from": 122040,
				"to": 124320
			},
			"text": " But there are even speedier keyboard users."
		},
		{
			"timestamps": {
				"from": "00:02:04,320",
				"to": "00:02:08,360"
			},
			"offsets": {
				"from": 124320,
				"to": 128360
			},
			"text": " If you abandon the requirement of writing actual words and just care about the most key presses,"
		},
		{
			"timestamps": {
				"from": "00:02:08,360",
				"to": "00:02:10,480"
			},
			"offsets": {
				"from": 128360,
				"to": 130480
			},
			"text": " esports is a promising place to look."
		},
		{
			"timestamps": {
				"from": "00:02:10,480",
				"to": "00:02:14,320"
			},
			"offsets": {
				"from": 130480,
				"to": 134320
			},
			"text": " Top esports professionals can clock in over 400 actions per minute, which are a mix of"
		},
		{
			"timestamps": {
				"from": "00:02:14,320",
				"to": "00:02:15,800"
			},
			"offsets": {
				"from": 134320,
				"to": 135800
			},
			"text": " mouse clicks and keystrokes."
		},
		{
			"timestamps": {
				"from": "00:02:15,800",
				"to": "00:02:19,200"
			},
			"offsets": {
				"from": 135800,
				"to": 139200
			},
			"text": " Taking a conservative estimate, a top esports player types the equivalent of a novel in"
		},
		{
			"timestamps": {
				"from": "00:02:19,200",
				"to": "00:02:20,720"
			},
			"offsets": {
				"from": 139200,
				"to": 140720
			},
			"text": " a few days of playing time."
		},
		{
			"timestamps": {
				"from": "00:02:20,720",
				"to": "00:02:24,720"
			},
			"offsets": {
				"from": 140720,
				"to": 144720
			},
			"text": " However, a few days still isn't fast enough to represent much energy."
		},
		{
			"timestamps": {
				"from": "00:02:24,720",
				"to": "00:02:28,240"
			},
			"offsets": {
				"from": 144720,
				"to": 148240
			},
			"text": " Remember, to keep a laptop running from keypress power alone, you'd need to write a novel"
		},
		{
			"timestamps": {
				"from": "00:02:28,240",
				"to": "00:02:29,440"
			},
			"offsets": {
				"from": 148240,
				"to": 149440
			},
			"text": " in half a minute."
		},
		{
			"timestamps": {
				"from": "00:02:29,440",
				"to": "00:02:33,080"
			},
			"offsets": {
				"from": 149440,
				"to": 153080
			},
			"text": " To run a microwave would require one novel per second."
		},
		{
			"timestamps": {
				"from": "00:02:33,080",
				"to": "00:02:36,920"
			},
			"offsets": {
				"from": 153080,
