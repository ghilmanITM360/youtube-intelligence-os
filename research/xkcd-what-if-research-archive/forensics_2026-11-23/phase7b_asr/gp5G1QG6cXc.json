			},
			"offsets": {
				"from": 26300,
				"to": 29620
			},
			"text": " For reference, supersonic speed is 343 meters per second."
		},
		{
			"timestamps": {
				"from": "00:00:29,620",
				"to": "00:00:33,040"
			},
			"offsets": {
				"from": 29620,
				"to": 33040
			},
			"text": " The wind would be highest at the equator, but everyone and everything living between"
