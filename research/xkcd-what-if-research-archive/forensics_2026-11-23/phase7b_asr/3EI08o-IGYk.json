		{
			"timestamps": {
				"from": "00:00:08,400",
				"to": "00:00:11,160"
			},
			"offsets": {
				"from": 8400,
				"to": 11160
			},
			"text": " Let's set aside the question of how we got the baseball moving that fast."
		},
		{
			"timestamps": {
				"from": "00:00:11,160",
				"to": "00:00:14,820"
			},
			"offsets": {
				"from": 11160,
				"to": 14820
			},
			"text": " We'll suppose that it's a normal pitch, except in the instant the pitcher releases the ball,"
