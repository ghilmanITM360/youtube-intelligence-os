				"to": "00:00:23,460"
			},
			"offsets": {
				"from": 20940,
				"to": 23460
			},
			"text": " Most of the world's wealth isn't physical money."
		},
		{
			"timestamps": {
				"from": "00:00:23,460",
				"to": "00:00:27,340"
			},
			"offsets": {
				"from": 23460,
				"to": 27340
			},
			"text": " It's land and houses, bank accounts, businesses, intellectual property, cryptocurrency, and"
