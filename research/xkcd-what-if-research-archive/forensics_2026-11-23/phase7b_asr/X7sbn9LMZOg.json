			},
			"offsets": {
				"from": 0,
				"to": 3460
			},
			"text": " What would happen to the Earth if the Sun suddenly switched off is probably the single"
		},
		{
			"timestamps": {
				"from": "00:00:03,460",
				"to": "00:00:05,360"
			},
			"offsets": {
				"from": 3460,
				"to": 5360
			},
			"text": " most popular question submitted to \"what if.\""
		},
		{
			"timestamps": {
				"from": "00:00:05,360",
				"to": "00:00:06,760"
			},
			"offsets": {
				"from": 5360,
				"to": 6760
			},
			"text": " And it's been answered already."
		},
		{
			"timestamps": {
				"from": "00:00:06,760",
				"to": "00:00:10,260"
			},
			"offsets": {
				"from": 6760,
				"to": 10260
			},
			"text": " A search for \"what if the Sun went out\" turns up lots of excellent articles thoroughly"
		},
		{
			"timestamps": {
				"from": "00:00:10,260",
				"to": "00:00:11,560"
			},
			"offsets": {
				"from": 10260,
				"to": 11560
			},
			"text": " analyzing the situation."
		},
		{
			"timestamps": {
				"from": "00:00:11,560",
				"to": "00:00:15,080"
			},
			"offsets": {
				"from": 11560,
				"to": 15080
			},
			"text": " However, there are a few aspects of this scenario that I thought other answers were missing,"
		},
		{
			"timestamps": {
				"from": "00:00:15,080",
				"to": "00:00:18,920"
			},
			"offsets": {
				"from": 15080,
				"to": 18920
			},
			"text": " so I've decided to add my two cents."
		},
		{
			"timestamps": {
				"from": "00:00:18,920",
				"to": "00:00:20,640"
			},
			"offsets": {
				"from": 18920,
				"to": 20640
			},
			"text": " We won't worry about exactly how it happens."
		},
		{
			"timestamps": {
				"from": "00:00:20,640",
				"to": "00:00:24,480"
			},
			"offsets": {
				"from": 20640,
				"to": 24480
			},
			"text": " We'll just assume that the Sun for some reason becomes a cold inert sphere."
		},
		{
			"timestamps": {
				"from": "00:00:24,480",
				"to": "00:00:27,080"
			},
			"offsets": {
				"from": 24480,
				"to": 27080
			},
			"text": " What would the consequences be for us here on Earth?"
		},
		{
			"timestamps": {
				"from": "00:00:27,080",
				"to": "00:00:30,840"
			},
			"offsets": {
				"from": 27080,
				"to": 30840
			},
			"text": " Under astronomy, without the Sun, ground-based observatories would be able to operate around"
		},
		{
			"timestamps": {
				"from": "00:00:30,840",
				"to": "00:00:31,840"
			},
			"offsets": {
				"from": 30840,
				"to": 31840
			},
			"text": " the clock."
		},
		{
			"timestamps": {
				"from": "00:00:31,840",
				"to": "00:00:34,840"
			},
			"offsets": {
				"from": 31840,
				"to": 34840
			},
			"text": " The cooler air would create less atmospheric noise, which would reduce the load on adaptive"
		},
		{
			"timestamps": {
				"from": "00:00:34,840",
				"to": "00:00:37,800"
			},
			"offsets": {
				"from": 34840,
				"to": 37800
			},
			"text": " optic systems and allow for sharper images."
		},
		{
			"timestamps": {
				"from": "00:00:37,800",
				"to": "00:00:38,800"
			},
			"offsets": {
				"from": 37800,
				"to": 38800
			},
			"text": " Improved satellite service."
		},
		{
			"timestamps": {
				"from": "00:00:38,800",
				"to": "00:00:42,280"
			},
			"offsets": {
				"from": 38800,
				"to": 42280
			},
			"text": " When a communications satellite passes in front of the Sun, the Sun can drown out the"
		},
		{
			"timestamps": {
				"from": "00:00:42,280",
				"to": "00:00:45,040"
			},
			"offsets": {
				"from": 42280,
				"to": 45040
			},
			"text": " satellite's radio signal, causing an interruption in service."
		},
		{
			"timestamps": {
				"from": "00:00:45,040",
				"to": "00:00:47,460"
			},
			"offsets": {
				"from": 45040,
				"to": 47460
			},
			"text": " Deactivating the Sun would solve this problem."
		},
		{
			"timestamps": {
				"from": "00:00:47,460",
				"to": "00:00:48,800"
			},
			"offsets": {
				"from": 47460,
				"to": 48800
			},
			"text": " Easier trade."
		},
		{
			"timestamps": {
				"from": "00:00:48,800",
				"to": "00:00:50,000"
			},
			"offsets": {
				"from": 48800,
				"to": 50000
			},
			"text": " Time zones make trade more expensive."
		},
		{
			"timestamps": {
				"from": "00:00:50,000",
				"to": "00:00:53,400"
			},
			"offsets": {
				"from": 50000,
				"to": 53400
			},
			"text": " It's hard to do business with someone if their office hours don't overlap with yours."
		},
		{
			"timestamps": {
				"from": "00:00:53,400",
				"to": "00:00:56,580"
			},
			"offsets": {
				"from": 53400,
				"to": 56580
			},
			"text": " If the Sun went out, it would eliminate the need for time zones, allowing us to switch"
		},
		{
			"timestamps": {
				"from": "00:00:56,580",
				"to": "00:01:00,520"
			},
			"offsets": {
				"from": 56580,
				"to": 60520
			},
			"text": " to coordinated universal time and give a boost to the global economy."
		},
		{
			"timestamps": {
				"from": "00:01:00,520",
				"to": "00:01:02,120"
			},
			"offsets": {
				"from": 60520,
				"to": 62120
			},
			"text": " Reduced risk of solar flares."
		},
		{
			"timestamps": {
				"from": "00:01:02,120",
				"to": "00:01:05,680"
			},
			"offsets": {
				"from": 62120,
				"to": 65680
			},
			"text": " In 1859, a massive solar flare and geomagnetic storm hit the Earth."
		},
		{
			"timestamps": {
				"from": "00:01:05,680",
				"to": "00:01:10,040"
			},
			"offsets": {
				"from": 65680,
				"to": 70040
			},
			"text": " A basic principle of physics is that changing magnetic fields induce currents and wires."
		},
		{
			"timestamps": {
				"from": "00:01:10,040",
				"to": "00:01:13,920"
			},
			"offsets": {
				"from": 70040,
				"to": 73920
			},
			"text": " Unfortunately for us, by 1859 we had wrapped the Earth in telegraph wires."
		},
		{
			"timestamps": {
				"from": "00:01:13,920",
				"to": "00:01:17,440"
			},
			"offsets": {
				"from": 73920,
				"to": 77440
			},
			"text": " The storm caused powerful currents in those wires, knocking out communications and in some"
		},
		{
			"timestamps": {
				"from": "00:01:17,440",
				"to": "00:01:20,400"
			},
			"offsets": {
				"from": 77440,
				"to": 80400
			},
			"text": " cases causing telegraph equipment to catch fire."
		},
		{
			"timestamps": {
				"from": "00:01:20,400",
				"to": "00:01:23,320"
			},
			"offsets": {
				"from": 80400,
				"to": 83320
			},
			"text": " Since 1859, we've wrapped the Earth in a lot more wires."
		},
		{
			"timestamps": {
				"from": "00:01:23,320",
				"to": "00:01:27,200"
			},
			"offsets": {
				"from": 83320,
				"to": 87200
			},
			"text": " If the 1859 solar flare and storm hit us today, it's estimated that the economic damage"
		},
		{
			"timestamps": {
				"from": "00:01:27,200",
				"to": "00:01:30,160"
			},
			"offsets": {
				"from": 87200,
				"to": 90160
			},
			"text": " to the US alone would be several trillion dollars."
		},
		{
			"timestamps": {
				"from": "00:01:30,160",
				"to": "00:01:32,680"
			},
			"offsets": {
				"from": 90160,
				"to": 92680
			},
			"text": " More than every hurricane which has ever hit the US combined."
		},
		{
			"timestamps": {
				"from": "00:01:32,680",
				"to": "00:01:35,720"
			},
			"offsets": {
				"from": 92680,
				"to": 95720
			},
			"text": " If the Sun went out, this threat would be eliminated."
		},
		{
			"timestamps": {
				"from": "00:01:35,720",
				"to": "00:01:39,080"
			},
			"offsets": {
				"from": 95720,
				"to": 99080
			},
			"text": " We'd also be safe from hurricanes since the ocean would be frozen."
		},
		{
			"timestamps": {
				"from": "00:01:39,080",
				"to": "00:01:40,080"
			},
			"offsets": {
				"from": 99080,
				"to": 100080
			},
			"text": " Cheaper bridges."
		},
		{
			"timestamps": {
				"from": "00:01:40,080",
				"to": "00:01:43,800"
			},
			"offsets": {
				"from": 100080,
				"to": 103800
			},
			"text": " The Department of Transportation estimates that it will cost 20 billion dollars per year"
		},
		{
			"timestamps": {
				"from": "00:01:43,800",
				"to": "00:01:47,200"
			},
			"offsets": {
				"from": 103800,
				"to": 107200
			},
			"text": " over the next 20 years to repair and maintain all US bridges."
		},
		{
			"timestamps": {
				"from": "00:01:47,200",
				"to": "00:01:48,880"
			},
			"offsets": {
				"from": 107200,
				"to": 108880
			},
			"text": " Many US bridges are over water."
		},
		{
			"timestamps": {
				"from": "00:01:48,880",
				"to": "00:01:52,280"
			},
			"offsets": {
				"from": 108880,
				"to": 112280
			},
			"text": " Without the Sun, we could save money by simply driving on a strip of asphalt laid across"
		},
		{
			"timestamps": {
				"from": "00:01:52,280",
				"to": "00:01:53,680"
			},
			"offsets": {
				"from": 112280,
				"to": 113680
			},
			"text": " the ice."
		},
		{
			"timestamps": {
				"from": "00:01:53,680",
				"to": "00:01:54,680"
			},
			"offsets": {
				"from": 113680,
				"to": 114680
			},
			"text": " Safer children."
		},
		{
			"timestamps": {
				"from": "00:01:54,680",
				"to": "00:01:58,000"
			},
			"offsets": {
				"from": 114680,
				"to": 118000
			},
			"text": " According to health experts, babies younger than six months should be kept out of direct"
		},
		{
			"timestamps": {
				"from": "00:01:58,000",
				"to": "00:01:59,000"
			},
			"offsets": {
				"from": 118000,
				"to": 119000
			},
			"text": " sunlight."
		},
		{
			"timestamps": {
				"from": "00:01:59,000",
				"to": "00:02:01,600"
			},
			"offsets": {
				"from": 119000,
				"to": 121600
			},
			"text": " Without sunlight, our children would be safer."
		},
		{
			"timestamps": {
				"from": "00:02:01,600",
				"to": "00:02:02,840"
			},
			"offsets": {
				"from": 121600,
				"to": 122840
			},
			"text": " Safer pilots."
		},
		{
			"timestamps": {
				"from": "00:02:02,840",
				"to": "00:02:05,120"
			},
			"offsets": {
				"from": 122840,
				"to": 125120
			},
			"text": " Many people sneeze when exposed to bright sunlight."
		},
		{
			"timestamps": {
				"from": "00:02:05,120",
				"to": "00:02:08,680"
			},
			"offsets": {
				"from": 125120,
				"to": 128680
			},
			"text": " The reasons for this reflux are unknown, but in some situations it's speculated that it"
		},
		{
			"timestamps": {
				"from": "00:02:08,680",
				"to": "00:02:10,800"
			},
			"offsets": {
				"from": 128680,
				"to": 130800
			},
			"text": " may pose a danger to pilots during flight."
		},
		{
			"timestamps": {
				"from": "00:02:10,800",
				"to": "00:02:15,340"
			},
			"offsets": {
				"from": 130800,
				"to": 135340
			},
			"text": " If the Sun went dark, we could mitigate this potential aviation hazard."
		},
		{
			"timestamps": {
				"from": "00:02:15,340",
				"to": "00:02:16,880"
			},
			"offsets": {
				"from": 135340,
				"to": 136880
			},
			"text": " Stable dust orbits."
		},
		{
			"timestamps": {
				"from": "00:02:16,880",
				"to": "00:02:19,960"
			},
			"offsets": {
				"from": 136880,
				"to": 139960
			},
			"text": " Without sunlight, there would be no pointing Roberts in drag, which means we'd finally"
		},
		{
			"timestamps": {
				"from": "00:02:19,960",
				"to": "00:02:24,000"
			},
			"offsets": {
				"from": 139960,
				"to": 144000
			},
			"text": " be able to place dust into a stable orbit around the Sun without the orbits decaying."
		},
		{
			"timestamps": {
				"from": "00:02:24,000",
				"to": "00:02:28,480"
			},
			"offsets": {
				"from": 144000,
				"to": 148480
			},
			"text": " I'm not sure whether anyone wants to do that, but you never know."
		},
		{
			"timestamps": {
				"from": "00:02:28,480",
				"to": "00:02:29,960"
			},
			"offsets": {
				"from": 148480,
				"to": 149960
			},
			"text": " Safer parsnip."
		},
		{
			"timestamps": {
				"from": "00:02:29,960",
				"to": "00:02:32,200"
			},
			"offsets": {
				"from": 149960,
				"to": 152200
			},
			"text": " Wild parsnip is a surprisingly nasty plant."
		},
		{
			"timestamps": {
				"from": "00:02:32,200",
				"to": "00:02:35,980"
			},
			"offsets": {
				"from": 152200,
				"to": 155980
			},
			"text": " Its leaves contain chemicals called furocumorins, which can be absorbed by human skin without"
		},
		{
			"timestamps": {
				"from": "00:02:35,980",
				"to": "00:02:38,120"
			},
			"offsets": {
				"from": 155980,
				"to": 158120
			},
			"text": " causing symptoms at first."
		},
		{
			"timestamps": {
				"from": "00:02:38,120",
				"to": "00:02:42,800"
			},
			"offsets": {
				"from": 158120,
				"to": 162800
			},
			"text": " However, when the skin is then exposed to sunlight, even days or weeks later, the furocumorins"
		},
		{
			"timestamps": {
				"from": "00:02:42,800",
				"to": "00:02:44,600"
			},
			"offsets": {
				"from": 162800,
				"to": 164600
			},
			"text": " cause a nasty chemical burn."
		},
		{
			"timestamps": {
				"from": "00:02:44,600",
				"to": "00:02:49,880"
			},
			"offsets": {
				"from": 164600,
				"to": 169880
			},
			"text": " This is called phytophotodermatitis, a darkened Sun would liberate us from the parsnip threat."
		},
		{
			"timestamps": {
				"from": "00:02:49,880",
				"to": "00:02:54,120"
			},
			"offsets": {
				"from": 169880,
				"to": 174120
			},
			"text": " In conclusion, if the Sun went out, we would see a variety of benefits across many areas"
		},
		{
			"timestamps": {
				"from": "00:02:54,120",
				"to": "00:02:55,580"
			},
			"offsets": {
				"from": 174120,
				"to": 175580
			},
			"text": " of our lives."
		},
		{
			"timestamps": {
				"from": "00:02:55,580",
				"to": "00:02:58,320"
			},
			"offsets": {
				"from": 175580,
				"to": 178320
			},
			"text": " Are there any downsides to this scenario?"
		},
		{
			"timestamps": {
				"from": "00:02:58,320",
				"to": "00:02:59,320"
			},
			"offsets": {
				"from": 178320,
				"to": 179320
			},
			"text": " Just one."
		},
		{
			"timestamps": {
				"from": "00:02:59,320",
				"to": "00:03:00,160"
			},
			"offsets": {
				"from": 179320,
				"to": 180160
			},
			"text": " We would all freeze and die."
