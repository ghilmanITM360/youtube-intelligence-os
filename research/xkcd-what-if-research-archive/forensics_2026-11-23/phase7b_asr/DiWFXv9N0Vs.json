			},
			"offsets": {
				"from": 83920,
				"to": 88040
			},
			"text": " The most energy we've really observed is in cosmic rays, more than the LHC by circuit"
		},
		{
			"timestamps": {
				"from": "00:01:28,040",
				"to": "00:01:31,160"
			},
			"offsets": {
				"from": 88040,
				"to": 91160
			},
			"text": " 10 to the 6th, I think, but still not close to the Planck energy."
		},
		{
			"timestamps": {
				"from": "00:01:31,160",
				"to": "00:01:34,320"
			},
			"offsets": {
				"from": 91160,
				"to": 94320
			},
			"text": " Being a string theorist, I'm tempted to say something stringy would happen, but the truth"
		},
		{
			"timestamps": {
				"from": "00:01:34,320",
				"to": "00:01:36,340"
			},
			"offsets": {
				"from": 94320,
