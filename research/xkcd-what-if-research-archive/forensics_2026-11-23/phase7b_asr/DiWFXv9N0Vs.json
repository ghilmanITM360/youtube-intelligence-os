		},
		{
			"timestamps": {
				"from": "00:01:36,340",
				"to": "00:01:38,080"
			},
			"offsets": {
				"from": 96340,
				"to": 98080
			},
			"text": " Luckily, that's not the end of the story."
		},
		{
			"timestamps": {
				"from": "00:01:38,080",
				"to": "00:01:40,080"
			},
			"offsets": {
				"from": 98080,
				"to": 100080
			},
			"text": " Remember how we're ignoring general relativity?"
