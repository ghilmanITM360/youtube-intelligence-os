			"timestamps": {
				"from": "00:02:10,820",
				"to": "00:02:12,700"
			},
			"offsets": {
				"from": 130820,
				"to": 132700
			},
			"text": " you'll run out of fuel constantly."
		},
		{
			"timestamps": {
				"from": "00:02:12,700",
				"to": "00:02:14,180"
			},
			"offsets": {
				"from": 132700,
				"to": 134180
			},
			"text": " Gas mileage in the U.S. is often measured"
		},
		{
			"timestamps": {
				"from": "00:02:14,180",
				"to": "00:02:16,180"
			},
			"offsets": {
				"from": 134180,
				"to": 136180
			},
			"text": " in miles per gallon of gasoline."
		},
		{
			"timestamps": {
				"from": "00:02:16,180",
				"to": "00:02:17,540"
			},
			"offsets": {
				"from": 136180,
				"to": 137540
			},
			"text": " With your flamethrower guzzling fuel,"
		},
		{
			"timestamps": {
				"from": "00:02:17,540",
				"to": "00:02:19,820"
			},
			"offsets": {
				"from": 137540,
				"to": 139820
			},
			"text": " your mileage would be about 17 feet per gallon,"
		},
		{
			"timestamps": {
				"from": "00:02:19,820",
				"to": "00:02:20,700"
			},
			"offsets": {
				"from": 139820,
				"to": 140700
			},
			"text": " and you'd be using up fuel"
		},
		{
			"timestamps": {
				"from": "00:02:20,700",
				"to": "00:02:23,100"
			},
			"offsets": {
				"from": 140700,
				"to": 143100
			},
			"text": " at a rate of almost five gallons per second."
		},
		{
			"timestamps": {
				"from": "00:02:23,100",
				"to": "00:02:24,260"
			},
			"offsets": {
				"from": 143100,
				"to": 144260
			},
			"text": " You'd probably be better off"
		},
		{
			"timestamps": {
				"from": "00:02:24,260",
				"to": "00:02:25,900"
			},
			"offsets": {
				"from": 144260,
				"to": 145900
			},
			"text": " dropping the melting idea entirely"
		},
		{
			"timestamps": {
				"from": "00:02:25,900",
				"to": "00:02:27,460"
			},
			"offsets": {
				"from": 145900,
				"to": 147460
			},
			"text": " and taking a cue from rail agencies"
		},
		{
			"timestamps": {
				"from": "00:02:27,460",
				"to": "00:02:29,060"
			},
			"offsets": {
				"from": 147460,
				"to": 149060
			},
			"text": " who use jet-engine-powered snowblowers"
		},
		{
			"timestamps": {
				"from": "00:02:29,060",
				"to": "00:02:30,340"
			},
			"offsets": {
				"from": 149060,
				"to": 150340
			},
			"text": " to clear train tracks."
		},
		{
			"timestamps": {
				"from": "00:02:30,340",
				"to": "00:02:33,380"
			},
			"offsets": {
				"from": 150340,
				"to": 153380
			},
			"text": " In the end, it's easier to just move the snow out of your way."
		},
		{
			"timestamps": {
				"from": "00:02:33,380",
				"to": "00:02:34,540"
			},
			"offsets": {
				"from": 153380,
				"to": 154540
			},
			"text": " So it turns out Matt was right"
		},
		{
			"timestamps": {
				"from": "00:02:34,540",
				"to": "00:02:36,420"
			},
			"offsets": {
				"from": 154540,
				"to": 156420
			},
			"text": " about the flamethrower being impractical."
		},
		{
			"timestamps": {
				"from": "00:02:36,420",
				"to": "00:02:37,780"
			},
			"offsets": {
				"from": 156420,
				"to": 157780
			},
			"text": " Although, if you're not careful"
		},
		{
			"timestamps": {
				"from": "00:02:37,780",
				"to": "00:02:39,260"
			},
			"offsets": {
				"from": 157780,
				"to": 159260
			},
			"text": " with the jet-engine snowblower,"
		},
		{
			"timestamps": {
				"from": "00:02:39,260",
				"to": "00:02:41,460"
			},
			"offsets": {
				"from": 159260,
				"to": 161460
			},
			"text": " you might run into a different problem."
		},
		{
			"timestamps": {
				"from": "00:02:42,460",
				"to": "00:02:44,960"
			},
			"offsets": {
				"from": 162460,
				"to": 164960
			},
			"text": " (light music)"
		}
	]
}
