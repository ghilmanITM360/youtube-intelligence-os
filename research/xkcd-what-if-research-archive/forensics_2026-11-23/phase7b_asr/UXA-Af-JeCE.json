				"to": "00:01:31,100"
			},
			"offsets": {
				"from": 89060,
				"to": 91100
			},
			"text": " The energy absorbed by your skin would be minor,"
		},
		{
			"timestamps": {
				"from": "00:01:31,100",
				"to": "00:01:32,540"
			},
			"offsets": {
				"from": 91100,
				"to": 92540
			},
			"text": " about 10 to the minus five joules"
		},
		{
			"timestamps": {
				"from": "00:01:32,540",
				"to": "00:01:34,660"
			},
			"offsets": {
				"from": 92540,
