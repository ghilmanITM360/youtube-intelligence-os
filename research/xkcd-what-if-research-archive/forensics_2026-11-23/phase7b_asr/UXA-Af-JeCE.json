		},
		{
			"timestamps": {
				"from": "00:01:34,660",
				"to": "00:01:37,940"
			},
			"offsets": {
				"from": 94660,
				"to": 97940
			},
			"text": " For comparison, according to the IEEE P1584 standard,"
		},
		{
			"timestamps": {
				"from": "00:01:37,940",
				"to": "00:01:40,120"
			},
			"offsets": {
				"from": 97940,
				"to": 100120
			},
