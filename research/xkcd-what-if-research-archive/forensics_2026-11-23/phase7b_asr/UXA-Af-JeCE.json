		},
		{
			"timestamps": {
				"from": "00:02:12,100",
				"to": "00:02:13,060"
			},
			"offsets": {
				"from": 132100,
				"to": 133060
			},
			"text": " It's not good."
		},
		{
			"timestamps": {
				"from": "00:02:13,060",
				"to": "00:02:15,580"
			},
			"offsets": {
				"from": 133060,
				"to": 135580
			},
			"text": " You exceed the IEEE 1584B standard"
		},
		{
			"timestamps": {
				"from": "00:02:15,580",
				"to": "00:02:18,660"
			},
			"offsets": {
				"from": 135580,
				"to": 138660
			},
			"text": " for second degree burns after one femtosecond in the sun."
		},
		{
			"timestamps": {
				"from": "00:02:18,660",
				"to": "00:02:20,620"
			},
			"offsets": {
				"from": 138660,
				"to": 140620
			},
			"text": " A nanosecond, the time you're spending there,"
		},
		{
			"timestamps": {
				"from": "00:02:20,620",
				"to": "00:02:22,180"
			},
			"offsets": {
				"from": 140620,
				"to": 142180
			},
			"text": " is a million femtoseconds."
		},
		{
			"timestamps": {
				"from": "00:02:22,180",
				"to": "00:02:23,660"
			},
			"offsets": {
				"from": 142180,
				"to": 143660
			},
			"text": " This doesn't end well for you."
		},
		{
			"timestamps": {
				"from": "00:02:23,660",
				"to": "00:02:24,900"
			},
			"offsets": {
				"from": 143660,
				"to": 144900
			},
			"text": " But there's some good news."
		},
		{
			"timestamps": {
				"from": "00:02:24,900",
				"to": "00:02:26,660"
			},
			"offsets": {
				"from": 144900,
				"to": 146660
			},
			"text": " Deep in the sun, the photons carrying energy"
		},
		{
			"timestamps": {
				"from": "00:02:26,660",
				"to": "00:02:28,220"
			},
			"offsets": {
				"from": 146660,
				"to": 148220
			},
			"text": " are out of very short wavelengths."
		},
		{
			"timestamps": {
				"from": "00:02:28,220",
				"to": "00:02:29,340"
			},
			"offsets": {
				"from": 148220,
				"to": 149340
			},
			"text": " They're not visible light."
		},
		{
			"timestamps": {
				"from": "00:02:29,340",
				"to": "00:02:30,860"
			},
			"offsets": {
				"from": 149340,
				"to": 150860
			},
			"text": " They're mostly a mix of what we consider"
		},
		{
			"timestamps": {
				"from": "00:02:30,860",
				"to": "00:02:32,260"
			},
			"offsets": {
				"from": 150860,
				"to": 152260
			},
			"text": " hard and soft X-rays."
		},
		{
			"timestamps": {
				"from": "00:02:32,260",
				"to": "00:02:34,060"
			},
			"offsets": {
				"from": 152260,
				"to": 154060
			},
			"text": " This means that they penetrate into your body"
		},
		{
			"timestamps": {
				"from": "00:02:34,060",
				"to": "00:02:36,060"
			},
			"offsets": {
				"from": 154060,
				"to": 156060
			},
			"text": " to various depths, heating your internal organs"
		},
		{
			"timestamps": {
				"from": "00:02:36,060",
				"to": "00:02:38,820"
			},
			"offsets": {
				"from": 156060,
				"to": 158820
			},
			"text": " and also ionizing your DNA, causing irreversible damage"
		},
		{
			"timestamps": {
				"from": "00:02:38,820",
				"to": "00:02:40,420"
			},
			"offsets": {
				"from": 158820,
				"to": 160420
			},
			"text": " before they even start burning you."
		},
		{
			"timestamps": {
				"from": "00:02:40,420",
				"to": "00:02:42,060"
			},
			"offsets": {
				"from": 160420,
				"to": 162060
			},
			"text": " Looking back, I realize I started that"
		},
		{
			"timestamps": {
				"from": "00:02:42,060",
				"to": "00:02:43,660"
			},
			"offsets": {
				"from": 162060,
				"to": 163660
			},
			"text": " by saying there's some good news."
		},
		{
			"timestamps": {
				"from": "00:02:43,660",
				"to": "00:02:44,700"
			},
			"offsets": {
				"from": 163660,
				"to": 164700
			},
			"text": " I don't know why I did that."
		},
		{
			"timestamps": {
				"from": "00:02:44,700",
				"to": "00:02:46,740"
			},
			"offsets": {
				"from": 164700,
				"to": 166740
			},
			"text": " Don't spend a nanosecond inside the sun."
		},
		{
			"timestamps": {
				"from": "00:02:46,740",
				"to": "00:02:49,180"
			},
			"offsets": {
				"from": 166740,
				"to": 169180
			},
			"text": " In Greek legend, Icarus flew too close to the sun"
		},
		{
			"timestamps": {
				"from": "00:02:49,180",
				"to": "00:02:51,660"
			},
			"offsets": {
				"from": 169180,
				"to": 171660
			},
			"text": " and the heat melted his wings and he fell to his death."
		},
		{
			"timestamps": {
				"from": "00:02:51,660",
				"to": "00:02:54,300"
			},
			"offsets": {
				"from": 171660,
				"to": 174300
			},
			"text": " It's true that the temperature is higher closer to the sun,"
		},
		{
			"timestamps": {
				"from": "00:02:54,300",
				"to": "00:02:56,460"
			},
			"offsets": {
				"from": 174300,
				"to": 176460
			},
			"text": " but temperature and heat aren't the same thing."
		},
		{
			"timestamps": {
				"from": "00:02:56,460",
				"to": "00:02:58,900"
			},
			"offsets": {
				"from": 176460,
				"to": 178900
			},
			"text": " Melting, or any phase change of a substance,"
		},
		{
			"timestamps": {
				"from": "00:02:58,900",
				"to": "00:03:00,820"
			},
			"offsets": {
				"from": 178900,
				"to": 180820
			},
			"text": " requires the absorption of a specific amount"
		},
		{
			"timestamps": {
				"from": "00:03:00,820",
				"to": "00:03:02,460"
			},
			"offsets": {
				"from": 180820,
				"to": 182460
			},
			"text": " of heat energy per kilogram."
		},
		{
			"timestamps": {
				"from": "00:03:02,460",
				"to": "00:03:03,860"
			},
			"offsets": {
				"from": 182460,
				"to": 183860
			},
			"text": " And the heat absorbed is a function"
		},
		{
			"timestamps": {
				"from": "00:03:03,860",
				"to": "00:03:05,500"
			},
			"offsets": {
				"from": 183860,
				"to": 185500
			},
			"text": " of both the temperature and the length"
		},
		{
			"timestamps": {
				"from": "00:03:05,500",
				"to": "00:03:06,820"
			},
			"offsets": {
				"from": 185500,
				"to": 186820
			},
			"text": " of time you're exposed to it."
		},
		{
			"timestamps": {
				"from": "00:03:06,820",
				"to": "00:03:08,460"
			},
			"offsets": {
				"from": 186820,
				"to": 188460
			},
			"text": " Which brings us back to Icarus."
		},
		{
			"timestamps": {
				"from": "00:03:08,460",
				"to": "00:03:11,220"
			},
			"offsets": {
				"from": 188460,
				"to": 191220
			},
			"text": " His wings didn't melt because he flew too close to the sun."
		},
		{
			"timestamps": {
				"from": "00:03:11,220",
				"to": "00:03:13,700"
			},
			"offsets": {
				"from": 191220,
				"to": 193700
			},
			"text": " They melted because he spent too much time there."
		},
		{
			"timestamps": {
				"from": "00:03:13,700",
				"to": "00:03:16,820"
			},
			"offsets": {
				"from": 193700,
				"to": 196820
			},
			"text": " Visit briefly in little hops and you can go anywhere."
		},
		{
			"timestamps": {
				"from": "00:03:16,820",
				"to": "00:03:18,820"
			},
			"offsets": {
				"from": 196820,
				"to": 198820
			},
			"text": " (meows)"
		},
		{
			"timestamps": {
				"from": "00:03:18,820",
				"to": "00:03:21,400"
			},
			"offsets": {
				"from": 198820,
				"to": 201400
			},
			"text": " (gentle music)"
		},
		{
			"timestamps": {
				"from": "00:03:24,300",
				"to": "00:03:26,880"
			},
			"offsets": {
				"from": 204300,
				"to": 206880
			},
			"text": " (gentle music)"
		}
	]
}
