	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:02,260"
			},
			"offsets": {
				"from": 0,
				"to": 2260
			},
			"text": " This question comes from AJ, who wrote,"
		},
		{
			"timestamps": {
				"from": "00:00:02,260",
				"to": "00:00:03,420"
			},
			"offsets": {
				"from": 2260,
				"to": 3420
			},
			"text": " \"When I was about eight years old,"
		},
		{
			"timestamps": {
				"from": "00:00:03,420",
				"to": "00:00:05,420"
			},
			"offsets": {
				"from": 3420,
				"to": 5420
			},
			"text": " shoveling snow on a freezing day in Colorado,"
		},
		{
			"timestamps": {
				"from": "00:00:05,420",
				"to": "00:00:07,260"
			},
			"offsets": {
				"from": 5420,
				"to": 7260
			},
			"text": " I wished that I could instantly be transported"
		},
		{
			"timestamps": {
				"from": "00:00:07,260",
				"to": "00:00:09,460"
			},
			"offsets": {
				"from": 7260,
				"to": 9460
			},
			"text": " to the surface of the sun, just for a nanosecond,"
		},
		{
			"timestamps": {
				"from": "00:00:09,460",
				"to": "00:00:11,100"
			},
			"offsets": {
				"from": 9460,
				"to": 11100
			},
			"text": " and then instantly transported back."
		},
		{
			"timestamps": {
				"from": "00:00:11,100",
				"to": "00:00:12,860"
			},
			"offsets": {
				"from": 11100,
				"to": 12860
			},
			"text": " I figured this would be long enough to warm me up,"
		},
		{
			"timestamps": {
				"from": "00:00:12,860",
				"to": "00:00:14,220"
			},
			"offsets": {
				"from": 12860,
				"to": 14220
			},
			"text": " but not enough to harm me.\""
		},
		{
			"timestamps": {
				"from": "00:00:14,220",
				"to": "00:00:15,420"
			},
			"offsets": {
				"from": 14220,
				"to": 15420
			},
			"text": " What would actually happen?"
		},
		{
			"timestamps": {
				"from": "00:00:17,260",
				"to": "00:00:19,580"
			},
			"offsets": {
				"from": 17260,
				"to": 19580
			},
			"text": " Believe it or not, this wouldn't even warm you."
		},
		{
			"timestamps": {
				"from": "00:00:19,580",
				"to": "00:00:20,860"
			},
			"offsets": {
				"from": 19580,
				"to": 20860
			},
			"text": " The temperature of the surface of the sun"
		},
		{
			"timestamps": {
				"from": "00:00:20,860",
				"to": "00:00:22,740"
			},
			"offsets": {
				"from": 20860,
				"to": 22740
			},
			"text": " is about 5,800 K, give or take."
		},
		{
			"timestamps": {
				"from": "00:00:22,740",
				"to": "00:00:23,980"
			},
			"offsets": {
				"from": 22740,
				"to": 23980
			},
			"text": " If you stayed there for a while,"
		},
		{
			"timestamps": {
				"from": "00:00:23,980",
				"to": "00:00:25,100"
			},
			"offsets": {
				"from": 23980,
				"to": 25100
			},
			"text": " you'd be cooked to a cinder,"
		},
		{
			"timestamps": {
				"from": "00:00:25,100",
				"to": "00:00:26,980"
			},
			"offsets": {
				"from": 25100,
				"to": 26980
			},
			"text": " but a nanosecond is not very long."
		},
		{
			"timestamps": {
				"from": "00:00:26,980",
				"to": "00:00:29,540"
			},
			"offsets": {
				"from": 26980,
				"to": 29540
			},
			"text": " It's enough time for light to travel about a foot."
		},
		{
			"timestamps": {
				"from": "00:00:29,540",
				"to": "00:00:31,380"
			},
			"offsets": {
				"from": 29540,
				"to": 31380
			},
			"text": " I'm gonna assume you're facing toward the sun."
		},
		{
			"timestamps": {
				"from": "00:00:31,380",
				"to": "00:00:33,700"
			},
			"offsets": {
				"from": 31380,
				"to": 33700
			},
			"text": " In general, you should avoid looking directly at the sun,"
		},
		{
			"timestamps": {
				"from": "00:00:33,700",
				"to": "00:00:35,300"
			},
			"offsets": {
				"from": 33700,
				"to": 35300
			},
			"text": " but it's hard to avoid when it takes up"
		},
		{
			"timestamps": {
				"from": "00:00:35,300",
				"to": "00:00:37,380"
			},
			"offsets": {
				"from": 35300,
				"to": 37380
			},
			"text": " a full 180 degrees of your view."
		},
		{
			"timestamps": {
				"from": "00:00:37,380",
				"to": "00:00:39,420"
			},
			"offsets": {
				"from": 37380,
				"to": 39420
			},
			"text": " In that nanosecond, about a microjoule of energy"
		},
		{
			"timestamps": {
				"from": "00:00:39,420",
				"to": "00:00:40,660"
			},
			"offsets": {
				"from": 39420,
				"to": 40660
			},
			"text": " would enter your eye."
		},
		{
			"timestamps": {
				"from": "00:00:40,660",
				"to": "00:00:42,340"
			},
			"offsets": {
				"from": 40660,
				"to": 42340
			},
			"text": " A microjoule of light is not a lot."
		},
		{
			"timestamps": {
				"from": "00:00:42,340",
				"to": "00:00:44,340"
			},
			"offsets": {
				"from": 42340,
				"to": 44340
			},
			"text": " If you start a computer monitor with your eyes closed,"
		},
		{
			"timestamps": {
				"from": "00:00:44,340",
				"to": "00:00:46,380"
			},
			"offsets": {
				"from": 44340,
				"to": 46380
			},
			"text": " and then you open them and shut them very quickly,"
		},
		{
			"timestamps": {
				"from": "00:00:46,380",
				"to": "00:00:47,820"
			},
			"offsets": {
				"from": 46380,
				"to": 47820
			},
			"text": " your eye will take in about as much light"
		},
		{
			"timestamps": {
				"from": "00:00:47,820",
				"to": "00:00:49,420"
			},
			"offsets": {
				"from": 47820,
				"to": 49420
			},
			"text": " from the screen during your reverse blink"
		},
		{
			"timestamps": {
				"from": "00:00:49,420",
				"to": "00:00:51,760"
			},
			"offsets": {
				"from": 49420,
				"to": 51760
			},
			"text": " as it would during a nanosecond on the sun's surface."
		},
		{
			"timestamps": {
				"from": "00:00:51,760",
				"to": "00:00:52,740"
			},
			"offsets": {
				"from": 51760,
				"to": 52740
			},
			"text": " Is there a word for that?"
		},
		{
			"timestamps": {
				"from": "00:00:52,740",
				"to": "00:00:54,740"
			},
			"offsets": {
				"from": 52740,
				"to": 54740
			},
			"text": " Like a blink, but in reverse?"
		},
		{
			"timestamps": {
				"from": "00:00:54,740",
				"to": "00:00:56,280"
			},
			"offsets": {
				"from": 54740,
				"to": 56280
			},
			"text": " I feel like there should be a word for that."
		},
		{
			"timestamps": {
				"from": "00:00:56,280",
				"to": "00:00:58,420"
			},
			"offsets": {
				"from": 56280,
				"to": 58420
			},
			"text": " Anyway, during the nanosecond on the sun,"
		},
		{
			"timestamps": {
				"from": "00:00:58,420",
				"to": "00:01:00,220"
			},
			"offsets": {
				"from": 58420,
				"to": 60220
			},
			"text": " photons from the sun would flood into your eye"
