		{
			"timestamps": {
				"from": "00:01:07,180",
				"to": "00:01:10,320"
			},
			"offsets": {
				"from": 67180,
				"to": 70320
			},
			"text": " Over the next few million nanoseconds, or milliseconds,"
		},
		{
			"timestamps": {
