				"to": "00:01:01,620"
			},
			"offsets": {
				"from": 60220,
				"to": 61620
			},
			"text": " and strike your retinal cells."
		},
		{
			"timestamps": {
				"from": "00:01:01,620",
				"to": "00:01:04,340"
			},
			"offsets": {
				"from": 61620,
				"to": 64340
			},
			"text": " Then, at the end of the nanosecond, you'd jump back home."
