				"to": "00:01:12,940"
			},
			"offsets": {
				"from": 70320,
				"to": 72940
			},
			"text": " the retinal cells, having absorbed a bunch of light energy,"
		},
		{
			"timestamps": {
				"from": "00:01:12,940",
				"to": "00:01:14,860"
			},
			"offsets": {
				"from": 72940,
				"to": 74860
			},
			"text": " would get into gear and start signaling to your brain"
		},
		{
			"timestamps": {
				"from": "00:01:14,860",
				"to": "00:01:16,220"
			},
			"offsets": {
				"from": 74860,
				"to": 76220
			},
			"text": " that something had happened."
		},
		{
			"timestamps": {
				"from": "00:01:16,220",
				"to": "00:01:18,080"
			},
			"offsets": {
				"from": 76220,
				"to": 78080
			},
			"text": " You would spend one nanosecond on the sun,"
		},
		{
			"timestamps": {
				"from": "00:01:18,080",
				"to": "00:01:19,960"
			},
			"offsets": {
				"from": 78080,
				"to": 79960
			},
			"text": " but it would take 30 million nanoseconds"
		},
		{
			"timestamps": {
				"from": "00:01:19,960",
				"to": "00:01:21,260"
			},
			"offsets": {
				"from": 79960,
				"to": 81260
			},
			"text": " for your brain to notice."
		},
		{
			"timestamps": {
				"from": "00:01:21,260",
				"to": "00:01:23,500"
			},
			"offsets": {
				"from": 81260,
				"to": 83500
			},
