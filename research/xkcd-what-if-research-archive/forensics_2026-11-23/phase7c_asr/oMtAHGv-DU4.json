	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:02,120"
			},
			"offsets": {
				"from": 0,
				"to": 2120
			},
			"text": " Have you ever tried to make a tower out of Jell-O?"
		},
		{
			"timestamps": {
				"from": "00:00:02,120",
				"to": "00:00:05,640"
			},
			"offsets": {
				"from": 2120,
				"to": 5640
			},
			"text": " It's easy to make a little, tiny, wobbly Jell-O castle - in fact, some people like"
		},
		{
			"timestamps": {
				"from": "00:00:05,640",
				"to": "00:00:09,880"
			},
			"offsets": {
				"from": 5640,
				"to": 9880
			},
			"text": " to serve fancy Jell-O that way - but if you try to make a really big Jell-O castle, the"
		},
		{
			"timestamps": {
				"from": "00:00:09,880",
				"to": "00:00:11,800"
			},
			"offsets": {
				"from": 9880,
				"to": 11800
			},
			"text": " whole thing smushes down on itself."
		},
		{
			"timestamps": {
				"from": "00:00:11,800",
				"to": "00:00:13,940"
			},
			"offsets": {
				"from": 11800,
				"to": 13940
			},
			"text": " The same thing happens with buildings, eventually."
		},
		{
			"timestamps": {
				"from": "00:00:13,940",
				"to": "00:00:15,280"
			},
			"offsets": {
				"from": 13940,
				"to": 15280
			},
			"text": " The buildings we make are strong."
		},
		{
			"timestamps": {
				"from": "00:00:15,280",
				"to": "00:00:18,840"
			},
			"offsets": {
				"from": 15280,
				"to": 18840
			},
			"text": " The tallest are almost a kilometer tall, and we could probably make buildings two or even"
		},
		{
			"timestamps": {
				"from": "00:00:18,840",
				"to": "00:00:21,860"
			},
			"offsets": {
				"from": 18840,
				"to": 21860
			},
			"text": " three kilometers tall if we wanted, and they would still be able to stand up under their"
		},
		{
			"timestamps": {
				"from": "00:00:21,860",
				"to": "00:00:22,860"
			},
			"offsets": {
				"from": 21860,
				"to": 22860
			},
			"text": " own weight."
		},
		{
			"timestamps": {
				"from": "00:00:22,860",
				"to": "00:00:25,320"
			},
			"offsets": {
				"from": 22860,
				"to": 25320
			},
			"text": " But too much higher, and we'd run into the Jell-O problem."
		},
		{
			"timestamps": {
				"from": "00:00:25,320",
				"to": "00:00:27,400"
			},
			"offsets": {
				"from": 25320,
				"to": 27400
			},
			"text": " The top part would squish the bottom part."
		},
		{
			"timestamps": {
				"from": "00:00:27,400",
				"to": "00:00:29,660"
			},
			"offsets": {
				"from": 27400,
				"to": 29660
			},
			"text": " There are other problems with tall buildings, too."
		},
		{
			"timestamps": {
				"from": "00:00:29,660",
				"to": "00:00:30,880"
			},
			"offsets": {
				"from": 29660,
				"to": 30880
			},
			"text": " One is wind."
		},
		{
			"timestamps": {
				"from": "00:00:30,880",
				"to": "00:00:35,160"
			},
			"offsets": {
				"from": 30880,
				"to": 35160
			},
			"text": " The wind up high is very strong, and buildings have to be very strong to stand up against"
		},
		{
			"timestamps": {
				"from": "00:00:35,160",
				"to": "00:00:36,160"
			},
			"offsets": {
				"from": 35160,
				"to": 36160
			},
			"text": " the wind."
		},
		{
			"timestamps": {
				"from": "00:00:36,160",
				"to": "00:00:38,860"
			},
			"offsets": {
				"from": 36160,
				"to": 38860
			},
			"text": " Another problem is, surprisingly, elevators."
		},
		{
			"timestamps": {
				"from": "00:00:38,860",
				"to": "00:00:42,520"
			},
			"offsets": {
				"from": 38860,
				"to": 42520
			},
			"text": " Tall buildings need elevators, since no one wants to climb hundreds of flights of stairs."
		},
		{
			"timestamps": {
				"from": "00:00:42,520",
				"to": "00:00:45,380"
			},
			"offsets": {
				"from": 42520,
				"to": 45380
			},
			"text": " If your building has lots of floors, you need lots of different elevators to get all the"
		},
		{
			"timestamps": {
				"from": "00:00:45,380",
				"to": "00:00:47,280"
			},
			"offsets": {
				"from": 45380,
				"to": 47280
			},
			"text": " people where they're trying to go at once."
		},
		{
			"timestamps": {
				"from": "00:00:47,280",
				"to": "00:00:51,080"
			},
			"offsets": {
				"from": 47280,
				"to": 51080
			},
			"text": " Some of our existing tall buildings have floors purely dedicated to letting people change from"
		},
		{
			"timestamps": {
				"from": "00:00:51,080",
				"to": "00:00:52,480"
			},
			"offsets": {
				"from": 51080,
				"to": 52480
			},
			"text": " one elevator to another."
		},
		{
			"timestamps": {
				"from": "00:00:52,480",
				"to": "00:00:55,600"
			},
			"offsets": {
				"from": 52480,
				"to": 55600
			},
			"text": " If you make a building too tall, the whole thing gets taken up by elevators and there's"
		},
		{
			"timestamps": {
				"from": "00:00:55,600",
				"to": "00:00:57,680"
			},
			"offsets": {
				"from": 55600,
				"to": 57680
			},
			"text": " no space for regular rooms."
		},
		{
			"timestamps": {
				"from": "00:00:57,680",
				"to": "00:00:59,080"
			},
			"offsets": {
				"from": 57680,
				"to": 59080
			},
			"text": " Another big problem is money."
		},
		{
			"timestamps": {
				"from": "00:00:59,080",
				"to": "00:01:02,440"
			},
			"offsets": {
				"from": 59080,
				"to": 62440
			},
			"text": " A building several miles tall would cost many billions of dollars."
		},
		{
			"timestamps": {
				"from": "00:01:02,440",
				"to": "00:01:06,320"
			},
			"offsets": {
				"from": 62440,
				"to": 66320
			},
			"text": " And most people don't think giant towers a few miles tall are important enough to spend"
		},
		{
			"timestamps": {
				"from": "00:01:06,320",
				"to": "00:01:07,360"
			},
			"offsets": {
				"from": 66320,
				"to": 67360
			},
			"text": " billions of dollars on."
		}
	]
