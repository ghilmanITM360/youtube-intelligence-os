	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:02,220"
			},
			"offsets": {
				"from": 0,
				"to": 2220
			},
			"text": " This question comes from AJ, who wrote,"
		},
		{
			"timestamps": {
				"from": "00:00:02,220",
				"to": "00:00:03,300"
			},
			"offsets": {
				"from": 2220,
				"to": 3300
			},
			"text": " \"When I was about eight years old,"
		},
		{
			"timestamps": {
				"from": "00:00:03,300",
				"to": "00:00:05,300"
			},
			"offsets": {
				"from": 3300,
				"to": 5300
			},
			"text": " \"shoveling snow on a freezing day in Colorado,"
		},
		{
			"timestamps": {
				"from": "00:00:05,300",
				"to": "00:00:07,140"
			},
			"offsets": {
				"from": 5300,
				"to": 7140
			},
			"text": " \"I wished that I could instantly be transported"
		},
		{
			"timestamps": {
				"from": "00:00:07,140",
				"to": "00:00:09,340"
			},
			"offsets": {
				"from": 7140,
				"to": 9340
			},
			"text": " \"to the surface of the sun, just for a nanosecond,"
		},
		{
			"timestamps": {
				"from": "00:00:09,340",
				"to": "00:00:10,940"
			},
			"offsets": {
				"from": 9340,
				"to": 10940
			},
			"text": " \"and then instantly transport it back."
		},
		{
			"timestamps": {
				"from": "00:00:10,940",
				"to": "00:00:12,140"
			},
			"offsets": {
				"from": 10940,
				"to": 12140
			},
			"text": " \"What would actually happen?"
		},
		{
			"timestamps": {
				"from": "00:00:12,140",
				"to": "00:00:14,420"
			},
			"offsets": {
				"from": 12140,
				"to": 14420
			},
			"text": " \"Believe it or not, this wouldn't even warm you."
		},
		{
			"timestamps": {
				"from": "00:00:14,420",
				"to": "00:00:15,680"
			},
			"offsets": {
				"from": 14420,
				"to": 15680
			},
			"text": " \"The temperature of the surface of the sun"
		},
		{
			"timestamps": {
				"from": "00:00:15,680",
				"to": "00:00:17,600"
			},
			"offsets": {
				"from": 15680,
				"to": 17600
			},
			"text": " \"is about 5,800 K, give or take."
		},
		{
			"timestamps": {
				"from": "00:00:17,600",
				"to": "00:00:18,800"
			},
			"offsets": {
				"from": 17600,
				"to": 18800
			},
			"text": " \"If you stayed there for a while,"
		},
		{
			"timestamps": {
				"from": "00:00:18,800",
				"to": "00:00:19,940"
			},
			"offsets": {
				"from": 18800,
				"to": 19940
			},
			"text": " \"you'd be cooked to a cinder."
		},
		{
			"timestamps": {
				"from": "00:00:19,940",
				"to": "00:00:21,800"
			},
			"offsets": {
				"from": 19940,
				"to": 21800
			},
			"text": " \"But a nanosecond is not very long."
		},
		{
			"timestamps": {
				"from": "00:00:21,800",
				"to": "00:00:24,360"
			},
			"offsets": {
				"from": 21800,
				"to": 24360
			},
			"text": " \"It's enough time for light to travel about a foot."
		},
		{
			"timestamps": {
				"from": "00:00:24,360",
				"to": "00:00:26,380"
			},
			"offsets": {
				"from": 24360,
				"to": 26380
			},
			"text": " \"The energy absorbed by your skin would be minor,"
		},
		{
			"timestamps": {
				"from": "00:00:26,380",
				"to": "00:00:28,700"
			},
			"offsets": {
				"from": 26380,
				"to": 28700
			},
			"text": " \"about 10 to the minus five joules per square centimeter"
		},
		{
			"timestamps": {
				"from": "00:00:28,700",
				"to": "00:00:29,980"
			},
			"offsets": {
				"from": 28700,
				"to": 29980
			},
			"text": " \"of exposed skin."
		},
		{
			"timestamps": {
				"from": "00:00:29,980",
				"to": "00:00:33,280"
			},
			"offsets": {
				"from": 29980,
				"to": 33280
			},
			"text": " \"For comparison, according to the IEEE P1584 standard,"
		},
		{
			"timestamps": {
				"from": "00:00:33,280",
				"to": "00:00:35,440"
			},
			"offsets": {
				"from": 33280,
				"to": 35440
			},
			"text": " \"holding your finger in the blue flame of a butane lighter"
		},
		{
			"timestamps": {
				"from": "00:00:35,440",
				"to": "00:00:37,360"
			},
			"offsets": {
				"from": 35440,
				"to": 37360
			},
			"text": " \"for one second delivers about five joules"
		},
		{
			"timestamps": {
				"from": "00:00:37,360",
				"to": "00:00:38,840"
			},
			"offsets": {
				"from": 37360,
				"to": 38840
			},
			"text": " \"per square centimeter to the skin,"
		},
		{
			"timestamps": {
				"from": "00:00:38,840",
				"to": "00:00:40,060"
			},
			"offsets": {
				"from": 38840,
				"to": 40060
			},
			"text": " \"which is roughly the threshold"
		},
		{
			"timestamps": {
				"from": "00:00:40,060",
				"to": "00:00:41,880"
			},
			"offsets": {
				"from": 40060,
				"to": 41880
			},
			"text": " \"for receiving a second degree burn."
		},
		{
			"timestamps": {
				"from": "00:00:41,880",
				"to": "00:00:43,120"
			},
			"offsets": {
				"from": 41880,
				"to": 43120
			},
			"text": " \"The heat during your sun visit"
		},
		{
			"timestamps": {
				"from": "00:00:43,120",
				"to": "00:00:45,360"
			},
			"offsets": {
				"from": 43120,
				"to": 45360
			},
			"text": " \"would be five orders of magnitude weaker than that."
		},
		{
			"timestamps": {
				"from": "00:00:45,360",
				"to": "00:00:47,320"
			},
			"offsets": {
				"from": 45360,
				"to": 47320
			},
			"text": " \"So other than the dim flash in your eyes,"
		},
		{
			"timestamps": {
				"from": "00:00:47,320",
				"to": "00:00:48,820"
			},
			"offsets": {
				"from": 47320,
				"to": 48820
			},
			"text": " \"you might not even notice."
		},
		{
			"timestamps": {
				"from": "00:00:48,820",
				"to": "00:00:50,820"
			},
			"offsets": {
				"from": 48820,
				"to": 50820
			},
			"text": " \"But what if you got the coordinates wrong?"
		},
		{
			"timestamps": {
				"from": "00:00:50,820",
				"to": "00:00:53,080"
			},
			"offsets": {
				"from": 50820,
				"to": 53080
			},
			"text": " \"The sun's surface is relatively cool."
		},
		{
			"timestamps": {
				"from": "00:00:53,080",
				"to": "00:00:54,700"
			},
			"offsets": {
				"from": 53080,
				"to": 54700
			},
			"text": " \"It's hotter than like Phoenix,"
		},
		{
			"timestamps": {
				"from": "00:00:54,700",
				"to": "00:00:56,420"
			},
			"offsets": {
				"from": 54700,
				"to": 56420
			},
			"text": " \"but compared to the interior of the sun,"
		},
		{
			"timestamps": {
				"from": "00:00:56,420",
				"to": "00:00:57,680"
			},
			"offsets": {
				"from": 56420,
				"to": 57680
			},
			"text": " \"it's downright chilly."
		},
		{
			"timestamps": {
				"from": "00:00:57,680",
				"to": "00:00:59,180"
			},
			"offsets": {
				"from": 57680,
				"to": 59180
			},
			"text": " \"The surface is a few thousand degrees,"
		},
		{
			"timestamps": {
				"from": "00:00:59,180",
				"to": "00:01:01,520"
			},
			"offsets": {
				"from": 59180,
				"to": 61520
			},
			"text": " \"but the interior is a few million degrees."
		},
		{
			"timestamps": {
				"from": "00:01:01,520",
				"to": "00:01:03,520"
			},
			"offsets": {
				"from": 61520,
				"to": 63520
			},
			"text": " \"What if you spent a nanosecond there?"
		},
		{
			"timestamps": {
				"from": "00:01:03,520",
				"to": "00:01:05,200"
			},
			"offsets": {
				"from": 63520,
				"to": 65200
			},
			"text": " \"The Stefan-Boltzmann law lets us calculate"
		},
		{
			"timestamps": {
				"from": "00:01:05,200",
				"to": "00:01:07,420"
			},
			"offsets": {
				"from": 65200,
				"to": 67420
			},
			"text": " \"how much heat you'd absorb while inside the sun."
		},
		{
			"timestamps": {
				"from": "00:01:07,420",
				"to": "00:01:08,360"
			},
			"offsets": {
				"from": 67420,
				"to": 68360
			},
			"text": " \"It's not good."
		},
		{
			"timestamps": {
				"from": "00:01:08,360",
				"to": "00:01:10,880"
			},
			"offsets": {
				"from": 68360,
				"to": 70880
			},
			"text": " \"You would exceed the IEEE 1584B standard"
		},
		{
			"timestamps": {
				"from": "00:01:10,880",
				"to": "00:01:13,960"
			},
			"offsets": {
				"from": 70880,
				"to": 73960
			},
			"text": " \"for second degree burns after one femtosecond in the sun."
		},
		{
			"timestamps": {
				"from": "00:01:13,960",
				"to": "00:01:15,920"
			},
			"offsets": {
				"from": 73960,
				"to": 75920
			},
			"text": " \"A nanosecond, the time you're spending there,"
		},
		{
			"timestamps": {
				"from": "00:01:15,920",
				"to": "00:01:17,520"
			},
			"offsets": {
				"from": 75920,
				"to": 77520
			},
			"text": " \"is a million femtoseconds."
		},
		{
			"timestamps": {
				"from": "00:01:17,520",
				"to": "00:01:18,960"
			},
			"offsets": {
				"from": 77520,
				"to": 78960
			},
			"text": " \"This doesn't end well for you."
		},
		{
			"timestamps": {
				"from": "00:01:18,960",
				"to": "00:01:20,220"
			},
			"offsets": {
				"from": 78960,
				"to": 80220
			},
			"text": " \"But there's some good news."
		},
		{
			"timestamps": {
				"from": "00:01:20,220",
				"to": "00:01:21,960"
			},
			"offsets": {
				"from": 80220,
				"to": 81960
			},
			"text": " \"Deep in the sun, the photons carrying energy"
		},
		{
			"timestamps": {
				"from": "00:01:21,960",
				"to": "00:01:23,560"
			},
			"offsets": {
				"from": 81960,
				"to": 83560
			},
			"text": " \"are out of very short wavelengths."
		},
		{
			"timestamps": {
				"from": "00:01:23,560",
				"to": "00:01:24,660"
			},
			"offsets": {
				"from": 83560,
				"to": 84660
			},
			"text": " \"They're not visible light."
		},
		{
			"timestamps": {
				"from": "00:01:24,660",
				"to": "00:01:26,200"
			},
			"offsets": {
				"from": 84660,
				"to": 86200
			},
			"text": " \"They're mostly a mix of what we consider"
		},
		{
			"timestamps": {
				"from": "00:01:26,200",
				"to": "00:01:27,580"
			},
			"offsets": {
				"from": 86200,
				"to": 87580
			},
			"text": " \"hard and soft X-rays."
		},
		{
			"timestamps": {
				"from": "00:01:27,580",
				"to": "00:01:29,380"
			},
			"offsets": {
				"from": 87580,
				"to": 89380
			},
			"text": " \"This means that they penetrate into your body"
		},
		{
			"timestamps": {
				"from": "00:01:29,380",
				"to": "00:01:31,380"
			},
			"offsets": {
				"from": 89380,
				"to": 91380
			},
			"text": " \"to various depths, heating your internal organs"
		},
		{
			"timestamps": {
				"from": "00:01:31,380",
				"to": "00:01:32,840"
			},
			"offsets": {
				"from": 91380,
				"to": 92840
			},
			"text": " \"and also ionizing your DNA,"
		},
		{
			"timestamps": {
				"from": "00:01:32,840",
				"to": "00:01:34,120"
			},
			"offsets": {
				"from": 92840,
				"to": 94120
			},
			"text": " \"causing your reversible damage"
		},
		{
			"timestamps": {
				"from": "00:01:34,120",
				"to": "00:01:35,720"
			},
			"offsets": {
				"from": 94120,
				"to": 95720
			},
			"text": " \"before they even start burning you."
		},
		{
			"timestamps": {
				"from": "00:01:35,720",
				"to": "00:01:37,360"
			},
			"offsets": {
				"from": 95720,
				"to": 97360
			},
			"text": " \"Looking back, I realize I started that"
		},
		{
			"timestamps": {
				"from": "00:01:37,360",
				"to": "00:01:38,880"
			},
			"offsets": {
				"from": 97360,
				"to": 98880
			},
			"text": " \"by saying there's some good news."
		},
		{
			"timestamps": {
				"from": "00:01:38,880",
				"to": "00:01:40,020"
			},
			"offsets": {
				"from": 98880,
				"to": 100020
			},
			"text": " \"I don't know why I did that."
		},
		{
			"timestamps": {
				"from": "00:01:40,020",
				"to": "00:01:42,280"
			},
			"offsets": {
				"from": 100020,
				"to": 102280
			},
			"text": " \"Don't spend a nanosecond inside the sun.\""
		}
	]
}
