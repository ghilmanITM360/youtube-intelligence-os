	"transcription": [
		{
			"timestamps": {
				"from": "00:00:00,000",
				"to": "00:00:03,560"
			},
			"offsets": {
				"from": 0,
				"to": 3560
			},
			"text": " What would your country be like if the land masses were rotated by 90 degrees?"
		},
		{
			"timestamps": {
				"from": "00:00:03,560",
				"to": "00:00:06,880"
			},
			"offsets": {
				"from": 3560,
				"to": 6880
			},
			"text": " Let's imagine that this alternate Earth develops over millions of years, giving time"
		},
		{
			"timestamps": {
				"from": "00:00:06,880",
				"to": "00:00:09,360"
			},
			"offsets": {
				"from": 6880,
				"to": 9360
			},
			"text": " for ecosystems and climate zones to settle out."
		},
		{
			"timestamps": {
				"from": "00:00:09,360",
				"to": "00:00:11,580"
			},
			"offsets": {
				"from": 9360,
				"to": 11580
			},
			"text": " Let's take a closer look at each continent."
		},
		{
			"timestamps": {
				"from": "00:00:11,580",
				"to": "00:00:15,000"
			},
			"offsets": {
				"from": 11580,
				"to": 15000
			},
			"text": " North America's climate is similar to before, but flipped north-south."
		},
		{
			"timestamps": {
				"from": "00:00:15,000",
				"to": "00:00:19,280"
			},
			"offsets": {
				"from": 15000,
				"to": 19280
			},
			"text": " Central America is now icy and polar, while Arctic Canada becomes tropical."
		},
		{
			"timestamps": {
				"from": "00:00:19,280",
				"to": "00:00:22,320"
			},
			"offsets": {
				"from": 19280,
				"to": 22320
			},
			"text": " Hurricanes threaten Greenland, Baffin Island, and the Maritimes."
		},
		{
			"timestamps": {
				"from": "00:00:22,320",
				"to": "00:00:25,480"
			},
			"offsets": {
				"from": 22320,
				"to": 25480
			},
			"text": " Tropical moisture from Baffin Bay and the former North Atlantic mixes with cool air"
		},
		{
			"timestamps": {
				"from": "00:00:25,480",
				"to": "00:00:29,180"
			},
			"offsets": {
				"from": 25480,
				"to": 29180
			},
			"text": " flowing down from the Rockies, creating a new tornado alley in the prairies inland from"
		},
		{
			"timestamps": {
				"from": "00:00:29,180",
				"to": "00:00:30,180"
			},
			"offsets": {
				"from": 29180,
				"to": 30180
			},
			"text": " Hudson Bay."
		},
		{
			"timestamps": {
				"from": "00:00:30,180",
				"to": "00:00:32,360"
			},
			"offsets": {
				"from": 30180,
				"to": 32360
			},
			"text": " South America looks sort of like the old Europe."
		},
		{
			"timestamps": {
				"from": "00:00:32,360",
				"to": "00:00:35,720"
			},
			"offsets": {
				"from": 32360,
				"to": 35720
			},
			"text": " It's cool and temperate along the Brazilian coast, with grasslands and boreal forests"
		},
		{
			"timestamps": {
				"from": "00:00:35,720",
				"to": "00:00:37,120"
			},
			"offsets": {
				"from": 35720,
				"to": 37120
			},
			"text": " along much of its width."
		},
		{
			"timestamps": {
				"from": "00:00:37,120",
				"to": "00:00:40,480"
			},
			"offsets": {
				"from": 37120,
				"to": 40480
			},
			"text": " In the south, the boreal vegetation gives way to polar tundra, and eventually to be"
		},
		{
			"timestamps": {
				"from": "00:00:40,480",
				"to": "00:00:45,080"
			},
			"offsets": {
				"from": 40480,
				"to": 45080
			},
			"text": " massive icebound Andes, which cut the continent off from the frozen polar waters."
		},
		{
			"timestamps": {
				"from": "00:00:45,080",
				"to": "00:00:48,840"
			},
			"offsets": {
				"from": 45080,
				"to": 48840
			},
			"text": " The Amazon, which in our world carries more water than the next seven rivers put together,"
		},
		{
			"timestamps": {
				"from": "00:00:48,840",
				"to": "00:00:51,040"
			},
			"offsets": {
				"from": 48840,
				"to": 51040
			},
			"text": " is reduced to something akin to the Mississippi."
		},
		{
			"timestamps": {
				"from": "00:00:51,040",
				"to": "00:00:54,800"
			},
			"offsets": {
				"from": 51040,
				"to": 54800
			},
			"text": " Asia is flipped in the same way North America was, with the Siberian coast now facing an"
		},
		{
			"timestamps": {
				"from": "00:00:54,800",
				"to": "00:00:56,560"
			},
			"offsets": {
				"from": 54800,
				"to": 56560
			},
			"text": " enclosed tropical sea."
		},
		{
			"timestamps": {
				"from": "00:00:56,560",
				"to": "00:01:00,060"
			},
			"offsets": {
				"from": 56560,
				"to": 60060
			},
			"text": " The Indian subcontinent and former Southeast Asia form the new Siberia."
		},
		{
			"timestamps": {
				"from": "00:01:00,060",
				"to": "00:01:03,720"
			},
			"offsets": {
				"from": 60060,
				"to": 63720
			},
			"text": " The Gobi Desert is no longer in the rain shadow of the Himalayas, but it doesn't exactly"
		},
		{
			"timestamps": {
				"from": "00:01:03,720",
				"to": "00:01:05,160"
			},
			"offsets": {
				"from": 63720,
				"to": 65160
			},
			"text": " become tropical."
		},
		{
			"timestamps": {
				"from": "00:01:05,160",
				"to": "00:01:06,960"
			},
			"offsets": {
				"from": 65160,
				"to": 66960
			},
			"text": " Europe resembles the old Southeast Asia."
		},
		{
			"timestamps": {
				"from": "00:01:06,960",
				"to": "00:01:09,960"
			},
			"offsets": {
				"from": 66960,
				"to": 69960
			},
			"text": " Great Britain and Ireland look like the islands of Sumatra and Borneo."
		},
		{
			"timestamps": {
				"from": "00:01:09,960",
				"to": "00:01:11,680"
			},
			"offsets": {
				"from": 69960,
				"to": 71680
			},
			"text": " Iceland resembles our Philippines."
		},
		{
			"timestamps": {
				"from": "00:01:11,680",
				"to": "00:01:15,560"
			},
			"offsets": {
				"from": 71680,
				"to": 75560
			},
			"text": " And Central Europe is the new New Guinea, with the Alps the only place on the equator"
		},
		{
			"timestamps": {
				"from": "00:01:15,560",
				"to": "00:01:17,480"
			},
			"offsets": {
				"from": 75560,
				"to": 77480
			},
			"text": " with permanent glaciers."
		},
		{
			"timestamps": {
				"from": "00:01:17,480",
				"to": "00:01:22,000"
			},
			"offsets": {
				"from": 77480,
				"to": 82000
			},
			"text": " Africa is rotated by 90 degrees, with former West Africa becoming tropical rainforest and"
		},
		{
			"timestamps": {
				"from": "00:01:22,000",
				"to": "00:01:24,320"
			},
			"offsets": {
				"from": 82000,
				"to": 84320
			},
			"text": " former East Africa an arid desert."
		},
		{
			"timestamps": {
				"from": "00:01:24,320",
				"to": "00:01:27,920"
			},
			"offsets": {
				"from": 84320,
				"to": 87920
			},
			"text": " On our Earth, North America has by far the most tornadoes of any continent."
		},
		{
			"timestamps": {
				"from": "00:01:27,920",
				"to": "00:01:30,980"
			},
			"offsets": {
				"from": 87920,
				"to": 90980
			},
			"text": " But in this world, I bet they'd be frequent in Africa as well."
		},
		{
			"timestamps": {
				"from": "00:01:30,980",
				"to": "00:01:35,440"
			},
			"offsets": {
				"from": 90980,
				"to": 95440
			},
			"text": " Australia is cooler in wetter, with forests along the formerly dry western regions."
		},
		{
			"timestamps": {
				"from": "00:01:35,440",
				"to": "00:01:37,320"
			},
			"offsets": {
				"from": 95440,
				"to": 97320
			},
			"text": " But Antarctica is the clear winner."
		},
		{
			"timestamps": {
				"from": "00:01:37,320",
				"to": "00:01:40,000"
			},
			"offsets": {
				"from": 97320,
				"to": 100000
			},
			"text": " Without its icecap, it's a bit smaller than we remember."
		},
		{
			"timestamps": {
				"from": "00:01:40,000",
				"to": "00:01:42,600"
			},
			"offsets": {
				"from": 100000,
				"to": 102600
			},
			"text": " But most of it is blanketed with highland rainforest."
		},
		{
			"timestamps": {
				"from": "00:01:42,600",
				"to": "00:01:45,280"
			},
			"offsets": {
				"from": 102600,
				"to": 105280
			},
			"text": " There are alpine zones around the mountains to the south and west."
		},
		{
			"timestamps": {
				"from": "00:01:45,280",
				"to": "00:01:49,440"
			},
			"offsets": {
				"from": 105280,
				"to": 109440
			},
			"text": " The researchers at McMurdo and Ross Island work in a tropical paradise."
		},
		{
			"timestamps": {
				"from": "00:01:49,440",
				"to": "00:01:52,600"
			},
			"offsets": {
				"from": 109440,
				"to": 112600
			},
			"text": " If any of them decide they miss the frozen wastelands, hey, they can always put in for"
		},
		{
			"timestamps": {
				"from": "00:01:52,600",
				"to": "00:01:55,800"
			},
			"offsets": {
				"from": 112600,
				"to": 115800
			},
			"text": " transfer to Costa Rica."
		}
	]
}
