# Operational browser/export staging. Canonical registered copies live under
# their checksum-registered data/raw/ and data/extracted/ dataset paths.
/outputs/

# Phase 1 SQLite inventory catalog (Decision 012, Decision 013): the database
# is a regenerable local index, not source evidence. Its schema and manifests
# stay in Git; the runtime database file does not.
data/catalog/*.db
data/catalog/*.db-wal
data/catalog/*.db-shm
data/catalog/*.sqlite
data/catalog/*.sqlite3

# Owner-required durable catalog snapshots. SQLite journals remain ignored.
!data/catalog/youtube_inventory.db
!data/catalog/youtube_channel_registry.db

# Private first-party YouTube Analytics exports and derived diagnoses stay local.
# Only capability contracts/status and synthetic test fixtures are versioned.
data/intelligence/first-party/**/*

# Phase 1C transient handoff file between `register_batch.py discover` and
# `register` — scratch state, not a durable record (the durable records are
# data/manifests/batches/*.md and *_FILES.csv, both regenerated from the
# catalog database by scripts/generate_batch_manifests.py).
data/manifests/batches/*_state.json

# Python/test/build caches are always disposable and must never enter Git.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local inspection sidecars produced while validating generated workbooks.
*.inspect.ndjson

# Local rendering-pipeline test output (not checksum-registered dataset
# evidence). Matches the /outputs/ naming already ignored above; this repo
# also produces a singular "output/" directory from local pipeline runs.
/output/
/output.zip

# Local normalized What If forensic staging. The reviewed source contract and
# importer code are versioned; row payloads and diff reports stay local.
/data/staging/what-if-forensic/
