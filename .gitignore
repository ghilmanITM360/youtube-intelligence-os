!data/raw/channel-data/DS-000027/preflight/authenticated_apify_prelaunch_verification_20260920T163357+0500.json
!data/raw/channel-data/DS-000027/apify/
!data/raw/channel-data/DS-000027/apify/*/
!data/raw/channel-data/DS-000027/apify/*/*.json

