# Operating-system and editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Secrets and local credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Temporary and cache files
.cache/
.tmp/
tmp/
*.tmp

# Isolated Python environment for optional image-pipeline dependencies
# (Pillow — Phase 1C). Never the system Python; see docs/TOOLS_INSTALLED.md.
.venv/

# Generated operational logs; keep documentation and placeholders
logs/*
!logs/README.md
!logs/.gitkeep
*.log

# Raw data is intentionally not ignored wholesale as a *policy* (see README.md,
# "Git and large raw data"): each dataset still needs an explicit inventory and
# storage decision. But as a *safety default* (Decision 013), files copied into
# data/raw/ are not staged automatically — .gitkeep placeholders stay tracked,
# everything else under data/raw/ must be added deliberately, file by file.
data/raw/**/*
!data/raw/**/.gitkeep
!data/raw/**/README.md

# DS-000020 is an explicitly authorized, checksum-registered Apify evidence set.
# Only these three immutable JSON exports are versioned; all other raw-data
# safety defaults remain in force.
!data/raw/channel-data/
!data/raw/channel-data/DS-000020/
!data/raw/channel-data/DS-000020/apify/
!data/raw/channel-data/DS-000020/apify/*/
!data/raw/channel-data/DS-000020/apify/*/*.json

# DS-000021 is an explicitly authorized, checksum-registered Apify evidence set.
# Only immutable JSON exports below this dataset path are versioned.
!data/raw/channel-data/DS-000021/
!data/raw/channel-data/DS-000021/apify/
!data/raw/channel-data/DS-000021/apify/*/
!data/raw/channel-data/DS-000021/apify/*/*.json

# DS-000022 is an explicitly authorized, checksum-registered set of
# user-provided channel workbooks and transcript archives. Source-artifact
# copies remain byte-identical; other raw-data defaults remain in force.
!data/raw/channel-data/DS-000022/
!data/raw/channel-data/DS-000022/source-artifacts/
!data/raw/channel-data/DS-000022/source-artifacts/*/
!data/raw/channel-data/DS-000022/source-artifacts/*/*.xlsx
!data/raw/channel-data/DS-000022/source-artifacts/*/*.zip

# DS-000022 targeted Lucas Grant transcript-recovery evidence. This exact run
# directory contains immutable Actor output plus its registered input/run log.
!data/raw/channel-data/DS-000022/apify-transcript-recovery/
!data/raw/channel-data/DS-000022/apify-transcript-recovery/dmUFY1GHENjMdqsB9/
!data/raw/channel-data/DS-000022/apify-transcript-recovery/dmUFY1GHENjMdqsB9/*

# DS-000026 preflight evidence is an explicitly authorized immutable evidence
# set. The dataset itself remains unstarted; only these two preflight exports
