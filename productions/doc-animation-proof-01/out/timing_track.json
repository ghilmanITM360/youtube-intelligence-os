{
 "note": "planned from ~2.6 words/s; NOT measured speech; audible review pending",
 "clauses": [
  {
   "start_end_s": "0.0-4.8",
   "text": "If your savings earn interest, does that interest earn interest too?"
  },
  {
   "start_end_s": "5.2-8.0",
   "text": "Here is how the Consumer Financial Protection Bureau puts it."
  },
  {
   "start_end_s": "8.4-16.6",
   "text": "Compound interest is when you earn interest on the money you've saved, and on the interest you earn along the way."
  },
  {
   "start_end_s": "17.4-23.8",
   "text": "Their example starts with one thousand dollars, earning five percent, calculated once a year."
  },
  {
   "start_end_s": "24.2-31.6",
   "text": "After year one, that is fifty dollars of interest. In year two, you earn five percent of one thousand fifty, so fifty-two dollars and fifty cents."
  },
  {
   "start_end_s": "32.6-39.0",
   "text": "Now our own numbers, a hypothetical: one thousand dollars at five percent, added once a year, for three years."
  },
  {
   "start_end_s": "39.6-46.0",
   "text": "Year one adds fifty dollars. Year two adds fifty-two fifty. Year three adds fifty-five thirteen."
  },
  {
   "start_end_s": "46.2-53.0",
   "text": "Simple interest alone would add one hundred fifty dollars. Compounding adds seven dollars and sixty-three cents more."
  },
  {
   "start_end_s": "53.2-59.5",
   "text": "Small at first, but every year starts from a bigger base. Interest earns interest."
  }
 ],
