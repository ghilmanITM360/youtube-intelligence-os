[
 {
  "text": "You're falling from",
  "speech_start": 0.13,
  "speech_end": 1.35,
  "start": 0.08,
  "end": 0.95
 },
 {
  "text": "10 kilometers above the ground,",
  "speech_start": 1.0,
  "speech_end": 2.82,
  "start": 0.95,
  "end": 3.07
 },
 {
  "text": "your parachute is still closed,",
  "speech_start": 3.16,
  "speech_end": 4.87,
  "start": 3.11,
  "end": 5.12
 },
 {
  "text": "gravity is still pulling you down,",
  "speech_start": 5.22,
  "speech_end": 7.04,
  "start": 5.17,
  "end": 7.29
 },
 {
  "text": "and somehow,",
  "speech_start": 7.65,
  "speech_end": 8.34,
  "start": 7.6,
  "end": 8.59
 },
 {
  "text": "you're slowing down.",
  "speech_start": 8.78,
  "speech_end": 10.2,
  "start": 8.73,
  "end": 10.45
 },
 {
  "text": "Wait, what?",
  "speech_start": 11.15,
  "speech_end": 11.96,
  "start": 11.1,
  "end": 12.21
 },
 {
  "text": "Did gravity change its mind?",
  "speech_start": 12.52,
  "speech_end": 14.18,
  "start": 12.47,
  "end": 14.35
 },
 {
  "text": "Did the air suddenly grow brakes?",
  "speech_start": 14.4,
  "speech_end": 16.11,
  "start": 14.35,
  "end": 16.36
 },
 {
  "text": "No, but the air is doing something",
  "speech_start": 16.79,
  "speech_end": 19.22,
  "start": 16.74,
  "end": 18.82
 },
 {
  "text": "surprisingly powerful.",
  "speech_start": 18.87,
  "speech_end": 20.32,
  "start": 18.82,
  "end": 20.57
 },
 {
  "text": "Imagine the fall,",
  "speech_start": 20.75,
  "speech_end": 21.7,
  "start": 20.7,
  "end": 21.84
 },
 {
  "text": "starting from rest.",
  "speech_start": 21.89,
  "speech_end": 22.67,
  "start": 21.84,
  "end": 22.8
 },
 {
  "text": "Up here,",
  "speech_start": 22.85,
  "speech_end": 23.79,
  "start": 22.8,
  "end": 23.39
 },
 {
  "text": "the air is thin.",
  "speech_start": 23.44,
  "speech_end": 24.41,
  "start": 23.39,
  "end": 24.62
 },
 {
  "text": "At first,",
  "speech_start": 24.67,
  "speech_end": 25.66,
  "start": 24.62,
  "end": 25.26
 },
 {
  "text": "gravity wins.",
  "speech_start": 25.31,
  "speech_end": 26.29,
  "start": 25.26,
  "end": 26.54
 },
 {
  "text": "You keep going faster,",
  "speech_start": 26.67,
  "speech_end": 28.04,
  "start": 26.62,
  "end": 27.88
 },
 {
  "text": "but as you fall,",
  "speech_start": 27.93,
  "speech_end": 29.29,
  "start": 27.88,
  "end": 28.89
 },
 {
  "text": "you're entering denser air.",
  "speech_start": 28.94,
  "speech_end": 30.99,
  "start": 28.89,
  "end": 30.78
 },
 {
  "text": "And here's where things get strange.",
  "speech_start": 30.83,
  "speech_end": 33.1,
  "start": 30.78,
  "end": 33.34
 },
 {
  "text": "The air pushes against you,",
  "speech_start": 33.39,
  "speech_end": 35.06,
  "start": 33.34,
  "end": 34.9
 },
 {
  "text": "and the faster you fall,",
  "speech_start": 34.95,
  "speech_end": 36.83,
  "start": 34.9,
  "end": 36.43
 },
 {
  "text": "the harder it pushes back.",
  "speech_start": 36.48,
  "speech_end": 38.12,
  "start": 36.43,
  "end": 38.37
 },
 {
  "text": "Eventually,",
  "speech_start": 38.74,
  "speech_end": 39.58,
  "start": 38.69,
  "end": 39.18
 },
 {
  "text": "in a simple model where your body",
  "speech_start": 39.23,
  "speech_end": 41.34,
  "start": 39.18,
  "end": 40.94
 },
 {
  "text": "position stays fixed,",
  "speech_start": 40.99,
  "speech_end": 42.31,
  "start": 40.94,
  "end": 42.52
 },
 {
  "text": "that upward push can actually",
  "speech_start": 42.57,
  "speech_end": 44.7,
  "start": 42.52,
  "end": 44.3
 },
 {
  "text": "become stronger than your weight.",
  "speech_start": 44.35,
  "speech_end": 46.11,
  "start": 44.3,
  "end": 46.36
 },
 {
  "text": "Think about that.",
  "speech_start": 46.8,
  "speech_end": 47.25,
  "start": 46.75,
  "end": 47.65
 },
 {
  "text": "You're still moving down,",
  "speech_start": 47.71,
  "speech_end": 48.93,
  "start": 47.66,
  "end": 49.18
 },
 {
  "text": "but the net force is now pointing up,",
  "speech_start": 49.4,
  "speech_end": 51.66,
  "start": 49.35,
  "end": 51.91
 },
 {
  "text": "so your downward speed",
  "speech_start": 52.2,
  "speech_end": 53.87,
  "start": 52.15,
  "end": 53.47
 },
 {
  "text": "starts to decrease.",
  "speech_start": 53.52,
  "speech_end": 55.04,
  "start": 53.47,
  "end": 55.29
 },
 {
  "text": "The speedometer drops,",
  "speech_start": 55.44,
  "speech_end": 56.7,
  "start": 55.39,
  "end": 56.76
 },
 {
  "text": "the ground gets closer.",
  "speech_start": 56.81,
  "speech_end": 58.56,
  "start": 56.76,
  "end": 58.42
 },
 {
  "text": "And your parachute?",
  "speech_start": 58.47,
  "speech_end": 60.03,
  "start": 58.42,
  "end": 60.28
 },
 {
  "text": "Still closed.",
  "speech_start": 60.57,
  "speech_end": 61.18,
  "start": 60.52,
  "end": 61.43
 },
 {
  "text": "That's the strange part.",
  "speech_start": 61.71,
  "speech_end": 62.79,
  "start": 61.66,
  "end": 62.57
 },
 {
  "text": "Slowing down doesn't mean",
  "speech_start": 62.62,
  "speech_end": 64.45,
  "start": 62.57,
  "end": 64.05
 },
 {
  "text": "you've stopped falling.",
  "speech_start": 64.1,
  "speech_end": 65.51,
  "start": 64.05,
  "end": 65.74
 },
 {
  "text": "It means the air is pushing back harder",
  "speech_start": 65.79,
  "speech_end": 68.08,
  "start": 65.74,
  "end": 67.68
 },
 {
  "text": "than gravity is pulling you down.",
  "speech_start": 67.73,
  "speech_end": 69.77,
  "start": 67.68,
  "end": 70.02
 },
 {
  "text": "But remember,",
  "speech_start": 70.27,
  "speech_end": 70.65,
  "start": 70.22,
  "end": 70.86
 },
 {
  "text": "this is a model,",
  "speech_start": 70.91,
  "speech_end": 72.18,
  "start": 70.86,
  "end": 71.78
 },
 {
  "text": "not a prediction for a real person.",
  "speech_start": 71.83,
  "speech_end": 74.05,
  "start": 71.78,
  "end": 74.3
 },
 {
  "text": "Change the posture or the conditions,",
  "speech_start": 74.55,
  "speech_end": 76.18,
  "start": 74.5,
  "end": 76.43
 },
 {
  "text": "and the result can change too.",
  "speech_start": 76.55,
  "speech_end": 77.88,
  "start": 76.5,
  "end": 78.13
 }
]